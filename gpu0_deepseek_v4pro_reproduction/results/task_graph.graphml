lect_wood": 100.0, "place_table": 100.0, "eat_cow": 78.56135401974612, "collect_sapling": 98.87165021156558, "collect_drink": 95.62764456981664, "make_wood_pickaxe": 100.0, "make_wood_sword": 98.58956276445699, "place_plant": 98.58956276445699, "defeat_zombie": 5.077574047954866, "collect_stone": 100.0, "place_stone": 98.02538787023977, "eat_plant": 5.077574047954866, "defeat_skeleton": 5.359661495063469, "make_stone_pickaxe": 100.0, "make_stone_sword": 97.88434414668548, "wake_up": 94.78138222849083, "place_furnace": 100.0, "collect_coal": 100.0, "collect_iron": 98.16643159379407, "collect_diamond": 3.8081805359661494, "make_iron_pickaxe": 91.67842031029619, "make_iron_sword": 41.889985895627646, "make_arrow": 81.80535966149506, "make_torch": 95.76868829337094, "place_torch": 92.80677009873061, "collect_sapphire": 5.077574047954866, "collect_ruby": 5.500705218617772, "make_diamond_pickaxe": 0.5641748942172073, "make_diamond_sword": 0.5641748942172073, "make_iron_armour": 1.8335684062059239, "enter_dungeon": 52.46826516220028, "defeat_orc_solider": 2.397743300423131, "defeat_orc_mage": 1.2693935119887165, "eat_snail": 11.424541607898448, "find_bow": 50.916784203102964, "fire_bow": 36.248236953455574, "open_chest": 50.916784203102964, "drink_potion": 21.156558533145276}, "average_episode_length": 394.90973201692526, "mean_return_percentage": 17.809200626115555, "mean_return": 40.248793415021154, "lp": NaN, "priority_score": 0.07746463462911865}]</data>
