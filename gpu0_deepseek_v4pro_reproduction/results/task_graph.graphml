pen_chest": 99.12280701754386, "drink_potion": 81.57894736842105}, "average_episode_length": 794.672514619883, "mean_return_percentage": 20.853241855965045, "mean_return": 47.128326594480995, "lp": NaN, "priority_score": 0.24178379672377825}, {"session": 131, "sr": 0.6235632183908046, "achievement_srs": {"collect_wood": 100.0, "place_table": 100.0, "eat_cow": 63.2183908045977, "collect_sapling": 74.71264367816092, "collect_drink": 93.39080459770115, "place_plant": 74.71264367816092, "defeat_zombie": 37.06896551724138, "collect_stone": 100.0, "place_stone": 99.13793103448276, "eat_plant": 10.344827586206897, "defeat_skeleton": 37.06896551724138, "wake_up": 95.6896551724138, "place_furnace": 99.42528735632185, "collect_coal": 77.01149425287356, "collect_iron": 74.13793103448276, "collect_diamond": 29.885057471264368, "make_iron_pickaxe": 17.528735632183906, "make_iron_sword": 34.770114942528735, "make_arrow": 100.0, "make_torch": 100.0, "place_torch": 100.0, "collect_sapphire": 25.28735632183908, "collect_ruby": 26.724137931034484, "make_diamond_pickaxe": 4.597701149425287, "make_diamond_sword": 2.2988505747126435, "make_iron_armour": 4.885057471264368, "enter_gnomish_mines": 62.35632183908046, "enter_dungeon": 100.0, "defeat_orc_solider": 97.41379310344827, "defeat_orc_mage": 92.816091954023, "eat_snail": 97.70114942528735, "find_bow": 99.13793103448276, "fire_bow": 99.13793103448276, "open_chest": 99.13793103448276, "drink_potion": 83.04597701149426}, "average_episode_length": 812.2672413793103, "mean_return_percentage": 21.24422764247025, "mean_return": 48.01195447198276, "lp": NaN, "priority_score": 0.23473213106090632}]</data>
