      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Clear the Dungeon under full‑difficulty combat and survival conditions and descend to the Gnomish Mines to improve the agent’s robustness on the dungeon‑clearing bottleneck seen in the original Craftax.

Description: The agent starts on the Dungeon floor (Floor 1) with a loadout that reflects a successful Overworld descent. It is given a stone pickaxe, stone sword, 20 wood, and 10 stone, so that it can focus on combat and exploration without crafting early tools. All survival meters (Health, Food, Drink, Energy, Mana) are full. The ladder down to the Gnomish Mines is locked; the agent must kill 8 hostile mobs (orc soldiers and orc mages) on this floor to unlock it. Unlike the lenient parent task, **all spawn multipliers and the needs depletion rate are set to 1.0 (original Craftax values)**, matching the full game’s difficulty. No manual mob placements are used; enemies spawn naturally. The agent must survive, hunt down and defeat enough enemies, and then descend the ladder to achieve `ENTER_GNOMISH_MINES`.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD

World:
- Player: Floor 1 (spawn at the ladder‑up position). Inventory: {"pickaxe": 2, "sword": 2, "wood": 20, "stone": 10}. (Pickaxe level 2 = stone pickaxe, Sword level 2 = stone sword.) Stats: Strength 1, Dexterity 1, Intelligence 1. Health/Food/Drink/Energy/Mana all full (9/9). Learned spells: none. Weapon/Armour enchantments: none.
- Map:
    - Use default world generation for all levels.
    - No manual block placements, resource additions, or pre‑spawned mobs.
- Mechanics:
    "needs_depletion_multiplier": 1.0,
    "melee_spawn_multiplier": 1.0,
    "ranged_spawn_multiplier": 1.0,
    "passive_spawn_multiplier": 1.0,
    "monsters_killed_to_clear_level": 8,
    "health_recover_multiplier": 1.0,
    "health_loss_multiplier": 1.0,
    "mob_health_multiplier": 1.0,
    "mob_damage_multiplier": 1.0
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            monsters_killed_to_clear_level=8,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on Floor 1 (the Dungeon)
        builder.set_starting_floor(1)

        # Equip starting inventory: stone pickaxe, stone sword, wood, stone
        builder.set_player_inventory({
            "pickaxe": 2,   # stone
            "sword": 2,     # stone
            "wood": 20,
            "stone": 10,
        })

        # No map modifications; use default procedural generation
        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
