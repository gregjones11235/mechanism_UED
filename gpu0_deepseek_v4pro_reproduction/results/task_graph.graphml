"make_torch": 100.0, "place_torch": 100.0, "collect_sapphire": 22.55892255892256, "collect_ruby": 25.925925925925927, "make_diamond_pickaxe": 5.05050505050505, "make_diamond_sword": 3.7037037037037037, "enter_gnomish_mines": 42.08754208754209, "enter_dungeon": 100.0, "defeat_orc_solider": 96.29629629629629, "defeat_orc_mage": 91.58249158249158, "eat_snail": 96.63299663299664, "find_bow": 98.65319865319866, "fire_bow": 87.20538720538721, "open_chest": 98.65319865319866, "drink_potion": 79.79797979797979}, "average_episode_length": 955.1515151515151, "mean_return_percentage": 18.802676353319328, "mean_return": 42.49404855850168, "lp": NaN, "priority_score": 0.24373930097835825}]</data>
