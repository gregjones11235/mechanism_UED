      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Master survival‑aware combat by reaching the Gnomish Mines under full hunger, thirst, and fatigue rates, while maintaining the ability to clear hostile mobs and navigate the dungeon.

Description:
The agent begins on Floor 0 (Overworld) at the default spawn point. Its inventory is pre‑supplied with a **wood pickaxe**, a **wood sword**, **5 torches**, and **5 wood**. A crafting table is already placed on a grass block near the center of the Overworld (e.g., at map coordinates (24, 24) – reachable within a few steps). All other stats are at their maximum (health 9, food 9, drink 9, energy 9, mana 9; STR 1, DEX 1, INT 1). No mobs are pre‑placed.
The early game chores of chopping trees, building a table, and crafting wooden tools are therefore completed at the start, freeing the agent to focus on the core challenge: managing survival needs while fighting.
Survival pressure is set to full default game intensity: **needs_depletion_multiplier = 1.0**, meaning hunger, thirst, and fatigue accumulate at the standard rate. The player must actively seek food (e.g., eating cows, drinking water, possibly growing/eating plants) and manage energy through sleep or rest to stay alive.
Combat difficulty is unchanged from the previous task: melee and ranged spawn multipliers are **1.0**, mob health and damage multipliers are **1.0**, and the number of hostile monsters that must be killed to clear a floor is raised to **8** (the original Craftax value). The agent must descend to the Dungeon (Floor 1), defeat the required 8 monsters to unlock the down‑ladder, and then descend to the Gnomish Mines (Floor 2).
The task terminates with success when the `ENTER_GNOMISH_MINES` achievement is triggered. All other mechanics (world generation, potion mapping, mob spawn logic) remain at their default values.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD, PLACE_TABLE

World:
- Player: Start on Floor 0 at the default Overworld spawn. Inventory: wood_pickaxe = 1, wood_sword = 1, torches = 5, wood = 5. All stats at max. No enchantments or learned spells.
- Map:
    * Place a CRAFTING_TABLE block on a grass tile near the center of Floor 0, e.g., at absolute coordinates (24, 24). This block is accessible without special movement from the spawn point.
- Mechanics:
    * needs_depletion_multiplier = 1.0
    * monsters_killed_to_clear_level = 8
    * melee_spawn_multiplier = 1.0
    * ranged_spawn_multiplier = 1.0
    * All other TaskParams (mob_health_multiplier, mob_damage_multiplier, etc.) remain at their default values.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.PLACE_TABLE,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=1.0,
            monsters_killed_to_clear_level=8,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld) – default center spawn
        builder.set_starting_floor(0)

        # Equip starting inventory: wood pickaxe, wood sword, torches, wood
        builder.set_player_inventory({
            "pickaxe": 1,  # wood pickaxe
            "sword": 1,    # wood sword
            "torches": 5,
            "wood": 5,
        })

        # Place a Crafting Table at the center of the Overworld (24,24)
        builder.place_block(
            level=0,
            block_type=BlockType.CRAFTING_TABLE,
            position=(24, 24),
        )

        # All player stats (health, food, etc.) are already max by default in build()

        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
