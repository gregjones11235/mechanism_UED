 3.883495145631068, "make_diamond_sword": 3.883495145631068, "make_iron_armour": 6.796116504854369, "enter_gnomish_mines": 68.93203883495146, "enter_dungeon": 94.1747572815534, "defeat_orc_solider": 92.71844660194175, "defeat_orc_mage": 89.80582524271844, "eat_snail": 92.23300970873787, "find_bow": 93.68932038834951, "fire_bow": 93.68932038834951, "open_chest": 93.68932038834951, "drink_potion": 77.66990291262135}, "average_episode_length": 1390.0533980582525, "mean_return_percentage": 26.49882290615066, "mean_return": 59.887339767900485, "lp": NaN, "priority_score": 0.214157790555189}]</data>
