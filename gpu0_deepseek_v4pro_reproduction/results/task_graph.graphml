      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to autonomously harvest Overworld resources, craft a weapon, descend to the Dungeon, and defeat enough hostiles to unlock the Gnomish Mines.

Description: The agent starts on the Overworld (floor 0) at the default spawn position with a completely empty inventory, full survival stats (health, food, drink, energy, mana all 9/9), and default attributes (strength=1, dexterity=1, intelligence=1). No torches, tools, weapons, or enchantments are provided. The task mimics the first stage of the full Craftax game: the agent must chop trees to obtain wood, optionally collect stone and other resources, craft at least a wooden sword (or better) at a crafting table, then locate and descend the ladder to floor 1. On floor 1, it must kill the standard 8 melee/ranged Orc enemies (Orc Soldiers and Orc Mages) to satisfy the level‑clear requirement (monsters_killed_to_clear_level = 8), locate the ladder down, and descend to floor 2, thereby achieving ENTER_GNOMISH_MINES. Survival mechanics are present but slowed to 50% of their normal rate (needs_depletion_multiplier = 0.5) so the episode remains combat‑focused rather than a starvation test. All mob spawn multipliers, damage, health, and other world properties are left at default values, providing an authentic early‑game experience.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: (none)

World:
- Player: Starts on floor 0 at (24,24) (center). Inventory: empty. All attributes default. All vital bars full. No weapon or armour enchantments, no learned spells.
- Map: No modifications to the procedurally generated 9‑level world; all floors use standard generation.
- Mechanics:
  - monsters_killed_to_clear_level = 8 (default; ladder down from floor 0 is already open because kill count for floor 0 is initialized to 0)
  - needs_depletion_multiplier = 0.5
  - All other TaskParams remain at their defaults (mob_health_multiplier, mob_damage_multiplier, health_recover_multiplier, mana_recover_multiplier, growing_plants_age = 1.0; melee_trigger_distance = 10; passive/melee/ranged spawn multipliers = 1.0).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = []  # none
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.5,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld)
        builder.set_starting_floor(0)

        # Inventory is empty by default, no need to set anything else

        # No map modifications required

        state = builder.build(rng)

        # No pre‑completed achievements to mark
        return state</data>
