.75, "make_diamond_pickaxe": 5.9375, "make_diamond_sword": 3.4375, "enter_gnomish_mines": 61.5625, "enter_dungeon": 100.0, "defeat_orc_solider": 97.5, "defeat_orc_mage": 87.5, "eat_snail": 97.5, "find_bow": 99.6875, "fire_bow": 99.6875, "open_chest": 99.6875, "drink_potion": 84.375}, "average_episode_length": 818.634375, "mean_return_percentage": 21.44908263620022, "mean_return": 48.4749267578125, "lp": NaN, "priority_score": 0.236630859375}]</data>
