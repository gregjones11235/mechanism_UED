028169014084508, "wake_up": 98.59154929577464, "place_furnace": 99.15492957746478, "collect_coal": 77.1830985915493, "collect_iron": 74.08450704225352, "collect_diamond": 33.23943661971831, "make_iron_pickaxe": 19.718309859154928, "make_iron_sword": 32.67605633802817, "make_arrow": 100.0, "make_torch": 94.08450704225352, "place_torch": 92.11267605633803, "collect_sapphire": 25.633802816901408, "collect_ruby": 32.11267605633803, "make_diamond_pickaxe": 3.6619718309859155, "make_diamond_sword": 4.225352112676056, "enter_gnomish_mines": 61.12676056338028, "enter_dungeon": 100.0, "defeat_orc_solider": 96.90140845070422, "defeat_orc_mage": 90.14084507042253, "eat_snail": 99.43661971830986, "find_bow": 99.15492957746478, "fire_bow": 99.15492957746478, "open_chest": 99.15492957746478, "drink_potion": 87.32394366197182}, "average_episode_length": 772.2394366197183, "mean_return_percentage": 21.376883744391126, "mean_return": 48.311757262323944, "lp": NaN, "priority_score": 0.23761951993652053}]</data>
