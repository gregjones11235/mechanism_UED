      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to gather resources on the Overworld, craft a stone sword and torches, then enter the Dungeon, clear it, and descend to the Gnomish Mines.

Description: The agent starts on floor 0 (Overworld) at its default center position, with an empty inventory and default attributes (strength 1, dexterity 1, intelligence 1). The environment is the standard overworld: grass, trees, water, sand, and stone patches containing coal and iron. The dungeon entrance (ladder‑down) is somewhere in the world, already unlocked. The agent must locate and harvest wood, stone, and coal, then place a crafting table to create a stone sword and at least 4 torches. With these items, it must find the dungeon entrance, descend to floor 1 (Dungeon), navigate the dark corridors, defeat exactly 5 hostile mobs (Orc Soldiers and Orc Mages) to unlock the ladder‑down to floor 2, and finally descend into the Gnomish Mines. Survival needs deplete at 20% of normal speed to keep the focus on preparation and combat. All spawn rates and mob stats remain at default.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: (none)
World:
- Player: Starting floor 0 (`set_starting_floor(0)`). Inventory empty. Attributes default.
- Map: No modifications – the Overworld (floor 0) uses the standard SmoothGen generation, and floor 1 uses the standard Dungeon generation.
- Mechanics:
  - `monsters_killed_to_clear_level = 5` (applies from floor 1 onward; floor 0 is already open by default)
  - `mob_health_multiplier = 1.0`
  - `mob_damage_multiplier = 1.0`
  - `melee_spawn_multiplier = 1.0`
  - `ranged_spawn_multiplier = 1.0`
  - `passive_spawn_multiplier = 1.0`
  - `needs_depletion_multiplier = 0.2`
  - `health_recover_multiplier = 1.0`
  - `health_loss_multiplier = 1.0`
  - `mana_recover_multiplier = 1.0`
  - `growing_plants_age = 600`
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = []   # No pre-completed achievements
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=5,
            needs_depletion_multiplier=0.2,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld) at default centre
        builder.set_starting_floor(0)

        # No inventory modifications needed (starts empty)

        # Floor 0 ladder down is already unlocked: set kills to the global requirement
        builder.set_monsters_killed(level=0, count=5)

        # Floor 1 (Dungeon) must be cleared by the agent: reset kills to 0
        builder.set_monsters_killed(level=1, count=0)

        state = builder.build(rng)

        # No completed achievements to set, so return state as-is
        return state</data>
