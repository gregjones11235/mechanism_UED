turn": 60.105639900128864, "lp": NaN, "priority_score": 0.24139122117121906}, {"session": 133, "sr": 0.6096256684491979, "achievement_srs": {"collect_wood": 100.0, "place_table": 100.0, "eat_cow": 97.86096256684492, "collect_sapling": 100.0, "collect_drink": 98.93048128342247, "make_wood_pickaxe": 99.46524064171123, "make_wood_sword": 98.39572192513369, "place_plant": 100.0, "defeat_zombie": 77.00534759358288, "collect_stone": 97.32620320855615, "place_stone": 97.32620320855615, "eat_plant": 31.550802139037433, "defeat_skeleton": 73.79679144385027, "make_stone_pickaxe": 94.6524064171123, "make_stone_sword": 96.2566844919786, "wake_up": 98.39572192513369, "place_furnace": 97.32620320855615, "collect_coal": 95.72192513368984, "collect_iron": 87.70053475935829, "collect_diamond": 25.13368983957219, "make_iron_pickaxe": 48.663101604278076, "make_iron_sword": 80.74866310160428, "make_arrow": 94.11764705882354, "make_torch": 95.72192513368984, "place_torch": 94.6524064171123, "collect_sapphire": 29.41176470588235, "collect_ruby": 24.59893048128342, "make_diamond_pickaxe": 2.6737967914438503, "make_diamond_sword": 5.882352941176471, "make_iron_armour": 17.112299465240643, "enter_gnomish_mines": 62.5668449197861, "enter_dungeon": 96.2566844919786, "defeat_orc_solider": 94.6524064171123, "defeat_orc_mage": 93.04812834224599, "eat_snail": 93.04812834224599, "find_bow": 94.6524064171123, "fire_bow": 91.44385026737967, "open_chest": 94.6524064171123, "drink_potion": 79.67914438502673}, "average_episode_length": 1506.3636363636363, "mean_return_percentage": 26.556547548625243, "mean_return": 60.017797459893046, "lp": NaN, "priority_score": 0.23798221281706655}]</data>
