      <data key="d3">import jax
import jax.numpy as jnp
from craftax.craftax.constants import Achievement, BlockType, ItemType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to independently locate iron and coal, set up necessary crafting stations, craft an iron pickaxe and iron sword, and then descend to the Gnomish Mines.

Description: The episode begins on the Overworld (floor 0) with the agent having an empty inventory and no pre‑placed crafting stations. The ladder to the Dungeon is already unlocked (`monsters_killed[0]` set to 8). To succeed, the agent must first collect wood (`COLLECT_WOOD`), craft a Wood Pickaxe and Wood Sword, mine stone, craft a Stone Pickaxe, locate coal and iron ore deposits, place a Crafting Table (using 2 wood) and a Furnace (using 1 stone), then craft an Iron Pickaxe and an Iron Sword using both stations. After crafting both iron tools, the agent must find the ladder down on floor 0 (marked by the already‑unlocked clearance) and use `DESCEND` to enter the Dungeon (floor 1). On floor 1 a ladder down to floor 2 is guaranteed to be placed on a PATH block within Manhattan distance 2–10 from the entry point. The agent must defeat at least 8 hostile mobs (standard Orc Soldiers and Orc Mages on floor 1) to clear the floor, step on that ladder, and `DESCEND` again, thereby unlocking `ENTER_GNOMISH_MINES` and completing the task. Survival needs are heavily reduced (`needs_depletion_multiplier = 0.25`, `health_recover_multiplier = 2.0`) to keep the focus strictly on resource gathering, crafting, and combat.

Relevant Achievements: MAKE_IRON_PICKAXE, MAKE_IRON_SWORD, ENTER_DUNGEON, ENTER_GNOMISH_MINES
Completed Achievements: (none)

World:
- Player:
  - Starting floor = 0.
  - Inventory: completely empty (all counts 0).
  - Stats: dexterity=1, strength=1, intelligence=1.
  - `set_monsters_killed(level=0, count=8)` – Ladder down to floor 1 is immediately usable, no overworld combat required.
- Map:
  - Level 0:
    - Place 6 Iron Ore blocks using `place_randomly_near(rng, 0, BlockType.IRON, player_spawn, min_dist=8, max_dist=25, n=6, on_blocks=[BlockType.STONE])`.
    - Place 5 Coal Ore blocks using `place_randomly_near(rng, 0, BlockType.COAL, player_spawn, min_dist=8, max_dist=25, n=5, on_blocks=[BlockType.STONE])`.
  - Level 1:
    - Place 1 LADDER_DOWN using `place_randomly_near(rng, 1, BlockType.LADDER_DOWN, target_pos=player_spawn_on_floor1, min_dist=2, max_dist=10, n=1, on_blocks=[BlockType.PATH])`.
- Mechanics:
  - `melee_spawn_multiplier = 1.0`
  - `ranged_spawn_multiplier = 1.0`
  - `passive_spawn_multiplier = 1.0`
  - `mob_health_multiplier = 1.0`
  - `mob_damage_multiplier = 1.0`
  - `needs_depletion_multiplier = 0.25`
  - `health_recover_multiplier = 2.0`
  - `monsters_killed_to_clear_level = 8` (default; effective for floor 1 to require 8 kills)
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.MAKE_IRON_PICKAXE,
            Achievement.MAKE_IRON_SWORD,
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = []   # No pre-completed achievements
        self.label = "MAKE_IRON_PICKAXE, MAKE_IRON_SWORD, ENTER_DUNGEON, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.25,
            health_recover_multiplier=2.0,
            monsters_killed_to_clear_level=8,  # default but explicit
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        # Split the rng into independent keys for different random operations
        rng, rng_build, rng_iron, rng_coal, rng_ladder, rng_build_final = jax.random.split(rng, 6)

        builder = WorldBuilder(rng_build, self.static_params, self.params)

        # Start on floor 0 (Overworld) at the default centre
        builder.set_starting_floor(0)

        # The inventory is already empty because god_mode is False and we don't call set_player_inventory.
        # Ensure the ladder down to floor 1 is immediately usable
        builder.set_monsters_killed(level=0, count=8)

        player_spawn = builder.player_position

        # Place iron ore deposits near the spawn, on Stone blocks
        builder.place_randomly_near(
            rng_iron,
            level=0,
            block_type=BlockType.IRON,
            target_pos=player_spawn,
            min_dist=8,
            max_dist=25,
            n=6,
            on_blocks=[BlockType.STONE],
        )

        # Place coal ore deposits near the spawn, on Stone blocks
        builder.place_randomly_near(
            rng_coal,
            level=0,
            block_type=BlockType.COAL,
            target_pos=player_spawn,
            min_dist=8,
            max_dist=25,
            n=5,
            on_blocks=[BlockType.STONE],
        )

        state = builder.build(rng_build_final)

        # ------------------------------------------------------------
        # Guarantee a ladder down on floor 1 near the entry point
        # ------------------------------------------------------------
        # The entry point on floor 1 is the position of the up-ladder.
        entry_pos_floor1 = state.up_ladders[1]

        map_floor1 = state.map[1]
        rows, cols = jnp.indices(self.static_params.map_size)
        dist = jnp.abs(rows - entry_pos_floor1[0]) + jnp.abs(cols - entry_pos_floor1[1])
        in_range_mask = (dist &gt;= 2) &amp; (dist &lt;= 10)
        path_mask = map_floor1 == BlockType.PATH.value
        valid_mask = in_range_mask &amp; path_mask

        num_valid = valid_mask.sum()
        # If no valid cell, keep original (should not happen with a normal dungeon)
        # Uniform random choice among valid cells
        flat_probs = valid_mask.astype(jnp.float32).flatten()
        probs = jnp.where(num_valid &gt; 0, flat_probs / num_valid, 0.0)
        chosen_flat_idx = jax.random.choice(rng_ladder, a=flat_probs.shape[0], p=probs)
        ladder_row = chosen_flat_idx // self.static_params.map_size[1]
        ladder_col = chosen_flat_idx % self.static_params.map_size[1]

        # Place the ladder item only if we actually found a valid cell (always true here)
        new_item_map = state.item_map.at[1, ladder_row, ladder_col].set(
            ItemType.LADDER_DOWN.value
        )
        state = state.replace(item_map=new_item_map)

        # No pre-completed achievements to set
        return state</data>
