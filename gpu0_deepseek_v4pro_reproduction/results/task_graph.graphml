, "open_chest": 99.6415770609319, "drink_potion": 89.24731182795699}, "average_episode_length": 1052.2186379928316, "mean_return_percentage": 20.489413092349416, "mean_return": 46.30607358870968, "lp": NaN, "priority_score": 0.2499710949242687}, {"session": 148, "sr": 0.5601503759398496, "achievement_srs": {"collect_wood": 57.142857142857146, "place_table": 56.390977443609025, "eat_cow": 62.40601503759399, "collect_sapling": 57.142857142857146, "collect_drink": 95.48872180451127, "make_wood_pickaxe": 65.0375939849624, "make_wood_sword": 100.0, "place_plant": 57.142857142857146, "defeat_zombie": 30.827067669172934, "collect_stone": 57.142857142857146, "place_stone": 56.390977443609025, "eat_plant": 11.278195488721805, "defeat_skeleton": 24.06015037593985, "make_stone_pickaxe": 59.3984962406015, "make_stone_sword": 100.0, "wake_up": 99.24812030075188, "place_furnace": 57.142857142857146, "collect_coal": 75.93984962406014, "collect_iron": 74.43609022556392, "collect_diamond": 40.97744360902256, "make_iron_pickaxe": 26.69172932330827, "make_iron_sword": 42.10526315789474, "make_arrow": 86.84210526315789, "make_torch": 96.99248120300751, "place_torch": 95.11278195488721, "collect_sapphire": 31.57894736842105, "collect_ruby": 36.090225563909776, "make_diamond_pickaxe": 5.639097744360902, "make_diamond_sword": 6.7669172932330826, "enter_gnomish_mines": 56.015037593984964, "enter_dungeon": 100.0, "defeat_orc_solider": 95.86466165413533, "defeat_orc_mage": 90.97744360902256, "eat_snail": 98.49624060150376, "find_bow": 99.62406015037594, "fire_bow": 86.09022556390977, "open_chest": 99.62406015037594, "drink_potion": 88.7218045112782}, "average_episode_length": 1006.5751879699249, "mean_return_percentage": 21.494610744747654, "mean_return": 48.5778202831297, "lp": NaN, "priority_score": 0.24638193227429475}]</data>
