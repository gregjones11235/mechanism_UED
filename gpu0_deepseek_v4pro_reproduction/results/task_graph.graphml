defeat_skeleton": 65.06024096385542, "make_stone_pickaxe": 94.77911646586345, "make_stone_sword": 97.59036144578313, "wake_up": 99.59839357429719, "place_furnace": 100.0, "collect_coal": 93.1726907630522, "collect_iron": 85.5421686746988, "collect_diamond": 28.11244979919679, "make_iron_pickaxe": 25.70281124497992, "make_iron_sword": 53.81526104417671, "make_arrow": 95.58232931726907, "make_torch": 95.9839357429719, "place_torch": 95.18072289156626, "collect_sapphire": 30.120481927710845, "collect_ruby": 26.50602409638554, "make_diamond_pickaxe": 5.622489959839357, "make_diamond_sword": 3.6144578313253013, "make_iron_armour": 4.819277108433735, "enter_gnomish_mines": 47.389558232931726, "enter_dungeon": 97.18875502008032, "defeat_orc_solider": 92.36947791164658, "defeat_orc_mage": 86.74698795180723, "eat_snail": 93.57429718875503, "find_bow": 96.78714859437751, "fire_bow": 92.7710843373494, "open_chest": 96.78714859437751, "drink_potion": 81.52610441767068}, "average_episode_length": 1146.3935742971887, "mean_return_percentage": 24.68986843391264, "mean_return": 55.79910266064257, "lp": NaN, "priority_score": 0.24931855937807454}]</data>
