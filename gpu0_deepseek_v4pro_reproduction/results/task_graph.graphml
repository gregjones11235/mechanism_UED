      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Defeat an Orc Mage while also facing an Orc Soldier, using a bow and a melee weapon, to practice mixed‑enemy combat in a dungeon.

    Description: The agent spawns on Floor 1 (Dungeon) equipped with a bow, 10 arrows, and a wood sword. All survival needs are disabled and no other mobs can spawn. In addition to the usual Orc Mage (ranged), a single Orc Soldier (melee) is placed 5 to 8 tiles from the starting position. The agent must locate both enemies, avoid the mage’s projectiles, engage the soldier, and kill the mage to complete the task. The floor‑clear requirement is set to 1 so that killing the mage also unlocks the ladder down, reinforcing progression. This task extends the isolated bow‑mage combat by introducing an additional melee threat and a starting sword, training target prioritisation and weapon switching for more realistic dungeon encounters.

    Relevant Achievements: DEFEAT_ORC_MAGE
    Completed Achievements: FIND_BOW
    World:
    - Player: Floor 1 (spawn at ladder‑up position). Inventory: {"bow": 1, "arrows": 10, "sword": 1}. Stats: Strength 1, Dexterity 1, Intelligence 1. Health/Food/Drink/Energy/Mana all full (9/9). Learned spells: none. Weapon/Armour enchantments: none.
    - Map:
        - Use default Dungeon generation for Floor 1.
        - Place exactly one melee mob (Orc Soldier, "melee", type_id=2) using `add_mobs_randomly_near`, with target_pos = player spawn coordinates, n=1, min_dist=5, max_dist=8, on_blocks = [BlockType.PATH].
        - Place exactly one ranged mob (Orc Mage, "ranged", type_id=2) using `add_mobs_randomly_near`, with target_pos = player spawn coordinates, n=1, min_dist=5, max_dist=8, on_blocks = [BlockType.PATH].
        - No other mobs are placed.
    - Mechanics:
        "needs_depletion_multiplier": 0.0,
        "melee_spawn_multiplier": 0.0,
        "ranged_spawn_multiplier": 0.0,
        "passive_spawn_multiplier": 0.0,
        "monsters_killed_to_clear_level": 1,
        "health_recover_multiplier": 1.0,
        "mob_health_multiplier": 1.0,
        "mob_damage_multiplier": 1.0
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.DEFEAT_ORC_MAGE]
        self.completed_achievements = [Achievement.FIND_BOW]
        self.label = "DEFEAT_ORC_MAGE"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            passive_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=1,
            # health_recover_multiplier=1.0, mob_health_multiplier=1.0, mob_damage_multiplier=1.0 are defaults
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, melee_rng, ranged_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(1)
        builder.set_player_inventory({"bow": 1, "arrows": 10, "sword": 1})

        # Place Orc Soldier (melee, type_id=2)
        builder.add_mobs_randomly_near(
            melee_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=1,
            target_pos=builder.player_position,
            min_dist=5,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        # Place Orc Mage (ranged, type_id=2)
        builder.add_mobs_randomly_near(
            ranged_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=1,
            target_pos=builder.player_position,
            min_dist=5,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        return builder.build(rng)</data>
