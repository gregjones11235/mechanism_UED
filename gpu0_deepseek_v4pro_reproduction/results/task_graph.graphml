69, "collect_stone": 97.74011299435028, "place_stone": 97.74011299435028, "eat_plant": 36.72316384180791, "defeat_skeleton": 79.66101694915254, "make_stone_pickaxe": 95.48022598870057, "make_stone_sword": 96.045197740113, "wake_up": 98.87005649717514, "place_furnace": 97.17514124293785, "collect_coal": 96.61016949152543, "collect_iron": 92.090395480226, "collect_diamond": 30.508474576271187, "make_iron_pickaxe": 79.09604519774011, "make_iron_sword": 89.26553672316385, "make_arrow": 96.045197740113, "make_torch": 96.045197740113, "place_torch": 95.48022598870057, "collect_sapphire": 30.508474576271187, "collect_ruby": 28.8135593220339, "make_diamond_pickaxe": 6.214689265536723, "make_diamond_sword": 6.214689265536723, "make_iron_armour": 49.152542372881356, "enter_gnomish_mines": 71.75141242937853, "enter_dungeon": 97.74011299435028, "defeat_orc_solider": 96.61016949152543, "defeat_orc_mage": 93.78531073446328, "eat_snail": 96.61016949152543, "find_bow": 97.74011299435028, "fire_bow": 95.48022598870057, "open_chest": 97.74011299435028, "drink_potion": 86.44067796610169}, "average_episode_length": 1529.406779661017, "mean_return_percentage": 28.358774932347135, "mean_return": 64.09083134710453, "lp": NaN, "priority_score": 0.2240735420856076}]</data>
