      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to survive, fight Gnome Warriors and Gnome Archers in the dark Gnomish Mines, and descend to the Sewers.

Description: The agent starts on Floor 2 (Gnomish Mines) at the ladder‑up position. The inventory contains stone sword (1), bow (1), arrows (10), torches (4), and snail (2) for food. All survival meters (health, food, drink, energy, mana) are full (9/9). The Gnomish Mines are pitch black (light level 0.0), so the agent must use torches to see and navigate. Hostile mobs spawn at moderate rates: melee spawn multiplier 0.5 (Gnome Warriors, type_id 1) and ranged spawn multiplier 0.5 (Gnome Archers, type_id 1). Passive bats spawn with multiplier 1.0, providing an additional food source. Survival needs are slightly increased (needs_depletion_multiplier = 0.5) and health recovery remains boosted (health_recover_multiplier = 2.0). The level‑clear requirement is 4 kills (monsters_killed_to_clear_level = 4). The agent must defeat at least one Gnome Warrior and one Gnome Archer, unlocking those achievements, and then descend via the ladder down to Floor 3 (Sewers) to trigger ENTER_SEWERS. The episode succeeds only when the agent achieves ENTER_SEWERS.

Relevant Achievements: DEFEAT_GNOME_WARRIOR, DEFEAT_GNOME_ARCHER, ENTER_SEWERS
Completed Achievements: ENTER_DUNGEON, ENTER_GNOMISH_MINES, MAKE_STONE_SWORD, FIND_BOW, MAKE_ARROW, MAKE_TORCH, EAT_SNAIL

World:
- Player: Starting floor 2; inventory: `{"stone_sword": 1, "bow": 1, "arrows": 10, "torches": 4, "snail": 2}`; all survival stats 9/9.
- Map: No block modifications; the standard Gnomish Mines layout is used.
- Mechanics:
    "melee_spawn_multiplier": 0.5,
    "ranged_spawn_multiplier": 0.5,
    "passive_spawn_multiplier": 1.0,
    "needs_depletion_multiplier": 0.5,
    "health_recover_multiplier": 2.0,
    "monsters_killed_to_clear_level": 4
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.DEFEAT_GNOME_WARRIOR,
            Achievement.DEFEAT_GNOME_ARCHER,
            Achievement.ENTER_SEWERS,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
            Achievement.MAKE_STONE_SWORD,
            Achievement.FIND_BOW,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_TORCH,
            Achievement.EAT_SNAIL,
        ]
        self.label = "DEFEAT_GNOME_WARRIOR, DEFEAT_GNOME_ARCHER, ENTER_SEWERS"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=0.5,
            ranged_spawn_multiplier=0.5,
            passive_spawn_multiplier=1.0,
            needs_depletion_multiplier=0.5,
            health_recover_multiplier=2.0,
            monsters_killed_to_clear_level=4,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines) at the up‑ladder position
        builder.set_starting_floor(2)

        # Set starting inventory: stone sword (tier 2), bow, arrows, torches
        builder.set_player_inventory({
            "sword": 2,
            "bow": 1,
            "arrows": 10,
            "torches": 4,
        })

        # No custom block or mob placements; use default world generation

        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
