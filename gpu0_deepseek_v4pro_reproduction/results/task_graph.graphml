      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Master melee and anti‑ranged combat in the dark Gnomish Mines by defeating one Gnome Warrior and one Gnome Archer with only a stone sword and torches, forcing the agent to survive the higher damage output of Floor 2 mobs.

Description: The agent starts on Floor 2 (the Gnomish Mines) at the Ladder‑Up position, holding a stone sword (tier 2, inventory: `{"sword": 2, "torches": 10}`). All stats are maxed (health 9, food 9, drink 9, energy 9, mana 9) and attributes are base (strength=1, dexterity=1, intelligence=1). Two Gnomes are hand‑placed on PATH tiles within Manhattan distance 5–10 from the start: one Gnome Warrior (melee, type_id=1) and one Gnome Archer (ranged, type_id=1). Natural spawns for all mob types are completely disabled (`passive_spawn_multiplier = 0.0`, `melee_spawn_multiplier = 0.0`, `ranged_spawn_multiplier = 0.0`), so no extra enemies appear. The Gnomish Mines are pitch‑black (default light level 0.0), and the agent must place torches to illuminate the area and reduce the darkness‑based melee spawn bonus (though spawning itself is off, the bonus does not apply). The level‑clear requirement is `monsters_killed_to_clear_level = 2`, exactly the two hand‑placed Gnomes. Killing both Gnomes clears the level and marks the relevant achievements as completed, ending the episode successfully. The task isolates the core combat challenge: facing a melee attacker with 9 HP and 4 damage alongside a ranged kiting enemy with 6 HP and 2 damage, using only a stone sword and player‑placed light sources.

Relevant Achievements: DEFEAT_GNOME_WARRIOR, DEFEAT_GNOME_ARCHER

Completed Achievements: ENTER_DUNGEON, ENTER_GNOMISH_MINES, MAKE_WOOD_SWORD, MAKE_STONE_SWORD, MAKE_TORCH

World:
- Player: Start on floor 2. Inventory: `{"sword": 2, "torches": 10}`. All stats maxed, attributes 1/1/1.
- Map: `builder.set_monsters_killed(level=2, count=0)`.
  Hand‑place Gnome Warrior: `builder.add_mobs_randomly_near(rng, 2, "melee", 1, n=1, target_pos=player_start_pos, min_dist=5, max_dist=10, on_blocks=[BlockType.PATH])`.
  Hand‑place Gnome Archer: `builder.add_mobs_randomly_near(rng, 2, "ranged", 1, n=1, target_pos=player_start_pos, min_dist=5, max_dist=10, on_blocks=[BlockType.PATH])`.
- Mechanics: `passive_spawn_multiplier = 0.0`, `melee_spawn_multiplier = 0.0`, `ranged_spawn_multiplier = 0.0`. `monsters_killed_to_clear_level = 2`. `mob_health_multiplier = 1.0`, `mob_damage_multiplier = 1.0`. All other TaskParams at defaults.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.DEFEAT_GNOME_WARRIOR,
            Achievement.DEFEAT_GNOME_ARCHER,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_TORCH,
        ]
        self.label = "DEFEAT_GNOME_WARRIOR, DEFEAT_GNOME_ARCHER"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=0.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=2,
            # mob_health_multiplier and mob_damage_multiplier are explicitly 1.0 (default)
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, mob_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines) at the up-ladder position
        builder.set_starting_floor(2)

        # Equip stone sword and torches
        builder.set_player_inventory({
            "sword": 2,     # stone sword (tier 2)
            "torches": 10,
        })

        # No monsters have been killed yet on floor 2, so the ladder down is locked until 2 kills
        builder.set_monsters_killed(level=2, count=0)

        # Player spawn position is the up-ladder location
        start_pos = builder.player_position

        # Hand-place Gnome Warrior (melee, type_id=1) within Manhattan distance 5-10
        rng, _rng1, _rng2 = jax.random.split(mob_rng, 3)
        builder.add_mobs_randomly_near(
            _rng1,
            level=2,
            mob_name="melee",
            type_id=1,
            n=1,
            target_pos=start_pos,
            min_dist=5,
            max_dist=10,
            on_blocks=[BlockType.PATH],
        )

        # Hand-place Gnome Archer (ranged, type_id=1) within Manhattan distance 5-10
        builder.add_mobs_randomly_near(
            _rng2,
            level=2,
            mob_name="ranged",
            type_id=1,
            n=1,
            target_pos=start_pos,
            min_dist=5,
            max_dist=10,
            on_blocks=[BlockType.PATH],
        )

        state = builder.build(rng)

        # Mark pre-completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
      <data key="d4">[{"session": 125, "sr": 0.0, "achievement_srs": {"collect_wood": 55.167394468704515, "place_table": 52.838427947598255, "collect_sapling": 53.42066957787482, "collect_drink": 96.94323144104804, "make_wood_pickaxe": 66.37554585152839, "place_plant": 53.12954876273653, "collect_stone": 52.256186317321685, "place_stone": 49.92721979621543, "eat_plant": 0.14556040756914118, "make_stone_pickaxe": 53.12954876273653, "wake_up": 84.27947598253274, "place_furnace": 51.67394468704512, "collect_coal": 77.00145560407569, "collect_iron": 71.32459970887919, "collect_diamond": 35.662299854439595, "make_iron_pickaxe": 27.802037845705968, "make_iron_sword": 30.56768558951965, "make_arrow": 82.24163027656478, "place_torch": 99.85443959243086, "collect_sapphire": 28.675400291120816, "collect_ruby": 30.42212518195051, "make_diamond_pickaxe": 3.63901018922853, "enter_gnomish_mines": 100.0, "enter_dungeon": 100.0, "find_bow": 99.85443959243086, "fire_bow": 80.78602620087337, "open_chest": 99.85443959243086, "drink_potion": 92.28529839883552}, "average_episode_length": 413.18195050946144, "mean_return_percentage": 10.315253536159846, "mean_return": 23.31247299172125, "lp": NaN, "priority_score": 0.0}]</data>
