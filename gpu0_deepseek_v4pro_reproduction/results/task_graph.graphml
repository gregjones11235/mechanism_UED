7383966244726, "make_stone_sword": 76.79324894514768, "wake_up": 98.31223628691983, "place_furnace": 94.09282700421942, "collect_coal": 83.54430379746836, "collect_iron": 63.29113924050633, "collect_diamond": 26.160337552742615, "make_iron_pickaxe": 20.675105485232066, "make_iron_sword": 33.333333333333336, "make_arrow": 87.34177215189874, "make_torch": 90.29535864978902, "place_torch": 88.18565400843882, "collect_sapphire": 18.565400843881857, "collect_ruby": 16.877637130801688, "make_diamond_pickaxe": 2.9535864978902953, "make_diamond_sword": 3.3755274261603376, "make_iron_armour": 2.5316455696202533, "enter_gnomish_mines": 32.91139240506329, "enter_dungeon": 95.35864978902954, "defeat_orc_solider": 90.29535864978902, "defeat_orc_mage": 74.68354430379746, "eat_snail": 91.13924050632912, "find_bow": 94.09282700421942, "fire_bow": 85.65400843881856, "open_chest": 94.09282700421942, "drink_potion": 73.83966244725738}, "average_episode_length": 1180.253164556962, "mean_return_percentage": 20.740845961805945, "mean_return": 46.874311873681435, "lp": NaN, "priority_score": 0.22079794904662714}]</data>
