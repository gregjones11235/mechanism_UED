d": 32.758620689655174, "make_iron_pickaxe": 22.126436781609197, "make_iron_sword": 31.32183908045977, "make_torch": 93.67816091954023, "place_torch": 91.95402298850574, "collect_sapphire": 32.18390804597701, "collect_ruby": 31.03448275862069, "make_diamond_pickaxe": 5.747126436781609, "make_diamond_sword": 5.459770114942529, "make_iron_armour": 1.4367816091954022, "enter_gnomish_mines": 62.93103448275862, "enter_dungeon": 100.0, "defeat_orc_solider": 99.42528735632185, "defeat_orc_mage": 95.40229885057471, "eat_snail": 86.7816091954023, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 98.85057471264368, "drink_potion": 88.2183908045977}, "average_episode_length": 764.2270114942529, "mean_return_percentage": 20.16835744790077, "mean_return": 45.58048783225575, "lp": NaN, "priority_score": 0.23327883472057076}]</data>
