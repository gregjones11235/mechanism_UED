      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Craft an iron sword and then descend into the dungeon from the Overworld.

Description: The agent starts on Floor 0 (Overworld) at the map centre. It is equipped with a stone pickaxe and a small amount of wood and stone. A Crafting Table and a Furnace have been pre‑placed adjacent to the spawn point, and several coal and iron ore blocks are within a few tiles’ reach. No mobs spawn on any floor, and survival needs deplete very slowly. The agent must gather at least one coal and one iron ore, craft an iron sword (requiring close proximity to both the Table and Furnace), then locate the overworld ladder down and perform the DESCEND action to enter the dungeon. The task exercises self‑sufficient iron‑sword crafting and overworld‑to‑dungeon navigation in a low‑pressure environment, setting the stage for later combination with dungeon combat.

Relevant Achievements: MAKE_IRON_SWORD, ENTER_DUNGEON

Completed Achievements: []

World:
- Player:  
  - `builder.set_starting_floor(0)`  
  - Inventory: `{"pickaxe": 2, "wood": 5, "stone": 3}` (stone pickaxe, basic materials)  
  - All other attributes default.
- Map:  
  - `builder.place_block(0, BlockType.CRAFTING_TABLE, (33, 33))`  
  - `builder.place_block(0, BlockType.FURNACE, (33, 34))`  
  - Coal ore blocks:  
    `builder.place_block(0, BlockType.COAL, (33, 32))`  
    `builder.place_block(0, BlockType.COAL, (34, 32))`  
    `builder.place_block(0, BlockType.COAL, (35, 32))`  
    `builder.place_block(0, BlockType.COAL, (32, 34))`  
  - Iron ore blocks:  
    `builder.place_block(0, BlockType.IRON, (36, 32))`  
    `builder.place_block(0, BlockType.IRON, (35, 33))`  
    `builder.place_block(0, BlockType.IRON, (34, 34))`  
    `builder.place_block(0, BlockType.IRON, (37, 33))`  
  - No other map modifications; dungeon generation on Floor 1 remains default.
- Mechanics:  
  - `melee_spawn_multiplier = 0.0`  
  - `ranged_spawn_multiplier = 0.0`  
  - `passive_spawn_multiplier = 0.0`  
  - `needs_depletion_multiplier = 0.2`  
  - All other TaskParams left at default (health/damage multipliers 1.0, etc.).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.MAKE_IRON_SWORD,
            Achievement.ENTER_DUNGEON,
        ]
        self.completed_achievements = []
        self.label = "MAKE_IRON_SWORD, ENTER_DUNGEON"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            passive_spawn_multiplier=0.0,
            needs_depletion_multiplier=0.2,
            # All other parameters remain at their default values
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on the overworld (floor 0) at default centre position
        builder.set_starting_floor(0)

        # Initial inventory: stone pickaxe, wood, stone
        builder.set_player_inventory({"pickaxe": 2, "wood": 5, "stone": 3})

        # Place crafting table and furnace adjacent to each other
        builder.place_block(0, BlockType.CRAFTING_TABLE, (33, 33))
        builder.place_block(0, BlockType.FURNACE, (33, 34))

        # Place coal ore blocks within reach
        builder.place_block(0, BlockType.COAL, (33, 32))
        builder.place_block(0, BlockType.COAL, (34, 32))
        builder.place_block(0, BlockType.COAL, (35, 32))
        builder.place_block(0, BlockType.COAL, (32, 34))

        # Place iron ore blocks within reach
        builder.place_block(0, BlockType.IRON, (36, 32))
        builder.place_block(0, BlockType.IRON, (35, 33))
        builder.place_block(0, BlockType.IRON, (34, 34))
        builder.place_block(0, BlockType.IRON, (37, 33))

        # Build and return the initial state
        state = builder.build(rng)
        return state</data>
