_iron_pickaxe": 88.31168831168831, "make_iron_sword": 97.40259740259741, "make_arrow": 99.35064935064935, "make_torch": 97.40259740259741, "place_torch": 96.75324675324676, "collect_sapphire": 33.76623376623377, "collect_ruby": 22.727272727272727, "make_diamond_pickaxe": 3.2467532467532467, "make_diamond_sword": 7.142857142857143, "make_iron_armour": 55.84415584415584, "enter_gnomish_mines": 77.92207792207792, "enter_dungeon": 94.15584415584415, "defeat_orc_solider": 92.85714285714286, "defeat_orc_mage": 92.85714285714286, "eat_snail": 92.85714285714286, "find_bow": 94.15584415584415, "fire_bow": 94.15584415584415, "open_chest": 94.15584415584415, "drink_potion": 85.71428571428571}, "average_episode_length": 1805.7922077922078, "mean_return_percentage": 26.246329332655726, "mean_return": 59.31670429180195, "lp": NaN, "priority_score": 0.21453870804520156}]</data>
