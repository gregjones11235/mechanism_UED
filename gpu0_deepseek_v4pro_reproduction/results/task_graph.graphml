ur": 3.2, "enter_gnomish_mines": 51.2, "enter_dungeon": 96.4, "defeat_orc_solider": 91.6, "defeat_orc_mage": 87.2, "eat_snail": 93.2, "find_bow": 95.6, "fire_bow": 92.0, "open_chest": 95.6, "drink_potion": 74.8}, "average_episode_length": 1144.772, "mean_return_percentage": 24.3875483960177, "mean_return": 55.115859375, "lp": NaN, "priority_score": 0.249856}, {"session": 134, "sr": 0.4899598393574297, "achievement_srs": {"collect_wood": 100.0, "place_table": 100.0, "eat_cow": 95.9839357429719, "collect_sapling": 100.0, "collect_drink": 97.99196787148594, "make_wood_pickaxe": 99.19678714859438, "make_wood_sword": 95.18072289156626, "place_plant": 100.0, "defeat_zombie": 76.30522088353413, "collect_stone": 98.39357429718875, "place_stone": 97.99196787148594, "eat_plant": 15.662650602409638, "defeat_skeleton": 66.26506024096386, "make_stone_pickaxe": 86.74698795180723, "make_stone_sword": 86.74698795180723, "wake_up": 99.59839357429719, "place_furnace": 98.39357429718875, "collect_coal": 90.76305220883535, "collect_iron": 70.68273092369478, "collect_diamond": 26.104417670682732, "make_iron_pickaxe": 21.285140562248998, "make_iron_sword": 34.53815261044177, "make_arrow": 89.95983935742971, "make_torch": 92.7710843373494, "place_torch": 92.7710843373494, "collect_sapphire": 24.899598393574298, "collect_ruby": 27.710843373493976, "make_diamond_pickaxe": 2.8112449799196786, "make_diamond_sword": 2.4096385542168677, "enter_gnomish_mines": 48.99598393574297, "enter_dungeon": 96.78714859437751, "defeat_orc_solider": 92.36947791164658, "defeat_orc_mage": 87.95180722891567, "eat_snail": 93.97590361445783, "find_bow": 94.37751004016064, "fire_bow": 86.74698795180723, "open_chest": 94.37751004016064, "drink_potion": 80.32128514056225}, "average_episode_length": 1135.0441767068273, "mean_return_percentage": 24.16975354404343, "mean_return": 54.62364300953815, "lp": NaN, "priority_score": 0.2498991951742714}, {"session": 136, "sr": 0.4602510460251046, "achievement_srs": {"collect_w