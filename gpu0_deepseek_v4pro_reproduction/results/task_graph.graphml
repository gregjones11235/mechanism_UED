_diamond_pickaxe": 5.787781350482315, "make_diamond_sword": 5.144694533762058, "enter_gnomish_mines": 62.057877813504824, "enter_dungeon": 100.0, "defeat_orc_solider": 98.39228295819936, "defeat_orc_mage": 93.89067524115755, "eat_snail": 98.39228295819936, "find_bow": 99.35691318327974, "fire_bow": 98.39228295819936, "open_chest": 99.35691318327974, "drink_potion": 84.88745980707395}, "average_episode_length": 907.9453376205788, "mean_return_percentage": 22.462917412873832, "mean_return": 50.766193353094856, "lp": NaN, "priority_score": 0.2354607582634588}]</data>
