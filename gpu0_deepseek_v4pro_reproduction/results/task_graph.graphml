make_stone_sword": 94.06631762652705, "wake_up": 74.86910994764398, "place_furnace": 99.12739965095986, "collect_coal": 96.68411867364748, "collect_iron": 93.717277486911, "collect_diamond": 5.4101221640488655, "make_iron_pickaxe": 86.91099476439791, "make_iron_sword": 24.25828970331588, "make_arrow": 83.0715532286213, "make_torch": 86.38743455497382, "place_torch": 80.97731239092495, "collect_sapphire": 5.5846422338568935, "collect_ruby": 5.5846422338568935, "make_diamond_pickaxe": 0.6980802792321117, "make_diamond_sword": 0.8726003490401396, "make_iron_armour": 2.268760907504363, "enter_dungeon": 65.09598603839441, "defeat_orc_solider": 10.471204188481675, "defeat_orc_mage": 4.712041884816754, "eat_snail": 22.338568935427574, "find_bow": 61.78010471204188, "fire_bow": 49.040139616055846, "open_chest": 61.78010471204188, "drink_potion": 25.654450261780106}, "average_episode_length": 490.8621291448517, "mean_return_percentage": 19.64650726989992, "mean_return": 44.40110642997382, "lp": NaN, "priority_score": 0.11632234740153935}]</data>
