      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Clear floor 1 of normal‑strength Orc Soldiers and Mages while managing moderate survival needs, then descend into the Gnomish Mines.

    Description: The agent begins on the first dungeon floor (level 1) at the ladder‑up position, already equipped with stone weapons, a bow, and a modest stockpile of arrows and basic materials. A fountain and a crafting table are spawned a few tiles away so thirst can be quenched and arrows replenished locally. The primary challenge is to defeat 8 hostile Orc Soldiers (melee) and Orc Mages (ranged) that now have their natural health and damage (multiplier 1.0). Survival pressure is turned up to moderate: hunger, thirst, and fatigue accumulate at half the original rate (multiplier 0.5), forcing the agent to occasionally drink from the fountain and perhaps craft or eat food. All other enemy spawn rates are kept at default (1.0 for melee and ranged, 0.0 for passive mobs). Success is determined by reaching the descending ladder and entering the Gnomish Mines (achievement `ENTER_GNOMISH_MINES`).

    Relevant Achievements: ENTER_GNOMISH_MINES
    Completed Achievements: ENTER_DUNGEON, MAKE_STONE_SWORD, MAKE_STONE_PICKAXE, FIND_BOW

    World:
    - Player: Starting floor 1 (dungeon) at the ladder‑up position. Inventory: {"stone_sword": 1, "stone_pickaxe": 1, "bow": 1, "arrows": 20, "wood": 10, "stone": 10}. All attributes at 1, full health, food, drink, energy, and mana (9 each). No enchantments, no spells learned.
    - Map:
      - place_randomly_near: floor 1, BlockType.FOUNTAIN, target_pos=None (player start), min_dist=2, max_dist=5, n=1, on_blocks=[BlockType.PATH]
      - place_randomly_near: floor 1, BlockType.CRAFTING_TABLE, target_pos=None, min_dist=2, max_dist=5, n=1, on_blocks=[BlockType.PATH]
      - No other manual block modifications; natural dungeon generation provides walls, paths, chests, torches, and the two ladders.
    - Mechanics:
      - monsters_killed_to_clear_level = 8
      - mob_health_multiplier = 1.0
      - mob_damage_multiplier = 1.0
      - melee_spawn_multiplier = 1.0
      - ranged_spawn_multiplier = 1.0
      - passive_spawn_multiplier = 0.0 (no passive mobs on this floor)
      - needs_depletion_multiplier = 0.5
      - health_recover_multiplier = 1.0
      - mana_recover_multiplier = 1.0
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_GNOMISH_MINES]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.FIND_BOW,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=0.0,
            needs_depletion_multiplier=0.5,
            health_recover_multiplier=1.0,
            mana_recover_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, fountain_rng, table_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(1)

        # Set up inventory with stone weapons, bow, arrows, wood, stone
        builder.set_player_inventory({
            "pickaxe": 2,   # 2 = stone pickaxe
            "sword": 2,     # 2 = stone sword
            "bow": 1,       # 1 = bow
            "arrows": 20,
            "wood": 10,
            "stone": 10,
        })

        # Place a fountain near the player start
        builder.place_randomly_near(
            fountain_rng,
            level=1,
            block_type=BlockType.FOUNTAIN,
            target_pos=builder.player_position,
            min_dist=2,
            max_dist=5,
            n=1,
            on_blocks=[BlockType.PATH],
        )

        # Place a crafting table near the player start
        builder.place_randomly_near(
            table_rng,
            level=1,
            block_type=BlockType.CRAFTING_TABLE,
            target_pos=builder.player_position,
            min_dist=2,
            max_dist=5,
            n=1,
            on_blocks=[BlockType.PATH],
        )

        return builder.build(rng)</data>
