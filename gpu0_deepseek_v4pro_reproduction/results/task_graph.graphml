      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to survive and clear more Dungeon mobs before descending, bridging the gap to the full‑game requirement of 8 kills.
Description: The agent begins on floor 1 (the Dungeon) with a stone sword (tier 2) in its inventory. The goal is to descend to floor 2 and earn the `ENTER_GNOMISH_MINES` achievement. The level‑clear threshold is raised to the full‑game value: the agent must defeat **8** hostile mobs (`monsters_killed_to_clear_level = 8`) to unlock the Ladder Down. Hostile melee mobs (Orc Soldiers) and ranged mobs (Orc Mages) continue to spawn at half the default rate (`melee_spawn_multiplier = 0.5`, `ranged_spawn_multiplier = 0.5`); passive mobs (Snails) spawn normally (`passive_spawn_multiplier = 1.0`). All survival needs and regeneration rates remain at default values. The episode is considered successful when the agent uses the Descend action on a Ladder Down tile on floor 1. The task compresses pre‑dungeon preparation: the agent is placed directly into the dungeon with the required weapon, and the achievements `ENTER_DUNGEON` and `MAKE_STONE_SWORD` are marked as completed.
Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: ENTER_DUNGEON, MAKE_STONE_SWORD
World:
- Player: Starts on floor 1 with inventory `{"sword": 2}` (stone sword). All attributes default (STR 1, DEX 1, INT 1); health, food, drink, energy, mana start at 9/9.
- Map: No modifications; standard dungeon generation is used. The Ladder Down appears in a normal dungeon room as per the default placement rules.
- Mechanics: `passive_spawn_multiplier = 1.0`, `melee_spawn_multiplier = 0.5`, `ranged_spawn_multiplier = 0.5`, `monsters_killed_to_clear_level = 8`. All other `TaskParams` remain at their defaults (e.g., `melee_trigger_distance = 10`, `needs_depletion_multiplier = 1.0`).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.MAKE_STONE_SWORD,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=0.5,
            ranged_spawn_multiplier=0.5,
            monsters_killed_to_clear_level=8,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Equip stone sword
        builder.set_player_inventory({
            "sword": 2,
        })

        state = builder.build(rng)

        # Mark pre-completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
