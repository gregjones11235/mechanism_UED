: 33.513513513513516, "make_diamond_pickaxe": 5.945945945945946, "make_diamond_sword": 5.945945945945946, "make_diamond_armour": 0.5405405405405406, "enter_gnomish_mines": 68.10810810810811, "enter_dungeon": 100.0, "defeat_orc_solider": 94.5945945945946, "defeat_orc_mage": 88.64864864864865, "eat_snail": 92.97297297297297, "find_bow": 95.67567567567568, "fire_bow": 75.67567567567568, "open_chest": 95.67567567567568, "drink_potion": 88.10810810810811}, "average_episode_length": 1482.2648648648649, "mean_return_percentage": 21.003824967113133, "mean_return": 47.46864442567568, "lp": NaN, "priority_score": 0.21720964207450694}, {"session": 65, "sr": 0.7526881720430108, "achievement_srs": {"collect_wood": 54.30107526881721, "place_table": 48.924731182795696, "eat_cow": 32.25806451612903, "collect_sapling": 54.30107526881721, "collect_drink": 90.86021505376344, "place_plant": 53.763440860215056, "defeat_zombie": 15.053763440860216, "collect_stone": 56.45161290322581, "place_stone": 54.83870967741935, "eat_plant": 22.043010752688172, "defeat_skeleton": 8.602150537634408, "wake_up": 86.02150537634408, "place_furnace": 55.913978494623656, "collect_coal": 79.56989247311827, "collect_iron": 70.43010752688173, "collect_diamond": 38.17204301075269, "make_iron_pickaxe": 22.043010752688172, "make_iron_sword": 30.64516129032258, "make_arrow": 82.79569892473118, "make_torch": 91.93548387096774, "place_torch": 91.93548387096774, "collect_sapphire": 30.107526881720432, "collect_ruby": 32.25806451612903, "make_diamond_pickaxe": 3.225806451612903, "make_diamond_sword": 8.602150537634408, "enter_gnomish_mines": 75.26881720430107, "enter_dungeon": 100.0, "defeat_orc_solider": 99.46236559139786, "defeat_orc_mage": 88.17204301075269, "eat_snail": 91.39784946236558, "find_bow": 95.16129032258064, "fire_bow": 81.72043010752688, "open_chest": 95.16129032258064, "drink_potion": 89.24731182795699}, "average_episode_length": 1497.0483870967741, "mean_return_percentage": 22.118896693459178, "mean