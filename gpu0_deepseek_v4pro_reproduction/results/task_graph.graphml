      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Practise a thin‑slice of dungeon clearing: find and defeat a single Orc Soldier in the dark and descend to the Gnomish Mines.

Description: The player begins on Floor 1 (Dungeon) at the Ladder Up position. All vital stats are at maximum (9) and attributes are at 1. The inventory contains a wood sword, a bow, 15 arrows, and 20 torches—enough to light critical path segments generously. One Orc Soldier (melee, type id 2) is spawned randomly within 5–10 Manhattan distance of the start on a path block. The floor’s kill count is initialised at 0, and only one kill is required to unlock the ladder (`monsters_killed_to_clear_level = 1`). No other active or spawning mobs exist; all spawn multipliers are zero. Mob health and damage are slightly reduced (multiplier 0.8) to keep the combat accessible. The agent must explore, place torches, locate and defeat the Orc Soldier, then find and approach the Ladder Down (naturally generated) and use the Descend action. Success unlocks the achievement `ENTER_GNOMISH_MINES`. The dungeon retains its usual procedural rooms, corridors, chests, and fountains, but none are required for success.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: ENTER_DUNGEON, FIND_BOW, MAKE_ARROW, MAKE_WOOD_SWORD, MAKE_TORCH

World:
- Player: `builder.set_starting_floor(1)`. Inventory provided by `builder.set_player_inventory({"sword": 1, "bow": 1, "arrows": 15, "torches": 20})`. All stats are at max, attributes at 1 (default, no explicit change needed).
- Map: `builder.set_monsters_killed(level=1, count=0)`. Place one Orc Soldier: `builder.add_mobs_randomly_near(rng, 1, "melee", 2, n=1, target_pos=player_start_pos, min_dist=5, max_dist=10, on_blocks=[BlockType.PATH])`. No other mobs are placed; spawning disabled below.
- Mechanics: `passive_spawn_multiplier = 0.0`, `melee_spawn_multiplier = 0.0`, `ranged_spawn_multiplier = 0.0`. `monsters_killed_to_clear_level = 1`. `mob_health_multiplier = 0.8`, `mob_damage_multiplier = 0.8`. All other TaskParams remain default.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.FIND_BOW,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_TORCH,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=0.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=1,
            mob_health_multiplier=0.8,
            mob_damage_multiplier=0.8,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, melee_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Set starting inventory
        builder.set_player_inventory({
            "sword": 1,      # Wood sword
            "bow": 1,
            "arrows": 15,
            "torches": 20,
        })

        # Reset floor 1 kill count to 0
        builder.set_monsters_killed(level=1, count=0)

        # Get spawn position after set_starting_floor updates it
        spawn_pos = builder.player_position

        # Place exactly one Orc Soldier (melee type_id=2) within 5-10 Manhattan distance
        builder.add_mobs_randomly_near(
            melee_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=1,
            target_pos=spawn_pos,
            min_dist=5,
            max_dist=10,
            on_blocks=[BlockType.PATH],
        )

        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
