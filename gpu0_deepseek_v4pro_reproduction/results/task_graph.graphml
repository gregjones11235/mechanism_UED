_stone_sword": 19.724770642201836, "wake_up": 9.403669724770642, "place_furnace": 13.761467889908257, "collect_coal": 32.3394495412844, "collect_iron": 30.96330275229358, "collect_diamond": 13.302752293577981, "make_iron_pickaxe": 11.697247706422019, "make_iron_sword": 16.05504587155963, "make_arrow": 100.0, "make_torch": 60.55045871559633, "place_torch": 54.58715596330275, "collect_sapphire": 11.46788990825688, "collect_ruby": 11.009174311926605, "make_diamond_pickaxe": 1.834862385321101, "make_diamond_sword": 1.834862385321101, "make_iron_armour": 3.8990825688073394, "enter_gnomish_mines": 7.568807339449541, "enter_dungeon": 100.0, "defeat_orc_solider": 83.02752293577981, "defeat_orc_mage": 78.6697247706422, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 90.13761467889908, "drink_potion": 50.91743119266055}, "average_episode_length": 823.3692660550458, "mean_return_percentage": 14.60420299275138, "mean_return": 33.00549876361812, "lp": NaN, "priority_score": 0.1678046881575625}]</data>
