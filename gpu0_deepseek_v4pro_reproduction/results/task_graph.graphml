      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Defeat three orc enemies in the darkness of the Dungeon using a sword and bow, then descend into the Gnomish Mines.

Description: The agent begins on Floor 1 (Dungeon) at the Ladder Up spawn point, with all vital stats at full (9) and attributes at 1. The inventory contains a wood sword, a bow, 20 arrows, and 20 torches. The dungeon is pitch‑black, requiring torch placement to see. Two Orc Soldiers (melee, type_id=2) and one Orc Mage (ranged, type_id=2) are placed randomly on path blocks within a Manhattan distance of 5 to 10 from the player’s starting position. No other mobs exist, and all spawn multipliers are set to zero. The floor’s kill count is initialised to 0, and `monsters_killed_to_clear_level` is set to 3, so all three enemies must be defeated to unlock the Ladder Down. Mob health and damage are multiplied by 0.9 (slightly tougher than the previous task). After defeating the enemies, the agent must locate the naturally generated Ladder Down and use the Descend action to achieve ENTER_GNOMISH_MINES, which ends the episode successfully. The dungeon retains its standard rooms, corridors, chests, and fountains, but none are required for success.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: ENTER_DUNGEON, FIND_BOW, MAKE_ARROW, MAKE_WOOD_SWORD, MAKE_TORCH

World:
- Player: `builder.set_starting_floor(1)`. Inventory provided by `builder.set_player_inventory({"sword": 1, "bow": 1, "arrows": 20, "torches": 20})`.
- Map: `builder.set_monsters_killed(level=1, count=0)`. Place two melee Orc Soldiers: `builder.add_mobs_randomly_near(rng, 1, "melee", 2, n=2, target_pos=player_start_pos, min_dist=5, max_dist=10, on_blocks=[BlockType.PATH])`. Place one ranged Orc Mage: `builder.add_mobs_randomly_near(rng, 1, "ranged", 2, n=1, target_pos=player_start_pos, min_dist=5, max_dist=10, on_blocks=[BlockType.PATH])`.
- Mechanics: `passive_spawn_multiplier = 0.0`, `melee_spawn_multiplier = 0.0`, `ranged_spawn_multiplier = 0.0`. `monsters_killed_to_clear_level = 3`. `mob_health_multiplier = 0.9`, `mob_damage_multiplier = 0.9`. All other TaskParams remain default.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.FIND_BOW,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_TORCH,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=0.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=3,
            mob_health_multiplier=0.9,
            mob_damage_multiplier=0.9,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)
        mob_rng = jax.random.split(rng, 2)  # Two separate rngs for two calls

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Equip starting inventory: wood sword, bow, arrows, torches
        builder.set_player_inventory({
            "sword": 1,
            "bow": 1,
            "arrows": 20,
            "torches": 20,
        })

        # Reset Dungeon kill counter to zero
        builder.set_monsters_killed(level=1, count=0)

        # Handplace orc mobs near the spawn
        spawn_pos = builder.player_position

        builder.add_mobs_randomly_near(
            mob_rng[0],
            level=1,
            mob_name="melee",
            type_id=2,   # Orc Soldier
            n=2,
            target_pos=spawn_pos,
            min_dist=5,
            max_dist=10,
            on_blocks=[BlockType.PATH],
        )

        builder.add_mobs_randomly_near(
            mob_rng[1],
            level=1,
            mob_name="ranged",
            type_id=2,   # Orc Mage
            n=1,
            target_pos=spawn_pos,
            min_dist=5,
            max_dist=10,
            on_blocks=[BlockType.PATH],
        )

        state = builder.build(rng)

        # Mark completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
