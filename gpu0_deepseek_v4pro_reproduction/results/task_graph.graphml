      <data key="d3">import jax
import jax.numpy as jnp
from craftax.craftax.constants import Achievement, BlockType, ItemType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to kill hostile mobs to clear floor 0 and descend into the dungeon.
Description: The agent starts on floor 0 with a stone sword, stone pickaxe, and a small supply of wood, stone, coal, and torches. The ladder down is initially locked because the level’s monster kill count is set to 0. The agent must find and defeat enough hostile mobs (zombies) to reach the required 8 kills (via `monsters_killed_to_clear_level`), while sustaining health and needs, then stand on the exposed ladder and perform the DESCEND action. Only one `LADDER_DOWN` is guaranteed near the spawn to make it easily discoverable. Mobs: only melee zombies are present; all ranged mobs are disabled. To ease combat, zombie health is reduced to 80% normal and survival pressure is halved. Passive cows are available for food.
Relevant Achievements: DEFEAT_ZOMBIE, ENTER_DUNGEON
Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_STONE_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_SWORD
World:
- Player: Starts on floor 0 with inventory `{"pickaxe": 2, "sword": 2, "wood": 20, "stone": 20, "coal": 10, "torch": 10}`. Stats: all 1. Kill counter for floor 0 is manually set to 0 using `set_monsters_killed(level=0, count=0)`.
- Map: One `LADDER_DOWN` block is placed randomly on `GRASS` or `PATH` within a Manhattan distance of 2–10 tiles from the player’s spawn point using `place_randomly_near`. Additionally, 3 `COW` (passive mob, type_id 0) are placed randomly within 4–10 tiles of the player on `GRASS`.
- Mechanics: 
  - `melee_spawn_multiplier = 1.5`
  - `ranged_spawn_multiplier = 0.0`
  - `passive_spawn_multiplier = 1.0`
  - `mob_health_multiplier = 0.8`
  - `mob_damage_multiplier = 1.0`
  - `needs_depletion_multiplier = 0.25`
  - `health_recover_multiplier = 2.0`
  - `monsters_killed_to_clear_level = 8` (unchanged from default, but enforced via the initial kill count override)
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.DEFEAT_ZOMBIE,
            Achievement.ENTER_DUNGEON,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_SWORD,
        ]
        self.label = "DEFEAT_ZOMBIE, ENTER_DUNGEON"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=1.5,
            ranged_spawn_multiplier=0.0,
            passive_spawn_multiplier=1.0,
            mob_health_multiplier=0.8,
            mob_damage_multiplier=1.0,
            needs_depletion_multiplier=0.25,
            health_recover_multiplier=2.0,
            monsters_killed_to_clear_level=8,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, ladder_rng, cow_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(0)
        builder.set_player_inventory({
            "pickaxe": 2,
            "sword": 2,
            "wood": 20,
            "stone": 20,
            "coal": 10,
            "torches": 10,
        })
        # Reset kill counter so the ladder remains locked until enough zombies are killed.
        builder.set_monsters_killed(level=0, count=0)

        # Place a single ladder down item within 2‑10 Manhattan tiles of the spawn,
        # only on grass or path.
        level = 0
        target_pos = builder.player_position
        map_size = self.static_params.map_size

        rows_grid, cols_grid = jnp.indices(map_size)
        dist_map = jnp.abs(rows_grid - target_pos[0]) + jnp.abs(cols_grid - target_pos[1])
        distance_mask = (dist_map &gt;= 2) &amp; (dist_map &lt;= 10)

        on_blocks_mask = jnp.isin(
            builder.map[level],
            jnp.array([BlockType.GRASS.value, BlockType.PATH.value]),
        )
        valid_mask = distance_mask &amp; on_blocks_mask

        random_logits = jax.random.uniform(ladder_rng, shape=map_size)
        masked_logits = jnp.where(valid_mask, random_logits, -jnp.inf)
        flat_index = jnp.argmax(masked_logits.flatten())
        row = flat_index // map_size[1]
        col = flat_index % map_size[1]

        builder.item_map = builder.item_map.at[level, row, col].set(ItemType.LADDER_DOWN.value)

        # Add 3 passive cows as a food source.
        builder.add_mobs_randomly_near(
            cow_rng,
            level=0,
            mob_name="passive",
            type_id=0,
            n=3,
            target_pos=target_pos,
            min_dist=4,
            max_dist=10,
            on_blocks=[BlockType.GRASS],
        )

        return builder.build(rng)</data>
