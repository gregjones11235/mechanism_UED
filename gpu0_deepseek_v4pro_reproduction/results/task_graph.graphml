1.10236220472441, "make_wood_pickaxe": 51.87007874015748, "make_wood_sword": 100.0, "place_plant": 35.925196850393704, "collect_stone": 37.696850393700785, "place_stone": 36.318897637795274, "make_stone_pickaxe": 27.263779527559056, "make_stone_sword": 27.46062992125984, "wake_up": 80.61023622047244, "place_furnace": 36.22047244094488, "collect_coal": 58.95669291338583, "collect_iron": 51.181102362204726, "collect_diamond": 27.755905511811022, "make_iron_pickaxe": 12.893700787401574, "make_iron_sword": 15.059055118110237, "make_torch": 91.24015748031496, "place_torch": 87.20472440944881, "collect_sapphire": 25.29527559055118, "collect_ruby": 24.507874015748033, "make_diamond_pickaxe": 4.133858267716535, "make_diamond_sword": 5.019685039370079, "enter_gnomish_mines": 61.12204724409449, "enter_dungeon": 100.0, "defeat_orc_mage": 79.6259842519685, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 99.31102362204724, "drink_potion": 82.38188976377953}, "average_episode_length": 271.9517716535433, "mean_return_percentage": 15.408500632577871, "mean_return": 34.823211429625985, "lp": NaN, "priority_score": 0.237630006510013}]</data>
