      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Strengthen the Overworld‑to‑Dungeon transition by forcing the agent to gather its own wood and stone to craft arrows before clearing the Dungeon and descending to the Gnomish Mines.

Description: The agent starts on floor 0 (the Overworld) with only a **wood sword** and **wood pickaxe**. Its inventory is otherwise empty—no wood, no stone, no arrows, no torches. The agent must explore the Overworld, harvest trees for wood, mine stone, craft a crafting table, and produce enough arrows (recipe: 1 wood + 1 stone → 2 arrows) to reliably defeat the 8 hostile monsters required to clear the Dungeon (floor 1). It then descends to the Dungeon, fights orc soldiers and mages using the bow (which must be found in the Dungeon as usual, since no bow is provided), and finally stands on the LADDER_DOWN and uses the `DESCEND` action to trigger `ENTER_GNOMISH_MINES`. Survival pressure is kept low (`needs_depletion_multiplier=0.25`, `health_recover_multiplier=2.0`) and mobs have standard stats (all multipliers=1.0) to keep focus on the resource‑preparation‑to‑dungeon‑clear loop. This thin‑slice task directly addresses the global weakness where the agent fails to enter the Gnomish Mines because it never learns to supply itself from scratch.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD, COLLECT_WOOD, COLLECT_STONE

World:
- Player: Starting floor = 0. Inventory: `{"pickaxe": 1, "sword": 1}` (both wood tier). All stats are 1. The kill counter for floor 0 is already 0 (ladder down open by default). No other resources.
- Map: No modifications. The default Overworld (SmoothGen) and Dungeon generation apply. The LADDER_DOWN on floor 0 is present in its normal position; the LADDER_DOWN on floor 1 is generated as usual.
- Mechanics:
  - `melee_spawn_multiplier = 1.0`
  - `ranged_spawn_multiplier = 1.0`
  - `passive_spawn_multiplier = 1.0`
  - `mob_health_multiplier = 1.0`
  - `mob_damage_multiplier = 1.0`
  - `monsters_killed_to_clear_level = 8` (applies to floor 1; floor 0 is already cleared)
  - `needs_depletion_multiplier = 0.25`
  - `health_recover_multiplier = 2.0`
  - `mana_recover_multiplier = 1.0`
  - All other TaskParams remain default.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_GNOMISH_MINES]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.COLLECT_WOOD,
            Achievement.COLLECT_STONE,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            monsters_killed_to_clear_level=8,
            needs_depletion_multiplier=0.25,
            health_recover_multiplier=2.0,
            mana_recover_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (overworld)
        builder.set_starting_floor(0)

        # Equip only wooden pickaxe and wooden sword
        builder.set_player_inventory({"pickaxe": 1, "sword": 1})

        # No other modifications; use default world generation
        return builder.build(rng)</data>
