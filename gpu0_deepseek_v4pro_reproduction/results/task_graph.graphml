lect_iron": 83.96624472573839, "collect_diamond": 43.459915611814345, "make_iron_pickaxe": 34.177215189873415, "make_iron_sword": 58.64978902953587, "make_arrow": 100.0, "make_torch": 100.0, "place_torch": 100.0, "collect_sapphire": 35.44303797468354, "collect_ruby": 30.80168776371308, "make_diamond_pickaxe": 6.329113924050633, "make_diamond_sword": 2.9535864978902953, "make_iron_armour": 6.751054852320675, "enter_gnomish_mines": 73.83966244725738, "enter_dungeon": 99.57805907172995, "defeat_orc_solider": 98.31223628691983, "defeat_orc_mage": 96.62447257383967, "eat_snail": 97.0464135021097, "find_bow": 99.57805907172995, "fire_bow": 99.15611814345992, "open_chest": 100.0, "drink_potion": 89.87341772151899}, "average_episode_length": 1214.4303797468353, "mean_return_percentage": 26.03443206004257, "mean_return": 58.8378164556962, "lp": NaN, "priority_score": 0.19316704944008262}]</data>
