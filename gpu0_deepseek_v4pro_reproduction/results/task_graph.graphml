      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Descend into the Dungeon by killing two hostile mobs on the overworld, unlocking the ladder down, and using the DESCEND action.

    Description: The agent starts on Floor 0 with a stone sword and a stone pickaxe, no other resources. The overworld is fully lit, and survival needs deplete at half the normal rate. Two zombies (melee, type_id=0) and two skeletons (ranged, type_id=0) are scattered within 5–10 Manhattan tiles of the starting position. Natural mob spawning continues with default multipliers for melee, passive, and ranged mobs. The floor‑clear requirement is set to 2 kills. Once the agent has killed any two hostile mobs and stands on the ladder‑down tile (procedurally placed), it can descend to floor 1, achieving ENTER_DUNGEON. All other achievements remain possible as side rewards.

    Relevant Achievements: ENTER_DUNGEON

    Completed Achievements: (none)

    World:
    - Player: Starts on Floor 0 with inventory {"stone_sword": 1, "stone_pickaxe": 1}.
    - Map:
      - Place 2 Zombies (melee mob, type_id=0) randomly within 5–10 Manhattan distance of player start using add_mobs_randomly_near.
      - Place 2 Skeletons (ranged mob, type_id=0) randomly within 5–10 Manhattan distance of player start using add_mobs_randomly_near.
    - Mechanics:
      - monsters_killed_to_clear_level = 2
      - needs_depletion_multiplier = 0.5
      - health_recover_multiplier = 1.0
      - mana_recover_multiplier = 1.0
      - passive_spawn_multiplier = 1.0
      - melee_spawn_multiplier = 1.0
      - ranged_spawn_multiplier = 1.0
      - melee_trigger_distance = 10
      - mob_health_multiplier = 1.0
      - mob_damage_multiplier = 1.0
      - growing_plants_age = 600
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_DUNGEON]
        self.completed_achievements = []
        self.label = "ENTER_DUNGEON"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            monsters_killed_to_clear_level=2,
            needs_depletion_multiplier=0.5,
            health_recover_multiplier=1.0,
            mana_recover_multiplier=1.0,
            melee_trigger_distance=10,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            growing_plants_age=600,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, zombie_rng, skeleton_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(0)
        builder.set_player_inventory({"sword": 2, "pickaxe": 2})  # stone sword and pickaxe

        # Place 2 zombies (melee, type_id=0) 5-10 tiles away
        builder.add_mobs_randomly_near(
            zombie_rng,
            level=0,
            mob_name="melee",
            type_id=0,
            n=2,
            target_pos=builder.player_position,
            min_dist=5,
            max_dist=10,
        )

        # Place 2 skeletons (ranged, type_id=0) 5-10 tiles away
        builder.add_mobs_randomly_near(
            skeleton_rng,
            level=0,
            mob_name="ranged",
            type_id=0,
            n=2,
            target_pos=builder.player_position,
            min_dist=5,
            max_dist=10,
        )

        return builder.build(rng)</data>
