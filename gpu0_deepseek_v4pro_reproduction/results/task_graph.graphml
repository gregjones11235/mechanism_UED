      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Teach the agent to navigate a normal dungeon, defeat hostile mobs, and descend to the Gnomish Mines.

Description: The agent starts on Floor 1 (the Dungeon) at the up‑ladder, equipped with a stone sword (tier 2) and a stone pickaxe (tier 2). The dungeon is generated procedurally with all default features – chests, fountains, torches in corners, snails, and standard spawns of orc soldiers and orc mages. No extra ore blocks are placed; the agent cannot craft iron tools and must focus exclusively on exploration and combat. The ladder down is present at a random location and becomes usable once the required number of hostile mobs (orcs) has been defeated (`monsters_killed_to_clear_level = 6`). Survival needs are moderately eased (`needs_depletion_multiplier = 0.5`) to keep the challenge on the core descent sequence, while mob spawn rates are set to their original values (`melee_spawn_multiplier = ranged_spawn_multiplier = 1.0`). The single relevant achievement is `ENTER_GNOMISH_MINES`; all prerequisite achievements (`ENTER_DUNGEON`, `MAKE_STONE_SWORD`, `MAKE_STONE_PICKAXE`, `COLLECT_WOOD`, `COLLECT_STONE`) are marked as completed to avoid pointless repetition.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: ENTER_DUNGEON, MAKE_STONE_SWORD, MAKE_STONE_PICKAXE, COLLECT_WOOD, COLLECT_STONE

World:
- Player: `builder.set_starting_floor(1)`.  
  Inventory via `builder.set_player_inventory({"sword": 2, "pickaxe": 2})`.  
  All attributes default (full health, food, drink, etc.).
- Map:
  - `builder.set_monsters_killed(level=1, count=0)`
  - No other block modifications; the standard dungeon layout is used (rooms, corridors, chests, fountains, torches).
- Mechanics:
  - `monsters_killed_to_clear_level = 6`
  - `mob_health_multiplier = 1.0`
  - `mob_damage_multiplier = 1.0`
  - `melee_spawn_multiplier = 1.0`
  - `ranged_spawn_multiplier = 1.0`
  - `passive_spawn_multiplier = 1.0`
  - `needs_depletion_multiplier = 0.5`
  - `health_recover_multiplier = 1.0`
  - `health_loss_multiplier = 1.0`
  - `mana_recover_multiplier = 1.0`
  - `growing_plants_age = 600`
  - All other parameters left at default.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.COLLECT_WOOD,
            Achievement.COLLECT_STONE,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            monsters_killed_to_clear_level=6,
            needs_depletion_multiplier=0.5,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            growing_plants_age=600,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on Floor 1 (Dungeon) at the up‑ladder position
        builder.set_starting_floor(1)

        # Equip starting inventory: stone sword (tier 2) and stone pickaxe (tier 2)
        builder.set_player_inventory({
            "sword": 2,
            "pickaxe": 2,
        })

        # Reset dungeon kill counter to zero
        builder.set_monsters_killed(level=1, count=0)

        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
