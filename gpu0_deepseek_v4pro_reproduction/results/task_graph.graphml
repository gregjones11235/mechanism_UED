4153005464481, "achievement_srs": {"collect_wood": 98.62295081967213, "place_table": 95.60655737704919, "collect_sapling": 99.43169398907104, "collect_drink": 28.459016393442624, "make_wood_pickaxe": 84.34972677595628, "place_plant": 99.19125683060109, "collect_stone": 55.73770491803279, "place_stone": 55.12568306010929, "make_stone_pickaxe": 13.683060109289617, "make_stone_sword": 4.8743169398907105, "wake_up": 7.475409836065574, "place_furnace": 55.169398907103826, "collect_coal": 16.612021857923498, "collect_iron": 4.502732240437158, "make_iron_pickaxe": 0.4808743169398907, "make_iron_sword": 0.7431693989071039, "make_arrow": 5.245901639344262, "make_torch": 5.923497267759563, "place_torch": 5.704918032786885, "enter_dungeon": 98.8415300546448}, "average_episode_length": 61.630819672131146, "mean_return_percentage": 13.313471698341312, "mean_return": 30.088446038251366, "lp": NaN, "priority_score": 0.01145049419212277}]</data>
