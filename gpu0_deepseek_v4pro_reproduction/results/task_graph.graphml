, "make_iron_pickaxe": 22.80701754385965, "make_iron_sword": 39.473684210526315, "make_arrow": 100.0, "make_torch": 89.47368421052632, "place_torch": 88.01169590643275, "collect_sapphire": 27.485380116959064, "collect_ruby": 23.68421052631579, "make_diamond_pickaxe": 4.970760233918129, "make_diamond_sword": 4.093567251461988, "enter_gnomish_mines": 55.55555555555556, "enter_dungeon": 100.0, "defeat_orc_solider": 96.78362573099415, "defeat_orc_mage": 91.52046783625731, "eat_snail": 97.36842105263158, "find_bow": 98.53801169590643, "fire_bow": 98.53801169590643, "open_chest": 98.53801169590643, "drink_potion": 81.87134502923976}, "average_episode_length": 804.6374269005848, "mean_return_percentage": 20.845580163939992, "mean_return": 47.11101117050438, "lp": NaN, "priority_score": 0.24691358024691357}, {"session": 147, "sr": 0.5758426966292135, "achievement_srs": {"collect_wood": 100.0, "place_table": 100.0, "eat_cow": 58.146067415730336, "collect_sapling": 58.98876404494382, "collect_drink": 94.9438202247191, "place_plant": 58.70786516853933, "defeat_zombie": 32.86516853932584, "collect_stone": 100.0, "place_stone": 97.47191011235955, "eat_plant": 8.426966292134832, "defeat_skeleton": 32.58426966292135, "wake_up": 95.78651685393258, "place_furnace": 99.43820224719101, "collect_coal": 78.65168539325843, "collect_iron": 74.71910112359551, "collect_diamond": 33.146067415730336, "make_iron_pickaxe": 23.59550561797753, "make_iron_sword": 43.82022471910113, "make_arrow": 100.0, "make_torch": 94.66292134831461, "place_torch": 92.97752808988764, "collect_sapphire": 26.40449438202247, "collect_ruby": 30.89887640449438, "make_diamond_pickaxe": 4.213483146067416, "make_diamond_sword": 4.213483146067416, "enter_gnomish_mines": 57.58426966292135, "enter_dungeon": 100.0, "defeat_orc_solider": 98.03370786516854, "defeat_orc_mage": 91.85393258426966, "eat_snail": 97.75280898876404, "find_bow": 98.87640449438203, "fire_bow": 98.87640449438203, "open_chest": 98.87640449438203, "drink_