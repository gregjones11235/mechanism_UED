      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Clear the dungeon under more realistic spawn pressure to reach the Gnomish Mines.  
    Description: This task reduces the excessive scaffolding of the previous dungeon exercise. The agent still starts on Floor 1 with a Wood Pickaxe, 5 wood, and 5 stone — the resources a competent Overworld player would bring — but the world is generated with the **default Dungeon layout** and no additional blocks or mobs. Hostile spawn rates are raised to the standard `1.0×` for both melee and ranged mobs, and passive spawns remain off. Survival needs are slightly faster (`needs_depletion_multiplier = 0.3`) to introduce mild pressure without dominating. No crafting table is pre‑placed; the agent must use its wood to craft and place one. From there the goal is the same: find a bow in standard dungeon chests, craft arrows using the wood and stone, and defeat the 8 required hostiles to unlock the ladder down, earning `ENTER_GNOMISH_MINES`.  
    Relevant Achievements: ENTER_GNOMISH_MINES  
    Completed Achievements: COLLECT_WOOD, COLLECT_STONE, MAKE_WOOD_PICKAXE  
    World:
    - Player: Starts on Floor 1 (spawn at ladder‑up position). Inventory: `{"pickaxe": 1, "wood": 5, "stone": 5}`. All stats default (1/1/1), full health/hunger/thirst/energy/mana. No enchantments, no spells learned.
    - Map: Default Dungeon generation for Floor 1. No additional blocks, chests, or mobs are placed by the builder.
    - Mechanics:
      - `needs_depletion_multiplier`: 0.3
      - `melee_spawn_multiplier`: 1.0
      - `ranged_spawn_multiplier`: 1.0
      - `passive_spawn_multiplier`: 0.0
      - `monsters_killed_to_clear_level`: 8
      - All other TaskParams at their default (`health_recover_multiplier`, `health_loss_multiplier`, `mob_health_multiplier`, `mob_damage_multiplier` etc. remain 1.0).
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.COLLECT_WOOD,
            Achievement.COLLECT_STONE,
            Achievement.MAKE_WOOD_PICKAXE,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.3,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=8,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Equip wood pickaxe, 5 wood, 5 stone
        builder.set_player_inventory({
            "pickaxe": 1,  # Wood pickaxe
            "wood": 5,
            "stone": 5,
        })

        state = builder.build(rng)

        # Mark completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
