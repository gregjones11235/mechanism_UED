      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Clear a floor‑1 dungeon with multiple normal‑strength enemies using only starting equipment, and descend to the Gnomish Mines.

Description: The agent begins on Floor 1 (Dungeon) at the Ladder Up position. All vital stats are at maximum (9), attributes are at 1, and survival needs (hunger, thirst, fatigue) are completely disabled via `needs_depletion_multiplier = 0.0`. The inventory contains a wood sword, a bow, 15 arrows, and 10 torches. No food or drink is required.  
The entire map of Floor 0 is filled with WATER blocks, making it completely barren; any ascent to the Overworld is futile.  
Two Orc Soldiers (melee, type id 2) and one Orc Mage (ranged, type id 2) are spawned randomly on Floor 1 within a Manhattan distance of 5–12 from the player’s start, on PATH blocks. No other mobs exist, and all spawn multipliers are set to zero. The kill requirement to unlock the ladder is 3 (`monsters_killed_to_clear_level = 3`), matching the number of placed enemies.  
Mob health and damage multipliers are set to 1.0 (normal values).  
The agent must explore the procedurally generated dungeon, place torches to light the darkness, locate and defeat all three enemies (which will automatically unlock the ladder), and then find the naturally generated Ladder Down and use the DESCEND action. Success grants the achievement `ENTER_GNOMISH_MINES`.  

Relevant Achievements: ENTER_GNOMISH_MINES  
Completed Achievements: ENTER_DUNGEON, FIND_BOW, MAKE_ARROW, MAKE_WOOD_SWORD, MAKE_TORCH  

World:
- Player:  
  `builder.set_starting_floor(1)`  
  `builder.set_player_inventory({"sword": 1, "bow": 1, "arrows": 15, "torches": 10})`  
  No changes to stats; survival disabled via `needs_depletion_multiplier = 0.0`.
- Map:  
  `builder.fill_area(0, BlockType.WATER, (0, 0), (63, 63))`  (overwrites entire Floor 0 with water)  
  `builder.set_monsters_killed(level=1, count=0)`  
  `builder.add_mobs_randomly_near(rng, 1, "melee", 2, n=2, target_pos=player_start_pos, min_dist=5, max_dist=12, on_blocks=[BlockType.PATH])`  
  `builder.add_mobs_randomly_near(rng, 1, "ranged", 2, n=1, target_pos=player_start_pos, min_dist=5, max_dist=12, on_blocks=[BlockType.PATH])`  
  No other blocks are modified.
- Mechanics:  
  `passive_spawn_multiplier = 0.0`  
  `melee_spawn_multiplier = 0.0`  
  `ranged_spawn_multiplier = 0.0`  
  `monsters_killed_to_clear_level = 3`  
  `mob_health_multiplier = 1.0`  
  `mob_damage_multiplier = 1.0`  
  `needs_depletion_multiplier = 0.0`  
  All other TaskParams remain at default.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.FIND_BOW,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_TORCH,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=0.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=3,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            needs_depletion_multiplier=0.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, mob_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Fill the entire Overworld (floor 0) with water to make it barren
        map_height, map_width = self.static_params.map_size
        builder.fill_area(0, BlockType.WATER, (0, 0), (map_height - 1, map_width - 1))

        # Set initial kill count on floor 1 to 0 (ladder is locked until 3 kills)
        builder.set_monsters_killed(level=1, count=0)

        # Equip starting inventory: wood sword, bow, 15 arrows, 10 torches
        builder.set_player_inventory({
            "sword": 1,
            "bow": 1,
            "arrows": 15,
            "torches": 10,
        })

        # Player spawn position (ladder-up location on floor 1)
        spawn_pos = builder.player_position

        # Spawn two Orc Soldiers (melee, type_id=2) near the player
        mob_rng1, mob_rng2 = jax.random.split(mob_rng)
        builder.add_mobs_randomly_near(
            mob_rng1,
            level=1,
            mob_name="melee",
            type_id=2,
            n=2,
            target_pos=spawn_pos,
            min_dist=5,
            max_dist=12,
            on_blocks=[BlockType.PATH],
        )

        # Spawn one Orc Mage (ranged, type_id=2) near the player
        builder.add_mobs_randomly_near(
            mob_rng2,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=1,
            target_pos=spawn_pos,
            min_dist=5,
            max_dist=12,
            on_blocks=[BlockType.PATH],
        )

        state = builder.build(rng)

        # Mark completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
