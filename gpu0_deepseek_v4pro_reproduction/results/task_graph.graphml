torch": 86.76470588235294, "collect_sapphire": 23.235294117647058, "collect_ruby": 23.529411764705884, "make_diamond_pickaxe": 2.6470588235294117, "make_diamond_sword": 3.235294117647059, "enter_gnomish_mines": 66.76470588235294, "enter_dungeon": 100.0, "defeat_orc_solider": 90.88235294117646, "defeat_orc_mage": 70.58823529411765, "eat_snail": 91.76470588235294, "find_bow": 96.17647058823529, "fire_bow": 76.17647058823529, "open_chest": 96.17647058823529, "drink_potion": 78.23529411764706}, "average_episode_length": 880.8529411764706, "mean_return_percentage": 21.420059640974753, "mean_return": 48.40933478860294, "lp": NaN, "priority_score": 0.2218944636678201}]</data>
