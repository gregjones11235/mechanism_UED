4}, "average_episode_length": 754.02, "mean_return_percentage": 19.87441850703224, "mean_return": 44.91618582589286, "lp": NaN, "priority_score": 0.23346938775510204}, {"session": 82, "sr": 0.7345679012345679, "achievement_srs": {"collect_wood": 50.617283950617285, "place_table": 47.22222222222222, "eat_cow": 55.864197530864196, "collect_sapling": 50.925925925925924, "collect_drink": 96.91358024691358, "make_wood_pickaxe": 63.888888888888886, "make_wood_sword": 100.0, "place_plant": 50.30864197530864, "defeat_zombie": 25.925925925925927, "collect_stone": 51.851851851851855, "place_stone": 51.23456790123457, "eat_plant": 12.345679012345679, "defeat_skeleton": 23.765432098765434, "make_stone_pickaxe": 49.074074074074076, "wake_up": 96.29629629629629, "place_furnace": 50.925925925925924, "collect_coal": 76.23456790123457, "collect_iron": 75.61728395061728, "collect_diamond": 35.18518518518518, "make_iron_pickaxe": 26.85185185185185, "make_iron_sword": 35.80246913580247, "make_arrow": 79.62962962962963, "make_torch": 95.98765432098766, "place_torch": 92.90123456790124, "collect_sapphire": 28.703703703703702, "collect_ruby": 28.395061728395063, "make_diamond_pickaxe": 6.790123456790123, "make_diamond_sword": 5.864197530864198, "enter_gnomish_mines": 73.45679012345678, "enter_dungeon": 100.0, "defeat_orc_solider": 95.98765432098766, "defeat_orc_mage": 86.11111111111111, "eat_snail": 99.38271604938272, "find_bow": 100.0, "fire_bow": 77.77777777777777, "open_chest": 100.0, "drink_potion": 91.35802469135803}, "average_episode_length": 911.0123456790124, "mean_return_percentage": 22.691546764892657, "mean_return": 51.282895688657405, "lp": NaN, "priority_score": 0.19497789971041}]</data>
