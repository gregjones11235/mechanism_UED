88034, "make_arrow": 99.14529914529915, "make_torch": 83.93162393162393, "place_torch": 71.62393162393163, "collect_sapphire": 7.17948717948718, "collect_ruby": 8.376068376068377, "make_diamond_pickaxe": 0.8547008547008547, "make_diamond_sword": 0.8547008547008547, "make_iron_armour": 4.957264957264957, "enter_dungeon": 85.2991452991453, "defeat_orc_solider": 14.35897435897436, "defeat_orc_mage": 5.128205128205129, "eat_snail": 40.51282051282051, "find_bow": 84.44444444444444, "fire_bow": 82.73504273504274, "open_chest": 84.44444444444444, "drink_potion": 34.52991452991453}, "average_episode_length": 479.34017094017094, "mean_return_percentage": 20.945539411731335, "mean_return": 47.33691907051282, "lp": NaN, "priority_score": 0.08378698224852071}]</data>
