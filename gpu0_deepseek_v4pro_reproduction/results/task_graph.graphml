      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType, ItemType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Teach the agent to descend into the dungeon by using the DESCEND action on a ladder.

    Description: The player starts on floor 0 (the overworld) with a wooden pickaxe and wooden sword. The world contains a rectangular stone deposit identical to the previous training task (area from (10,10) to (20,20)). A single LADDER_DOWN block is placed at the fixed coordinate (15,15) inside that deposit, so the agent must navigate to that tile and execute the DESCEND action. All survival needs are turned off (needs depletion multiplier 0.0), and no hostile or passive mobs spawn (multipliers set to 0). The task terminates with success when the agent descends to floor 1, unlocking the ENTER_DUNGEON achievement.

    Relevant Achievements: ENTER_DUNGEON

    Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD

    World:
    - Player: Starts on floor 0 with inventory {"pickaxe": 1, "sword": 1} (wooden counterparts).
    - Map:
      - Fill a rectangular area on floor 0 with STONE from (10,10) to (20,20) (inclusive) to create a stone deposit.
      - Place one LADDER_DOWN block at position (15,15) inside the stone deposit.
      - No additional blocks or mobs are placed (no coal, no cows).
    - Mechanics:
      - needs_depletion_multiplier = 0.0
      - passive_spawn_multiplier = 0.0
      - melee_spawn_multiplier = 0.0
      - ranged_spawn_multiplier = 0.0
    """
    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_DUNGEON]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
        ]
        self.label = "ENTER_DUNGEON"

    def get_task_params(self) -&gt; TaskParams:
        return TaskParams(
            needs_depletion_multiplier=0.0,
            passive_spawn_multiplier=0.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)
        builder.set_starting_floor(0)
        builder.set_player_inventory({"pickaxe": 1, "sword": 1})

        # Create stone deposit
        builder.fill_area(
            level=0,
            block_type=BlockType.STONE,
            top_left=(10, 10),
            bottom_right=(20, 20),
        )

        # Place ladder down item at (15,15) inside the deposit
        builder.item_map = builder.item_map.at[0, 15, 15].set(ItemType.LADDER_DOWN.value)

        return builder.build(rng)</data>
