sapphire": 30.25830258302583, "collect_ruby": 21.40221402214022, "make_diamond_pickaxe": 2.952029520295203, "make_diamond_sword": 4.797047970479705, "make_iron_armour": 25.461254612546124, "enter_gnomish_mines": 79.33579335793358, "enter_dungeon": 96.6789667896679, "defeat_orc_solider": 94.8339483394834, "defeat_orc_mage": 94.09594095940959, "eat_snail": 95.9409594095941, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 95.9409594095941, "drink_potion": 79.33579335793358}, "average_episode_length": 984.7970479704798, "mean_return_percentage": 23.137775387882474, "mean_return": 52.29137237661439, "lp": NaN, "priority_score": 0.163941122806062}]</data>
