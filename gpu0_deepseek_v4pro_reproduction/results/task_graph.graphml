verage_episode_length": 792.2633228840125, "mean_return_percentage": 14.783087011401783, "mean_return": 33.40977664576803, "lp": NaN, "priority_score": 0.10493214492782103}, {"session": 17, "sr": 0.9595141700404858, "achievement_srs": {"collect_wood": 100.0, "place_table": 99.79757085020243, "eat_cow": 63.76518218623482, "collect_sapling": 100.0, "collect_drink": 77.53036437246963, "make_wood_sword": 100.0, "place_plant": 99.79757085020243, "defeat_zombie": 12.550607287449393, "collect_stone": 100.0, "place_stone": 99.39271255060729, "eat_plant": 12.550607287449393, "defeat_skeleton": 17.408906882591094, "make_stone_pickaxe": 98.582995951417, "wake_up": 28.74493927125506, "place_furnace": 99.39271255060729, "collect_coal": 78.5425101214575, "collect_iron": 64.5748987854251, "collect_diamond": 0.20242914979757085, "make_iron_pickaxe": 28.13765182186235, "make_iron_sword": 33.60323886639676, "make_arrow": 77.32793522267207, "make_torch": 100.0, "place_torch": 86.43724696356276, "make_iron_armour": 7.489878542510121, "enter_dungeon": 95.95141700404858}, "average_episode_length": 485.52834008097165, "mean_return_percentage": 15.065225110059654, "mean_return": 34.04740874873482, "lp": NaN, "priority_score": 0.03884672753200352}]</data>
