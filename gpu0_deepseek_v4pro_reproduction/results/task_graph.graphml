880749574105621, "make_torch": 53.4923339011925, "place_torch": 36.626916524701876, "collect_sapphire": 10.732538330494037, "collect_ruby": 10.90289608177172, "make_diamond_pickaxe": 1.0221465076660987, "make_diamond_sword": 2.5553662691652472, "make_diamond_armour": 0.17035775127768313, "enter_dungeon": 100.0, "defeat_orc_mage": 84.15672913117547, "find_bow": 100.0, "fire_bow": 98.63713798977854, "open_chest": 79.72742759795571, "drink_potion": 39.522998296422486}, "average_episode_length": 604.320272572402, "mean_return_percentage": 13.042171729187709, "mean_return": 29.475308107964224, "lp": NaN, "priority_score": 0.13333178550595093}, {"session": 38, "sr": 0.8548387096774194, "achievement_srs": {"collect_wood": 5.967741935483871, "place_table": 5.806451612903226, "collect_sapling": 5.483870967741935, "collect_drink": 27.903225806451612, "make_wood_pickaxe": 12.903225806451612, "make_wood_sword": 100.0, "place_plant": 5.483870967741935, "collect_stone": 5.806451612903226, "place_stone": 5.483870967741935, "eat_plant": 3.5483870967741935, "make_stone_pickaxe": 9.67741935483871, "wake_up": 4.67741935483871, "place_furnace": 5.645161290322581, "collect_coal": 21.129032258064516, "collect_iron": 22.258064516129032, "collect_diamond": 12.096774193548388, "make_iron_pickaxe": 5.483870967741935, "make_iron_sword": 7.580645161290323, "make_torch": 54.83870967741935, "place_torch": 47.58064516129032, "collect_sapphire": 9.193548387096774, "collect_ruby": 10.806451612903226, "make_diamond_pickaxe": 0.6451612903225806, "make_diamond_sword": 1.935483870967742, "enter_dungeon": 100.0, "defeat_orc_mage": 85.48387096774194, "find_bow": 100.0, "fire_bow": 99.35483870967742, "open_chest": 82.09677419354838, "drink_potion": 27.096774193548388}, "average_episode_length": 602.583870967742, "mean_return_percentage": 12.91472543623323, "mean_return": 29.187279485887096, "lp": NaN, "priority_score": 0.12408949011446409}]</data>
