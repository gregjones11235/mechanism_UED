      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to explore the Dungeon floor and use the ladder down to descend to the Gnomish Mines.

Description: The agent starts on Floor 1 (Dungeon) at the ladder‑up arrival point with an empty inventory. All natural mob spawning is disabled, and the level‑clearance requirement is set to zero, so the ladder down is immediately usable. The task’s only goal is to find the Ladder Down block on Floor 1 and execute the DESCEND action, thereby moving to Floor 2 and unlocking the ENTER_GNOMISH_MINES achievement. Survival needs (hunger, thirst, fatigue) are also disabled, so the agent can explore freely without resource pressure. There are no combat threats, allowing the agent to focus entirely on navigation and the new descent action.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: (none required; ENTER_DUNGEON is implicitly covered by starting on floor 1)

World:
- Player: Starting floor 1; inventory `{}`. Stats default.
- Map: No block modifications.
- Mechanics:
    "needs_depletion_multiplier": 0.0,
    "melee_spawn_multiplier": 0.0,
    "ranged_spawn_multiplier": 0.0,
    "passive_spawn_multiplier": 0.0,
    "monsters_killed_to_clear_level": 0
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = []
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            passive_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # No inventory changes, all default

        return builder.build(rng)</data>
