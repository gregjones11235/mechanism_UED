750788643535, "collect_ruby": 5.047318611987381, "make_diamond_pickaxe": 0.6309148264984227, "make_diamond_sword": 1.1041009463722398, "make_iron_armour": 91.7981072555205, "enter_dungeon": 57.88643533123028, "eat_snail": 19.558359621451103, "find_bow": 57.413249211356465, "fire_bow": 56.624605678233436, "open_chest": 57.413249211356465, "drink_potion": 22.082018927444796}, "average_episode_length": 436.8864353312303, "mean_return_percentage": 19.85447443974903, "mean_return": 44.87111223383281, "lp": NaN, "priority_score": 0.07529182298560046}]</data>
