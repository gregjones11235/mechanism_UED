ect_iron": 96.78714859437751, "collect_diamond": 26.907630522088354, "make_iron_pickaxe": 32.93172690763052, "make_iron_sword": 71.08433734939759, "make_arrow": 97.99196787148594, "make_torch": 99.59839357429719, "place_torch": 99.59839357429719, "collect_sapphire": 22.08835341365462, "collect_ruby": 25.70281124497992, "make_diamond_pickaxe": 2.0080321285140563, "make_diamond_sword": 6.024096385542169, "make_iron_armour": 8.433734939759036, "enter_gnomish_mines": 46.5863453815261, "enter_dungeon": 95.9839357429719, "defeat_orc_solider": 92.7710843373494, "defeat_orc_mage": 85.5421686746988, "eat_snail": 93.97590361445783, "find_bow": 95.58232931726907, "fire_bow": 93.57429718875503, "open_chest": 95.58232931726907, "drink_potion": 80.72289156626506}, "average_episode_length": 1098.4859437751004, "mean_return_percentage": 22.944607870086543, "mean_return": 51.85481378639558, "lp": NaN, "priority_score": 0.24883469621457718}, {"session": 148, "sr": 0.45318352059925093, "achievement_srs": {"collect_wood": 99.62546816479401, "eat_cow": 95.88014981273409, "collect_sapling": 100.0, "collect_drink": 99.25093632958801, "place_plant": 100.0, "defeat_zombie": 73.03370786516854, "collect_stone": 99.62546816479401, "place_stone": 97.00374531835206, "eat_plant": 16.10486891385768, "defeat_skeleton": 61.42322097378277, "make_stone_sword": 95.1310861423221, "wake_up": 100.0, "place_furnace": 99.62546816479401, "collect_coal": 99.25093632958801, "collect_iron": 94.38202247191012, "collect_diamond": 29.588014981273407, "make_iron_pickaxe": 38.20224719101124, "make_iron_sword": 71.16104868913858, "make_arrow": 97.00374531835206, "make_torch": 97.75280898876404, "place_torch": 97.75280898876404, "collect_sapphire": 19.475655430711612, "collect_ruby": 22.846441947565545, "make_diamond_pickaxe": 4.119850187265918, "make_diamond_sword": 5.2434456928838955, "make_iron_armour": 11.610486891385769, "enter_gnomish_mines": 45.3183520599251, "enter_dungeon": 97.75280898876404, "defeat_orc_solider": 94.00749063670412, "defeat_orc_mage": 86.51685393258427, "eat_snail": 94.38202247191012, "find_bow": 96.25468164794007, "fire_bow": 93.63295880149813, "open_chest": 96.25468164794007, "drink_potion": 81.64794007490637}, "average_episode_length": 1080.9063670411986, "mean_return_percentage": 22.82908806521577, "mean_return": 51.59373902738764, "lp": NaN, "priority_score": 0.24780821725651925}]</data>
