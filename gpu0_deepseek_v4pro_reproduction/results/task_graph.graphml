      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Increase floor 1 combat intensity by raising hostile mob spawn rates from 0.5 to 0.75, forcing the agent to handle more frequent Orc Soldier and Orc Mage encounters while still clearing the dungeon to reach the Gnomish Mines.

Description: The agent begins on floor 1 (the Dungeon) with a stone sword (tier 2) already equipped, exactly as in the preceding task. All mob spawn rates are increased from the previous half intensity: melee mobs (Orc Soldiers) now spawn at 0.75× (`melee_spawn_multiplier = 0.75`), ranged mobs (Orc Mages) at 0.75× (`ranged_spawn_multiplier = 0.75`), while passive mobs (Snails) remain at 1.0×. The floor‑clearing threshold stays at `monsters_killed_to_clear_level = 7`; the agent must defeat at least seven hostiles before the down ladder unlocks. Once the requirement is met, the agent must locate the down ladder and descend, triggering the `ENTER_GNOMISH_MINES` achievement, which is the sole success condition. All other aspects—survival needs, health regeneration, starting inventory, player attributes—are unchanged. This task incrementally raises the combat pressure, moving the agent closer to the original game’s spawn intensity and thereby strengthening the core capability needed to enter floor 2 under normal difficulty.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: ENTER_DUNGEON
World:
- Player: Starts on floor 1. Inventory: `{"sword": 2}` (stone sword). All attributes and status bars at default (STR 1, DEX 1, INT 1; health/food/drink/energy/mana all 9/9).
- Map: No modifications. The dungeon level is generated by the default procedural routine.
- Mechanics: `passive_spawn_multiplier = 1.0`, `melee_spawn_multiplier = 0.75`, `ranged_spawn_multiplier = 0.75`, `monsters_killed_to_clear_level = 7`. All other `TaskParams` remain at defaults (e.g., `melee_trigger_distance = 10`, `needs_depletion_multiplier = 1.0`).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=7,
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=0.75,
            ranged_spawn_multiplier=0.75,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon)
        builder.set_starting_floor(1)

        # Equip stone sword (tier 2)
        builder.set_player_inventory({
            "sword": 2,
        })

        # No additional placements; rely on default dungeon generation and mob spawning

        state = builder.build(rng)

        # Mark ENTER_DUNGEON as already completed
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
