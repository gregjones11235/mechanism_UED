98.59154929577464, "place_stone": 98.59154929577464, "eat_plant": 16.431924882629108, "defeat_skeleton": 46.009389671361504, "make_stone_pickaxe": 77.46478873239437, "make_stone_sword": 87.79342723004694, "wake_up": 97.65258215962442, "place_furnace": 98.59154929577464, "collect_coal": 92.48826291079813, "collect_iron": 70.4225352112676, "collect_diamond": 32.863849765258216, "make_iron_pickaxe": 20.657276995305164, "make_iron_sword": 34.27230046948357, "make_arrow": 91.07981220657277, "make_torch": 92.95774647887323, "place_torch": 92.01877934272301, "collect_sapphire": 28.63849765258216, "collect_ruby": 31.455399061032864, "make_diamond_pickaxe": 3.2863849765258215, "make_diamond_sword": 5.633802816901408, "make_iron_armour": 3.755868544600939, "enter_gnomish_mines": 61.971830985915496, "enter_dungeon": 97.65258215962442, "defeat_orc_solider": 93.42723004694835, "defeat_orc_mage": 87.32394366197182, "eat_snail": 89.2018779342723, "find_bow": 93.42723004694835, "fire_bow": 89.67136150234742, "open_chest": 93.42723004694835, "drink_potion": 83.5680751173709}, "average_episode_length": 1283.75117370892, "mean_return_percentage": 25.595806993046033, "mean_return": 57.84652380428404, "lp": NaN, "priority_score": 0.23566752628446738}]</data>
