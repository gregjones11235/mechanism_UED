": 13.333333333333334, "collect_ruby": 11.666666666666666, "make_diamond_pickaxe": 2.7777777777777777, "make_diamond_sword": 2.2222222222222223, "enter_dungeon": 100.0, "defeat_orc_solider": 81.66666666666667, "find_bow": 100.0, "fire_bow": 72.77777777777777, "open_chest": 100.0, "drink_potion": 57.77777777777778}, "average_episode_length": 1812.4888888888888, "mean_return_percentage": 15.311455740689528, "mean_return": 34.60388997395833, "lp": NaN, "priority_score": 0.23222222222222222}, {"session": 42, "sr": 0.8942307692307693, "achievement_srs": {"collect_wood": 100.0, "place_table": 100.0, "collect_sapling": 81.73076923076923, "collect_drink": 61.53846153846154, "make_wood_pickaxe": 100.0, "make_wood_sword": 100.0, "place_plant": 70.67307692307692, "collect_stone": 100.0, "place_stone": 88.46153846153847, "eat_plant": 8.89423076923077, "wake_up": 6.25, "place_furnace": 95.91346153846153, "collect_coal": 100.0, "collect_iron": 94.71153846153847, "collect_diamond": 15.865384615384615, "make_iron_pickaxe": 12.259615384615385, "make_iron_sword": 97.83653846153847, "make_arrow": 98.79807692307692, "make_torch": 78.84615384615384, "place_torch": 60.81730769230769, "collect_sapphire": 12.5, "collect_ruby": 12.01923076923077, "make_diamond_pickaxe": 0.7211538461538461, "make_diamond_sword": 2.4038461538461537, "enter_dungeon": 100.0, "defeat_orc_solider": 90.625, "find_bow": 99.27884615384616, "fire_bow": 90.38461538461539, "open_chest": 99.27884615384616, "drink_potion": 37.5}, "average_episode_length": 645.1225961538462, "mean_return_percentage": 18.17970146038972, "mean_return": 41.08612530048077, "lp": NaN, "priority_score": 0.09458210059171594}]</data>
