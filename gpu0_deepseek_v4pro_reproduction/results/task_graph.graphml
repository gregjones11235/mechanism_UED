      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Generalise the overworld‑to‑Gnomish‑Mines sequence by forcing the agent to start from a completely empty inventory, mimicking the full Craftax game start, while keeping the same terminal goals.

Description: The agent begins on the Overworld (floor 0) at the default center spawn with no items, tools, or resources. It must autonomously collect wood, craft a wood pickaxe, mine stone and coal, place a crafting table, craft a stone sword, and optionally craft torches. The ladder down to the Dungeon is already open (monsters_killed[0] = 10). The agent descends into the Dungeon (floor 1), where it must defeat 4 Orc Soldiers or Orc Mages (standard melee/ranged behaviour, full damage) and then step onto the ladder down to trigger ENTER_GNOMISH_MINES. The task terminates successfully only when both MAKE_STONE_SWORD and ENTER_GNOMISH_MINES are achieved. All other crafting steps are permitted but not required for success; survival mechanics use default rates. This task is identical to the parent except the initial inventory is emptied, forcing the agent to practise the full autonomous preparation pipeline.

Relevant Achievements: MAKE_STONE_SWORD, ENTER_GNOMISH_MINES

Completed Achievements: [none]

World:
- Player: Starting floor: 0 (Overworld). Inventory: empty. Attributes: strength=1, dexterity=1, intelligence=1. Health/Food/Drink/Energy/Mana all 9/9. Enchantments and spells at default (none).
- Map: No manual block modifications; the default Overworld and Dungeon generation are used.
- Mechanics:
  - monsters_killed_to_clear_level = 4 (applies globally; floor 0 remains pre‑cleared with kills=10)
  - needs_depletion_multiplier = 1.0
  - mob_damage_multiplier = 1.0
  - health_recover_multiplier = 1.0
  - health_loss_multiplier = 1.0
  - mana_recover_multiplier = 1.0
  - All spawn multipliers (passive, melee, ranged) = 1.0
  - All other TaskParams at default.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.MAKE_STONE_SWORD,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = []  # none
        self.label = "MAKE_STONE_SWORD, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=4,
            # All other multipliers remain at their default values (1.0)
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld) at the default spawn
        builder.set_starting_floor(0)

        # Pre‑unlock the Overworld ladder down by setting kills to 10
        builder.set_monsters_killed(level=0, count=10)

        # No inventory set – agent starts with nothing
        # No block/mob placements – default procedural generation

        state = builder.build(rng)

        # No pre‑completed achievements to mark
        return state</data>
