6.882591093117409, "make_iron_armour": 3.6437246963562755, "enter_gnomish_mines": 60.32388663967611, "enter_dungeon": 98.38056680161944, "defeat_orc_solider": 95.95141700404858, "defeat_orc_mage": 92.71255060728745, "eat_snail": 97.16599190283401, "find_bow": 96.76113360323886, "fire_bow": 94.73684210526316, "open_chest": 96.76113360323886, "drink_potion": 82.5910931174089}, "average_episode_length": 1116.2793522267207, "mean_return_percentage": 24.459690931666724, "mean_return": 55.2789015055668, "lp": NaN, "priority_score": 0.2393417364651117}, {"session": 148, "sr": 0.6746987951807228, "achievement_srs": {"collect_wood": 99.19678714859438, "place_table": 98.39357429718875, "eat_cow": 93.1726907630522, "collect_sapling": 100.0, "collect_drink": 99.59839357429719, "make_wood_pickaxe": 100.0, "make_wood_sword": 100.0, "place_plant": 100.0, "defeat_zombie": 62.24899598393574, "collect_stone": 98.39357429718875, "place_stone": 97.99196787148594, "eat_plant": 14.056224899598394, "defeat_skeleton": 64.65863453815261, "wake_up": 99.59839357429719, "place_furnace": 98.39357429718875, "collect_coal": 96.3855421686747, "collect_iron": 86.74698795180723, "collect_diamond": 32.93172690763052, "make_iron_pickaxe": 29.718875502008032, "make_iron_sword": 67.46987951807229, "make_arrow": 95.18072289156626, "make_torch": 97.18875502008032, "place_torch": 96.78714859437751, "collect_sapphire": 32.53012048192771, "collect_ruby": 28.91566265060241, "make_diamond_pickaxe": 2.8112449799196786, "make_diamond_sword": 4.417670682730924, "make_iron_armour": 4.417670682730924, "enter_gnomish_mines": 67.46987951807229, "enter_dungeon": 97.59036144578313, "defeat_orc_solider": 97.18875502008032, "defeat_orc_mage": 92.36947791164658, "eat_snail": 97.18875502008032, "find_bow": 97.18875502008032, "fire_bow": 93.57429718875503, "open_chest": 97.18875502008032, "drink_potion": 83.93574297188755}, "average_episode_length": 1113.3413654618473, "mean_return_percentage": 25.348922307037885, "mean_ret