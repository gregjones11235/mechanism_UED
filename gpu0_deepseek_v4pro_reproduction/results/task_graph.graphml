      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to defeat a mixed group of melee and ranged enemies in the darkness of the Dungeon before descending to Gnomish Mines.

Description: The agent starts on Floor 1 (Dungeon) at the Ladder Up position, all vital stats at maximum (9) and attributes at 1. The inventory contains a wood sword, a bow, 15 arrows, and 20 torches. The level is pitch‑black, and the agent must place torches to illuminate its surroundings. One Orc Soldier (melee, type id 2) and one Orc Mage (ranged, type id 2) are spawned randomly on path blocks within 5–10 Manhattan distance of the starting position. No other mobs exist, and all spawn multipliers are set to zero. The floor’s kill count is initialised at 0, and `monsters_killed_to_clear_level` is set to 2, meaning both enemies must be defeated to unlock the Ladder Down. Mob health and damage are slightly reduced (multiplier 0.8) to keep the combat accessible. After defeating both enemies, the agent must locate the naturally generated Ladder Down and use the Descend action to achieve `ENTER_GNOMISH_MINES`, ending the episode successfully. The dungeon retains its standard rooms, corridors, chests, and fountains, but none are required for success.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: ENTER_DUNGEON, FIND_BOW, MAKE_ARROW, MAKE_WOOD_SWORD, MAKE_TORCH

World:
- Player: `builder.set_starting_floor(1)`. Inventory provided by `builder.set_player_inventory({"sword": 1, "bow": 1, "arrows": 15, "torches": 20})`.
- Map: `builder.set_monsters_killed(level=1, count=0)`. Place one melee Orc Soldier: `builder.add_mobs_randomly_near(rng, 1, "melee", 2, n=1, target_pos=player_start_pos, min_dist=5, max_dist=10, on_blocks=[BlockType.PATH])`. Place one ranged Orc Mage: `builder.add_mobs_randomly_near(rng, 1, "ranged", 2, n=1, target_pos=player_start_pos, min_dist=5, max_dist=10, on_blocks=[BlockType.PATH])`.
- Mechanics: `passive_spawn_multiplier = 0.0`, `melee_spawn_multiplier = 0.0`, `ranged_spawn_multiplier = 0.0`. `monsters_killed_to_clear_level = 2`. `mob_health_multiplier = 0.8`, `mob_damage_multiplier = 0.8`. All other TaskParams remain default.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.FIND_BOW,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_TORCH,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=0.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            mob_health_multiplier=0.8,
            mob_damage_multiplier=0.8,
            monsters_killed_to_clear_level=2,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, mob_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Equip starting inventory: wood sword, bow, 15 arrows, 20 torches
        builder.set_player_inventory({
            "sword": 1,       # wood sword (level 1)
            "bow": 1,         # bow
            "arrows": 15,
            "torches": 20,
        })

        # Reset kill counter for floor 1 to 0 so the ladder is locked
        builder.set_monsters_killed(level=1, count=0)

        # Player spawn position (up ladder on floor 1)
        player_start_pos = builder.player_position

        # Split rng for mob placements
        mob_rng1, mob_rng2 = jax.random.split(mob_rng)

        # Place one Orc Soldier (melee, type_id=2) near spawn
        builder.add_mobs_randomly_near(
            mob_rng1,
            level=1,
            mob_name="melee",
            type_id=2,
            n=1,
            target_pos=player_start_pos,
            min_dist=5,
            max_dist=10,
            on_blocks=[BlockType.PATH],
        )

        # Place one Orc Mage (ranged, type_id=2) near spawn
        builder.add_mobs_randomly_near(
            mob_rng2,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=1,
            target_pos=player_start_pos,
            min_dist=5,
            max_dist=10,
            on_blocks=[BlockType.PATH],
        )

        state = builder.build(rng)

        # Mark pre-completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
