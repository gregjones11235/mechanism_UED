      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Sustain combat on Floor 1 to clear 8 hostile mobs and descend to the Gnomish Mines, using a Stone Sword and bow, without retreating to the Overworld.

Description: The agent begins on Floor 1 (Dungeon) with a bow, 10 arrows, and a Stone Sword, representing a fully equipped adventurer who has already conquered the Overworld. Survival needs are set to a moderate half‑rate (`needs_depletion_multiplier` = 0.5) so that hunger, thirst, and fatigue pressure exist but are not overwhelming. Passive snails spawn at 0.3x to provide food, and hostile mob rates are moderately boosted (`melee_spawn_multiplier` = 0.6, `ranged_spawn_multiplier` = 0.5) to keep the floor populated. The critical escalation is that **8 kills** are now required to unlock the ladder down, up from 7 in the previous task, pushing the agent’s combat endurance one step closer to the full game’s requirement. Two initial mobs—an Orc Soldier (melee, type_id=2) and an Orc Mage (ranged, type_id=2)—are placed within 5–8 tiles of spawn to guarantee early engagements. The agent must hunt snails, ration arrows, and fight through all spawns to achieve the floor clear, without the distraction of ascending to the Overworld for better tools (the Stone Sword removes that temptation). This task targets the global failure to enter the Gnomish Mines by training sustained Dungeon combat with the true kill goal.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: FIND_BOW, MAKE_ARROW, MAKE_STONE_SWORD

World:
- Player: Floor 1 (spawn at ladder‑up position). Inventory: {"bow": 1, "arrows": 10, "sword": 2} (sword tier 2 = Stone Sword). Stats: Strength 1, Dexterity 1, Intelligence 1. Health/Food/Drink/Energy/Mana all full (9/9). Learned spells: none. Weapon/Armour enchantments: none.
- Map:
    - Use default Dungeon generation for Floor 1.
    - Place one melee mob (Orc Soldier, "melee", type_id=2) using `add_mobs_randomly_near`, target_pos = player spawn, n=1, min_dist=5, max_dist=8, on_blocks = [BlockType.PATH].
    - Place one ranged mob (Orc Mage, "ranged", type_id=2) using `add_mobs_randomly_near`, target_pos = player spawn, n=1, min_dist=5, max_dist=8, on_blocks = [BlockType.PATH].
    - No other mobs pre‑placed.
- Mechanics:
    "needs_depletion_multiplier": 0.5,
    "melee_spawn_multiplier": 0.6,
    "ranged_spawn_multiplier": 0.5,
    "passive_spawn_multiplier": 0.3,
    "monsters_killed_to_clear_level": 8,
    "health_recover_multiplier": 1.0,
    "health_loss_multiplier": 1.0,
    "mob_health_multiplier": 1.0,
    "mob_damage_multiplier": 1.0
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.FIND_BOW,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_STONE_SWORD,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        return TaskParams(
            needs_depletion_multiplier=0.5,
            melee_spawn_multiplier=0.6,
            ranged_spawn_multiplier=0.5,
            passive_spawn_multiplier=0.3,
            monsters_killed_to_clear_level=8,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        rng, build_rng, melee_rng, ranged_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Equip bow, arrows, and stone sword
        builder.set_player_inventory({
            "bow": 1,
            "arrows": 10,
            "sword": 2,   # Stone Sword (tier 2)
        })

        # Spawn point is the up-ladder on floor 1
        spawn_pos = builder.ladders_up[1]

        # Add one Orc Soldier (melee, type_id=2) within 5-8 tiles
        builder.add_mobs_randomly_near(
            melee_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=1,
            target_pos=spawn_pos,
            min_dist=5,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        # Add one Orc Mage (ranged, type_id=2) within 5-8 tiles
        builder.add_mobs_randomly_near(
            ranged_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=1,
            target_pos=spawn_pos,
            min_dist=5,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        state = builder.build(rng)

        # Mark completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
