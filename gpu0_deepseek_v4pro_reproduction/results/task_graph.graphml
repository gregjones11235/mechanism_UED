_arrow": 77.8443113772455, "place_torch": 96.40718562874251, "make_iron_armour": 10.179640718562874, "enter_dungeon": 74.25149700598803}, "average_episode_length": 1709.2874251497005, "mean_return_percentage": 13.920960278005937, "mean_return": 31.461370228293415, "lp": NaN, "priority_score": 0.19118648929685542}, {"session": 38, "sr": 0.9507829977628636, "achievement_srs": {"eat_cow": 78.97091722595079, "collect_sapling": 99.77628635346755, "collect_drink": 79.19463087248322, "place_plant": 99.32885906040268, "defeat_zombie": 52.12527964205817, "place_stone": 95.97315436241611, "eat_plant": 16.107382550335572, "defeat_skeleton": 49.4407158836689, "place_furnace": 93.73601789709173, "collect_iron": 63.982102908277405, "make_iron_pickaxe": 11.185682326621924, "make_iron_sword": 8.724832214765101, "make_arrow": 72.93064876957494, "place_torch": 95.07829977628636, "make_iron_armour": 7.382550335570469, "enter_dungeon": 95.07829977628636}, "average_episode_length": 658.5324384787472, "mean_return_percentage": 15.43970813597533, "mean_return": 34.89374038730425, "lp": NaN, "priority_score": 0.04679468892792614}]</data>
