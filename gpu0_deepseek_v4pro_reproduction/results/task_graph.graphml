      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to clear multiple orcs on Floor 1 and descend to the Gnomish Mines, combining survival with sustained combat to unlock the critical Floor‑2 transition.

Description: The agent spawns on Floor 1 with a stone sword, stone pickaxe, bow, and a small supply of arrows, wood, and stone. Full survival mechanics are active (hunger, thirst, fatigue, health loss). Four hostile orcs—two Orc Soldiers (melee, type_id=2) and two Orc Mages (ranged, type_id=2)—are pre‑placed near the player. The kill requirement to clear the floor is set to 4, so the agent must defeat all four enemies to unlock the ladder down. Passive snail spawning is enabled (passive_spawn_multiplier = 1.0) as a food source; fountains provide drink. No additional hostiles spawn. The task ends successfully when the agent steps onto the ladder down and descends to Floor 2, earning ENTER_GNOMISH_MINES. This task extends the parent by requiring the agent to handle a larger, mixed group of orcs while managing survival, directly training the ability to progress beyond the Dungeon in the full Craftax game.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, FIND_BOW

World:
- Player: Floor 1 (spawn at the ladder‑up position). Inventory: {"sword": 1, "pickaxe": 1, "bow": 1, "arrows": 5, "wood": 10, "stone": 5}. All stats default (Strength 1, Dexterity 1, Intelligence 1; Health/Food/Drink/Energy/Mana all 9/9). No spells learned, no enchantments.
- Map:
    - Use default Dungeon generation for Floor 1 (rooms, corridors, chests, fountains, torches).
    - Place exactly two melee Orc Soldiers (mob_name="melee", type_id=2) using `add_mobs_randomly_near` with target_pos = player spawn, n=2, min_dist=2, max_dist=8, on any walkable terrain.
    - Place exactly two ranged Orc Mages (mob_name="ranged", type_id=2) using `add_mobs_randomly_near` with target_pos = player spawn, n=2, min_dist=2, max_dist=8, on any walkable terrain.
- Mechanics:
    - needs_depletion_multiplier = 1.0
    - passive_spawn_multiplier = 1.0
    - melee_spawn_multiplier = 0.0
    - ranged_spawn_multiplier = 0.0
    - monsters_killed_to_clear_level = 4
    - health_recover_multiplier = 1.0
    - health_loss_multiplier = 1.0
    - mana_recover_multiplier = 1.0
    - mob_health_multiplier = 1.0
    - mob_damage_multiplier = 1.0
    - melee_trigger_distance = 10
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_GNOMISH_MINES]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.FIND_BOW,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=4,
            needs_depletion_multiplier=1.0,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            melee_trigger_distance=10,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, mob_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(1)
        player_pos = builder.player_position

        # Set inventory: stone sword=2, stone pickaxe=2, bow=1, arrows=5, wood=10, stone=5
        builder.set_player_inventory({
            "sword": 2,
            "pickaxe": 2,
            "bow": 1,
            "arrows": 5,
            "wood": 10,
            "stone": 5,
        })

        # Place two Orc Soldiers (melee, type_id=2)
        rng1, rng2 = jax.random.split(mob_rng)
        builder.add_mobs_randomly_near(
            rng1,
            level=1,
            mob_name="melee",
            type_id=2,
            n=2,
            target_pos=player_pos,
            min_dist=2,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        # Place two Orc Mages (ranged, type_id=2)
        builder.add_mobs_randomly_near(
            rng2,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=2,
            target_pos=player_pos,
            min_dist=2,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        return builder.build(rng)</data>
