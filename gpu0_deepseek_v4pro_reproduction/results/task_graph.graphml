ire": 20.38327526132404, "collect_ruby": 22.299651567944252, "make_diamond_pickaxe": 2.6132404181184667, "make_diamond_sword": 3.3101045296167246, "enter_gnomish_mines": 76.30662020905923, "enter_dungeon": 100.0, "defeat_orc_solider": 99.30313588850174, "defeat_orc_mage": 93.55400696864112, "eat_snail": 96.16724738675958, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 97.90940766550523, "drink_potion": 72.12543554006969}, "average_episode_length": 478.8414634146341, "mean_return_percentage": 18.3093544395216, "mean_return": 41.37914103331882, "lp": NaN, "priority_score": 0.18079617331763165}]</data>
