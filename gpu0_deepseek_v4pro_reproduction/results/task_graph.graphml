86.60714285714286, "make_torch": 86.30952380952381, "place_torch": 84.52380952380952, "collect_sapphire": 19.047619047619047, "collect_ruby": 19.047619047619047, "make_diamond_pickaxe": 3.5714285714285716, "make_diamond_sword": 2.0833333333333335, "enter_gnomish_mines": 67.26190476190476, "enter_dungeon": 100.0, "defeat_orc_solider": 99.10714285714286, "defeat_orc_mage": 88.39285714285714, "find_bow": 92.55952380952381, "fire_bow": 83.33333333333333, "open_chest": 92.55952380952381, "drink_potion": 75.0}, "average_episode_length": 778.8065476190476, "mean_return_percentage": 19.034181282181706, "mean_return": 43.017249697730655, "lp": NaN, "priority_score": 0.22020266439909295}]</data>
