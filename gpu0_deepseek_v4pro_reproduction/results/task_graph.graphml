      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to descend from the Dungeon to the Gnomish Mines while actively managing hunger, thirst, and fatigue, without any combat pressure.

Description:
This task focuses on the core ladder‑descent mechanic under normal survival needs. The agent starts on Floor 1 (the Dungeon) with the same inventory as the previous combat‑survival task: a stone sword, a bow, 20 arrows, and 4 torches. All hostile mob spawning is disabled (`melee_spawn_multiplier = 0.0`, `ranged_spawn_multiplier = 0.0`), and the kill‑to‑clear threshold is lowered to zero (`monsters_killed_to_clear_level = 0`). Passive mob spawning remains enabled (`passive_spawn_multiplier = 1.0`) so Snails (passive type 2) appear naturally and can be killed for food (EAT_SNAIL). Fountains within the Dungeon provide water (COLLECT_DRINK). The agent must explore the procedurally generated rooms and corridors, locate the Ladder Down, and use the DESCEND action to enter the Gnomish Mines (Floor 2). Survival depletion rates are at default values (`needs_depletion_multiplier = 1.0`, etc.). The episode terminates successfully upon entering Floor 2.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: ENTER_DUNGEON, MAKE_STONE_SWORD, FIND_BOW, MAKE_ARROW, MAKE_TORCH

World:
- Player: Starts on floor 1 with inventory `{"sword": 2, "bow": 1, "arrows": 20, "torches": 4}`. All attributes at level 1; health, food, drink, energy at max 9.
- Map: No manual mob or block modifications; the default Dungeon generation is used (rooms, corridors, chests, fountains, torches in corners).
- Mechanics:
  * `melee_spawn_multiplier = 0.0`
  * `ranged_spawn_multiplier = 0.0`
  * `passive_spawn_multiplier = 1.0`
  * `needs_depletion_multiplier = 1.0`
  * `health_recover_multiplier = 1.0`
  * `health_loss_multiplier = 1.0`
  * `mob_health_multiplier = 1.0` (unused)
  * `mob_damage_multiplier = 1.0` (unused)
  * `monsters_killed_to_clear_level = 0`
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.MAKE_STONE_SWORD,
            Achievement.FIND_BOW,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_TORCH,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            passive_spawn_multiplier=1.0,
            needs_depletion_multiplier=1.0,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            monsters_killed_to_clear_level=0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon)
        builder.set_starting_floor(1)

        # Starting inventory: stone sword, bow, 20 arrows, 4 torches
        builder.set_player_inventory({
            "sword": 2,      # stone sword
            "bow": 1,
            "arrows": 20,
            "torches": 4,
        })

        # Build initial state (no additional mob/block modifications)
        state = builder.build(rng)

        # Mark required pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
