461539, "eat_plant": 11.384615384615385, "defeat_skeleton": 27.076923076923077, "wake_up": 96.3076923076923, "place_furnace": 99.38461538461539, "collect_coal": 78.76923076923077, "collect_iron": 77.53846153846153, "collect_diamond": 29.846153846153847, "make_iron_pickaxe": 15.384615384615385, "make_iron_sword": 35.38461538461539, "place_torch": 100.0, "collect_sapphire": 30.76923076923077, "collect_ruby": 26.46153846153846, "make_diamond_pickaxe": 3.6923076923076925, "make_diamond_sword": 4.615384615384615, "enter_gnomish_mines": 57.53846153846154, "enter_dungeon": 100.0, "defeat_orc_solider": 98.76923076923077, "defeat_orc_mage": 95.07692307692308, "eat_snail": 97.84615384615384, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 99.6923076923077, "drink_potion": 79.6923076923077}, "average_episode_length": 836.9261538461539, "mean_return_percentage": 18.02397597217495, "mean_return": 40.734185697115386, "lp": NaN, "priority_score": 0.2443171597633136}, {"session": 144, "sr": 0.5825545171339563, "achievement_srs": {"collect_wood": 100.0, "place_table": 99.68847352024922, "eat_cow": 60.74766355140187, "collect_sapling": 73.5202492211838, "collect_drink": 95.01557632398755, "make_wood_pickaxe": 99.68847352024922, "make_wood_sword": 100.0, "place_plant": 73.5202492211838, "defeat_zombie": 35.202492211838006, "collect_stone": 100.0, "place_stone": 94.0809968847352, "eat_plant": 13.707165109034268, "defeat_skeleton": 30.8411214953271, "wake_up": 96.26168224299066, "place_furnace": 99.06542056074767, "collect_coal": 80.68535825545172, "collect_iron": 66.97819314641744, "collect_diamond": 30.218068535825545, "make_iron_pickaxe": 22.741433021806852, "make_iron_sword": 30.529595015576323, "place_torch": 99.68847352024922, "collect_sapphire": 24.922118380062305, "collect_ruby": 24.922118380062305, "make_diamond_pickaxe": 4.984423676012461, "make_diamond_sword": 4.361370716510903, "enter_gnomish_mines": 58.25545171339564, "enter_dungeon": 100.0, "defeat_orc_solider": 97.50778816199377, "defeat_orc_mage": 93.76947040498442, "eat_snail": 99.06542056074767, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 99.68847352024922, "drink_potion": 78.81619937694704}, "average_episode_length": 908.0155763239875, "mean_return_percentage": 18.101252136575415, "mean_return": 40.90882982866044, "lp": NaN, "priority_score": 0.2431847517007793}]</data>
