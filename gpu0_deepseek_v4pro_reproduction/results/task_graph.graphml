 "open_chest": 96.44444444444444, "drink_potion": 85.77777777777777}, "average_episode_length": 1260.8533333333332, "mean_return_percentage": 23.89125107546706, "mean_return": 53.994227430555554, "lp": NaN, "priority_score": 0.2264888888888889}]</data>
