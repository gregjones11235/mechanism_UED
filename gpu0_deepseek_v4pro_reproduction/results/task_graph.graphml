      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Defeat a single Orc Soldier on the Dungeon floor while an enemy Orc Mage is also present, using a pre‑equipped iron sword, no survival pressure, and no other mobs.

    Description: The agent begins on Floor 1 (Dungeon) at the ladder‑up arrival point. Its inventory contains an iron sword (`sword`: 3), and all survival needs are disabled (`needs_depletion_multiplier = 0.0`). Health regeneration is boosted (`health_recover_multiplier = 2.0`) to aid recovery from multiple attacks. All passive and natural hostile spawns are suppressed (`passive_spawn_multiplier = 0.0`, `melee_spawn_multiplier = 0.0`, `ranged_spawn_multiplier = 0.0`). The agent must locate and kill the Orc Soldier; the Orc Mage is an additional threat that the agent needs to contend with but is not required to defeat for success. The Orc Soldier (melee mob, `mob_name = "melee"`, `type_id = 2`) and the Orc Mage (ranged mob, `mob_name = "ranged"`, `type_id = 2`) are each placed randomly on Floor 1 on walkable Dungeon tiles (`on_blocks = [BlockType.PATH]`) at a Manhattan distance between 4 and 8 from the player’s start position. Both mobs are present from the first timestep, forcing the agent to manage a melee pursuer and a ranged attacker simultaneously.

    Relevant Achievements: DEFEAT_ORC_SOLIDER
    Completed Achievements: ENTER_DUNGEON, MAKE_IRON_SWORD
    World:
    - Player: Starting floor 1; inventory contains an iron sword (`{"sword": 3}`). All other stats default.
    - Map: On Floor 1, place one Orc Soldier (`mob_name = "melee"`, `type_id = 2`) randomly within Manhattan distance 4–8 from the player’s starting position, using `on_blocks = [BlockType.PATH]`. Additionally, place one Orc Mage (`mob_name = "ranged"`, `type_id = 2`) randomly within the same distance range and on the same block type, independently of the Orc Soldier.
    - Mechanics:
        "needs_depletion_multiplier": 0.0,
        "health_recover_multiplier": 2.0,
        "melee_spawn_multiplier": 0.0,
        "passive_spawn_multiplier": 0.0,
        "ranged_spawn_multiplier": 0.0
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.DEFEAT_ORC_SOLIDER]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.MAKE_IRON_SWORD,
        ]
        self.label = "DEFEAT_ORC_SOLIDER"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.0,
            health_recover_multiplier=2.0,
            melee_spawn_multiplier=0.0,
            passive_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, melee_rng, ranged_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on Floor 1 (Dungeon) at the ladder-up point
        builder.set_starting_floor(1)

        # Equip iron sword (3 = iron)
        builder.set_player_inventory({"sword": 3})

        # Place Orc Soldier (melee, type_id=2) randomly 4-8 tiles away on path blocks
        builder.add_mobs_randomly_near(
            melee_rng,
            level=1,
            mob_name="melee",
            type_id=2,        # Orc Soldier
            n=1,
            target_pos=builder.player_position,
            min_dist=4,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        # Place Orc Mage (ranged, type_id=2) randomly 4-8 tiles away on path blocks
        builder.add_mobs_randomly_near(
            ranged_rng,
            level=1,
            mob_name="ranged",
            type_id=2,        # Orc Mage
            n=1,
            target_pos=builder.player_position,
            min_dist=4,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        return builder.build(rng)</data>
