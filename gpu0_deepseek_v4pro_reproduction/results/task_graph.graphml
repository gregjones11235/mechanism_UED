": {"collect_wood": 97.95918367346938, "place_table": 93.19727891156462, "eat_cow": 89.79591836734694, "collect_sapling": 98.63945578231292, "collect_drink": 74.14965986394557, "make_wood_pickaxe": 90.47619047619048, "place_plant": 97.95918367346938, "collect_stone": 83.6734693877551, "place_stone": 83.6734693877551, "eat_plant": 48.29931972789116, "defeat_skeleton": 34.01360544217687, "make_stone_pickaxe": 61.224489795918366, "make_stone_sword": 57.142857142857146, "wake_up": 80.95238095238095, "place_furnace": 82.99319727891157, "collect_coal": 68.02721088435374, "collect_iron": 63.945578231292515, "collect_diamond": 22.448979591836736, "make_iron_pickaxe": 46.93877551020408, "make_iron_sword": 38.775510204081634, "make_arrow": 63.265306122448976, "make_torch": 68.70748299319727, "place_torch": 66.66666666666667, "collect_sapphire": 19.727891156462587, "collect_ruby": 16.3265306122449, "make_diamond_pickaxe": 4.761904761904762, "make_diamond_sword": 3.401360544217687, "make_iron_armour": 21.08843537414966, "enter_dungeon": 68.02721088435374, "eat_snail": 66.66666666666667, "find_bow": 68.02721088435374, "fire_bow": 61.904761904761905, "open_chest": 68.02721088435374, "drink_potion": 60.54421768707483}, "average_episode_length": 2192.0204081632655, "mean_return_percentage": 16.095062195232074, "mean_return": 36.37484056122449, "lp": NaN, "priority_score": 0.2244435189041603}]</data>
