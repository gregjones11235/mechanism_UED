      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Teach the agent to defeat a Gnome Warrior on floor 2 after safely entering the Gnomish Mines.

Description: The agent begins on floor 2 (Gnomish Mines) directly at the up‑ladder, with inventory that reflects a competent clear of the Dungeon: wood_pickaxe = 1, stone_sword = 1, bow = 1, arrows = 10, torches = 5, wood = 5, stone = 5, coal = 3. A crafting table is placed on a walkable tile adjacent to the start (position + (1,0)). All hostile mob spawning is disabled (melee_spawn_multiplier=0.0, ranged_spawn_multiplier=0.0) so that the only hostile present is a single Gnome Warrior placed exactly 4 tiles away from the start (Manhattan distance = 4), on a walkable tile (e.g., path or stone). This mob has reduced health (mob_health_multiplier = 0.7) so that the encounter is learnable but still requires several hits. Survival needs are almost frozen (needs_depletion_multiplier = 0.1) to keep focus on combat. The episode terminates successfully when the agent defeats the Gnome Warrior, earning the DEFEAT_GNOME_WARRIOR achievement. All achievements that would normally be acquired before this point are marked as Completed.

Relevant Achievements: DEFEAT_GNOME_WARRIOR

Completed Achievements: MAKE_WOOD_PICKAXE, PLACE_TABLE, MAKE_STONE_SWORD, FIND_BOW, MAKE_ARROW, MAKE_TORCH, PLACE_TORCH, ENTER_DUNGEON, ENTER_GNOMISH_MINES, OPEN_CHEST, FIRE_BOW

World:
- Player: Starts on floor 2 (Gnomish Mines) at the up‑ladder. Inventory: wood_pickaxe = 1, stone_sword = 1, bow = 1, arrows = 10, torches = 5, wood = 5, stone = 5, coal = 3. All other slots empty. Attributes: strength = 1, dexterity = 1, intelligence = 1. Health, food, drink, energy, mana all 9/9. Weapon/armour enchantments all 0. Learned spells false.
- Map:
  - Place a Crafting Table at the player start position + (1, 0) on a walkable tile (BlockType.PATH or BlockType.STONE).
  - Place one Gnome Warrior (mob_name="Gnome Warrior", type_id=1) at a walkable tile exactly 4 Manhattan distance units from the player start position (e.g., (start_row+2, start_col+2)) using add_mobs_randomly_near with min_dist=4, max_dist=4, n=1, on_blocks=[BlockType.PATH, BlockType.STONE, BlockType.SAND] (any non‑solid surface typical of floor 2).
  - No other block or mob modifications; the rest of the floor uses normal procedural generation.
- Mechanics:
  - melee_spawn_multiplier = 0.0 (no additional melee spawns)
  - ranged_spawn_multiplier = 0.0 (no additional ranged spawns)
  - passive_spawn_multiplier = 0.0 (no passive spawns)
  - mob_health_multiplier = 0.7
  - mob_damage_multiplier = 1.0
  - needs_depletion_multiplier = 0.1
  - All other TaskParams (monsters_killed_to_clear_level, health_recover_multiplier, etc.) remain at default values.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.DEFEAT_GNOME_WARRIOR,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.PLACE_TABLE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.FIND_BOW,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_TORCH,
            Achievement.PLACE_TORCH,
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
            Achievement.OPEN_CHEST,
            Achievement.FIRE_BOW,
        ]
        self.label = "DEFEAT_GNOME_WARRIOR"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=0.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            mob_health_multiplier=0.7,
            mob_damage_multiplier=1.0,
            needs_depletion_multiplier=0.1,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, mob_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines) at the up-ladder
        builder.set_starting_floor(2)

        # Equip starting inventory
        builder.set_player_inventory({
            "pickaxe": 1,   # wood pickaxe
            "sword": 2,     # stone sword (tier 2)
            "bow": 1,       # bow
            "arrows": 10,
            "torches": 5,
            "wood": 5,
            "stone": 5,
            "coal": 3,
        })

        # Get the player spawn position on floor 2
        spawn_pos = builder.player_position

        # Place a crafting table on the tile directly to the right (row unchanged, col+1)
        table_pos = (spawn_pos[0] + 1, spawn_pos[1])
        builder.place_block(level=2, block_type=BlockType.CRAFTING_TABLE, position=table_pos)

        # Place one Gnome Warrior (melee, type_id=1) exactly 4 tiles away
        builder.add_mobs_randomly_near(
            mob_rng,
            level=2,
            mob_name="melee",
            type_id=1,
            n=1,
            target_pos=spawn_pos,
            min_dist=4,
            max_dist=4,
            on_blocks=[BlockType.PATH, BlockType.STONE],
        )

        state = builder.build(rng)

        # Mark pre-completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
      <data key="d4">[{"session": 125, "sr": 0.2018348623853211, "achievement_srs": {"collect_wood": 100.0, "collect_sapling": 77.98165137614679, "collect_drink": 79.81651376146789, "make_wood_sword": 100.0, "place_plant": 77.98165137614679, "collect_stone": 100.0, "place_stone": 87.1559633027523, "eat_plant": 66.05504587155963, "make_stone_pickaxe": 78.89908256880734, "wake_up": 79.81651376146789, "place_furnace": 81.65137614678899, "collect_coal": 100.0, "collect_iron": 77.98165137614679, "collect_diamond": 32.11009174311926, "make_iron_pickaxe": 73.39449541284404, "make_iron_sword": 63.30275229357798, "collect_sapphire": 39.44954128440367, "collect_ruby": 34.862385321100916, "make_diamond_pickaxe": 7.339449541284404, "enter_gnomish_mines": 100.0, "enter_dungeon": 100.0, "defeat_gnome_warrior": 20.18348623853211, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 100.0, "drink_potion": 77.98165137614679}, "average_episode_length": 3010.0366972477063, "mean_return_percentage": 8.816674751169625, "mean_return": 19.92568493764335, "lp": NaN, "priority_score": 0.1610975507112196}]</data>
