222222, "defeat_skeleton": 23.88888888888889, "make_stone_pickaxe": 46.388888888888886, "make_stone_sword": 100.0, "wake_up": 96.38888888888889, "place_furnace": 50.0, "collect_coal": 65.0, "collect_iron": 63.611111111111114, "collect_diamond": 37.77777777777778, "make_iron_pickaxe": 20.833333333333332, "make_arrow": 79.16666666666667, "make_torch": 93.61111111111111, "place_torch": 92.77777777777777, "collect_sapphire": 28.333333333333332, "collect_ruby": 26.38888888888889, "make_diamond_pickaxe": 3.0555555555555554, "make_diamond_sword": 4.166666666666667, "enter_gnomish_mines": 53.611111111111114, "enter_dungeon": 100.0, "defeat_orc_solider": 96.94444444444444, "defeat_orc_mage": 93.88888888888889, "eat_snail": 98.88888888888889, "find_bow": 99.72222222222223, "fire_bow": 78.05555555555556, "open_chest": 99.72222222222223, "drink_potion": 85.83333333333333}, "average_episode_length": 780.0111111111111, "mean_return_percentage": 20.14141431600295, "mean_return": 45.519596354166666, "lp": NaN, "priority_score": 0.248695987654321}]</data>
