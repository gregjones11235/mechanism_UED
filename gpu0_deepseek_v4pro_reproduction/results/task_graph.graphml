tone_pickaxe": 88.0952380952381, "wake_up": 21.03174603174603, "place_furnace": 96.42857142857143, "collect_coal": 93.65079365079364, "collect_iron": 81.34920634920636, "collect_diamond": 24.206349206349206, "make_iron_pickaxe": 44.04761904761905, "make_iron_sword": 57.142857142857146, "place_torch": 100.0, "collect_sapphire": 25.396825396825395, "collect_ruby": 26.19047619047619, "make_diamond_pickaxe": 4.761904761904762, "make_diamond_sword": 5.555555555555555, "make_iron_armour": 9.523809523809524, "enter_gnomish_mines": 70.23809523809524, "enter_dungeon": 97.22222222222223, "defeat_orc_solider": 96.03174603174604, "defeat_orc_mage": 94.44444444444444, "eat_snail": 94.84126984126983, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 96.82539682539682, "drink_potion": 78.96825396825396}, "average_episode_length": 1184.111111111111, "mean_return_percentage": 23.896401382962846, "mean_return": 54.00586712549603, "lp": NaN, "priority_score": 0.2090419501133787}]</data>
