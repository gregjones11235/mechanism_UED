      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Teach the agent to survive and fight gnome warriors and archers in the dark Gnomish Mines in order to unlock the Sewers.

Description: The agent starts on **Floor 2 (Gnomish Mines)** directly, placed at the ladder‑up location. Its inventory simulates a competent early‑game arrival: a **stone sword (tier 2)**, a **stone pickaxe (tier 2)**, a **bow**, **20 arrows**, and **10 torches**. All survival bars (health, food, drink, energy) are full, and mana is full. The world generation uses the standard procedural Gnomish Mines (pitch‑black, stalagmites, stone/coal/iron/ diamond/sapphire/ruby ores). The level spawns gnome warriors, gnome archers, and passive bats as usual. **No extra illumination is placed** – the agent must use torches to see. The ladder down to Floor 3 is **locked**; to open it the agent must personally defeat at least **4 hostile mobs** (melee or ranged) on Floor 2 (the `monsters_killed_to_clear_level` parameter is set to 4). Once the kill requirement is met, the agent must locate the **Ladder Down** and descend to Floor 3 (the Sewers). Success is defined by the **ENTER_SEWERS** achievement. Survival needs are eased (`needs_depletion_multiplier = 0.5`, `health_recover_multiplier = 1.5`) to keep pressure on combat rather than survival. All other game mechanics (mob health, damage, spawn rates, etc.) are left at default Craftax values.

Relevant Achievements: ENTER_SEWERS, DEFEAT_GNOME_WARRIOR, DEFEAT_GNOME_ARCHER

Completed Achievements: ENTER_DUNGEON, ENTER_GNOMISH_MINES, COLLECT_WOOD, PLACE_TABLE, MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD, COLLECT_STONE, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, COLLECT_COAL, MAKE_TORCH

World:
- Player:
  - `builder.set_starting_floor(2)`
  - `builder.set_player_inventory({"sword": 2, "pickaxe": 2, "bow": 1, "arrows": 20, "torch": 10})`
  - All survival bars are full (health 9, food 9, drink 9, energy 9, mana 9; attributes all 1)
- Map:
  - No block modifications; standard Gnomish Mines generation is used.
- Mechanics:
  - `monsters_killed_to_clear_level = 4`          # for Floor 2 (reduced to focus on combat)
  - `needs_depletion_multiplier = 0.5`
  - `health_recover_multiplier = 1.5`
  - `health_loss_multiplier = 1.0`
  - `mob_health_multiplier = 1.0`
  - `mob_damage_multiplier = 1.0`
  - `melee_spawn_multiplier = 1.0`
  - `ranged_spawn_multiplier = 1.0`
  - `passive_spawn_multiplier = 1.0`
  - `mana_recover_multiplier = 1.0`
  - `growing_plants_age = 600` (unused)
  - All other parameters at default.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_SEWERS,
            Achievement.DEFEAT_GNOME_WARRIOR,
            Achievement.DEFEAT_GNOME_ARCHER,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
            Achievement.COLLECT_WOOD,
            Achievement.PLACE_TABLE,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.COLLECT_STONE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.COLLECT_COAL,
            Achievement.MAKE_TORCH,
        ]
        self.label = "ENTER_SEWERS, DEFEAT_GNOME_WARRIOR, DEFEAT_GNOME_ARCHER"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=4,
            needs_depletion_multiplier=0.5,
            health_recover_multiplier=1.5,
            # All other multipliers remain at default (1.0)
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on Floor 2 (Gnomish Mines)
        builder.set_starting_floor(2)

        # Equip starting inventory: stone sword, stone pickaxe, bow, arrows, torches
        builder.set_player_inventory({
            "sword": 2,
            "pickaxe": 2,
            "bow": 1,
            "arrows": 20,
            "torches": 10,
        })

        # No block or mob modifications; standard Gnomish Mines generation
        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
