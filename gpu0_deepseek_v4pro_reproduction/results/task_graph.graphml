      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Introduce the agent to the Gnomish Mines (floor 2) combat, requiring it to clear the level and descend to the Sewers (floor 3).

Description:
The agent starts on floor 2 (Gnomish Mines) with a stone sword, a wood pickaxe, torches, and basic resources. Survival needs deplete at half the normal rate (`needs_depletion_multiplier = 0.5`) so that hunger, thirst, and fatigue do not distract from the new combat challenge. The floor 2 ladder down remains locked until the agent defeats **eight** hostile monsters – the same intensified requirement as the parent task, but now against gnome warriors and archers. Two gnomes are pre‑placed near the spawn point to guarantee early confrontation: one Gnome Warrior (`mob_name="melee"`, `type_id=1`) and one Gnome Archer (`mob_name="ranged"`, `type_id=1`), each within Manhattan distance 2–4 from the up‑ladder position on distinct, non‑colliding tiles. The agent may use natural spawns of bats and snails for food, mine coal/iron, craft iron‑tier equipment, and place torches to navigate the pitch‑black mines. The episode is successful only when the agent uses the floor 2 down‑ladder to enter floor 3, earning `ENTER_SEWERS`.

Relevant Achievements: ENTER_SEWERS

Completed Achievements: COLLECT_WOOD, PLACE_TABLE, MAKE_WOOD_PICKAXE, COLLECT_STONE, MAKE_STONE_SWORD, ENTER_DUNGEON, ENTER_GNOMISH_MINES

World:
- Player: Start on floor 2. Inventory: stone sword (tier 2), wood pickaxe (tier 1), Torches=10, Wood=20, Stone=20, Food=9, Drink=9. All attributes at 1. Health, Food, Drink, Energy, Mana full (9/9).
- Map:
  - Floor 2: pre‑place one Gnome Warrior (`mob_name="melee"`, `type_id=1`) and one Gnome Archer (`mob_name="ranged"`, `type_id=1`), each randomly placed within Manhattan distance 2–4 from the up‑ladder position (the agent’s spawn point), with distinct, non‑colliding tiles.
- Mechanics:
  - `monsters_killed_to_clear_level` for floor 2 set to 8 (default for other floors unchanged)
  - `needs_depletion_multiplier = 0.5`
  - `passive_spawn_multiplier = 1.0`
  - `melee_spawn_multiplier = 1.0`
  - `ranged_spawn_multiplier = 1.0`
  - All other `TaskParams` at original Craftax defaults (mob health/damage multipliers, recovery rates, etc. are 1.0).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_SEWERS,
        ]
        self.completed_achievements = [
            Achievement.COLLECT_WOOD,
            Achievement.PLACE_TABLE,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.COLLECT_STONE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.label = "ENTER_SEWERS"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.5,
            monsters_killed_to_clear_level=8,
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, mob_rng = jax.random.split(rng, 3)
        mob_rng1, mob_rng2 = jax.random.split(mob_rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines) at the up-ladder position
        builder.set_starting_floor(2)

        # Equip starting inventory: stone sword (tier 2), wood pickaxe (tier 1), torches, wood, stone
        builder.set_player_inventory({
            "sword": 2,
            "pickaxe": 1,
            "torches": 10,
            "wood": 20,
            "stone": 20,
        })

        # Reset Gnomish Mines kill counter to zero (it is zero by default, but explicit is safer)
        builder.set_monsters_killed(level=2, count=0)

        # Handplace two initial gnome enemies near spawn
        spawn_pos = builder.player_position

        # Gnome Warrior (melee, type_id=1) – Manhattan distance 2–4
        builder.add_mobs_randomly_near(
            mob_rng1,
            level=2,
            mob_name="melee",
            type_id=1,
            n=1,
            target_pos=spawn_pos,
            min_dist=2,
            max_dist=4,
            on_blocks=[BlockType.PATH],
        )

        # Gnome Archer (ranged, type_id=1) – Manhattan distance 2–4
        builder.add_mobs_randomly_near(
            mob_rng2,
            level=2,
            mob_name="ranged",
            type_id=1,
            n=1,
            target_pos=spawn_pos,
            min_dist=2,
            max_dist=4,
            on_blocks=[BlockType.PATH],
        )

        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
