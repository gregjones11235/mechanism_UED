666666668, "make_iron_pickaxe": 24.305555555555557, "make_iron_sword": 49.65277777777778, "make_arrow": 92.01388888888889, "make_torch": 95.48611111111111, "place_torch": 94.79166666666667, "collect_sapphire": 26.38888888888889, "collect_ruby": 21.180555555555557, "make_diamond_pickaxe": 2.7777777777777777, "make_diamond_sword": 3.4722222222222223, "enter_gnomish_mines": 38.541666666666664, "enter_dungeon": 100.0, "defeat_orc_solider": 94.44444444444444, "defeat_orc_mage": 88.54166666666667, "eat_snail": 96.875, "find_bow": 99.65277777777777, "fire_bow": 91.31944444444444, "open_chest": 99.65277777777777, "drink_potion": 76.04166666666667}, "average_episode_length": 968.4722222222222, "mean_return_percentage": 19.134011357700345, "mean_return": 43.24286566840278, "lp": NaN, "priority_score": 0.2368706597222222}]</data>
