63779527, "place_stone": 98.03149606299213, "eat_plant": 15.354330708661417, "defeat_skeleton": 62.59842519685039, "make_stone_pickaxe": 91.33858267716535, "make_stone_sword": 96.06299212598425, "wake_up": 98.81889763779527, "place_furnace": 98.81889763779527, "collect_coal": 93.30708661417323, "collect_iron": 76.77165354330708, "collect_diamond": 29.52755905511811, "make_iron_pickaxe": 23.228346456692915, "make_iron_sword": 48.818897637795274, "make_arrow": 96.85039370078741, "make_torch": 96.06299212598425, "place_torch": 95.66929133858268, "collect_sapphire": 31.496062992125985, "collect_ruby": 25.984251968503937, "make_diamond_pickaxe": 3.937007874015748, "make_diamond_sword": 4.330708661417323, "make_iron_armour": 5.511811023622047, "enter_gnomish_mines": 64.1732283464567, "enter_dungeon": 98.03149606299213, "defeat_orc_solider": 94.09448818897638, "defeat_orc_mage": 89.37007874015748, "eat_snail": 96.45669291338582, "find_bow": 98.03149606299213, "fire_bow": 95.2755905511811, "open_chest": 98.03149606299213, "drink_potion": 84.25196850393701}, "average_episode_length": 1148.763779527559, "mean_return_percentage": 26.37006594705944, "mean_return": 59.59634904035433, "lp": NaN, "priority_score": 0.2341279682559365}]</data>
