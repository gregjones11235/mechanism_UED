      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Enter the Gnomish Mines while managing normal‑rate hunger, thirst, and fatigue, forcing the agent to integrate basic farming and drinking into the dungeon‑clearance routine.

Description: The agent begins on floor 0 (Overworld) with a stone pickaxe, 10 wood, 10 stone, and 10 torches. It must place a crafting table, craft a stone sword and arrows, locate the Dungeon entrance, and descend. On floor 1 it must defeat any mix of Orc Soldiers and Orc Mages until the kill counter reaches 6, then stand on the ladder down to floor 2. Survival needs now deplete at the default speed (needs_depletion_multiplier = 1.0), requiring the agent to secure food and water actively—planting saplings, harvesting ripe plants, drinking from water or fountains—while engaged in combat. Mobs still deal only 75% of normal damage (`mob_damage_multiplier = 0.75`), and the floor‑0 ladder is pre‑unlocked. All other world generation and parameters remain default. The episode succeeds only when the ENTER_GNOMISH_MINES achievement is earned.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: MAKE_STONE_PICKAXE, MAKE_TORCH
World:
- Player: Starts on floor 0. Inventory: stone_pickaxe=1, wood=10, stone=10, torches=10. Armour slots empty. Attributes: strength=1, dexterity=1, intelligence=1. Status bars all 9/9. Enchantments all 0. Learned spells both false.
- Map: All nine levels use default procedural generation. No manual block modifications.
- Mechanics:
  - monsters_killed_to_clear_level = 6
  - needs_depletion_multiplier = 1.0
  - mob_damage_multiplier = 0.75
  - health_recover_multiplier = 1.0
  - health_loss_multiplier = 1.0
  - mana_recover_multiplier = 1.0
  - melee_spawn_multiplier = 1.0
  - ranged_spawn_multiplier = 1.0
  - passive_spawn_multiplier = 1.0
  - All other TaskParams at default.
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_GNOMISH_MINES]
        self.completed_achievements = [
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_TORCH,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        return TaskParams(
            monsters_killed_to_clear_level=6,
            needs_depletion_multiplier=1.0,
            mob_damage_multiplier=0.75,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        builder = WorldBuilder(rng, self.static_params, self.params)
        builder.set_starting_floor(0)
        builder.set_player_inventory(
            {"pickaxe": 2, "wood": 10, "stone": 10, "torches": 10}
        )
        # Pre-unlock floor 0 ladder by setting the kill count to the required threshold
        builder.set_monsters_killed(0, 6)
        return builder.build(rng)</data>
