t_iron": 55.61797752808989, "collect_diamond": 25.84269662921348, "make_iron_pickaxe": 10.674157303370787, "make_iron_sword": 13.48314606741573, "make_arrow": 72.47191011235955, "make_torch": 89.32584269662921, "place_torch": 84.8314606741573, "collect_sapphire": 20.224719101123597, "collect_ruby": 23.59550561797753, "make_diamond_pickaxe": 3.3707865168539324, "make_diamond_sword": 1.6853932584269662, "make_iron_armour": 3.3707865168539324, "enter_gnomish_mines": 31.46067415730337, "enter_dungeon": 83.70786516853933, "defeat_orc_solider": 79.7752808988764, "defeat_orc_mage": 70.2247191011236, "eat_snail": 66.29213483146067, "find_bow": 82.02247191011236, "fire_bow": 62.359550561797754, "open_chest": 82.02247191011236, "drink_potion": 70.2247191011236}, "average_episode_length": 1503.2191011235955, "mean_return_percentage": 18.080750755847916, "mean_return": 40.86249670821629, "lp": NaN, "priority_score": 0.2156293397298321}]</data>
