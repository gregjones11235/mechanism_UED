  - Place a Torch at the player’s exact spawn coordinates (the up-ladder tile) and on two adjacent walkable tiles within Manhattan distance 1 to light the immediate area.  
  - Spawn one Orc Soldier (mob_name="melee", type_id=2) using add_mobs_randomly_near with target_pos = player spawn, n=1, min_dist=3, max_dist=8, on_blocks=[BlockType.PATH].  
- Mechanics:  
  - passive_spawn_multiplier = 0.0  
  - melee_spawn_multiplier = 0.0  
  - ranged_spawn_multiplier = 0.0  
  - health_recover_multiplier = 2.0  
  - needs_depletion_multiplier = 0.5  
  - All other TaskParams at default (e.g., mob_health_multiplier=1.0, mob_damage_multiplier=1.0, melee_trigger_distance=10, monsters_killed_to_clear_level=8).</data>
      <data key="d3">import jax
import jax.numpy as jnp
from craftax.craftax.constants import Achievement, BlockType, ItemType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams
from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to defeat an Orc Soldier in the dungeon environment with basic stone weapons and light survival pressure.

    Description: The agent starts on Floor 1 (Dungeon) at the up-ladder position with an inventory containing a stone sword, stone pickaxe, and 10 torches, reflecting a smooth descent from the overworld with stone tools. A torch is placed at the player’s spawn tile and on two adjacent walkable tiles to provide immediate illumination. One Orc Soldier (melee mob, type_id=2) is spawned nearby on a path block (Manhattan distance between 3 and 8 from the player) using add_mobs_randomly_near. All spawning multipliers (passive, melee, ranged) are set to 0, so no additional mobs appear, and any existing mobs outside despawn range are removed. Survival needs deplete at half the normal rate (needs_depletion_multiplier=0.5), and health regeneration is doubled (health_recover_multiplier=2.0). The task terminates successfully as soon as the agent defeats the Orc Soldier (DEFEAT_ORC_SOLIDER). All other achievements remain possible as incidental rewards, but the only required condition for termination is defeating that specific mob.  

    Relevant Achievements: DEFEAT_ORC_SOLIDER  

    Completed Achievements:  
    COLLECT_WOOD, PLACE_TABLE, MAKE_WOOD_PICKAXE, COLLECT_STONE, MAKE_WOOD_SWORD, MAKE_STONE_SWORD, COLLECT_COAL, MAKE_TORCH, MAKE_STONE_PICKAXE, ENTER_DUNGEON  

    World:  
    - Player:  
      - Starting floor: 1  
      - Inventory: {"sword": 2, "pickaxe": 2, "torches": 10}  
      - Stats: default (full health/food/drink/energy/mana, attributes all 1)  
    - Map:  
      - Use standard dungeon generation for Floor 1 (rooms, corridors, chests, fountains, torches in corners).  
      - Place a Torch at the player’s exact spawn coordinates (the up-ladder tile) and on two adjacent walkable tiles within Manhattan distance 1 to light the immediate area.  
      - Spawn one Orc Soldier (mob_name="melee", type_id=2) using add_mobs_randomly_near with target_pos = player spawn, n=1, min_dist=3, max_dist=8, on_blocks=[BlockType.PATH].  
    - Mechanics:  
      - passive_spawn_multiplier = 0.0  
      - melee_spawn_multiplier = 0.0  
      - ranged_spawn_multiplier = 0.0  
      - health_recover_multiplier = 2.0  
      - needs_depletion_multiplier = 0.5  
      - All other TaskParams at default (e.g., mob_health_multiplier=1.0, mob_damage_multiplier=1.0, melee_trigger_distance=10, monsters_killed_to_clear_level=8).
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.DEFEAT_ORC_SOLIDER]
        self.completed_achievements = [
            Achievement.COLLECT_WOOD,
            Achievement.PLACE_TABLE,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.COLLECT_STONE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_SWORD,
            Achievement.COLLECT_COAL,
            Achievement.MAKE_TORCH,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.ENTER_DUNGEON,
        ]
        self.label = "DEFEAT_ORC_SOLIDER"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=0.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            health_recover_multiplier=2.0,
            needs_depletion_multiplier=0.5,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, orc_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)
        builder.set_starting_floor(1)
        builder.set_player_inventory({"sword": 2, "pickaxe": 2, "torches": 10})

        # Place one Orc Soldier near the player spawn on a path block
        builder.add_mobs_randomly_near(
            orc_rng,
            level=1,
            mob_name="melee",
            type_id=2,  # Orc Soldier
            n=1,
            target_pos=builder.player_position,
            min_dist=3,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        state = builder.build(rng)

        # --- Place torches at spawn and two adjacent walkable tiles ---
        player_level = 1
        player_pos = state.player_position
        torch_item = ItemType.TORCH.value

        item_map = state.item_map
        # Torch at player position
        item_map = item_map.at[player_level, player_pos[0], player_pos[1]].set(torch_item)

        # Torches on two adjacent tiles (1,0) and (0,1) – assumed walkable in dungeon rooms
        offset1 = jnp.array([1, 0], dtype=jnp.int32)
        offset2 = jnp.array([0, 1], dtype=jnp.int32)

        for offset in [offset1, offset2]:
            tile_pos = player_pos + offset
            # Only set torch if inside map and on a path block (walkable)
            row, col = tile_pos[0], tile_pos[1]
            in_bounds = (row &gt;= 0) &amp; (row &lt; self.static_params.map_size[0]) &amp; (col &gt;= 0) &amp; (col &lt; self.static_params.map_size[1])
            is_path = state.map[player_level, row, col] == BlockType.PATH.value
            valid = in_bounds &amp; is_path
            # Use cond to avoid JAX tracing issues with non-pure conditionals
            item_map = jax.lax.cond(
                valid,
                lambda m: m.at[player_level, row, col].set(torch_item),
                lambda m: m,
                item_map,
            )

        state = state.replace(item_map=item_map)
        # --- End torch placement ---

        return state</data>
