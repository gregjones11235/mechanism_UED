      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to independently gather resources, craft a weapon and light source, and then descend into the dungeon to fight orcs and reach the Gnomish Mines.

Description: The agent begins on Floor 0 (Overworld) at the default spawn position. Inventory is completely empty; all attributes are at their base values (strength 1, dexterity 1, intelligence 1). The Overworld contains standard terrain (trees, stone, coal, etc.) but **no hostile mobs** – the `melee_spawn_multiplier` and `ranged_spawn_multiplier` for Floor 0 are set to 0, allowing the agent to gather resources in complete safety. The ladder down to Floor 1 is permanently unlocked (monsters_killed[0] default), so the agent may descend at any time.

On Floor 1 (Dungeon), the environment is fully dark (ambient light 0), with normal spawn rates for Orc Soldiers, Orc Mages, and passive Snails. To advance to Floor 2 (Gnomish Mines), the agent must **kill exactly 5 hostile monsters** (melee or ranged) on Floor 1 and then step onto the ladder down and execute `DESCEND`. The task succeeds only when `ENTER_GNOMISH_MINES` is triggered.

The agent must figure out that it needs to craft at least a stone sword (or better) and torches before entering the Dungeon. Typical required chain on Floor 0: punch trees to obtain wood → craft a Crafting Table (2 wood) → craft a Wood Pickaxe (1 wood) → mine Stone and Coal → craft a Stone Sword (1 wood + 1 stone, at table) and Torches (1 wood + 1 coal, at table). Survival needs are intentionally slowed (`needs_depletion_multiplier = 0.2`) to keep the focus on preparation and combat.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: (none)

World:
- Player: Starting floor 0 via default. Inventory empty. Attributes default (strength=1, dexterity=1, intelligence=1).
- Map: No modifications to the default world generation. Floor 0 generates normally; Floor 1 is generated by the standard dungeon algorithm.
- Mechanics:
  - `monsters_killed_to_clear_level` = 5 (for Floor 1 only; Floor 0 is already unlocked)
  - `melee_spawn_multiplier` = 0.0 (Floor 0), 1.0 (Floor 1)
  - `ranged_spawn_multiplier` = 0.0 (Floor 0), 1.0 (Floor 1)
  - `passive_spawn_multiplier` = 1.0 (all floors)
  - `mob_health_multiplier` = 1.0
  - `mob_damage_multiplier` = 1.0
  - `needs_depletion_multiplier` = 0.2
  - `health_recover_multiplier` = 1.0
  - `health_loss_multiplier` = 1.0
  - `mana_recover_multiplier` = 1.0
  - `growing_plants_age` = 600
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = []  # No pre-completed achievements
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=5,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            passive_spawn_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            needs_depletion_multiplier=0.2,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            growing_plants_age=600,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, mob_rng = jax.random.split(rng, 3)
        mob_rng1, mob_rng2 = jax.random.split(mob_rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld) at default centre
        builder.set_starting_floor(0)

        # Floor 0 has default kill count (10) so ladder is permanently unlocked.

        # Pre-place the 5 hostile mobs required for floor 1 clearing.
        floor1_spawn = builder.ladders_up[1]

        # 3 Orc Soldiers (melee, type_id=2)
        builder.add_mobs_randomly_near(
            mob_rng1,
            level=1,
            mob_name="melee",
            type_id=2,   # Orc Soldier
            n=3,
            target_pos=floor1_spawn,
            min_dist=5,
            max_dist=10,
            on_blocks=[BlockType.PATH],
        )

        # 2 Orc Mages (ranged, type_id=2)
        builder.add_mobs_randomly_near(
            mob_rng2,
            level=1,
            mob_name="ranged",
            type_id=2,   # Orc Mage
            n=2,
            target_pos=floor1_spawn,
            min_dist=5,
            max_dist=10,
            on_blocks=[BlockType.PATH],
        )

        state = builder.build(rng)

        # No pre-completed achievements; return state as-is.
        return state</data>
