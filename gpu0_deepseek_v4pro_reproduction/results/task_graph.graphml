  - mana_recover_multiplier = 1.0</data>
      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Clear the first dungeon floor under resource‑constrained conditions that mirror a typical global run, entering the Gnomish Mines with only what a competent overworld run would provide.

Description: The agent starts on floor 1 (Dungeon) with the gear it would realistically carry after a standard overworld progression – a stone sword, stone pickaxe, a bow, and a small stock of ammunition and materials (5 arrows, 5 wood, 5 stone). No crafting stations or fountains are placed near spawn; the agent must explore the procedurally generated dungeon to find chests, potions, and safe spots to craft additional arrows. The kill requirement to unlock the descending ladder is raised from 8 to 12, forcing the agent to seek out and eliminate many Orc Soldiers and Orc Mages. By reducing initial resources and increasing combat demand, the task teaches resource management, efficient bow usage, and thorough dungeon navigation – exactly the skills needed to bridge the gap between the high local success on the scaffolded parent task and the poor global transition rate. Success is defined as reaching floor 2 (Gnomish Mines).

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: ENTER_DUNGEON, MAKE_STONE_SWORD, MAKE_STONE_PICKAXE, FIND_BOW

World:
- Player: Starting floor 1 (Dungeon) at the ladder‑up position. Inventory: {"stone_sword": 1, "stone_pickaxe": 1, "bow": 1, "arrows": 5, "wood": 5, "stone": 5}. All stats at maximum (health 9, food 9, drink 9, energy 9, mana 9). No enchantments, no spells learned.
- Map: No manual block modifications; rely on the standard dungeon generation (rooms, corridors, chests, torches, fountains, etc.).
- Mechanics:
  - monsters_killed_to_clear_level = 12
  - mob_health_multiplier = 1.0
  - mob_damage_multiplier = 1.0
  - melee_spawn_multiplier = 1.0
  - ranged_spawn_multiplier = 1.0
  - passive_spawn_multiplier = 0.0 (no snails or other passives)
  - needs_depletion_multiplier = 0.1
  - health_recover_multiplier = 1.0
  - mana_recover_multiplier = 1.0
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.FIND_BOW,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=0.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            monsters_killed_to_clear_level=12,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            needs_depletion_multiplier=0.1,
            health_recover_multiplier=1.0,
            mana_recover_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Set starting inventory: stone sword (2), stone pickaxe (2), bow (1), arrows=5, wood=5, stone=5
        builder.set_player_inventory({
            "sword": 2,
            "pickaxe": 2,
            "bow": 1,
            "arrows": 5,
            "wood": 5,
            "stone": 5,
        })

        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
