66667, "collect_drink": 97.82608695652173, "make_wood_pickaxe": 100.0, "make_wood_sword": 100.0, "place_plant": 91.66666666666667, "defeat_zombie": 55.072463768115945, "collect_stone": 93.1159420289855, "place_stone": 93.1159420289855, "eat_plant": 22.463768115942027, "defeat_skeleton": 54.34782608695652, "make_stone_pickaxe": 100.0, "make_stone_sword": 100.0, "wake_up": 98.91304347826087, "place_furnace": 92.7536231884058, "collect_coal": 85.8695652173913, "collect_iron": 86.23188405797102, "collect_diamond": 28.26086956521739, "make_iron_pickaxe": 28.985507246376812, "make_iron_sword": 55.072463768115945, "make_arrow": 93.84057971014492, "make_torch": 100.0, "place_torch": 100.0, "collect_sapphire": 26.08695652173913, "collect_ruby": 25.72463768115942, "make_diamond_pickaxe": 3.9855072463768115, "make_diamond_sword": 2.536231884057971, "make_iron_armour": 8.333333333333334, "enter_gnomish_mines": 62.68115942028985, "enter_dungeon": 100.0, "defeat_orc_solider": 94.92753623188406, "defeat_orc_mage": 90.21739130434783, "eat_snail": 97.82608695652173, "find_bow": 98.91304347826087, "fire_bow": 92.02898550724638, "open_chest": 98.91304347826087, "drink_potion": 82.6086956521739}, "average_episode_length": 1002.3152173913044, "mean_return_percentage": 22.57940848393212, "mean_return": 51.029463173686594, "lp": NaN, "priority_score": 0.2339188195757194}]</data>
