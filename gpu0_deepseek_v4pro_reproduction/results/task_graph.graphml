nace": 98.21428571428571, "collect_coal": 95.23809523809524, "collect_iron": 89.88095238095238, "collect_diamond": 25.595238095238095, "make_iron_pickaxe": 67.26190476190476, "make_iron_sword": 77.38095238095238, "make_arrow": 98.21428571428571, "make_torch": 95.23809523809524, "place_torch": 95.23809523809524, "collect_sapphire": 27.976190476190474, "collect_ruby": 27.976190476190474, "make_diamond_pickaxe": 3.5714285714285716, "make_diamond_sword": 2.9761904761904763, "make_iron_armour": 29.166666666666668, "enter_gnomish_mines": 56.54761904761905, "enter_dungeon": 98.80952380952381, "defeat_orc_solider": 97.02380952380952, "defeat_orc_mage": 88.69047619047619, "eat_snail": 97.02380952380952, "find_bow": 97.61904761904762, "fire_bow": 97.02380952380952, "open_chest": 97.61904761904762, "drink_potion": 82.73809523809524}, "average_episode_length": 1546.0714285714287, "mean_return_percentage": 24.439489957003264, "mean_return": 55.23324730282738, "lp": NaN, "priority_score": 0.24985827664399093}, {"session": 134, "sr": 0.4514285714285714, "achievement_srs": {"eat_cow": 95.42857142857143, "collect_sapling": 100.0, "collect_drink": 97.71428571428571, "place_plant": 100.0, "defeat_zombie": 84.0, "collect_stone": 100.0, "place_stone": 99.42857142857143, "eat_plant": 38.857142857142854, "defeat_skeleton": 70.28571428571429, "make_stone_pickaxe": 97.14285714285714, "make_stone_sword": 97.71428571428571, "wake_up": 99.42857142857143, "place_furnace": 100.0, "collect_coal": 96.57142857142857, "collect_iron": 89.14285714285714, "collect_diamond": 34.857142857142854, "make_iron_pickaxe": 66.85714285714286, "make_iron_sword": 78.28571428571429, "make_arrow": 96.0, "make_torch": 98.28571428571429, "place_torch": 97.14285714285714, "collect_sapphire": 27.428571428571427, "collect_ruby": 29.142857142857142, "make_diamond_pickaxe": 8.571428571428571, "make_diamond_sword": 8.0, "make_iron_armour": 17.142857142857142, "enter_gnomish_mines": 50.285714285714285, "enter_dungeon": 98.28571428571429, "defeat_orc_solider": 95.42857142857143, "defeat_orc_mage": 91.42857142857143, "eat_snail": 95.42857142857143, "find_bow": 97.71428571428571, "fire_bow": 94.85714285714286, "open_chest": 97.71428571428571, "drink_potion": 82.85714285714286}, "average_episode_length": 1621.3828571428571, "mean_return_percentage": 23.775842485777495, "mean_return": 53.73340401785714, "lp": NaN, "priority_score": 0.24764081632653062}]</data>
