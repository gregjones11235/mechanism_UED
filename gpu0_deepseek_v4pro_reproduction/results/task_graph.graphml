9282576866764276, "defeat_skeleton": 0.6832601268911664, "make_stone_pickaxe": 12.005856515373353, "wake_up": 6.490971205466081, "place_furnace": 1.3177159590043923, "collect_coal": 33.87018057589068, "collect_iron": 32.796486090775986, "collect_diamond": 16.15422157149829, "make_iron_pickaxe": 5.075646656905808, "make_iron_sword": 7.36944851146901, "make_arrow": 41.142020497803806, "make_torch": 78.5261102977062, "place_torch": 76.86676427525622, "collect_sapphire": 15.031722791605661, "collect_ruby": 14.641288433382138, "make_diamond_pickaxe": 1.5129331381161542, "make_diamond_sword": 2.342606149341142, "enter_gnomish_mines": 0.04880429477794046, "enter_dungeon": 100.0, "defeat_orc_solider": 88.23816495851635, "defeat_orc_mage": 34.504636408003904, "eat_snail": 74.1825280624695, "find_bow": 99.02391410444119, "fire_bow": 40.26354319180088, "open_chest": 99.02391410444119, "drink_potion": 53.00146412884334}, "average_episode_length": 137.18350414836505, "mean_return_percentage": 16.304047449759647, "mean_return": 36.847147236456806, "lp": NaN, "priority_score": 0.10378427406052922}]</data>
