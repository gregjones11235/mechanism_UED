      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Descend into the Gnomish Mines after defeating four hostile monsters on Floor 1 (Dungeon).

Description: The agent begins on Floor 1 (Dungeon) at the up‑ladder position, equipped with an iron sword (sword = 3), just as in the previous task. The dungeon is generated with the default procedural algorithm, and the ladder down to Floor 2 (Gnomish Mines) appears in its normal random location. This time, the agent must defeat **four** hostile monsters (melee or ranged) on this level to unlock the descent gate. Once the kill count reaches 4, the agent must navigate to the ladder down and execute the DESCEND action. All other game mechanics remain at the same relaxed difficulty: mob health and damage are unchanged (1.0× multiplier), spawn rates are normal, survival needs deplete at only 20% of the standard rate, and no Overworld progression or crafting is required. The iron sword is granted from the start, and the achievements for entering the dungeon and making an iron sword are considered already completed.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: MAKE_IRON_SWORD, ENTER_DUNGEON

World:
- Player: Set starting floor to 1 (Dungeon) via `set_starting_floor(1)`. Inventory: `{"sword": 3}`. All other attributes default.
- Map:
  - No manual placement of the ladder—leave the default dungeon generation intact.
  - Use `set_monsters_killed(level=1, count=0)` to reset the kill counter for Floor 1.
- Mechanics:
  - monsters_killed_to_clear_level = 4
  - mob_health_multiplier = 1.0
  - mob_damage_multiplier = 1.0
  - melee_spawn_multiplier = 1.0
  - ranged_spawn_multiplier = 1.0
  - passive_spawn_multiplier = 1.0
  - needs_depletion_multiplier = 0.2
  - health_recover_multiplier = 1.0
  - health_loss_multiplier = 1.0
  - mana_recover_multiplier = 1.0
  - growing_plants_age = 600
  - All other parameters left at default.
    """
    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_GNOMISH_MINES]
        self.completed_achievements = [Achievement.MAKE_IRON_SWORD, Achievement.ENTER_DUNGEON]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        return TaskParams(
            monsters_killed_to_clear_level=4,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            needs_depletion_multiplier=0.2,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            growing_plants_age=600,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(1)
        builder.set_player_inventory({"sword": 3})  # iron sword
        builder.set_monsters_killed(level=1, count=0)

        return builder.build(rng)</data>
