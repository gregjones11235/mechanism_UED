up": 34.120734908136484, "place_furnace": 99.73753280839895, "collect_iron": 60.10498687664042, "collect_diamond": 39.10761154855643, "make_iron_pickaxe": 39.37007874015748, "make_iron_sword": 53.28083989501312, "make_arrow": 100.0, "make_torch": 100.0, "place_torch": 99.21259842519684, "collect_sapphire": 30.708661417322833, "collect_ruby": 31.233595800524935, "make_diamond_pickaxe": 3.937007874015748, "make_diamond_sword": 7.086614173228346, "make_iron_armour": 4.724409448818897, "enter_gnomish_mines": 85.03937007874016, "enter_dungeon": 100.0, "defeat_orc_solider": 100.0, "defeat_orc_mage": 90.0262467191601, "eat_bat": 0.26246719160104987, "eat_snail": 98.4251968503937, "find_bow": 99.21259842519684, "fire_bow": 99.21259842519684, "open_chest": 99.21259842519684, "drink_potion": 83.98950131233596}, "average_episode_length": 757.0314960629921, "mean_return_percentage": 21.74724140884491, "mean_return": 49.1487655839895, "lp": NaN, "priority_score": 0.15650209078195937}]</data>
