eleton": 21.447721179624665, "make_stone_pickaxe": 40.21447721179624, "wake_up": 92.76139410187668, "place_furnace": 45.84450402144772, "collect_coal": 66.48793565683646, "collect_iron": 60.58981233243968, "collect_diamond": 31.635388739946382, "make_iron_pickaxe": 17.158176943699733, "make_iron_sword": 20.37533512064343, "place_torch": 100.0, "collect_sapphire": 23.056300268096514, "collect_ruby": 28.15013404825737, "make_diamond_pickaxe": 5.361930294906166, "make_diamond_sword": 2.9490616621983916, "make_iron_armour": 2.680965147453083, "enter_gnomish_mines": 61.93029490616622, "enter_dungeon": 100.0, "defeat_orc_solider": 98.12332439678285, "defeat_orc_mage": 95.71045576407506, "eat_snail": 97.31903485254692, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 100.0, "drink_potion": 85.52278820375335}, "average_episode_length": 740.7908847184987, "mean_return_percentage": 19.086086802919404, "mean_return": 43.134556174597854, "lp": NaN, "priority_score": 0.23576680634519045}]</data>
