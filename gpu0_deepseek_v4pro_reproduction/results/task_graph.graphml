, "make_stone_sword": 58.648648648648646, "wake_up": 90.27027027027027, "place_furnace": 62.7027027027027, "collect_coal": 79.72972972972973, "collect_iron": 74.5945945945946, "collect_diamond": 35.945945945945944, "make_iron_pickaxe": 23.783783783783782, "make_iron_sword": 29.72972972972973, "make_torch": 96.75675675675676, "place_torch": 96.48648648648648, "collect_sapphire": 31.08108108108108, "collect_ruby": 30.54054054054054, "make_diamond_pickaxe": 5.135135135135135, "make_diamond_sword": 3.7837837837837838, "make_iron_armour": 2.4324324324324325, "enter_gnomish_mines": 73.78378378378379, "enter_dungeon": 100.0, "defeat_orc_solider": 99.45945945945945, "defeat_orc_mage": 97.29729729729729, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 100.0, "drink_potion": 88.64864864864865}, "average_episode_length": 763.3351351351351, "mean_return_percentage": 20.49914933254604, "mean_return": 46.328077491554055, "lp": NaN, "priority_score": 0.19343316289262236}]</data>
