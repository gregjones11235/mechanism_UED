941747572816, "enter_dungeon": 49.70873786407767, "eat_snail": 19.41747572815534, "find_bow": 49.12621359223301, "fire_bow": 48.932038834951456, "open_chest": 49.12621359223301, "drink_potion": 21.553398058252426}, "average_episode_length": 551.473786407767, "mean_return_percentage": 18.056195093006274, "mean_return": 40.807000910194176, "lp": NaN, "priority_score": 0.12026015647092092}, {"session": 42, "sr": 0.9269588313413014, "achievement_srs": {"eat_cow": 83.39973439575033, "collect_sapling": 82.73572377158034, "collect_drink": 84.4621513944223, "make_wood_pickaxe": 100.0, "make_wood_sword": 100.0, "place_plant": 77.82204515272244, "defeat_zombie": 94.55511288180611, "place_stone": 96.14873837981408, "eat_plant": 3.452855245683931, "defeat_skeleton": 40.50464807436919, "wake_up": 27.755644090305445, "place_furnace": 100.0, "collect_coal": 98.80478087649402, "collect_iron": 98.93758300132802, "collect_diamond": 6.905710491367862, "make_iron_pickaxe": 5.843293492695883, "make_iron_sword": 31.47410358565737, "make_arrow": 99.33598937583001, "make_torch": 90.83665338645419, "place_torch": 84.19654714475432, "collect_sapphire": 4.913678618857902, "collect_ruby": 5.046480743691899, "make_diamond_pickaxe": 0.5312084993359893, "make_diamond_sword": 0.9296148738379814, "make_iron_armour": 92.69588313413014, "enter_dungeon": 49.26958831341302, "eat_snail": 20.98273572377158, "find_bow": 48.60557768924303, "fire_bow": 48.07436918990704, "open_chest": 48.60557768924303, "drink_potion": 16.334661354581673}, "average_episode_length": 368.12881806108896, "mean_return_percentage": 18.39944678329455, "mean_return": 41.58274973024568, "lp": NaN, "priority_score": 0.06770615633967013}]</data>
