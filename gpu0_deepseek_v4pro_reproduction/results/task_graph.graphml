, "collect_coal": 80.4733727810651, "collect_iron": 71.00591715976331, "collect_diamond": 40.23668639053255, "make_iron_pickaxe": 34.319526627218934, "make_iron_sword": 34.319526627218934, "make_arrow": 90.53254437869822, "make_torch": 94.0828402366864, "place_torch": 90.53254437869822, "collect_sapphire": 27.218934911242602, "collect_ruby": 36.68639053254438, "make_diamond_pickaxe": 4.733727810650888, "make_diamond_sword": 7.100591715976331, "enter_gnomish_mines": 59.171597633136095, "enter_dungeon": 100.0, "defeat_orc_solider": 81.06508875739645, "defeat_orc_mage": 70.41420118343196, "find_bow": 98.81656804733728, "fire_bow": 90.53254437869822, "open_chest": 98.81656804733728, "drink_potion": 84.02366863905326}, "average_episode_length": 1866.5976331360946, "mean_return_percentage": 20.704824025452297, "mean_return": 46.79290229752219, "lp": NaN, "priority_score": 0.24158817968558524}, {"session": 144, "sr": 0.5833333333333334, "achievement_srs": {"collect_wood": 100.0, "place_table": 100.0, "collect_sapling": 79.48717948717949, "collect_drink": 77.56410256410257, "make_wood_pickaxe": 95.51282051282051, "make_wood_sword": 99.35897435897436, "place_plant": 78.84615384615384, "collect_stone": 100.0, "place_stone": 82.05128205128206, "eat_plant": 23.71794871794872, "make_stone_pickaxe": 72.43589743589743, "make_stone_sword": 98.07692307692308, "wake_up": 23.71794871794872, "place_furnace": 92.94871794871794, "collect_coal": 75.0, "collect_iron": 71.7948717948718, "collect_diamond": 36.53846153846154, "make_iron_pickaxe": 28.846153846153847, "make_iron_sword": 26.28205128205128, "make_arrow": 87.82051282051282, "make_torch": 92.94871794871794, "place_torch": 90.38461538461539, "collect_sapphire": 21.794871794871796, "collect_ruby": 25.641025641025642, "make_diamond_pickaxe": 5.769230769230769, "make_diamond_sword": 5.769230769230769, "enter_gnomish_mines": 58.333333333333336, "enter_dungeon": 100.0, "defeat_orc_solider": 83.97435897435898, "defeat_orc_mage": 74.35897435897436, "find_bow": 99.35897435897436, "fire_bow": 86.53846153846153, "open_chest": 99.35897435897436, "drink_potion": 84.61538461538461}, "average_episode_length": 2033.0897435897436, "mean_return_percentage": 20.182949522333075, "mean_return": 45.613465920472755, "lp": NaN, "priority_score": 0.24305555555555555}]</data>
