      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to locate and use a Ladder Down to descend from the Overworld into the Dungeon.
    Description: The agent must achieve the `ENTER_DUNGEON` achievement by moving to a Ladder Down tile on Floor 0 and executing the `DESCEND` action. All survival needs are switched off (`needs_depletion_multiplier = 0.0`), so the agent never loses food, drink, or energy and never suffers health loss from unmet needs. Natural health regeneration remains at its default rate (1.0). No hostile or passive creatures ever spawn (`melee_spawn_multiplier = 0.0`, `ranged_spawn_multiplier = 0.0`, `passive_spawn_multiplier = 0.0`). The Overworld ladder down is already open because the required kills for Floor 0 default to zero. The agent begins on Floor 0 with an empty inventory. The only objective is to find the ladder and descend, thereby unlocking the critical global transition to later floors.
    Relevant Achievements: ENTER_DUNGEON
    Completed Achievements: (none)
    World:
    - Player: Floor 0; no starting items.
    - Map: No modifications; the default world generation is used (the Ladder Down is spawned normally, and Floor 0 requires 0 kills to unlock it).
    - Mechanics:
        "needs_depletion_multiplier": 0.0,
        "melee_spawn_multiplier": 0.0,
        "ranged_spawn_multiplier": 0.0,
        "passive_spawn_multiplier": 0.0
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_DUNGEON]
        self.completed_achievements = []
        self.label = "ENTER_DUNGEON"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            passive_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=0,  # Overworld ladder is immediately unlocked
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(0)
        # No inventory, no mobs, no block modifications, just the default world

        return builder.build(rng)</data>
