      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to fight gnome warriors and archers in the dark Gnomish Mines to unlock the descent to the Sewers.

Description: The agent starts on Floor 2 (Gnomish Mines) at the location of the up‑ladder that connects to the Dungeon. The mine generation is the default smooth‑terrain layout with stalagmites, coal, iron, diamond, sapphire, ruby ores and lava lakes, but the focus is combat. The agent must defeat a total of 8 hostile monsters on this floor—a mixture of gnome warriors (melee) and gnome archers (ranged)—to clear the level and make the ladder‑down to the Sewers usable. The starting inventory provides an iron sword, bow, 20 arrows and 20 torches, simulating a competent arrival from Floor 1. Survival needs (hunger, thirst, fatigue) deplete at 70% of the normal rate (`needs_depletion_multiplier = 0.7`), giving the agent enough time to locate and engage enemies while still requiring occasional feeding (bats are the passive mob on this floor). All other game parameters remain at their default values, including normal mob spawn rates and difficulty. This task directly targets the globally critical ability to progress beyond the Gnomish Mines in the full Craftax game.

Relevant Achievements: ENTER_SEWERS
Completed Achievements: MAKE_IRON_SWORD, FIND_BOW, ENTER_DUNGEON, ENTER_GNOMISH_MINES

World:
- Player: Starting floor = 2 (via `builder.set_starting_floor(2)`). Inventory: `{"sword": 3, "bow": 1, "arrows": 20, "torches": 20}` (via `builder.set_player_inventory(...)`). All other attributes default (full health/food/drink/energy, etc.).
- Map:
  - No manual block placements; the default Gnomish Mines generation remains intact.
  - The kill counter for floor 2 is reset: `builder.set_monsters_killed(level=2, count=0)`.
- Mechanics:
  - `monsters_killed_to_clear_level = 8`
  - `needs_depletion_multiplier = 0.7`
  - All other TaskParams (spawn multipliers, mob health/damage multipliers, health/mana recovery multipliers, growing plants age) are at their default 1.0.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_SEWERS,
        ]
        self.completed_achievements = [
            Achievement.MAKE_IRON_SWORD,
            Achievement.FIND_BOW,
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.label = "ENTER_SEWERS"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
            needs_depletion_multiplier=0.7,
            # All other multipliers remain at default 1.0
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines)
        builder.set_starting_floor(2)

        # Equip starting inventory: iron sword, bow, 20 arrows, 20 torches
        builder.set_player_inventory({
            "sword": 3,      # iron sword
            "bow": 1,
            "arrows": 20,
            "torches": 20,
        })

        # Reset the kill counter for floor 2 to zero
        builder.set_monsters_killed(level=2, count=0)

        # No block/mob placement modifications; use default world generation
        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
