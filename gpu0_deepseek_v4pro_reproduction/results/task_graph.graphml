w": 100.0, "make_torch": 100.0, "place_torch": 100.0, "collect_sapphire": 29.48328267477204, "collect_ruby": 25.835866261398177, "make_diamond_pickaxe": 3.3434650455927053, "make_diamond_sword": 5.775075987841945, "make_iron_armour": 5.47112462006079, "enter_gnomish_mines": 65.65349544072949, "enter_dungeon": 100.0, "defeat_orc_solider": 97.26443768996961, "defeat_orc_mage": 89.36170212765957, "eat_snail": 96.96048632218844, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 99.3920972644377, "drink_potion": 81.7629179331307}, "average_episode_length": 853.2857142857143, "mean_return_percentage": 19.660641838788095, "mean_return": 44.4330505556611, "lp": NaN, "priority_score": 0.22549680804870614}]</data>
