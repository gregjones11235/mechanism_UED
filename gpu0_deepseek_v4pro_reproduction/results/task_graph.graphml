      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Craft iron armour while already on the Dungeon floor, then descend into the Gnomish Mines.

Description: The agent begins on floor 1 (Dungeon) at the up‑ladder spawn location. It starts equipped with an iron sword (sword tier 3) and a stone pickaxe (pickaxe tier 2). Its inventory contains 5 wood, 5 stone, 3 coal, and 2 iron. All other player attributes (health, food, drink, energy, mana) are at their default maximums, and no spells or enchantments are known. Two accessible iron blocks and one coal block are placed near the starting area so the agent can obtain the missing iron needed for the armour without long wandering. The ladder‑down to floor 2 (Gnomish Mines) is locked; it becomes usable only after the agent defeats 3 hostile mobs on floor 1. Gameplay follows standard mechanics: the agent must place a crafting table and furnace, collect the final iron piece, and stand near both table and furnace to execute the MAKE_IRON_ARMOUR action. After crafting the armour, the agent must fight and kill three Orc Soldiers or Orc Mages to unlock the ladder, then descend to floor 2.

Relevant Achievements: MAKE_IRON_ARMOUR, ENTER_GNOMISH_MINES

Completed Achievements: MAKE_IRON_SWORD, MAKE_STONE_PICKAXE, COLLECT_WOOD, COLLECT_STONE, COLLECT_COAL, COLLECT_IRON

World:
- Player:
  - Starting floor = 1
  - Inventory: {"pickaxe": 2, "sword": 3, "wood": 5, "stone": 5, "coal": 3, "iron": 2}
  - All stats at default maximums (health=9, food=9, drink=9, energy=9, mana=9, no enchantments, no learned spells)
- Map (all on floor 1):
  - Place 2 iron blocks randomly near the player, min_dist=2, max_dist=5, on_blocks=[BlockType.PATH]:
    builder.place_randomly_near(rng, 1, BlockType.IRON, target_pos=None, min_dist=2, max_dist=5, n=2, on_blocks=[BlockType.PATH])
  - Place 1 coal block randomly near the player, min_dist=2, max_dist=5, on_blocks=[BlockType.PATH]:
    builder.place_randomly_near(rng, 1, BlockType.COAL, target_pos=None, min_dist=2, max_dist=5, n=1, on_blocks=[BlockType.PATH])
  - Set monsters killed on floor 1 to 0: builder.set_monsters_killed(level=1, count=0)
- Mechanics:
  - monsters_killed_to_clear_level = 3
  - All other TaskParams multipliers (passive_spawn_multiplier, melee_spawn_multiplier, ranged_spawn_multiplier, mob_health_multiplier, mob_damage_multiplier, needs_depletion_multiplier, health_recover_multiplier, health_loss_multiplier, mana_recover_multiplier) remain at their default of 1.0.
  - melee_trigger_distance and growing_plants_age left at defaults.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.MAKE_IRON_ARMOUR,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_IRON_SWORD,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.COLLECT_WOOD,
            Achievement.COLLECT_STONE,
            Achievement.COLLECT_COAL,
            Achievement.COLLECT_IRON,
        ]
        self.label = "MAKE_IRON_ARMOUR, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=3,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)
        # Split additional keys for random block placements
        rng_iron, rng_coal = jax.random.split(rng, 2)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up‑ladder position
        builder.set_starting_floor(1)

        # Set starting inventory: iron sword (tier 3), stone pickaxe (tier 2), and supplies
        builder.set_player_inventory({
            "pickaxe": 2,  # stone
            "sword": 3,    # iron
            "wood": 5,
            "stone": 5,
            "coal": 3,
            "iron": 2,
        })

        # No stat or spell modifications needed (defaults already set)

        # Get the player's spawn position (up‑ladder on floor 1)
        spawn_pos = builder.player_position

        # Place 2 iron blocks near the spawn on PATH tiles
        builder.place_randomly_near(
            rng_iron,
            level=1,
            block_type=BlockType.IRON,
            target_pos=spawn_pos,
            min_dist=2,
            max_dist=5,
            n=2,
            on_blocks=[BlockType.PATH],
        )

        # Place 1 coal block near the spawn on PATH tiles
        builder.place_randomly_near(
            rng_coal,
            level=1,
            block_type=BlockType.COAL,
            target_pos=spawn_pos,
            min_dist=2,
            max_dist=5,
            n=1,
            on_blocks=[BlockType.PATH],
        )

        # Reset monsters killed on floor 1 to 0 (so ladder is locked until 3 kills)
        builder.set_monsters_killed(level=1, count=0)

        state = builder.build(rng)  # build with original rng (the one before splitting)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
