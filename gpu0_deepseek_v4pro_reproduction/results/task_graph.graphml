ce": 99.00990099009901, "collect_coal": 91.08910891089108, "collect_iron": 79.70297029702971, "collect_diamond": 32.17821782178218, "make_iron_pickaxe": 38.613861386138616, "make_iron_sword": 53.46534653465346, "make_arrow": 96.53465346534654, "make_torch": 97.52475247524752, "place_torch": 96.53465346534654, "collect_sapphire": 32.67326732673267, "collect_ruby": 26.237623762376238, "make_diamond_pickaxe": 4.9504950495049505, "make_diamond_sword": 5.445544554455446, "make_iron_armour": 7.920792079207921, "enter_gnomish_mines": 60.396039603960396, "enter_dungeon": 96.03960396039604, "defeat_orc_solider": 92.07920792079207, "defeat_orc_mage": 83.66336633663366, "eat_snail": 80.1980198019802, "find_bow": 95.04950495049505, "fire_bow": 92.07920792079207, "open_chest": 95.04950495049505, "drink_potion": 87.12871287128714}, "average_episode_length": 1447.2277227722773, "mean_return_percentage": 24.091748958150795, "mean_return": 54.44735264542079, "lp": NaN, "priority_score": 0.24115282815410255}, {"session": 68, "sr": 0.722488038277512, "achievement_srs": {"eat_cow": 62.67942583732057, "collect_sapling": 100.0, "collect_drink": 98.56459330143541, "make_wood_sword": 99.04306220095694, "place_plant": 99.52153110047847, "defeat_zombie": 47.84688995215311, "collect_stone": 100.0, "place_stone": 99.04306220095694, "eat_plant": 22.966507177033492, "defeat_skeleton": 44.97607655502392, "make_stone_pickaxe": 93.30143540669856, "make_stone_sword": 96.17224880382776, "wake_up": 85.64593301435407, "place_furnace": 100.0, "collect_coal": 94.25837320574162, "collect_iron": 82.77511961722487, "collect_diamond": 36.36363636363637, "make_iron_pickaxe": 38.27751196172249, "make_iron_sword": 66.02870813397129, "make_arrow": 98.08612440191388, "make_torch": 98.56459330143541, "place_torch": 97.60765550239235, "collect_sapphire": 25.358851674641148, "collect_ruby": 34.44976076555024, "make_diamond_pickaxe": 4.784688995215311, "make_diamond_sword": 10.526315789473685, "make_iron_armour": 12.