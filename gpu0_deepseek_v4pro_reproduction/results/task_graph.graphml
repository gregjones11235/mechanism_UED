      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Reach the Gnomish Mines (Floor 2) starting from the Overworld under original Craftax survival pressure and mob spawn rates, while retaining starter tools to avoid early crafting drift.

Description: The agent begins on Floor 0 at the default center coordinates with a wood pickaxe, a wood sword, 10 wood, and 5 stone already in its inventory. The Overworld ladder down is pre‑unlocked (kill count set to 8) so the agent can descend as soon as it finds it. All mob spawn rates are set to their full original values (1.0 for melee, ranged, and passive) and the needs depletion multiplier is reset to 1.0, matching the original game’s hunger, thirst, and fatigue pace. The agent must navigate the Overworld, enter the Dungeon, survive and defeat enough orc soldiers and mages to unlock the Floor 1 descending ladder (kill count required: 8), and finally step onto Floor 2 to trigger the ENTER_GNOMISH_MINES achievement. No additional mobs or blocks are placed; the world relies on default generation and natural spawning. This task forces the agent to learn robust food/water gathering and combat management under full survival demands, directly targeting the major global performance gap while keeping the progression goal unchanged.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD

World:
- Player: Floor 0 (default spawn position). Inventory: {"pickaxe": 1, "sword": 1, "wood": 10, "stone": 5}. Stats: Strength=1, Dexterity=1, Intelligence=1. All status bars full (9/9). No learned spells, no weapon/armour enchantments.
- Map:
    - Use default world generation for all levels.
    - Call `builder.set_monsters_killed(level=0, count=8)` to pre‑unlock the Overworld ladder down.
    - No manual block placements or mob pre‑spawning.
- Mechanics:
    "needs_depletion_multiplier": 1.0,
    "melee_spawn_multiplier": 1.0,
    "ranged_spawn_multiplier": 1.0,
    "passive_spawn_multiplier": 1.0,
    "monsters_killed_to_clear_level": 8,
    "health_recover_multiplier": 1.0,
    "health_loss_multiplier": 1.0,
    "mob_health_multiplier": 1.0,
    "mob_damage_multiplier": 1.0
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            monsters_killed_to_clear_level=8,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            mana_recover_multiplier=1.0,   # original Craftax default
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld)
        builder.set_starting_floor(0)

        # Equip starting inventory
        builder.set_player_inventory({
            "pickaxe": 1,   # wood
            "sword": 1,     # wood
            "wood": 10,
            "stone": 5,
        })

        # Pre‑unlock the Overworld ladder down
        builder.set_monsters_killed(level=0, count=8)

        # Build the full state
        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
