": 100.0, "fire_bow": 100.0, "open_chest": 99.71751412429379, "drink_potion": 84.46327683615819}, "average_episode_length": 781.9717514124294, "mean_return_percentage": 18.361072913151215, "mean_return": 41.49602478372175, "lp": NaN, "priority_score": 0.24935363401321456}, {"session": 147, "sr": 0.5702479338842975, "achievement_srs": {"collect_wood": 50.964187327823694, "place_table": 46.28099173553719, "eat_cow": 56.74931129476584, "collect_sapling": 52.617079889807165, "collect_drink": 93.38842975206612, "make_wood_pickaxe": 62.25895316804408, "make_wood_sword": 100.0, "place_plant": 52.617079889807165, "defeat_zombie": 30.853994490358126, "collect_stone": 51.239669421487605, "place_stone": 50.137741046831955, "eat_plant": 11.294765840220386, "defeat_skeleton": 26.99724517906336, "make_stone_pickaxe": 48.484848484848484, "wake_up": 96.69421487603306, "place_furnace": 50.413223140495866, "collect_coal": 67.4931129476584, "collect_iron": 64.46280991735537, "collect_diamond": 31.40495867768595, "make_iron_pickaxe": 21.21212121212121, "make_iron_sword": 28.37465564738292, "make_torch": 93.66391184573003, "place_torch": 91.18457300275482, "collect_sapphire": 27.272727272727273, "collect_ruby": 28.37465564738292, "make_diamond_pickaxe": 4.683195592286501, "make_diamond_sword": 3.0303030303030303, "make_iron_armour": 2.7548209366391183, "enter_gnomish_mines": 57.02479338842975, "enter_dungeon": 100.0, "defeat_orc_solider": 97.7961432506887, "defeat_orc_mage": 93.66391184573003, "eat_snail": 97.7961432506887, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 99.17355371900827, "drink_potion": 88.15426997245179}, "average_episode_length": 757.8429752066115, "mean_return_percentage": 19.321245851769913, "mean_return": 43.666015625, "lp": NaN, "priority_score": 0.24506522778498738}]</data>
