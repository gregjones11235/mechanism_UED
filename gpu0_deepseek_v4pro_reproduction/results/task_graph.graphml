nd": 48.83720930232558, "make_iron_pickaxe": 35.46511627906977, "make_iron_sword": 48.25581395348837, "make_arrow": 98.54651162790698, "make_torch": 95.93023255813954, "place_torch": 94.47674418604652, "collect_sapphire": 37.5, "collect_ruby": 38.95348837209303, "make_diamond_pickaxe": 7.267441860465116, "make_diamond_sword": 7.267441860465116, "make_iron_armour": 10.465116279069768, "enter_gnomish_mines": 63.95348837209303, "enter_dungeon": 100.0, "defeat_orc_solider": 96.80232558139535, "defeat_orc_mage": 90.40697674418605, "find_bow": 96.51162790697674, "fire_bow": 95.34883720930233, "open_chest": 96.51162790697674, "drink_potion": 93.02325581395348}, "average_episode_length": 809.3691860465116, "mean_return_percentage": 21.626513179473655, "mean_return": 48.87591978561046, "lp": NaN, "priority_score": 0.23053001622498648}]</data>
      <data key="d5">77</data>
