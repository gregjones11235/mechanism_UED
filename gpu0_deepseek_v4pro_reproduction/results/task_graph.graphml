      <data key="d3">import jax
import jax.numpy as jnp
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to descend from Overworld to Dungeon (floor 1) and then to Gnomish Mines (floor 2), bridging floor 0 navigation with floor 1 combat.

Description: The agent starts on the Overworld (floor 0) with a stone sword. Its goal is to first find the Ladder Down, descend into the Dungeon (triggering `ENTER_DUNGEON`), and then, on floor 1, defeat enough hostile mobs to clear the floor and descend to floor 2, earning `ENTER_GNOMISH_MINES`. The overworld is kept safe with low mob spawning, and survival needs are slowed to 0.1× speed so the agent can focus on exploration and combat. To replicate the combat challenge from the parent task, floor 1 is seeded with two Orc Soldiers and two Orc Mages, along with two passive snails for optional food.

Relevant Achievements: ENTER_DUNGEON, ENTER_GNOMISH_MINES

Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD

World:
- Player: starting floor 0. Inventory: `{"sword": 2}` (stone sword). All other stats and equipment are default.
- Map:
  - On floor 1, place 2 melee Orc Soldiers (mob_name="orc_soldier", type_id=2) randomly using `add_mobs_randomly_near` with `target_pos=jnp.array([24,24])`, min_dist=0, max_dist=25, on `[BlockType.PATH]`.
  - On floor 1, place 2 ranged Orc Mages (mob_name="orc_mage", type_id=2) randomly using `add_mobs_randomly_near` with `target_pos=jnp.array([24,24])`, min_dist=0, max_dist=25, on `[BlockType.PATH]`.
  - On floor 1, place 2 passive snails (mob_name="snail", type_id=2) randomly using `add_mobs_randomly_near` with `target_pos=jnp.array([24,24])`, min_dist=0, max_dist=25, on `[BlockType.PATH]`.
- Mechanics:
  - needs_depletion_multiplier = 0.1
  - melee_spawn_multiplier = 0.2
  - ranged_spawn_multiplier = 0.2
  - passive_spawn_multiplier = 0.2
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
        ]
        self.label = "ENTER_DUNGEON, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.1,
            melee_spawn_multiplier=0.2,
            ranged_spawn_multiplier=0.2,
            passive_spawn_multiplier=0.2,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, melee_rng, ranged_rng, passive_rng = jax.random.split(rng, 5)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld) with a stone sword (id = 2)
        builder.set_starting_floor(0)
        builder.set_player_inventory({"sword": 2})

        # Floor 1 mob placements: two Orc Soldiers (melee, type_id=2)
        builder.add_mobs_randomly_near(
            melee_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=2,
            target_pos=jnp.array([24, 24]),
            min_dist=0,
            max_dist=25,
            on_blocks=[BlockType.PATH],
        )

        # Two Orc Mages (ranged, type_id=2)
        builder.add_mobs_randomly_near(
            ranged_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=2,
            target_pos=jnp.array([24, 24]),
            min_dist=0,
            max_dist=25,
            on_blocks=[BlockType.PATH],
        )

        # Two passive snails (passive, type_id=2)
        builder.add_mobs_randomly_near(
            passive_rng,
            level=1,
            mob_name="passive",
            type_id=2,
            n=2,
            target_pos=jnp.array([24, 24]),
            min_dist=0,
            max_dist=25,
            on_blocks=[BlockType.PATH],
        )

        return builder.build(rng)</data>
