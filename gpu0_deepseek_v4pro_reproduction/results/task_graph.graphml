50887573964496, "defeat_skeleton": 42.30769230769231, "wake_up": 96.44970414201184, "place_furnace": 88.46153846153847, "collect_coal": 83.4319526627219, "collect_iron": 77.81065088757397, "collect_diamond": 31.65680473372781, "make_iron_pickaxe": 22.781065088757398, "make_iron_sword": 42.30769230769231, "make_arrow": 92.3076923076923, "make_torch": 92.01183431952663, "place_torch": 92.01183431952663, "collect_sapphire": 23.37278106508876, "collect_ruby": 26.331360946745562, "make_diamond_pickaxe": 2.9585798816568047, "make_diamond_sword": 2.366863905325444, "make_iron_armour": 5.325443786982248, "enter_gnomish_mines": 54.437869822485204, "enter_dungeon": 100.0, "defeat_orc_solider": 96.74556213017752, "defeat_orc_mage": 87.8698224852071, "eat_snail": 97.92899408284023, "find_bow": 99.40828402366864, "fire_bow": 91.71597633136095, "open_chest": 99.40828402366864, "drink_potion": 82.54437869822485}, "average_episode_length": 814.905325443787, "mean_return_percentage": 21.46960920317982, "mean_return": 48.521316799186394, "lp": NaN, "priority_score": 0.2480305311438675}]</data>
