      <data key="d3">import jax
import jax.numpy as jnp
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Isolate dungeon navigation and combat to master descending from the Dungeon (floor 1) into the Gnomish Mines (floor 2), relying on pre‑crafted iron equipment to remove the overworld crafting chain.

Description: The agent begins on the Overworld (floor 0) with a full set of iron tools, iron armour, a bow, arrows, and torches already in its inventory, and the ladder to the Dungeon is already unlocked (monsters_killed[0] = 8). The task is to immediately descend to the Dungeon (floor 1), explore the procedurally‑generated rooms/corridors, defeat the required number of hostile monsters (default 8), locate the randomly placed LADDER_DOWN, step on it, and use DESCEND to enter the Gnomish Mines (floor 2). No overworld resource gathering or crafting is needed; the inventory provides everything required for combat and navigation. Survival pressure is kept very low (`needs_depletion_multiplier = 0.25`, `health_recover_multiplier = 2.0`) so that the agent can concentrate exclusively on movement, monster engagement, and floor traversal. By compressing away the iron‑crafting sequence, this task delivers densely‑packed practice on the exact skill that is globally weakest: reaching floor 2.

Relevant Achievements: ENTER_DUNGEON, ENTER_GNOMISH_MINES
Completed Achievements: MAKE_IRON_PICKAXE, MAKE_IRON_SWORD, MAKE_IRON_ARMOUR, FIND_BOW, MAKE_ARROW, MAKE_TORCH

World:
- Player:
  - Starting floor = 0.
  - Inventory: {"pickaxe": 1, "sword": 1, "armour_helmet": 1, "armour_chestplate": 1, "armour_leggings": 1, "armour_boots": 1, "bow": 1, "arrows": 20, "torches": 10}.
  - Stats: dexterity=1, strength=1, intelligence=1 (default).
  - `set_monsters_killed(level=0, count=8)` – Overworld ladder is immediately usable, no overworld combat required.
- Map:
  - No manual block modifications; the default world generation for all levels is used. The Dungeon (level 1) will place a single LADDER_DOWN on a valid PATH tile somewhere in its layout.
- Mechanics:
  - `melee_spawn_multiplier = 1.0`
  - `ranged_spawn_multiplier = 1.0`
  - `passive_spawn_multiplier = 1.0`
  - `mob_health_multiplier = 1.0`
  - `mob_damage_multiplier = 1.0`
  - `needs_depletion_multiplier = 0.25`
  - `health_recover_multiplier = 2.0`
  - `monsters_killed_to_clear_level = 8` (effective for floor 1 to require 8 kills before descending)
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_IRON_PICKAXE,
            Achievement.MAKE_IRON_SWORD,
            Achievement.MAKE_IRON_ARMOUR,
            Achievement.FIND_BOW,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_TORCH,
        ]
        self.label = "ENTER_DUNGEON, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            needs_depletion_multiplier=0.25,
            health_recover_multiplier=2.0,
            monsters_killed_to_clear_level=8,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on Overworld (floor 0) at default spawn
        builder.set_starting_floor(0)

        # Full iron equipment
        builder.set_player_inventory({
            "pickaxe": 3,   # iron pickaxe
            "sword": 3,     # iron sword
            "bow": 1,
            "arrows": 20,
            "torches": 10,
            "armour": jnp.array([1, 1, 1, 1]),  # full iron armour
        })

        # Overworld ladder is already unlocked
        builder.set_monsters_killed(level=0, count=8)

        # No additional block or mob placements

        state = builder.build(rng)

        # Mark completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
