e": 17.51824817518248, "make_iron_sword": 29.562043795620436, "make_arrow": 88.32116788321167, "make_torch": 90.14598540145985, "place_torch": 90.14598540145985, "collect_sapphire": 24.817518248175183, "collect_ruby": 24.087591240875913, "make_diamond_pickaxe": 0.36496350364963503, "make_diamond_sword": 2.18978102189781, "enter_gnomish_mines": 61.67883211678832, "enter_dungeon": 100.0, "defeat_orc_solider": 97.81021897810218, "defeat_orc_mage": 82.48175182481752, "eat_snail": 97.81021897810218, "find_bow": 98.9051094890511, "fire_bow": 87.5912408759124, "open_chest": 98.9051094890511, "drink_potion": 78.10218978102189}, "average_episode_length": 987.5912408759124, "mean_return_percentage": 20.879880541571122, "mean_return": 47.18853002395073, "lp": NaN, "priority_score": 0.23636048803878737}]</data>
