      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to survive and fight in the Gnomish Mines (floor 2) by clearing the required number of hostile mobs and descending to the Sewers (floor 3).

Description: This task pushes the agent from simply arriving at floor 2 to becoming combat‑effective inside it. The player starts directly on floor 2, already equipped with iron tools, a bow, arrows, torches, and a small cache of resources, so no backtracking is required. A Crafting Table and a Furnace are placed near the spawn point. The goal is to kill at least 8 hostile mobs on floor 2 (Gnome Warriors and Gnome Archers spawn naturally), locate the Ladder Down, and descend to floor 3, thereby achieving `ENTER_SEWERS`. Survival pressure is intentionally light (`needs_depletion_multiplier = 0.2`, `health_recover_multiplier = 2.0`) so the agent can focus on combat and light management without dying of hunger or thirst. Mob damage is reduced (`mob_damage_multiplier = 0.7`) to make the first encounters with these new melee and ranged creatures learnable, while still being a credible threat.

Relevant Achievements:
- ENTER_SEWERS

Completed Achievements:
- ENTER_DUNGEON
- ENTER_GNOMISH_MINES
- MAKE_IRON_PICKAXE
- MAKE_IRON_SWORD
- PLACE_TABLE
- PLACE_FURNACE

World:
- Player:
  - Starting floor: `set_starting_floor(2)`
  - Inventory: {"wood": 10, "stone": 10, "coal": 5, "torches": 10, "arrows": 20, "bow": 1, "pickaxe": 3, "sword": 3}
  - Stats: `set_player_stats(dexterity=1, strength=1, intelligence=1)`
  - No monster‑kill pre‑set on floor 2 (kill count starts at 0); the ladder must be unlocked.
- Map:
  - Level 2:
    - Place a Crafting Table: `place_randomly_near(rng, 2, BlockType.CRAFTING_TABLE, target_pos=player_start_pos, min_dist=1, max_dist=3, n=1, on_blocks=[BlockType.PATH])`
    - Place a Furnace: `place_randomly_near(rng, 2, BlockType.FURNACE, target_pos=player_start_pos, min_dist=1, max_dist=3, n=1, on_blocks=[BlockType.PATH])`
  - All other levels remain at their default generation (not accessed in this task).
- Mechanics:
  - `needs_depletion_multiplier = 0.2`
  - `health_recover_multiplier = 2.0`
  - `mob_damage_multiplier = 0.7`
  - `monsters_killed_to_clear_level = 8`
  - All other `TaskParams` at default.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_SEWERS,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
            Achievement.MAKE_IRON_PICKAXE,
            Achievement.MAKE_IRON_SWORD,
            Achievement.PLACE_TABLE,
            Achievement.PLACE_FURNACE,
        ]
        self.label = "ENTER_SEWERS"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.2,
            health_recover_multiplier=2.0,
            mob_damage_multiplier=0.7,
            monsters_killed_to_clear_level=8,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, table_rng, furnace_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines)
        builder.set_starting_floor(2)

        # Equip starting inventory: iron pickaxe, iron sword, bow, arrows, torches, and materials
        builder.set_player_inventory({
            "wood": 10,
            "stone": 10,
            "coal": 5,
            "torches": 10,
            "arrows": 20,
            "bow": 1,
            "pickaxe": 3,  # iron pickaxe
            "sword": 3,    # iron sword
        })

        # Stats remain default (strength=1, dexterity=1, intelligence=1) - no separate call needed

        # Get the player's starting position after floor selection
        player_pos = builder.player_position

        # Place a Crafting Table near the player on any path block
        builder.place_randomly_near(
            rng=table_rng,
            level=2,
            block_type=BlockType.CRAFTING_TABLE,
            target_pos=player_pos,
            min_dist=1,
            max_dist=3,
            n=1,
            on_blocks=[BlockType.PATH],
        )

        # Place a Furnace near the player on any path block
        builder.place_randomly_near(
            rng=furnace_rng,
            level=2,
            block_type=BlockType.FURNACE,
            target_pos=player_pos,
            min_dist=1,
            max_dist=3,
            n=1,
            on_blocks=[BlockType.PATH],
        )

        # No pre‑cleared monsters on floor 2; the agent must kill 8 to unlock the down ladder

        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
