      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to defeat a melee Orc Soldier and a ranged Orc Mage on Floor 1 while actively managing hunger, thirst, and fatigue, preparing for survival-based combat in the full dungeon.

Description: The agent spawns on Floor 1 (Dungeon) equipped with a stone sword, stone pickaxe, and a small supply of raw wood and stone. Two hostile mobs—one Orc Soldier (melee, type_id=2) and one Orc Mage (ranged, type_id=2)—are pre‑placed near the player. Unlike the parent task, all survival needs are active (hunger, thirst, and energy deplete, and health can be lost from starvation/dehydration). Passive mob spawning is enabled (passive_spawn_multiplier = 1.0), allowing snails to appear on the dungeon floor; these provide a natural food source. Fountains in the dungeon offer water. The kill requirement to clear the floor is set to 2, so defeating both enemies unlocks the ladder down. Only these two mobs exist; all hostile spawn multipliers are zero, preventing additional combat pressure. The agent must balance exploring for food/drink, avoiding hunger/thirst death, and engaging the two orcs. This task extends the parent by adding a survival dependency, directly targeting the gap in global Floor 1 clearance where survival and combat must coexist.

Relevant Achievements: DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE

Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD

World:
- Player: Floor 1 (spawn at the ladder‑up position). Inventory: {"sword": 2, "pickaxe": 2, "wood": 5, "stone": 5}. All stats default (Strength 1, Dexterity 1, Intelligence 1; Health/Food/Drink/Energy/Mana all 9/9). No spells learned, no enchantments.
- Map:
    - Use the default Dungeon generation for Floor 1 (rooms, corridors, chests, fountains, torches).
    - Place exactly one melee mob of type appropriate for Floor 1: Orc Soldier (mob_name="melee", type_id=2) via `add_mobs_randomly_near` with target_pos = player spawn, n=1, min_dist=2, max_dist=8, on any walkable terrain.
    - Place exactly one ranged mob of type appropriate for Floor 1: Orc Mage (mob_name="ranged", type_id=2) via `add_mobs_randomly_near` with target_pos = player spawn, n=1, min_dist=2, max_dist=8, on any walkable terrain.
- Mechanics:
    - needs_depletion_multiplier = 1.0
    - passive_spawn_multiplier = 1.0
    - melee_spawn_multiplier = 0.0
    - ranged_spawn_multiplier = 0.0
    - monsters_killed_to_clear_level = 2
    - health_recover_multiplier = 1.0
    - health_loss_multiplier = 1.0
    - mana_recover_multiplier = 1.0
    - mob_health_multiplier = 1.0
    - mob_damage_multiplier = 1.0
    - melee_trigger_distance = 10
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.DEFEAT_ORC_SOLIDER,
            Achievement.DEFEAT_ORC_MAGE,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
        ]
        self.label = "DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=2,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            melee_trigger_distance=10,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, soldier_rng, mage_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Spawn on Floor 1 (Dungeon)
        builder.set_starting_floor(1)

        # Equip stone sword (2) and stone pickaxe (2), plus raw materials
        builder.set_player_inventory({
            "sword": 2,
            "pickaxe": 2,
            "wood": 5,
            "stone": 5,
        })

        # Place one Orc Soldier (melee, type_id=2) near spawn
        builder.add_mobs_randomly_near(
            soldier_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=1,
            target_pos=builder.player_position,
            min_dist=2,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        # Place one Orc Mage (ranged, type_id=2) near spawn
        builder.add_mobs_randomly_near(
            mage_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=1,
            target_pos=builder.player_position,
            min_dist=2,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        return builder.build(rng)</data>
