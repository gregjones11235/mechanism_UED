      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Teach the agent to prepare for the dungeon by crafting a stone weapon, fighting overworld enemies, and descending, without pre‑supplied combat gear.

Description: The agent starts on floor 0 (the overworld) with minimal supplies and must earn the `ENTER_DUNGEON` achievement by descending to floor 1. The overworld generates normally with its default terrain, trees, stone, coal, iron, water, and passive/hostile mobs. A crafting table is pre‑placed one tile to the right of the player’s spawn (at coordinates (24, 25), assuming spawn at (24, 24)) so the agent can immediately use it. The inventory contains only a wood pickaxe and 2 wood. The agent must mine stone (using the wood pickaxe), craft a stone sword at the crafting table, and then defeat hostile mobs (zombies, skeletons) to meet the floor’s kill requirement of 6. Normal survival needs (hunger, thirst, health) apply with `needs_depletion_multiplier = 1.0`. All mob spawn multipliers remain at 1.0 to keep the challenge realistic. The task ends successfully when the agent finds and uses a ladder down to floor 1, triggering `ENTER_DUNGEON`. No achievements are marked as completed by the initial state; the agent earns them naturally during play.

Relevant Achievements: ENTER_DUNGEON

Completed Achievements: (none)

World:
- Player: Starting floor 0. Inventory:
    - wood_pickaxe: 1
    - wood: 2
  All stats at default maximums (health 9, food 9, drink 9, energy 9, mana 9; Strength 1, Dexterity 1, Intelligence 1).
- Map: Pre‑place one Crafting Table at world coordinates (24, 25) on level 0 (assuming player spawns at (24, 24)). No other block modifications.
- Mechanics:
    - needs_depletion_multiplier = 1.0
    - monsters_killed_to_clear_level = 6 (applies to level 0)
    - melee_spawn_multiplier = 1.0
    - ranged_spawn_multiplier = 1.0
    - passive_spawn_multiplier = 1.0
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_DUNGEON,
        ]
        self.completed_achievements = []  # none
        self.label = "ENTER_DUNGEON"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=6,
            needs_depletion_multiplier=1.0,
            # All spawn multipliers default to 1.0; we set them explicitly for clarity.
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld)
        builder.set_starting_floor(0)

        # Inventory: wood pickaxe (id 1) and 2 wood
        builder.set_player_inventory({
            "pickaxe": 1,  # wood pickaxe
            "wood": 2,
        })

        # Place a Crafting Table one tile to the right of the spawn point
        spawn_pos = builder.player_position
        builder.place_block(
            level=0,
            block_type=BlockType.CRAFTING_TABLE,
            position=(spawn_pos[0] + 1, spawn_pos[1]),
        )

        # Reset monsters killed on floor 0 so the ladder is not already open.
        # The agent must kill 6 mobs to clear the level.
        builder.set_monsters_killed(level=0, count=0)

        state = builder.build(rng)

        # No pre‑completed achievements to set
        return state</data>
