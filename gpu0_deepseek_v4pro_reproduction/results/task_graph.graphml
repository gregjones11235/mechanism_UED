      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Clear the Dungeon while managing normal survival pressure (full hunger/thirst/fatigue) and descend to the Gnomish Mines.

Description: The agent starts on Floor 1 (Dungeon) with a bow, 10 arrows, and a wood sword—the same combat loadout that previously succeeded under easy survival. Now `needs_depletion_multiplier` is raised to **1.0** (full speed), so hunger, thirst, and fatigue decay at the original Craftax rate. The agent must actively hunt passive mobs (snails) and drink from fountains to stay alive during combat. Melee and ranged spawn multipliers are kept at 0.8 and 0.7, and `monsters_killed_to_clear_level` remains at 8. Two passive Snail mobs are seeded 3‑10 tiles from the spawn to provide early food, while the usual two hostile mobs (one Orc Soldier, one Orc Mage) are placed at distance 5‑8. Spawning will generate all other mobs. Ascending to Floor 0 is still possible but penalized by the global 8‑kill ladder requirement, encouraging the agent to sustain itself entirely within the Dungeon. The goal is to defeat eight hostiles, stand on the ladder down, and achieve `ENTER_GNOMISH_MINES`.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: FIND_BOW, MAKE_WOOD_SWORD, MAKE_ARROW

World:
- Player: Floor 1 (spawn at ladder‑up position). Inventory: {"bow": 1, "arrows": 10, "sword": 1}. Stats: Strength 1, Dexterity 1, Intelligence 1. Health/Food/Drink/Energy/Mana all full (9/9). Learned spells: none. Weapon/Armour enchantments: none.
- Map:
    - Dungeon generation for Floor 1 is default.
    - Place two passive mobs (Snail, “passive”, type_id=2) using `add_mobs_randomly_near`, target_pos = player spawn coordinates, n=2, min_dist=3, max_dist=10, on_blocks = [BlockType.PATH].
    - Place exactly one melee mob (Orc Soldier, “melee”, type_id=2) using `add_mobs_randomly_near`, target_pos = player spawn, n=1, min_dist=5, max_dist=8, on_blocks = [BlockType.PATH].
    - Place exactly one ranged mob (Orc Mage, “ranged”, type_id=2) using `add_mobs_randomly_near`, target_pos = player spawn, n=1, min_dist=5, max_dist=8, on_blocks = [BlockType.PATH].
- Mechanics:
    "needs_depletion_multiplier": 1.0,
    "melee_spawn_multiplier": 0.8,
    "ranged_spawn_multiplier": 0.7,
    "passive_spawn_multiplier": 0.5,
    "monsters_killed_to_clear_level": 8,
    "health_recover_multiplier": 1.0,
    "health_loss_multiplier": 1.0,
    "mob_health_multiplier": 1.0,
    "mob_damage_multiplier": 1.0
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.FIND_BOW,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_ARROW,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=1.0,
            melee_spawn_multiplier=0.8,
            ranged_spawn_multiplier=0.7,
            passive_spawn_multiplier=0.5,
            monsters_killed_to_clear_level=8,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, passive_rng, melee_rng, ranged_rng = jax.random.split(rng, 5)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on Floor 1 (Dungeon) at the ladder‑up position
        builder.set_starting_floor(1)

        # Equip starting inventory: wood sword, bow, 10 arrows
        builder.set_player_inventory({
            "sword": 1,    # wood sword
            "bow": 1,
            "arrows": 10,
        })

        # Spawn two passive snails near the player
        spawn_pos = builder.player_position
        builder.add_mobs_randomly_near(
            passive_rng,
            level=1,
            mob_name="passive",
            type_id=2,  # Snail
            n=2,
            target_pos=spawn_pos,
            min_dist=3,
            max_dist=10,
            on_blocks=[BlockType.PATH],
        )

        # Spawn one melee Orc Soldier
        builder.add_mobs_randomly_near(
            melee_rng,
            level=1,
            mob_name="melee",
            type_id=2,  # Orc Soldier
            n=1,
            target_pos=spawn_pos,
            min_dist=5,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        # Spawn one ranged Orc Mage
        builder.add_mobs_randomly_near(
            ranged_rng,
            level=1,
            mob_name="ranged",
            type_id=2,  # Orc Mage
            n=1,
            target_pos=spawn_pos,
            min_dist=5,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        state = builder.build(rng)

        # Mark pre‑completed achievements
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
