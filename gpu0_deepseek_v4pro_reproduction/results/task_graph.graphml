axe": 74.32432432432432, "wake_up": 97.63513513513513, "place_furnace": 87.16216216216216, "collect_coal": 83.44594594594595, "collect_iron": 76.35135135135135, "collect_diamond": 31.41891891891892, "make_iron_pickaxe": 18.58108108108108, "make_iron_sword": 41.554054054054056, "make_arrow": 91.55405405405405, "make_torch": 100.0, "place_torch": 100.0, "collect_sapphire": 23.986486486486488, "collect_ruby": 25.675675675675677, "make_diamond_pickaxe": 3.3783783783783785, "make_diamond_sword": 2.7027027027027026, "enter_gnomish_mines": 56.41891891891892, "enter_dungeon": 100.0, "defeat_orc_solider": 97.63513513513513, "defeat_orc_mage": 94.25675675675676, "eat_snail": 98.3108108108108, "find_bow": 99.32432432432432, "fire_bow": 90.87837837837837, "open_chest": 99.32432432432432, "drink_potion": 78.71621621621621}, "average_episode_length": 927.4155405405405, "mean_return_percentage": 21.696015608649994, "mean_return": 49.032995275548984, "lp": NaN, "priority_score": 0.2458797479912345}]</data>
