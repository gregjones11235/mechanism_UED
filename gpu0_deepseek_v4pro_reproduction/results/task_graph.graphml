      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Teach the agent to survive in the dark Gnomish Mines and defeat enough gnome mobs to unlock the descent to the Sewers.

Description: The agent starts on floor 2 (the Gnomish Mines) at the ladder‑up location. Its inventory contains a stone pickaxe (tier 2), a stone sword (tier 2), and 5 torches. All status bars (health, food, drink, energy, mana) are full. The mines are pitch black, requiring the agent to place torches to see and fight. Hostile mobs – Gnome Warriors (melee) and Gnome Archers (ranged) – spawn normally alongside passive Snails. The agent must defeat a total of 3 hostile monsters on this floor to unlock the ladder down. Once the requirement is met, the agent must locate the ladder down, stand on it, and execute the DESCEND action. Successfully entering the Sewers for the first time (achievement ENTER_SEWERS) marks the episode as a success. Failure occurs if the agent dies or runs out of time without descending.

Relevant Achievements: ENTER_SEWERS

Completed Achievements: MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, MAKE_TORCH (the inventory already contains these items; they cannot be crafted again)

World:
- Player: start_floor = 2. Inventory: pickaxe = 2, sword = 2, torch = 5. All needs at maximum.
- Map: No block modifications; use the default Gnomish Mines generation.
- Mechanics:
  - monsters_killed_to_clear_level = 3
  - All other TaskParams remain at their default values (mob_health_multiplier = 1.0, mob_damage_multiplier = 1.0, melee_spawn_multiplier = 1.0, ranged_spawn_multiplier = 1.0, passive_spawn_multiplier = 1.0, etc.).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_SEWERS,
        ]
        self.completed_achievements = [
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_TORCH,
        ]
        self.label = "ENTER_SEWERS"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=3,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines) at the up-ladder position
        builder.set_starting_floor(2)

        # Equip starting inventory: stone pickaxe, stone sword, 5 torches
        builder.set_player_inventory({
            "pickaxe": 2,   # stone pickaxe
            "sword": 2,     # stone sword
            "torches": 5,
        })

        # No extra mobs or block modifications; default generation used
        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
