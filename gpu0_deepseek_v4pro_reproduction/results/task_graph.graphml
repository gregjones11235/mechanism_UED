.5945945945946, "collect_sapphire": 31.89189189189189, "collect_ruby": 28.64864864864865, "make_diamond_pickaxe": 3.2432432432432434, "make_diamond_sword": 4.864864864864865, "make_iron_armour": 11.35135135135135, "enter_gnomish_mines": 60.0, "enter_dungeon": 95.13513513513513, "defeat_orc_solider": 92.97297297297297, "defeat_orc_mage": 89.72972972972973, "eat_snail": 92.97297297297297, "find_bow": 94.5945945945946, "fire_bow": 92.97297297297297, "open_chest": 94.5945945945946, "drink_potion": 85.94594594594595}, "average_episode_length": 1457.9891891891891, "mean_return_percentage": 25.49776425346807, "mean_return": 57.62494721283784, "lp": NaN, "priority_score": 0.24}]</data>
