mour": 7.317073170731708, "enter_gnomish_mines": 64.39024390243902, "enter_dungeon": 100.0, "defeat_orc_solider": 96.58536585365853, "defeat_orc_mage": 91.70731707317073, "eat_snail": 96.58536585365853, "find_bow": 98.04878048780488, "fire_bow": 95.60975609756098, "open_chest": 98.04878048780488, "drink_potion": 92.1951219512195}, "average_episode_length": 1249.2439024390244, "mean_return_percentage": 23.759892095429528, "mean_return": 53.69735613567073, "lp": NaN, "priority_score": 0.22929208804283163}]</data>
