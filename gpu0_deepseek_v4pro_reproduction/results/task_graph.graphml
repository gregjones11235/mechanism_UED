09677419356, "make_iron_pickaxe": 23.79032258064516, "make_iron_sword": 49.596774193548384, "make_arrow": 96.37096774193549, "make_torch": 99.59677419354838, "place_torch": 99.59677419354838, "collect_sapphire": 18.951612903225808, "collect_ruby": 32.25806451612903, "make_diamond_pickaxe": 3.225806451612903, "make_diamond_sword": 3.629032258064516, "make_iron_armour": 10.887096774193548, "enter_gnomish_mines": 60.88709677419355, "enter_dungeon": 95.56451612903226, "defeat_orc_solider": 90.7258064516129, "defeat_orc_mage": 84.6774193548387, "eat_snail": 91.93548387096774, "find_bow": 95.16129032258064, "fire_bow": 93.14516129032258, "open_chest": 95.16129032258064, "drink_potion": 83.06451612903226}, "average_episode_length": 1112.1693548387098, "mean_return_percentage": 24.666151808494504, "mean_return": 55.745503087197584, "lp": NaN, "priority_score": 0.23814711238293443}]</data>
