      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Generalise the early‑game sequence: from scratch, craft a stone pickaxe, then an iron sword, clear the dungeon, and descend to the Gnomish Mines.

Description: The agent starts on floor 0 with an empty inventory. A crafting table is placed one tile south of the spawn. Survival needs are slowed (20% rate) to keep focus on the crafting‑combat pipeline. The agent must gather wood to make a wood pickaxe, mine stone to make a stone pickaxe, then mine coal and iron, place a furnace, and craft an iron sword. After that, it must locate and enter the dungeon on floor 1, defeat exactly 8 hostile orcs (soldiers or mages) to satisfy the clear requirement, and finally stand on the ladder down and use the DESCEND action to reach floor 2 (the Gnomish Mines). All mob spawn rates and combat parameters remain at default (normal difficulty) to match the original game as closely as possible.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: []

World:
- Player: `set_starting_floor(0)`. Inventory: `{}` (fully empty). All attributes default (Strength/Dexterity/Intelligence = 1, full health/mana/energy/food/drink).
- Map:
  - `place_block(0, BlockType.CRAFTING_TABLE, (player_start_row + 1, player_start_col))` to place a crafting table directly south of the spawn point.
  - `set_monsters_killed(level=1, count=0)` to ensure the dungeon starts uncleared (8 kills needed).
  - No other manual block placements; all ores, trees, stone, water, etc. are generated procedurally as in the normal Overworld.
- Mechanics:
  - monsters_killed_to_clear_level = 8
  - mob_health_multiplier = 1.0
  - mob_damage_multiplier = 1.0
  - melee_spawn_multiplier = 1.0
  - ranged_spawn_multiplier = 1.0
  - passive_spawn_multiplier = 1.0
  - needs_depletion_multiplier = 0.2
  - health_recover_multiplier = 1.0
  - health_loss_multiplier = 1.0
  - mana_recover_multiplier = 1.0
  - growing_plants_age = 600
  - All other parameters left at their default values.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = []  # No pre-completed achievements
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            needs_depletion_multiplier=0.2,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            growing_plants_age=600,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld) at default centre
        builder.set_starting_floor(0)

        # Player spawn coordinates (centre of map)
        spawn_row = self.static_params.map_size[0] // 2
        spawn_col = self.static_params.map_size[1] // 2

        # Place a crafting table directly south of the spawn point
        builder.place_block(0, BlockType.CRAFTING_TABLE, (spawn_row + 1, spawn_col))

        # Ensure the dungeon (floor 1) starts with 0 kills (8 needed to clear)
        builder.set_monsters_killed(1, 0)

        # Build the initial state
        state = builder.build(rng)

        # No achievements are pre-completed, so return as is
        return state</data>
