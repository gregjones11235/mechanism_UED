stone_pickaxe": 97.77777777777777, "make_stone_sword": 88.48484848484848, "wake_up": 76.16161616161617, "place_furnace": 99.1919191919192, "collect_coal": 98.38383838383838, "collect_iron": 94.14141414141415, "collect_diamond": 8.282828282828282, "make_iron_pickaxe": 91.71717171717172, "make_iron_sword": 28.68686868686869, "make_arrow": 94.74747474747475, "make_torch": 93.53535353535354, "place_torch": 82.42424242424242, "collect_sapphire": 5.05050505050505, "collect_ruby": 6.4646464646464645, "make_diamond_pickaxe": 1.0101010101010102, "make_diamond_sword": 0.20202020202020202, "make_iron_armour": 4.242424242424242, "enter_dungeon": 68.68686868686869, "defeat_orc_solider": 5.858585858585859, "defeat_orc_mage": 1.4141414141414141, "eat_snail": 16.161616161616163, "find_bow": 66.06060606060606, "fire_bow": 59.7979797979798, "open_chest": 66.06060606060606, "drink_potion": 22.828282828282827}, "average_episode_length": 572.9252525252525, "mean_return_percentage": 20.779669971283635, "mean_return": 46.96205413510101, "lp": NaN, "priority_score": 0.0759677583920008}, {"session": 24, "sr": 0.89749430523918, "achievement_srs": {"eat_cow": 97.9498861047836, "collect_sapling": 98.86104783599089, "collect_drink": 94.53302961275627, "make_wood_pickaxe": 100.0, "make_wood_sword": 97.49430523917995, "place_plant": 98.86104783599089, "defeat_zombie": 29.612756264236904, "collect_stone": 99.54441913439635, "place_stone": 99.31662870159454, "eat_plant": 14.123006833712983, "defeat_skeleton": 20.273348519362187, "make_stone_pickaxe": 94.76082004555809, "make_stone_sword": 92.02733485193622, "wake_up": 84.05466970387243, "place_furnace": 99.31662870159454, "collect_coal": 97.9498861047836, "collect_iron": 92.25512528473804, "collect_diamond": 8.200455580865604, "make_iron_pickaxe": 89.749430523918, "make_iron_sword": 21.867881548974943, "make_arrow": 95.44419134396355, "make_torch": 88.8382687927107, "place_torch": 81.77676537585421, "collect_sapphire": 5.922551252847381, "collect_ruby": 7.517084282460137, "make_diamond_pickaxe": 1.366742596810934, "make_diamond_sword": 1.8223234624145785, "make_iron_armour": 1.8223234624145785, "enter_dungeon": 79.27107061503416, "defeat_orc_solider": 12.75626423690205, "defeat_orc_mage": 6.605922551252847, "eat_snail": 35.7630979498861, "find_bow": 78.5876993166287, "fire_bow": 69.4760820045558, "open_chest": 78.5876993166287, "drink_potion": 34.39635535307517}, "average_episode_length": 621.0546697038725, "mean_return_percentage": 21.77515073162558, "mean_return": 49.21184065347381, "lp": NaN, "priority_score": 0.09199827730242165}]</data>
