      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Teach the agent to fight a Gnome Archer in the dark Gnomish Mines using a bow and torches, generalizing ranged combat to a new enemy and a blacked‑out environment.

    Description: The agent begins on Floor 2 (Gnomish Mines) at the ladder‑up position, equipped with a bow, 10 arrows, a stone pickaxe, and 5 torches. All survival needs are disabled and no mobs spawn naturally. The floor’s default lighting is pitch black (0.0). A single Gnome Archer (“ranged”, type_id=1) is placed 5–8 tiles from the start on walkable ground (BlockType.PATH). The agent must use torches to illuminate the area, locate the archer, avoid its projectiles, and shoot back until it is defeated. The floor‑clear requirement is set to 1, so the kill also unlocks the ladder down to Floor 3. This task forces the agent to combine projectile combat with active torch management under darkness, building skills essential for real Floor 2 progression.

    Relevant Achievements: DEFEAT_GNOME_ARCHER

    Completed Achievements: FIND_BOW, MAKE_ARROW, MAKE_TORCH, MAKE_STONE_PICKAXE

    World:
    - Player: Floor 2 (spawn at ladder‑up position). Inventory: {"bow": 1, "arrows": 10, "pickaxe": 1, "torch": 5}. Stats: Strength 1, Dexterity 1, Intelligence 1. Health/Food/Drink/Energy/Mana all full (9/9). Learned spells: none. Weapon/Armour enchantments: none.
    - Map:
        - Use default SmoothGen generation for Floor 2 (Gnomish Mines). This creates terrain of Path, Stone, Stalagmites, etc., and turns off all lighting (pitch black).
        - Place exactly one ranged mob of type Gnome Archer (“ranged”, type_id=1) using `add_mobs_randomly_near`, with target_pos = player spawn coordinates, n=1, min_dist=5, max_dist=8, on_blocks = [BlockType.PATH].
        - No other mobs are placed.
    - Mechanics:
        "needs_depletion_multiplier": 0.0,
        "melee_spawn_multiplier": 0.0,
        "ranged_spawn_multiplier": 0.0,
        "passive_spawn_multiplier": 0.0,
        "monsters_killed_to_clear_level": 1,
        "health_recover_multiplier": 1.0,
        "mob_health_multiplier": 1.0,
        "mob_damage_multiplier": 1.0
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.DEFEAT_GNOME_ARCHER]
        self.completed_achievements = [
            Achievement.FIND_BOW,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_TORCH,
            Achievement.MAKE_STONE_PICKAXE,
        ]
        self.label = "DEFEAT_GNOME_ARCHER"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            passive_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=1,
            health_recover_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, mob_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on Floor 2 (Gnomish Mines) at the ladder‑up position
        builder.set_starting_floor(2)

        # Equip player: bow, 10 arrows, stone pickaxe (stone = 2), 5 torches
        builder.set_player_inventory(
            {"bow": 1, "arrows": 10, "pickaxe": 2, "torches": 5}
        )

        # Place exactly one Gnome Archer near the player
        builder.add_mobs_randomly_near(
            mob_rng,
            level=2,
            mob_name="ranged",
            type_id=1,          # Gnome Archer
            n=1,
            target_pos=builder.player_position,
            min_dist=5,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        return builder.build(rng)</data>
