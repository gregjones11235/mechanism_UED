iamond": 7.947900053163211, "make_iron_pickaxe": 3.6948431685273793, "make_iron_sword": 4.412546517809676, "make_arrow": 23.391812865497077, "make_torch": 100.0, "place_torch": 73.07283359914939, "collect_sapphire": 6.45933014354067, "collect_ruby": 6.113769271664008, "make_diamond_pickaxe": 0.7708665603402446, "make_diamond_sword": 0.7177033492822966, "make_iron_armour": 0.1063264221158958, "enter_dungeon": 100.0, "defeat_orc_solider": 84.7953216374269, "defeat_orc_mage": 0.7442849548112705, "eat_snail": 10.047846889952153, "find_bow": 80.03721424774056, "fire_bow": 17.22488038277512, "open_chest": 80.03721424774056, "drink_potion": 10.89845826687932}, "average_episode_length": 76.16719829877725, "mean_return_percentage": 12.252765707258897, "mean_return": 27.691250498405104, "lp": NaN, "priority_score": 0.12892855921480112}, {"session": 28, "sr": 0.9170645446507516, "achievement_srs": {"collect_wood": 100.0, "place_table": 69.7789566755084, "eat_cow": 1.9805481874447393, "collect_sapling": 1.3262599469496021, "collect_drink": 11.529619805481875, "make_wood_pickaxe": 100.0, "make_wood_sword": 100.0, "place_plant": 1.1847922192749778, "defeat_zombie": 2.1573828470380194, "collect_stone": 2.2634836427939877, "place_stone": 2.1220159151193636, "eat_plant": 0.21220159151193635, "defeat_skeleton": 1.892130857648099, "wake_up": 2.1043324491600353, "place_furnace": 1.821396993810787, "collect_coal": 100.0, "collect_iron": 18.054818744473916, "collect_diamond": 8.452696728558797, "make_iron_pickaxe": 3.0592396109637487, "make_iron_sword": 3.165340406719717, "make_arrow": 24.73916887709991, "make_torch": 100.0, "place_torch": 91.2290008841733, "collect_sapphire": 7.17948717948718, "collect_ruby": 6.259946949602122, "make_diamond_pickaxe": 1.0079575596816976, "make_diamond_sword": 0.9549071618037135, "make_iron_armour": 0.05305039787798409, "enter_dungeon": 100.0, "defeat_orc_solider": 91.70645446507515, "defeat_orc_mage": 3.8373121131741823, "eat_snail": 14.288240495137046, "find_bow": 90.9814323607427, "fire_bow": 22.298850574712645, "open_chest": 90.9814323607427, "drink_potion": 11.918656056587091}, "average_episode_length": 50.280459770114945, "mean_return_percentage": 13.54145271433378, "mean_return": 30.60368313439434, "lp": NaN, "priority_score": 0.07605716559526123}]</data>
