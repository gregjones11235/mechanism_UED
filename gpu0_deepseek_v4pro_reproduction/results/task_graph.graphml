      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Train the agent to navigate the dark Gnomish Mines (floor 2), defeat hostile gnomes, and descend to the Sewers (floor 3).

Description: The agent starts on floor 2 (Gnomish Mines) at the Up‑Ladder location. The floor is generated with its default smooth‑gen terrain, including stalagmites, lava patches, ores, and total darkness (base light level 0.0). The agent is equipped with stone‑tier gear, a bow, a modest supply of arrows and torches, and a small stock of wood, stone, and coal. No additional terrain or block modifications are performed. The ladder down remains locked until the agent kills 8 hostile gnomes (Gnome Warriors and Gnome Archers). Passive bats are present but do not count toward the kill requirement. The agent must place torches to see, fight the gnomes, locate the natural ladder down, and use the DESCEND action while standing on it. This action triggers the ENTER_SEWERS achievement and ends the episode as a success. Survival needs are slightly reduced (`needs_depletion_multiplier = 0.5`) to keep focus on combat and darkness navigation.

Relevant Achievements: ENTER_SEWERS
Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_STONE_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_SWORD, FIND_BOW, ENTER_DUNGEON, ENTER_GNOMISH_MINES

World:
- Player:
  - Starting floor = 2.
  - Inventory: {"stone": 10, "wood": 10, "coal": 10, "torch": 10, "arrow": 10, "bow": 1, "pickaxe": 2, "sword": 2}.
  - Stats: dexterity = 1, strength = 1, intelligence = 1.
- Map:
  - No additional block placements; the default smooth‑gen level 2 is used.
- Mechanics:
  - `melee_spawn_multiplier = 1.0`
  - `ranged_spawn_multiplier = 1.0`
  - `passive_spawn_multiplier = 1.0`
  - `mob_health_multiplier = 1.0`
  - `mob_damage_multiplier = 1.0`
  - `needs_depletion_multiplier = 0.5`
  - `health_recover_multiplier = 1.0`
  - `health_loss_multiplier = 1.0`
  - `mana_recover_multiplier = 1.0`
  - `monsters_killed_to_clear_level = 8` (applies to floor 2; floor 0 and floor 1 are irrelevant because the agent starts on floor 2 and cannot backtrack)
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_SEWERS,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_SWORD,
            Achievement.FIND_BOW,
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.label = "ENTER_SEWERS"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            needs_depletion_multiplier=0.5,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            monsters_killed_to_clear_level=8,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines)
        builder.set_starting_floor(2)

        # Equip the specified inventory
        builder.set_player_inventory({
            "stone": 10,
            "wood": 10,
            "coal": 10,
            "torches": 10,
            "arrows": 10,
            "bow": 1,
            "pickaxe": 2,   # stone pickaxe
            "sword": 2,     # stone sword
        })

        # No additional blocks or mobs are placed; default world generation suffices
        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
