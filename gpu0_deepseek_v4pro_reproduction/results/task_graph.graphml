      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Robustify the agent’s ability to manage survival needs while clearing the Dungeon under full hostile mob spawn rates, in order to enter the Gnomish Mines reliably under original‑game difficulty.

Description: The agent begins on Floor 0 (Overworld) at the default spawn point. Its inventory contains only a Wood Pickaxe (pickaxe level 1) – **no wood, stone, or other resources**. All survival needs deplete at the normal full‑game rate (`needs_depletion_multiplier = 1.0`). Hostile mob spawn multipliers are now set to the original Craftax values: `melee_spawn_multiplier = 1.0` and `ranged_spawn_multiplier = 1.0`. Passive mobs (cows) spawn normally (`passive_spawn_multiplier = 1.0`). The Dungeon (Floor 1) requires the agent to defeat 8 hostile mobs (`monsters_killed_to_clear_level = 8`) before descending.

The complete chain is:
1. On the Overworld, gather at least 2 wood and 2 stone. Place a Crafting Table (cost 2 wood), then craft a Stone Sword (cost 1 wood, 1 stone) using the `MAKE_STONE_SWORD` action. The Wood Pickaxe already in inventory can harvest wood and stone. Be prepared to fight fully‑spawned Zombies and Skeletons.
2. Descend through the open Ladder Down to the Dungeon (Floor 1). Locate a chest to obtain a Bow (and optionally craft Arrows if needed; default dungeon generation provides wood blocks inside rooms).
3. While on Floor 1, defeat 8 Orc Soldiers and/or Orc Mages (both spawn with the full 1.0 multiplier). Use the Bow and Stone Sword as primary weapons.
4. After meeting the kill requirement, use the Ladder Down on Floor 1 to reach Floor 2 (Gnomish Mines), thereby unlocking the `ENTER_GNOMISH_MINES` achievement.

The increased mob pressure forces the agent to practise efficient combat, resource gathering, and survival under full‑threat conditions, directly preparing it for the original Craftax environment.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: MAKE_WOOD_PICKAXE

World:
- Player: Floor 0, center spawn. Inventory: {"pickaxe": 1}. All attributes at default (Strength 1, Dexterity 1, Intelligence 1). Health, Food, Drink, Energy, Mana all full (9/9). No bow, no spells, no enchantments.
- Map: No modifications; default Overworld and Dungeon generation (ladders, chests, trees, stone, etc. are all as per the standard game).
- Mechanics:
  "needs_depletion_multiplier": 1.0,
  "melee_spawn_multiplier": 1.0,
  "ranged_spawn_multiplier": 1.0,
  "passive_spawn_multiplier": 1.0,
  "monsters_killed_to_clear_level": 8,
  "mob_health_multiplier": 1.0,
  "mob_damage_multiplier": 1.0,
  "health_recover_multiplier": 1.0,
  "health_loss_multiplier": 1.0
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            monsters_killed_to_clear_level=8,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld) at default center spawn
        builder.set_starting_floor(0)

        # Starting inventory: only a wood pickaxe (level 1)
        builder.set_player_inventory({"pickaxe": 1})

        # No map modifications; all levels use default procedural generation
        state = builder.build(rng)

        # Mark pre-completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
