nail": 100.0, "find_bow": 99.609375, "fire_bow": 88.28125, "open_chest": 99.609375, "drink_potion": 93.75}, "average_episode_length": 1067.8203125, "mean_return_percentage": 21.571588094255564, "mean_return": 48.75178909301758, "lp": NaN, "priority_score": 0.247802734375}]</data>
