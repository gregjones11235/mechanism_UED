      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Train the agent to start from nothing, survive, craft equipment, enter the Dungeon, defeat orcs, and reach the Gnomish Mines under **full original Craftax difficulty** – no more relaxed needs or reduced mob damage.

Description:
The agent spawns on floor 0 (Overworld) with an empty inventory (no tools, no torches, no resources) and all attributes at 1. It must gather wood by punching trees, place a crafting table, craft a wood pickaxe, mine stone, craft a stone pickaxe and stone sword (optionally upgrade to iron), collect coal and iron to craft arrows (if desired), find a bow from a chest or skeleton, then locate and descend the Dungeon ladder (floor 1). On floor 1, the agent must defeat any combination of Orc Soldiers and Orc Mages until it reaches a kill count of **8**, then stand on the ladder descending to floor 2 (Gnomish Mines).

Crucially, all survival and combat parameters are at their **original values**: hunger, thirst, and fatigue accumulate at the standard rate (needs_depletion_multiplier = 1.0), mobs deal full damage (mob_damage_multiplier = 1.0), and health/mana regeneration are at default speeds. The floor‑0 ladder remains pre‑unlocked by the game’s default rules (no kills needed on floor 0). The task terminates successfully only when ENTER_GNOMISH_MINES is achieved.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: (none)

World:
- Player: Starts on floor 0 with inventory completely empty (all item counts = 0). Armour slots empty, weapon enchantments 0, armour enchantments all 0. Attributes: strength = 1, dexterity = 1, intelligence = 1. Status bars: health 9/9, food 9/9, drink 9/9, energy 9/9, mana 9/9. Learned spells: fireball = False, iceball = False. No manual changes to player position.
- Map: No manual block modifications. All nine levels use their default procedural generation. The floor‑0 ladder down is pre‑unlocked (default behaviour).
- Mechanics:
  - monsters_killed_to_clear_level = 8
  - needs_depletion_multiplier = 1.0
  - mob_damage_multiplier = 1.0
  - health_recover_multiplier = 1.0
  - health_loss_multiplier = 1.0
  - mana_recover_multiplier = 1.0
  - melee_spawn_multiplier = 1.0
  - ranged_spawn_multiplier = 1.0
  - passive_spawn_multiplier = 1.0
  - All other TaskParams at their default values.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = []  # none
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
            needs_depletion_multiplier=1.0,
            mob_damage_multiplier=1.0,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)
        # Start on floor 0 (Overworld) with default position
        builder.set_starting_floor(0)

        # No inventory or stat modifications: empty inventory, stats=1 (default)

        state = builder.build(rng)

        # No pre-completed achievements to set
        return state</data>
