      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
	"""Objective: Learn to explore the overworld, survive light combat, and descend into the Dungeon.

	Description: The player starts on Floor 0 (Overworld) with a stone sword (`inventory.sword = 2`) and a stone pickaxe (`inventory.pickaxe = 2`), but no other items. All survival needs (hunger, thirst, fatigue) are frozen (`needs_depletion_multiplier = 0.0`), so the agent can focus purely on movement and combat. Melee and ranged spawn rates are halved (`melee_spawn_multiplier = 0.5`, `ranged_spawn_multiplier = 0.5`), reducing encounter frequency. Health recovery is set to 2× normal (`health_recover_multiplier = 2.0`) to keep fights forgiving. The only goal is to find the procedurally placed ladder down and descend, triggering the `ENTER_DUNGEON` achievement. No other achievements are required for success.

	Relevant Achievements: ENTER_DUNGEON
	Completed Achievements: MAKE_STONE_SWORD, MAKE_STONE_PICKAXE
	World:
	- Player:
	  - Starting floor: 0
	  - Inventory: `{"sword": 2, "pickaxe": 2}`
	- Map: No modifications to the default Overworld map.
	- Mechanics:
	  - needs_depletion_multiplier = 0.0
	  - health_recover_multiplier = 2.0
	  - melee_spawn_multiplier = 0.5
	  - ranged_spawn_multiplier = 0.5
	  - All other TaskParams remain at default values.
	"""

	def __init__(self, static_params: StaticEnvParams, params: EnvParams):
		super().__init__(static_params, params)
		self.relevant_achievements = [Achievement.ENTER_DUNGEON]
		self.completed_achievements = [
			Achievement.MAKE_STONE_SWORD,
			Achievement.MAKE_STONE_PICKAXE,
		]
		self.label = "ENTER_DUNGEON"

	def get_task_params(self) -&gt; TaskParams:
		"""Return custom parameters for this task."""
		return TaskParams(
			needs_depletion_multiplier=0.0,
			health_recover_multiplier=2.0,
			melee_spawn_multiplier=0.5,
			ranged_spawn_multiplier=0.5,
		)

	def generate_world(self, rng: jax.Array) -&gt; EnvState:
		"""Generates the world for the task."""
		rng, build_rng = jax.random.split(rng)

		builder = WorldBuilder(build_rng, self.static_params, self.params)
		builder.set_starting_floor(0)
		# Give stone tools: 2 = stone sword, 2 = stone pickaxe
		builder.set_player_inventory({"sword": 2, "pickaxe": 2})

		return builder.build(rng)</data>
