      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to craft an Iron Sword on the overworld using coal and iron, then defeat a few hostile mobs to unlock and perform the first descent into the Dungeon.

Description: The agent begins on Floor 0 (Overworld) at the default spawn location, with an inventory containing a stone pickaxe, 5 wood, and 5 stone. All other attributes are standard (9 health, 9 food, 9 drink, 9 energy, 9 mana, no enchantments, no learned spells). The ladder‑down to the Dungeon is present but locked; it becomes usable only after the agent kills 3 hostile mobs (melee or ranged) on this floor. The task requires the agent to craft an Iron Sword and then descend to Floor 1, thereby earning MAKE_IRON_SWORD and ENTER_DUNGEON. Survival mechanics remain at standard rates, and mob spawn parameters are unchanged. To guarantee the agent can practice the critical crafting step without excessive exploration, small clusters of coal and iron ore are placed near the starting area.

Relevant Achievements: MAKE_IRON_SWORD, ENTER_DUNGEON

Completed Achievements: MAKE_STONE_PICKAXE, COLLECT_WOOD, COLLECT_STONE (these are implicitly satisfied by the initial inventory; no corresponding actions are required during the episode).

World:
- Player:
  - Starting floor = 0 (default)
  - Inventory: `{"stone_pickaxe": 1, "wood": 5, "stone": 5}`
  - All other attributes at default values.
- Map:
  - Place 5 coal blocks randomly near the player on floor 0, within Manhattan distance 3–12, on stone blocks:
    `builder.place_randomly_near(rng, 0, BlockType.COAL, builder.player_position, 3, 12, 5, [BlockType.STONE])`
  - Place 3 iron blocks randomly near the player on floor 0, within Manhattan distance 3–12, on stone blocks:
    `builder.place_randomly_near(rng, 0, BlockType.IRON, builder.player_position, 3, 12, 3, [BlockType.STONE])`
  - Monsters killed on floor 0 set to 0: `builder.set_monsters_killed(level=0, count=0)`
- Mechanics:
  - `monsters_killed_to_clear_level = 3`
  - All other TaskParams multipliers (passive_spawn_multiplier, melee_spawn_multiplier, ranged_spawn_multiplier, mob_health_multiplier, mob_damage_multiplier, needs_depletion_multiplier, health_recover_multiplier, health_loss_multiplier, mana_recover_multiplier) remain at their defaults of 1.0.
  - `melee_trigger_distance`, `growing_plants_age` left at defaults.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.MAKE_IRON_SWORD,
            Achievement.ENTER_DUNGEON,
        ]
        self.completed_achievements = [
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.COLLECT_WOOD,
            Achievement.COLLECT_STONE,
        ]
        self.label = "MAKE_IRON_SWORD, ENTER_DUNGEON"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=3,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, coal_rng, iron_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld)
        builder.set_starting_floor(0)

        # Equip starting inventory: stone pickaxe, wood, stone
        builder.set_player_inventory({
            "pickaxe": 2,      # stone pickaxe (tier 2)
            "wood": 5,
            "stone": 5,
        })

        # Place coal and iron near the player to ease crafting
        spawn_pos = builder.player_position
        builder.place_randomly_near(
            coal_rng, 0, BlockType.COAL,
            target_pos=spawn_pos,
            min_dist=3, max_dist=12,
            n=5,
            on_blocks=[BlockType.STONE],
        )
        builder.place_randomly_near(
            iron_rng, 0, BlockType.IRON,
            target_pos=spawn_pos,
            min_dist=3, max_dist=12,
            n=3,
            on_blocks=[BlockType.STONE],
        )

        # Reset monsters killed on floor 0 to 0 (ladder down locked)
        builder.set_monsters_killed(level=0, count=0)

        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
