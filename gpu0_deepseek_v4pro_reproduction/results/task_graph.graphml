 "make_stone_pickaxe": 95.30595138306789, "make_stone_sword": 86.00167644593462, "wake_up": 75.77535624476111, "place_furnace": 95.0544844928751, "collect_coal": 85.24727577535624, "collect_iron": 10.05867560771165, "collect_diamond": 5.699916177703269, "make_iron_pickaxe": 2.095557418273261, "make_iron_sword": 2.2632020117351215, "make_arrow": 87.92958927074602, "make_torch": 83.7384744341995, "place_torch": 66.63872590108969, "collect_sapphire": 3.4367141659681475, "collect_ruby": 3.1014249790444257, "make_diamond_pickaxe": 0.7544006705783739, "make_diamond_sword": 0.5029337803855826, "enter_dungeon": 44.92875104777871, "defeat_orc_solider": 5.448449287510478, "defeat_orc_mage": 1.0058675607711651, "eat_snail": 12.238055322715843, "find_bow": 44.3419949706622, "fire_bow": 33.78038558256496, "open_chest": 44.3419949706622, "drink_potion": 10.226320201173513}, "average_episode_length": 236.9547359597653, "mean_return_percentage": 18.132253897180455, "mean_return": 40.97889380762783, "lp": NaN, "priority_score": 0.044737076927508786}]</data>
