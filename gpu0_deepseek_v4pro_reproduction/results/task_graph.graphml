      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to explore the Gnomish Mines (Floor 2) and defeat its mobs to unlock the ladder down and enter the Sewers (Floor 3).

Description: The agent begins on Floor 2 (Gnomish Mines) with a stone sword (level 2), stone pickaxe (level 2), 20 wood, 20 stone, 10 coal, and 10 torches. The kill counters for Floor 0 and Floor 1 are pre-set to 5 (already cleared), so the ladders from those levels are irrelevant. The kill counter for Floor 2 is reset to 0; the ladder down to the Sewers remains locked until 5 hostile mobs are defeated. Floor 2 is dark (light level 0.0), so the agent must place torches to navigate. Both melee Gnome Warriors (`mob_name="melee", type_id=1`) and ranged Gnome Archers (`mob_name="ranged", type_id=1`) spawn, with archers appearing at a reduced rate (0.3×). Survival pressure is minimal (needs depletion 0.25×, health recovery 2.0×) to keep the focus on darkness navigation, combat, and finding the ladder. The ladder down appears only where the default smooth‑gen generation places it, requiring full exploration. The agent must locate the ladder, kill the required number of gnomes, and descend to earn the ENTER_SEWERS achievement.

Relevant Achievements: ENTER_SEWERS

Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_STONE_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_SWORD, COLLECT_WOOD, COLLECT_STONE, COLLECT_COAL, ENTER_DUNGEON, ENTER_GNOMISH_MINES

World:
- Player: Starting floor = 2. Inventory: `{"pickaxe": 2, "sword": 2, "wood": 20, "stone": 20, "coal": 10, "torch": 10}`. All stats = 1. `set_monsters_killed(level=0, count=5)`; `set_monsters_killed(level=1, count=5)`; `set_monsters_killed(level=2, count=0)`.
- Map: No additional block placements. The ladder on Floor 2 will be present at its default, randomly generated location.
- Mechanics:
  - `monsters_killed_to_clear_level = 5` (global, applies to all floors)
  - `melee_spawn_multiplier = 1.0`
  - `ranged_spawn_multiplier = 0.3`
  - `passive_spawn_multiplier = 0.3`
  - `mob_health_multiplier = 1.0`
  - `mob_damage_multiplier = 1.0`
  - `needs_depletion_multiplier = 0.25`
  - `health_recover_multiplier = 2.0`
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_SEWERS]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_SWORD,
            Achievement.COLLECT_WOOD,
            Achievement.COLLECT_STONE,
            Achievement.COLLECT_COAL,
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.label = "ENTER_SEWERS"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=5,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=0.3,
            passive_spawn_multiplier=0.3,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            needs_depletion_multiplier=0.25,
            health_recover_multiplier=2.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        builder = WorldBuilder(rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines)
        builder.set_starting_floor(2)

        # Set up player inventory: stone tools and supplies
        builder.set_player_inventory({
            "pickaxe": 2,
            "sword": 2,
            "wood": 20,
            "stone": 20,
            "coal": 10,
            "torches": 10,
        })

        # Set pre-cleared kill counts for earlier floors and reset floor 2
        builder.set_monsters_killed(level=0, count=5)
        builder.set_monsters_killed(level=1, count=5)
        builder.set_monsters_killed(level=2, count=0)

        # No manual block or mob placements – rely on default generation

        return builder.build(rng)</data>
