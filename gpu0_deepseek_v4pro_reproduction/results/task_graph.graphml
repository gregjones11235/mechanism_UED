      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Harden floor 1 combat endurance by descending into the Gnomish Mines under full game spawn intensity, while keeping the kill requirement at 7 to ensure learnability.

Description: The agent begins on floor 1 (the Dungeon) with a stone sword (tier 2) already equipped. Hostile mob spawns now occur at the standard (100 %) rates (`melee_spawn_multiplier = 1.0`, `ranged_spawn_multiplier = 1.0`), matching the full game’s enemy density. Passive snails still spawn at `passive_spawn_multiplier = 1.0`. The floor‑clearing condition remains `monsters_killed_to_clear_level = 7`—the agent must defeat at least seven Orc Soldiers or Orc Mages before the down ladder unlocks. Once the required kills are achieved, locating and stepping onto the ladder triggers the `ENTER_GNOMISH_MINES` achievement, which ends the episode as a success. All other mechanics (needs depletion, health/mana regeneration, mob damage/health) stay at their default values. This task progressively escalates combustion pressure by removing the previous half‑spawn crutch, directly preparing the agent for the transition to the full‑game 8‑kill requirement while keeping the kill count attainable.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: ENTER_DUNGEON, MAKE_STONE_SWORD
World:
- Player: Starts on floor 1. Inventory: `{"sword": 2}` (stone sword). All attributes and status bars at default (STR 1, DEX 1, INT 1; health/food/drink/energy/mana all 9/9).
- Map: No modifications. The dungeon layout is generated by the default procedure.
- Mechanics: `passive_spawn_multiplier = 1.0`, `melee_spawn_multiplier = 1.0`, `ranged_spawn_multiplier = 1.0`, `monsters_killed_to_clear_level = 7`. All other `TaskParams` at their default values (e.g., `melee_trigger_distance = 10`, `needs_depletion_multiplier = 1.0`, etc.).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.MAKE_STONE_SWORD,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=7,
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon)
        builder.set_starting_floor(1)

        # Equip stone sword (tier 2)
        builder.set_player_inventory({
            "sword": 2,
        })

        # No map modifications; default dungeon generation is sufficient.

        state = builder.build(rng)

        # Mark pre-completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
