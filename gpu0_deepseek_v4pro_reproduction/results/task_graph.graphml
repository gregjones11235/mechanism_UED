      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to enter the dungeon and descend to the Gnomish Mines after preparing essential equipment from scratch on the Overworld.

Description:
The agent starts on floor 0 (the Overworld) with completely empty inventory and base attributes (strength=1, dexterity=1, intelligence=1). All status bars are full (health, food, drink, energy, mana at 9/9). No weapons, armour, tools, spells, or potions are provided. The agent’s task is to:
  1) Gather wood and stone, place a crafting table, craft a wood pickaxe, mine stone, craft a stone sword and arrows, and optionally craft torches to navigate the dark dungeon.
  2) Locate the ladder down on the Overworld (no kill requirement; the ladder is open by default on floor 0) and descend to floor 1 (ENTER_DUNGEON).
  3) On floor 1 (the Dungeon), defeat 8 hostile monsters (orc soldiers and/or orc mages) to unlock the ladder down, then descend to floor 2 (ENTER_GNOMISH_MINES). The agent may find and use a bow from a chest, as in the parent task, to safely engage ranged enemies.
Survival mechanics are active at 75% normal speed to keep basal pressure but not distract from the core progression.

Relevant Achievements: ENTER_DUNGEON, ENTER_GNOMISH_MINES
Completed Achievements: (none)
World:
- Player:
  - Starting floor: 0
  - Inventory: empty (all counts zero). No weapons, armour, torches, or arrows.
  - Attributes: strength=1, dexterity=1, intelligence=1.
  - Status bars: health=9, food=9, drink=9, energy=9, mana=9.
  - Enchantments: sword=0, bow=0, armour slots all 0.
  - Learned spells: fireball=False, iceball=False.
- Map: No manual block modifications; the default Overworld (floor 0) and all subsequent floors are used exactly as generated by the standard Craftax world builder (smooth‑gen terrain with trees, stone, coal, iron, water, lava, etc.).
- Mechanics:
  - monsters_killed_to_clear_level = 8
  - needs_depletion_multiplier = 0.75
  - All other TaskParams remain at their default values (mob_damage_multiplier=1.0, melee_spawn_multiplier=1.0, ranged_spawn_multiplier=1.0, passive_spawn_multiplier=1.0, mob_health_multiplier=1.0, melee_trigger_distance=10, health_recover_multiplier=1.0, health_loss_multiplier=1.0, mana_recover_multiplier=1.0, growing_plants_age=600).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = []  # none
        self.label = "ENTER_DUNGEON, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
            needs_depletion_multiplier=0.75,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld)
        builder.set_starting_floor(0)

        # Inventory is empty by default; no weapons, tools, or consumables
        # No map modifications required; default generation handles everything

        state = builder.build(rng)

        # No pre‑completed achievements to mark
        return state</data>
