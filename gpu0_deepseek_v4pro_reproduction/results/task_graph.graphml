      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Teach the agent to clear the Dungeon (Floor 1) by defeating a larger group of orc soldiers and mages, then descend to the Gnomish Mines.

Description: This task builds directly on the parent by requiring the agent to kill 5 hostile monsters on Floor 1 instead of 3. All other conditions are identical. The agent starts on Floor 1 at the up‑ladder position, equipped with an iron sword. The dungeon layout uses standard procedural generation, including random chests, snails, and other features. The agent must explore, engage multiple orc soldiers and mages, and when 5 kills have been achieved, perform the DESCEND action while standing on the ladder down. Survival needs deplete at 0.2× their normal rate so that hunger/thirst do not interfere with combat training. The goal is to extend combat persistence and exploration depth, directly bridging the gap to the full game’s requirement of clearing Floor 1.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: MAKE_IRON_SWORD, ENTER_DUNGEON

World:
- Player: `builder.set_starting_floor(1)`.
  Inventory: `{"sword": 3}` (iron sword). All other attributes default.
- Map:
  - `builder.set_monsters_killed(level=1, count=0)` to reset the Floor 1 kill counter.
  - No other block modifications; the default dungeon generation is preserved.
- Mechanics:
  - `monsters_killed_to_clear_level = 5`
  - `mob_health_multiplier = 1.0`
  - `mob_damage_multiplier = 1.0`
  - `melee_spawn_multiplier = 1.0`
  - `ranged_spawn_multiplier = 1.0`
  - `passive_spawn_multiplier = 1.0`
  - `needs_depletion_multiplier = 0.2`
  - `health_recover_multiplier = 1.0`
  - `health_loss_multiplier = 1.0`
  - `mana_recover_multiplier = 1.0`
  - `growing_plants_age = 600`
  - All other parameters left at default.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_IRON_SWORD,
            Achievement.ENTER_DUNGEON,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=5,
            needs_depletion_multiplier=0.2,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Equip iron sword (tier 3)
        builder.set_player_inventory({"sword": 3})

        # Reset the Floor 1 kill counter to 0 to ensure the ladder is locked
        builder.set_monsters_killed(level=1, count=0)

        # Build the initial state
        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
