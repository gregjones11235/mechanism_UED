      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Scale up Floor 1 combat to reliably defeat multiple orcs and descend to Floor 2, bridging the gap between the overfitted single‑encounter training and the full game’s enemy density.

Description: The agent spawns on Floor 1 (Dungeon) with a stone sword, stone pickaxe, and a modest supply of wood and stone. This time, five hostile mobs are pre‑placed near the spawn: three Orc Soldiers (melee, type_id=2) and two Orc Mages (ranged, type_id=2). The floor‑clear requirement is set to exactly 5 kills, so the agent must defeat all five enemies to unlock the ladder down. Survival needs remain fully active (hunger, thirst, energy depletion, health loss) with passive snail spawning as a food source and fountains for water. All hostile spawn multipliers are zero, preventing any additional reinforcements. The agent must use its stone weapon, explore the dungeon rooms and corridors, engage the orcs, and then locate the ladder, stand on it, and execute DESCEND. The objective is to force generalisation of Floor 1 combat skills by demanding sustained fighting against a larger enemy group.

Relevant Achievements: DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, ENTER_GNOMISH_MINES

Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD

World:
- Player: Floor 1 (spawn at the ladder‑up position). Inventory: {"sword": 1, "pickaxe": 1, "wood": 5, "stone": 5}. All stats default (Strength 1, Dexterity 1, Intelligence 1; Health/Food/Drink/Energy/Mana all 9/9). No spells learned, no enchantments.
- Map:
    - Use default Dungeon generation for Floor 1 (rooms, corridors, chests, fountains, torches).
    - Place three melee mobs: Orc Soldier (mob_name="melee", type_id=2) via `add_mobs_randomly_near` with target_pos = player spawn, n=3, min_dist=2, max_dist=8, on any walkable terrain.
    - Place two ranged mobs: Orc Mage (mob_name="ranged", type_id=2) via `add_mobs_randomly_near` with target_pos = player spawn, n=2, min_dist=2, max_dist=8, on any walkable terrain.
- Mechanics:
    - needs_depletion_multiplier = 1.0
    - passive_spawn_multiplier = 1.0
    - melee_spawn_multiplier = 0.0
    - ranged_spawn_multiplier = 0.0
    - monsters_killed_to_clear_level = 5
    - health_recover_multiplier = 1.0
    - health_loss_multiplier = 1.0
    - mana_recover_multiplier = 1.0
    - mob_health_multiplier = 1.0
    - mob_damage_multiplier = 1.0
    - melee_trigger_distance = 10
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.DEFEAT_ORC_SOLIDER,
            Achievement.DEFEAT_ORC_MAGE,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
        ]
        self.label = "DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=5,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            melee_trigger_distance=10,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, melee_rng, ranged_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Equip stone sword (tier 2), stone pickaxe (tier 2), wood and stone resources
        builder.set_player_inventory({
            "sword": 2,      # stone sword
            "pickaxe": 2,    # stone pickaxe
            "wood": 5,
            "stone": 5,
        })

        # Pre-place 3 Orc Soldiers (melee, type_id=2) near the player spawn
        builder.add_mobs_randomly_near(
            melee_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=3,
            target_pos=builder.player_position,
            min_dist=2,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        # Pre-place 2 Orc Mages (ranged, type_id=2) near the player spawn
        builder.add_mobs_randomly_near(
            ranged_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=2,
            target_pos=builder.player_position,
            min_dist=2,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        # Build the base state
        state = builder.build(rng)

        # Mark pre-completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
