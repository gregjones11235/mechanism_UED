8, "eat_plant": 5.7441253263707575, "defeat_skeleton": 28.45953002610966, "make_stone_pickaxe": 44.38642297650131, "make_stone_sword": 100.0, "wake_up": 81.72323759791122, "place_furnace": 45.16971279373368, "collect_coal": 66.57963446475196, "collect_iron": 62.66318537859008, "collect_diamond": 34.72584856396867, "make_iron_pickaxe": 25.326370757180158, "make_arrow": 75.1958224543081, "make_torch": 93.47258485639686, "place_torch": 91.90600522193212, "collect_sapphire": 28.45953002610966, "collect_ruby": 26.109660574412533, "make_diamond_pickaxe": 7.310704960835509, "make_diamond_sword": 4.960835509138382, "enter_gnomish_mines": 70.23498694516971, "enter_dungeon": 100.0, "defeat_orc_solider": 97.65013054830287, "defeat_orc_mage": 90.86161879895562, "eat_snail": 95.30026109660574, "find_bow": 99.47780678851174, "fire_bow": 73.62924281984334, "open_chest": 99.47780678851174, "drink_potion": 82.76762402088772}, "average_episode_length": 762.8694516971279, "mean_return_percentage": 21.51443973982763, "mean_return": 48.62263381201044, "lp": NaN, "priority_score": 0.20905453033288116}]</data>
