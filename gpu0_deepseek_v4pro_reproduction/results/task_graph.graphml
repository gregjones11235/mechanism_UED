": 8.16326530612245, "place_furnace": 83.38192419825073, "collect_coal": 36.15160349854227, "collect_iron": 32.94460641399417, "collect_diamond": 16.034985422740526, "make_iron_pickaxe": 21.865889212827987, "make_iron_sword": 23.9067055393586, "make_arrow": 91.83673469387755, "make_torch": 64.1399416909621, "place_torch": 62.68221574344023, "collect_sapphire": 16.3265306122449, "collect_ruby": 12.244897959183673, "make_diamond_pickaxe": 2.3323615160349855, "make_diamond_sword": 4.081632653061225, "make_iron_armour": 11.661807580174926, "enter_dungeon": 100.0, "defeat_orc_solider": 86.88046647230321, "defeat_orc_mage": 74.05247813411079, "find_bow": 92.12827988338192, "fire_bow": 86.88046647230321, "open_chest": 92.12827988338192, "drink_potion": 48.97959183673469}, "average_episode_length": 982.0408163265306, "mean_return_percentage": 16.76410413347545, "mean_return": 37.886875341654516, "lp": NaN, "priority_score": 0.21011653307720424}]</data>
