      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Chain the early‐game crafting sequence of making a stone sword, entering the Dungeon, and defeating an Orc Mage – teaching the agent to handle a ranged threat that kites and shoots projectiles.

Description:
The agent starts on floor 0 (Overworld) with an empty inventory and default stats (STR 1, DEX 1, INT 1; all needs maxed). No hostile mobs spawn anywhere (melee and ranged spawn multipliers set to 0.0). The overworld uses the standard generation rules for trees, stone, coal, iron, and other resources. The dungeon (floor 1) contains exactly one Orc Mage (ranged, type_id=2) placed randomly at a Manhattan distance of 1–3 from the floor’s up‐ladder, guaranteeing a quick ranged encounter after descending. The ladder down on floor 0 is open from the start (0 kills required). The episode terminates in success only when all three achievements – `MAKE_STONE_SWORD`, `ENTER_DUNGEON`, and `DEFEAT_ORC_MAGE` – have been obtained. The task provides exactly one learning pressure: the agent must craft a stone sword, descend, and then close distance on a kiting ranged mob to defeat it with melee, while dodging incoming projectiles.

Relevant Achievements: MAKE_STONE_SWORD, ENTER_DUNGEON, DEFEAT_ORC_MAGE
Completed Achievements: (none)
World:
- Player: Start on floor 0. Inventory empty. Stats default.
- Map: On floor 1, add one Orc Mage (`mob_name="ranged"`, `type_id=2`) randomly within a Manhattan distance of 1–3 from the up‑ladder position.
- Mechanics:
    * `passive_spawn_multiplier = 1.0`
    * `melee_spawn_multiplier = 0.0`
    * `ranged_spawn_multiplier = 0.0`
    * `monsters_killed_to_clear_level` set to 0
    * All other `TaskParams` at default.
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.MAKE_STONE_SWORD,
            Achievement.ENTER_DUNGEON,
            Achievement.DEFEAT_ORC_MAGE,
        ]
        self.completed_achievements = []
        self.label = "MAKE_STONE_SWORD, ENTER_DUNGEON, DEFEAT_ORC_MAGE"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, mob_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(0)

        # The up-ladder on floor 1 is where the player appears after descending.
        up_ladder_pos = builder.ladders_up[1]

        # Place one Orc Mage (ranged, type_id=2) near that ladder on floor 1.
        builder.add_mobs_randomly_near(
            mob_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=1,
            target_pos=up_ladder_pos,
            min_dist=1,
            max_dist=3,
            on_blocks=[BlockType.PATH],
        )

        return builder.build(rng)</data>
