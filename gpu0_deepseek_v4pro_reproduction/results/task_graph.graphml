      <data key="d3">import jax
import jax.numpy as jnp
from craftax.craftax.constants import Achievement, BlockType, ItemType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Descend from the dark Gnomish Mines into the Sewers using only melee combat and torch light, without any possibility of ranged weapons.

Description: The agent begins on floor 2 (Gnomish Mines) at the Up‑Ladder position, equipped with a stone sword and 15 torches. No other items are provided. The environment is pitch black (default lighting for floor 2), forcing the agent to place torches to see. Survival needs (hunger, thirst, fatigue) are completely frozen so that the agent can focus entirely on combat and progression without starvation pressure. The only hostile mobs are Gnome Warriors (melee) and Gnome Archers (ranged), which spawn and behave with standard damage and health. The level must be cleared by defeating 4 hostile mobs; once done, the Ladder Down activates. The agent must stand on the ladder and descend, triggering ENTER_SEWERS, which immediately ends the task successfully. There are no chests, trees, or any source of wood on this floor, making it impossible to craft a bow, arrows, or a crafting table. Thus, the agent is forced to engage every enemy in melee, learning positioning, timing, and light conservation against new opponents.

Relevant Achievements: ENTER_SEWERS
Completed Achievements: MAKE_STONE_SWORD

World:
- Player: Starts on floor 2 (Gnomish Mines). Inventory: stone_sword=1, torch=15. All other inventory slots empty. Attributes: strength=1, dexterity=1, intelligence=1. Health/Food/Drink/Energy/Mana all 9/9. Enchantments and spells as default (none).
- Map: 
  - Place 5 BlockType.TORCH randomly within a Manhattan distance of 3 from the player's starting position (the Up‑Ladder) to provide initial ambient light. 
  - No other manual block modifications; the level uses default Gnomish Mines generation (stone, path, stalagmites, ladders, etc.).
- Mechanics:
  - monsters_killed_to_clear_level = 4 (applies globally; floors 0 and 1 are pre‑cleared by setting their monster kill counts to 10)
  - needs_depletion_multiplier = 0.0
  - mob_damage_multiplier = 1.0
  - mob_health_multiplier = 1.0
  - melee_spawn_multiplier = 1.0
  - ranged_spawn_multiplier = 1.0
  - passive_spawn_multiplier = 0.0 (no passive mobs on this floor anyway)
  - health_recover_multiplier = 1.0
  - health_loss_multiplier = 1.0
  - mana_recover_multiplier = 1.0
  - All other TaskParams at default.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_SEWERS,
        ]
        self.completed_achievements = [
            Achievement.MAKE_STONE_SWORD,
        ]
        self.label = "ENTER_SEWERS"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=4,
            needs_depletion_multiplier=0.0,
            mob_damage_multiplier=1.0,
            mob_health_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=0.0,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, torch_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines) at the up-ladder position
        builder.set_starting_floor(2)

        # Equip stone sword and torches
        builder.set_player_inventory({
            "sword": 2,      # stone sword = tier 2
            "torches": 15,
        })

        # Pre-clear floors 0 and 1 by setting their kill counts to 10
        builder.set_monsters_killed(level=0, count=10)
        builder.set_monsters_killed(level=1, count=10)

        # Place 5 torches within Manhattan distance 3 of the spawn (the ladder-up position)
        player_start = builder.player_position
        level = 2

        # Create a mask of positions within Manhattan distance ≤ 3
        rows, cols = jnp.indices(self.static_params.map_size, dtype=jnp.int32)
        dist_map = jnp.abs(rows - player_start[0]) + jnp.abs(cols - player_start[1])
        valid_mask = dist_map &lt;= 3

        # Randomly select 5 distinct positions from the valid mask
        valid_logits = jax.random.uniform(torch_rng, shape=self.static_params.map_size)
        masked_logits = jnp.where(valid_mask, valid_logits, -jnp.inf)
        flat_indices = jnp.argsort(masked_logits.flatten())
        selected_indices = flat_indices[-5:]   # 5 largest scores
        torch_rows = selected_indices // self.static_params.map_size[1]
        torch_cols = selected_indices % self.static_params.map_size[1]

        # Write the torch items directly into the level's item map
        item_map = builder.item_map.at[level, torch_rows, torch_cols].set(ItemType.TORCH.value)
        builder.item_map = item_map

        state = builder.build(rng)

        # Mark completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
