": 100.0, "defeat_orc_solider": 66.2020905923345, "defeat_orc_mage": 61.32404181184669, "eat_snail": 73.5191637630662, "find_bow": 93.72822299651568, "fire_bow": 44.94773519163763, "open_chest": 93.72822299651568, "drink_potion": 55.400696864111495}, "average_episode_length": 1436.5400696864112, "mean_return_percentage": 15.354910352941628, "mean_return": 34.70209739764808, "lp": NaN, "priority_score": 0.2371766077043548}, {"session": 84, "sr": 0.6271186440677966, "achievement_srs": {"collect_wood": 27.796610169491526, "place_table": 26.440677966101696, "eat_cow": 30.508474576271187, "collect_sapling": 26.440677966101696, "collect_drink": 50.16949152542373, "place_plant": 26.440677966101696, "collect_stone": 27.11864406779661, "place_stone": 27.11864406779661, "eat_plant": 17.627118644067796, "make_stone_pickaxe": 27.796610169491526, "wake_up": 33.559322033898304, "place_furnace": 27.11864406779661, "collect_coal": 41.016949152542374, "collect_iron": 43.05084745762712, "collect_diamond": 18.305084745762713, "make_iron_pickaxe": 23.728813559322035, "make_iron_sword": 25.423728813559322, "make_arrow": 50.50847457627118, "make_torch": 69.15254237288136, "place_torch": 69.15254237288136, "collect_sapphire": 18.305084745762713, "collect_ruby": 17.627118644067796, "make_diamond_pickaxe": 2.0338983050847457, "make_diamond_sword": 4.067796610169491, "enter_dungeon": 100.0, "defeat_orc_solider": 71.86440677966101, "defeat_orc_mage": 62.71186440677966, "eat_snail": 74.91525423728814, "find_bow": 94.23728813559322, "fire_bow": 48.813559322033896, "open_chest": 94.23728813559322, "drink_potion": 54.23728813559322}, "average_episode_length": 1390.3830508474575, "mean_return_percentage": 15.943454292129145, "mean_return": 36.032206700211866, "lp": NaN, "priority_score": 0.23384085033036484}]</data>
