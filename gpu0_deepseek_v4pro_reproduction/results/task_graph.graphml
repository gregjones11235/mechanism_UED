mbie": 79.58115183246073, "collect_stone": 95.81151832460733, "place_stone": 95.81151832460733, "eat_plant": 36.12565445026178, "defeat_skeleton": 72.77486910994764, "make_stone_pickaxe": 93.717277486911, "make_stone_sword": 95.28795811518324, "wake_up": 100.0, "place_furnace": 95.81151832460733, "collect_coal": 93.19371727748691, "collect_iron": 88.48167539267016, "collect_diamond": 29.842931937172775, "make_iron_pickaxe": 45.026178010471206, "make_iron_sword": 83.7696335078534, "make_arrow": 95.28795811518324, "make_torch": 94.24083769633508, "place_torch": 93.717277486911, "collect_sapphire": 24.607329842931936, "collect_ruby": 25.130890052356023, "make_diamond_pickaxe": 3.141361256544503, "make_diamond_sword": 4.18848167539267, "make_iron_armour": 16.75392670157068, "enter_gnomish_mines": 65.96858638743456, "enter_dungeon": 95.81151832460733, "defeat_orc_solider": 94.76439790575917, "defeat_orc_mage": 92.14659685863874, "eat_snail": 94.76439790575917, "find_bow": 95.81151832460733, "fire_bow": 95.28795811518324, "open_chest": 95.81151832460733, "drink_potion": 83.24607329842932}, "average_episode_length": 1539.2303664921467, "mean_return_percentage": 26.86779625095561, "mean_return": 60.72121952715968, "lp": NaN, "priority_score": 0.23217565307968532}]</data>
