      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to survive and defeat a mixed group of Orc Soldiers and an Orc Mage in the dungeon.
    Description: The agent is placed on Floor 1 (dungeon) equipped with a stone sword, ready for combat. All mob spawning is disabled, and survival needs (hunger, thirst, fatigue) are suspended, so the agent can focus purely on fighting. Two Orc Soldiers (melee mob, mob_name "Orc Soldier", type_id=2) and one Orc Mage (ranged mob, mob_name "Orc Mage", type_id=2) are added to the level, each within 2–6 tiles (Manhattan distance) of the player’s start position. The task is a success when the agent has defeated at least one Orc Soldier and the single Orc Mage, thereby earning both `DEFEAT_ORC_SOLIDER` and `DEFEAT_ORC_MAGE` achievements. Health regeneration functions normally because all needs are met, allowing the agent to rest between skirmishes.
    Relevant Achievements: DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE
    Completed Achievements: MAKE_STONE_SWORD, ENTER_DUNGEON
    World:
    - Player: Starts on floor 1. Inventory: `{"sword": 2}` (stone sword). MAKE_STONE_SWORD and ENTER_DUNGEON achievements completed.
    - Map:
      - Add 2 Orc Soldiers (melee mob, mob_name "Orc Soldier", type_id=2) randomly within 2–6 Manhattan distance of the starting position.
      - Add 1 Orc Mage (ranged mob, mob_name "Orc Mage", type_id=2) randomly within 2–6 Manhattan distance of the starting position.
      - No other initial mobs or block modifications.
    - Mechanics:
      - melee_spawn_multiplier = 0.0
      - ranged_spawn_multiplier = 0.0
      - passive_spawn_multiplier = 0.0
      - needs_depletion_multiplier = 0.0
      - All other TaskParams at default (mob_health_multiplier = 1.0, mob_damage_multiplier = 1.0, health_recover_multiplier = 1.0, health_loss_multiplier = 1.0, etc.).
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.DEFEAT_ORC_SOLIDER,
            Achievement.DEFEAT_ORC_MAGE,
        ]
        self.completed_achievements = [
            Achievement.MAKE_STONE_SWORD,
            Achievement.ENTER_DUNGEON,
        ]
        self.label = "DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=0.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            needs_depletion_multiplier=0.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, melee_rng, ranged_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(1)
        builder.set_player_inventory({"sword": 2})  # stone sword

        # Place 2 Orc Soldiers (melee, type_id=2) within 2-6 Manhattan distance
        builder.add_mobs_randomly_near(
            melee_rng,
            level=1,
            mob_name="melee",
            type_id=2,  # Orc Soldier
            n=2,
            target_pos=builder.player_position,
            min_dist=2,
            max_dist=6,
            on_blocks=[BlockType.PATH],  # dungeon floor uses PATH blocks
        )

        # Place 1 Orc Mage (ranged, type_id=2) within 2-6 Manhattan distance
        builder.add_mobs_randomly_near(
            ranged_rng,
            level=1,
            mob_name="ranged",
            type_id=2,  # Orc Mage
            n=1,
            target_pos=builder.player_position,
            min_dist=2,
            max_dist=6,
            on_blocks=[BlockType.PATH],
        )

        state = builder.build(rng)

        # Set completed achievements so that they are already granted
        # (the agent does not need to re-earn them)
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
