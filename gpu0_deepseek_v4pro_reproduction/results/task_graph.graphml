      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Craft a Stone Pickaxe.
    Description: The player must use a wood pickaxe to mine stone and then craft a stone pickaxe. The player starts on the overworld (Floor 0) with a wood pickaxe and 3 wood in the inventory. A crafting table must be placed to enable the stone-pickaxe recipe. Stone blocks are placed around the player’s starting location (center of the map) to ensure accessibility. Survival needs are active but reduced (needs depletion multiplier 0.5). Mob spawns are kept very low to minimize combat interference while still allowing the player to eat cows if desired. Three cows are placed nearby as a food source.
    Relevant Achievements: PLACE_TABLE, COLLECT_STONE, MAKE_STONE_PICKAXE
    Completed Achievements: MAKE_WOOD_PICKAXE
    World:
    - Player: Starts on floor 0. Inventory: pickaxe (tier 1, wood) = 1, wood = 3.
    - Map:
      * Use the default procedural overworld (Floor 0).
      * Place 5 Stone blocks (BlockType.STONE) randomly on Floor 0 within Manhattan distance 3–8 from the player start position (approx. (24, 24)), on blocks of type GRASS or PATH.
      * Add 3 Cow mobs (passive, mob_name "passive", type_id 0) within Manhattan distance 4–8 from the player start position.
    - Mechanics: 
      * needs_depletion_multiplier = 0.5
      * passive_spawn_multiplier = 1.0
      * melee_spawn_multiplier = 0.1
      * ranged_spawn_multiplier = 0.05
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.PLACE_TABLE,
            Achievement.COLLECT_STONE,
            Achievement.MAKE_STONE_PICKAXE,
        ]
        self.completed_achievements = [Achievement.MAKE_WOOD_PICKAXE]
        self.label = "PLACE_TABLE, COLLECT_STONE, MAKE_STONE_PICKAXE"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=1.0,   # Enable random cow spawns
            melee_spawn_multiplier=0.1,     # Very low zombie spawns
            ranged_spawn_multiplier=0.05,   # Very low skeleton spawns
            needs_depletion_multiplier=0.5, # Needs active but reduced
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, stone_rng, cow_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(0)

        # Give the player a wood pickaxe and 3 wood
        builder.set_player_inventory({"pickaxe": 1, "wood": 3})

        # Place 5 stone blocks near the player on Floor 0 (Manhattan distance 3-8)
        builder.place_randomly_near(
            stone_rng,
            level=0,
            block_type=BlockType.STONE,
            target_pos=builder.player_position,
            min_dist=3,
            max_dist=8,
            n=5,
            on_blocks=[BlockType.GRASS, BlockType.PATH],
        )

        # Place 3 cows (passive mob type_id=0) as a food source
        builder.add_mobs_randomly_near(
            cow_rng,
            level=0,
            mob_name="passive",
            type_id=0,
            n=3,
            target_pos=builder.player_position,
            min_dist=4,
            max_dist=8,
            on_blocks=[BlockType.GRASS, BlockType.PATH],
        )

        return builder.build(rng)</data>
