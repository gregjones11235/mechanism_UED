: 0.11953721912755469}, {"session": 28, "sr": 0.892570281124498, "achievement_srs": {"collect_wood": 97.59036144578313, "place_table": 95.38152610441767, "eat_cow": 82.83132530120481, "collect_sapling": 80.52208835341365, "collect_drink": 82.3293172690763, "make_wood_pickaxe": 93.57429718875503, "place_plant": 76.80722891566265, "defeat_zombie": 89.2570281124498, "collect_stone": 91.96787148594377, "place_stone": 91.06425702811245, "eat_plant": 1.2048192771084338, "defeat_skeleton": 6.7269076305220885, "make_stone_pickaxe": 58.23293172690763, "make_stone_sword": 29.819277108433734, "wake_up": 49.29718875502008, "place_furnace": 84.43775100401606, "collect_coal": 66.86746987951807, "collect_iron": 28.91566265060241, "collect_diamond": 3.8152610441767068, "make_iron_pickaxe": 1.4056224899598393, "make_iron_sword": 7.228915662650603, "make_arrow": 61.34538152610442, "make_torch": 53.91566265060241, "place_torch": 51.40562248995984, "collect_sapphire": 3.21285140562249, "collect_ruby": 2.710843373493976, "make_diamond_pickaxe": 0.5020080321285141, "make_diamond_sword": 0.30120481927710846, "make_iron_armour": 0.7028112449799196, "enter_dungeon": 32.1285140562249, "defeat_orc_solider": 8.835341365461847, "defeat_orc_mage": 1.8072289156626506, "eat_snail": 13.052208835341366, "find_bow": 30.823293172690764, "fire_bow": 22.991967871485944, "open_chest": 30.823293172690764, "drink_potion": 13.052208835341366}, "average_episode_length": 272.43172690763055, "mean_return_percentage": 16.015590292586275, "mean_return": 36.19523406124498, "lp": NaN, "priority_score": 0.09588857437783262}]</data>
