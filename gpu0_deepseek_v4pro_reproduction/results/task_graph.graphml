      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams
from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to handle mixed melee/ranged encounters in the Dungeon by defeating two Orc Soldiers and two Orc Mages using a bow and a melee weapon.

Description: The agent starts on Floor 1 (Dungeon) at the ladder‑up arrival point. It receives a bow, 10 arrows, and a stone sword in its starting inventory. All natural mob spawns are suppressed (melee_spawn_multiplier = 0.0, ranged_spawn_multiplier = 0.0, passive_spawn_multiplier = 0.0), so the only hostiles are the four placed Orcs. Two Orc Soldiers (`mob_name = "melee"`, `type_id = 2`) and two Orc Mages (`mob_name = "ranged"`, `type_id = 2`) are spawned on walkable dungeon tiles (`BlockType.PATH`) at a Manhattan distance between 5 and 8 from the agent’s start location. Survival demands (hunger, thirst, fatigue) remain disabled (`needs_depletion_multiplier = 0.0`), and health regeneration stays moderately boosted (`health_recover_multiplier = 2.0`) to soften the increased enemy pressure while combat skills are being refined. The task is considered successful once the agent has fired the bow (triggering `FIRE_BOW`) and killed all four Orcs.

Relevant Achievements: FIRE_BOW, DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE
Completed Achievements: ENTER_DUNGEON, FIND_BOW
World:
- Player: Starting floor 1; inventory `{"bow": 1, "arrows": 10, "sword": 2}` (stone sword). Stats default.
- Map: On Floor 1, add two Orc Soldiers using `add_mobs_randomly_near` with `mob_name = "melee"`, `type_id = 2`, `n = 2`, `target_pos = None`, `min_dist = 5`, `max_dist = 8`, `on_blocks = [BlockType.PATH]`. Also add two Orc Mages using the same method with `mob_name = "ranged"`, `type_id = 2`, `n = 2`. No other block modifications.
- Mechanics:
    "needs_depletion_multiplier": 0.0,
    "health_recover_multiplier": 2.0,
    "melee_spawn_multiplier": 0.0,
    "passive_spawn_multiplier": 0.0,
    "ranged_spawn_multiplier": 0.0
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.FIRE_BOW,
            Achievement.DEFEAT_ORC_SOLIDER,
            Achievement.DEFEAT_ORC_MAGE,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.FIND_BOW,
        ]
        self.label = "FIRE_BOW, DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.0,
            health_recover_multiplier=2.0,
            melee_spawn_multiplier=0.0,
            passive_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, soldier_rng, mage_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)
        builder.set_starting_floor(1)

        # Equip bow, 10 arrows, and a stone sword
        builder.set_player_inventory({"bow": 1, "arrows": 10, "sword": 2})

        # Place two Orc Soldiers (melee, type_id=2)
        builder.add_mobs_randomly_near(
            soldier_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=2,
            target_pos=builder.player_position,
            min_dist=5,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        # Place two Orc Mages (ranged, type_id=2)
        builder.add_mobs_randomly_near(
            mage_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=2,
            target_pos=builder.player_position,
            min_dist=5,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        return builder.build(rng)</data>
