  - All other parameters left at default.</data>
      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to clear a stronger dungeon floor to unlock the descent to the Gnomish Mines.

Description: The agent starts on Floor 0 with a stone pickaxe, 5 wood and 5 stone. A crafting table is already placed one tile south of the spawn. The task requires crafting an iron sword, entering the dungeon, defeating exactly 8 hostile orcs (soldiers or mages) to satisfy the new kill threshold, and descending to Floor 2. Survival needs are slowed (20% rate) to keep focus on crafting and combat.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: PLACE_TABLE, MAKE_STONE_PICKAXE

World:
- Player: `set_starting_floor(0)`. Inventory: `{"pickaxe": 2, "wood": 5, "stone": 5}`. All other attributes default.
- Map:
  - `place_block(0, BlockType.CRAFTING_TABLE, (player_start_row + 1, player_start_col))` to place a crafting table one tile south of spawn.
  - `set_monsters_killed(level=1, count=0)` to ensure the dungeon starts uncleared.
  - No other manual block placements; ores and terrain use procedural generation.
- Mechanics:
  - monsters_killed_to_clear_level = 8
  - mob_health_multiplier = 1.0
  - mob_damage_multiplier = 1.0
  - melee_spawn_multiplier = 1.0
  - ranged_spawn_multiplier = 1.0
  - passive_spawn_multiplier = 1.0
  - needs_depletion_multiplier = 0.2
  - health_recover_multiplier = 1.0
  - health_loss_multiplier = 1.0
  - mana_recover_multiplier = 1.0
  - growing_plants_age = 600
  - All other parameters left at default.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.PLACE_TABLE,
            Achievement.MAKE_STONE_PICKAXE,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            needs_depletion_multiplier=0.2,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            growing_plants_age=600,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld) at default center position
        builder.set_starting_floor(0)

        # Starting inventory: stone pickaxe (2), 5 wood, 5 stone
        builder.set_player_inventory({
            "pickaxe": 2,
            "wood": 5,
            "stone": 5,
        })

        # Place a crafting table one tile south of the player's spawn
        spawn_row, spawn_col = builder.player_position[0], builder.player_position[1]
        builder.place_block(
            0,
            BlockType.CRAFTING_TABLE,
            (spawn_row + 1, spawn_col),
        )

        # Ensure the Dungeon (floor 1) starts uncleared
        builder.set_monsters_killed(level=1, count=0)

        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
