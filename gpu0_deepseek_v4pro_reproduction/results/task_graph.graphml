ton": 12.468193384223918, "make_stone_pickaxe": 35.11450381679389, "wake_up": 65.39440203562341, "place_furnace": 29.516539440203562, "collect_coal": 61.57760814249364, "collect_iron": 60.55979643765903, "collect_diamond": 34.86005089058524, "make_iron_pickaxe": 17.302798982188296, "make_iron_sword": 13.231552162849873, "place_torch": 99.74554707379134, "collect_sapphire": 27.2264631043257, "collect_ruby": 22.391857506361323, "make_diamond_pickaxe": 4.325699745547074, "make_diamond_sword": 2.7989821882951653, "make_iron_armour": 3.053435114503817, "enter_gnomish_mines": 68.95674300254453, "enter_dungeon": 100.0, "defeat_orc_solider": 98.21882951653944, "defeat_orc_mage": 90.83969465648855, "eat_snail": 95.92875318066157, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 99.23664122137404, "drink_potion": 82.95165394402035}, "average_episode_length": 702.2773536895675, "mean_return_percentage": 18.65722337392195, "mean_return": 42.165324825063614, "lp": NaN, "priority_score": 0.2140641894735479}, {"session": 52, "sr": 0.7298969072164948, "achievement_srs": {"collect_wood": 27.628865979381445, "place_table": 23.917525773195877, "eat_cow": 28.45360824742268, "collect_sapling": 26.5979381443299, "collect_drink": 86.3917525773196, "make_wood_pickaxe": 47.628865979381445, "make_wood_sword": 100.0, "place_plant": 26.391752577319586, "defeat_zombie": 15.051546391752577, "collect_stone": 30.309278350515463, "place_stone": 29.484536082474225, "eat_plant": 3.5051546391752577, "defeat_skeleton": 11.75257731958763, "make_stone_pickaxe": 30.103092783505154, "wake_up": 69.48453608247422, "place_furnace": 28.04123711340206, "collect_coal": 58.144329896907216, "collect_iron": 56.90721649484536, "collect_diamond": 31.95876288659794, "make_iron_pickaxe": 15.051546391752577, "make_iron_sword": 14.639175257731958, "place_torch": 99.79381443298969, "collect_sapphire": 25.97938144329897, "collect_ruby": 28.8659793814433, "make_diamond_pickaxe": 4.123711340206185, "make_diamond_sword": 4.329896907216495, "make_iron_armour": 2.0618556701030926, "enter_gnomish_mines": 72.98969072164948, "enter_dungeon": 100.0, "defeat_orc_solider": 98.55670103092784, "defeat_orc_mage": 90.9278350515464, "eat_snail": 96.28865979381443, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 99.17525773195877, "drink_potion": 84.12371134020619}, "average_episode_length": 611.6680412371134, "mean_return_percentage": 19.054686430868532, "mean_return": 43.063591333762886, "lp": NaN, "priority_score": 0.1971474120522904}]</data>
