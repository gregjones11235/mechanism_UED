": 12.982456140350877, "collect_coal": 28.07017543859649, "collect_iron": 28.304093567251464, "collect_diamond": 12.865497076023392, "make_iron_pickaxe": 10.64327485380117, "make_iron_sword": 10.175438596491228, "make_arrow": 100.0, "make_torch": 61.87134502923977, "place_torch": 61.05263157894737, "collect_sapphire": 13.91812865497076, "collect_ruby": 14.269005847953217, "make_diamond_pickaxe": 2.690058479532164, "make_diamond_sword": 2.2222222222222223, "make_iron_armour": 1.6374269005847952, "enter_dungeon": 100.0, "defeat_orc_solider": 81.98830409356725, "defeat_orc_mage": 76.25730994152046, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 89.47368421052632, "drink_potion": 49.12280701754386}, "average_episode_length": 324.14269005847956, "mean_return_percentage": 14.104890989688453, "mean_return": 31.877053636695905, "lp": NaN, "priority_score": 0.18105536746349304}]</data>
