      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Clear the Dungeon under full default combat and survival pressure, then descend to the Gnomish Mines – eliminating the earlier damage‑reduction and hunger‑thirst cushions.

Description: The agent spawns on Floor 1 (Dungeon) at the ladder‑up location. Its inventory contains a stone sword (tier 2), a stone pickaxe (tier 2), a bow (1), 10 arrows, and 5 torches. No other items, resources, or enchantments are provided. All mob damage and needs depletion are now set to the standard Craftax values (multiplier 1.0). The agent must explore the procedurally‑generated Dungeon, fight Orc Soldiers and Orc Mages at full strength, and accumulate exactly 8 kills on this floor to unlock the ladder down. Once the ladder is active, the agent must stand on it and descend to Floor 2 (Gnomish Mines); doing so ends the episode successfully. All other game mechanics remain unchanged from the parent task (default spawn rates, health recovery, mana recovery, plant growth, etc.). This task removes the scaffolding that made the previous training easier, forcing the agent to handle authentic combat damage and the full rate of hunger, thirst, and fatigue. The objective is to strengthen the agent’s ability to survive and fight on Floor 1 under the exact same conditions it will face in the full Craftax game.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: COLLECT_WOOD, PLACE_TABLE, MAKE_WOOD_PICKAXE, COLLECT_STONE, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, MAKE_ARROW, MAKE_TORCH, FIND_BOW, ENTER_DUNGEON

World:
- Player:
  - Starting floor: 1
  - Inventory: sword=1 (stone tier), pickaxe=1 (stone tier), bow=1, arrows=10, torches=5
  - All attributes: strength=1, dexterity=1, intelligence=1
  - Status bars: health=9/9, food=9/9, drink=9/9, energy=9/9, mana=9/9
  - Enchantments: none (sword=0, bow=0, armour=0)
  - Learned spells: fireball=False, iceball=False
- Map:
  - No manual block modifications. Floor 1 uses default Dungeon generation (rooms, corridors, chests, fountains, torches). Floor 0 and all deeper levels retain procedural defaults, inaccessible except for the descent to Floor 2.
- Mechanics:
  - monsters_killed_to_clear_level = 8
  - mob_damage_multiplier = 1.0
  - needs_depletion_multiplier = 1.0
  - health_recover_multiplier = 1.0
  - health_loss_multiplier = 1.0
  - mana_recover_multiplier = 1.0
  - melee_spawn_multiplier = 1.0
  - ranged_spawn_multiplier = 1.0
  - passive_spawn_multiplier = 1.0
  - All other TaskParams at default values.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.COLLECT_WOOD,
            Achievement.PLACE_TABLE,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.COLLECT_STONE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_TORCH,
            Achievement.FIND_BOW,
            Achievement.ENTER_DUNGEON,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task (all defaults)."""
        # All the described multipliers and thresholds are exactly the defaults.
        return TaskParams()

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Equip the agent's inventory as described:
        # stone sword (sword=2), stone pickaxe (pickaxe=2), bow (1), 10 arrows, 5 torches
        builder.set_player_inventory({
            "sword": 2,
            "pickaxe": 2,
            "bow": 1,
            "arrows": 10,
            "torches": 5,
        })

        state = builder.build(rng)

        # Mark all pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
