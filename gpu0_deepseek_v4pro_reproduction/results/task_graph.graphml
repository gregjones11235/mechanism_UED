4, "make_torch": 89.65517241379311, "place_torch": 88.96551724137932, "collect_sapphire": 24.82758620689655, "collect_ruby": 24.137931034482758, "make_diamond_pickaxe": 3.4482758620689653, "make_diamond_sword": 4.137931034482759, "make_iron_armour": 1.3793103448275863, "enter_gnomish_mines": 45.51724137931034, "enter_dungeon": 88.27586206896552, "defeat_orc_solider": 82.75862068965517, "defeat_orc_mage": 79.3103448275862, "eat_snail": 80.6896551724138, "find_bow": 82.75862068965517, "fire_bow": 81.37931034482759, "open_chest": 82.75862068965517, "drink_potion": 72.41379310344827}, "average_episode_length": 1832.048275862069, "mean_return_percentage": 23.26049245928059, "mean_return": 52.568712957974135, "lp": NaN, "priority_score": 0.24799048751486327}, {"session": 137, "sr": 0.6862745098039216, "achievement_srs": {"collect_wood": 99.34640522875817, "place_table": 99.34640522875817, "eat_cow": 100.0, "collect_sapling": 100.0, "collect_drink": 99.34640522875817, "make_wood_pickaxe": 99.34640522875817, "make_wood_sword": 98.69281045751634, "place_plant": 100.0, "defeat_zombie": 98.69281045751634, "collect_stone": 98.69281045751634, "place_stone": 98.69281045751634, "eat_plant": 40.52287581699346, "defeat_skeleton": 96.07843137254902, "make_stone_pickaxe": 96.73202614379085, "make_stone_sword": 98.03921568627452, "wake_up": 100.0, "place_furnace": 98.69281045751634, "collect_coal": 94.77124183006536, "collect_iron": 89.54248366013071, "collect_diamond": 33.98692810457516, "make_iron_pickaxe": 32.02614379084967, "make_iron_sword": 64.70588235294117, "make_arrow": 98.03921568627452, "make_torch": 94.11764705882354, "place_torch": 94.11764705882354, "collect_sapphire": 24.836601307189543, "collect_ruby": 32.02614379084967, "make_diamond_pickaxe": 1.9607843137254901, "make_diamond_sword": 2.6143790849673203, "make_iron_armour": 4.57516339869281, "enter_gnomish_mines": 68.62745098039215, "enter_dungeon": 92.81045751633987, "defeat_orc_solider": 92.15686274509804, "defeat_orc_mage": 88.23529411764706, "eat_snail": 90.19607843137256, "find_bow": 92.81045751633987, "fire_bow": 92.81045751633987, "open_chest": 92.81045751633987, "drink_potion": 86.27450980392157}, "average_episode_length": 1865.111111111111, "mean_return_percentage": 27.212801718216785, "mean_return": 61.50093188316993, "lp": NaN, "priority_score": 0.21530180699730872}]</data>
