      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Fight under survival pressure against Orcs with increased (but still scaffolded) damage, then descend to the Gnomish Mines.

Description:
The agent begins on Floor 1 (“Dungeon”) with the same inventory as the previous task:
- `sword` level 2 (stone sword)
- `bow` 1
- `arrows` 20
- `torches` 4

Survival needs remain active at standard Craftax rates (`needs_depletion_multiplier = 1.0`, `health_recover_multiplier = 1.0`, `health_loss_multiplier = 1.0`). Passive mobs spawn at the base rate (`passive_spawn_multiplier = 1.0`), giving Snails as a food source; fountains provide water. Hostile spawning is unchanged (`melee_spawn_multiplier = 1.0`, `ranged_spawn_multiplier = 1.0`), so the Dungeon is populated with Orc Soldiers (melee, type 2) and Orc Mages (ranged, type 2). The kill threshold for the Ladder Down stays at `monsters_killed_to_clear_level = 8`.

The only difference: mob‑inflicted damage is raised from 0.5 to **0.7** (`mob_damage_multiplier = 0.7`). This is a small step toward the game’s default of 1.0, forcing the agent to adapt its combat approach (dodging, using bow, timing attacks) without making the episode prohibitively fatal. Mobs keep full health (`mob_health_multiplier = 1.0`).

The agent must hunt and defeat any combination of eight Orc Soldiers and/or Orc Mages. Once the kill count reaches 8, the Ladder Down becomes usable. The episode succeeds and terminates when the agent performs the DESCEND action on the ladder, granting the `ENTER_GNOMISH_MINES` achievement.

Relevant Achievements:
- DEFEAT_ORC_SOLIDER
- DEFEAT_ORC_MAGE
- ENTER_GNOMISH_MINES

Completed Achievements:
- ENTER_DUNGEON
- MAKE_STONE_SWORD
- FIND_BOW
- MAKE_ARROW
- MAKE_TORCH

World:
- Player: Starts on floor 1 with inventory `{"sword": 2, "bow": 1, "arrows": 20, "torches": 4}`.
- Map: No manual block or mob additions; the default Floor 1 Dungeon generation (rooms, corridors, chests, fountains, torches) is used.
- Mechanics:
  * `needs_depletion_multiplier = 1.0`
  * `health_recover_multiplier = 1.0`
  * `health_loss_multiplier = 1.0`
  * `passive_spawn_multiplier = 1.0`
  * `melee_spawn_multiplier = 1.0`
  * `ranged_spawn_multiplier = 1.0`
  * `mob_damage_multiplier = 0.7`
  * `mob_health_multiplier = 1.0`
  * `monsters_killed_to_clear_level = 8`
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.DEFEAT_ORC_SOLIDER,
            Achievement.DEFEAT_ORC_MAGE,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.MAKE_STONE_SWORD,
            Achievement.FIND_BOW,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_TORCH,
        ]
        self.label = "DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=1.0,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            mob_damage_multiplier=0.7,
            mob_health_multiplier=1.0,
            monsters_killed_to_clear_level=8,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon)
        builder.set_starting_floor(1)

        # Set the inventory as described
        builder.set_player_inventory({
            "sword": 2,    # stone sword
            "bow": 1,
            "arrows": 20,
            "torches": 4,
        })

        # No manual block/mob placements; rely on default dungeon generation and spawns

        state = builder.build(rng)

        # Mark pre‑completed achievements
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
