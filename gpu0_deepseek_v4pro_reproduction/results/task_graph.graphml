      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Enter the Gnomish Mines by clearing floor 1 of orc soldiers and descending to floor 2.

    Description: The player begins on floor 1 (Dungeon) with a stone sword, full health/food/drink/energy, and no other inventory. Survival is active but depletion is halved. No hostile mobs spawn; only three orc melee soldiers are placed 2‑5 tiles from the player. The kill‑to‑clear requirement for floor 1 is set to 3, so the player must defeat all three orc soldiers to unlock the ladder down. Once unlocked, standing on the down‑ladder and using the DESCEND action moves the player to floor 2 (Gnomish Mines), awarding the ENTER_GNOMISH_MINES achievement and terminating the episode successfully.

    Relevant Achievements: ENTER_GNOMISH_MINES

    Completed Achievements: ENTER_DUNGEON, MAKE_STONE_SWORD

    World:
    - Player: Starts on floor 1 (Dungeon) with a stone sword (sword tier 2) in inventory. All intrinsics (health, food, drink, energy) are at max (9). No other items.
    - Map: 3 `melee` mobs of type `orc soldier` (mob_name="orc_soldier", type_id=2) are placed randomly 2‑5 tiles away from the player using `add_mobs_randomly_near`. All other map blocks are procedurally generated for the full 9‑level world (default dungeon generation on floor 1).
    - Mechanics:
      - monsters_killed_to_clear_level = 3
      - needs_depletion_multiplier = 0.5
      - passive_spawn_multiplier = 0.1
      - melee_spawn_multiplier = 0
      - ranged_spawn_multiplier = 0
      - All other TaskParams remain at default values.
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_GNOMISH_MINES]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.MAKE_STONE_SWORD,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=0.1,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            needs_depletion_multiplier=0.5,
            monsters_killed_to_clear_level=3,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, mob_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(1)
        builder.set_player_inventory({"sword": 2})  # 2 = stone sword

        # Place 3 orc soldiers (melee, type_id=2) 2-5 tiles from the player
        builder.add_mobs_randomly_near(
            mob_rng,
            level=1,
            mob_name="melee",
            type_id=2,  # Orc Soldier
            n=3,
            target_pos=builder.player_position,
            min_dist=2,
            max_dist=5,
        )

        return builder.build(rng)</data>
