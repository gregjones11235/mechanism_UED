": 29.55665024630542, "make_iron_pickaxe": 50.73891625615764, "make_iron_sword": 61.576354679802954, "make_arrow": 100.0, "make_torch": 100.0, "place_torch": 100.0, "collect_sapphire": 23.15270935960591, "collect_ruby": 19.704433497536947, "make_diamond_pickaxe": 4.433497536945813, "make_diamond_sword": 2.4630541871921183, "make_iron_armour": 8.866995073891626, "enter_gnomish_mines": 58.12807881773399, "enter_dungeon": 92.11822660098522, "defeat_orc_solider": 91.6256157635468, "defeat_orc_mage": 84.72906403940887, "eat_snail": 90.14778325123153, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 91.13300492610837, "drink_potion": 77.33990147783251}, "average_episode_length": 1403.3793103448277, "mean_return_percentage": 21.79954938232922, "mean_return": 49.26698160406404, "lp": NaN, "priority_score": 0.24339343347327042}, {"session": 104, "sr": 0.504950495049505, "achievement_srs": {"collect_wood": 97.52475247524752, "place_table": 95.54455445544555, "eat_cow": 92.07920792079207, "collect_sapling": 100.0, "collect_drink": 99.00990099009901, "make_wood_pickaxe": 100.0, "make_wood_sword": 100.0, "place_plant": 99.5049504950495, "defeat_zombie": 68.31683168316832, "collect_stone": 99.5049504950495, "place_stone": 99.00990099009901, "eat_plant": 26.73267326732673, "defeat_skeleton": 63.366336633663366, "wake_up": 97.52475247524752, "place_furnace": 98.51485148514851, "collect_coal": 91.08910891089108, "collect_iron": 87.62376237623762, "collect_diamond": 27.22772277227723, "make_iron_pickaxe": 42.57425742574257, "make_iron_sword": 59.9009900990099, "make_arrow": 100.0, "make_torch": 100.0, "place_torch": 100.0, "collect_sapphire": 25.247524752475247, "collect_ruby": 27.722772277227723, "make_diamond_pickaxe": 2.9702970297029703, "make_diamond_sword": 4.455445544554456, "make_iron_armour": 7.425742574257426, "enter_gnomish_mines": 50.495049504950494, "enter_dungeon": 97.52475247524752, "defeat_orc_solider": 94.55445544554455, "defeat_orc_mage": 90.0990099009901, "eat_sn