from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Enter the Gnomish Mines (floor 2) after clearing the dungeon of a larger number of hostiles, forcing sustained combat without changing other easy‑mode settings.

Description:  
The agent begins on the Overworld (floor 0) with no equipment or resources, and survival needs (hunger, thirst, fatigue) remain disabled. The core gameplay loop is identical to the parent task:

1. **Overworld preparation:** Gather wood, place a crafting table, craft a wood pickaxe, mine stone, and then craft a stone pickaxe and a stone sword.  
2. **Dungeon assault:** Descend to floor 1, open a chest to acquire a bow and arrows, then hunt and defeat **exactly 8 hostile mobs** (Orc Soldiers and/or Orc Mages) to unlock the ladder down to floor 2.  

The only mechanical change is the floor‑clearance threshold: `monsters_killed_to_clear_level` is set to 8 (applied to all floors, though only floor 1 matters). All other difficulty‑reducing parameters are kept exactly as in the parent task – melee and ranged spawn multipliers remain at 0.5, so monster density is low, and the needs‑depletion multiplier stays at 0.0. This forces the agent to become proficient at extended combat and arrow usage (or melee duels) in a controlled environment, directly targeting the global bottleneck that prevents progression to the Gnomish Mines under full‑game conditions.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: (none)

World:
- Player:
  * Start on floor 0 (Overworld).
  * Stats: Strength 1, Dexterity 1, Intelligence 1; health, food, drink, energy, mana all at 9/9.
  * Inventory: empty.
- Map:
  * No custom block or mob placements; the default overworld and dungeon layouts are used unchanged.
- Mechanics:
  * `melee_spawn_multiplier = 0.5`
  * `ranged_spawn_multiplier = 0.5`
  * `monsters_killed_to_clear_level = 8`
  * `needs_depletion_multiplier = 0.0`
  * All other `TaskParams` remain at default Craftax values.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_GNOMISH_MINES]
        self.completed_achievements = []
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=0.5,
            ranged_spawn_multiplier=0.5,
            monsters_killed_to_clear_level=8,
            needs_depletion_multiplier=0.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        builder = WorldBuilder(rng, self.static_params, self.params)
        # Start on floor 0 (Overworld) — already default, but explicit
        builder.set_starting_floor(0)
        # No inventory, stat, or mob placement changes required
        return builder.build(rng)</data>
