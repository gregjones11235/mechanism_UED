      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Clear the Dungeon floor by defeating all four Orc enemies and then descend to the Gnomish Mines.

    Description: The agent begins on Floor 1 (the Dungeon) equipped with a wood sword, a bow, and 15 arrows. Survival needs are disabled and no additional mobs can spawn, ensuring the challenge consists solely of the placed enemies. Four Orc enemies—two Orc Soldiers (melee) and two Orc Mages (ranged)—are placed randomly on walkable path tiles, 5 to 12 tiles away from the player’s spawn. The dungeon floor must be cleared by defeating all four enemies; once the kill count reaches 4 (the required amount set by `monsters_killed_to_clear_level`), the ladder down becomes active. The agent must navigate the procedurally‑generated rooms and corridors, locate the enemies, use both melee and ranged attacks to defeat them, then find and stand on the Ladder Down tile and use the `DESCEND` action. Successfully descending to Floor 2 unlocks the `ENTER_GNOMISH_MINES` achievement and ends the episode successfully. This task teaches floor clearance, multi‑enemy combat, and the ladder‑descent mechanic—the exact skills missing for progressing beyond Floor 1 in the full game.

    Relevant Achievements: ENTER_GNOMISH_MINES
    Completed Achievements: ENTER_DUNGEON, FIND_BOW

    World:
    - Player: Floor 1 (spawn at ladder‑up position). Inventory: {"sword": 1, "bow": 1, "arrows": 15}. Stats: Strength 1, Dexterity 1, Intelligence 1. Health/Food/Drink/Energy/Mana all full (9/9). Learned spells: none. Weapon/Armour enchantments: none.
    - Map:
        - Use default Dungeon generation for Floor 1.
        - Place exactly two melee mobs (Orc Soldier, mob_name "melee", type_id=2) using `add_mobs_randomly_near`, with target_pos = player spawn coordinates, n=2, min_dist=5, max_dist=12, on_blocks = [BlockType.PATH].
        - Place exactly two ranged mobs (Orc Mage, mob_name "ranged", type_id=2) using `add_mobs_randomly_near`, with target_pos = player spawn coordinates, n=2, min_dist=5, max_dist=12, on_blocks = [BlockType.PATH].
        - No other mobs are placed.
    - Mechanics:
        "needs_depletion_multiplier": 0.0,
        "melee_spawn_multiplier": 0.0,
        "ranged_spawn_multiplier": 0.0,
        "passive_spawn_multiplier": 0.0,
        "monsters_killed_to_clear_level": 4,
        "health_recover_multiplier": 1.0,
        "mob_health_multiplier": 1.0,
        "mob_damage_multiplier": 1.0
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_GNOMISH_MINES]
        self.completed_achievements = [Achievement.ENTER_DUNGEON, Achievement.FIND_BOW]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            passive_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=4,
            health_recover_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, melee_rng, ranged_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(1)
        builder.set_player_inventory({"sword": 1, "bow": 1, "arrows": 15})

        # Place exactly two Orc Soldiers (melee, type_id=2) near the player spawn
        builder.add_mobs_randomly_near(
            melee_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=2,
            target_pos=builder.player_position,
            min_dist=5,
            max_dist=12,
            on_blocks=[BlockType.PATH],
        )

        # Place exactly two Orc Mages (ranged, type_id=2) near the player spawn
        builder.add_mobs_randomly_near(
            ranged_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=2,
            target_pos=builder.player_position,
            min_dist=5,
            max_dist=12,
            on_blocks=[BlockType.PATH],
        )

        return builder.build(rng)</data>
