  - ranged_spawn_multiplier = 1.0
  - passive_spawn_multiplier = 1.0
  - mob_health_multiplier = 1.0
  - mob_damage_multiplier = 1.0
  - needs_depletion_multiplier = 0.25
  - health_recover_multiplier = 2.0
  - monsters_killed_to_clear_level = 8</data>
      <data key="d3">import jax
import jax.numpy as jnp
from craftax.craftax.constants import (
    Achievement,
    BlockType,
    ItemType,
)
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to craft an iron pickaxe and iron sword, then use them to clear floor 1 and descend to the Gnomish Mines (floor 2).

Description: The episode begins on the Overworld (floor 0) with the ladder to the Dungeon already unlocked. The player spawns at the centre of the map, already equipped with stone‑tier tools, a bow, arrows, torches, and a small stock of wood, stone, and coal. A Crafting Table and a Furnace are pre‑placed directly adjacent to the spawn location. Three blocks of Iron Ore are placed randomly on visible nearby terrain (within Manhattan distance 3–8 from the player, on stone blocks) to guarantee accessible mining. The agent must first collect 3 iron (enough for both recipes) and then craft an iron pickaxe and an iron sword using the nearby Table and Furnace. These two crafting achievements are required for success; without them the episode will not count as succeeded. Once both items are crafted, the agent must locate the ladder down on floor 0 and use DESCEND to enter the Dungeon (floor 1). On floor 1, a ladder down to floor 2 is guaranteed to appear on a PATH block within Manhattan distance 2–10 from the spawn point. The agent must defeat at least 8 hostile mobs (Orc Soldiers and Orc Mages, standard spawn rates) to clear the floor, then step on that ladder and use DESCEND again, thereby unlocking ENTER_GNOMISH_MINES and completing the task. Survival needs are heavily reduced (needs_depletion_multiplier = 0.25, health_recover_multiplier = 2.0) so the agent can fully focus on the iron‑crafting and combat sequence.

Relevant Achievements: MAKE_IRON_PICKAXE, MAKE_IRON_SWORD, ENTER_DUNGEON, ENTER_GNOMISH_MINES
Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_STONE_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_SWORD, COLLECT_WOOD, COLLECT_STONE, COLLECT_COAL, PLACE_TABLE, PLACE_FURNACE, FIND_BOW, MAKE_ARROW, MAKE_TORCH

World:
- Player:
  - Starting floor = 0.
  - Inventory: {"pickaxe": 2, "sword": 2, "bow": 1, "arrows": 15, "torch": 10, "wood": 5, "stone": 5, "coal": 5}.
  - Stats: dexterity=1, strength=1, intelligence=1.
  - set_monsters_killed(level=0, count=8) (ladder immediately usable).
- Map:
  - On level 0, pre‑place:
    - One Crafting Table adjacent to the player’s spawn (use place_adjacent_to_existing with target_block_type=PATH? Instead, explicitly place at a fixed adjacent coordinate to guarantee adjacency: builder.place_block(0, BlockType.CRAFTING_TABLE, (spawn_row, spawn_col+1)).
    - One Furnace placed adjacent to the crafting table (or at another adjacent cell to the player) using builder.place_block(0, BlockType.FURNACE, (spawn_row+1, spawn_col)).
    - Three Iron Ore blocks placed using place_randomly_near(rng, 0, BlockType.IRON, player_spawn, min_dist=3, max_dist=8, n=3, on_blocks=[BlockType.STONE]).
  - On level 1, place exactly one LADDER_DOWN using place_randomly_near(rng, 1, BlockType.LADDER_DOWN, target_pos=player_spawn_on_floor1, min_dist=2, max_dist=10, n=1, on_blocks=[BlockType.PATH]).
- Mechanics:
  - melee_spawn_multiplier = 1.0
  - ranged_spawn_multiplier = 1.0
  - passive_spawn_multiplier = 1.0
  - mob_health_multiplier = 1.0
  - mob_damage_multiplier = 1.0
  - needs_depletion_multiplier = 0.25
  - health_recover_multiplier = 2.0
  - monsters_killed_to_clear_level = 8
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.MAKE_IRON_PICKAXE,
            Achievement.MAKE_IRON_SWORD,
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_SWORD,
            Achievement.COLLECT_WOOD,
            Achievement.COLLECT_STONE,
            Achievement.COLLECT_COAL,
            Achievement.PLACE_TABLE,
            Achievement.PLACE_FURNACE,
            Achievement.FIND_BOW,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_TORCH,
        ]
        self.label = "MAKE_IRON_PICKAXE, MAKE_IRON_SWORD, ENTER_DUNGEON, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            needs_depletion_multiplier=0.25,
            health_recover_multiplier=2.0,
            monsters_killed_to_clear_level=8,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        # Split the RNG for various parts of world building
        rng, build_rng, iron_rng, ladder_rng = jax.random.split(rng, 4)

        # 1. Create the world builder and set up the overworld
        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Spawn on floor 0 (Overworld) at default center position
        builder.set_starting_floor(0)

        # Equip the starting inventory and stats
        builder.set_player_inventory({
            "pickaxe": 2,      # stone pickaxe
            "sword": 2,        # stone sword
            "bow": 1,          # bow
            "arrows": 15,
            "torches": 10,
            "wood": 5,
            "stone": 5,
            "coal": 5,
        })
        builder.set_player_stats(dexterity=1, strength=1, intelligence=1)

        # Unlock the ladder down on floor 0 immediately
        builder.set_monsters_killed(0, 8)

        # 2. Pre-place blocks on floor 0
        # Player spawn at centre (map_size // 2, map_size // 2)
        spawn_center = (
            self.static_params.map_size[0] // 2,
            self.static_params.map_size[1] // 2,
        )
        # Place Crafting Table adjacent to spawn (to the right)
        builder.place_block(0, BlockType.CRAFTING_TABLE, (spawn_center[0], spawn_center[1] + 1))
        # Place Furnace adjacent (below the spawn)
        builder.place_block(0, BlockType.FURNACE, (spawn_center[0] + 1, spawn_center[1]))

        # Place three Iron Ore blocks near spawn on stone blocks
        builder.place_randomly_near(
            iron_rng,
            level=0,
            block_type=BlockType.IRON,
            target_pos=spawn_center,
            min_dist=3,
            max_dist=8,
            n=3,
            on_blocks=[BlockType.STONE],
        )

        # 3. Build the initial state
        state = builder.build(rng)

        # 4. Place a guaranteed ladder down on floor 1 near the spawn point
        #    (the up-ladder position where the player will appear)
        floor1_spawn = state.up_ladders[1]   # spawn point on floor 1 (up ladder)

        # Helper to randomly place an item (LADDER_DOWN) on a nearby path block
        def place_ladder_down_near(rng_key, state, level, target_pos, min_dist, max_dist):
            map_level = state.map[level]
            h, w = map_level.shape
            rows, cols = jnp.indices((h, w))
            dist_map = jnp.abs(rows - target_pos[0]) + jnp.abs(cols - target_pos[1])
            distance_mask = (dist_map &gt;= min_dist) &amp; (dist_map &lt;= max_dist)
            # Valid locations: PATH blocks within the distance ring
            valid_mask = (map_level == BlockType.PATH.value) &amp; distance_mask
            # Also avoid existing items (optional, but safer)
            valid_mask = valid_mask &amp; (state.item_map[level] == ItemType.NONE.value)

            flat_valid = valid_mask.ravel()
            n_valid = flat_valid.sum()
            # Use jax.random.choice with uniform probability over valid cells
            rng_key, _rng = jax.random.split(rng_key)
            chosen_flat = jax.random.choice(_rng, jnp.arange(h * w), p=flat_valid / n_valid)
            row = chosen_flat // w
            col = chosen_flat % w

            new_item_map = state.item_map.at[level, row, col].set(ItemType.LADDER_DOWN.value)
            return state.replace(item_map=new_item_map)

        state = place_ladder_down_near(ladder_rng, state, 1, floor1_spawn, 2, 10)

        # 5. Mark the pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
