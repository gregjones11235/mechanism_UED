- Map:
  - Place 2 passive snails (mob_name="snail", type_id=2) randomly within Manhattan distance 3–10 from the player’s spawn, on valid ground blocks (PATH).
  - Place 1 melee Orc Soldier (mob_name="orc_soldier", type_id=2) randomly within Manhattan distance 4–12 from the player’s spawn, on valid ground blocks (PATH).
  - Place 2 ranged Orc Mages (mob_name="orc_mage", type_id=2) randomly within Manhattan distance 5–15 from the player’s spawn, on valid ground blocks (PATH).
- Mechanics: needs_depletion_multiplier = 0.1, melee_spawn_multiplier = 0.0, ranged_spawn_multiplier = 0.0.</data>
      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to defeat a ranged orc mage on Floor 1 while handling nearby melee orc soldiers.

    Description: The agent is placed on floor 1 (the Dungeon), already in possession of a stone sword. Its goal is to locate and kill at least one Orc Mage (ranged attacker). The dungeon generation is standard (rooms/corridors with chests and fountains). Two orc mages and one orc soldier are pre‑placed at moderate distances, and passive snails provide optional food. Both melee and ranged spawn multipliers are set to zero so no additional mobs appear during the episode, keeping the challenge focused on the initial mixed group. Survival needs drain very slowly (multiplier 0.1) so health regeneration remains continuously active, removing hunger/thirst distractions.

    Relevant Achievements: DEFEAT_ORC_MAGE

    Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_SWORD, ENTER_DUNGEON

    World:
    - Player: Starts on floor 1. Inventory: {"sword": 2} (stone sword).
    - Map:
      - Place 2 passive snails (mob_name="snail", type_id=2) randomly within Manhattan distance 3–10 from the player’s spawn, on valid ground blocks (PATH).
      - Place 1 melee Orc Soldier (mob_name="orc_soldier", type_id=2) randomly within Manhattan distance 4–12 from the player’s spawn, on valid ground blocks (PATH).
      - Place 2 ranged Orc Mages (mob_name="orc_mage", type_id=2) randomly within Manhattan distance 5–15 from the player’s spawn, on valid ground blocks (PATH).
    - Mechanics: needs_depletion_multiplier = 0.1, melee_spawn_multiplier = 0.0, ranged_spawn_multiplier = 0.0.
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.DEFEAT_ORC_MAGE]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_SWORD,
            Achievement.ENTER_DUNGEON,
        ]
        self.label = "DEFEAT_ORC_MAGE"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.1,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, snail_rng, soldier_rng, mage_rng = jax.random.split(rng, 5)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(1)
        builder.set_player_inventory({"sword": 2})  # Stone sword

        # Place 2 passive snails (type_id=2) within distance 3-10 on PATH
        builder.add_mobs_randomly_near(
            snail_rng,
            level=1,
            mob_name="passive",
            type_id=2,
            n=2,
            target_pos=builder.player_position,
            min_dist=3,
            max_dist=10,
            on_blocks=[BlockType.PATH],
        )

        # Place 1 melee Orc Soldier (type_id=2) within distance 4-12 on PATH
        builder.add_mobs_randomly_near(
            soldier_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=1,
            target_pos=builder.player_position,
            min_dist=4,
            max_dist=12,
            on_blocks=[BlockType.PATH],
        )

        # Place 2 ranged Orc Mages (type_id=2) within distance 5-15 on PATH
        builder.add_mobs_randomly_near(
            mage_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=2,
            target_pos=builder.player_position,
            min_dist=5,
            max_dist=15,
            on_blocks=[BlockType.PATH],
        )

        return builder.build(rng)</data>
