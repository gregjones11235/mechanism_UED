import jax.numpy as jnp
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Teach the agent to fight and defeat Gnome Warriors and Gnome Archers in the pitch‑black Gnomish Mines while managing normal survival needs, directly addressing the global bottleneck at floor 2.

Description: The agent begins on floor 2 (Gnomish Mines) with gear typical of a successful floor 1 clear: an iron sword, a bow, 20 arrows, 10 torches, 5 wood, 10 stone, 5 coal, and two random‑colour potions. All player stats are default (STR 1, DEX 1, INT 1; full health/food/drink/energy/mana). Survival needs deplete at the standard rate (`needs_depletion_multiplier = 1.0`). The map is a normal SmoothGen Gnomish Mines: stone/grass terrain, stalagmites, lava lakes, and total darkness (light value 0.0). All mob spawn multipliers are 1.0, so Gnome Warriors (melee) and Gnome Archers (ranged) spawn normally, along with passive Bats that can be eaten for food. Water can be drunk from surface lakes. The agent must explore, light torches to see and reduce hostile spawns, locate and defeat at least one Gnome Warrior and one Gnome Archer, managing health and resources via potions, bats, and water. The task terminates successfully only when both DEFEAT_GNOME_WARRIOR and DEFEAT_GNOME_ARCHER are obtained; no descent to floor 3 is required. This focused combat‑on‑floor 2 experience directly builds the missing skill for global progression.

Relevant Achievements: DEFEAT_GNOME_WARRIOR, DEFEAT_GNOME_ARCHER

Completed Achievements: COLLECT_WOOD, COLLECT_STONE, COLLECT_COAL, MAKE_WOOD_PICKAXE, MAKE_STONE_SWORD, MAKE_ARROW, MAKE_TORCH, FIND_BOW, EAT_COW, COLLECT_DRINK, ENTER_DUNGEON, ENTER_GNOMISH_MINES, MAKE_IRON_SWORD, PLACE_TORCH, FIRE_BOW, DRINK_POTION

World:
- Player: Starting floor 2. Inventory:
    - iron_sword: 1
    - bow: 1
    - arrows: 20
    - torches: 10
    - wood: 5, stone: 10, coal: 5
    - potion_red: 1, potion_blue: 1 (random effects at runtime)
  Player stats default (Strength 1, Dexterity 1, Intelligence 1; all vitals full).
- Map: No explicit block modifications; floor 2 generates normally (SmoothGen with stalagmites, lava, ores, total darkness).
- Mechanics:
    - needs_depletion_multiplier = 1.0
    - monsters_killed_to_clear_level = 8 (floor 2 default; not relevant to terminal condition)
    - melee_spawn_multiplier = 1.0
    - ranged_spawn_multiplier = 1.0
    - passive_spawn_multiplier = 1.0
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.DEFEAT_GNOME_WARRIOR,
            Achievement.DEFEAT_GNOME_ARCHER,
        ]
        self.completed_achievements = [
            Achievement.COLLECT_WOOD,
            Achievement.COLLECT_STONE,
            Achievement.COLLECT_COAL,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_TORCH,
            Achievement.FIND_BOW,
            Achievement.EAT_COW,
            Achievement.COLLECT_DRINK,
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
            Achievement.MAKE_IRON_SWORD,
            Achievement.PLACE_TORCH,
            Achievement.FIRE_BOW,
            Achievement.DRINK_POTION,
        ]
        self.label = "DEFEAT_GNOME_WARRIOR, DEFEAT_GNOME_ARCHER"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines)
        builder.set_starting_floor(2)

        # Equip starting gear: iron sword (sword=3), bow, arrows, torches, basic resources, potions
        potions = jnp.array([1, 0, 1, 0, 0, 0])  # red (idx 0) and blue (idx 2)
        builder.set_player_inventory({
            "sword": 3,       # iron sword
            "bow": 1,
            "arrows": 20,
            "torches": 10,
            "wood": 5,
            "stone": 10,
            "coal": 5,
            "potions": potions,
        })

        state = builder.build(rng)

        # Mark all pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
