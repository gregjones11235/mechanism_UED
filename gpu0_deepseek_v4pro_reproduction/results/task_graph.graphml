t_sapling": 0.09267840593141798, "collect_drink": 78.77664504170528, "place_plant": 0.09267840593141798, "place_stone": 90.82483781278962, "wake_up": 2.4096385542168677, "place_furnace": 96.84893419833179, "collect_iron": 44.76367006487489, "collect_diamond": 22.984244670991657, "make_iron_pickaxe": 24.65245597775718, "make_iron_sword": 34.56904541241891, "make_arrow": 99.62928637627432, "make_torch": 100.0, "place_torch": 95.55143651529194, "collect_sapphire": 21.594068582020387, "collect_ruby": 20.574606116774792, "make_diamond_pickaxe": 2.5949953660797034, "make_diamond_sword": 3.5217794253938832, "make_iron_armour": 1.7608897126969416, "enter_gnomish_mines": 98.70250231696015, "enter_dungeon": 100.0, "defeat_orc_solider": 100.0, "eat_snail": 96.01482854494903, "find_bow": 99.25857275254866, "fire_bow": 98.88785912882298, "open_chest": 99.25857275254866, "drink_potion": 69.23076923076923}, "average_episode_length": 253.13253012048193, "mean_return_percentage": 21.18103167007718, "mean_return": 47.86913157437442, "lp": NaN, "priority_score": 0.01280662680664912}]</data>
