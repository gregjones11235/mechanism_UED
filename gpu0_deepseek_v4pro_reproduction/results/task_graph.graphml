place_stone": 89.78102189781022, "eat_plant": 15.328467153284672, "defeat_skeleton": 46.35036496350365, "make_stone_pickaxe": 86.4963503649635, "wake_up": 91.97080291970804, "place_furnace": 89.78102189781022, "collect_coal": 88.68613138686132, "collect_iron": 80.2919708029197, "collect_diamond": 28.83211678832117, "make_iron_pickaxe": 27.73722627737226, "make_iron_sword": 53.64963503649635, "make_arrow": 95.98540145985402, "make_torch": 100.0, "place_torch": 100.0, "collect_sapphire": 25.182481751824817, "collect_ruby": 25.547445255474454, "make_diamond_pickaxe": 2.18978102189781, "make_diamond_sword": 5.109489051094891, "make_iron_armour": 6.934306569343065, "enter_gnomish_mines": 62.043795620437955, "enter_dungeon": 100.0, "defeat_orc_solider": 98.17518248175182, "defeat_orc_mage": 91.97080291970804, "eat_snail": 98.17518248175182, "find_bow": 99.27007299270073, "fire_bow": 95.98540145985402, "open_chest": 99.27007299270073, "drink_potion": 82.84671532846716}, "average_episode_length": 1025.4598540145985, "mean_return_percentage": 22.762048476257185, "mean_return": 51.44222955634124, "lp": NaN, "priority_score": 0.23549469870531195}]</data>
