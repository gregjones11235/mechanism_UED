      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to defeat an Orc Soldier on the first dungeon floor using basic stone‑tier equipment.
    Description: The agent spawns on Floor 1 (Dungeon) equipped with a stone sword and stone pickaxe, along with a small cushion of raw wood and stone. The task requires the agent to find and defeat a single Orc Soldier somewhere nearby (pre‑placed for this purpose). No survival needs drain, so the agent can focus entirely on combat and minimal navigation. The kill requirement to clear the floor is set to 1, meaning that after this victory the ladder down will open, naturally reinforcing progress. This isolates the next global bottleneck—melee combat against dungeon mobs—without reintroducing already‑mastered crafting or Overworld exploration.
    Relevant Achievements: DEFEAT_ORC_SOLIDER
    Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD
    World:
    - Player: Floor 1 (spawn at ladder‑up position). Inventory: {"sword": 1, "pickaxe": 1, "wood": 5, "stone": 5}. Stats: Strength 1, Dexterity 1, Intelligence 1. Health/Food/Drink/Energy/Mana all full (9/9). Learned spells: none. Weapon/Armour enchantments: none.
    - Map: 
        - Use default Dungeon generation for Floor 1. 
        - Place exactly one melee mob of type appropriate for Floor 1 (Orc Soldier) via `add_mobs_randomly_near` targeting the player spawn position, with n=1, min_dist=2, max_dist=6, on any walkable terrain.
    - Mechanics:
        "needs_depletion_multiplier": 0.0,
        "melee_spawn_multiplier": 1.0,
        "ranged_spawn_multiplier": 0.0,
        "passive_spawn_multiplier": 0.0,
        "monsters_killed_to_clear_level": 1,
        "health_recover_multiplier": 1.0,
        "mob_health_multiplier": 1.0,
        "mob_damage_multiplier": 1.0,
        "melee_trigger_distance": 10
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.DEFEAT_ORC_SOLIDER]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
        ]
        self.label = "DEFEAT_ORC_SOLIDER"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=0.0,
            passive_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=1,
            health_recover_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            melee_trigger_distance=10,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, mob_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Spawn on Floor 1 (Dungeon)
        builder.set_starting_floor(1)

        # Equip stone‑tier gear and some resources
        builder.set_player_inventory({
            "sword": 1,    # stone sword (confirmed: value 1 is stone)
            "pickaxe": 1,  # stone pickaxe
            "wood": 5,
            "stone": 5,
        })

        # Place exactly one Orc Soldier (melee type_id=2) near the player
        builder.add_mobs_randomly_near(
            mob_rng,
            level=1,
            mob_name="melee",
            type_id=2,      # Orc Soldier
            n=1,
            target_pos=builder.player_position,
            min_dist=2,
            max_dist=6,
            # on_blocks default includes PATH, which is the dungeon floor
        )

        return builder.build(rng)</data>
