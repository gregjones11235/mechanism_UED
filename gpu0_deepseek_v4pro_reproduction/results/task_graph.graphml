      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Genuinely explore the Overworld to locate scattered iron and coal ores, craft iron tools, then descend through the Dungeon to the Gnomish Mines.

Description: The episode begins on the Overworld (floor 0) with an empty inventory and no pre‑placed crafting stations. The ladder to the Dungeon is already unlocked (`set_monsters_killed(level=0, count=8)`, no overworld combat needed). Thirty Iron Ore blocks and twenty Coal Ore blocks are placed randomly across the entire Overworld map on any Stone blocks using `place_randomly`, forcing the agent to wander and search instead of depending on a dense near‑spawn cluster. The agent must collect wood, craft a Wood Pickaxe and Wood Sword, mine stone, craft a Stone Pickaxe, find and mine at least one iron ore and one coal ore, place a Crafting Table and a Furnace, craft an Iron Pickaxe and an Iron Sword, then descend to the Dungeon (floor 1). On floor 1, a standard dungeon layout is generated; the LADDER_DOWN block appears somewhere on a PATH tile in the maze—the agent must defeat at least 8 hostile mobs (Orc Soldiers and Orc Mages) to unlock the ladder, find it, step on it, and `DESCEND` to floor 2, thereby achieving `ENTER_GNOMISH_MINES`. Survival needs remain greatly reduced so the focus stays on exploration, resource gathering, combat, and the hunt for iron.

Relevant Achievements: MAKE_IRON_PICKAXE, MAKE_IRON_SWORD, ENTER_DUNGEON, ENTER_GNOMISH_MINES
Completed Achievements: (none)

World:
- Player:
  - Starting floor = 0.
  - Inventory: completely empty (all counts 0).
  - Stats: dexterity=1, strength=1, intelligence=1.
  - `set_monsters_killed(level=0, count=8)` – Ladder down to floor 1 instantly usable.
- Map:
  - Level 0:
    - Place 30 Iron Ore blocks using `place_randomly(rng, 0, BlockType.IRON, 30, [BlockType.STONE])`.
    - Place 20 Coal Ore blocks using `place_randomly(rng, 0, BlockType.COAL, 20, [BlockType.STONE])`.
  - Level 1:
    - No manual ladder placement; the default dungeon generation places a single `LADDER_DOWN` on a PATH tile.
- Mechanics:
  - `needs_depletion_multiplier = 0.25`
  - `health_recover_multiplier = 2.0`
  - `monsters_killed_to_clear_level = 8` (effective for floor 1)
  - All other TaskParams at default.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.MAKE_IRON_PICKAXE,
            Achievement.MAKE_IRON_SWORD,
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = []
        self.label = "MAKE_IRON_PICKAXE, MAKE_IRON_SWORD, ENTER_DUNGEON, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.25,
            health_recover_multiplier=2.0,
            monsters_killed_to_clear_level=8,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, iron_rng, coal_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld)
        builder.set_starting_floor(0)

        # Overworld ladder down is immediately available
        builder.set_monsters_killed(level=0, count=8)

        # No inventory – empty by default.
        # Stats remain at default (1/1/1), no need to call set_player_stats.

        # Scatter 30 iron ore blocks on any stone tile
        builder.place_randomly(
            iron_rng,
            level=0,
            block_type=BlockType.IRON,
            n=30,
            on_blocks=[BlockType.STONE],
        )

        # Scatter 20 coal ore blocks on any stone tile
        builder.place_randomly(
            coal_rng,
            level=0,
            block_type=BlockType.COAL,
            n=20,
            on_blocks=[BlockType.STONE],
        )

        state = builder.build(rng)

        # No completed achievements to mark
        return state</data>
