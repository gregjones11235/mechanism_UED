.0, "defeat_zombie": 4.53551912568306, "collect_stone": 99.39890710382514, "place_stone": 98.36065573770492, "eat_plant": 0.4371584699453552, "defeat_skeleton": 0.7103825136612022, "make_stone_pickaxe": 90.27322404371584, "make_stone_sword": 63.98907103825137, "wake_up": 92.95081967213115, "place_furnace": 97.81420765027322, "collect_coal": 99.67213114754098, "collect_iron": 11.530054644808743, "make_arrow": 72.8415300546448}, "average_episode_length": 153.6775956284153, "mean_return_percentage": 14.59913476534165, "mean_return": 32.994044569672134, "lp": NaN, "priority_score": 0.0032679387261488444}, {"session": 7, "sr": 0.9967931587386424, "achievement_srs": {"collect_wood": 99.94655264564405, "place_table": 99.51897381079637, "eat_cow": 92.03634420096205, "collect_sapling": 100.0, "collect_drink": 80.01068947087118, "place_plant": 99.83965793693213, "defeat_zombie": 3.794762159273116, "collect_stone": 99.35863174772848, "place_stone": 98.8241582041689, "eat_plant": 0.48102618920363444, "defeat_skeleton": 1.6034206306787815, "make_stone_pickaxe": 90.53981827899518, "make_stone_sword": 70.71084981293426, "wake_up": 94.70871191876002, "place_furnace": 98.0224478888295, "collect_coal": 99.67931587386424, "collect_iron": 11.918760021378942, "make_arrow": 74.6125066809193}, "average_episode_length": 146.34740780331373, "mean_return_percentage": 14.639417519912687, "mean_return": 33.08508359500267, "lp": NaN, "priority_score": 0.0031965574304820723}, {"session": 12, "sr": 0.9934711643090316, "achievement_srs": {"collect_wood": 99.89118607181719, "place_table": 99.34711643090316, "eat_cow": 90.26115342763873, "collect_sapling": 99.89118607181719, "collect_drink": 82.97062023939064, "place_plant": 99.61915125136018, "defeat_zombie": 4.080522306855277, "collect_stone": 99.18389553862895, "place_stone": 98.4766050054407, "eat_plant": 0.544069640914037, "defeat_skeleton": 5.00544069640914, "make_stone_pickaxe": 90.20674646354733, "make_stone_sword": 92.16539717083786, "wake_