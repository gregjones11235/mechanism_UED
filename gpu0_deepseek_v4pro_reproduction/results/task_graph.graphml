ckaxe": 27.0042194092827, "make_iron_sword": 35.0210970464135, "make_arrow": 99.57805907172995, "make_torch": 97.46835443037975, "place_torch": 97.0464135021097, "collect_sapphire": 37.552742616033754, "collect_ruby": 29.957805907172997, "make_diamond_pickaxe": 6.329113924050633, "make_diamond_sword": 7.172995780590718, "enter_gnomish_mines": 65.82278481012658, "enter_dungeon": 100.0, "defeat_orc_solider": 94.51476793248945, "defeat_orc_mage": 86.91983122362869, "eat_snail": 100.0, "find_bow": 100.0, "fire_bow": 99.57805907172995, "open_chest": 100.0, "drink_potion": 96.62447257383967}, "average_episode_length": 1178.6033755274261, "mean_return_percentage": 22.008504746835442, "mean_return": 49.7392207278481, "lp": NaN, "priority_score": 0.22496394808524275}]</data>
