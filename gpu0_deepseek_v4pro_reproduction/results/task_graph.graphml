      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Clear Floor 1 under slightly increased combat pressure to reinforce sustained fighting and resource endurance before descending to the Gnomish Mines.

Description: The agent begins on Floor 1 (Dungeon) with a stone sword, stone pickaxe, bow, 10 arrows, and 20 torches, exactly the gear of a competent adventurer who finished the overworld. All survival needs are active (hunger, thirst, fatigue). The key difference from the prior task is that the floor now requires 6 monster kills (`monsters_killed_to_clear_level = 6`) to unlock the ladder down, compared to 4 previously. This forces the agent to engage in longer combat sequences, manage health and consumables more carefully, and navigate the procedurally generated dungeon more thoroughly to find enough hostile mobs (orcs). Fountains provide water, snails supply food, and chests may contain potions or other loot. The agent must kill 6 melee or ranged orcs without dying, then find the ladder down and use the DESCEND action to enter Floor 2 (Gnomish Mines).

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, COLLECT_WOOD, PLACE_TABLE, COLLECT_STONE, FIND_BOW, ENTER_DUNGEON

World:
- Player: `set_starting_floor(1)`. Inventory: `{"stone_pickaxe": 1, "stone_sword": 1, "bow": 1, "arrows": 10, "torch": 20}`. All survival stats at maximum (health=9, food=9, drink=9, energy=9). Attributes: Strength 1, Dexterity 1, Intelligence 1.
- Map: No manual block placements. Default procedural dungeon generation for Floor 1; other floors remain default.
- Mechanics:
  - monsters_killed_to_clear_level = 6
  - needs_depletion_multiplier = 1.0
  - mob_health_multiplier = 1.0
  - mob_damage_multiplier = 1.0
  - melee_spawn_multiplier = 1.0
  - ranged_spawn_multiplier = 1.0
  - passive_spawn_multiplier = 1.0
  - health_recover_multiplier = 1.0
  - health_loss_multiplier = 1.0
  - mana_recover_multiplier = 1.0
  - growing_plants_age = 600
  - All other parameters at original Craftax defaults.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.COLLECT_WOOD,
            Achievement.PLACE_TABLE,
            Achievement.COLLECT_STONE,
            Achievement.FIND_BOW,
            Achievement.ENTER_DUNGEON,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=6,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on Floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Equip starting inventory: stone pickaxe, stone sword, bow, arrows, torches
        builder.set_player_inventory({
            "pickaxe": 2,   # stone pickaxe
            "sword": 2,     # stone sword
            "bow": 1,
            "arrows": 10,
            "torches": 20,
        })

        # Reset kill counter on floor 1 to enforce the 6-kill requirement
        builder.set_monsters_killed(level=1, count=0)

        state = builder.build(rng)

        # Mark all achievements that are considered already completed
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
