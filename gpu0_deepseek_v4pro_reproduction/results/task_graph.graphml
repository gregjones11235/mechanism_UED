: 91.45569620253164, "wake_up": 92.0886075949367, "place_furnace": 100.0, "collect_coal": 88.60759493670886, "collect_iron": 78.79746835443038, "collect_diamond": 31.962025316455698, "make_iron_pickaxe": 31.962025316455698, "make_iron_sword": 60.12658227848101, "make_arrow": 99.68354430379746, "place_torch": 100.0, "collect_sapphire": 32.278481012658226, "collect_ruby": 25.949367088607595, "make_diamond_pickaxe": 5.379746835443038, "make_diamond_sword": 4.430379746835443, "make_iron_armour": 4.430379746835443, "enter_gnomish_mines": 81.64556962025317, "enter_dungeon": 99.68354430379746, "defeat_orc_solider": 97.78481012658227, "defeat_orc_mage": 89.24050632911393, "eat_snail": 96.83544303797468, "find_bow": 99.0506329113924, "fire_bow": 99.0506329113924, "open_chest": 99.0506329113924, "drink_potion": 79.74683544303798}, "average_episode_length": 890.5316455696203, "mean_return_percentage": 26.132148476881927, "mean_return": 59.05865555775316, "lp": NaN, "priority_score": 0.149855792340971}]</data>
