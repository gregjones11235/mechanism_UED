      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to survive and clear the dark Gnomish Mines by defeating gnome warriors and archers, then descend to the Sewers.

Description:
The agent begins on floor 2 (Gnomish Mines, pitch black) with a fully prepared inventory and full stats. The agent must use the provided stone sword and bow to defeat 8 gnome mobs (melee Gnome Warriors and ranged Gnome Archers) to unlock the ladder down, then descend to floor 3 (ENTER_SEWERS). The mines are completely dark (light level 0.0), so the agent must place torches to see mobs and navigate. The agent starts with 20 torches, a bow, and 20 arrows, as well as extra wood, stone, and coal to craft additional arrows or torches if desired. All overworld and dungeon prerequisites are already met (achievements marked completed), so training focuses entirely on dark‑level combat and light management.

Relevant Achievements: ENTER_SEWERS, DEFEAT_GNOME_WARRIOR, DEFEAT_GNOME_ARCHER
Completed Achievements: COLLECT_WOOD, PLACE_TABLE, EAT_COW, COLLECT_SAPLING, COLLECT_DRINK, MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD, PLACE_PLANT, DEFEAT_ZOMBIE, COLLECT_STONE, PLACE_STONE, EAT_PLANT, DEFEAT_SKELETON, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, WAKE_UP, PLACE_FURNACE, COLLECT_COAL, COLLECT_IRON, MAKE_ARROW, MAKE_TORCH, PLACE_TORCH, ENTER_DUNGEON, ENTER_GNOMISH_MINES, DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, FIND_BOW, FIRE_BOW, OPEN_CHEST, DRINK_POTION
World:
- Player:
  - Starting floor: 2
  - Inventory:
    - stone_sword: 1
    - stone_pickaxe: 1
    - bow: 1
    - arrows: 20
    - torches: 20
    - wood: 10
    - stone: 10
    - coal: 5
    - All other item counts zero.
  - Attributes: strength=1, dexterity=1, intelligence=1.
  - Status bars: health=9, food=9, drink=9, energy=9, mana=9.
  - Enchantments: sword=0, bow=0, armour slots all 0.
  - Learned spells: fireball=False, iceball=False.
- Map: No manual block modifications; the Gnomish Mines (floor 2) and all subsequent floors use the default world generation (pitch‑black smooth‑gen with stalagmites, stone, ores, etc.). No additional mobs, blocks, or items are placed.
- Mechanics:
  - monsters_killed_to_clear_level = 8
  - needs_depletion_multiplier = 0.75
  - All other TaskParams remain at default (mob_damage_multiplier=1.0, melee_spawn_multiplier=1.0, ranged_spawn_multiplier=1.0, passive_spawn_multiplier=1.0, mob_health_multiplier=1.0, melee_trigger_distance=10, health_recover_multiplier=1.0, health_loss_multiplier=1.0, mana_recover_multiplier=1.0, growing_plants_age=600).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_SEWERS,
            Achievement.DEFEAT_GNOME_WARRIOR,
            Achievement.DEFEAT_GNOME_ARCHER,
        ]
        self.completed_achievements = [
            Achievement.COLLECT_WOOD,
            Achievement.PLACE_TABLE,
            Achievement.EAT_COW,
            Achievement.COLLECT_SAPLING,
            Achievement.COLLECT_DRINK,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.PLACE_PLANT,
            Achievement.DEFEAT_ZOMBIE,
            Achievement.COLLECT_STONE,
            Achievement.PLACE_STONE,
            Achievement.EAT_PLANT,
            Achievement.DEFEAT_SKELETON,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.WAKE_UP,
            Achievement.PLACE_FURNACE,
            Achievement.COLLECT_COAL,
            Achievement.COLLECT_IRON,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_TORCH,
            Achievement.PLACE_TORCH,
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
            Achievement.DEFEAT_ORC_SOLIDER,
            Achievement.DEFEAT_ORC_MAGE,
            Achievement.FIND_BOW,
            Achievement.FIRE_BOW,
            Achievement.OPEN_CHEST,
            Achievement.DRINK_POTION,
        ]
        self.label = "ENTER_SEWERS, DEFEAT_GNOME_WARRIOR, DEFEAT_GNOME_ARCHER"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
            needs_depletion_multiplier=0.75,
            # All other multipliers remain at their default values (1.0)
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines)
        builder.set_starting_floor(2)

        # Set starting inventory
        builder.set_player_inventory({
            "sword": 1,        # stone sword (tier 1)
            "pickaxe": 1,      # stone pickaxe (tier 1)
            "bow": 1,
            "arrows": 20,
            "torches": 20,
            "wood": 10,
            "stone": 10,
            "coal": 5,
            # All other items default to 0
        })

        # Player stats: all default except they are already max (full health etc.)
        # By default, health etc. are 9, but we can leave them as they are built in WorldBuilder.
        # Attributes: strength=1, dexterity=1, intelligence=1 are default.

        # Pre-unlock the ladder from floor 1 to floor 2 in case of accidental ascent
        builder.set_monsters_killed(level=1, count=10)

        # No manual block/mob modifications; default world generation
        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
