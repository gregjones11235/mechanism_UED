eturn_percentage": 18.034982936758773, "mean_return": 40.75906143707483, "lp": NaN, "priority_score": 0.08708434242933753}, {"session": 35, "sr": 0.9085290482076638, "achievement_srs": {"eat_cow": 86.65018541409147, "collect_sapling": 98.39307787391841, "collect_drink": 94.19035846724351, "make_wood_sword": 98.02224969097651, "place_plant": 97.77503090234858, "collect_stone": 100.0, "place_stone": 98.8875154511743, "eat_plant": 0.7416563658838071, "make_stone_pickaxe": 98.02224969097651, "make_stone_sword": 86.8974042027194, "wake_up": 84.67243510506799, "place_furnace": 99.75278121137207, "collect_coal": 99.6291718170581, "collect_iron": 94.56118665018542, "collect_diamond": 8.15822002472188, "make_iron_pickaxe": 90.85290482076638, "make_iron_sword": 22.249690976514216, "make_arrow": 95.67367119901112, "make_torch": 94.56118665018542, "place_torch": 86.52657601977751, "collect_sapphire": 4.8207663782447465, "collect_ruby": 6.9221260815822, "make_diamond_pickaxe": 1.3597033374536465, "make_diamond_sword": 0.24721878862793573, "make_iron_armour": 0.6180469715698393, "enter_dungeon": 60.07416563658838, "find_bow": 58.71446229913474, "fire_bow": 49.567367119901114, "open_chest": 58.71446229913474, "drink_potion": 25.216316440049443}, "average_episode_length": 344.1334981458591, "mean_return_percentage": 19.214261638973056, "mean_return": 43.42423130407911, "lp": NaN, "priority_score": 0.08310401677054033}]</data>
