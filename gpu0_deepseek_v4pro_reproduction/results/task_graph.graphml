_pickaxe": 10.505529225908372, "make_iron_sword": 10.268562401263823, "make_arrow": 100.0, "place_torch": 96.99842022116904, "collect_sapphire": 23.380726698262244, "collect_ruby": 23.143759873617693, "make_diamond_pickaxe": 3.5545023696682465, "make_diamond_sword": 3.712480252764613, "enter_gnomish_mines": 64.53396524486571, "enter_dungeon": 100.0, "defeat_orc_solider": 97.78830963665087, "defeat_orc_mage": 89.02053712480253, "find_bow": 100.0, "fire_bow": 99.84202211690364, "open_chest": 95.260663507109, "drink_potion": 69.58925750394944}, "average_episode_length": 222.5955766192733, "mean_return_percentage": 16.06505725606048, "mean_return": 36.307029398696685, "lp": NaN, "priority_score": 0.22887638542610353}, {"session": 86, "sr": 0.6214405360134003, "achievement_srs": {"collect_wood": 33.41708542713568, "place_table": 28.894472361809044, "collect_sapling": 34.33835845896147, "collect_drink": 76.46566164154103, "make_wood_pickaxe": 47.98994974874372, "make_wood_sword": 100.0, "place_plant": 33.91959798994975, "collect_stone": 35.76214405360134, "place_stone": 35.5108877721943, "make_stone_pickaxe": 24.706867671691793, "wake_up": 64.99162479061977, "place_furnace": 35.25963149078727, "collect_coal": 53.18257956448911, "collect_iron": 48.91122278056952, "collect_diamond": 27.47068676716918, "make_iron_pickaxe": 12.73031825795645, "make_iron_sword": 11.474036850921273, "make_arrow": 100.0, "place_torch": 98.65996649916248, "collect_sapphire": 22.613065326633166, "collect_ruby": 22.445561139028477, "make_diamond_pickaxe": 4.355108877721943, "make_diamond_sword": 2.680067001675042, "enter_gnomish_mines": 62.14405360134003, "enter_dungeon": 100.0, "defeat_orc_solider": 95.97989949748744, "defeat_orc_mage": 86.93467336683418, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 94.13735343383584, "drink_potion": 74.5393634840871}, "average_episode_length": 236.2780569514238, "mean_return_percentage": 15.92346382307926, "mean_return": 35.98702824015913, "lp": NaN, "priority_score": 0.23525219621277801}]</data>
