      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to survive and progress on Floor 1 with normal survival pressure, requiring the agent to manage hunger actively by eating snails and potentially growing plants, while still placing a crafting table and clearing the dungeon to enter the Gnomish Mines.

Description: This task builds on the previous training by raising the survival demands to their original level. The agent starts on Floor 1 (the Dungeon) with a Wood Pickaxe, a Wood Sword, 5 wood, and 5 stone. No crafting table is provided; the agent must place one using 2 wood (action `PLACE_TABLE`). Hunger and thirst now deplete at the normal rate (multiplier 1.0), forcing the agent to eat snails and/or plant saplings from grass to sustain itself. Two passive Snails are spawned near the player as an initial food source. Hostile spawns remain low (melee 0.5, ranged 0.4) to avoid overwhelming combat while the agent learns to balance needs and crafting. An Orc Soldier and an Orc Mage are placed 5‑8 tiles from spawn to provide immediate threat. Three extra Chests are placed within 5‑10 tiles to ensure Bow availability. The agent must locate a Bow from a chest, craft arrows at its table, defeat 8 hostile mobs to clear the floor, then descend the ladder to reach Floor 2, unlocking `ENTER_GNOMISH_MINES`.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: COLLECT_WOOD, COLLECT_STONE, MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD

World:
- Player: Start on Floor 1 (spawn at ladder‑up position). Inventory: {"pickaxe": 1, "sword": 1, "wood": 5, "stone": 5}. All stats at default (1/1/1), full health/hunger/thirst/energy/mana. No enchantments, no spells learned.
- Map:
  - Default Dungeon generation for Floor 1.
  - No pre‑placed crafting table.
  - Place three additional Chests randomly on `BlockType.PATH` within 5–10 Manhattan distance of the player spawn using `place_randomly_near`.
  - Place one melee mob (Orc Soldier, "melee", type_id=2) via `add_mobs_randomly_near` at target_pos = player spawn, n=1, min_dist=5, max_dist=8, on_blocks=[BlockType.PATH].
  - Place one ranged mob (Orc Mage, "ranged", type_id=2) via `add_mobs_randomly_near` at target_pos = player spawn, n=1, min_dist=5, max_dist=8, on_blocks=[BlockType.PATH].
  - Place two passive mobs (Snail, "passive", type_id=2) via `add_mobs_randomly_near` at target_pos = player spawn, n=2, min_dist=3, max_dist=8, on_blocks=[BlockType.PATH].
- Mechanics:
  - `needs_depletion_multiplier`: 1.0
  - `melee_spawn_multiplier`: 0.5
  - `ranged_spawn_multiplier`: 0.4
  - `passive_spawn_multiplier`: 0.5
  - `monsters_killed_to_clear_level`: 8
  - All other mechanics at default (`health_recover_multiplier`: 1.0, `health_loss_multiplier`: 1.0, `mob_health_multiplier`: 1.0, `mob_damage_multiplier`: 1.0).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.COLLECT_WOOD,
            Achievement.COLLECT_STONE,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        return TaskParams(
            needs_depletion_multiplier=1.0,
            melee_spawn_multiplier=0.5,
            ranged_spawn_multiplier=0.4,
            passive_spawn_multiplier=0.5,
            monsters_killed_to_clear_level=8,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        rng, build_rng = jax.random.split(rng)
        # RNGs for mobs and chests
        rng, chest_rng, orc_soldier_rng, orc_mage_rng, snails_rng = jax.random.split(rng, 5)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Equip starting inventory: wood pickaxe, wood sword, 5 wood, 5 stone
        builder.set_player_inventory({
            "pickaxe": 1,   # wood pickaxe
            "sword": 1,     # wood sword
            "wood": 5,
            "stone": 5,
        })

        # Get player spawn position for later placements
        spawn_pos = builder.player_position

        # Place 3 extra Chests within 5-10 Manhattan tiles on PATH
        builder.place_randomly_near(
            chest_rng,
            level=1,
            block_type=BlockType.CHEST,
            target_pos=spawn_pos,
            min_dist=5,
            max_dist=10,
            n=3,
            on_blocks=[BlockType.PATH],
        )

        # Orc Soldier (melee, type_id=2): 5-8 distance, 1 mob
        builder.add_mobs_randomly_near(
            orc_soldier_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=1,
            target_pos=spawn_pos,
            min_dist=5,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        # Orc Mage (ranged, type_id=2): 5-8 distance, 1 mob
        builder.add_mobs_randomly_near(
            orc_mage_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=1,
            target_pos=spawn_pos,
            min_dist=5,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        # Two passive Snails (passive, type_id=2): 3-8 distance, 2 mobs
        builder.add_mobs_randomly_near(
            snails_rng,
            level=1,
            mob_name="passive",
            type_id=2,
            n=2,
            target_pos=spawn_pos,
            min_dist=3,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        state = builder.build(rng)

        # Mark pre-completed achievements
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
