      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to clear the Overworld by fighting melee mobs and descending to the Dungeon (Floor 1).

    Description: The player must achieve the ENTER_DUNGEON achievement by killing enough hostile mobs to unlock the ladder on Floor 0 and then using the DESCEND action. The agent starts on Floor 0 with a wood pickaxe, a wood sword, and 5 wood in its inventory. A crafting table is placed directly adjacent to the starting position. Five stone blocks are scattered within 2–5 tiles of the spawn so the agent can optionally craft a stone pickaxe or sword. Two zombies (melee, type_id=0) are placed in open terrain 8–12 tiles away to provide combat practice; no other mobs are manually placed. Passive and ranged mob spawning is disabled, melee spawn rate is very low, and the number of kills required to clear the level is reduced to 4. Melee mob damage and health are lowered to make fights forgiving, and survival needs are slowed to keep attention on combat and descent. The ladder down location is determined by the default world generation; the agent must explore to find it.

    Relevant Achievements: ENTER_DUNGEON
    Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD
    World:
    - Player: Starts on floor 0 with inventory: wood pickaxe (1), wood sword (1), wood (5). No other items.
    - Map: On floor 0, place a CRAFTING_TABLE block directly adjacent to the player’s spawn location (one cell to the right). Use `place_randomly_near` to place 5 STONE blocks within min_dist=2, max_dist=5 of the player’s spawn position, on any non‑solid ground (GRASS, PATH, etc.). Add 2 ZOMBIE melee mobs (`mob_name="melee", type_id=0`) randomly within min_dist=8, max_dist=12 of the player, on passable terrain. Do not add any passive or ranged mobs.
    - Mechanics: melee_spawn_multiplier = 0.2, ranged_spawn_multiplier = 0.0, passive_spawn_multiplier = 0.0, mob_health_multiplier = 0.8, mob_damage_multiplier = 0.5, monsters_killed_to_clear_level = 4, needs_depletion_multiplier = 0.5, health_recover_multiplier = 2.0. All other TaskParams remain at default.
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_DUNGEON]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
        ]
        self.label = "ENTER_DUNGEON"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=0.2,
            ranged_spawn_multiplier=0.0,
            passive_spawn_multiplier=0.0,
            mob_health_multiplier=0.8,
            mob_damage_multiplier=0.5,
            monsters_killed_to_clear_level=4,
            needs_depletion_multiplier=0.5,
            health_recover_multiplier=2.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, stone_rng, zombie_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(0)

        # Give player starting inventory
        builder.set_player_inventory({"pickaxe": 1, "sword": 1, "wood": 5})

        # Place a crafting table one cell to the right of the player spawn
        table_row = builder.player_position[0]
        table_col = builder.player_position[1] + 1
        builder.place_block(
            level=0,
            block_type=BlockType.CRAFTING_TABLE,
            position=(table_row, table_col),
        )

        # Place 5 stone blocks near the player (distance 2-5)
        builder.place_randomly_near(
            stone_rng,
            level=0,
            block_type=BlockType.STONE,
            n=5,
            target_pos=builder.player_position,
            min_dist=2,
            max_dist=5,
        )

        # Place 2 zombies at a moderate distance (8-12 tiles)
        builder.add_mobs_randomly_near(
            zombie_rng,
            level=0,
            mob_name="melee",
            type_id=0,  # Zombie
            n=2,
            target_pos=builder.player_position,
            min_dist=8,
            max_dist=12,
        )

        return builder.build(rng)</data>
