      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Force the agent to use a bow to kill an unreachable Orc Mage before entering the Gnomish Mines, strengthening ranged‑combat skills.

Description: The agent starts on Floor 0 with no equipment. Survival and combat parameters are the same as the trained task: `needs_depletion_multiplier = 0.5`, `melee_spawn_multiplier = 0.6`, `ranged_spawn_multiplier = 0.5`, `passive_spawn_multiplier = 1.5`. The Overworld ladder down is locked (kill requirement 8, initial kills set to 0), so the agent must first chop wood, mine stone, craft a Wood Pickaxe, Stone Sword, arrows, and defeat 8 hostile mobs on Floor 0. Upon descending to Floor 1 (the Dungeon), the agent must find a Chest (naturally generated) to obtain a Bow and arrows. The critical new challenge is that a single Orc Mage (ranged, type_id=2) is trapped behind a ring of lava near the player spawn point, making melee impossible. The lava ring is created by placing 30 LAVA blocks randomly on PATH tiles within a Manhattan distance of 2–6 from the spawn (using `place_randomly_near` with no explicit target). The Orc Mage is placed on a PATH tile at a distance of 8–12, ensuring it is on the far side of the lava. The agent must shoot the mage with arrows to earn the `FIRE_BOW` achievement. After killing the mage and meeting the floor’s kill requirement (8 hostile mobs total), the ladder down to Floor 2 opens. Stepping onto it grants `ENTER_GNOMISH_MINES` and finishes the episode successfully. Both `FIRE_BOW` and `ENTER_GNOMISH_MINES` must be completed for success.

Relevant Achievements: FIRE_BOW, ENTER_GNOMISH_MINES
Completed Achievements: None

World:
- Player: Floor 0 (spawn at center). Inventory: empty. Stats: Strength 1, Dexterity 1, Intelligence 1. Health/Food/Drink/Energy/Mana all full (9 / 9). Learned spells: none. Weapon/Armour enchantments: none.
- Map:
    - Floor 0: default Overworld generation. Use `builder.set_monsters_killed(level=0, count=0)` so the ladder down is blocked until 8 melee mobs are killed.
    - Floor 1: default Dungeon generation. After the default generation, add a lava barrier and the trapped mage:
        * Use `builder.place_randomly_near(rng, 1, BlockType.LAVA, target_pos=None, min_dist=2, max_dist=6, n=30, on_blocks=[BlockType.PATH])` to place a ring of lava near the player spawn.
        * Use `builder.add_mobs_randomly_near(rng, 1, "ranged", type_id=2, n=1, target_pos=None, min_dist=8, max_dist=12, on_blocks=[BlockType.PATH])` to place the Orc Mage on the far side of the lava.
- Mechanics:
    - "needs_depletion_multiplier": 0.5
    - "melee_spawn_multiplier": 0.6
    - "ranged_spawn_multiplier": 0.5
    - "passive_spawn_multiplier": 1.5
    - "monsters_killed_to_clear_level": 8
    - "health_recover_multiplier": 1.0
    - "health_loss_multiplier": 1.0
    - "mob_health_multiplier": 1.0
    - "mob_damage_multiplier": 1.0
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.FIRE_BOW,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = []
        self.label = "FIRE_BOW, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.5,
            melee_spawn_multiplier=0.6,
            ranged_spawn_multiplier=0.5,
            passive_spawn_multiplier=1.5,
            monsters_killed_to_clear_level=8,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, lava_rng, mob_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld)
        builder.set_starting_floor(0)

        # Lock the Overworld ladder by resetting the kill count
        builder.set_monsters_killed(0, 0)

        # Floor 1 spawn point (the up‑ladder tile, where the player appears when descending)
        floor1_spawn = builder.ladders_up[1]

        # Create a barrier of 30 lava blocks around the spawn, on PATH tiles
        builder.place_randomly_near(
            lava_rng,
            level=1,
            block_type=BlockType.LAVA,
            target_pos=floor1_spawn,
            min_dist=2,
            max_dist=6,
            n=30,
            on_blocks=[BlockType.PATH],
        )

        # Place a single Orc Mage (ranged, type_id=2) on the far side of the lava
        builder.add_mobs_randomly_near(
            mob_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=1,
            target_pos=floor1_spawn,
            min_dist=8,
            max_dist=12,
            on_blocks=[BlockType.PATH],
        )

        state = builder.build(rng)
        return state</data>
