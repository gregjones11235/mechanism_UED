      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Strengthen pure melee combat endurance on Floor 1 by clearing it without a bow and with the default kill requirement of 8 monsters, preparing the agent to reliably reach the Gnomish Mines in the full game.

Description: The agent starts on Floor 1 (Dungeon) with a stone sword, stone pickaxe, and 5 torches—a typical loadout after minimal overworld preparation—but without any bow or arrows. All survival needs are active (health, food, drink, energy maxed). The default monster line‑up persists: orc soldiers and orc mages spawn naturally. To unlock the ladder down to Floor 2 (Gnomish Mines), the agent must defeat **8 hostile mobs** (monsters_killed_to_clear_level = 8). Without a ranged option, every kill must be earned in melee, forcing the agent to manage multiple threats, closing distance to mages, and sustaining health through prolonged engagements. The task teaches the endurance necessary to clear the dungeon under conditions more representative of the original Craftax, where a bow may not be available early and the kill count is higher than in the parent task.

Relevant Achievements: ENTER_GNOMISH_MINES  
Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, COLLECT_WOOD, PLACE_TABLE, COLLECT_STONE, ENTER_DUNGEON  
World:
- Player: set_starting_floor(1). Inventory: {"stone_sword": 1, "stone_pickaxe": 1, "torch": 5}. No bow, no arrows, no armour. All survival stats set to maximum (health=9, food=9, drink=9, energy=9, mana=9). Attributes: Strength 1, Dexterity 1, Intelligence 1.
- Map: No manual block placements; default procedural dungeon generation for Floor 1, including chests, fountains, and mob spawns.
- Mechanics:
    monsters_killed_to_clear_level = 8
    All other TaskParams at original Craftax defaults (e.g., needs_depletion_multiplier = 1.0, mob_health_multiplier = 1.0, mob_damage_multiplier = 1.0, melee_spawn_multiplier = 1.0, ranged_spawn_multiplier = 1.0).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.COLLECT_WOOD,
            Achievement.PLACE_TABLE,
            Achievement.COLLECT_STONE,
            Achievement.ENTER_DUNGEON,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on Floor 1 (Dungeon)
        builder.set_starting_floor(1)

        # Equip starting inventory: stone sword, stone pickaxe, and 5 torches
        builder.set_player_inventory({
            "sword": 2,    # stone sword
            "pickaxe": 2,  # stone pickaxe
            "torches": 5,
        })

        # No manual block or mob placements; default dungeon generation is sufficient

        state = builder.build(rng)

        # Mark the pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
