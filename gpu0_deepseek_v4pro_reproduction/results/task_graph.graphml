180722891, "collect_diamond": 9.939759036144578, "make_iron_pickaxe": 28.313253012048193, "make_iron_sword": 81.02409638554217, "make_arrow": 84.93975903614458, "make_torch": 92.16867469879519, "place_torch": 89.1566265060241, "collect_sapphire": 7.831325301204819, "collect_ruby": 9.337349397590362, "make_diamond_pickaxe": 0.30120481927710846, "make_diamond_sword": 0.9036144578313253, "make_iron_armour": 91.56626506024097, "enter_dungeon": 95.18072289156626, "defeat_orc_solider": 9.337349397590362, "defeat_orc_mage": 8.132530120481928, "eat_snail": 28.012048192771083, "find_bow": 70.48192771084338, "fire_bow": 56.325301204819276, "open_chest": 70.48192771084338, "drink_potion": 32.83132530120482}, "average_episode_length": 866.5451807228916, "mean_return_percentage": 21.96361063029774, "mean_return": 49.63776002447289, "lp": NaN, "priority_score": 0.11050224996371028}]</data>
