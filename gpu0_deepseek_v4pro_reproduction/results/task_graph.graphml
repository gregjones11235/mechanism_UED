  - `monsters_killed_to_clear_level = 8` (applies to all floors; pre‑cleared floors 0 and 1 already meet this).</data>
      <data key="d3">import jax
import jax.numpy as jnp
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Descend from the Gnomish Mines (floor 2) to the Sewers (floor 3) by exploring the pitch‑black caverns, fighting Gnome Warriors and Archers, and locating the ladder down.

Description: The episode begins on floor 2 (Gnomish Mines) with the player spawning at the natural ladder‑up position. The floor is completely dark (base light level 0), requiring the agent to actively place torches to navigate. The player is equipped with iron tools, a bow, and a large supply of arrows and torches to focus the challenge on exploration, combat, and survival in the darkness. No terrain modifications are made; the default SmoothGen generation for the Gnomish Mines provides all blocks, including the randomly placed LADDER_DOWN. The agent must defeat 8 hostiles (Gnome Warriors and Gnome Archers) to satisfy the floor‑clear requirement. Once killed, stepping on the ladder down and using the DESCEND action will unlock `ENTER_SEWERS` and end the episode successfully. Mild survival mechanics (needs_depletion_multiplier = 0.5) ensure hunger and thirst are relevant but not overwhelming; passive bats on this floor can be hunted for food (granting EAT_BAT). All achievements from earlier floors (Overworld, Dungeon, Gnomish Mines entry, and crafting up to iron tools) are considered completed and are not required to be performed again.

Relevant Achievements: ENTER_SEWERS
Completed Achievements: COLLECT_WOOD, PLACE_TABLE, EAT_COW, COLLECT_SAPLING, COLLECT_DRINK, MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD, PLACE_PLANT, DEFEAT_ZOMBIE, COLLECT_STONE, PLACE_STONE, EAT_PLANT, DEFEAT_SKELETON, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, WAKE_UP, PLACE_FURNACE, COLLECT_COAL, COLLECT_IRON, COLLECT_DIAMOND, MAKE_IRON_PICKAXE, MAKE_IRON_SWORD, MAKE_ARROW, MAKE_TORCH, PLACE_TORCH, ENTER_DUNGEON, ENTER_GNOMISH_MINES, DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, EAT_SNAIL, FIND_BOW, FIRE_BOW, OPEN_CHEST, DRINK_POTION

World:
- Player:
  - Starting floor = 2.
  - Inventory: `{"wood": 20, "stone": 20, "coal": 10, "iron": 5, "pickaxe": 3, "sword": 3, "bow": 1, "arrows": 40, "torches": 40}`.
  - Stats: `dexterity=1, strength=1, intelligence=1`.
  - `set_monsters_killed(level=0, count=8)` and `set_monsters_killed(level=1, count=8)` to mark previous floors as cleared (no backtracking needed). Floor 2 kill count starts at 0.
- Map:
  - No additional block placements; use default SmoothGen generation for the Gnomish Mines, which includes the LADDER_DOWN.
- Mechanics:
  - `melee_spawn_multiplier = 1.0`
  - `ranged_spawn_multiplier = 1.0`
  - `passive_spawn_multiplier = 1.0`
  - `mob_health_multiplier = 1.0`
  - `mob_damage_multiplier = 1.0`
  - `needs_depletion_multiplier = 0.5`
  - `health_recover_multiplier = 1.0`
  - `health_loss_multiplier = 1.0`
  - `mana_recover_multiplier = 1.0`
  - `monsters_killed_to_clear_level = 8` (applies to all floors; pre‑cleared floors 0 and 1 already meet this).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_SEWERS,
        ]
        self.completed_achievements = [
            Achievement.COLLECT_WOOD,
            Achievement.PLACE_TABLE,
            Achievement.EAT_COW,
            Achievement.COLLECT_SAPLING,
            Achievement.COLLECT_DRINK,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.PLACE_PLANT,
            Achievement.DEFEAT_ZOMBIE,
            Achievement.COLLECT_STONE,
            Achievement.PLACE_STONE,
            Achievement.EAT_PLANT,
            Achievement.DEFEAT_SKELETON,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.WAKE_UP,
            Achievement.PLACE_FURNACE,
            Achievement.COLLECT_COAL,
            Achievement.COLLECT_IRON,
            Achievement.COLLECT_DIAMOND,
            Achievement.MAKE_IRON_PICKAXE,
            Achievement.MAKE_IRON_SWORD,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_TORCH,
            Achievement.PLACE_TORCH,
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
            Achievement.DEFEAT_ORC_SOLIDER,
            Achievement.DEFEAT_ORC_MAGE,
            Achievement.EAT_SNAIL,
            Achievement.FIND_BOW,
            Achievement.FIRE_BOW,
            Achievement.OPEN_CHEST,
            Achievement.DRINK_POTION,
        ]
        self.label = "ENTER_SEWERS"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            needs_depletion_multiplier=0.5,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            monsters_killed_to_clear_level=8,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines)
        builder.set_starting_floor(2)

        # Equip the starting inventory
        builder.set_player_inventory({
            "wood": 20,
            "stone": 20,
            "coal": 10,
            "iron": 5,
            "pickaxe": 3,   # iron pickaxe
            "sword": 3,     # iron sword
            "bow": 1,
            "arrows": 40,
            "torches": 40,
        })

        # Pre-clear floors 0 and 1 to avoid backtracking
        builder.set_monsters_killed(level=0, count=8)
        builder.set_monsters_killed(level=1, count=8)

        # No additional block or mob placements; default Gnomish Mines generation used

        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        # Set floor 2 to be completely dark (ambient light level 0, light_map all zeros)
        state = state.replace(
            light_level=jnp.asarray(0.0, dtype=jnp.float32),
            light_map=state.light_map.at[2].set(
                jnp.zeros(self.static_params.map_size, dtype=jnp.float32)
            ),
        )

        return state</data>
