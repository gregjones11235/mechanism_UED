      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Clear the Dungeon by defeating 7 enemies under more realistic survival pressure and mob density, then descend to the Gnomish Mines.

Description: The agent starts on Floor 1 (Dungeon) with the same combat loadout as the previous task—a bow, 10 arrows, and a wood sword—to keep offensive capabilities constant while we raise the environmental difficulty. Survival needs are now increased: the `needs_depletion_multiplier` is raised from 0.2 to **0.5**, making hunger, thirst, and fatigue accumulate at half the normal rate instead of nearly negligible. To provide a food source, passive mob spawns are re-enabled with `passive_spawn_multiplier` set to **0.3**, allowing snails to appear naturally in the Dungeon (bats do not spawn on Floor 1). Hostile mob spawn rates are pushed closer to original values: `melee_spawn_multiplier` goes from 0.5 to **0.6**, and `ranged_spawn_multiplier` from 0.4 to **0.5**. The floor‑clear requirement is increased from 6 to **7 kills** to further test sustained combat endurance. The agent must still manage health, arrows, and torches (darkness is not yet a major factor on this floor), but now must also actively seek and eat snails to avoid starvation. Two initial mobs—an Orc Soldier (melee, type_id=2) and an Orc Mage (ranged, type_id=2)—are placed 5–8 tiles from the spawn point to guarantee immediate combat opportunities. No other mobs are pre‑spawned; they will generate via the new spawn rates. This task directly addresses the global failure to enter the Gnomish Mines by forcing the agent to balance combat, resource gathering, and survival in a more authentic Dungeon environment, smoothly bridging the gap to the full game’s 8‑kill, full‑survival challenge.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: FIND_BOW, MAKE_WOOD_SWORD, MAKE_ARROW

World:
- Player: Floor 1 (spawn at ladder‑up position). Inventory: {"bow": 1, "arrows": 10, "sword": 1}. Stats: Strength 1, Dexterity 1, Intelligence 1. Health/Food/Drink/Energy/Mana all full (9/9). Learned spells: none. Weapon/Armour enchantments: none.
- Map:
    - Use default Dungeon generation for Floor 1.
    - Place exactly one melee mob (Orc Soldier, "melee", type_id=2) using `add_mobs_randomly_near`, with target_pos = player spawn coordinates, n=1, min_dist=5, max_dist=8, on_blocks = [BlockType.PATH].
    - Place exactly one ranged mob (Orc Mage, "ranged", type_id=2) using `add_mobs_randomly_near`, with target_pos = player spawn coordinates, n=1, min_dist=5, max_dist=8, on_blocks = [BlockType.PATH].
    - No other mobs are placed initially; spawning will generate the remainder.
- Mechanics:
    "needs_depletion_multiplier": 0.5,
    "melee_spawn_multiplier": 0.6,
    "ranged_spawn_multiplier": 0.5,
    "passive_spawn_multiplier": 0.3,
    "monsters_killed_to_clear_level": 7,
    "health_recover_multiplier": 1.0,
    "health_loss_multiplier": 1.0,
    "mob_health_multiplier": 1.0,
    "mob_damage_multiplier": 1.0
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.FIND_BOW,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_ARROW,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        return TaskParams(
            needs_depletion_multiplier=0.5,
            melee_spawn_multiplier=0.6,
            ranged_spawn_multiplier=0.5,
            passive_spawn_multiplier=0.3,
            monsters_killed_to_clear_level=7,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        rng, build_rng, melee_rng, ranged_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)
        builder.set_starting_floor(1)  # Start on Dungeon (floor 1)

        # Equip starting items
        builder.set_player_inventory({
            "bow": 1,
            "arrows": 10,
            "sword": 1,  # wood sword
        })

        # Get the player spawn position on floor 1 (the up-ladder position)
        player_spawn = builder.player_position

        # Place one melee Orc Soldier (type_id=2) near spawn
        builder.add_mobs_randomly_near(
            melee_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=1,
            target_pos=player_spawn,
            min_dist=5,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        # Place one ranged Orc Mage (type_id=2) near spawn
        builder.add_mobs_randomly_near(
            ranged_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=1,
            target_pos=player_spawn,
            min_dist=5,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        state = builder.build(rng)

        # Mark pre-completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
