  - `health_loss_multiplier = 1.0`
  - `mana_recover_multiplier = 1.0`
  - `growing_plants_age = 600`</data>
      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to manage survival needs while progressing to the Gnomish Mines.

Description: The agent starts on floor 0 (Overworld) with default attributes (strength 1, dexterity 1, intelligence 1) and an empty inventory. The world uses standard generation for all floors. The dungeon entrance (ladder‑down) on floor 0 is already unlocked. The agent must gather wood, stone, and coal, craft a stone sword and at least 4 torches, then locate the dungeon entrance, descend to floor 1 (Dungeon). In the dark dungeon, it must navigate, defeat exactly 5 hostile mobs (Orc Soldiers and Orc Mages) to unlock the ladder‑down to floor 2, and finally descend to the Gnomish Mines. Importantly, hunger, thirst, and fatigue now deplete at 60% of the normal rate (up from 20%), forcing the agent to actively seek food, water, and rest during its journey. All other mechanics remain as before.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: (none)

World:
- Player: Starting floor 0 (`set_starting_floor(0)`). Inventory empty. Default attributes.
- Map: No modifications – the Overworld (floor 0) uses the standard SmoothGen generation, and floor 1 uses the standard Dungeon generation.
- Mechanics:
  - `monsters_killed_to_clear_level = 5`
  - `mob_health_multiplier = 1.0`
  - `mob_damage_multiplier = 1.0`
  - `melee_spawn_multiplier = 1.0`
  - `ranged_spawn_multiplier = 1.0`
  - `passive_spawn_multiplier = 1.0`
  - `needs_depletion_multiplier = 0.6`
  - `health_recover_multiplier = 1.0`
  - `health_loss_multiplier = 1.0`
  - `mana_recover_multiplier = 1.0`
  - `growing_plants_age = 600`
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = []
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=5,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            needs_depletion_multiplier=0.6,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            growing_plants_age=600,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld)
        builder.set_starting_floor(0)

        # No inventory modifications; empty is default.
        # No block or mob placements; map is standard generation.

        state = builder.build(rng)

        # Mark completed achievements as True (none in this task)
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
