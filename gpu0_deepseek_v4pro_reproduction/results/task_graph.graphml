4736842105, "collect_coal": 76.63157894736842, "collect_iron": 46.73684210526316, "collect_diamond": 2.736842105263158, "make_iron_pickaxe": 6.105263157894737, "make_iron_sword": 8.631578947368421, "make_arrow": 73.6842105263158, "make_torch": 61.26315789473684, "place_torch": 60.421052631578945, "collect_sapphire": 2.1052631578947367, "collect_ruby": 2.9473684210526314, "make_diamond_pickaxe": 0.631578947368421, "make_diamond_sword": 0.21052631578947367, "enter_gnomish_mines": 0.8421052631578947, "enter_dungeon": 87.57894736842105, "defeat_orc_solider": 14.736842105263158, "find_bow": 17.473684210526315, "fire_bow": 9.052631578947368, "open_chest": 17.473684210526315, "drink_potion": 4.842105263157895}, "average_episode_length": 586.7221052631579, "mean_return_percentage": 10.237358814625058, "mean_return": 23.136430921052632, "lp": NaN, "priority_score": 0.12565096952908586}]</data>
