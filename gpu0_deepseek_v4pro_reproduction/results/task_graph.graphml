make_arrow": 99.6875, "make_torch": 100.0, "place_torch": 96.875, "make_iron_armour": 2.1875, "enter_dungeon": 89.0625}, "average_episode_length": 832.275, "mean_return_percentage": 14.549439016696628, "mean_return": 32.88173217773438, "lp": NaN, "priority_score": 0.097412109375}, {"session": 31, "sr": 0.9223057644110275, "achievement_srs": {"collect_wood": 100.0, "place_table": 100.0, "eat_cow": 99.49874686716792, "collect_sapling": 100.0, "collect_drink": 95.73934837092732, "place_plant": 100.0, "defeat_zombie": 99.49874686716792, "collect_stone": 100.0, "place_stone": 100.0, "eat_plant": 19.548872180451127, "wake_up": 97.4937343358396, "place_furnace": 99.74937343358395, "collect_coal": 100.0, "collect_iron": 76.69172932330827, "collect_diamond": 1.0025062656641603, "make_iron_pickaxe": 45.86466165413534, "make_iron_sword": 56.64160401002506, "make_arrow": 100.0, "make_torch": 100.0, "place_torch": 98.49624060150376, "make_iron_armour": 5.513784461152882, "enter_dungeon": 92.23057644110276}, "average_episode_length": 688.047619047619, "mean_return_percentage": 15.099861838293188, "mean_return": 34.125687754542604, "lp": NaN, "priority_score": 0.07165784134521773}]</data>
