      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Defeat at least one Gnome Warrior and one Gnome Archer on floor 2 (Gnomish Mines) to establish combat competence in the dark, mining‑style environment.

Description:
The agent begins on floor 2 (Gnomish Mines) at the ladder‑up position. It carries the equipment of a player who has competently cleared floor 1: a stone sword, a stone pickaxe, a bow, 15 arrows, and 5 torches. All vital stats are full (health 9, food 9, drink 9, energy 9, mana 9) and attributes are at base (STR 1, DEX 1, INT 1). No armour or enchantments are provided.

Two Gnome Warriors (melee, type_id 1) and one Gnome Archer (ranged, type_id 1) are spawned randomly on floor 2 within a Manhattan distance of 3–8 tiles from the player’s starting position, ensuring immediate combat encounters. Spawn rates for hostiles remain at default (1.0) so additional gnomes may appear over time, keeping pressure high.

Survival needs are drastically slowed (`needs_depletion_multiplier = 0.3`) to remove any starvation or thirst pressure and let the agent concentrate purely on fighting in the pitch‑black mines. The number of kills required to clear the floor is set to 10, preventing accidental ascension and keeping the agent focused on floor 2.

The episode terminates with success as soon as both `DEFEAT_GNOME_WARRIOR` and `DEFEAT_GNOME_ARCHER` achievements are earned. All earlier‑tier crafting achievements that are impossible because the agent already possesses stone tools are listed as completed and should not be pursued.

Relevant Achievements: DEFEAT_GNOME_WARRIOR, DEFEAT_GNOME_ARCHER
Completed Achievements: ENTER_GNOMISH_MINES, MAKE_WOOD_PICKAXE, MAKE_STONE_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_SWORD

World:
- Player: Start on floor 2 at the ladder‑up position. Inventory: stone sword (tier 2), stone pickaxe (tier 2), bow, 15 arrows, 5 torches. Stats: health 9, food 9, drink 9, energy 9, mana 9; STR 1, DEX 1, INT 1. No enchantments or learned spells.
- Map:
    - No block modifications.
    - Mobs: On floor 2, using `add_mobs_randomly_near`, place exactly 2 melee mobs of type “Gnome Warrior” (mob_name="melee", type_id=1) and 1 ranged mob of type “Gnome Archer” (mob_name="ranged", type_id=1). All placements use min_dist=3, max_dist=8 from the player’s start position, on any walkable ground.
- Mechanics:
    * melee_spawn_multiplier = 1.0
    * ranged_spawn_multiplier = 1.0
    * mob_health_multiplier = 1.0
    * mob_damage_multiplier = 1.0
    * monsters_killed_to_clear_level = 10
    * needs_depletion_multiplier = 0.3
    * All other TaskParams remain at their default values.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.DEFEAT_GNOME_WARRIOR,
            Achievement.DEFEAT_GNOME_ARCHER,
        ]
        self.completed_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_SWORD,
        ]
        self.label = "DEFEAT_GNOME_WARRIOR, DEFEAT_GNOME_ARCHER"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            monsters_killed_to_clear_level=10,
            needs_depletion_multiplier=0.3,
            # All other fields default
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, melee_rng, ranged_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines) at the ladder-up position
        builder.set_starting_floor(2)

        # Equip the player with stone tools, bow, arrows, torches
        builder.set_player_inventory({
            "pickaxe": 2,  # stone pickaxe
            "sword": 2,    # stone sword
            "bow": 1,
            "arrows": 15,
            "torches": 5,
        })

        # Spawn mobs near the player
        player_start_pos = builder.player_position  # ladder-up on floor 2

        # Place 2 melee Gnome Warriors (type_id=1)
        builder.add_mobs_randomly_near(
            melee_rng,
            level=2,
            mob_name="melee",        # mob class: melee
            type_id=1,               # Gnome Warrior
            n=2,
            target_pos=player_start_pos,
            min_dist=3,
            max_dist=8,
        )

        # Place 1 ranged Gnome Archer (type_id=1)
        builder.add_mobs_randomly_near(
            ranged_rng,
            level=2,
            mob_name="ranged",       # mob class: ranged
            type_id=1,               # Gnome Archer
            n=1,
            target_pos=player_start_pos,
            min_dist=3,
            max_dist=8,
        )

        state = builder.build(rng)

        # Mark pre-completed achievements as true
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
