      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Descend to the Gnomish Mines (floor 2) from the Dungeon (floor 1) by finding the ladder down and clearing the required monsters.

    Description: The agent starts on floor 1 (the Dungeon) at the default ladder‑up spawn point. All status bars (health, food, drink, energy, mana) are maxed at 9. The inventory is pre‑equipped with a stone sword (sword: 2), a stone pickaxe (pickaxe: 2), 64 torches, a bow (bow: 1), and 20 arrows (arrows: 20). Survival needs are completely disabled (`needs_depletion_multiplier = 0.0`), so the agent never gets hungry, thirsty, or tired. Hostile mobs (orcs, etc.) spawn at their normal rates (1.0× each). All mob damage is halved (`mob_damage_multiplier = 0.5`) to keep early dungeon encounters forgiving. The ladder down to floor 2 will not open until the agent defeats exactly 4 hostile monsters on this floor (`monsters_killed_to_clear_level = 4`). The episode ends successfully when the agent steps onto the ladder down and uses the DESCEND action, unlocking the `ENTER_GNOMISH_MINES` achievement. No extra blocks are placed; the procedural dungeon generation (rooms, corridors, chests, fountains, corner torches) is used unchanged.

    Relevant Achievements: ENTER_GNOMISH_MINES

    Completed Achievements: COLLECT_WOOD, COLLECT_STONE, COLLECT_COAL, MAKE_WOOD_PICKAXE, MAKE_STONE_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_SWORD, PLACE_TABLE, MAKE_TORCH, ENTER_DUNGEON, FIND_BOW

    World:
    - Player: Starts on floor 1 at the default ‘ladder‑up’ spawn position; inventory contains {"sword": 2, "pickaxe": 2, "torches": 64, "bow": 1, "arrows": 20}. Health, food, drink, energy, mana all set to 9.
    - Map: No block modifications. The default procedural dungeon layout is used as‑is.
    - Mechanics: "needs_depletion_multiplier = 0.0", "melee_spawn_multiplier = 1.0", "ranged_spawn_multiplier = 1.0", "mob_damage_multiplier = 0.5", "monsters_killed_to_clear_level = 4". All other TaskParams use default values.
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_GNOMISH_MINES]
        self.completed_achievements = [
            Achievement.COLLECT_WOOD,
            Achievement.COLLECT_STONE,
            Achievement.COLLECT_COAL,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_SWORD,
            Achievement.PLACE_TABLE,
            Achievement.MAKE_TORCH,
            Achievement.ENTER_DUNGEON,
            Achievement.FIND_BOW,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            mob_damage_multiplier=0.5,
            monsters_killed_to_clear_level=4,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the default ladder‑up spawn
        builder.set_starting_floor(1)

        # Set the pre‑equipped inventory
        builder.set_player_inventory({
            "sword": 2,
            "pickaxe": 2,
            "torches": 64,
            "bow": 1,
            "arrows": 20,
        })

        # No extra blocks or mobs – use the procedural dungeon as‑is
        return builder.build(rng)</data>
