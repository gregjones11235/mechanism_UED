4.123711340206185, "enter_dungeon": 100.0, "defeat_orc_solider": 94.58762886597938, "defeat_orc_mage": 86.08247422680412, "eat_snail": 98.45360824742268, "find_bow": 98.45360824742268, "fire_bow": 90.4639175257732, "open_chest": 98.45360824742268, "drink_potion": 77.0618556701031}, "average_episode_length": 716.1469072164948, "mean_return_percentage": 20.22734590608179, "mean_return": 45.713801747744846, "lp": NaN, "priority_score": 0.2482995004782655}, {"session": 124, "sr": 0.5803571428571429, "achievement_srs": {"collect_wood": 100.0, "place_table": 99.70238095238095, "eat_cow": 74.70238095238095, "collect_sapling": 78.86904761904762, "collect_drink": 95.53571428571429, "make_wood_sword": 100.0, "place_plant": 76.78571428571429, "defeat_zombie": 42.55952380952381, "collect_stone": 90.47619047619048, "place_stone": 86.30952380952381, "eat_plant": 14.583333333333334, "defeat_skeleton": 40.476190476190474, "make_stone_pickaxe": 72.61904761904762, "wake_up": 97.02380952380952, "place_furnace": 87.20238095238095, "collect_coal": 100.0, "collect_iron": 69.04761904761905, "collect_diamond": 29.464285714285715, "make_iron_pickaxe": 27.083333333333332, "make_iron_sword": 34.523809523809526, "make_arrow": 92.85714285714286, "make_torch": 100.0, "place_torch": 100.0, "collect_sapphire": 24.404761904761905, "collect_ruby": 25.297619047619047, "make_diamond_pickaxe": 3.869047619047619, "make_diamond_sword": 3.2738095238095237, "make_iron_armour": 10.416666666666666, "enter_gnomish_mines": 58.035714285714285, "enter_dungeon": 100.0, "defeat_orc_solider": 94.64285714285714, "defeat_orc_mage": 84.22619047619048, "eat_snail": 97.91666666666667, "find_bow": 99.10714285714286, "fire_bow": 92.85714285714286, "open_chest": 99.10714285714286, "drink_potion": 78.27380952380952}, "average_episode_length": 844.2678571428571, "mean_return_percentage": 20.961901973783846, "mean_return": 47.37389846075149, "lp": NaN, "priority_score": 0.24354272959183673}, {"session": 144, "sr": 0.551724137