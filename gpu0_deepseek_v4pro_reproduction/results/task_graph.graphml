orch": 97.51552795031056, "collect_sapphire": 20.910973084886127, "collect_ruby": 22.56728778467909, "make_diamond_pickaxe": 3.3126293995859215, "make_diamond_sword": 4.3478260869565215, "enter_gnomish_mines": 28.26086956521739, "enter_dungeon": 100.0, "defeat_orc_solider": 90.6832298136646, "defeat_orc_mage": 58.69565217391305, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 92.13250517598344, "drink_potion": 71.73913043478261}, "average_episode_length": 289.5, "mean_return_percentage": 11.798611123039539, "mean_return": 26.66486113806936, "lp": NaN, "priority_score": 0.20274102079395084}, {"session": 61, "sr": 0.3683127572016461, "achievement_srs": {"collect_wood": 35.18518518518518, "place_table": 31.275720164609055, "collect_sapling": 35.90534979423868, "collect_drink": 77.26337448559671, "make_wood_pickaxe": 48.66255144032922, "make_wood_sword": 100.0, "place_plant": 35.08230452674897, "collect_stone": 36.83127572016461, "place_stone": 35.90534979423868, "make_stone_pickaxe": 25.20576131687243, "wake_up": 78.70370370370371, "place_furnace": 34.876543209876544, "collect_coal": 52.77777777777778, "collect_iron": 47.42798353909465, "collect_diamond": 26.954732510288064, "make_iron_pickaxe": 10.08230452674897, "make_iron_sword": 11.728395061728396, "place_torch": 89.91769547325103, "collect_sapphire": 24.279835390946502, "collect_ruby": 23.559670781893004, "make_diamond_pickaxe": 3.1893004115226335, "make_diamond_sword": 2.983539094650206, "enter_gnomish_mines": 36.83127572016461, "enter_dungeon": 100.0, "defeat_orc_solider": 91.9753086419753, "defeat_orc_mage": 66.2551440329218, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 92.07818930041152, "drink_potion": 68.62139917695474}, "average_episode_length": 285.10493827160496, "mean_return_percentage": 12.89624772956954, "mean_return": 29.14551986882716, "lp": NaN, "priority_score": 0.2326584700841674}]</data>
