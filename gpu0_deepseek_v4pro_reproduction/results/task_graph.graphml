bow": 100.0, "open_chest": 98.80597014925372, "drink_potion": 83.88059701492537}, "average_episode_length": 845.5313432835821, "mean_return_percentage": 18.1738087769119, "mean_return": 41.072807835820896, "lp": NaN, "priority_score": 0.22903987525061262}]</data>
