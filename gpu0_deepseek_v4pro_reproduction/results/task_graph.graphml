.0362694300518134, "make_diamond_sword": 5.181347150259067, "make_iron_armour": 13.989637305699482, "enter_gnomish_mines": 75.64766839378238, "enter_dungeon": 97.92746113989638, "defeat_gnome_warrior": 0.5181347150259067, "defeat_orc_solider": 96.37305699481865, "defeat_orc_mage": 90.15544041450777, "eat_bat": 0.5181347150259067, "eat_snail": 94.30051813471502, "find_bow": 96.89119170984456, "fire_bow": 96.89119170984456, "open_chest": 96.89119170984456, "drink_potion": 81.34715025906736}, "average_episode_length": 1448.9274611398964, "mean_return_percentage": 26.304144612029432, "mean_return": 59.44736682318653, "lp": NaN, "priority_score": 0.19919997852291335}]</data>
