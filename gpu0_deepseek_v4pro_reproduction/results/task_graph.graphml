      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to craft a Stone Sword using overworld resources, then descend into the Dungeon and defeat 8 Orc Soldiers/Mages to reach the Gnomish Mines, all at full mob damage.

Description: The agent starts on the Overworld (floor 0) with a Wood Pickaxe, a Wood Sword, and 10 Torches in its inventory, but **no Stone Sword**. Hunger, thirst, and fatigue are disabled, so only combat and tool‑crafting pressure apply. The agent must locate trees and stone blocks, gather wood and stone, then craft a Stone Sword (recipe: 1 Wood + 1 Stone, near a crafting table – either one placed by the agent or a naturally occurring one). Once the Stone Sword is obtained, the agent must descend to the Dungeon (floor 1). On floor 1, the game’s default procedural rooms and corridors spawn with Orc Soldiers (melee) and Orc Mages (ranged). All hostile mob damage is at full default (`mob_damage_multiplier = 1.0`), so hits are punishing. The floor‑clear requirement is set to 8 kills – the agent must defeat any combination of these orcs to unlock the ladder down to Gnomish Mines (floor 2). Torches can be placed for light; bow and arrows are not provided but may be found in chests (optional). The episode is considered successful only when **both** the Stone Sword has been crafted **and** the agent enters the Gnomish Mines.

Relevant Achievements: MAKE_STONE_SWORD, ENTER_GNOMISH_MINES
Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD
World:
- Player: Starts on floor 0. Inventory: wood_pickaxe=1, wood_sword=1, torches=10. No armour, no bow, no arrows. Attributes: strength=1, dexterity=1, intelligence=1. Status bars all 9/9. Enchantments 0. Learned spells false.
- Map: No manual block modifications. Default overworld (floor 0) and dungeon (floor 1) generation with naturally placed trees, stone, crafting tables (from dungeon torches? no, but there are no tables on overworld; the agent may need to place one using wood), chests, fountains, etc.
- Mechanics:
  - monsters_killed_to_clear_level = 8
  - mob_damage_multiplier = 1.0
  - needs_depletion_multiplier = 0.0
  - melee_spawn_multiplier = 1.0
  - ranged_spawn_multiplier = 1.0
  - passive_spawn_multiplier = 1.0
  - All other TaskParams at default (mob_health_multiplier = 1.0, melee_trigger_distance = 10, etc.).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.MAKE_STONE_SWORD,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
        ]
        self.label = "MAKE_STONE_SWORD, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
            needs_depletion_multiplier=0.0,
            mob_damage_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on the Overworld (floor 0)
        builder.set_starting_floor(0)

        # Equip starting gear: wood pickaxe, wood sword, torches
        builder.set_player_inventory({
            "pickaxe": 1,  # wood pickaxe
            "sword": 1,    # wood sword
            "torches": 10,
        })

        # No armour, bow, or enchantments (default already 0)
        # No manual block or mob placements – rely on default generation

        return builder.build(rng)</data>
