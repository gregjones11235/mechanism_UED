      <data key="d3">import jax
import jax.numpy as jnp
from craftax.craftax.constants import Achievement, BlockType, ItemType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Train the agent to clear floor 1 (Dungeon) of normal-strength orc soldiers and mages, meeting the standard 8-kill requirement, and descend to floor 2.

    Description: The agent begins on floor 1 with a stone sword, stone pickaxe, bow, 15 arrows, 10 torches, and basic crafting resources (wood, stone, coal). The kill counter for floor 1 is set to zero. Both melee orc soldiers and ranged orc mages spawn at standard rates (multiplier 1.0) with full normal health and damage (multiplier 1.0). A ladder down is guaranteed to appear on a path tile within a Manhattan distance of 2–10 from the spawn point. The agent must kill at least 8 hostiles, then step on the ladder and use the DESCEND action to unlock ENTER_GNOMISH_MINES and succeed. Survival needs are kept minimal (needs_depletion_multiplier = 0.25, health_recover_multiplier = 2.0) to avoid distractions from combat training.

    Relevant Achievements: ENTER_GNOMISH_MINES
    Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_STONE_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_SWORD, COLLECT_WOOD, COLLECT_STONE, COLLECT_COAL, ENTER_DUNGEON
    World:
    - Player: Starting floor = 1. Inventory: `{"pickaxe": 2, "sword": 2, "wood": 20, "stone": 20, "coal": 10, "torch": 10, "bow": 1, "arrows": 15}`. All stats = 1. `set_monsters_killed(level=1, count=0)`.
    - Map: Place exactly one `LADDER_DOWN` using `place_randomly_near` on level 1, on `PATH` blocks, within Manhattan distance 2–10 from the player spawn point.
    - Mechanics:
      - `melee_spawn_multiplier = 1.0`
      - `ranged_spawn_multiplier = 1.0`
      - `passive_spawn_multiplier = 1.0`
      - `mob_health_multiplier = 1.0`
      - `mob_damage_multiplier = 1.0`
      - `needs_depletion_multiplier = 0.25`
      - `health_recover_multiplier = 2.0`
      - `monsters_killed_to_clear_level = 8`
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_GNOMISH_MINES]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_SWORD,
            Achievement.COLLECT_WOOD,
            Achievement.COLLECT_STONE,
            Achievement.COLLECT_COAL,
            Achievement.ENTER_DUNGEON,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            needs_depletion_multiplier=0.25,
            health_recover_multiplier=2.0,
            monsters_killed_to_clear_level=8,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, ladder_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Set up the player on floor 1 (Dungeon)
        builder.set_starting_floor(1)
        builder.set_player_inventory({
            "pickaxe": 2,   # stone pickaxe
            "sword": 2,     # stone sword
            "bow": 1,
            "arrows": 15,
            "torches": 10,
            "wood": 20,
            "stone": 20,
            "coal": 10,
        })
        # Reset kill counter on floor 1
        builder.set_monsters_killed(level=1, count=0)

        # Build the initial dungeon world
        state = builder.build(build_rng)

        # --- Manually place a ladder down within 2-10 tiles of the player's spawn ---
        player_pos = state.player_position
        map_level1 = state.map[1]

        # Compute Manhattan distance
        rows = jnp.arange(map_level1.shape[0])
        cols = jnp.arange(map_level1.shape[1])
        rr, cc = jnp.meshgrid(rows, cols, indexing="ij")
        dist_map = jnp.abs(rr - player_pos[0]) + jnp.abs(cc - player_pos[1])

        # Valid locations: PATH block within distance 2–10
        valid_mask = (dist_map &gt;= 2) &amp; (dist_map &lt;= 10) &amp; (map_level1 == BlockType.PATH.value)
        valid_prob = valid_mask.astype(jnp.float32)
        valid_prob /= valid_prob.sum()

        # Choose one valid location randomly
        ladder_rng, _rng = jax.random.split(ladder_rng)
        chosen_flat = jax.random.choice(
            _rng,
            jnp.arange(map_level1.size),
            p=valid_prob.flatten(),
        )
        new_row = chosen_flat // map_level1.shape[1]
        new_col = chosen_flat % map_level1.shape[1]

        # Remove any existing ladder down on level 1 (replace with NONE)
        item_map_level1 = jnp.where(
            state.item_map[1] == ItemType.LADDER_DOWN.value,
            ItemType.NONE.value,
            state.item_map[1],
        )
        # Place the new ladder down
        item_map_level1 = item_map_level1.at[new_row, new_col].set(ItemType.LADDER_DOWN.value)

        # Update the state's item_map
        state = state.replace(item_map=state.item_map.at[1].set(item_map_level1))

        return state</data>
