      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to defeat an Orc Mage (ranged enemy) on Floor 1 using a bow and arrows, isolating ranged combat and projectile dodging.
Description: The agent spawns on Floor 1 (Dungeon) equipped with a bow and 10 arrows. All survival needs are disabled, and no other mobs can spawn. The sole hostile is a single Orc Mage placed 5–8 tiles from the starting position. The agent must locate the mage, avoid its projectiles, and shoot back until the mage is defeated. The floor‑clear requirement is set to 1 so that the kill also unlocks the ladder down, reinforcing progress. This task trains the essential skill of handling ranged enemies with ranged weapons, directly targeting the globally weakest dungeon combat achievement (8.55%).
Relevant Achievements: DEFEAT_ORC_MAGE
Completed Achievements: FIND_BOW
World:
- Player: Floor 1 (spawn at ladder‑up position). Inventory: {"bow": 1, "arrows": 10}. Stats: Strength 1, Dexterity 1, Intelligence 1. Health/Food/Drink/Energy/Mana all full (9/9). Learned spells: none. Weapon/Armour enchantments: none.
- Map:
    - Use default Dungeon generation for Floor 1.
    - Place exactly one ranged mob of type appropriate for Floor 1 (Orc Mage, "ranged", type_id=2) using `add_mobs_randomly_near`, with target_pos = player spawn coordinates, n=1, min_dist=5, max_dist=8, on_blocks = [BlockType.DIRT_PATH, BlockType.FLOOR] (any walkable ground).
    - No other mobs are placed.
- Mechanics:
    "needs_depletion_multiplier": 0.0,
    "melee_spawn_multiplier": 0.0,
    "ranged_spawn_multiplier": 0.0,
    "passive_spawn_multiplier": 0.0,
    "monsters_killed_to_clear_level": 1,
    "health_recover_multiplier": 1.0,
    "mob_health_multiplier": 1.0,
    "mob_damage_multiplier": 1.0
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.DEFEAT_ORC_MAGE]
        self.completed_achievements = [Achievement.FIND_BOW]
        self.label = "DEFEAT_ORC_MAGE"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=0.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            needs_depletion_multiplier=0.0,
            health_recover_multiplier=1.0,
            monsters_killed_to_clear_level=1,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, mob_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(1)
        builder.set_player_inventory({"bow": 1, "arrows": 10})

        # Place exactly one Orc Mage (ranged type_id=2) within 5‑8 tiles
        builder.add_mobs_randomly_near(
            mob_rng,
            level=1,
            mob_name="ranged",
            type_id=2,   # Orc Mage
            n=1,
            target_pos=builder.player_position,
            min_dist=5,
            max_dist=8,
            on_blocks=[BlockType.PATH],   # walkable ground in the dungeon
        )

        return builder.build(rng)</data>
