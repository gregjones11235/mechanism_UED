      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to clear a minimal set of Dungeon hostiles and descend to the Gnomish Mines (Floor 2) to unlock the critical global progression gate.

    Description: The agent is placed directly on Floor 1 (the Dungeon) with a stone sword, exactly as in the previous task, but now the goal is to enter the next floor. The Dungeon is completely devoid of random mob spawns, so only the pre‑placed enemies exist. Three hostile mobs – one melee Orc Soldier and two ranged Orc Mages – are scattered within reach of the spawn point. The ladder down is procedurally generated somewhere on the level. The agent must locate and defeat all three hostiles (the kill requirement is set to 3) and then stand on the ladder and use the DESCEND action to achieve ENTER_GNOMISH_MINES. Passive snails provide a safe source of health if needed, but with extreme survival pressure removed (needs depletion = 0.1) the focus stays entirely on combat and the descent mechanic.

    Relevant Achievements: ENTER_GNOMISH_MINES

    Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_SWORD, ENTER_DUNGEON

    World:
    - Player: Starts on floor 1. Inventory: {"sword": 2} (stone sword).
    - Map:
      - Place 2 passive Snails (mob_name="passive", type_id=2) randomly within Manhattan distance 3–10 from the player’s spawn, on valid ground blocks (PATH).
      - Place 1 melee Orc Soldier (mob_name="melee", type_id=2) randomly within distance 4–12 from spawn, on PATH.
      - Place 2 ranged Orc Mages (mob_name="ranged", type_id=2) randomly within distance 4–12 from spawn, on PATH.
    - Mechanics:
      - needs_depletion_multiplier = 0.1
      - passive_spawn_multiplier = 0.0
      - melee_spawn_multiplier = 0.0
      - ranged_spawn_multiplier = 0.0
      - monsters_killed_to_clear_level = 3
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_GNOMISH_MINES]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_SWORD,
            Achievement.ENTER_DUNGEON,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=0.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            needs_depletion_multiplier=0.1,
            monsters_killed_to_clear_level=3,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, snail_rng, orc_soldier_rng, orc_mage_rng = jax.random.split(
            rng, 5
        )

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) with a stone sword
        builder.set_starting_floor(1)
        builder.set_player_inventory({"sword": 2})  # 2 = stone sword

        # Place 2 passive Snails (type_id=2) 3-10 tiles away on PATH
        builder.add_mobs_randomly_near(
            snail_rng,
            level=1,
            mob_name="passive",
            type_id=2,
            n=2,
            target_pos=builder.player_position,
            min_dist=3,
            max_dist=10,
            on_blocks=[BlockType.PATH],
        )

        # Place 1 melee Orc Soldier (melee, type_id=2) 4-12 tiles away on PATH
        builder.add_mobs_randomly_near(
            orc_soldier_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=1,
            target_pos=builder.player_position,
            min_dist=4,
            max_dist=12,
            on_blocks=[BlockType.PATH],
        )

        # Place 2 ranged Orc Mages (ranged, type_id=2) 4-12 tiles away on PATH
        builder.add_mobs_randomly_near(
            orc_mage_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=2,
            target_pos=builder.player_position,
            min_dist=4,
            max_dist=12,
            on_blocks=[BlockType.PATH],
        )

        return builder.build(rng)</data>
