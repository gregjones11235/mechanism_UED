085, "make_diamond_sword": 1.5267175572519085, "make_iron_armour": 46.18320610687023, "enter_gnomish_mines": 7.633587786259542, "enter_dungeon": 96.94656488549619, "defeat_orc_solider": 75.95419847328245, "defeat_orc_mage": 55.343511450381676, "eat_snail": 83.96946564885496, "find_bow": 91.98473282442748, "fire_bow": 84.73282442748092, "open_chest": 91.98473282442748, "drink_potion": 59.16030534351145}, "average_episode_length": 1043.4541984732825, "mean_return_percentage": 21.851278628593022, "mean_return": 49.38388970062023, "lp": NaN, "priority_score": 0.2485432084377367}, {"session": 60, "sr": 0.1323529411764706, "achievement_srs": {"collect_wood": 100.0, "place_table": 99.26470588235294, "eat_cow": 97.05882352941177, "collect_sapling": 100.0, "collect_drink": 97.79411764705883, "place_plant": 100.0, "defeat_zombie": 86.76470588235294, "collect_stone": 100.0, "place_stone": 100.0, "eat_plant": 52.94117647058823, "defeat_skeleton": 82.3529411764706, "make_stone_pickaxe": 95.58823529411765, "make_stone_sword": 94.8529411764706, "wake_up": 100.0, "place_furnace": 99.26470588235294, "collect_coal": 98.52941176470588, "collect_iron": 85.29411764705883, "collect_diamond": 11.764705882352942, "make_iron_pickaxe": 16.91176470588235, "make_iron_sword": 59.55882352941177, "make_arrow": 97.79411764705883, "make_torch": 83.82352941176471, "place_torch": 83.08823529411765, "collect_sapphire": 11.029411764705882, "collect_ruby": 13.970588235294118, "make_diamond_pickaxe": 4.411764705882353, "make_diamond_sword": 1.4705882352941178, "make_iron_armour": 15.441176470588236, "enter_gnomish_mines": 2.9411764705882355, "enter_dungeon": 89.70588235294117, "defeat_orc_solider": 59.55882352941177, "defeat_orc_mage": 44.85294117647059, "eat_snail": 73.52941176470588, "find_bow": 84.55882352941177, "fire_bow": 82.3529411764706, "open_chest": 84.55882352941177, "drink_potion": 48.529411764705884}, "average_episode_length": 1975.1985294117646, "mean_return_percentage": 17.659683664412253,