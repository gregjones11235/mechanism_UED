_coal": 95.28985507246377, "collect_iron": 88.76811594202898, "collect_diamond": 35.14492753623188, "make_iron_pickaxe": 31.884057971014492, "make_iron_sword": 64.85507246376811, "make_arrow": 97.46376811594203, "make_torch": 97.82608695652173, "place_torch": 97.10144927536231, "collect_sapphire": 31.159420289855074, "collect_ruby": 29.71014492753623, "make_diamond_pickaxe": 2.536231884057971, "make_diamond_sword": 3.6231884057971016, "make_iron_armour": 4.7101449275362315, "enter_gnomish_mines": 68.1159420289855, "enter_dungeon": 98.91304347826087, "defeat_orc_solider": 97.10144927536231, "defeat_orc_mage": 91.66666666666667, "eat_snail": 95.65217391304348, "find_bow": 98.18840579710145, "fire_bow": 95.65217391304348, "open_chest": 98.18840579710145, "drink_potion": 85.5072463768116}, "average_episode_length": 1010.3840579710145, "mean_return_percentage": 25.47195041211764, "mean_return": 57.56660793138587, "lp": NaN, "priority_score": 0.21718126444024363}]</data>
