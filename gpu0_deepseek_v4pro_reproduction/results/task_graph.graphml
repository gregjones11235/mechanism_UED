8235294116, "place_furnace": 35.588235294117645, "collect_coal": 47.94117647058823, "collect_iron": 38.23529411764706, "collect_diamond": 15.588235294117647, "make_iron_pickaxe": 10.588235294117647, "make_iron_sword": 9.411764705882353, "make_arrow": 47.05882352941177, "make_torch": 65.29411764705883, "place_torch": 62.35294117647059, "collect_sapphire": 14.411764705882353, "collect_ruby": 14.117647058823529, "make_diamond_pickaxe": 1.7647058823529411, "make_diamond_sword": 1.4705882352941178, "enter_gnomish_mines": 26.470588235294116, "enter_dungeon": 100.0, "defeat_orc_solider": 81.47058823529412, "defeat_orc_mage": 52.35294117647059, "eat_snail": 69.11764705882354, "find_bow": 79.11764705882354, "fire_bow": 41.1764705882353, "open_chest": 79.11764705882354, "drink_potion": 52.05882352941177}, "average_episode_length": 833.2, "mean_return_percentage": 12.444405583029672, "mean_return": 28.12435661764706, "lp": NaN, "priority_score": 0.19463667820069205}]</data>
