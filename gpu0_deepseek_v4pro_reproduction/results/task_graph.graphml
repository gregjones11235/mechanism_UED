      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to survive the Dungeon long enough to kill four enemies and descend to the Gnomish Mines.

    Description:
    The agent starts on floor 1 (Dungeon) with a Stone Sword already equipped. All stats (STR 1, DEX 1, INT 1) and all needs (health, food, drink, energy, mana) are at their default maximums. Natural hostile spawning is enabled but dialed back: melee and ranged spawn multipliers are set to 0.5 so enemies appear less frequently. The required number of kills to clear the level (and unlock the down‑ladder) is reduced to 4. To make the multi‑enemy fights learnable, all mobs have 80% of their normal health and damage (mob_health_multiplier = 0.8, mob_damage_multiplier = 0.8). No pre‑placed mobs — enemies spawn only through normal game logic. The episode terminates successfully when the agent achieves the `ENTER_GNOMISH_MINES` achievement, i.e., descends to floor 2 for the first time. Because the agent begins in the Dungeon and already carries a stone sword, the achievements `ENTER_DUNGEON` and `MAKE_STONE_SWORD` are treated as completed and do not need to be re‑achieved during the task.

    Relevant Achievements: ENTER_GNOMISH_MINES
    Completed Achievements: ENTER_DUNGEON, MAKE_STONE_SWORD
    World:
    - Player: Start on floor 1 at the up‑ladder position. Inventory contains a stone sword (sword level 2). All player stats and needs are at their default maximums (health 9, food 9, drink 9, energy 9, mana 9). No other items are given.
    - Map: No additional block or mob placements. The Dungeon is generated with its standard rooms, corridors, chests, fountains, and torches. Mobs will spawn naturally according to the modified spawn multipliers below.
    - Mechanics:
        * melee_spawn_multiplier = 0.5
        * ranged_spawn_multiplier = 0.5
        * mob_health_multiplier = 0.8
        * mob_damage_multiplier = 0.8
        * monsters_killed_to_clear_level = 4
        * All other TaskParams remain at their default values (e.g., needs_depletion_multiplier = 1.0, default light settings, etc.).
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_GNOMISH_MINES]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.MAKE_STONE_SWORD,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=0.5,
            ranged_spawn_multiplier=0.5,
            mob_health_multiplier=0.8,
            mob_damage_multiplier=0.8,
            monsters_killed_to_clear_level=4,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on Floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Give the agent a stone sword
        builder.set_player_inventory({"sword": 2})  # 2 = stone sword

        # No other custom placements; Dungeon generates naturally

        return builder.build(rng)</data>
