      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Progress from the Overworld to the Gnomish Mines by crafting a stone sword, defeating Dungeon hostiles, and descending to floor 2.

Description:
The agent starts on floor 0 (Overworld) at the default center spawn with an empty inventory and all attributes at their maximum (health 9, food 9, drink 9, energy 9, mana 9; STR 1, DEX 1, INT 1). No equipment or items are provided—it must gather wood, stone, craft a crafting table, and make at least a stone sword to survive the Dungeon.  
The goal is to enter the Gnomish Mines (floor 2) for the first time. This requires descending to floor 1 (the Dungeon), defeating at least 5 hostile mobs on that level to unlock the down‑ladder, and then taking the ladder to floor 2.  
Survival needs are slowed by half (needs_depletion_multiplier=0.5) to keep the focus on combat progression. Dungeon enemies use normal health and damage (mob_health_multiplier=1.0, mob_damage_multiplier=1.0) but their natural spawn rates are slightly reduced (both melee and ranged multipliers set to 0.7) to match the difficulty of the parent training task.  
The episode terminates with success when the `ENTER_GNOMISH_MINES` achievement is unlocked. No additional blocks or mobs are placed; the world uses the standard generation for all 9 floors.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: None
World:
- Player: Start on floor 0 at the default Overworld spawn. Empty inventory, stats at max (9/9/9/9/9), STR 1, DEX 1, INT 1. No enchantments or learned spells.
- Map: No modifications.
- Mechanics:
    * melee_spawn_multiplier = 0.7
    * ranged_spawn_multiplier = 0.7
    * mob_health_multiplier = 1.0
    * mob_damage_multiplier = 1.0
    * monsters_killed_to_clear_level = 5
    * needs_depletion_multiplier = 0.5
    * All other TaskParams remain at their default values (e.g., health_recover_multiplier = 1.0, growing_plants_age = 600).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = []
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=0.7,
            ranged_spawn_multiplier=0.7,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            monsters_killed_to_clear_level=5,
            needs_depletion_multiplier=0.5,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld) at default spawn – no changes needed
        state = builder.build(rng)

        # No pre‑completed achievements to set, but loop anyway for consistency
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
