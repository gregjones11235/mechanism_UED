      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to fight Orc Soldiers and Orc Mages with a stone sword and bow while managing hunger, thirst, and fatigue, then descend into the Gnomish Mines.

    Description: The agent starts on floor 1 (the Dungeon) with a Stone Sword, a Bow, 20 Arrows, and 10 Torches. Armour slots are empty. Survival needs are enabled at a low rate – the agent must occasionally eat snails and drink from fountains to avoid starvation and dehydration. The dungeon is procedurally generated with rooms, corridors, chests, fountains, and pre‑placed torches. The floor‑clear requirement is 4 kills; the agent must defeat any combination of Orc Soldiers (melee) and Orc Mages (ranged) to unlock the ladder down. Hostile mob damage remains reduced to 75% of normal to keep the combat challenge familiar while the agent masters survival. The task succeeds only when the agent reaches floor 2 (Gnomish Mines). By layering a gentle survival clock onto the previously mastered combat loop, this task teaches the resource‑management skills essential for progressing through the full Craftax game.

    Relevant Achievements: ENTER_GNOMISH_MINES
    Completed Achievements: MAKE_STONE_SWORD, FIND_BOW, MAKE_ARROW, MAKE_TORCH
    World:
    - Player: Starts on floor 1. Inventory: stone_sword=1, bow=1, arrows=20, torches=10. Armour slots empty. Attributes: strength=1, dexterity=1, intelligence=1. Status bars all 9/9. Enchantments all 0. Learned spells both false.
    - Map: No manual block modifications. The default floor‑1 dungeon (rooms, corridors, chests, fountains, torches in corners) is used.
    - Mechanics:
      - monsters_killed_to_clear_level = 4
      - needs_depletion_multiplier = 0.5
      - mob_damage_multiplier = 0.75
      - health_recover_multiplier = 1.0
      - health_loss_multiplier = 1.0
      - mana_recover_multiplier = 1.0
      - melee_spawn_multiplier = 1.0
      - ranged_spawn_multiplier = 1.0
      - passive_spawn_multiplier = 1.0
      - All other TaskParams at default.
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_GNOMISH_MINES]
        self.completed_achievements = [
            Achievement.MAKE_STONE_SWORD,
            Achievement.FIND_BOW,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_TORCH,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=4,
            needs_depletion_multiplier=0.5,
            mob_damage_multiplier=0.75,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(1)
        builder.set_player_inventory({
            "sword": 2,   # stone sword
            "bow": 1,     # bow present
            "arrows": 20,
            "torches": 10,
        })

        # The default floor-1 dungeon already contains rooms, corridors, chests,
        # fountains, and torches. Natural spawning (with the multipliers set above)
        # will provide Orc Soldiers and Orc Mages.
        return builder.build(rng)</data>
