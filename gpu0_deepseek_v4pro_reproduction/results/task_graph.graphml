      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Descend from the overworld into the dungeon while hostile mobs are present, teaching the agent to survive contact with zombies and skeletons and still locate the ladder.
Description: The agent must achieve the `ENTER_DUNGEON` achievement by moving to a Ladder Down tile on Floor 0 and executing the `DESCEND` action. Survival needs remain disabled (`needs_depletion_multiplier = 0.0`), so the agent never loses food, drink, or energy and never suffers health loss from unmet needs. All mob types now spawn at their normal rates (`melee_spawn_multiplier = 1.0`, `ranged_spawn_multiplier = 1.0`, `passive_spawn_multiplier = 1.0`). To make the initial combat encounters more forgiving, mob damage is halved (`mob_damage_multiplier = 0.5`), but mob health remains unchanged. The overworld ladder down is already open (Floor 0 requires 0 kills to unlock). The agent begins on Floor 0 with an empty inventory and must gather resources, craft a weapon/armour, and either fight or avoid the hostile mobs while finding the ladder.
Relevant Achievements: ENTER_DUNGEON
Completed Achievements: (none)
World:
- Player: Floor 0; no starting items.
- Map: No modifications; the default overworld generation is used (the Ladder Down is spawned normally).
- Mechanics:
    "needs_depletion_multiplier": 0.0,
    "melee_spawn_multiplier": 1.0,
    "ranged_spawn_multiplier": 1.0,
    "passive_spawn_multiplier": 1.0,
    "mob_damage_multiplier": 0.5"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_DUNGEON]
        self.completed_achievements = []
        self.label = "ENTER_DUNGEON"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            mob_damage_multiplier=0.5,
            monsters_killed_to_clear_level=0,  # Overworld ladder open by default
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)
        builder.set_starting_floor(0)
        # No inventory, mob placements, or map changes – rely on default world generation.
        return builder.build(rng)</data>
