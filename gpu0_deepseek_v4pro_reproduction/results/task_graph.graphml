037, "enter_gnomish_mines": 70.74074074074075, "enter_dungeon": 100.0, "defeat_orc_solider": 98.14814814814815, "defeat_orc_mage": 93.33333333333333, "eat_snail": 98.14814814814815, "find_bow": 98.88888888888889, "fire_bow": 94.44444444444444, "open_chest": 98.88888888888889, "drink_potion": 82.96296296296296}, "average_episode_length": 983.5518518518519, "mean_return_percentage": 23.389011159251066, "mean_return": 52.85916521990741, "lp": NaN, "priority_score": 0.20698216735253774}]</data>
