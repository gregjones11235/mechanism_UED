  - All spawn multipliers at 1.0
  - All other TaskParams at default.</data>
      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Persist on the critical dungeon descent, increasing the required mob kills and combat threat to improve robustness for the full game transition into the Gnomish Mines.

Description: The agent begins on floor 1 (Dungeon) at the Up‑Ladder position, fully equipped from an efficient overworld preparation: a stone sword, a bow, 10 arrows, 10 torches, a wood pickaxe, 5 wood, and 3 coal. No further resources from the overworld are needed, and the task focuses entirely on clearing the dungeon under more demanding conditions. The dungeon is procedurally generated, remains dark, and requires torch usage. Hostile mobs (Orc Soldiers, Orc Mages) spawn and behave normally, but now deal 20% more damage (`mob_damage_multiplier = 1.2`) and the level‑clear requirement is increased to 8 kills (`monsters_killed_to_clear_level = 8` for all floors, except floor 0 which is pre‑cleared). Survival needs deplete at standard speed. The task terminates successfully as soon as the agent descends to the Gnomish Mines (ENTER_GNOMISH_MINES); no other achievements are required. This forces the agent to master sustained combat against both melee and ranged orcs, precise resource management (arrows, torches, health), and efficient dungeon navigation under realistic pressure, directly bridging the global gap in the dungeon‑to‑mines transition.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: MAKE_STONE_SWORD, FIND_BOW, MAKE_ARROW, MAKE_TORCH, PLACE_TORCH

World:
- Player: Starts on floor 1 (Dungeon). Inventory: stone_sword=1, bow=1, arrows=10, torch=10, wood_pickaxe=1, wood=5, coal=3. All other inventory slots empty. Attributes: strength=1, dexterity=1, intelligence=1. Health/Food/Drink/Energy/Mana all 9/9. Enchantments and spells as default (none).
- Map: No manual block modifications; the default Dungeon generation is used. The player spawns at the Up‑Ladder location.
- Mechanics:
  - monsters_killed_to_clear_level = 8 (global; floor 0 remains pre‑cleared)
  - mob_damage_multiplier = 1.2
  - needs_depletion_multiplier = 1.0
  - health_recover_multiplier = 1.0
  - health_loss_multiplier = 1.0
  - mana_recover_multiplier = 1.0
  - All spawn multipliers at 1.0
  - All other TaskParams at default.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_STONE_SWORD,
            Achievement.FIND_BOW,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_TORCH,
            Achievement.PLACE_TORCH,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
            mob_damage_multiplier=1.2,
            needs_depletion_multiplier=1.0,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon), at the up-ladder position
        builder.set_starting_floor(1)

        # Equip the agent with the provided gear
        builder.set_player_inventory({
            "sword": 2,      # stone sword
            "bow": 1,
            "arrows": 10,
            "torches": 10,
            "pickaxe": 1,    # wood pickaxe
            "wood": 5,
            "coal": 3,
        })

        # Pre-clear floor 0 so the ladder down from the overworld is already accessible
        # (though the agent starts on floor 1 and never needs it)
        builder.set_monsters_killed(level=0, count=self.get_task_params().monsters_killed_to_clear_level)

        state = builder.build(rng)

        # Mark the pre-completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
