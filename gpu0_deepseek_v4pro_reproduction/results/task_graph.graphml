      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to defeat two skeletons at once with a stone sword under moderately reduced health recovery, strengthening melee‑vs‑ranged combat for the full game.
    Description: The agent starts on Floor 0 with a stone sword (`inventory.sword = 2`) and no other items. Two Skeletons (ranged mob, type_id=0) are placed randomly on GRASS within a Manhattan distance of 3 to 7 tiles from the player start. One Cow (passive mob, type_id=0) is placed under the same distance constraints to provide a familiar food source. Health recovery is set to 2×, making the fight less forgiving than the previous 5×, but still easier than the default game, encouraging better damage avoidance. Melee enemy spawns are disabled; ranged spawns remain at a low rate (0.2) to keep focus on the placed skeletons. Survival needs (hunger, thirst, fatigue) stay at normal rates. The task is considered successful when both skeletons are defeated.
    Relevant Achievements: DEFEAT_SKELETON
    Completed Achievements: MAKE_STONE_SWORD
    World:
    - Player: Starts on floor 0 with inventory `{"sword": 2}` (stone sword).
    - Map:
      - Use `add_mobs_randomly_near` to place **two** Skeletons ("ranged", type_id=0) at Manhattan distance 3–7 from the player’s start, on `[BlockType.GRASS]`.
      - Use `add_mobs_randomly_near` to place **one** Cow ("passive", type_id=0) at Manhattan distance 3–7 from the player’s start, on `[BlockType.GRASS]`.
    - Mechanics:
      - health_recover_multiplier = 2.0
      - melee_spawn_multiplier = 0.0
      - ranged_spawn_multiplier = 0.2
      - passive_spawn_multiplier = 1.0
      - All other TaskParams remain default.
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.DEFEAT_SKELETON]
        self.completed_achievements = [Achievement.MAKE_STONE_SWORD]
        self.label = "DEFEAT_SKELETON"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.2,
            health_recover_multiplier=2.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, skeleton_rng, cow_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(0)
        builder.set_player_inventory({"sword": 2})  # stone sword

        # Place two skeletons near the player
        builder.add_mobs_randomly_near(
            skeleton_rng,
            level=0,
            mob_name="ranged",
            type_id=0,  # Skeleton
            n=2,
            target_pos=builder.player_position,
            min_dist=3,
            max_dist=7,
            on_blocks=[BlockType.GRASS],
        )

        # Place one cow for food
        builder.add_mobs_randomly_near(
            cow_rng,
            level=0,
            mob_name="passive",
            type_id=0,  # Cow
            n=1,
            target_pos=builder.player_position,
            min_dist=3,
            max_dist=7,
            on_blocks=[BlockType.GRASS],
        )

        return builder.build(rng)</data>
