      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Defeat a skeleton using melee combat, teaching the agent to handle a ranged enemy that kites.

    Description: The player must achieve the `DEFEAT_SKELETON` achievement. The player starts on floor 0 (the overworld) with a wooden sword in inventory. Exactly one skeleton (ranged mob type_id=0) and three cows (passive mob type_id=0) are placed randomly at a Manhattan distance of 4–8 tiles from the player. Health recovery is at normal speed (`health_recover_multiplier = 1.0`), and all survival needs deplete at standard rates. Melee mob spawning is disabled; passive and ranged spawning are also disabled so the initial skeleton is the only hostile enemy. The episode terminates on success (the skeleton is killed); rewards are given for any achievement earned, but only `DEFEAT_SKELETON` determines task completion.

    Relevant Achievements: DEFEAT_SKELETON
    Completed Achievements: MAKE_WOOD_SWORD
    World:
    - Player: Starts on floor 0 with a wooden sword (`{"sword": 1}`).
    - Map: Place one `SKELETON` (ranged mob type_id=0) and three `COW` (passive mob type_id=0) randomly within 4–8 Manhattan distance of the player start position.
    - Mechanics: `health_recover_multiplier = 1.0`, `needs_depletion_multiplier = 1.0`, `passive_spawn_multiplier = 1.0`, `melee_spawn_multiplier = 0.0`, `ranged_spawn_multiplier = 0.0`.
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.DEFEAT_SKELETON]
        self.completed_achievements = [Achievement.MAKE_WOOD_SWORD]
        self.label = "DEFEAT_SKELETON"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            needs_depletion_multiplier=1.0,
            health_recover_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, skeleton_rng, cow_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(0)
        builder.set_player_inventory({"sword": 1})

        # Place one skeleton (ranged, type_id=0) near the player
        builder.add_mobs_randomly_near(
            skeleton_rng,
            level=0,
            mob_name="ranged",
            type_id=0,
            n=1,
            target_pos=builder.player_position,
            min_dist=4,
            max_dist=8,
            on_blocks=[BlockType.GRASS, BlockType.PATH, BlockType.SAND],
        )

        # Place three cows (passive, type_id=0) nearby as a food source
        builder.add_mobs_randomly_near(
            cow_rng,
            level=0,
            mob_name="passive",
            type_id=0,
            n=3,
            target_pos=builder.player_position,
            min_dist=4,
            max_dist=8,
            on_blocks=[BlockType.GRASS, BlockType.PATH, BlockType.SAND],
        )

        return builder.build(rng)</data>
