      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Clear the Dungeon floor by defeating all placed orc soldiers and mages, then descend to the Gnomish Mines.

    Description: The agent starts on Floor 1 (Dungeon) with a bow, 10 arrows, and a wood sword. Survival needs are disabled and no additional mobs spawn. Exactly three Orc Soldiers (melee, type_id=2) and two Orc Mages (ranged, type_id=2) are placed within a Manhattan distance of 5–10 tiles from the player’s spawn position. The floor‑clear requirement is set to 5, meaning the agent must kill all five enemies to unlock the ladder down. Once unlocked, the agent must navigate to the ladder and descend, earning entrance to Floor 2 (Gnomish Mines). This task forces the agent to endure multiple combats, manage health through resting, and search the dungeon to reach the floor‑clear threshold, thereby bridging the gap between defeating isolated orc pairs and reliably clearing Dungeon Floor 1.

    Relevant Achievements: ENTER_GNOMISH_MINES
    Completed Achievements: FIND_BOW
    World:
    - Player: Start on Floor 1 (spawn at ladder‑up position). Inventory: {"bow": 1, "arrows": 10, "sword": 1}. Stats: Strength 1, Dexterity 1, Intelligence 1. Health/Food/Drink/Energy/Mana all full (9/9). No spells learned. No weapon/armour enchantments.
    - Map:
        - Use default Dungeon generation for Floor 1.
        - Place three melee mobs (Orc Soldier, "melee", type_id=2) using `add_mobs_randomly_near`, target_pos = player spawn coordinates, n=3, min_dist=5, max_dist=10, on_blocks = [BlockType.PATH].
        - Place two ranged mobs (Orc Mage, "ranged", type_id=2) using `add_mobs_randomly_near`, target_pos = player spawn coordinates, n=2, min_dist=5, max_dist=10, on_blocks = [BlockType.PATH].
        - No other mobs are placed.
    - Mechanics:
        "needs_depletion_multiplier": 0.0,
        "melee_spawn_multiplier": 0.0,
        "ranged_spawn_multiplier": 0.0,
        "passive_spawn_multiplier": 0.0,
        "monsters_killed_to_clear_level": 5,
        "health_recover_multiplier": 1.0,
        "mob_health_multiplier": 1.0,
        "mob_damage_multiplier": 1.0
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_GNOMISH_MINES]
        self.completed_achievements = [Achievement.FIND_BOW]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            passive_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=5,
            health_recover_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, melee_rng, ranged_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(1)
        builder.set_player_inventory({"bow": 1, "arrows": 10, "sword": 1})
        builder.set_player_stats(1, 1, 1)

        # Place three Orc Soldiers (melee, type_id=2) near the player
        builder.add_mobs_randomly_near(
            melee_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=3,
            target_pos=builder.player_position,
            min_dist=5,
            max_dist=10,
            on_blocks=[BlockType.PATH],
        )

        # Place two Orc Mages (ranged, type_id=2) near the player
        builder.add_mobs_randomly_near(
            ranged_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=2,
            target_pos=builder.player_position,
            min_dist=5,
            max_dist=10,
            on_blocks=[BlockType.PATH],
        )

        return builder.build(rng)</data>
