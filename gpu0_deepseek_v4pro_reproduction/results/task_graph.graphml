23732251521298, "collect_iron": 26.16632860040568, "collect_diamond": 11.359026369168356, "make_iron_pickaxe": 10.344827586206897, "make_iron_sword": 11.561866125760648, "make_arrow": 100.0, "make_torch": 54.766734279918865, "place_torch": 51.926977687626774, "collect_sapphire": 11.359026369168356, "collect_ruby": 10.953346855983773, "make_diamond_pickaxe": 1.2170385395537526, "make_diamond_sword": 1.4198782961460445, "make_iron_armour": 5.070993914807302, "enter_dungeon": 100.0, "defeat_orc_mage": 85.19269776876268, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 86.81541582150102, "drink_potion": 49.89858012170385}, "average_episode_length": 624.0202839756593, "mean_return_percentage": 13.920738128320828, "mean_return": 31.46086817000507, "lp": NaN, "priority_score": 0.1261474023756526}]</data>
