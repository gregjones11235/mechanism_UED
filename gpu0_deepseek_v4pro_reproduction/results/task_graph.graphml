feat_orc_solider": 96.27906976744185, "defeat_orc_mage": 87.44186046511628, "eat_snail": 82.32558139534883, "find_bow": 97.20930232558139, "fire_bow": 88.37209302325581, "open_chest": 97.20930232558139, "drink_potion": 89.76744186046511}, "average_episode_length": 1380.5813953488373, "mean_return_percentage": 24.897100178148797, "mean_return": 56.26744640261628, "lp": NaN, "priority_score": 0.23805300162249865}, {"session": 90, "sr": 0.714975845410628, "achievement_srs": {"collect_wood": 100.0, "place_table": 100.0, "eat_cow": 66.18357487922705, "collect_sapling": 100.0, "collect_drink": 99.03381642512078, "place_plant": 100.0, "defeat_zombie": 54.106280193236714, "collect_stone": 99.03381642512078, "place_stone": 98.55072463768116, "eat_plant": 15.458937198067632, "defeat_skeleton": 47.82608695652174, "wake_up": 90.33816425120773, "place_furnace": 98.55072463768116, "collect_coal": 92.27053140096618, "collect_iron": 81.15942028985508, "collect_diamond": 32.367149758454104, "make_iron_pickaxe": 30.434782608695652, "make_iron_sword": 48.792270531400966, "make_arrow": 91.30434782608695, "make_torch": 96.61835748792271, "place_torch": 96.13526570048309, "collect_sapphire": 32.85024154589372, "collect_ruby": 31.40096618357488, "make_diamond_pickaxe": 10.144927536231885, "make_diamond_sword": 3.3816425120772946, "make_iron_armour": 11.11111111111111, "enter_gnomish_mines": 71.4975845410628, "enter_dungeon": 99.51690821256038, "defeat_orc_solider": 98.55072463768116, "defeat_orc_mage": 93.71980676328502, "eat_snail": 88.40579710144928, "find_bow": 99.03381642512078, "fire_bow": 90.33816425120773, "open_chest": 99.03381642512078, "drink_potion": 85.5072463768116}, "average_episode_length": 1293.6763285024156, "mean_return_percentage": 26.39998799284447, "mean_return": 59.663972863828505, "lp": NaN, "priority_score": 0.2037853858899858}]</data>
