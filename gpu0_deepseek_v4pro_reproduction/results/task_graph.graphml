      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to defeat a ranged skeleton and enter the dungeon.
    Description: The agent must kill a skeleton and then descend to the first dungeon floor (Floor 1). The player begins on Floor 0 with a stone sword and three cows nearby. One skeleton and one zombie are placed within 4–8 tiles (Manhattan distance) of the starting position. The Overworld ladder down is sealed until the player defeats 2 hostile mobs (`monsters_killed_to_clear_level = 2`). Survival mechanics are fully active at default rates, and health regeneration is normal. Passive and melee spawns are standard; ranged spawns are slightly increased to give additional skeleton exposure. The episode succeeds when the agent (1) kills the skeleton and (2) descends to Floor 1.
    Relevant Achievements: DEFEAT_SKELETON, ENTER_DUNGEON
    Completed Achievements: MAKE_STONE_SWORD
    World:
    - Player: Floor 0; inventory contains a stone sword (`{"sword": 2}`).
    - Map: 
        * Place 1 Skeleton (ranged mob type_id=0) and 1 Zombie (melee mob type_id=0) randomly within a Manhattan distance of 4–8 from the player start.
        * Place 3 Cows (passive mob type_id=0) randomly within the same distance range.
    - Mechanics:
        "monsters_killed_to_clear_level": 2,
        "needs_depletion_multiplier": 1.0,
        "passive_spawn_multiplier": 1.0,
        "melee_spawn_multiplier": 1.0,
        "ranged_spawn_multiplier": 0.5,
        "health_recover_multiplier": 1.0
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.DEFEAT_SKELETON, Achievement.ENTER_DUNGEON]
        self.completed_achievements = [Achievement.MAKE_STONE_SWORD]
        self.label = "DEFEAT_SKELETON, ENTER_DUNGEON"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=0.5,
            needs_depletion_multiplier=1.0,
            health_recover_multiplier=1.0,
            monsters_killed_to_clear_level=2,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, skeleton_rng, zombie_rng, cow_rng = jax.random.split(rng, 5)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(0)
        builder.set_player_inventory({"sword": 2})  # stone sword

        # Reset monsters killed on floor 0 so the ladder is sealed until 2 are killed
        builder.set_monsters_killed(level=0, count=0)

        # Place 1 skeleton (ranged mob type_id=0) within 4–8 Manhattan distance
        builder.add_mobs_randomly_near(
            skeleton_rng,
            level=0,
            mob_name="ranged",
            type_id=0,  # Skeleton
            n=1,
            target_pos=builder.player_position,
            min_dist=4,
            max_dist=8,
            on_blocks=[BlockType.GRASS, BlockType.PATH, BlockType.SAND],
        )

        # Place 1 zombie (melee mob type_id=0) within 4–8 Manhattan distance
        builder.add_mobs_randomly_near(
            zombie_rng,
            level=0,
            mob_name="melee",
            type_id=0,  # Zombie
            n=1,
            target_pos=builder.player_position,
            min_dist=4,
            max_dist=8,
            on_blocks=[BlockType.GRASS, BlockType.PATH, BlockType.SAND],
        )

        # Place 3 cows (passive mob type_id=0) within 4–8 Manhattan distance
        builder.add_mobs_randomly_near(
            cow_rng,
            level=0,
            mob_name="passive",
            type_id=0,  # Cow
            n=3,
            target_pos=builder.player_position,
            min_dist=4,
            max_dist=8,
            on_blocks=[BlockType.GRASS, BlockType.PATH, BlockType.SAND],
        )

        return builder.build(rng)</data>
