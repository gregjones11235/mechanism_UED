05263158, "make_iron_pickaxe": 14.210526315789474, "make_iron_sword": 30.0, "make_arrow": 92.63157894736842, "make_torch": 91.05263157894737, "place_torch": 90.0, "collect_sapphire": 17.36842105263158, "collect_ruby": 20.0, "make_diamond_pickaxe": 1.5789473684210527, "make_diamond_sword": 2.1052631578947367, "make_iron_armour": 3.1578947368421053, "enter_gnomish_mines": 53.68421052631579, "enter_dungeon": 91.57894736842105, "defeat_orc_solider": 88.42105263157895, "defeat_orc_mage": 66.3157894736842, "eat_snail": 75.78947368421052, "find_bow": 83.15789473684211, "fire_bow": 76.84210526315789, "open_chest": 83.15789473684211, "drink_potion": 62.63157894736842}, "average_episode_length": 1363.6894736842105, "mean_return_percentage": 23.245519274714717, "mean_return": 52.53487356085526, "lp": NaN, "priority_score": 0.24864265927977838}, {"session": 76, "sr": 0.6869918699186992, "achievement_srs": {"collect_wood": 100.0, "place_table": 99.1869918699187, "eat_cow": 94.3089430894309, "collect_sapling": 100.0, "collect_drink": 99.1869918699187, "make_wood_pickaxe": 98.3739837398374, "make_wood_sword": 97.96747967479675, "place_plant": 99.59349593495935, "defeat_zombie": 73.17073170731707, "collect_stone": 98.3739837398374, "place_stone": 98.3739837398374, "eat_plant": 23.983739837398375, "defeat_skeleton": 65.85365853658537, "make_stone_pickaxe": 86.58536585365853, "make_stone_sword": 93.08943089430895, "wake_up": 83.33333333333333, "place_furnace": 97.96747967479675, "collect_coal": 93.08943089430895, "collect_iron": 79.26829268292683, "collect_diamond": 28.048780487804876, "make_iron_pickaxe": 32.926829268292686, "make_iron_sword": 55.6910569105691, "make_arrow": 93.90243902439025, "make_torch": 90.65040650406505, "place_torch": 86.58536585365853, "collect_sapphire": 21.951219512195124, "collect_ruby": 20.32520325203252, "make_diamond_pickaxe": 3.252032520325203, "make_diamond_sword": 3.658536585365854, "make_iron_armour": 6.097560975609756, "enter_gnomish_mines": 68.69918699186992, "enter_dungeon": 97.15447154471545, "defeat_orc_solider": 92.27642276422765, "defeat_orc_mage": 80.48780487804878, "eat_snail": 84.55284552845528, "find_bow": 89.4308943089431, "fire_bow": 86.17886178861788, "open_chest": 89.4308943089431, "drink_potion": 65.85365853658537}, "average_episode_length": 1124.5731707317073, "mean_return_percentage": 25.840218594300847, "mean_return": 58.398894023119915, "lp": NaN, "priority_score": 0.21503404058430828}]</data>
