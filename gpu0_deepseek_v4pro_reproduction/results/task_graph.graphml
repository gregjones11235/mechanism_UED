      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Teach the agent to successfully descend from the Overworld to the Gnomish Mines while managing standard survival needs, thereby improving the global reliability of the ENTER_GNOMISH_MINES transition.

Description:  
The agent starts on Floor 0 (Overworld) at the default center spawn. It is equipped with a stone sword (tier 2) and a stone pickaxe (tier 2). The Overworld uses standard procedural generation with default mob spawns. The ladder down to the Dungeon (Floor 1) is initially locked; the agent must defeat at least 8 hostile mobs (melee or ranged) on Floor 0 to unlock it (the default `monsters_killed_to_clear_level` for Floor 0 is 8, and no `set_monsters_killed` override is applied). **Survival needs are now at full speed** (`needs_depletion_multiplier = 1.0`), requiring the agent to eat, drink, and rest/sleep while fighting and exploring. Once the Floor 0 ladder is unlocked, the agent must descend, navigate the Dungeon, and defeat at least 6 hostile mobs to unlock the downward ladder to Floor 2 (the Gnomish Mines). The task terminates successfully when the agent descends from Floor 1 to Floor 2, achieving ENTER_GNOMISH_MINES. All other parameters (mob health/damage, spawn multipliers, plant growth, mana, etc.) remain at their default values.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: ENTER_DUNGEON, MAKE_STONE_SWORD, MAKE_STONE_PICKAXE, COLLECT_WOOD, COLLECT_STONE

World:
- Player:
  - `builder.set_starting_floor(0)`
  - `builder.set_player_inventory({"sword": 2, "pickaxe": 2})`
  - All attributes at default max (health 9, food 9, drink 9, energy 9, mana 9; stats all 1)
- Map:
  - **No `set_monsters_killed` call** for Floor 0 (the requirement defaults to 8)
  - `builder.set_monsters_killed(level=1, count=0)` (ensures Floor 1 starts uncleared)
  - No other block modifications; default map generation used
- Mechanics:
  - `monsters_killed_to_clear_level = 6`              # for Floor 1
  - `needs_depletion_multiplier = 1.0`                # &lt;-- Primary change: restored to default
  - `mob_health_multiplier = 1.0`
  - `mob_damage_multiplier = 1.0`
  - `melee_spawn_multiplier = 1.0`
  - `ranged_spawn_multiplier = 1.0`
  - `passive_spawn_multiplier = 1.0`
  - `health_recover_multiplier = 1.0`
  - `health_loss_multiplier = 1.0`
  - `mana_recover_multiplier = 1.0`
  - `growing_plants_age = 600`
  - All other parameters at default
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.COLLECT_WOOD,
            Achievement.COLLECT_STONE,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=6,
            needs_depletion_multiplier=1.0,
            # All other multipliers remain at their default 1.0
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld)
        builder.set_starting_floor(0)

        # Equip stone sword and stone pickaxe
        builder.set_player_inventory({"sword": 2, "pickaxe": 2})

        # Ensure Floor 1 starts with zero kills (though it is zero by default)
        builder.set_monsters_killed(level=1, count=0)

        # Build the state with default map generation (no block modifications)
        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
