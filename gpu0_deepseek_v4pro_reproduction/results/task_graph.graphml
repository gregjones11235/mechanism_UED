collect_sapling": 40.201567749160134, "collect_drink": 87.68197088465845, "make_wood_pickaxe": 54.423292273236285, "make_wood_sword": 100.0, "place_plant": 39.64165733482643, "collect_stone": 40.6494960806271, "place_stone": 39.64165733482643, "eat_plant": 0.11198208286674133, "make_stone_pickaxe": 31.466965285554313, "wake_up": 90.2575587905935, "place_furnace": 40.31354983202687, "collect_coal": 61.254199328107504, "collect_iron": 54.64725643896976, "collect_diamond": 27.435610302351623, "make_iron_pickaxe": 14.33370660694289, "make_iron_sword": 15.453527435610303, "place_torch": 99.77603583426652, "collect_sapphire": 27.659574468085108, "collect_ruby": 26.31578947368421, "make_diamond_pickaxe": 4.143337066069429, "make_diamond_sword": 4.25531914893617, "enter_gnomish_mines": 42.44120940649496, "enter_dungeon": 100.0, "defeat_orc_solider": 93.72900335946248, "defeat_orc_mage": 75.02799552071669, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 98.54423292273236, "drink_potion": 85.1063829787234}, "average_episode_length": 311.42105263157896, "mean_return_percentage": 14.473774212718885, "mean_return": 32.71072972074468, "lp": NaN, "priority_score": 0.24428646847635396}]</data>
