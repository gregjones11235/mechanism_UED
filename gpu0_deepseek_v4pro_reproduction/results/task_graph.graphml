84057971016, "make_iron_sword": 55.55555555555556, "make_arrow": 95.65217391304348, "make_torch": 99.03381642512078, "place_torch": 97.58454106280193, "collect_sapphire": 24.63768115942029, "collect_ruby": 26.08695652173913, "make_diamond_pickaxe": 4.830917874396135, "make_diamond_sword": 2.4154589371980677, "make_iron_armour": 12.560386473429952, "enter_gnomish_mines": 59.42028985507246, "enter_dungeon": 97.58454106280193, "defeat_orc_solider": 94.20289855072464, "defeat_orc_mage": 88.88888888888889, "eat_snail": 94.68599033816425, "find_bow": 97.58454106280193, "fire_bow": 94.20289855072464, "open_chest": 97.58454106280193, "drink_potion": 79.22705314009661}, "average_episode_length": 1374.2898550724638, "mean_return_percentage": 26.17965293141593, "mean_return": 59.166015625, "lp": NaN, "priority_score": 0.24112581390464188}, {"session": 150, "sr": 0.7346938775510204, "achievement_srs": {"collect_wood": 100.0, "place_table": 99.18367346938776, "eat_cow": 96.73469387755102, "collect_sapling": 100.0, "collect_drink": 98.77551020408163, "make_wood_pickaxe": 100.0, "make_wood_sword": 99.18367346938776, "place_plant": 100.0, "defeat_zombie": 72.65306122448979, "collect_stone": 99.59183673469387, "place_stone": 99.59183673469387, "eat_plant": 22.857142857142858, "defeat_skeleton": 65.71428571428571, "make_stone_pickaxe": 94.6938775510204, "make_stone_sword": 96.73469387755102, "wake_up": 99.18367346938776, "place_furnace": 99.59183673469387, "collect_coal": 97.95918367346938, "collect_iron": 86.12244897959184, "collect_diamond": 32.6530612244898, "make_iron_pickaxe": 28.979591836734695, "make_iron_sword": 63.673469387755105, "make_arrow": 97.55102040816327, "make_torch": 97.95918367346938, "place_torch": 97.95918367346938, "collect_sapphire": 29.387755102040817, "collect_ruby": 24.897959183673468, "make_diamond_pickaxe": 3.2653061224489797, "make_diamond_sword": 4.8979591836734695, "make_iron_armour": 17.959183673469386, "enter_gnomish_mines": 73.46938775510205, "enter_dungeon": 98.36734693877551, "defeat_orc_solider": 97.95918367346938, "defeat_orc_mage": 93.87755102040816, "eat_snail": 97.14285714285714, "find_bow": 97.14285714285714, "fire_bow": 95.91836734693878, "open_chest": 97.14285714285714, "drink_potion": 81.63265306122449}, "average_episode_length": 1189.6408163265305, "mean_return_percentage": 27.969917571564025, "mean_return": 63.21201371173469, "lp": NaN, "priority_score": 0.1949187838400666}]</data>
