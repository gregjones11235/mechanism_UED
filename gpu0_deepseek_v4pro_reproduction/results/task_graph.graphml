      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Teach the agent to autonomously gather resources, craft stone tools, and then clear the Dungeon to reach the Gnomish Mines.

Description: The agent starts on Floor 0 (the Overworld) at its default centre spawn, with no items in its inventory. The Overworld uses standard procedural generation (grass, water, sand, stone mountains, trees, coal/iron/diamond ores, lava, passive/melee/ranged mobs). The ladder down to the Dungeon (Floor 1) is already unlocked (`monsters_killed_to_clear_level` for Floor 0 is set to a high value, so no hostile mob kills are required). Survival needs are moderately eased (`needs_depletion_multiplier = 0.5`). All other game mechanics (mob health/damage, spawn rates, etc.) remain at default.

The agent must first collect wood, place a crafting table, craft a wood pickaxe and wood sword, then collect stone, and craft a stone pickaxe and a stone sword. Once equipped with stone tools, it must locate the ladder, descend to the Dungeon, clear Floor 1 by defeating at least 6 hostile mobs (Orc Soldiers, Orc Mages), and finally descend to Floor 2. The task terminates successfully only when the agent has achieved all three goals: crafting a Stone Pickaxe, crafting a Stone Sword, and entering the Gnomish Mines (`ENTER_GNOMISH_MINES`). This composition forces the agent to practice the full early‑game resource‑to‑tool pipeline in the context of a multi‑floor adventure, strengthening the globally fragile transition into the Gnomish Mines.

Relevant Achievements: MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, ENTER_GNOMISH_MINES

Completed Achievements: (none)

World:
- Player:
  - `builder.set_starting_floor(0)` (default Overworld spawn).
  - No initial inventory items; all stats at default maximum (health, food, drink, energy, mana 9; attributes all 1).
- Map:
  - `builder.set_monsters_killed(level=0, count=100)` (unlocks the ladder to Floor 1 immediately).
  - No other block modifications; the default map generation is used.
- Mechanics:
  - `monsters_killed_to_clear_level = 6` (for Floor 1, same as parent).
  - `needs_depletion_multiplier = 0.5`
  - `mob_health_multiplier = 1.0`
  - `mob_damage_multiplier = 1.0`
  - `melee_spawn_multiplier = 1.0`
  - `ranged_spawn_multiplier = 1.0`
  - `passive_spawn_multiplier = 1.0`
  - `health_recover_multiplier = 1.0`
  - `health_loss_multiplier = 1.0`
  - `mana_recover_multiplier = 1.0`
  - `growing_plants_age = 600`
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = []  # none
        self.label = "MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=6,
            needs_depletion_multiplier=0.5,
            # All other multipliers are left at default (1.0); the fields below are explicitly set to default for clarity
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            growing_plants_age=600,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on Floor 0 (Overworld)
        builder.set_starting_floor(0)

        # The inventory is empty by default; no set_player_inventory call needed.

        # Unlock the ladder down from Floor 0 by marking a high kill count
        builder.set_monsters_killed(level=0, count=100)

        # No additional map modifications; rely entirely on procedural generation.

        state = builder.build(rng)

        # No achievements are pre‑completed, so we return the state as is.
        return state</data>
