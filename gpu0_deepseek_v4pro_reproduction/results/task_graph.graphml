      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Train the agent to defeat a full cellar’s worth of Orcs (8 kills) while managing health and ammunition, then descend to the Gnomish Mines.

Description: The task is identical to the previous “Orc combat with full damage” training, except the floor‑clear requirement is raised to the original game’s default of 8 hostile kills. The agent begins on floor 1 (the Dungeon) with a stone sword, a bow, 20 arrows, and 10 torches. No armour is worn. Hunger, thirst, and fatigue are disabled so the agent can concentrate solely on combat endurance and navigation. The dungeon generation, chests, fountains, and pre‑placed torches are unchanged. Hostile mob damage stays at its full default value (mob_damage_multiplier = 1.0), and spawn multipliers remain at 1.0. The agent must locate, fight, and defeat any combination of Orc Soldiers (melee) and Orc Mages (ranged) until the kill count reaches 8; only then can it use the ladder down to floor 2. The task succeeds when the agent reaches the Gnomish Mines (floor 2). By requiring twice as many kills as the original training version, this task directly rehearses the real‑game barrier that currently prevents global progression past the Dungeon.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: FIND_BOW, MAKE_ARROW, MAKE_TORCH, MAKE_STONE_SWORD
World:
- Player: Starts on floor 1. Inventory: stone_sword=1, bow=1, arrows=20, torches=10. Armour slots empty. Attributes: strength=1, dexterity=1, intelligence=1. Status bars all 9/9. Enchantments all 0. Learned spells both false.
- Map: No manual block modifications. The default floor‑1 dungeon (rooms, corridors, chests, fountains, torches in corners) is used.
- Mechanics:
  - monsters_killed_to_clear_level = 8
  - needs_depletion_multiplier = 0.0
  - mob_damage_multiplier = 1.0
  - melee_spawn_multiplier = 1.0
  - ranged_spawn_multiplier = 1.0
  - passive_spawn_multiplier = 1.0
  - All other TaskParams at default (including mob_health_multiplier = 1.0, melee_trigger_distance = 10).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_GNOMISH_MINES]
        self.completed_achievements = [
            Achievement.FIND_BOW,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_TORCH,
            Achievement.MAKE_STONE_SWORD,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
            needs_depletion_multiplier=0.0,
            mob_damage_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (the Dungeon)
        builder.set_starting_floor(1)

        # Equip the required gear (stone sword = 2, bow = 1, arrows = 20, torches = 10)
        builder.set_player_inventory({
            "sword": 2,       # stone sword
            "bow": 1,         # bow
            "arrows": 20,     # arrows
            "torches": 10,    # torches
        })

        # Ensure no armour and no enchantments (default is already 0, but explicit)
        builder.set_armour_enchantments(0, 0, 0, 0)
        builder.set_weapon_enchantments(sword=0, bow=0)
        builder.set_learned_spells(fireball=False, iceball=False)

        # Starting stats are already 1 by default, no need to change.
        # No manual block or mob placements; the default Dungeon generation will
        # naturally spawn Orc Soldiers (melee type_id=2) and Orc Mages (ranged type_id=2)
        # during gameplay. The TaskParams handle the clear condition and damage.

        return builder.build(rng)</data>
