      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Teach the agent to smith iron equipment on floor 2 (Gnomish Mines) and defeat its native Gnome enemies, bridging the global progression gap between the Dungeon and deeper floors.

Description: The agent begins on floor 2 (Gnomish Mines) standing on the ladder‑up tile. The inventory contains a stone pickaxe, a stone sword, 10 torches, 10 coal, 5 wood, and 10 stone — representing the gear of a competent floor‑1 clear. A crafting table is placed on the adjacent tile in front of the player (1 tile in the facing direction), and a furnace is placed two tiles ahead, both on valid path/grass tiles. To ensure a reliable source of iron, three iron‑ore blocks are placed randomly within a Manhattan distance of 5 to 10 from the player, on valid stone/ore‑bearing blocks. The rest of floor 2 uses normal procedural generation with its default ores (iron, coal, diamonds, sapphires, rubies). The agent must craft an iron pickaxe and an iron sword (which requires standing near both the crafting table and the furnace), and must also defeat at least one Gnome Warrior (melee) and one Gnome Archer (ranged). The episode terminates successfully when all four achievements are earned. Mob mechanics are left on full defaults (spawn multipliers = 1.0, health = 1.0, damage = 1.0) to mimic real combat pressure, while survival needs are drastically slowed (needs_depletion_multiplier = 0.1) so the agent can focus entirely on combat and crafting without starvation interference. Torches are provided in inventory; the agent is expected to place them to see in the pitch‑black mines. No descent to floor 3 is required, keeping the task a thin slice.

Relevant Achievements: MAKE_IRON_PICKAXE, MAKE_IRON_SWORD, DEFEAT_GNOME_WARRIOR, DEFEAT_GNOME_ARCHER

Completed Achievements: MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, PLACE_TABLE, PLACE_FURNACE

World:
- Player: Starts on floor 2 at the ladder‑up location. Inventory: stone_pickaxe = 1, stone_sword = 1, torch = 10, coal = 10, wood = 5, stone = 10. All other slots empty. Attributes: strength = 1, dexterity = 1, intelligence = 1. Health/food/drink/energy/mana all 9/9. No enchantments, no learned spells.
- Map:
  - Place a Crafting Table at the player’s start position offset by the agent’s initial facing direction (distance 1), on a walkable tile.
  - Place a Furnace at the player’s start position offset by the facing direction (distance 2), on a walkable tile.
  - Place three Iron‑Ore blocks (BlockType.IRON) randomly within a Manhattan distance of 5 to 10 from the player’s start position, on any ore‑bearing block (e.g., Stone or Path).
  - No other block modifications; floors 0–8 use normal procedural generation.
- Mechanics:
  - monsters_killed_to_clear_level = 8 (default)
  - mob_damage_multiplier = 1.0
  - mob_health_multiplier = 1.0
  - melee_spawn_multiplier = 1.0
  - ranged_spawn_multiplier = 1.0
  - passive_spawn_multiplier = 1.0
  - needs_depletion_multiplier = 0.1
  - health_recover_multiplier = 1.0 (default)
  - health_loss_multiplier = 1.0 (default)
  - mana_recover_multiplier = 1.0 (default)
  - growing_plants_age = 600 (default)
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.MAKE_IRON_PICKAXE,
            Achievement.MAKE_IRON_SWORD,
            Achievement.DEFEAT_GNOME_WARRIOR,
            Achievement.DEFEAT_GNOME_ARCHER,
        ]
        self.completed_achievements = [
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.PLACE_TABLE,
            Achievement.PLACE_FURNACE,
        ]
        self.label = "MAKE_IRON_PICKAXE, MAKE_IRON_SWORD, DEFEAT_GNOME_WARRIOR, DEFEAT_GNOME_ARCHER"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.1,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, iron_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines) at the ladder‑up position
        builder.set_starting_floor(2)

        # Equip stone‑age starting inventory
        builder.set_player_inventory({
            "pickaxe": 2,   # stone pickaxe = tier 2
            "sword": 2,     # stone sword = tier 2
            "torches": 10,
            "coal": 10,
            "wood": 5,
            "stone": 10,
        })

        # The agent initially faces UP; place a Crafting Table 1 tile ahead and a Furnace 2 tiles ahead.
        player_spawn = builder.player_position
        # UP = (-1, 0)
        craft_table_pos = (player_spawn[0] - 1, player_spawn[1])
        furnace_pos = (player_spawn[0] - 2, player_spawn[1])

        builder.place_block(2, BlockType.CRAFTING_TABLE, craft_table_pos)
        builder.place_block(2, BlockType.FURNACE, furnace_pos)

        # Place three iron ore blocks near the spawn on valid ore‑bearing blocks.
        builder.place_randomly_near(
            iron_rng,
            level=2,
            block_type=BlockType.IRON,
            target_pos=player_spawn,
            min_dist=5,
            max_dist=10,
            n=3,
            on_blocks=[BlockType.STONE, BlockType.PATH],
        )

        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
