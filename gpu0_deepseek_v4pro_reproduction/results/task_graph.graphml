  - needs_depletion_multiplier = 0.5
  - melee_spawn_multiplier = 0.5
  - ranged_spawn_multiplier = 0.1
  - passive_spawn_multiplier = 1.0</data>
      <data key="d3">import jax
import jax.numpy as jnp
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Mine iron ore in the pitch‑black Gnomish Mines, relying on torchlight and stone tools while facing moderate monster threats.

Description: The player begins on Floor 2 (Gnomish Mines), which is completely dark. They are equipped with a stone pickaxe, a stone sword, 5 torches, 5 wood, and 5 coal. A crafting table is placed exactly one step away from the player’s starting position (adjacent tile). Three iron ore blocks are distributed randomly within a Manhattan distance of 10 from the player’s spawn point, placed on top of existing stone blocks. The goal is to mine any iron ore (achievement COLLECT_IRON). Survival needs are slowed to keep the focus on exploration and mining, while melee mobs (Gnome Warriors) spawn at half the normal rate to introduce controlled combat pressure. Crafting additional torches is possible with the nearby table and provided coal/wood, but the initial five torches should be sufficient if used wisely.

Relevant Achievements: COLLECT_IRON

Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, MAKE_TORCH, PLACE_TORCH, ENTER_GNOMISH_MINES

World:
- Player: Starts on floor 2 at the ladder‑up position. Inventory: {"pickaxe": 2, "sword": 2, "torch": 5, "wood": 5, "coal": 5}.
- Map:
  - Place one CRAFTING_TABLE block on the tile adjacent to the player’s starting coordinates (any orthogonal neighbour).
  - Use `place_randomly_near` to add 3 iron ore blocks on floor 2 within a Manhattan radius of 10 from the player’s start, restricted to on‑blocks [BlockType.STONE].
- Mechanics:
  - needs_depletion_multiplier = 0.5
  - melee_spawn_multiplier = 0.5
  - ranged_spawn_multiplier = 0.1
  - passive_spawn_multiplier = 1.0
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.COLLECT_IRON]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_TORCH,
            Achievement.PLACE_TORCH,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.label = "COLLECT_IRON"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.5,
            melee_spawn_multiplier=0.5,
            ranged_spawn_multiplier=0.1,
            passive_spawn_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, craft_rng, iron_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(2)

        # Equip the player with necessary tools and resources
        builder.set_player_inventory({
            "pickaxe": 2,   # stone pickaxe
            "sword": 2,     # stone sword
            "torches": 5,
            "wood": 5,
            "coal": 5,
        })

        # Place a crafting table on an adjacent orthogonal tile
        player_pos = builder.player_position
        offsets = jnp.array([[0, 1], [0, -1], [1, 0], [-1, 0]])
        direction_index = jax.random.randint(craft_rng, shape=(), minval=0, maxval=4)
        offset = offsets[direction_index]
        craft_pos = player_pos + offset
        builder.place_block(level=2, block_type=BlockType.CRAFTING_TABLE, position=(craft_pos[0], craft_pos[1]))

        # Scatter 3 iron ore blocks within Manhattan distance 10, restricted to stone blocks
        builder.place_randomly_near(
            iron_rng,
            level=2,
            block_type=BlockType.IRON,
            n=3,
            target_pos=player_pos,
            min_dist=1,
            max_dist=10,
            on_blocks=[BlockType.STONE],
        )

        return builder.build(rng)</data>
