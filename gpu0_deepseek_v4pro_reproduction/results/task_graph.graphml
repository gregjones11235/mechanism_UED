": 98.38056680161944, "collect_coal": 93.11740890688259, "collect_iron": 79.75708502024291, "collect_diamond": 33.19838056680162, "make_iron_pickaxe": 33.19838056680162, "make_iron_sword": 57.08502024291498, "make_arrow": 95.54655870445345, "make_torch": 96.76113360323886, "place_torch": 96.35627530364373, "collect_sapphire": 25.910931174089068, "collect_ruby": 27.530364372469634, "make_diamond_pickaxe": 4.8582995951417, "make_diamond_sword": 4.4534412955465585, "make_iron_armour": 4.8582995951417, "enter_gnomish_mines": 54.65587044534413, "enter_dungeon": 97.16599190283401, "defeat_orc_solider": 94.33198380566802, "defeat_orc_mage": 89.06882591093117, "eat_snail": 96.35627530364373, "find_bow": 97.16599190283401, "fire_bow": 93.92712550607287, "open_chest": 97.16599190283401, "drink_potion": 80.97165991902834}, "average_episode_length": 1141.1214574898786, "mean_return_percentage": 25.790796597331695, "mean_return": 58.287200309969634, "lp": NaN, "priority_score": 0.2478322870396171}]</data>
