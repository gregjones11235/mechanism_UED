      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Descend from the Dungeon (floor 1) into the Gnomish Mines (floor 2) by surviving and defeating more enemies, stepping up the kill requirement to bridge towards the full game difficulty.

Description: The agent starts on floor 1 (the Dungeon) with a stone sword (tier 2) already equipped. All spawns are active but kept at reduced intensity: melee mobs (Orc Soldiers) at half spawn rate (`melee_spawn_multiplier = 0.5`), ranged mobs (Orc Mages) also at half rate (`ranged_spawn_multiplier = 0.5`), and passive mobs (Snails) at normal rate (`passive_spawn_multiplier = 1.0`). The floor‑clearing threshold is raised from the previous step’s 3 to **5** via `monsters_killed_to_clear_level = 5`. Thus the agent must defeat at least five hostile mobs before the down ladder unlocks. Once the kill count is met, the agent must locate the down ladder and descend, triggering the `ENTER_GNOMISH_MINES` achievement and ending the episode as a success. All other achievements are incidental; only the descent counts for success. Survival needs, health regeneration, and all other mechanics remain at default values. This task is designed to strengthen sustained floor 1 combat and ladder utilisation under a more demanding kill threshold, a direct stepping‑stone toward the full game's 8‑kill requirement.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: ENTER_DUNGEON
World:
- Player: Starts on floor 1. Inventory: `{"sword": 2}` (stone sword). All attributes and status bars at default (STR 1, DEX 1, INT 1; health/food/drink/energy/mana all 9/9).
- Map: No modifications. Spawns and terrain are generated by the default dungeon procedure.
- Mechanics: `passive_spawn_multiplier = 1.0`, `melee_spawn_multiplier = 0.5`, `ranged_spawn_multiplier = 0.5`, `monsters_killed_to_clear_level = 5`. All other `TaskParams` at defaults (e.g., `melee_trigger_distance = 10`, `needs_depletion_multiplier = 1.0`).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=0.5,
            ranged_spawn_multiplier=0.5,
            monsters_killed_to_clear_level=5,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Equip a stone sword
        builder.set_player_inventory({"sword": 2})

        state = builder.build(rng)

        # Mark the pre-completed achievement as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
