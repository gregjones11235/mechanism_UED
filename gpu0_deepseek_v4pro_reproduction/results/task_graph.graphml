      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Forge an iron sword from ore mined in the Gnomish Mines, then descend to the Sewers.

Description: The agent starts on floor 2 (Gnomish Mines) at the ladder‑up position. The mines are pitch‑black, so the agent must use torches. A crafting table and a furnace are placed directly adjacent to the spawn tile (one in front, one to the side) to provide the required crafting stations. The inventory is pre‑stocked with: 1 stone pickaxe, 1 stone sword, and 8 torches. All other inventory slots are empty. The player begins with full health (9/9), full mana (9/9), and default attributes (Strength=1, Dexterity=1, Intelligence=1). Needs depletion has been disabled (`needs_depletion_multiplier = 0.0`), so hunger, thirst, and fatigue never advance; the agent does not need to find food, water, or sleep. To ensure the agent can realistically gather iron and coal, the world builder places exactly 4 iron ore blocks and 4 coal blocks randomly within a Manhattan distance of 5 from the spawn, on valid stone terrain. The Gnomish Mines spawn normal hostile mobs (Gnome Warriors and Gnome Archers) but with reduced difficulty: mob health is 70% of normal (`mob_health_multiplier = 0.7`), mob damage is 70% (`mob_damage_multiplier = 0.7`), and only 4 monsters must be killed to unlock the ladder down to floor 3 (`monsters_killed_to_clear_level = 4`). All other game mechanics (passive/melee/ranged spawn multipliers, etc.) remain at default. The task is considered successful when the agent achieves all three goals: collects at least one iron ore (COLLECT_IRON), crafts an iron sword (MAKE_IRON_SWORD), and descends to the Sewers (ENTER_SEWERS).

Relevant Achievements: COLLECT_IRON, MAKE_IRON_SWORD, ENTER_SEWERS
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.COLLECT_IRON,
            Achievement.MAKE_IRON_SWORD,
            Achievement.ENTER_SEWERS,
        ]
        self.completed_achievements = [
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.PLACE_TABLE,
            Achievement.PLACE_FURNACE,
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.label = "COLLECT_IRON, MAKE_IRON_SWORD, ENTER_SEWERS"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.0,
            mob_health_multiplier=0.7,
            mob_damage_multiplier=0.7,
            monsters_killed_to_clear_level=4,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, table_rng, furnace_rng, iron_rng, coal_rng = jax.random.split(rng, 6)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines)
        builder.set_starting_floor(2)

        # Set starting inventory: stone pickaxe, stone sword, and 8 torches
        builder.set_player_inventory({
            "pickaxe": 2,   # stone pickaxe
            "sword": 2,     # stone sword
            "torches": 8,
        })

        # Player spawn position (up-ladder on floor 2)
        spawn = builder.player_position

        # Place a crafting table directly adjacent to spawn
        builder.place_randomly_near(
            table_rng,
            level=2,
            block_type=BlockType.CRAFTING_TABLE,
            target_pos=spawn,
            min_dist=1,
            max_dist=1,
            n=1,
            on_blocks=[BlockType.PATH, BlockType.STONE],
        )

        # Place a furnace directly adjacent to spawn (next to spawn but not on the same tile as the table)
        builder.place_randomly_near(
            furnace_rng,
            level=2,
            block_type=BlockType.FURNACE,
            target_pos=spawn,
            min_dist=1,
            max_dist=1,
            n=1,
            on_blocks=[BlockType.PATH, BlockType.STONE],
        )

        # Place exactly 4 iron ore blocks on stone within distance 5
        builder.place_randomly_near(
            iron_rng,
            level=2,
            block_type=BlockType.IRON,
            target_pos=spawn,
            min_dist=1,
            max_dist=5,
            n=4,
            on_blocks=[BlockType.STONE],
        )

        # Place exactly 4 coal ore blocks on stone within distance 5
        builder.place_randomly_near(
            coal_rng,
            level=2,
            block_type=BlockType.COAL,
            target_pos=spawn,
            min_dist=1,
            max_dist=5,
            n=4,
            on_blocks=[BlockType.STONE],
        )

        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
