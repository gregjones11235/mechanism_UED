      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to clear the Dungeon and descend to the Gnomish Mines without the distraction of overworld preparation.

Description: The agent begins on floor 1 (the Dungeon) with a stone sword, stone pickaxe, and a supply of torches. It must navigate the procedurally generated dungeon, defeat at least 8 Orc Soldiers or Orc Mages to unlock the ladder down, and then descend to floor 2, thereby unlocking the ENTER_GNOMISH_MINES achievement. Survival pressures are minimized (needs depletion 0.1×) so the agent can focus purely on combat, lighting management with torches, and navigating rooms/corridors. All mob stats and spawn rates remain at their default values.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: ENTER_DUNGEON, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD

World:
- Player: Starts on floor 1 at the “ladder up” position. Inventory: sword = 2 (stone tier), pickaxe = 2 (stone tier), torch = 10. All player attributes default (strength=1, dexterity=1, intelligence=1). Health, food, drink, energy, mana are all maxed at 9. No weapon or armour enchantments, no learned spells.
- Map: Use the default procedural generation for all 9 floors; no additional block modifications.
- Mechanics:
  - monsters_killed_to_clear_level = 8
  - needs_depletion_multiplier = 0.1
  - All other TaskParams at defaults (passive_spawn_multiplier = 1.0, melee_spawn_multiplier = 1.0, ranged_spawn_multiplier = 1.0, mob_health_multiplier = 1.0, mob_damage_multiplier = 1.0, health_recover_multiplier = 1.0, health_loss_multiplier = 1.0, mana_recover_multiplier = 1.0, growing_plants_age = 600, melee_trigger_distance = 10).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
            needs_depletion_multiplier=0.1,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) – this places the player on the up-ladder
        builder.set_starting_floor(1)

        # Equip starting inventory: stone sword (2), stone pickaxe (2), 10 torches
        builder.set_player_inventory({
            "sword": 2,     # stone tier
            "pickaxe": 2,   # stone tier
            "torches": 10,
        })

        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
