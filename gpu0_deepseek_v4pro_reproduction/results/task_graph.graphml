_torch": 58.854166666666664, "collect_sapphire": 10.049019607843137, "collect_ruby": 9.497549019607844, "make_diamond_pickaxe": 1.5012254901960784, "make_diamond_sword": 1.286764705882353, "make_iron_armour": 0.12254901960784313, "enter_dungeon": 100.0, "defeat_orc_solider": 87.74509803921569, "find_bow": 95.18995098039215, "fire_bow": 87.62254901960785, "open_chest": 95.18995098039215, "drink_potion": 31.158088235294116}, "average_episode_length": 86.44546568627452, "mean_return_percentage": 15.4578899149884, "mean_return": 34.93483120787378, "lp": NaN, "priority_score": 0.10753075740099963}]</data>
