      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Master clearing the Dungeon under full, original‑game mob density to reliably descend into the Gnomish Mines.

Description: The agent starts in the Dungeon (floor 1) with a stone sword already equipped and full survival bars. All mob spawn intensities are now set to the original Craftax default values: melee mobs (Orc Soldiers) at normal rate (`melee_spawn_multiplier = 1.0`), ranged mobs (Orc Mages) at normal rate (`ranged_spawn_multiplier = 1.0`), passive mobs (Snails) at normal rate (`passive_spawn_multiplier = 1.0`). The floor‑clearing threshold remains `monsters_killed_to_clear_level = 8`, exactly matching the full game’s requirement. The agent must defeat at least eight hostile mobs, find the down ladder, and use the DESCEND action to trigger `ENTER_GNOMISH_MINES`. Only this achievement matters for success termination. Survival needs, regeneration, and all other mechanics stay at default values. This task provides the full, un‑scaled combat pressure of the original Dungeon, forcing the agent to generalise its combat and resource‑management skills to the density it will experience in the complete Craftax game.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: ENTER_DUNGEON
World:
- Player: Starts on floor 1. Inventory: `{"sword": 2}` (stone sword). Basic attributes (STR 1, DEX 1, INT 1) and full status bars (health 9, food 9, drink 9, energy 9, mana 9).
- Map: No modifications; default Dungeon generation (floor 1).
- Mechanics: `passive_spawn_multiplier = 1.0`, `melee_spawn_multiplier = 1.0`, `ranged_spawn_multiplier = 1.0`, `monsters_killed_to_clear_level = 8`. All other `TaskParams` at defaults (e.g., `melee_trigger_distance = 10`, `needs_depletion_multiplier = 1.0`).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            monsters_killed_to_clear_level=8,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon)
        builder.set_starting_floor(1)

        # Equip only a stone sword (tier 2)
        builder.set_player_inventory({"sword": 2})

        # No other modifications; use default world generation
        state = builder.build(rng)

        # Mark pre-completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
