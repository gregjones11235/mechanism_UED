      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Descend from the Gnomish Mines (Floor 2) into the Sewers (Floor 3) by defeating Gnome enemies in a dark environment, using stone‑tier melee and a bow.

Description: The agent spawns on Floor 2 (Gnomish Mines) at the ladder‑up location. Its inventory contains a stone sword (tier 2), a stone pickaxe (tier 2), a bow, 20 arrows, and 10 torches. All stats start at 1, status bars full, no enchantments, no learned spells. Floor 2 uses the default procedurally‑generated mines (smooth terrain, stalagmites, ores, total darkness). The agent must explore, light its surroundings with torches, fight Gnome Warriors (melee) and Gnome Archers (ranged), and kill a total of 4 hostiles to unlock the ladder down to the Sewers. Stepping onto the ladder and descending ends the episode successfully. Mob damage is halved (0.5×) to keep early encounters survivable; all other mechanics (spawn rates, needs depletion, health/mana regen) remain at default. The task forces the agent to learn combat against new, harder foes while maintaining light, with the option to scavenge or craft additional equipment (e.g., iron tools) but no iron‑crafting requirement.

Relevant Achievements: ENTER_SEWERS

Completed Achievements: COLLECT_WOOD, PLACE_TABLE, MAKE_WOOD_PICKAXE, COLLECT_STONE, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, MAKE_WOOD_SWORD, ENTER_DUNGEON, ENTER_GNOMISH_MINES

World:
- Player:
  - Starting floor: 2
  - Inventory: sword=1 (stone), pickaxe=1 (stone), bow=1, arrows=20, torches=10; all other counts 0.
  - Stats: strength=1, dexterity=1, intelligence=1.
  - Needs: health=9/9, food=9/9, drink=9/9, energy=9/9, mana=9/9.
  - Spells: fireball=False, iceball=False; enchantments: none.
  - Monsters killed: set `level 1` kill count to 8 (unlocks ladder from Floor 1, but agent starts on Floor 2).
- Map:
  - No manual block modifications; all floors use default procedural generation.
  - `set_starting_floor(2)` places the agent at the Floor 2 up‑ladder position.
- Mechanics:
  - monsters_killed_to_clear_level = 4
  - mob_damage_multiplier = 0.5
  - All other TaskParams remain default (1.0).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_SEWERS,
        ]
        self.completed_achievements = [
            Achievement.COLLECT_WOOD,
            Achievement.PLACE_TABLE,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.COLLECT_STONE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.label = "ENTER_SEWERS"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=4,
            mob_damage_multiplier=0.5,
            # All other TaskParams remain default (1.0)
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines)
        builder.set_starting_floor(2)

        # Equip starting inventory: stone sword (tier 2), stone pickaxe (tier 2),
        # bow, 20 arrows, 10 torches
        builder.set_player_inventory({
            "sword": 2,      # stone sword
            "pickaxe": 2,    # stone pickaxe
            "bow": 1,
            "arrows": 20,
            "torches": 10,
        })

        # No manual block or mob placements – default generation suffices

        # Set monsters killed on level 1 (Dungeon) to 8 so the ladder up is unlocked
        builder.set_monsters_killed(1, 8)

        state = builder.build(rng)

        # Mark pre‑completed achievements
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
