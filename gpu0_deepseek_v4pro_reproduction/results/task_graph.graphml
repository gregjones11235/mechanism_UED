ollect_stone": 95.90163934426229, "place_stone": 95.49180327868852, "eat_plant": 14.754098360655737, "defeat_skeleton": 54.91803278688525, "make_stone_pickaxe": 78.27868852459017, "make_stone_sword": 86.47540983606558, "wake_up": 98.36065573770492, "place_furnace": 95.49180327868852, "collect_coal": 88.93442622950819, "collect_iron": 61.0655737704918, "collect_diamond": 28.278688524590162, "make_iron_pickaxe": 18.442622950819672, "make_iron_sword": 24.18032786885246, "make_arrow": 84.01639344262296, "make_torch": 94.26229508196721, "place_torch": 94.26229508196721, "collect_sapphire": 27.049180327868854, "collect_ruby": 24.59016393442623, "make_diamond_pickaxe": 3.6885245901639343, "make_diamond_sword": 2.459016393442623, "make_iron_armour": 0.4098360655737705, "enter_gnomish_mines": 61.47540983606557, "enter_dungeon": 92.62295081967213, "defeat_orc_solider": 88.52459016393442, "defeat_orc_mage": 84.01639344262296, "eat_snail": 90.98360655737704, "find_bow": 92.21311475409836, "fire_bow": 81.14754098360656, "open_chest": 92.21311475409836, "drink_potion": 78.68852459016394}, "average_episode_length": 1152.122950819672, "mean_return_percentage": 24.797961501931308, "mean_return": 56.04339299436475, "lp": NaN, "priority_score": 0.23683149690943295}]</data>
