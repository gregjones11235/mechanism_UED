ce": 98.34024896265561, "collect_coal": 93.7759336099585, "collect_iron": 80.91286307053942, "collect_diamond": 28.630705394190873, "make_iron_pickaxe": 19.91701244813278, "make_iron_sword": 48.13278008298755, "make_arrow": 94.19087136929461, "make_torch": 94.19087136929461, "place_torch": 93.7759336099585, "collect_sapphire": 22.406639004149376, "collect_ruby": 23.236514522821576, "make_diamond_pickaxe": 1.6597510373443984, "make_diamond_sword": 3.7344398340248963, "make_iron_armour": 4.564315352697095, "enter_gnomish_mines": 30.70539419087137, "enter_dungeon": 95.02074688796681, "defeat_orc_solider": 86.72199170124482, "defeat_orc_mage": 81.74273858921161, "eat_snail": 89.6265560165975, "find_bow": 93.3609958506224, "fire_bow": 90.04149377593362, "open_chest": 93.3609958506224, "drink_potion": 74.27385892116183}, "average_episode_length": 1152.402489626556, "mean_return_percentage": 20.374370234986046, "mean_return": 46.04607673106847, "lp": NaN, "priority_score": 0.21277181866703399}]</data>
