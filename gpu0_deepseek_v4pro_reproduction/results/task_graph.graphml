010541304794}, {"session": 46, "sr": 0.8360995850622407, "achievement_srs": {"collect_wood": 8.506224066390041, "place_table": 8.091286307053942, "collect_sapling": 8.506224066390041, "collect_drink": 28.83817427385892, "make_wood_pickaxe": 18.672199170124482, "make_wood_sword": 100.0, "place_plant": 8.091286307053942, "collect_stone": 8.71369294605809, "place_stone": 8.71369294605809, "eat_plant": 4.771784232365145, "make_stone_pickaxe": 13.070539419087137, "make_stone_sword": 100.0, "wake_up": 7.053941908713693, "place_furnace": 8.298755186721992, "collect_coal": 29.25311203319502, "collect_iron": 31.95020746887967, "collect_diamond": 13.278008298755188, "make_iron_pickaxe": 8.921161825726141, "make_arrow": 36.92946058091286, "make_torch": 73.02904564315352, "place_torch": 67.42738589211618, "collect_sapphire": 13.692946058091286, "collect_ruby": 13.278008298755188, "make_diamond_pickaxe": 1.8672199170124482, "make_diamond_sword": 0.6224066390041494, "enter_dungeon": 100.0, "defeat_orc_solider": 83.60995850622406, "find_bow": 96.2655601659751, "fire_bow": 36.72199170124481, "open_chest": 96.2655601659751, "drink_potion": 41.49377593360996}, "average_episode_length": 680.2593360995851, "mean_return_percentage": 14.125515946875113, "mean_return": 31.92366603993776, "lp": NaN, "priority_score": 0.13703706892098963}]</data>
