      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Clear the Dungeon floor by defeating a mixed group of Orc Soldiers and Orc Mages, then descend to the Gnomish Mines.

    Description: The agent begins on Floor 1 (Dungeon) at the ladder‑up arrival point with an iron sword (`{"sword": 3}`) in its inventory. Survival needs are active at a reduced rate (`needs_depletion_multiplier = 0.3`) and health regeneration is boosted (`health_recover_multiplier = 2.0`). All natural spawns are suppressed (`passive_spawn_multiplier = 0.0`, `melee_spawn_multiplier = 0.0`, `ranged_spawn_multiplier = 0.0`), leaving only the manually placed orcs. Four hostile mobs are placed on Floor 1: two Orc Soldiers (`mob_name = "melee"`, `type_id = 2`) and two Orc Mages (`mob_name = "ranged"`, `type_id = 2`), each randomly positioned within Manhattan distance 4‑8 of the player’s start, using `on_blocks = [BlockType.PATH]`. The floor‑clearance requirement is set to `monsters_killed_to_clear_level = 4`, so the ladder down will not unlock until all four placed orcs are killed. A Fountain (`BlockType.FOUNTAIN`) is placed randomly near the start within distance 3‑6 on PATH to satisfy thirst without long exploration. Once the floor is cleared, the agent must find the ladder down (spawned by the default dungeon generation) and use the `DESCEND` action to reach Floor 2 (Gnomish Mines). Success occurs when the agent has gained the achievements DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, and ENTER_GNOMISH_MINES. Chests and other dungeon features remain available for bows, arrows, and potions.

    Relevant Achievements: DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, ENTER_GNOMISH_MINES
    Completed Achievements: ENTER_DUNGEON, MAKE_IRON_SWORD
    World:
    - Player: Starting floor 1; inventory `{"sword": 3}`. All other stats at default (full health, food, drink, energy, mana).
    - Map:
      * On Floor 1, place **two** Orc Soldiers (`mob_name = "melee"`, `type_id = 2`) randomly within Manhattan distance 4‑8 of the player’s start, using `on_blocks = [BlockType.PATH]`.
      * Place **two** Orc Mages (`mob_name = "ranged"`, `type_id = 2`) under the same distance and block constraints.
      * Place one Fountain (`BlockType.FOUNTAIN`) randomly near the player’s start within Manhattan distance 3‑6, using `on_blocks = [BlockType.PATH]`.
    - Mechanics:
        "needs_depletion_multiplier": 0.3,
        "health_recover_multiplier": 2.0,
        "melee_spawn_multiplier": 0.0,
        "passive_spawn_multiplier": 0.0,
        "ranged_spawn_multiplier": 0.0,
        "monsters_killed_to_clear_level": 4
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.DEFEAT_ORC_SOLIDER,
            Achievement.DEFEAT_ORC_MAGE,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.MAKE_IRON_SWORD,
        ]
        self.label = "DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.3,
            health_recover_multiplier=2.0,
            melee_spawn_multiplier=0.0,
            passive_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=4,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, melee_rng, ranged_rng, fountain_rng = jax.random.split(rng, 5)

        builder = WorldBuilder(build_rng, self.static_params, self.params)
        builder.set_starting_floor(1)
        builder.set_player_inventory({"sword": 3})

        # Place two Orc Soldiers (melee, type_id=2)
        builder.add_mobs_randomly_near(
            melee_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=2,
            target_pos=builder.player_position,
            min_dist=4,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        # Place two Orc Mages (ranged, type_id=2)
        builder.add_mobs_randomly_near(
            ranged_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=2,
            target_pos=builder.player_position,
            min_dist=4,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        # Place a Fountain near the player
        builder.place_randomly_near(
            fountain_rng,
            level=1,
            block_type=BlockType.FOUNTAIN,
            n=1,
            target_pos=builder.player_position,
            min_dist=3,
            max_dist=6,
            on_blocks=[BlockType.PATH],
        )

        return builder.build(rng)</data>
