iamond": 25.099601593625497, "make_iron_pickaxe": 21.91235059760956, "make_iron_sword": 31.872509960159363, "make_arrow": 95.2191235059761, "make_torch": 94.02390438247012, "place_torch": 93.62549800796813, "collect_sapphire": 22.310756972111555, "collect_ruby": 26.294820717131476, "make_diamond_pickaxe": 1.9920318725099602, "make_diamond_sword": 2.3904382470119523, "make_iron_armour": 2.7888446215139444, "enter_gnomish_mines": 44.62151394422311, "enter_dungeon": 97.21115537848605, "defeat_orc_solider": 94.42231075697211, "defeat_orc_mage": 88.44621513944223, "eat_snail": 96.41434262948208, "find_bow": 96.81274900398407, "fire_bow": 92.82868525896414, "open_chest": 96.81274900398407, "drink_potion": 81.27490039840637}, "average_episode_length": 1128.5776892430279, "mean_return_percentage": 21.275334915867504, "mean_return": 48.08225690986056, "lp": NaN, "priority_score": 0.24710718877478133}, {"session": 110, "sr": 0.3978102189781022, "achievement_srs": {"eat_cow": 98.54014598540147, "collect_sapling": 100.0, "collect_drink": 98.54014598540147, "make_wood_sword": 100.0, "place_plant": 99.63503649635037, "defeat_zombie": 69.34306569343066, "place_stone": 97.81021897810218, "eat_plant": 16.05839416058394, "defeat_skeleton": 64.96350364963503, "make_stone_pickaxe": 80.65693430656934, "wake_up": 98.17518248175182, "place_furnace": 97.08029197080292, "collect_coal": 90.87591240875912, "collect_iron": 66.05839416058394, "collect_diamond": 31.386861313868614, "make_iron_pickaxe": 20.072992700729927, "make_iron_sword": 39.416058394160586, "make_arrow": 94.16058394160584, "make_torch": 91.60583941605839, "place_torch": 91.60583941605839, "collect_sapphire": 19.708029197080293, "collect_ruby": 29.197080291970803, "make_diamond_pickaxe": 0.7299270072992701, "make_diamond_sword": 3.2846715328467155, "make_iron_armour": 5.839416058394161, "enter_gnomish_mines": 39.78102189781022, "enter_dungeon": 98.17518248175182, "defeat_orc_solider": 94.16058394160584, "defeat_orc_mage": 82.48175182481752, "eat_snail": 95.98540145985402, "find_bow": 96.71532846715328, "fire_bow": 91.24087591240875, "open_chest": 96.71532846715328, "drink_potion": 75.54744525547446}, "average_episode_length": 1050.405109489051, "mean_return_percentage": 20.65803129138137, "mean_return": 46.6871507185219, "lp": NaN, "priority_score": 0.23955724865469658}]</data>
