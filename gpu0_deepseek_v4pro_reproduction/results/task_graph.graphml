      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to fight Gnome Warriors and Gnome Archers in the dark environment of the Gnomish Mines.

Description: The agent starts on Floor 2 (the Gnomish Mines) at the up‑ladder position. It is equipped with a stone sword, stone pickaxe, a bow, 10 arrows, and 5 torches; all survival stats (food, drink, health, energy, mana) are at maximum. The default Gnomish Mines level is generated with its typical stalagmites, darkness (light 0), and ores. To guarantee early encounters and minimize navigation overhead, one Gnome Warrior (melee, type_id 1) and one Gnome Archer (ranged, type_id 1) are placed near the agent. No additional blocks or structures are modified. The task succeeds (terminates with is_success=True) only when both `DEFEAT_GNOME_WARRIOR` and `DEFEAT_GNOME_ARCHER` achievements are unlocked. This forces the agent to engage the new enemy types, manage light with torches, and apply its existing combat skills in a pitch‑black setting.

Relevant Achievements: DEFEAT_GNOME_WARRIOR, DEFEAT_GNOME_ARCHER

Completed Achievements: ENTER_GNOMISH_MINES, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, MAKE_ARROW

World:
- Player:
  - `builder.set_starting_floor(2)` (spawn at the Gnomish Mines up‑ladder, which is below the Dungeon down‑ladder)
  - `builder.set_player_inventory({"pickaxe": 2, "sword": 2, "bow": 1, "arrows": 10, "torches": 5})`  (stone tools, ranged weapon, ammunition, light)
  - `builder.set_player_stats(strength=1, dexterity=1, intelligence=1)` (default attributes)
  - All survival meters (health, food, drink, energy, mana) begin at 9 (full)
- Map:
  - No block modifications; the default procedural Gnomish Mines level is used.
  - `builder.add_mobs_randomly_near(rng, 2, "melee", 1, 1, player_position, min_dist=2, max_dist=6, on_blocks=[BlockType.PATH, BlockType.STONE])`  // Gnome Warrior
  - `builder.add_mobs_randomly_near(rng, 2, "ranged", 1, 1, player_position, min_dist=2, max_dist=6, on_blocks=[BlockType.PATH, BlockType.STONE])`  // Gnome Archer
- Mechanics:
  - All TaskParams kept at default values (monsters_killed_to_clear_level = 8, etc.)
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.DEFEAT_GNOME_WARRIOR,
            Achievement.DEFEAT_GNOME_ARCHER,
        ]
        self.completed_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_ARROW,
        ]
        self.label = "DEFEAT_GNOME_WARRIOR, DEFEAT_GNOME_ARCHER"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        # All default values are kept; no changes needed.
        return TaskParams()

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, melee_rng, ranged_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines)
        builder.set_starting_floor(2)

        # Equip starting inventory: stone tools, bow, arrows, torches
        builder.set_player_inventory({
            "pickaxe": 2,    # stone pickaxe
            "sword": 2,      # stone sword
            "bow": 1,        # normal bow
            "arrows": 10,
            "torches": 5,
        })

        # Default attributes (explicit for clarity)
        builder.set_player_stats(strength=1, dexterity=1, intelligence=1)

        # Place one Gnome Warrior (melee, type_id=1) near the player
        builder.add_mobs_randomly_near(
            rng=melee_rng,
            level=2,
            mob_name="melee",
            type_id=1,
            n=1,
            target_pos=builder.player_position,
            min_dist=2,
            max_dist=6,
            on_blocks=[BlockType.PATH, BlockType.STONE],
        )

        # Place one Gnome Archer (ranged, type_id=1) near the player
        builder.add_mobs_randomly_near(
            rng=ranged_rng,
            level=2,
            mob_name="ranged",
            type_id=1,
            n=1,
            target_pos=builder.player_position,
            min_dist=2,
            max_dist=6,
            on_blocks=[BlockType.PATH, BlockType.STONE],
        )

        # Build the full initial state
        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
