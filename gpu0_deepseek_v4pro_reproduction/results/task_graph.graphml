, "place_furnace": 90.97744360902256, "collect_coal": 84.9624060150376, "collect_iron": 78.94736842105263, "collect_diamond": 31.954887218045112, "make_iron_pickaxe": 26.31578947368421, "make_iron_sword": 45.86466165413534, "make_arrow": 91.72932330827068, "make_torch": 100.0, "place_torch": 100.0, "collect_sapphire": 22.93233082706767, "collect_ruby": 25.56390977443609, "make_diamond_pickaxe": 1.8796992481203008, "make_diamond_sword": 2.6315789473684212, "enter_gnomish_mines": 52.255639097744364, "enter_dungeon": 100.0, "defeat_orc_solider": 97.74436090225564, "defeat_orc_mage": 89.47368421052632, "eat_snail": 99.24812030075188, "find_bow": 98.1203007518797, "fire_bow": 90.22556390977444, "open_chest": 98.1203007518797, "drink_potion": 78.57142857142857}, "average_episode_length": 979.4774436090225, "mean_return_percentage": 20.918179605367122, "mean_return": 47.2750859081297, "lp": NaN, "priority_score": 0.2494912092260727}, {"session": 148, "sr": 0.6180555555555556, "achievement_srs": {"collect_wood": 94.09722222222223, "place_table": 93.75, "eat_cow": 87.84722222222223, "collect_sapling": 92.36111111111111, "collect_drink": 98.26388888888889, "make_wood_pickaxe": 100.0, "make_wood_sword": 100.0, "place_plant": 91.66666666666667, "defeat_zombie": 48.958333333333336, "collect_stone": 94.44444444444444, "place_stone": 93.75, "eat_plant": 14.583333333333334, "defeat_skeleton": 46.18055555555556, "wake_up": 97.91666666666667, "place_furnace": 94.44444444444444, "collect_coal": 88.19444444444444, "collect_iron": 84.02777777777777, "collect_diamond": 36.458333333333336, "make_iron_pickaxe": 32.291666666666664, "make_iron_sword": 56.59722222222222, "make_arrow": 95.83333333333333, "make_torch": 100.0, "place_torch": 100.0, "collect_sapphire": 30.208333333333332, "collect_ruby": 25.34722222222222, "make_diamond_pickaxe": 3.4722222222222223, "make_diamond_sword": 5.208333333333333, "enter_gnomish_mines": 61.80555555555556, "enter_dungeon": 100.0, "defeat_orc_solider": 97.91666666666667, "defeat_orc_mage": 93.40277777777777, "eat_snail": 98.61111111111111, "find_bow": 100.0, "fire_bow": 95.83333333333333, "open_chest": 100.0, "drink_potion": 83.68055555555556}, "average_episode_length": 987.4652777777778, "mean_return_percentage": 22.72308409624278, "mean_return": 51.35417005750868, "lp": NaN, "priority_score": 0.23606288580246912}]</data>
