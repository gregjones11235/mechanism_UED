ake_diamond_sword": 4.787234042553192, "make_iron_armour": 3.723404255319149, "enter_gnomish_mines": 73.40425531914893, "enter_dungeon": 100.0, "defeat_orc_solider": 98.40425531914893, "defeat_orc_mage": 90.95744680851064, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 97.6063829787234, "drink_potion": 86.96808510638297}, "average_episode_length": 747.1329787234042, "mean_return_percentage": 19.64556766395806, "mean_return": 44.398982920545215, "lp": NaN, "priority_score": 0.19522408329560886}]</data>
