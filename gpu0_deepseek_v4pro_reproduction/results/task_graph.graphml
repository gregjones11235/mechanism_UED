06, "make_iron_sword": 39.647577092511014, "make_arrow": 98.23788546255507, "make_torch": 97.79735682819383, "place_torch": 95.59471365638767, "collect_sapphire": 25.550660792951543, "collect_ruby": 29.07488986784141, "make_diamond_pickaxe": 3.5242290748898677, "make_diamond_sword": 3.9647577092511015, "make_iron_armour": 4.405286343612334, "enter_gnomish_mines": 70.9251101321586, "enter_dungeon": 98.6784140969163, "defeat_orc_solider": 96.91629955947137, "defeat_orc_mage": 92.0704845814978, "eat_snail": 96.91629955947137, "find_bow": 98.23788546255507, "fire_bow": 96.0352422907489, "open_chest": 98.23788546255507, "drink_potion": 85.02202643171806}, "average_episode_length": 1152.876651982379, "mean_return_percentage": 27.28559635223773, "mean_return": 61.66544775605727, "lp": NaN, "priority_score": 0.2062139765957034}]</data>
