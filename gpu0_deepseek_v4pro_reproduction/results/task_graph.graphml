 "collect_coal": 97.4151857835218, "collect_iron": 95.79967689822294, "collect_diamond": 2.504038772213247, "make_iron_pickaxe": 3.877221324717286, "make_iron_sword": 90.38772213247172, "make_arrow": 97.49596122778675, "make_torch": 86.34894991922455, "place_torch": 78.67528271405493, "collect_sapphire": 1.938610662358643, "collect_ruby": 2.5848142164781907, "make_diamond_pickaxe": 0.24232633279483037, "make_diamond_sword": 0.5654281098546042, "make_iron_armour": 0.24232633279483037, "enter_dungeon": 28.352180936995154, "defeat_orc_solider": 6.54281098546042, "defeat_orc_mage": 0.16155088852988692, "eat_snail": 8.64297253634895, "find_bow": 25.605815831987076, "fire_bow": 22.294022617124394, "open_chest": 25.605815831987076, "drink_potion": 4.684975767366721}, "average_episode_length": 223.75767366720518, "mean_return_percentage": 15.960542837344704, "mean_return": 36.070826812399034, "lp": NaN, "priority_score": 0.08688319009502535}, {"session": 34, "sr": 0.910295616717635, "achievement_srs": {"collect_wood": 100.0, "place_table": 100.0, "eat_cow": 88.17533129459736, "collect_sapling": 96.53414882772681, "collect_drink": 88.27726809378186, "make_wood_pickaxe": 100.0, "place_plant": 95.82059123343527, "defeat_zombie": 95.00509683995922, "collect_stone": 100.0, "place_stone": 98.77675840978593, "eat_plant": 2.4464831804281344, "defeat_skeleton": 9.683995922528032, "make_stone_sword": 98.1651376146789, "wake_up": 85.72884811416921, "place_furnace": 99.79612640163099, "collect_coal": 98.47094801223241, "collect_iron": 96.94189602446484, "collect_diamond": 3.9755351681957185, "make_iron_pickaxe": 4.587155963302752, "make_iron_sword": 91.0295616717635, "make_arrow": 99.38837920489297, "make_torch": 88.78695208970439, "place_torch": 81.54943934760449, "collect_sapphire": 4.994903160040774, "collect_ruby": 3.669724770642202, "make_diamond_pickaxe": 0.509683995922528, "make_diamond_sword": 0.7135575942915392, "make_iron_armour": 6.72782874617737, "enter_dungeon": 42.8134556