      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Train the agent to navigate from the overworld into the dungeon and then fight through orcs to reach the Gnomish Mines, bridging the gap between wandering the surface and the dungeon‑clearing skills already demonstrated.

Description: The agent starts on floor 0 (Overworld) at the default spawn location. It is given a stone sword, stone pickaxe, bow, 10 arrows, and 10 torches—the same loadout that enabled successful dungeon clearing in the parent task. Survival needs are kept at half speed (needs_depletion_multiplier = 0.5) to keep the focus on combat and navigation. Mob damage is at the standard 1.0 multiplier. Floor 0’s ladder down is already considered cleared (monsters_killed[0] = 10), so no overworld combat is required; the agent only needs to locate the ladder and descend. Once on floor 1 (the Dungeon), the agent must defeat 8 orcs (soldiers and mages) to unlock the ladder to floor 2 (Gnomish Mines). Ascending to floor 2 achieves the `ENTER_GNOMISH_MINES` achievement and ends the episode. All other floors remain unchanged.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, FIND_BOW

World:
- Player: Starts on floor 0 (Overworld) at the default spawn position. Inventory: stone_pickaxe=1, stone_sword=1, bow=1, arrows=10, torches=10. Equipment slots empty, enchantments 0, learned spells both false. Attributes: strength=1, dexterity=1, intelligence=1. Status bars all 9/9.
- Map: No manual block modifications. Use the default procedural generation for all nine floors. Additionally, call `set_monsters_killed(level=0, count=10)` to open the overworld ladder down immediately, matching the original Craftax initialisation.
- Mechanics:
  - monsters_killed_to_clear_level = 8
  - mob_damage_multiplier = 1.0
  - needs_depletion_multiplier = 0.5
  - health_recover_multiplier = 1.0
  - health_loss_multiplier = 1.0
  - mana_recover_multiplier = 1.0
  - melee_spawn_multiplier = 1.0
  - ranged_spawn_multiplier = 1.0
  - passive_spawn_multiplier = 1.0
  - melee_trigger_distance = 10 (default)
  - growing_plants_age = 600 (default)
  - All other TaskParams at default.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.FIND_BOW,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
            needs_depletion_multiplier=0.5,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld) at default centre
        builder.set_starting_floor(0)

        # Equip starting inventory: stone sword (tier 2), stone pickaxe (tier 2),
        # bow, 10 arrows, 10 torches
        builder.set_player_inventory({
            "sword": 2,
            "pickaxe": 2,
            "bow": 1,
            "arrows": 10,
            "torches": 10,
        })

        # Unlock the overworld ladder down by setting kills to 10
        builder.set_monsters_killed(level=0, count=10)

        state = builder.build(rng)

        # Mark completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
