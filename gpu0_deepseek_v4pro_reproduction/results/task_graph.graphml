e": 98.49246231155779, "place_stone": 97.98994974874371, "eat_plant": 22.110552763819097, "defeat_skeleton": 60.80402010050251, "make_stone_pickaxe": 79.39698492462311, "make_stone_sword": 92.46231155778895, "wake_up": 96.98492462311557, "place_furnace": 97.48743718592965, "collect_coal": 92.96482412060301, "collect_iron": 70.85427135678393, "collect_diamond": 29.64824120603015, "make_iron_pickaxe": 16.08040201005025, "make_iron_sword": 30.65326633165829, "make_arrow": 95.47738693467336, "make_torch": 94.9748743718593, "place_torch": 94.9748743718593, "collect_sapphire": 23.618090452261306, "collect_ruby": 24.12060301507538, "make_diamond_pickaxe": 3.0150753768844223, "make_diamond_sword": 4.0201005025125625, "make_iron_armour": 3.5175879396984926, "enter_gnomish_mines": 68.84422110552764, "enter_dungeon": 96.98492462311557, "defeat_orc_solider": 96.98492462311557, "defeat_orc_mage": 90.45226130653266, "eat_snail": 94.9748743718593, "find_bow": 96.98492462311557, "fire_bow": 93.46733668341709, "open_chest": 96.98492462311557, "drink_potion": 79.89949748743719}, "average_episode_length": 1310.1658291457286, "mean_return_percentage": 26.51403232631632, "mean_return": 59.921713057474875, "lp": NaN, "priority_score": 0.2144895330925987}]</data>
