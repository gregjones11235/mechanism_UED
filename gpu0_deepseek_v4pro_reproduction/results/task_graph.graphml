      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Clear Floor 1 (Dungeon) by defeating 8 Orc Soldiers/Mages under original Craftax balance to unlock the ladder to the Gnomish Mines, robustifying the critical early‑game descent.

Description: The agent spawns on Floor 1 at the ladder‑up location with the same initial equipment as the previous training stage: a stone sword, a bow, 16 arrows, 20 torches, and a small buffer of 5 wood and 5 stone for emergency arrow crafting. The goal remains to eliminate at least 8 hostile mobs (Orc Soldiers and Orc Mages) to clear the level and then descend to Floor 2 (Gnomish Mines). However, the game mechanics are now set to their original Craftax values: `needs_depletion_multiplier = 1.0` and `mob_damage_multiplier = 1.0`. This forces the agent to hunt snails for food, drink from fountains, and manage torch usage while taking full damage from enemy melee and ranged attacks, exactly as it would in the full game. The kill requirement stays at 8 (`monsters_killed_to_clear_level = 8`). Floor 1 generation is the default Dungeon layout (rooms, corridors, chests, fountains, torches in corners). The task succeeds when ENTER_GNOMISH_MINES is achieved.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: MAKE_STONE_SWORD, MAKE_ARROW, FIND_BOW, FIRE_BOW, ENTER_DUNGEON, MAKE_STONE_PICKAXE, MAKE_TORCH
World:
- Player: Starts on floor 1. Inventory: bow=1, arrows=16, stone_sword=1, torches=20, wood=5, stone=5. All attributes at default (strength=1, dexterity=1, intelligence=1). All status bars at maximum (9/9). Enchantments all 0. Learned spells both false.
- Map: No manual block modifications. All levels use default procedural generation. Starting floor is set to 1 via set_starting_floor(1).
- Mechanics:
  - monsters_killed_to_clear_level = 8
  - needs_depletion_multiplier = 1.0
  - mob_damage_multiplier = 1.0
  - All other TaskParams at default (health_recover, health_loss, mana_recover, spawn multipliers, growing_plants_age, etc., all 1.0 or original defaults).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_ARROW,
            Achievement.FIND_BOW,
            Achievement.FIRE_BOW,
            Achievement.ENTER_DUNGEON,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_TORCH,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        return TaskParams(
            monsters_killed_to_clear_level=8,
            needs_depletion_multiplier=1.0,
            mob_damage_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)
        builder.set_starting_floor(1)
        builder.set_player_inventory({
            "bow": 1,
            "arrows": 16,
            "sword": 2,      # stone sword (tier 2)
            "torches": 20,
            "wood": 5,
            "stone": 5,
        })
        state = builder.build(rng)

        # Mark completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
