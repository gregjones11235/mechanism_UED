449438202246, "make_stone_pickaxe": 29.213483146067414, "wake_up": 12.07865168539326, "place_furnace": 21.629213483146067, "collect_coal": 61.51685393258427, "collect_iron": 57.30337078651685, "collect_diamond": 32.30337078651685, "make_iron_pickaxe": 14.325842696629213, "make_iron_sword": 15.730337078651685, "place_torch": 100.0, "collect_sapphire": 24.43820224719101, "collect_ruby": 27.808988764044944, "make_diamond_pickaxe": 4.775280898876405, "make_diamond_sword": 4.49438202247191, "make_iron_armour": 0.2808988764044944, "enter_gnomish_mines": 78.65168539325843, "enter_dungeon": 100.0, "defeat_orc_solider": 98.59550561797752, "defeat_orc_mage": 90.4494382022472, "eat_snail": 97.47191011235955, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 99.43820224719101, "drink_potion": 87.07865168539325}, "average_episode_length": 794.2471910112359, "mean_return_percentage": 19.145173050720267, "mean_return": 43.268091094627806, "lp": NaN, "priority_score": 0.16790809241257415}]</data>
