2241887905605, "collect_coal": 71.68141592920354, "collect_iron": 61.35693215339233, "collect_diamond": 34.51327433628319, "make_iron_pickaxe": 17.699115044247787, "make_iron_sword": 23.893805309734514, "place_torch": 100.0, "collect_sapphire": 28.908554572271388, "collect_ruby": 30.088495575221238, "make_diamond_pickaxe": 3.2448377581120944, "make_diamond_sword": 5.6047197640118, "enter_gnomish_mines": 77.87610619469027, "enter_dungeon": 100.0, "defeat_orc_solider": 98.52507374631269, "defeat_orc_mage": 97.93510324483776, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 100.0, "drink_potion": 84.070796460177}, "average_episode_length": 838.7728613569321, "mean_return_percentage": 19.20974559765513, "mean_return": 43.41402505070059, "lp": NaN, "priority_score": 0.1722922703422351}]</data>
