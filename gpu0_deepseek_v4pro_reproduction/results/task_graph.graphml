      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Overworld preparation for the Gnomish Mines – gather stone and coal, craft a stone sword and torches, descend, and clear floor 1 using only melee combat.

Description: The agent begins on the Overworld (floor 0) at the default center spawn. It is expected to mine stone (from mountain blocks using the provided wood pickaxe) and coal, place a crafting table, craft a stone sword, and optionally craft torches to light the Dungeon. The ladder to the Dungeon is already open, so the agent may descend as soon as it is ready. Once on floor 1 (Dungeon), it must kill 4 Orc Soldiers or Orc Mages (standard melee/ranged behavior, full damage) and then use the ladder down to enter the Gnomish Mines. No bow or arrows are available, enforcing melee‑only tactics and torch‑dependent visibility. The task succeeds only when both MAKE_STONE_SWORD and ENTER_GNOMISH_MINES have been achieved, ensuring that the crucial preparation step is not skipped.

Relevant Achievements: MAKE_STONE_SWORD, ENTER_GNOMISH_MINES

Completed Achievements: MAKE_WOOD_PICKAXE

World:
- Player: Starting floor: 0 (Overworld). Inventory: wood_pickaxe=1, wood=5. All other inventory slots empty. Attributes: strength=1, dexterity=1, intelligence=1. Health/Food/Drink/Energy/Mana all 9/9. Enchantments and spells at default (none).
- Map: No manual block modifications; the default Overworld and Dungeon generation are used.
- Mechanics:
  - monsters_killed_to_clear_level = 4 (applies globally; floor 0 remains pre‑cleared with kills=10)
  - needs_depletion_multiplier = 1.0
  - mob_damage_multiplier = 1.0
  - health_recover_multiplier = 1.0
  - health_loss_multiplier = 1.0
  - mana_recover_multiplier = 1.0
  - All spawn multipliers (passive, melee, ranged) = 1.0
  - All other TaskParams at default.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.MAKE_STONE_SWORD,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
        ]
        self.label = "MAKE_STONE_SWORD, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=4,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld); default spawn (center) is used
        builder.set_starting_floor(0)

        # Equip starting inventory: wood pickaxe and 5 wood
        builder.set_player_inventory({
            "pickaxe": 1,  # wood pickaxe
            "wood": 5,
        })

        # Floor 0 already has 10 kills by default, so the ladder to floor 1 is open.
        # No other map modifications are needed.

        state = builder.build(rng)

        # Mark the pre‑completed achievement as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
