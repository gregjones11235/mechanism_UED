"wake_up": 77.4896265560166, "place_furnace": 100.0, "collect_coal": 100.0, "collect_iron": 97.40663900414938, "collect_diamond": 5.29045643153527, "make_iron_pickaxe": 95.33195020746888, "make_iron_sword": 39.004149377593365, "make_arrow": 99.27385892116183, "make_torch": 97.5103734439834, "place_torch": 94.39834024896265, "collect_sapphire": 6.431535269709544, "collect_ruby": 5.7053941908713695, "make_diamond_pickaxe": 0.4149377593360996, "make_diamond_sword": 0.6224066390041494, "make_iron_armour": 15.04149377593361, "enter_gnomish_mines": 0.1037344398340249, "enter_dungeon": 62.24066390041494, "defeat_orc_solider": 8.298755186721992, "defeat_orc_mage": 3.5269709543568464, "eat_snail": 21.473029045643152, "find_bow": 60.37344398340249, "fire_bow": 58.81742738589212, "open_chest": 60.37344398340249, "drink_potion": 23.236514522821576}, "average_episode_length": 294.99170124481327, "mean_return_percentage": 19.487402763306466, "mean_return": 44.041530245072614, "lp": NaN, "priority_score": 0.04450142903875617}]</data>
