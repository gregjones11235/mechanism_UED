      <data key="d3">import jax
import jax.numpy as jnp
from craftax.craftax.constants import Achievement, BlockType, ItemType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Teach the agent to chain together Overworld survival, basic crafting, and dungeon combat by progressing from floor 0 to floor 2 for the first time, mimicking the real early‑game transition.

Description: The agent begins on the Overworld (floor 0) with a modest starting inventory of 5 wood. The dungeon ladder is guaranteed to appear within a Manhattan distance of 2 to 10 from the spawn point, but the ladder to floor 2 is locked on floor 1 (requires 8 hostile kills). The agent must collect stone, craft a stone pickaxe and sword, enter the Dungeon (floor 1), defeat enough orc soldiers (`mob_name="melee", type_id=2`) and orc mages (`mob_name="ranged", type_id=2`) to unlock the Gnomish Mines entrance, and descend to floor 2. All spawn rates (melee, ranged, passive) are set to default (1.0), and survival needs deplete at the standard speed (`needs_depletion_multiplier=1.0`, health recovery/loss at 1.0). This tasks forces the agent to practise the full floor 0→floor 2 pipeline without the over‑scaffolding of pre‑supplied stone tools, thereby reducing the overfitting to the earlier unnaturally easy start.

Relevant Achievements: ENTER_DUNGEON, DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, ENTER_GNOMISH_MINES

Completed Achievements: COLLECT_WOOD

World:
- Player: Starting floor = 0. Inventory: `{"wood": 5}`. All stats = 1. `set_monsters_killed(level=0, count=0)` is called (already default, but ensures ladder is open).
- Map: On floor 0, place one `LADDER_DOWN` block using `place_randomly_near(rng, 0, BlockType.LADDER_DOWN, target_pos=player_start_pos, min_dist=2, max_dist=10, n=1, on_blocks=[BlockType.GRASS, BlockType.PATH])`. No other block modifications; floor 1 remains unchanged.
- Mechanics:
  - `passive_spawn_multiplier = 1.0`
  - `melee_spawn_multiplier = 1.0`
  - `ranged_spawn_multiplier = 1.0`
  - `mob_health_multiplier = 1.0`
  - `mob_damage_multiplier = 1.0`
  - `monsters_killed_to_clear_level = 8` (for all floors, so floor 1 requires 8 kills)
  - `needs_depletion_multiplier = 1.0`
  - `health_recover_multiplier = 1.0`
  - `health_loss_multiplier = 1.0`
  - `mana_recover_multiplier = 1.0`
  - `growing_plants_age = 600`
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.DEFEAT_ORC_SOLIDER,
            Achievement.DEFEAT_ORC_MAGE,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [Achievement.COLLECT_WOOD]
        self.label = "ENTER_DUNGEON, DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            melee_trigger_distance=10,
            monsters_killed_to_clear_level=8,
            needs_depletion_multiplier=1.0,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            growing_plants_age=600,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, ladder_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld)
        builder.set_starting_floor(0)

        # Give 5 wood as described
        builder.set_player_inventory({"wood": 5})

        # Unlock the overworld ladder by setting kills to the threshold (8).
        # The task description says count=0 for "open", but in game mechanics
        # a ladder is only open when monsters_killed &gt;= threshold, so we set it to 8.
        builder.set_monsters_killed(level=0, count=self.get_task_params().monsters_killed_to_clear_level)

        # Generate the default world (including a default ladder down)
        state = builder.build(rng)

        # --- Place the ladder down item at a random location near the player start ---
        # The player start position on floor 0 (center of the map)
        player_start = state.player_position

        # Compute Manhattan distance map
        rows_grid, cols_grid = jnp.indices(self.static_params.map_size)
        dist_map = jnp.abs(rows_grid - player_start[0]) + jnp.abs(cols_grid - player_start[1])
        distance_mask = (dist_map &gt;= 2) &amp; (dist_map &lt;= 10)

        # Only place on grass or path (surface blocks)
        surface_mask = jnp.isin(
            state.map[0],
            jnp.array([BlockType.GRASS.value, BlockType.PATH.value]),
        )
        valid_mask = distance_mask &amp; surface_mask

        # Choose a random valid cell by assigning random scores
        random_scores = jax.random.uniform(ladder_rng, shape=self.static_params.map_size)
        masked_scores = jnp.where(valid_mask, random_scores, -jnp.inf)
        flat_idx = jnp.argmax(masked_scores.flatten())
        new_row = flat_idx // self.static_params.map_size[1]
        new_col = flat_idx % self.static_params.map_size[1]

        # Remove the old ladder down from the item map
        old_ladder_pos = state.down_ladders[0]
        old_item = state.item_map[0, old_ladder_pos[0], old_ladder_pos[1]]
        # Only clear it if it was indeed a ladder_down item
        new_item_map = state.item_map.at[0, old_ladder_pos[0], old_ladder_pos[1]].set(
            jax.lax.cond(
                old_item == ItemType.LADDER_DOWN.value,
                lambda: 0,
                lambda: old_item,
            )
        )

        # Place the new ladder down item at the chosen cell
        new_item_map = new_item_map.at[0, new_row, new_col].set(ItemType.LADDER_DOWN.value)

        # Update the down_ladders position for floor 0
        new_down_ladders = state.down_ladders.at[0].set(jnp.array([new_row, new_col]))

        state = state.replace(
            item_map=new_item_map,
            down_ladders=new_down_ladders,
        )

        # Mark pre‑completed achievements
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
