      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Systematically clear a dungeon floor of multiple orc enemies and descend to the Gnomish Mines.

Description: The agent starts on Floor 1 (Dungeon) with a wooden sword, a bow, and a generous supply of 30 arrows. Survival needs (hunger, thirst, fatigue) deplete at 50% of normal speed, introducing moderate pressure to find and drink potions or use scattered fountains without overwhelming combat training. Orc Soldiers (melee) and Orc Mages (ranged) spawn naturally on the floor using boosted spawn multipliers, ensuring a steady stream of enemies. The floor‑clear requirement is set to 6 kills; the agent must defeat at least 6 orcs (any combination) to unlock the ladder down. Once the ladder is active, the agent must locate it (it is part of the default dungeon generation) and use the DESCEND action to reach Floor 2, achieving ENTER_GNOMISH_MINES. This task trains endurance, health management, and thorough floor exploration in preparation for the full 8‑kill requirement of the original Craftax dungeon.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: FIND_BOW, MAKE_WOOD_SWORD, MAKE_ARROW

World:
- Player: Floor 1 (spawn at ladder‑up position). Inventory: {"bow": 1, "arrows": 30, "sword": 1}. Stats: Strength 1, Dexterity 1, Intelligence 1. Health/Food/Drink/Energy/Mana all full (9/9). Learned spells: none. Weapon/Armour enchantments: none.
- Map:
    - Use default Dungeon generation for Floor 1. No manually placed mobs; rely on the environmental spawning mechanics described below.
- Mechanics:
    "needs_depletion_multiplier": 0.5,
    "melee_spawn_multiplier": 1.5,
    "ranged_spawn_multiplier": 1.5,
    "passive_spawn_multiplier": 0.0,
    "monsters_killed_to_clear_level": 6,
    "health_recover_multiplier": 1.0,
    "health_loss_multiplier": 1.0,
    "mob_health_multiplier": 1.0,
    "mob_damage_multiplier": 1.0
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.FIND_BOW,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_ARROW,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=0.0,
            melee_spawn_multiplier=1.5,
            ranged_spawn_multiplier=1.5,
            needs_depletion_multiplier=0.5,
            monsters_killed_to_clear_level=6,
            # health_recover_multiplier, health_loss_multiplier, mob_health, mob_damage default to 1.0
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        builder = WorldBuilder(rng, self.static_params, self.params)
        
        # Start on Floor 1 (Dungeon)
        builder.set_starting_floor(1)
        
        # Equip required starting gear: wooden sword (1), bow (1), 30 arrows
        builder.set_player_inventory({
            "sword": 1,    # wooden sword
            "bow": 1,
            "arrows": 30,
        })
        
        # No manual mob placements; rely on default dungeon generation and spawn rates
        return builder.build(rng)</data>
