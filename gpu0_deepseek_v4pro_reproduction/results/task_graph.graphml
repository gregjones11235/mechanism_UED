      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to explore the dungeon, defeat orc soldiers and mages, and descend to the Gnomish Mines (floor 2).
Description: The agent starts on floor 1 (the Dungeon) with an iron sword, iron pickaxe, bow, a quiver of arrows, torches, and a stock of basic resources (wood, stone, coal, iron) to eliminate any need for mining or gathering. The task is to kill 8 hostile mobs (orc soldiers and orc mages) to unlock the ladder down, then descend to floor 2. Combat is slightly eased via lower mob damage and health, and survival needs are halved so the agent can focus on navigation and fighting. The episode ends successfully when the agent reaches floor 2 (ENTERS_GNOMISH_MINES). All floor‑0 achievements up to iron crafting are marked completed to prevent backtracking and reward distraction.
Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: COLLECT_WOOD, PLACE_TABLE, COLLECT_STONE, MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD, COLLECT_SAPLING, COLLECT_COAL, COLLECT_IRON, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, MAKE_IRON_PICKAXE, MAKE_IRON_SWORD, PLACE_FURNACE
World:
- Player: Starts on floor 1 (dungeon) with inventory {"iron_sword": 1, "iron_pickaxe": 1, "bow": 1, "arrows": 10, "torches": 5, "wood": 10, "stone": 10, "coal": 5, "iron": 5, "sapling": 2}. Full health, food, drink, energy, mana (9/9 each). Monsters killed on floor 0 set to 8 (so floor 0 is cleared).
- Map: No manual block modifications. The default dungeon generation (rooms, corridors, chests, fountains, up‑ladder, down‑ladder) applies.
- Mechanics:
  - monsters_killed_to_clear_level = 8 (default for floor 1)
  - mob_health_multiplier = 0.7
  - mob_damage_multiplier = 0.8
  - needs_depletion_multiplier = 0.5
  - melee_spawn_multiplier = 1.0
  - ranged_spawn_multiplier = 1.0
  - passive_spawn_multiplier = 1.0
  - All other TaskParams at default.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_GNOMISH_MINES]
        self.completed_achievements = [
            Achievement.COLLECT_WOOD,
            Achievement.PLACE_TABLE,
            Achievement.COLLECT_STONE,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.COLLECT_SAPLING,
            Achievement.COLLECT_COAL,
            Achievement.COLLECT_IRON,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_IRON_PICKAXE,
            Achievement.MAKE_IRON_SWORD,
            Achievement.PLACE_FURNACE,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            monsters_killed_to_clear_level=8,
            mob_health_multiplier=0.7,
            mob_damage_multiplier=0.8,
            needs_depletion_multiplier=0.5,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(1)

        builder.set_player_inventory({
            "sword": 3,        # 3 = iron sword
            "pickaxe": 3,      # 3 = iron pickaxe
            "bow": 1,          # non-zero for bow
            "arrows": 10,
            "torches": 5,
            "wood": 10,
            "stone": 10,
            "coal": 5,
            "iron": 5,
            "sapling": 2,
        })

        # Clear floor 0 so ladder up is not an issue and to avoid distraction
        builder.set_monsters_killed(0, 8)

        return builder.build(rng)</data>
