"place_furnace": 94.03508771929825, "collect_coal": 84.56140350877193, "collect_iron": 80.0, "collect_diamond": 49.473684210526315, "make_iron_pickaxe": 36.49122807017544, "make_iron_sword": 45.96491228070175, "make_arrow": 97.89473684210526, "make_torch": 96.84210526315789, "place_torch": 95.43859649122807, "collect_sapphire": 37.54385964912281, "collect_ruby": 41.05263157894737, "make_diamond_pickaxe": 4.912280701754386, "make_diamond_sword": 5.2631578947368425, "make_iron_armour": 9.824561403508772, "enter_gnomish_mines": 36.49122807017544, "enter_dungeon": 100.0, "defeat_orc_solider": 97.89473684210526, "defeat_orc_mage": 87.36842105263158, "eat_snail": 94.73684210526316, "find_bow": 98.59649122807018, "fire_bow": 96.84210526315789, "open_chest": 98.59649122807018, "drink_potion": 92.63157894736842}, "average_episode_length": 944.8561403508772, "mean_return_percentage": 20.387847383946593, "mean_return": 46.0765350877193, "lp": NaN, "priority_score": 0.2317513080947984}]</data>
