": 6.998158379373849, "make_arrow": 91.25230202578268, "make_torch": 91.62062615101289, "place_torch": 82.13627992633518, "collect_sapphire": 4.419889502762431, "collect_ruby": 3.7753222836095763, "make_diamond_pickaxe": 0.3683241252302026, "make_diamond_sword": 0.27624309392265195, "make_iron_armour": 0.5524861878453039, "enter_dungeon": 46.13259668508287, "defeat_orc_solider": 4.696132596685083, "defeat_orc_mage": 1.0128913443830572, "find_bow": 42.9097605893186, "fire_bow": 35.0828729281768, "open_chest": 42.9097605893186, "drink_potion": 13.075506445672191}, "average_episode_length": 259.48987108655615, "mean_return_percentage": 17.03542846964178, "mean_return": 38.500068341390424, "lp": NaN, "priority_score": 0.11092457495192455}]</data>
