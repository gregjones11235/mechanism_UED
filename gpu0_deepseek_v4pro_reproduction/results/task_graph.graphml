": 100.0, "eat_plant": 0.32941176470588235, "make_stone_pickaxe": 99.5764705882353, "make_stone_sword": 97.55294117647058, "wake_up": 1.223529411764706, "place_furnace": 99.95294117647059, "collect_coal": 100.0, "collect_iron": 0.611764705882353, "make_iron_pickaxe": 0.047058823529411764, "make_arrow": 96.84705882352941, "make_torch": 97.78823529411764, "place_torch": 96.47058823529412, "collect_sapphire": 0.047058823529411764, "enter_dungeon": 0.18823529411764706, "find_bow": 0.18823529411764706, "fire_bow": 0.1411764705882353, "open_chest": 0.18823529411764706, "drink_potion": 0.1411764705882353}, "average_episode_length": 134.13505882352942, "mean_return_percentage": 14.903676470588234, "mean_return": 33.68230882352941, "lp": NaN, "priority_score": 0.004217356401384029}, {"session": 23, "sr": 0.9878706199460916, "achievement_srs": {"collect_wood": 100.0, "place_table": 100.0, "collect_sapling": 99.86522911051213, "collect_drink": 93.1266846361186, "make_wood_pickaxe": 100.0, "make_wood_sword": 99.59568733153638, "place_plant": 99.86522911051213, "collect_stone": 100.0, "place_stone": 99.86522911051213, "eat_plant": 1.8867924528301887, "make_stone_pickaxe": 98.78706199460916, "make_stone_sword": 82.47978436657682, "wake_up": 4.0431266846361185, "place_furnace": 99.73045822102426, "collect_coal": 100.0, "collect_iron": 13.611859838274933, "collect_diamond": 8.76010781671159, "make_iron_pickaxe": 3.234501347708895, "make_iron_sword": 2.560646900269542, "make_arrow": 91.91374663072776, "make_torch": 97.57412398921834, "place_torch": 95.01347708894879, "collect_sapphire": 6.46900269541779, "collect_ruby": 7.277628032345014, "make_diamond_pickaxe": 0.6738544474393531, "make_diamond_sword": 0.5390835579514824, "enter_dungeon": 76.68463611859838, "find_bow": 75.87601078167116, "fire_bow": 64.82479784366576, "open_chest": 75.87601078167116, "drink_potion": 26.41509433962264}, "average_episode_length": 375.41509433962267, "mean_return_percentage": 19.336758620342653, "mean_return": 43.701074481974395, "lp": NaN, "priority_score": 0.01198225819341625}]</data>
