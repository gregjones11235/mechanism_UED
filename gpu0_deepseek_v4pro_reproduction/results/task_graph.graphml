331950207469, "eat_plant": 1.037344398340249, "make_stone_pickaxe": 52.178423236514526, "make_stone_sword": 23.029045643153527, "place_furnace": 98.70331950207469, "collect_coal": 44.91701244813278, "collect_iron": 17.58298755186722, "make_iron_pickaxe": 4.097510373443983, "make_iron_sword": 7.987551867219917, "make_arrow": 39.26348547717842, "make_torch": 31.068464730290458, "place_torch": 30.809128630705395, "make_iron_armour": 0.46680497925311204, "enter_dungeon": 99.5850622406639}, "average_episode_length": 144.8143153526971, "mean_return_percentage": 14.486789923989276, "mean_return": 32.740145228215766, "lp": NaN, "priority_score": 0.004132160258948695}]</data>
