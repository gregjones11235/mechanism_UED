eton": 33.72781065088758, "make_stone_pickaxe": 52.662721893491124, "make_stone_sword": 100.0, "wake_up": 97.0414201183432, "place_furnace": 50.59171597633136, "collect_coal": 71.30177514792899, "collect_iron": 63.01775147928994, "collect_diamond": 30.76923076923077, "make_iron_pickaxe": 22.189349112426036, "make_iron_sword": 32.248520710059175, "make_arrow": 78.99408284023669, "make_torch": 93.49112426035504, "place_torch": 92.01183431952663, "collect_sapphire": 27.810650887573964, "collect_ruby": 26.62721893491124, "make_diamond_pickaxe": 3.2544378698224854, "make_diamond_sword": 3.2544378698224854, "enter_gnomish_mines": 52.662721893491124, "enter_dungeon": 100.0, "defeat_orc_solider": 95.85798816568047, "defeat_orc_mage": 87.27810650887574, "eat_snail": 95.85798816568047, "find_bow": 99.40828402366864, "fire_bow": 76.62721893491124, "open_chest": 99.40828402366864, "drink_potion": 84.31952662721893}, "average_episode_length": 801.3461538461538, "mean_return_percentage": 20.17377182320849, "mean_return": 45.59272432045118, "lp": NaN, "priority_score": 0.2492909912117923}]</data>
