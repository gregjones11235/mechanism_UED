      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Improve combat endurance in the Dungeon by facing higher hostile mob density and achieving the standard 8‑kill clearance, without relying on Overworld retreat.

Description: The agent starts on Floor 1 (Dungeon) with the same combat loadout as before—a bow, 10 arrows, and a wood sword—but now must clear the floor under more punishing spawn rates. `melee_spawn_multiplier` is raised from 0.6 to **0.8**, `ranged_spawn_multiplier` from 0.5 to **0.7**, and `monsters_killed_to_clear_level` from 7 to **8**. Survival needs remain at `needs_depletion_multiplier = 0.5`, so the agent must still hunt snails and drink from fountains to avoid starvation. Two initial mobs are placed 5‑8 tiles from the spawn point: one Orc Soldier (melee, type_id=2) and one Orc Mage (ranged, type_id=2). No other mobs are pre‑spawned; the remaining enemies will appear via the increased spawn multipliers. Ascending to Floor 0 is possible but costly, because the global `monsters_killed_to_clear_level` of 8 now applies to the Overworld as well, requiring a lengthy detour to return. The task therefore encourages the agent to stay within the Dungeon, manage its arrows carefully, and rely on melee when necessary, building the sustained combat proficiency needed to reach the Gnomish Mines in the full game.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: FIND_BOW, MAKE_WOOD_SWORD, MAKE_ARROW

World:
- Player: Floor 1 (spawn at ladder‑up position). Inventory: {"bow": 1, "arrows": 10, "sword": 1}. Stats: Strength 1, Dexterity 1, Intelligence 1. Health/Food/Drink/Energy/Mana all full (9/9). Learned spells: none. Weapon/Armour enchantments: none.
- Map:
    - Use default Dungeon generation for Floor 1.
    - Place exactly one melee mob (Orc Soldier, "melee", type_id=2) using `add_mobs_randomly_near`, with target_pos = player spawn coordinates, n=1, min_dist=5, max_dist=8, on_blocks = [BlockType.PATH].
    - Place exactly one ranged mob (Orc Mage, "ranged", type_id=2) using `add_mobs_randomly_near`, with target_pos = player spawn coordinates, n=1, min_dist=5, max_dist=8, on_blocks = [BlockType.PATH].
    - No other mobs are placed initially; spawning will generate the remainder.
- Mechanics:
    "needs_depletion_multiplier": 0.5,
    "melee_spawn_multiplier": 0.8,
    "ranged_spawn_multiplier": 0.7,
    "passive_spawn_multiplier": 0.3,
    "monsters_killed_to_clear_level": 8,
    "health_recover_multiplier": 1.0,
    "health_loss_multiplier": 1.0,
    "mob_health_multiplier": 1.0,
    "mob_damage_multiplier": 1.0
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.FIND_BOW,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_ARROW,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.5,
            melee_spawn_multiplier=0.8,
            ranged_spawn_multiplier=0.7,
            passive_spawn_multiplier=0.3,
            monsters_killed_to_clear_level=8,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, melee_rng, ranged_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Set starting inventory: wood sword (tier 1), bow, 10 arrows
        builder.set_player_inventory({
            "sword": 1,
            "bow": 1,
            "arrows": 10,
        })

        # Spawn point on floor 1 is the up-ladder entry
        spawn_pos = builder.ladders_up[1]

        # Pre-place one Orc Soldier (melee, type_id=2) within Manhattan distance 5-8
        builder.add_mobs_randomly_near(
            melee_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=1,
            target_pos=spawn_pos,
            min_dist=5,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        # Pre-place one Orc Mage (ranged, type_id=2) within Manhattan distance 5-8
        builder.add_mobs_randomly_near(
            ranged_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=1,
            target_pos=spawn_pos,
            min_dist=5,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        # Build the initial state
        state = builder.build(rng)

        # Mark pre-completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
