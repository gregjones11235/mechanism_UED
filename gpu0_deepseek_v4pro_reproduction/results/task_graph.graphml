      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Descend from the Dungeon to the Gnomish Mines and defeat a single Gnome Warrior, using provided weapons and torches.

    Description: The agent spawns on Floor 1 (Dungeon) at the ladder‑up position. The ladder down to Floor 2 is already unlocked (no enemies need to be killed). The agent’s inventory is pre‑equipped with a stone sword, a bow, 10 arrows, and 5 torches. Survival needs are disabled, and no other mobs can spawn. A single Gnome Warrior (melee mob, type_id 1) is placed on Floor 2 exactly 10 tiles from the ladder‑up spawn point of that floor. The agent must descend to Floor 2 (which is pitch‑black), place torches to navigate, locate the melee enemy, and kill it using the bow and sword. The task ends successfully when both achievements are obtained.

    Relevant Achievements: ENTER_GNOMISH_MINES, DEFEAT_GNOME_WARRIOR
    Completed Achievements: ENTER_DUNGEON, FIND_BOW, MAKE_STONE_SWORD, MAKE_ARROW, MAKE_TORCH
    World:
    - Player: Floor 1 (spawn at ladder‑up position). Inventory: {"sword": 2, "bow": 1, "arrows": 10, "torches": 5}. Stats: Strength 1, Dexterity 1, Intelligence 1. Health/Food/Drink/Energy/Mana all full (9/9). Learned spells: none. Weapon/Armour enchantments: none.
    - Map:
        - Use default Dungeon generation for Floor 1.
        - Pre‑clear Floor 1 ladder by calling `builder.set_monsters_killed(level=1, count=8)`.
        - Use default SmoothGen for Floor 2 (Gnomish Mines).
        - Place exactly one melee mob (Gnome Warrior, "melee", type_id=1) on Floor 2 using `add_mobs_randomly_near`, with target_pos = the ladder‑up coordinates of Floor 2, n=1, min_dist=10, max_dist=10, on_blocks = [BlockType.PATH]. (This places the warrior at exactly 10 tiles manhattan distance.)
        - No other mobs are placed on any floor.
    - Mechanics:
        "needs_depletion_multiplier": 0.0,
        "melee_spawn_multiplier": 0.0,
        "ranged_spawn_multiplier": 0.0,
        "passive_spawn_multiplier": 0.0,
        "monsters_killed_to_clear_level": 0,
        "health_recover_multiplier": 1.0,
        "mob_health_multiplier": 1.0,
        "mob_damage_multiplier": 1.0
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
            Achievement.DEFEAT_GNOME_WARRIOR,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.FIND_BOW,
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_TORCH,
        ]
        self.label = "ENTER_GNOMISH_MINES, DEFEAT_GNOME_WARRIOR"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            passive_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=0,
            health_recover_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, mob_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on Floor 1 (Dungeon)
        builder.set_starting_floor(1)

        # Give the agent the required starting equipment
        builder.set_player_inventory(
            {
                "sword": 2,  # Stone sword (1=wood, 2=stone)
                "bow": 1,
                "arrows": 10,
                "torches": 5,
            }
        )

        # Pre-clear the ladder down on Floor 1 so no kills are required
        builder.set_monsters_killed(level=1, count=8)

        # Target for placing the Gnome Warrior: the ladder up position of Floor 2
        target_pos = builder.ladders_up[2]

        # Place exactly one Gnome Warrior on Floor 2, Manhattan distance exactly 10
        builder.add_mobs_randomly_near(
            mob_rng,
            level=2,
            mob_name="melee",
            type_id=1,  # Gnome Warrior
            n=1,
            target_pos=target_pos,
            min_dist=10,
            max_dist=10,
            on_blocks=[BlockType.PATH],
        )

        return builder.build(rng)</data>
