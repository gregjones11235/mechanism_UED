, "defeat_skeleton": 22.195704057279237, "make_stone_pickaxe": 45.10739856801909, "wake_up": 75.41766109785203, "place_furnace": 46.30071599045346, "collect_coal": 71.36038186157518, "collect_iron": 60.859188544152744, "collect_diamond": 25.536992840095465, "make_iron_pickaxe": 17.422434367541765, "make_iron_sword": 24.58233890214797, "make_arrow": 76.84964200477327, "place_torch": 100.0, "collect_sapphire": 24.58233890214797, "collect_ruby": 25.536992840095465, "make_diamond_pickaxe": 4.05727923627685, "make_diamond_sword": 5.011933174224343, "enter_gnomish_mines": 64.20047732696898, "enter_dungeon": 100.0, "defeat_orc_solider": 98.56801909307876, "defeat_orc_mage": 86.39618138424821, "eat_snail": 96.4200477326969, "find_bow": 99.52267303102626, "fire_bow": 74.94033412887828, "open_chest": 99.52267303102626, "drink_potion": 87.82816229116945}, "average_episode_length": 658.8114558472554, "mean_return_percentage": 20.37900121047796, "mean_return": 46.05654273568019, "lp": NaN, "priority_score": 0.229834644368624}]</data>
