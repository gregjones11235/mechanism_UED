      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Force the agent to integrate Overworld combat clearing into the full Overworld‑to‑Mines progression by requiring it to defeat 8 hostile mobs on Floor 0 before the ladder down opens, while keeping all other scaffolding identical to the trained task.

Description: The agent spawns on Floor 0 (Overworld) with no equipment. The Overworld environment and survival settings are identical to the trained task: `needs_depletion_multiplier = 0.5`, `melee_spawn_multiplier = 0.6`, `ranged_spawn_multiplier = 0.5`, `passive_spawn_multiplier = 1.5`. The critical change is that the Overworld ladder down is now initially locked: `monsters_killed_to_clear_level` is set to 8, and Floor 0’s initial kill count is reset to 0 using `set_monsters_killed(level=0, count=0)`. Thus, the agent must first chop wood, mine stone, craft a Wood Pickaxe, a Stone Sword, and arrows, then engage and defeat 8 hostile mobs (typically Zombies and Skeletons spawned by the above multipliers) on Floor 0. Once the kill count reaches 8, the ladder down opens. The agent can then descend to Floor 1 (the Dungeon). Floor 1 is set up exactly as in the trained task: a Bow can be found in a chest, and two mobs are pre‑placed to guarantee early combat encounters: one Orc Soldier (melee, type_id=2) and one Orc Mage (ranged, type_id=2), each placed 5–8 Manhattan tiles from the player’s spawn point (the ladder‑up location) using `add_mobs_randomly_near` on Path blocks. After descending, the agent must use sword and bow to defeat the Floor 1 kill requirement of 8 hostile mobs (including the pre‑placed ones and any additional spawns), then step onto the ladder down to Floor 2 (Gnomish Mines). Successfully entering Floor 2 triggers the `ENTER_GNOMISH_MINES` achievement and terminates the episode successfully.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: None

World:
- Player: Floor 0 (spawn at center). Inventory: empty. Stats: Strength 1, Dexterity 1, Intelligence 1. Health/Food/Drink/Energy/Mana all full (9 / 9). Learned spells: none. Weapon/Armour enchantments: none.
- Map:
    - Floor 0: default Overworld generation (Grass, Trees, Stone, Water, etc.). The initial kill count for Floor 0 is set to 0 via `builder.set_monsters_killed(0, 0)` so the ladder down is blocked until 8 melee mobs are killed.
    - Floor 1: default Dungeon generation. Use `add_mobs_randomly_near` to place one Orc Soldier (melee, type_id=2) with target_pos = player spawn on Floor 1 (i.e., the ladder‑up location), n=1, min_dist=5, max_dist=8, on_blocks = [BlockType.PATH].
    - Use `add_mobs_randomly_near` to place one Orc Mage (ranged, type_id=2) with the same parameters.
    - No other pre‑placed mobs.
- Mechanics:
    - "needs_depletion_multiplier": 0.5
    - "melee_spawn_multiplier": 0.6
    - "ranged_spawn_multiplier": 0.5
    - "passive_spawn_multiplier": 1.5
    - "monsters_killed_to_clear_level": 8   (applies to all floors, making Floor 0 require 8 kills after the reset above)
    - "health_recover_multiplier": 1.0
    - "health_loss_multiplier": 1.0
    - "mob_health_multiplier": 1.0
    - "mob_damage_multiplier": 1.0
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = []  # No pre-completed achievements
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.5,
            melee_spawn_multiplier=0.6,
            ranged_spawn_multiplier=0.5,
            passive_spawn_multiplier=1.5,
            monsters_killed_to_clear_level=8,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, mob_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld) at default centre
        builder.set_starting_floor(0)

        # Reset kill counter for floor 0 so the ladder is initially locked
        builder.set_monsters_killed(0, 0)

        # Pre-place two mobs on Floor 1 near the ladder-up location
        floor1_spawn = builder.ladders_up[1]
        mob_rng1, mob_rng2 = jax.random.split(mob_rng)

        builder.add_mobs_randomly_near(
            mob_rng1,
            level=1,
            mob_name="melee",
            type_id=2,  # Orc Soldier
            n=1,
            target_pos=floor1_spawn,
            min_dist=5,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        builder.add_mobs_randomly_near(
            mob_rng2,
            level=1,
            mob_name="ranged",
            type_id=2,  # Orc Mage
            n=1,
            target_pos=floor1_spawn,
            min_dist=5,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        state = builder.build(rng)

        # No achievements are pre-completed, so return the state as-is
        return state</data>
