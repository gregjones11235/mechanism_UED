 "collect_drink": 25.797691785471827, "make_wood_pickaxe": 16.836388323150032, "place_plant": 3.9714867617107945, "collect_stone": 4.989816700610998, "place_stone": 4.5485403937542435, "make_stone_pickaxe": 9.708078750848609, "make_stone_sword": 10.658520027155465, "wake_up": 10.183299389002036, "place_furnace": 4.175152749490835, "collect_coal": 26.748133061778685, "collect_iron": 26.272912423625254, "collect_diamond": 13.204344874405974, "make_iron_pickaxe": 4.5485403937542435, "make_iron_sword": 5.532926001357773, "make_torch": 69.41615750169721, "place_torch": 65.17311608961303, "collect_sapphire": 10.726408689748812, "collect_ruby": 11.09979633401222, "make_diamond_pickaxe": 1.3577732518669383, "make_diamond_sword": 1.6632722335369994, "enter_dungeon": 100.0, "defeat_orc_solider": 84.35166327223354, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 95.21384928716904, "drink_potion": 34.75899524779362}, "average_episode_length": 94.08995247793618, "mean_return_percentage": 13.153370880494927, "mean_return": 29.726618189918533, "lp": NaN, "priority_score": 0.13199632304310815}, {"session": 42, "sr": 0.8329646017699115, "achievement_srs": {"collect_wood": 5.6047197640118, "place_table": 4.941002949852507, "collect_sapling": 5.125368731563422, "collect_drink": 29.941002949852507, "make_wood_pickaxe": 18.805309734513273, "place_plant": 4.904129793510324, "collect_stone": 5.346607669616519, "place_stone": 5.014749262536873, "make_stone_pickaxe": 12.205014749262537, "make_stone_sword": 10.103244837758112, "wake_up": 13.753687315634219, "place_furnace": 5.014749262536873, "collect_coal": 29.941002949852507, "collect_iron": 28.502949852507374, "collect_diamond": 14.970501474926253, "make_iron_pickaxe": 5.567846607669616, "make_iron_sword": 5.051622418879056, "make_torch": 73.00884955752213, "place_torch": 67.33038348082596, "collect_sapphire": 11.910029498525073, "collect_ruby": 12.094395280235988, "make_diamond_pickaxe": 1.4749262536873156, "make_diamond_sword": 1.58