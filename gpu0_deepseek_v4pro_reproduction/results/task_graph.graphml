hievement_srs": {"place_table": 100.0, "collect_sapling": 68.89632107023411, "make_wood_sword": 100.0, "place_plant": 68.89632107023411, "defeat_zombie": 49.163879598662206, "place_stone": 97.9933110367893, "eat_plant": 19.39799331103679, "defeat_skeleton": 43.812709030100336, "make_stone_pickaxe": 79.59866220735786, "wake_up": 96.65551839464882, "place_furnace": 96.98996655518394, "collect_coal": 81.93979933110369, "collect_iron": 72.24080267558529, "collect_diamond": 30.434782608695652, "make_iron_pickaxe": 28.42809364548495, "make_iron_sword": 47.82608695652174, "make_arrow": 100.0, "make_torch": 95.31772575250837, "place_torch": 94.31438127090301, "collect_sapphire": 26.421404682274247, "collect_ruby": 30.434782608695652, "make_diamond_pickaxe": 2.6755852842809364, "make_diamond_sword": 4.013377926421405, "enter_gnomish_mines": 55.852842809364546, "enter_dungeon": 100.0, "defeat_orc_solider": 97.9933110367893, "defeat_orc_mage": 92.97658862876254, "eat_snail": 98.99665551839465, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 98.99665551839465, "drink_potion": 85.61872909698997}, "average_episode_length": 931.0267558528428, "mean_return_percentage": 19.60444666449004, "mean_return": 44.30604946174749, "lp": NaN, "priority_score": 0.24657442310488698}]</data>
