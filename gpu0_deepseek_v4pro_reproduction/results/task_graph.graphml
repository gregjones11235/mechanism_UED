      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Enter the Gnomish Mines (floor 2) under full survival pressure by crafting an iron sword and clearing the Dungeon, using naturally occurring overworld ores.

Description: The agent starts on floor 0 with a stone pickaxe and a wood sword already in its inventory, and a crafting table pre‑placed directly south of spawn. Survival needs now deplete at the same rate as the original Craftax game (`needs_depletion_multiplier = 1.0`), forcing the agent to actively manage hunger and thirst while prospecting for resources. No coal or iron blocks are manually added; the agent must explore the procedurally generated overworld to mine coal (3% in stone) and iron (2% in stone). After gathering enough coal and iron, the agent must construct a furnace, craft an iron sword at the table‑furnace station, enter the dungeon, defeat exactly 8 hostile orcs (soldiers and/or mages) to unlock the ladder, stand on the ladder down, and use the `DESCEND` action to reach floor 2 (Gnomish Mines). All other mechanics, mob behaviour, and world generation remain at original Craftax defaults to preserve transferability.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_STONE_PICKAXE, MAKE_WOOD_SWORD, PLACE_TABLE

World:
- Player:
  - `set_starting_floor(0)`
  - `set_player_inventory({"stone_pickaxe": 1, "wood_sword": 1})`
  - Attributes at defaults (Strength/Dex/Int = 1, full health/mana/energy/food/drink).
- Map:
  - `place_block(0, BlockType.CRAFTING_TABLE, (player_start_row + 1, player_start_col))`  (the same pre‑placed table as before)
  - `set_monsters_killed(level=1, count=0)`
  - **No other block modifications** – coal and iron appear only through normal overworld generation (coal at 3%, iron at 2% inside stone blocks).
- Mechanics:
  - `monsters_killed_to_clear_level = 8`
  - `needs_depletion_multiplier = 1.0`   ← **only change from parent**
  - All other TaskParams at default (`mob_health_multiplier = 1.0`, `mob_damage_multiplier = 1.0`, `melee_spawn_multiplier = 1.0`, `ranged_spawn_multiplier = 1.0`, `passive_spawn_multiplier = 1.0`, `health_recover_multiplier = 1.0`, `health_loss_multiplier = 1.0`, `mana_recover_multiplier = 1.0`, `growing_plants_age = 600`).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.PLACE_TABLE,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
            needs_depletion_multiplier=1.0,
            # All other values are defaults, but we list them for clarity
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            growing_plants_age=600,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld)
        builder.set_starting_floor(0)

        # Equip starting inventory: stone pickaxe (tier 2), wood sword (tier 1)
        builder.set_player_inventory({
            "pickaxe": 2,   # stone pickaxe
            "sword": 1,     # wood sword
        })

        # Place a crafting table directly south (row+1) of the player's spawn position
        player_pos = builder.player_position  # (row, col)
        table_pos = (player_pos[0] + 1, player_pos[1])
        builder.place_block(0, BlockType.CRAFTING_TABLE, table_pos)

        # Ensure dungeon kill counter starts at 0
        builder.set_monsters_killed(level=1, count=0)

        # No other block modifications; ores appear naturally during generation

        state = builder.build(rng)

        # Mark pre-completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
