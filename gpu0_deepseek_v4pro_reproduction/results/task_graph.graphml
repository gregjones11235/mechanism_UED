t_drink": 96.22641509433963, "place_plant": 54.088050314465406, "defeat_zombie": 28.30188679245283, "collect_stone": 100.0, "place_stone": 97.79874213836477, "eat_plant": 13.836477987421384, "defeat_skeleton": 22.0125786163522, "wake_up": 93.39622641509433, "place_furnace": 99.05660377358491, "collect_coal": 73.8993710691824, "collect_iron": 72.95597484276729, "collect_diamond": 33.9622641509434, "make_iron_pickaxe": 22.0125786163522, "make_iron_sword": 38.36477987421384, "make_arrow": 100.0, "make_torch": 96.54088050314465, "place_torch": 96.22641509433963, "collect_sapphire": 28.61635220125786, "collect_ruby": 28.930817610062892, "make_diamond_pickaxe": 3.7735849056603774, "make_diamond_sword": 4.40251572327044, "enter_gnomish_mines": 55.34591194968554, "enter_dungeon": 100.0, "defeat_orc_solider": 94.65408805031447, "defeat_orc_mage": 83.9622641509434, "eat_snail": 98.74213836477988, "find_bow": 99.37106918238993, "fire_bow": 99.37106918238993, "open_chest": 99.37106918238993, "drink_potion": 85.84905660377359}, "average_episode_length": 869.2232704402516, "mean_return_percentage": 20.631181852058635, "mean_return": 46.62647098565252, "lp": NaN, "priority_score": 0.24714212254262094}, {"session": 128, "sr": 0.6947368421052632, "achievement_srs": {"collect_wood": 100.0, "place_table": 100.0, "eat_cow": 74.3859649122807, "collect_sapling": 75.78947368421052, "collect_drink": 97.54385964912281, "place_plant": 75.43859649122807, "defeat_zombie": 36.14035087719298, "collect_stone": 100.0, "place_stone": 97.54385964912281, "eat_plant": 14.385964912280702, "defeat_skeleton": 26.666666666666668, "wake_up": 98.94736842105263, "place_furnace": 99.29824561403508, "collect_coal": 79.29824561403508, "collect_iron": 74.73684210526316, "collect_diamond": 35.08771929824562, "make_iron_pickaxe": 27.017543859649123, "make_iron_sword": 40.70175438596491, "make_arrow": 100.0, "make_torch": 93.6842105263158, "place_torch": 91.57894736842105, "collect_sapphire": 27.36842105263158, "co