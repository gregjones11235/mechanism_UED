 6.821963394342762, "make_iron_sword": 43.09484193011647, "make_arrow": 99.16805324459234, "make_torch": 92.01331114808653, "place_torch": 88.6855241264559, "collect_sapphire": 6.156405990016639, "collect_ruby": 5.324459234608985, "make_diamond_pickaxe": 0.831946755407654, "make_diamond_sword": 0.49916805324459235, "make_iron_armour": 86.522462562396, "enter_dungeon": 54.24292845257904, "defeat_orc_solider": 10.149750415973378, "defeat_orc_mage": 5.657237936772047, "eat_snail": 25.124792013311147, "find_bow": 53.24459234608985, "fire_bow": 52.57903494176373, "open_chest": 53.24459234608985, "drink_potion": 22.628951747088188}, "average_episode_length": 436.6189683860233, "mean_return_percentage": 18.82171974621943, "mean_return": 42.53708662645591, "lp": NaN, "priority_score": 0.11661097283783821}]</data>
