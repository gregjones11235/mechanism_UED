      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Descend from floor 1 (Dungeon) to floor 2 (Gnomish Mines) by killing at least 7 hostile mobs, with spawn rates still halved, to strengthen sustained combat and navigation closer to the full game’s 8‑kill standard.

Description: The agent starts in the Dungeon (floor 1) with a stone sword (tier 2) already equipped. Mob spawn intensities remain reduced: melee mobs (Orc Soldiers) at half rate (`melee_spawn_multiplier = 0.5`), ranged mobs (Orc Mages) at half rate (`ranged_spawn_multiplier = 0.5`), passive mobs (Snails) at normal rate (`passive_spawn_multiplier = 1.0`). The floor clearing threshold `monsters_killed_to_clear_level` is increased from 6 to **7** — the only change from the previous task. The agent must defeat at least seven hostile mobs, locate the down ladder, and use the DESCEND action to trigger `ENTER_GNOMISH_MINES`. Only this achievement is relevant for success termination; all other achievements are incidental. Survival needs, regeneration, and all other mechanics remain at default values. This task applies one more unit of pressure on combat endurance and exploration, stepping the agent closer to the full game’s requirement of 8 kills while keeping spawn density learnable.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: ENTER_DUNGEON
World:
- Player: Starts on floor 1. Inventory: `{"sword": 2}` (stone sword). Basic attributes (STR 1, DEX 1, INT 1) and full status bars (health 9, food 9, drink 9, energy 9, mana 9).
- Map: No modifications; default Dungeon generation.
- Mechanics: `passive_spawn_multiplier = 1.0`, `melee_spawn_multiplier = 0.5`, `ranged_spawn_multiplier = 0.5`, `monsters_killed_to_clear_level = 7`. All other `TaskParams` at defaults (e.g., `melee_trigger_distance = 10`, `needs_depletion_multiplier = 1.0`).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=0.5,
            ranged_spawn_multiplier=0.5,
            monsters_killed_to_clear_level=7,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon)
        builder.set_starting_floor(1)

        # Equip stone sword (tier 2) only, no other items
        builder.set_player_inventory({
            "sword": 2,  # stone sword
        })

        # No map modifications; default Dungeon generation is used
        state = builder.build(rng)

        # Mark the pre‑completed achievement as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
