_stone": 99.63503649635037, "eat_plant": 17.883211678832115, "defeat_skeleton": 68.24817518248175, "make_stone_pickaxe": 88.68613138686132, "make_stone_sword": 94.16058394160584, "wake_up": 98.17518248175182, "place_furnace": 99.27007299270073, "collect_coal": 92.7007299270073, "collect_iron": 72.62773722627738, "collect_diamond": 23.357664233576642, "make_iron_pickaxe": 19.343065693430656, "make_iron_sword": 33.941605839416056, "make_arrow": 93.43065693430657, "make_torch": 92.33576642335767, "place_torch": 88.68613138686132, "collect_sapphire": 20.802919708029197, "collect_ruby": 17.883211678832115, "make_diamond_pickaxe": 1.8248175182481752, "make_diamond_sword": 2.5547445255474455, "make_iron_armour": 3.2846715328467155, "enter_gnomish_mines": 29.562043795620436, "enter_dungeon": 96.35036496350365, "defeat_orc_solider": 90.87591240875912, "defeat_orc_mage": 69.7080291970803, "eat_snail": 71.89781021897811, "find_bow": 83.94160583941606, "fire_bow": 79.1970802919708, "open_chest": 83.94160583941606, "drink_potion": 62.77372262773723}, "average_episode_length": 969.5985401459855, "mean_return_percentage": 20.842977947261968, "mean_return": 47.105130160812045, "lp": NaN, "priority_score": 0.2082289946187863}]</data>
