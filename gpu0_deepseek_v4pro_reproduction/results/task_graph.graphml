      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Descend to the Gnomish Mines (floor 2) by learning to handle early spawning mobs on floor 1 while still leaning on a guaranteed starting combat advantage.
Description: The agent starts on floor 1 (Dungeon) at the up‑ladder position, equipped with a stone sword, a bow, and 5 arrows. Two specific enemies are placed near the start zone: one Orc Soldier (melee mob, type_id=2) and one Orc Mage (ranged mob, type_id=2), each at a Manhattan distance of 4‑8 tiles from the player. In addition, **low‑rate random spawning is enabled for hostile mobs** (melee_spawn_multiplier = 0.2, ranged_spawn_multiplier = 0.2). All other spawning remains off (passive_spawn_multiplier = 0.0). The floor‑1 clearance requirement is raised to 5 kills; thus the agent must defeat the two placed orcs plus three additional spawned orcs to unlock the ladder down. The episode succeeds when the agent descends to floor 2 (i.e., achieves `ENTER_GNOMISH_MINES`). Survival mechanics stay at default rates. Fountains and any existing passive creatures on floor 1 (e.g., snails) are available but their spawning is disabled, so they will only appear if already present in the dungeon generation.
Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: MAKE_STONE_SWORD, FIND_BOW
World:
- Player: Starting floor = 1. Inventory: 5 arrows (`{"arrows": 5}`). The agent begins with a stone sword and a bow (ensured by Completed Achievements `MAKE_STONE_SWORD` and `FIND_BOW`).
- Map: On floor 1, using `add_mobs_randomly_near`, place one Orc Soldier (`mob_name="melee"`, `type_id=2`, `n=1`, `target_pos` = player start, `min_dist=4`, `max_dist=8`) and one Orc Mage (`mob_name="ranged"`, `type_id=2`, `n=1`, same distance parameters). No other block modifications.
- Mechanics:
  - `monsters_killed_to_clear_level = 5`
  - `passive_spawn_multiplier = 0.0`
  - `melee_spawn_multiplier = 0.2`
  - `ranged_spawn_multiplier = 0.2`
  - All other `TaskParams` at default values.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_STONE_SWORD,
            Achievement.FIND_BOW,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=5,
            passive_spawn_multiplier=0.0,
            melee_spawn_multiplier=0.2,
            ranged_spawn_multiplier=0.2,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, soldier_rng, mage_rng, final_rng = jax.random.split(rng, 5)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Equip stone sword, bow, and 5 arrows
        builder.set_player_inventory({"sword": 2, "bow": 1, "arrows": 5})

        # Place one Orc Soldier (melee, type_id=2) near spawn
        builder.add_mobs_randomly_near(
            soldier_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=1,
            target_pos=builder.player_position,
            min_dist=4,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        # Place one Orc Mage (ranged, type_id=2) near spawn
        builder.add_mobs_randomly_near(
            mage_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=1,
            target_pos=builder.player_position,
            min_dist=4,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        return builder.build(final_rng)</data>
