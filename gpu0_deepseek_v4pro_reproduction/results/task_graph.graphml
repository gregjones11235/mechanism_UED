1.0394265232975, "make_stone_sword": 96.05734767025089, "wake_up": 98.9247311827957, "place_furnace": 97.84946236559139, "collect_coal": 92.831541218638, "collect_iron": 72.40143369175627, "collect_diamond": 27.59856630824373, "make_iron_pickaxe": 27.956989247311828, "make_iron_sword": 44.44444444444444, "make_arrow": 98.9247311827957, "make_torch": 96.7741935483871, "place_torch": 96.7741935483871, "collect_sapphire": 23.655913978494624, "collect_ruby": 29.74910394265233, "make_diamond_pickaxe": 3.5842293906810037, "make_diamond_sword": 1.7921146953405018, "make_iron_armour": 5.017921146953405, "enter_gnomish_mines": 46.59498207885304, "enter_dungeon": 96.7741935483871, "defeat_orc_solider": 92.1146953405018, "defeat_orc_mage": 84.22939068100358, "eat_snail": 92.1146953405018, "find_bow": 96.415770609319, "fire_bow": 95.6989247311828, "open_chest": 96.415770609319, "drink_potion": 80.64516129032258}, "average_episode_length": 1015.5340501792115, "mean_return_percentage": 23.327678148392646, "mean_return": 52.72055261536738, "lp": NaN, "priority_score": 0.24858365128916635}]</data>
