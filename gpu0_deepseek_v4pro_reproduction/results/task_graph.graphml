"session": 150, "sr": 0.5833333333333334, "achievement_srs": {"collect_wood": 100.0, "place_table": 100.0, "eat_cow": 98.14814814814815, "collect_sapling": 100.0, "collect_drink": 99.07407407407408, "make_wood_pickaxe": 100.0, "make_wood_sword": 100.0, "place_plant": 100.0, "defeat_zombie": 80.0925925925926, "collect_stone": 100.0, "place_stone": 100.0, "eat_plant": 26.38888888888889, "defeat_skeleton": 80.0925925925926, "make_stone_pickaxe": 97.22222222222223, "make_stone_sword": 99.53703703703704, "wake_up": 99.53703703703704, "place_furnace": 99.07407407407408, "collect_coal": 94.9074074074074, "collect_iron": 84.72222222222223, "collect_diamond": 35.18518518518518, "make_iron_pickaxe": 29.62962962962963, "make_iron_sword": 59.72222222222222, "make_arrow": 98.61111111111111, "make_torch": 96.75925925925925, "place_torch": 96.75925925925925, "collect_sapphire": 24.074074074074073, "collect_ruby": 27.314814814814813, "make_diamond_pickaxe": 1.8518518518518519, "make_diamond_sword": 4.62962962962963, "make_iron_armour": 3.7037037037037037, "enter_gnomish_mines": 58.333333333333336, "enter_dungeon": 99.53703703703704, "defeat_orc_solider": 95.83333333333333, "defeat_orc_mage": 91.66666666666667, "eat_snail": 97.68518518518519, "find_bow": 98.14814814814815, "fire_bow": 96.29629629629629, "open_chest": 98.14814814814815, "drink_potion": 88.42592592592592}, "average_episode_length": 1254.4722222222222, "mean_return_percentage": 26.33022432130347, "mean_return": 59.506306966145836, "lp": NaN, "priority_score": 0.24305555555555555}]</data>
