      <data key="d3">import jax
import jax.numpy as jnp
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to clear the dungeon floor by defeating multiple spawned orcs, then descend to enter the Gnomish Mines.

    Description: The agent starts on Floor 1 (the Dungeon) at the ladder‑up position, equipped with an iron sword (level 3), a bow, 20 arrows, and one piece of iron armour (+1 defence). All status bars (health, food, drink, energy, mana) are full. Normal spawning is restored: melee_spawn_multiplier = 1.0, ranged_spawn_multiplier = 1.0, passive_spawn_multiplier = 0.0, so Orc Soldiers and Orc Mages will spawn naturally according to the dungeon’s usual spawn rules. The level‑clear requirement is lowered to 6 hostiles (monsters_killed_to_clear_level = 6). The agent must explore the dungeon, locate and defeat enough orcs (and potentially any other hostile mobs on the floor) to meet that kill count, then find the ladder down and descend to Floor 2, thereby unlocking the ENTER_GNOMISH_MINES achievement. Success is defined by obtaining DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, and ENTER_GNOMISH_MINES.

    Relevant Achievements: DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, ENTER_GNOMISH_MINES

    Completed Achievements: COLLECT_WOOD, PLACE_TABLE, COLLECT_STONE, COLLECT_COAL, COLLECT_IRON, MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, MAKE_IRON_SWORD, MAKE_IRON_ARMOUR, PLACE_FURNACE, ENTER_DUNGEON, FIND_BOW, MAKE_ARROW, FIRE_BOW

    World:
    - Player: Start on floor 1 (set_starting_floor(1)). Inventory: {"sword": 3, "bow": 1, "arrows": 20, "armour": 1}. All stats at max.
    - Map: No manual block or mob placements; the normal dungeon generation (rooms, corridors, chests, fountains) is left unchanged. We rely on the spawn system to produce the orcs.

    - Mechanics:
      - melee_spawn_multiplier = 1.0
      - ranged_spawn_multiplier = 1.0
      - passive_spawn_multiplier = 0.0 (no passive animals on this floor)
      - monsters_killed_to_clear_level for floor 1 = 6
      - needs_depletion_multiplier = 1.0 (normal survival pressure)
      - All other TaskParams at default values.
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.DEFEAT_ORC_SOLIDER,
            Achievement.DEFEAT_ORC_MAGE,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.COLLECT_WOOD,
            Achievement.PLACE_TABLE,
            Achievement.COLLECT_STONE,
            Achievement.COLLECT_COAL,
            Achievement.COLLECT_IRON,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_IRON_SWORD,
            Achievement.MAKE_IRON_ARMOUR,
            Achievement.PLACE_FURNACE,
            Achievement.ENTER_DUNGEON,
            Achievement.FIND_BOW,
            Achievement.MAKE_ARROW,
            Achievement.FIRE_BOW,
        ]
        self.label = "DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=6,
            needs_depletion_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)
        builder.set_starting_floor(1)
        builder.set_player_inventory({
            "sword": 3,
            "bow": 1,
            "arrows": 20,
            "armour": jnp.array([1, 0, 0, 0]),
        })

        state = builder.build(rng)

        # Set pre-completed achievements
        achievements = jnp.zeros((len(Achievement),), dtype=bool)
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
      <data key="d4">[{"session": 37, "sr": 0.018709073900841908, "achievement_srs": {"collect_sapling": 9.167446211412535, "collect_drink": 65.7623947614593, "place_plant": 8.886810102899906, "defeat_zombie": 6.641721234798878, "place_stone": 5.612722170252573, "defeat_skeleton": 4.490177736202058, "wake_up": 93.91955098222638, "collect_diamond": 16.744621141253507, "make_iron_pickaxe": 6.454630495790458, "make_torch": 77.82974742750234, "place_torch": 75.30402245088868, "collect_sapphire": 13.470533208606174, "make_diamond_pickaxe": 2.3386342376052385, "make_diamond_sword": 2.245088868101029, "enter_gnomish_mines": 1.8709073900841908, "enter_dungeon": 100.0, "defeat_orc_solider": 86.43592142188962, "defeat_orc_mage": 73.15247895229186, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 98.0355472404116, "drink_potion": 65.94948550046773}, "average_episode_length": 263.7511693171188, "mean_return_percentage": 6.164906794818994, "mean_return": 13.932689356290926, "lp": NaN, "priority_score": 0.018359044454614743}]</data>
