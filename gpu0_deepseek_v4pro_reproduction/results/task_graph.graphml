      <data key="d3">import jax
import jax.numpy as jnp
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to clear a dungeon floor containing multiple hostile mobs—including a ranged attacker—before descending to the Gnomish Mines, expanding combat capability beyond a single enemy.

    Description: The player starts in the Dungeon (floor 1) at the ladder-up position. Inventory: stone sword (sword tier 2), bow, 15 arrows, and 8 torches. All stats are max (health 9, food 9, drink 9, energy 9, mana 9), and attributes are default (strength=1, dexterity=1, intelligence=1). Two Orc Soldiers (melee, type_id=2) and one Orc Mage (ranged, type_id=2) are pre-placed near the player using WorldBuilder. All spawn multipliers are set to 0.0, so no additional mobs appear. The floor‑clear requirement is set to 3, meaning the ladder down only activates after all three enemies are killed. The episode ends successfully when the agent earns the ENTER_GNOMISH_MINES achievement. The dungeon retains its default generation (rooms, corridors, chests, fountains). No survival‑parameter changes (needs depletion, health regen all default).

    Relevant Achievements: ENTER_GNOMISH_MINES
    Completed Achievements: ENTER_DUNGEON, FIND_BOW, MAKE_ARROW, MAKE_STONE_SWORD, MAKE_TORCH

    World:
    - Player: Starts on floor 1 at the ladder‑up tile. Inventory: `{"sword": 2, "bow": 1, "arrows": 15, "torches": 8}`. All stats maximum. Attributes: strength=1, dexterity=1, intelligence=1.
    - Map: Pre‑place mobs near the player position (e.g., player start is the ladder‑up location). Use `builder.add_mobs_randomly_near` to place exactly:
        - 2 Orc Soldiers (`"melee"`, type_id=2) with `n=2`, `target_pos=player_pos`, `min_dist=4`, `max_dist=8`, `on_blocks=[BlockType.PATH]`.
        - 1 Orc Mage (`"ranged"`, type_id=2) with `n=1`, `target_pos=player_pos`, `min_dist=4`, `max_dist=8`, `on_blocks=[BlockType.PATH]`.
      All other map features remain default.
    - Mechanics:
        `passive_spawn_multiplier = 0.0`
        `melee_spawn_multiplier = 0.0`
        `ranged_spawn_multiplier = 0.0`
        `monsters_killed_to_clear_level = 3`
      All other TaskParams are default.
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_GNOMISH_MINES]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.FIND_BOW,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_TORCH,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=0.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=3,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, melee_rng, ranged_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(1)
        builder.set_player_inventory({"sword": 2, "bow": 1, "arrows": 15, "torches": 8})

        player_pos = builder.player_position

        # Place 2 Orc Soldiers (melee, type_id=2) near the player
        builder.add_mobs_randomly_near(
            melee_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=2,
            target_pos=player_pos,
            min_dist=4,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        # Place 1 Orc Mage (ranged, type_id=2) near the player
        builder.add_mobs_randomly_near(
            ranged_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=1,
            target_pos=player_pos,
            min_dist=4,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        state = builder.build(rng)

        # Mark completed achievements as already earned
        initial_achievements = jnp.zeros((len(Achievement),), dtype=bool)
        for ach in self.completed_achievements:
            initial_achievements = initial_achievements.at[ach.value].set(True)
        state = state.replace(achievements=initial_achievements)

        return state</data>
