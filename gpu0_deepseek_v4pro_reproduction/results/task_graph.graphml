      <data key="d3">import jax
import jax.numpy as jnp
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Defeat a Gnome Warrior and a Gnome Archer in the pitch‑black Gnomish Mines, forcing the agent to combine torch placement with melee/ranged combat against tougher new enemies.

Description: The agent begins on floor 2 (the Gnomish Mines) equipped with a stone sword (tier 2) and a stone pickaxe (tier 2). Its inventory also contains 4 torches, 2 wood, and 2 coal to craft additional torches if necessary. All hostile spawn multipliers (melee and ranged) are set to 0, so no random mobs appear; only the two pre‑placed gnome mobs exist. A Gnome Warrior (melee, type_id 1, health 9, damage 4) and a Gnome Archer (ranged, type_id 1, health 6, damage 2) are each placed within a Manhattan distance of 2 to 5 tiles from the player’s spawn point, guaranteeing immediate combat access. Passive mobs (Bats) spawn normally (multiplier 1.0) to provide food (EAT_BAT) for survival needs. The level’s default lighting is pitch black (0.0), requiring the agent to place torches to see. The episode terminates successfully as soon as both the Gnome Warrior and the Gnome Archer are defeated – no floor‑clearing or descent is required.

Relevant Achievements: DEFEAT_GNOME_WARRIOR, DEFEAT_GNOME_ARCHER
Completed Achievements: ENTER_GNOMISH_MINES, MAKE_STONE_SWORD, MAKE_STONE_PICKAXE
World:
- Player: Starts on floor 2. Inventory: {"sword": 2, "pickaxe": 2, "torches": 4, "wood": 2, "coal": 2}. Attributes and status bars at default (STR 1, DEX 1, INT 1; health/food/drink/energy/mana all 9/9).
- Map:
  - Pre‑place one Gnome Warrior (mob_name="melee", type_id=1) near player start using `add_mobs_randomly_near` (min_dist=2, max_dist=5, on_blocks valid ground).
  - Pre‑place one Gnome Archer (mob_name="ranged", type_id=1) similarly.
- Mechanics:
  - `melee_spawn_multiplier = 0.0`
  - `ranged_spawn_multiplier = 0.0`
  - `passive_spawn_multiplier = 1.0`
  - All other TaskParams remain at default values.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.DEFEAT_GNOME_WARRIOR,
            Achievement.DEFEAT_GNOME_ARCHER,
        ]
        self.completed_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_STONE_PICKAXE,
        ]
        self.label = "DEFEAT_GNOME_WARRIOR, DEFEAT_GNOME_ARCHER"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            passive_spawn_multiplier=1.0,
            # all other values remain default (1.0)
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, mob_rng1, mob_rng2 = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines)
        builder.set_starting_floor(2)

        # Equip starting inventory
        builder.set_player_inventory({
            "sword": 2,      # stone sword
            "pickaxe": 2,    # stone pickaxe
            "torches": 4,
            "wood": 2,
            "coal": 2,
        })

        # Player spawn position after floor selection (top‑left of the level)
        player_pos = builder.player_position

        # Place one Gnome Warrior (melee, type_id=1) near the player
        builder.add_mobs_randomly_near(
            rng=mob_rng1,
            level=2,
            mob_name="melee",
            type_id=1,
            n=1,
            target_pos=player_pos,
            min_dist=2,
            max_dist=5,
            on_blocks=[BlockType.PATH],   # valid ground in the dungeon
        )

        # Place one Gnome Archer (ranged, type_id=1) near the player
        builder.add_mobs_randomly_near(
            rng=mob_rng2,
            level=2,
            mob_name="ranged",
            type_id=1,
            n=1,
            target_pos=player_pos,
            min_dist=2,
            max_dist=5,
            on_blocks=[BlockType.PATH],
        )

        # Build the full initial state
        state = builder.build(rng)

        # Set floor 2 light map to pitch black (0.0)
        light_map = state.light_map
        light_map = light_map.at[2].set(jnp.zeros(self.static_params.map_size, dtype=jnp.float32))
        state = state.replace(light_map=light_map)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
