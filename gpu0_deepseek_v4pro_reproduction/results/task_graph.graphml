      <data key="d2">Objective: Collect iron ore.
Description: The player must achieve the `COLLECT_IRON` achievement. The player starts on floor 0 with a stone pickaxe. The world is a standard procedural overworld with 5 iron blocks placed 4–8 tiles from the player's start (Manhattan distance). Mobs and needs are enabled but with easier settings identical to the coal-collection task, so that the agent can focus on locating and mining iron with the provided tool.
Relevant Achievements: COLLECT_IRON
Completed Achievements: MAKE_STONE_PICKAXE
World:
- Player: Starts on floor 0 with a stone pickaxe (`{"pickaxe": 2}`).
- Map: 5 `IRON` blocks are placed randomly on `GRASS` or `STONE` within 4–8 (Manhattan distance) tiles of the player. Additionally, 3 `COW` (passive mob type_id=0) are placed 4–8 tiles away to maintain familiar survival.
- Mechanics: "needs_depletion_multiplier = 0.5", "passive_spawn_multiplier = 1.0", "melee_spawn_multiplier = 0.2", "ranged_spawn_multiplier = 0.2"</data>
      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Collect iron ore.
    Description: The player must achieve the `COLLECT_IRON` achievement. The player starts on floor 0 with a stone pickaxe. The world is a standard procedural overworld with 5 iron blocks placed 4–8 tiles from the player's start (Manhattan distance). Mobs and needs are enabled but with easier settings identical to the coal-collection task, so that the agent can focus on locating and mining iron with the provided tool.
    Relevant Achievements: COLLECT_IRON
    Completed Achievements: MAKE_STONE_PICKAXE
    World:
    - Player: Starts on floor 0 with a stone pickaxe (`{"pickaxe": 2}`).
    - Map: 5 `IRON` blocks are placed randomly on `GRASS` or `STONE` within 4–8 (Manhattan distance) tiles of the player. Additionally, 3 `COW` (passive mob type_id=0) are placed 4–8 tiles away to maintain familiar survival.
    - Mechanics: "needs_depletion_multiplier = 0.5", "passive_spawn_multiplier = 1.0", "melee_spawn_multiplier = 0.2", "ranged_spawn_multiplier = 0.2"
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.COLLECT_IRON]
        self.completed_achievements = [Achievement.MAKE_STONE_PICKAXE]
        self.label = "COLLECT_IRON"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=0.2,
            ranged_spawn_multiplier=0.2,
            needs_depletion_multiplier=0.5,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, iron_rng, cow_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(0)

        # Give the player a stone pickaxe
        builder.set_player_inventory({"pickaxe": 2})

        # Place 5 iron blocks near the player on level 0
        builder.place_randomly_near(
            iron_rng,
            level=0,
            block_type=BlockType.IRON,
            target_pos=builder.player_position,
            min_dist=4,
            max_dist=8,
            n=5,
            on_blocks=[BlockType.GRASS, BlockType.STONE],
        )

        # Place 3 cows as a food source
        builder.add_mobs_randomly_near(
            cow_rng,
            level=0,
            mob_name="passive",
            type_id=0,  # Cow
            n=3,
            target_pos=builder.player_position,
            min_dist=4,
            max_dist=8,
            on_blocks=[BlockType.GRASS, BlockType.PATH],
        )

        return builder.build(rng)</data>
