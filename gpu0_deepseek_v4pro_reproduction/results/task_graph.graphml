"collect_coal": 61.31498470948012, "collect_iron": 50.305810397553515, "collect_diamond": 28.89908256880734, "make_iron_pickaxe": 13.608562691131498, "make_iron_sword": 14.678899082568808, "make_arrow": 100.0, "make_torch": 100.0, "place_torch": 98.31804281345566, "collect_sapphire": 25.68807339449541, "collect_ruby": 27.98165137614679, "make_diamond_pickaxe": 3.8226299694189603, "make_diamond_sword": 4.434250764525994, "enter_gnomish_mines": 46.02446483180428, "enter_dungeon": 100.0, "defeat_orc_solider": 98.47094801223241, "defeat_orc_mage": 92.20183486238533, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 94.64831804281346, "drink_potion": 79.96941896024465}, "average_episode_length": 424.33639143730886, "mean_return_percentage": 15.287859840988743, "mean_return": 34.55056324063456, "lp": NaN, "priority_score": 0.2482955980136352}]</data>
