tage": 15.98086422957733, "mean_return": 36.116753158844766, "lp": NaN, "priority_score": 0.011418889859114599}, {"session": 22, "sr": 0.9506517690875232, "achievement_srs": {"collect_wood": 99.90689013035382, "place_table": 98.41713221601489, "eat_cow": 85.75418994413408, "collect_sapling": 99.90689013035382, "collect_drink": 82.86778398510242, "place_plant": 99.81378026070763, "defeat_zombie": 24.487895716945996, "collect_stone": 100.0, "place_stone": 99.06890130353817, "eat_plant": 0.4655493482309125, "defeat_skeleton": 9.962756052141527, "make_stone_pickaxe": 97.67225325884544, "make_stone_sword": 75.88454376163874, "wake_up": 84.07821229050279, "place_furnace": 96.8342644320298, "collect_coal": 83.14711359404097, "collect_iron": 95.62383612662943, "collect_diamond": 5.21415270018622, "make_iron_pickaxe": 1.3966480446927374, "make_iron_sword": 0.931098696461825, "make_arrow": 84.45065176908753, "make_torch": 81.09869646182496, "place_torch": 69.55307262569832, "collect_sapphire": 3.7243947858473, "collect_ruby": 2.5139664804469275, "make_diamond_pickaxe": 0.27932960893854747, "make_diamond_sword": 0.0931098696461825, "enter_dungeon": 39.57169459962756, "defeat_orc_solider": 6.238361266294227, "defeat_orc_mage": 1.1173184357541899, "eat_snail": 9.31098696461825, "find_bow": 37.80260707635009, "fire_bow": 28.864059590316575, "open_chest": 37.80260707635009, "drink_potion": 13.035381750465548}, "average_episode_length": 250.56983240223462, "mean_return_percentage": 17.750197047366555, "mean_return": 40.11544532704842, "lp": NaN, "priority_score": 0.04691298301828563}]</data>
