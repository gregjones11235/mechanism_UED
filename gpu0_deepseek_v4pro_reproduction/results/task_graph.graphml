      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Achieve the Gnomish Mines transition under full original survival pressure, forcing robust integration of combat, resource gathering, and needs management.

Description: The agent begins on Floor 0 (Overworld) with empty inventory, all survival stats (food, drink, energy, health, mana) at maximum (9/9), and base attributes (STR=1, DEX=1, INT=1). The world uses the default procedural generation for all nine floors; no blocks or mobs are added or removed. All spawn multipliers remain at 1.0 (standard melee, ranged, and passive mob frequencies). The kill requirement to clear the Dungeon (Floor 1) ladder is set to 8, matching the original game. The critical difference from the previous task is that survival mechanics are returned to default: `needs_depletion_multiplier` is 1.0 and `health_recover_multiplier` is 1.0. This means hunger, thirst, and fatigue accumulate at the normal rate, and health regeneration (when needs are met) proceeds at the standard speed, making resource management relevant throughout the run. The agent must gather wood and stone, craft basic tools and weapons, descend into the Dungeon (Floor 1), defeat at least 8 hostile monsters (Orc Soldiers, Orc Mages) to open the ladder down, and finally descend to Floor 2 to achieve ENTER_GNOMISH_MINES. The episode ends successfully only upon entering the Gnomish Mines.

Relevant Achievements: ENTER_DUNGEON, DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, ENTER_GNOMISH_MINES
Completed Achievements: (none)

World:
- Player: Starting floor 0; inventory empty; food=9, drink=9, energy=9, health=9, mana=9; strength=1, dexterity=1, intelligence=1; no spells learned; no weapon or armour enchantments.
- Map: No modifications; all levels use standard procedural generation.
- Mechanics:
    "needs_depletion_multiplier": 1.0,
    "health_recover_multiplier": 1.0,
    "melee_spawn_multiplier": 1.0,
    "ranged_spawn_multiplier": 1.0,
    "passive_spawn_multiplier": 1.0,
    "monsters_killed_to_clear_level": 8
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.DEFEAT_ORC_SOLIDER,
            Achievement.DEFEAT_ORC_MAGE,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = []  # none
        self.label = "ENTER_DUNGEON, DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=1.0,
            health_recover_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            monsters_killed_to_clear_level=8,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld) with no inventory or modifications
        builder.set_starting_floor(0)

        state = builder.build(rng)

        # No pre‑completed achievements to mark
        return state</data>
