358974358, "make_iron_pickaxe": 21.367521367521366, "make_iron_sword": 52.99145299145299, "make_arrow": 95.2991452991453, "make_torch": 93.16239316239316, "place_torch": 91.45299145299145, "collect_sapphire": 20.512820512820515, "collect_ruby": 25.641025641025642, "make_diamond_pickaxe": 3.8461538461538463, "make_diamond_sword": 4.273504273504273, "make_iron_armour": 3.8461538461538463, "enter_gnomish_mines": 59.401709401709404, "enter_dungeon": 89.74358974358974, "defeat_orc_solider": 85.8974358974359, "defeat_orc_mage": 76.4957264957265, "eat_snail": 86.75213675213675, "find_bow": 89.31623931623932, "fire_bow": 87.6068376068376, "open_chest": 89.31623931623932, "drink_potion": 70.94017094017094}, "average_episode_length": 1171.2222222222222, "mean_return_percentage": 24.822241397445353, "mean_return": 56.098265558226494, "lp": NaN, "priority_score": 0.24532471327343122}]</data>
