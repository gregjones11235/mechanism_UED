 "place_furnace": 42.06827309236948, "collect_coal": 62.14859437751004, "collect_iron": 50.502008032128515, "collect_diamond": 30.220883534136547, "make_iron_pickaxe": 11.345381526104418, "make_iron_sword": 13.25301204819277, "place_torch": 100.0, "collect_sapphire": 25.0, "collect_ruby": 25.401606425702813, "make_diamond_pickaxe": 3.4136546184738954, "make_diamond_sword": 3.714859437751004, "enter_gnomish_mines": 55.321285140562246, "enter_dungeon": 100.0, "defeat_orc_solider": 87.44979919678715, "defeat_orc_mage": 79.71887550200803, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 99.39759036144578, "drink_potion": 87.24899598393574}, "average_episode_length": 281.92269076305223, "mean_return_percentage": 15.85477696182962, "mean_return": 35.83179593373494, "lp": NaN, "priority_score": 0.24716839244528313}]</data>
