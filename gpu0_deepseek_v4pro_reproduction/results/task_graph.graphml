      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Teach the agent to clear multiple Orc enemies in the Dungeon and descend to the Gnomish Mines (Floor 2).

Description: The agent begins on Floor 1 (Dungeon) equipped with an iron sword, an iron pickaxe, a bow, arrows, torches, and a small stock of resources. The Overworld is completely skipped; the ladder up is blocked so the agent cannot return to Floor 0. Five hostile mobs are placed on the dungeon map: three Orc Soldiers (melee, type_id=2) and two Orc Mages (ranged, type_id=2), scattered within 3‑10 tiles of the start. No other mobs spawn. The kill‑to‑clear requirement for Floor 1 is set to 5, so the agent must defeat all five placed enemies to unlock the Ladder Down. Survival needs are slowed to 30% of normal, making starvation a non‑issue, while health regeneration is standard. Enemy health and damage are reduced by 20% and 30% respectively to keep the multi‑mob combat learnable. The episode terminates successfully when the agent uses the unlocked Ladder Down and achieves `ENTER_GNOMISH_MINES`. The primary training pressure is on navigating the dungeon, engaging multiple ranged and melee threats, managing resources, and using the descent action.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_STONE_PICKAXE, MAKE_IRON_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_SWORD, MAKE_IRON_SWORD, MAKE_ARROW, MAKE_TORCH, FIND_BOW, ENTER_DUNGEON

World:
- Player: Floor 1 (spawn at the dungeon’s up‑ladder position). Inventory: {"sword": 3, "pickaxe": 3, "bow": 1, "arrows": 15, "torch": 30, "wood": 10, "stone": 10, "coal": 5, "iron": 5}. Stats: Strength 1, Dexterity 1, Intelligence 1. Health/Food/Drink/Energy/Mana all 9/9. No weapon or armour enchantments. No learned spells.
- Map:
    - Floor 1: Default dungeon generation is used. After generation, block the up‑ladder tile (the player spawn coordinate) by placing a solid block (e.g., `BlockType.STONE`) at that exact position using `builder.place_block(1, BlockType.STONE, player_spawn_coord)`. Then, using `builder.add_mobs_randomly_near`, place three Orc Soldiers ("melee", type_id=2) and two Orc Mages ("ranged", type_id=2), each with `target_pos=None` (player spawn), `min_dist=3`, `max_dist=10`, `n=1`, `on_blocks=[BlockType.PATH]` (executed 5 times, ensuring distinct mobs).
    - All other floors remain unmodified.
- Mechanics:
    "needs_depletion_multiplier": 0.3,
    "mob_health_multiplier": 0.8,
    "mob_damage_multiplier": 0.7,
    "melee_spawn_multiplier": 0.0,
    "ranged_spawn_multiplier": 0.0,
    "passive_spawn_multiplier": 0.0,
    "monsters_killed_to_clear_level": 5,
    "health_recover_multiplier": 1.0,
    "health_loss_multiplier": 1.0
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_IRON_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_IRON_SWORD,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_TORCH,
            Achievement.FIND_BOW,
            Achievement.ENTER_DUNGEON,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.3,
            mob_health_multiplier=0.8,
            mob_damage_multiplier=0.7,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            passive_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=5,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, mob_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Equip starting inventory
        builder.set_player_inventory({
            "sword": 3,      # iron sword
            "pickaxe": 3,    # iron pickaxe
            "bow": 1,
            "arrows": 15,
            "torches": 30,
            "wood": 10,
            "stone": 10,
            "coal": 5,
            "iron": 5,
        })

        # Player spawn coordinate (up-ladder on floor 1)
        spawn_pos = builder.player_position

        # Block the up-ladder to prevent returning to floor 0
        builder.place_block(1, BlockType.STONE, spawn_pos)

        # Split mob RNGs for the five placements
        mob1_rng, mob2_rng, mob3_rng, mob4_rng, mob5_rng = jax.random.split(mob_rng, 5)

        # Place three Orc Soldiers (melee, type_id=2)
        builder.add_mobs_randomly_near(
            mob1_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=1,
            target_pos=spawn_pos,
            min_dist=3,
            max_dist=10,
            on_blocks=[BlockType.PATH],
        )
        builder.add_mobs_randomly_near(
            mob2_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=1,
            target_pos=spawn_pos,
            min_dist=3,
            max_dist=10,
            on_blocks=[BlockType.PATH],
        )
        builder.add_mobs_randomly_near(
            mob3_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=1,
            target_pos=spawn_pos,
            min_dist=3,
            max_dist=10,
            on_blocks=[BlockType.PATH],
        )

        # Place two Orc Mages (ranged, type_id=2)
        builder.add_mobs_randomly_near(
            mob4_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=1,
            target_pos=spawn_pos,
            min_dist=3,
            max_dist=10,
            on_blocks=[BlockType.PATH],
        )
        builder.add_mobs_randomly_near(
            mob5_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=1,
            target_pos=spawn_pos,
            min_dist=3,
            max_dist=10,
            on_blocks=[BlockType.PATH],
        )

        state = builder.build(rng)

        # Mark completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
