      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams
from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to survive and clear the Dungeon under realistic hostile spawn pressure, then descend to the Gnomish Mines.

Description: The agent starts on Floor 1 (Dungeon) at the ladder‑up arrival point with inventory: stone sword (1), bow (1), arrows (10), torches (4). All survival meters (food, drink, energy, health, mana) are full (9/9). Natural hostile spawns are enabled at a moderate rate: melee and ranged spawn multipliers are set to 0.5, so Orc Soldiers and Orc Mages will gradually appear throughout the floor. Passive spawns (snails) are also increased to 0.5 to provide a reliable food source. Survival needs are turned up slightly (needs_depletion_multiplier = 0.5), making hunger and thirst a noticeable but not urgent concern. Health recovery remains boosted (health_recover_multiplier = 2.0). The level‑clear requirement is lowered to 4 kills (monsters_killed_to_clear_level = 4) to keep episodes at a trainable length while still forcing the agent to defeat several dynamic threats. The agent must kill at least one Orc Soldier and one Orc Mage (unlocking those achievements) and then descend via the ladder to Floor 2 to reach the Gnomish Mines. The episode succeeds only when the agent triggers ENTER_GNOMISH_MINES.

Relevant Achievements: DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, ENTER_GNOMISH_MINES
Completed Achievements: ENTER_DUNGEON, MAKE_STONE_SWORD, FIND_BOW
World:
- Player: Starting floor 1; inventory: `{"stone_sword": 1, "bow": 1, "arrows": 10, "torches": 4}`; all survival stats are 9/9.
- Map: No block modifications; the standard Dungeon layout is used.
- Mechanics: 
    "melee_spawn_multiplier": 0.5,
    "ranged_spawn_multiplier": 0.5,
    "passive_spawn_multiplier": 0.5,
    "needs_depletion_multiplier": 0.5,
    "health_recover_multiplier": 2.0,
    "monsters_killed_to_clear_level": 4
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.DEFEAT_ORC_SOLIDER,
            Achievement.DEFEAT_ORC_MAGE,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.MAKE_STONE_SWORD,
            Achievement.FIND_BOW,
        ]
        self.label = "DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=0.5,
            ranged_spawn_multiplier=0.5,
            passive_spawn_multiplier=0.5,
            needs_depletion_multiplier=0.5,
            health_recover_multiplier=2.0,
            monsters_killed_to_clear_level=4,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        builder = WorldBuilder(rng, self.static_params, self.params)
        builder.set_starting_floor(1)
        builder.set_player_inventory({
            "sword": 2,    # stone sword (tier 2)
            "bow": 1,
            "arrows": 10,
            "torches": 4,
        })
        return builder.build(rng)</data>
