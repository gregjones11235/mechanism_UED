      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Descend from the dungeon into the Gnomish Mines after defeating a moderate number of orcs.

Description: The agent begins on floor 1 (the dungeon) standing on the ladder‑up tile. It starts with a full stone‑age loadout: stone pickaxe (tier 2), stone sword (tier 2), a bow, 10 arrows, and 10 torches. All attributes are at their defaults (Strength 1, Dexterity 1, Intelligence 1) and all survival bars are full (Health, Food, Drink, Energy, Mana = 9 each). The ladder down from floor 0 is pre‑unlocked (monsters_killed for floor 0 set to 8).  
To succeed, the agent must kill at least 5 hostile mobs (orc soldiers, orc mages) on floor 1, locate the ladder‑down somewhere within the procedurally‑generated dungeon, and descend to floor 2. This triggers the `ENTER_GNOMISH_MINES` achievement.  
All mob spawn multipliers remain at default (melee 1.0, ranged 1.0, passive 0.0) with standard health and damage. Survival needs deplete normally, but the full starting reserves give a comfortable initial buffer. The task ends immediately upon entering floor 2; no boss interaction or further crafting is required.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: COLLECT_WOOD, PLACE_TABLE, MAKE_WOOD_PICKAXE, COLLECT_STONE, MAKE_STONE_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_SWORD, FIND_BOW, MAKE_ARROW, MAKE_TORCH

World:
- Player: Starting floor = 1 (dungeon), at the ladder‑up position.
  Inventory (via builder.set_player_inventory): stone pickaxe (pickaxe=2, tier 2), stone sword (sword=2, tier 2), bow (bow=1), arrows=10, torches=10.
  Stats: all default (Strength=1, Dexterity=1, Intelligence=1).
  Monsters killed: builder.set_monsters_killed(level=0, count=8) – floor 0 is already cleared.
- Map: No block modifications; the dungeon is generated normally with rooms, corridors, water channels, chests, fountains, and ladders.
- Mechanics:
  - monsters_killed_to_clear_level = 5  (up from the previous 3; approaching the default 8)
  - All other TaskParams at default (melee_spawn_multiplier = 1.0, ranged_spawn_multiplier = 1.0, passive_spawn_multiplier = 0.0, mob_health_multiplier = 1.0, mob_damage_multiplier = 1.0, needs_depletion_multiplier = 1.0, health_recover_multiplier = 1.0, health_loss_multiplier = 1.0, mana_recover_multiplier = 1.0, growing_plants_age = 600).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.COLLECT_WOOD,
            Achievement.PLACE_TABLE,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.COLLECT_STONE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_SWORD,
            Achievement.FIND_BOW,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_TORCH,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        return TaskParams(
            monsters_killed_to_clear_level=5,
            passive_spawn_multiplier=0.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            needs_depletion_multiplier=1.0,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            growing_plants_age=600,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Equip stone-age starting inventory
        builder.set_player_inventory({
            "pickaxe": 2,   # stone pickaxe = tier 2
            "sword": 2,     # stone sword = tier 2
            "bow": 1,
            "arrows": 10,
            "torches": 10,
        })

        # Floor 0 is pre-cleared
        builder.set_monsters_killed(level=0, count=8)

        state = builder.build(rng)

        # Mark completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
