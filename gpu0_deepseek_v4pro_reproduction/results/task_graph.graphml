.261904761904762, "collect_sapling": 7.4603174603174605, "collect_drink": 39.44444444444444, "make_wood_pickaxe": 19.365079365079364, "make_wood_sword": 100.0, "place_plant": 7.222222222222222, "collect_stone": 7.738095238095238, "place_stone": 7.142857142857143, "make_stone_pickaxe": 11.071428571428571, "make_stone_sword": 11.19047619047619, "wake_up": 15.833333333333334, "place_furnace": 7.4603174603174605, "collect_coal": 26.19047619047619, "collect_iron": 26.38888888888889, "collect_diamond": 13.88888888888889, "make_iron_pickaxe": 4.841269841269841, "make_iron_sword": 4.841269841269841, "make_torch": 63.80952380952381, "place_torch": 61.98412698412698, "collect_sapphire": 10.357142857142858, "collect_ruby": 11.071428571428571, "make_diamond_pickaxe": 1.5873015873015872, "make_diamond_sword": 1.507936507936508, "enter_dungeon": 100.0, "defeat_orc_mage": 78.57142857142857, "find_bow": 100.0, "fire_bow": 99.96031746031746, "open_chest": 91.38888888888889, "drink_potion": 52.57936507936508}, "average_episode_length": 110.34484126984127, "mean_return_percentage": 12.952062427570588, "mean_return": 29.271661086309525, "lp": NaN, "priority_score": 0.16836734693877553}]</data>
