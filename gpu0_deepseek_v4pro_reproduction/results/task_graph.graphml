419355, "eat_plant": 11.559139784946236, "defeat_skeleton": 28.225806451612904, "make_stone_pickaxe": 51.344086021505376, "wake_up": 95.96774193548387, "place_furnace": 48.924731182795696, "collect_coal": 75.26881720430107, "collect_iron": 68.81720430107526, "collect_diamond": 28.49462365591398, "make_iron_pickaxe": 18.27956989247312, "make_iron_sword": 32.526881720430104, "make_arrow": 78.49462365591398, "make_torch": 93.81720430107526, "place_torch": 93.01075268817205, "collect_sapphire": 23.387096774193548, "collect_ruby": 30.376344086021504, "make_diamond_pickaxe": 2.956989247311828, "make_diamond_sword": 2.956989247311828, "enter_gnomish_mines": 39.516129032258064, "enter_dungeon": 100.0, "defeat_orc_solider": 96.7741935483871, "defeat_orc_mage": 87.09677419354838, "eat_snail": 95.96774193548387, "find_bow": 99.46236559139786, "fire_bow": 77.15053763440861, "open_chest": 99.46236559139786, "drink_potion": 83.87096774193549}, "average_episode_length": 757.7150537634409, "mean_return_percentage": 18.634878251677133, "mean_return": 42.11482484879032, "lp": NaN, "priority_score": 0.23900884495317376}]</data>
