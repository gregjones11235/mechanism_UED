"collect_drink": 25.0, "make_wood_sword": 100.0, "place_plant": 13.28125, "collect_stone": 15.104166666666666, "place_stone": 15.104166666666666, "eat_plant": 7.291666666666667, "make_stone_pickaxe": 20.833333333333332, "wake_up": 5.989583333333333, "place_furnace": 15.104166666666666, "collect_coal": 80.46875, "collect_iron": 28.90625, "collect_diamond": 18.489583333333332, "make_iron_pickaxe": 14.583333333333334, "make_iron_sword": 14.322916666666666, "make_arrow": 35.9375, "make_torch": 67.96875, "place_torch": 60.677083333333336, "collect_sapphire": 12.239583333333334, "collect_ruby": 13.28125, "make_diamond_pickaxe": 1.8229166666666667, "make_diamond_sword": 2.0833333333333335, "enter_dungeon": 100.0, "defeat_orc_solider": 79.94791666666667, "find_bow": 95.05208333333333, "fire_bow": 32.8125, "open_chest": 95.05208333333333, "drink_potion": 43.75}, "average_episode_length": 714.5416666666666, "mean_return_percentage": 14.367290935685148, "mean_return": 32.47007751464844, "lp": NaN, "priority_score": 0.16031222873263892}]</data>
