      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Enter the Gnomish Mines (floor 2) after crafting an iron sword and clearing the Dungeon, with a streamlined start that skips basic tool crafting.

Description: The agent starts on floor 0 with a stone pickaxe and a wood sword already in its inventory, and a crafting table pre‑placed directly south of spawn. To keep the iron‑sword pathway accessible, 8 coal blocks and 6 iron blocks are scattered within 3–8 cells of the player’s starting position, placed on stone tiles. The agent must use the stone pickaxe to mine coal and iron, craft a furnace, and then craft an iron sword at the table‑furnace station. After obtaining the iron sword, the agent must locate the dungeon ladder, descend to floor 1, defeat exactly 8 hostile orc enemies (soldiers or mages) to meet the level‑clear requirement, stand on the ladder down, and use the DESCEND action to reach floor 2 (Gnomish Mines). Survival needs are present at half the default rate (`needs_depletion_multiplier = 0.5`), requiring occasional eating and drinking without overwhelming the core progression. All other mechanics, mob behaviour, and world generation remain at original Craftax defaults to preserve transferability.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_STONE_PICKAXE, MAKE_WOOD_SWORD, PLACE_TABLE

World:
- Player:
  - `set_starting_floor(0)`
  - `set_player_inventory({"stone_pickaxe": 1, "wood_sword": 1})`
  - Attributes at defaults (Strength/Dex/Int=1, full health/mana/energy/food/drink).
- Map:
  - `place_block(0, BlockType.CRAFTING_TABLE, (player_start_row + 1, player_start_col))`
  - `place_randomly_near(rng, 0, BlockType.COAL, player_start_pos, min_dist=3, max_dist=8, n=8, on_blocks=[BlockType.STONE])`
  - `place_randomly_near(rng, 0, BlockType.IRON, player_start_pos, min_dist=3, max_dist=8, n=6, on_blocks=[BlockType.STONE])`
  - `set_monsters_killed(level=1, count=0)`
  - No other manual block changes; overworld terrain and ores are generated procedurally.
- Mechanics:
  - `monsters_killed_to_clear_level = 8`
  - `mob_health_multiplier = 1.0`
  - `mob_damage_multiplier = 1.0`
  - `melee_spawn_multiplier = 1.0`
  - `ranged_spawn_multiplier = 1.0`
  - `passive_spawn_multiplier = 1.0`
  - `needs_depletion_multiplier = 0.5`
  - `health_recover_multiplier = 1.0`
  - `health_loss_multiplier = 1.0`
  - `mana_recover_multiplier = 1.0`
  - `growing_plants_age = 600`
  - All other parameters at default values.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.PLACE_TABLE,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            needs_depletion_multiplier=0.5,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            growing_plants_age=600,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)
        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld)
        builder.set_starting_floor(0)

        # Equip stone pickaxe and wood sword
        builder.set_player_inventory({
            "pickaxe": 2,   # stone pickaxe (tier 2)
            "sword": 1,     # wood sword (tier 1)
        })

        # Player spawn position (center of map)
        spawn_pos = builder.player_position

        # Place a crafting table directly south of spawn
        builder.place_block(
            level=0,
            block_type=BlockType.CRAFTING_TABLE,
            position=(spawn_pos[0] + 1, spawn_pos[1]),
        )

        # Place 8 coal and 6 iron near spawn on stone tiles
        rng, coal_rng, iron_rng = jax.random.split(rng, 3)
        builder.place_randomly_near(
            coal_rng,
            level=0,
            block_type=BlockType.COAL,
            target_pos=spawn_pos,
            min_dist=3,
            max_dist=8,
            n=8,
            on_blocks=[BlockType.STONE],
        )
        builder.place_randomly_near(
            iron_rng,
            level=0,
            block_type=BlockType.IRON,
            target_pos=spawn_pos,
            min_dist=3,
            max_dist=8,
            n=6,
            on_blocks=[BlockType.STONE],
        )

        # Reset monsters killed on floor 1 (to enforce level clearing)
        builder.set_monsters_killed(level=1, count=0)

        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
