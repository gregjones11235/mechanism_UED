      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Train efficient combat and descent under Original Craftax survival pressure to reliably enter the Gnomish Mines.

Description: The agent starts on Floor 1 (Dungeon) with a moderate inventory that simulates a competent arrival from the Overworld. Survival multipliers are set to their original Craftax values (needs depletion 1.0×, health recovery 1.0×). The agent must defeat at least 8 hostile monsters (Orc Soldiers, Orc Mages) to open the ladder down, then descend to Floor 2. This forces the agent to manage hunger, thirst, fatigue, and health at full severity while engaging in combat, eliminating the cushion of previously softened survival rates and directly targeting the global ENTER_GNOMISH_MINES bottleneck.

Relevant Achievements: DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, ENTER_GNOMISH_MINES
Completed Achievements: ENTER_DUNGEON

World:
- Player: Starting floor 1; stone pickaxe (1), stone sword (1), wood (5), stone (10), torches (3), arrows (5), coal (2); all survival stats (food, drink, energy, health, mana) = 9/9; attributes STR=1, DEX=1, INT=1; no learned spells.
- Map: No modifications; all levels use standard procedural generation.
- Mechanics:
    "melee_spawn_multiplier": 1.0,
    "ranged_spawn_multiplier": 1.0,
    "passive_spawn_multiplier": 1.0,
    "needs_depletion_multiplier": 1.0,
    "health_recover_multiplier": 1.0,
    "monsters_killed_to_clear_level": 8
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.DEFEAT_ORC_SOLIDER,
            Achievement.DEFEAT_ORC_MAGE,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
        ]
        self.label = "DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            needs_depletion_multiplier=1.0,
            health_recover_multiplier=1.0,
            monsters_killed_to_clear_level=8,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon)
        builder.set_starting_floor(1)

        # Equip starting inventory: stone pickaxe (tier 2), stone sword (tier 2),
        # and the specified supplies
        builder.set_player_inventory({
            "pickaxe": 2,   # stone pickaxe
            "sword": 2,     # stone sword
            "wood": 5,
            "stone": 10,
            "torches": 3,
            "arrows": 5,
            "coal": 2,
        })

        # No map modifications; default procedural world is used
        state = builder.build(rng)

        # Mark pre-completed achievements
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
