      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to defeat both a melee Orc Soldier and a ranged Orc Mage on the first dungeon floor, combining previously practiced combat skills into a mixed encounter.

    Description: The agent spawns on Floor 1 (Dungeon) equipped with a stone sword, stone pickaxe, and a small buffer of raw wood and stone. Two hostile mobs are pre‑placed: one Orc Soldier (melee, type_id=2) and one Orc Mage (ranged, type_id=2), randomly placed within a few blocks of the player. All other spawn multipliers are zero, so no additional mobs appear. The kill requirement to clear the floor is set to 2, so after both kills the ladder down opens, naturally reinforcing that both enemies must be defeated. Survival needs are disabled to keep the focus entirely on the mixed‑combat challenge. This task extends the parent’s single‑mage practice into a realistic dungeon scenario, directly preparing the agent for clearing floor 1 in the full game.

    Relevant Achievements: DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE

    Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD

    World:
    - Player: Floor 1 (spawn at the ladder‑up position). Inventory: {"sword": 1, "pickaxe": 1, "wood": 5, "stone": 5}. All stats default (Strength 1, Dexterity 1, Intelligence 1; Health/Food/Drink/Energy/Mana all 9/9). No spells learned, no enchantments.
    - Map:
        - Use the default Dungeon generation for Floor 1 (rooms, corridors, chests, fountains, torches).
        - Place exactly one melee mob of type appropriate for Floor 1: Orc Soldier (mob_name="melee", type_id=2) via `add_mobs_randomly_near` with target_pos = player spawn, n=1, min_dist=2, max_dist=8, on any walkable terrain.
        - Place exactly one ranged mob of type appropriate for Floor 1: Orc Mage (mob_name="ranged", type_id=2) via `add_mobs_randomly_near` with target_pos = player spawn, n=1, min_dist=2, max_dist=8, on any walkable terrain.
    - Mechanics:
        - needs_depletion_multiplier = 0.0
        - melee_spawn_multiplier = 0.0
        - ranged_spawn_multiplier = 0.0
        - passive_spawn_multiplier = 0.0
        - monsters_killed_to_clear_level = 2
        - health_recover_multiplier = 1.0
        - mob_health_multiplier = 1.0
        - mob_damage_multiplier = 1.0
        - melee_trigger_distance = 10
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.DEFEAT_ORC_SOLIDER,
            Achievement.DEFEAT_ORC_MAGE,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
        ]
        self.label = "DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=0.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            needs_depletion_multiplier=0.0,
            health_recover_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            melee_trigger_distance=10,
            monsters_killed_to_clear_level=2,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, melee_rng, ranged_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on Floor 1 (Dungeon) with the ladder‑up position
        builder.set_starting_floor(1)

        # Equip the player with stone sword, stone pickaxe, and some raw materials
        builder.set_player_inventory({"sword": 1, "pickaxe": 1, "wood": 5, "stone": 5})

        # Place exactly one Orc Soldier (melee, type_id=2) near the player
        builder.add_mobs_randomly_near(
            melee_rng,
            level=1,
            mob_name="melee",
            type_id=2,               # Orc Soldier
            n=1,
            target_pos=builder.player_position,
            min_dist=2,
            max_dist=8,
        )

        # Place exactly one Orc Mage (ranged, type_id=2) near the player
        builder.add_mobs_randomly_near(
            ranged_rng,
            level=1,
            mob_name="ranged",
            type_id=2,               # Orc Mage
            n=1,
            target_pos=builder.player_position,
            min_dist=2,
            max_dist=8,
        )

        return builder.build(rng)</data>
