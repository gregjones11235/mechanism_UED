      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Clear the Dungeon floor by defeating at least five hostile mobs that spawn naturally, then descend into the Gnomish Mines.

Description: The agent starts on Floor 1 (Dungeon) at the position of the Ladder Up. It has a stone sword (tier 2), a bow, and 10 arrows in its inventory. Ambient mob spawning is re‑enabled but kept moderate: passive spawn multiplier 0.2 (to occasionally provide snails for food), melee spawn multiplier 0.5, ranged spawn multiplier 0.5. No mobs are placed manually; all mobs appear through normal in‑game spawning. The requirement to unlock the Ladder Down is `monsters_killed_to_clear_level = 5`, so the agent must defeat a total of five Orc Soldiers or Orc Mages. Once the kill count reaches 5, the Ladder Down becomes active; the agent must then locate it and use `DESCEND`. The episode terminates successfully only when the agent has descended to Floor 2 (Gnomish Mines). Survival needs decay at default rates. The starting gear eliminates any need to return to the overworld, forcing the agent to focus entirely on sustained dungeon combat and navigation.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: ENTER_DUNGEON, FIND_BOW

World:
- Player: Floor 1 at Ladder Up. Inventory: `{"sword": 2, "bow": 1, "arrows": 10}`. All stats max (health 9, food 9, drink 9, energy 9, mana 9). Attributes default: strength=1, dexterity=1, intelligence=1.
- Map:
  - No specific block or mob placements. The default dungeon layout (rooms, corridors, torches, chests, water fountains) is used.
- Mechanics:
  - passive_spawn_multiplier = 0.2
  - melee_spawn_multiplier = 0.5
  - ranged_spawn_multiplier = 0.5
  - monsters_killed_to_clear_level = 5
  - All other TaskParams keep default values (needs_depletion_multiplier = 1.0, health_recover_multiplier = 1.0, etc.).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.FIND_BOW,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=0.2,
            melee_spawn_multiplier=0.5,
            ranged_spawn_multiplier=0.5,
            monsters_killed_to_clear_level=5,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Equip stone sword (tier 2), bow, and 10 arrows
        builder.set_player_inventory({
            "sword": 2,   # stone sword
            "bow": 1,
            "arrows": 10,
        })

        state = builder.build(rng)

        # Mark pre-completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
