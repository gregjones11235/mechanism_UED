e_up": 99.13793103448276, "place_furnace": 100.0, "collect_coal": 100.0, "collect_iron": 76.29310344827586, "collect_diamond": 40.08620689655172, "make_iron_pickaxe": 23.275862068965516, "make_iron_sword": 52.1551724137931, "make_arrow": 97.84482758620689, "make_torch": 99.56896551724138, "place_torch": 99.56896551724138, "collect_sapphire": 26.724137931034484, "collect_ruby": 30.17241379310345, "make_diamond_pickaxe": 6.0344827586206895, "make_diamond_sword": 4.310344827586207, "make_iron_armour": 3.8793103448275863, "enter_gnomish_mines": 56.03448275862069, "enter_dungeon": 96.55172413793103, "defeat_orc_solider": 93.53448275862068, "defeat_orc_mage": 90.94827586206897, "eat_snail": 94.39655172413794, "find_bow": 96.55172413793103, "fire_bow": 96.12068965517241, "open_chest": 96.55172413793103, "drink_potion": 87.06896551724138}, "average_episode_length": 1248.728448275862, "mean_return_percentage": 23.447976739514992, "mean_return": 52.99242743130388, "lp": NaN, "priority_score": 0.24635850178359098}]</data>
