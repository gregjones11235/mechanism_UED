092715231786, "eat_plant": 5.298013245033113, "defeat_skeleton": 18.543046357615893, "make_stone_pickaxe": 33.99558498896247, "make_stone_sword": 100.0, "wake_up": 92.71523178807946, "place_furnace": 37.086092715231786, "collect_coal": 64.23841059602648, "collect_iron": 54.746136865342166, "collect_diamond": 25.386313465783665, "make_iron_pickaxe": 18.101545253863133, "make_arrow": 66.88741721854305, "make_torch": 92.49448123620309, "place_torch": 88.96247240618102, "collect_sapphire": 26.71081677704194, "collect_ruby": 23.620309050772626, "make_diamond_pickaxe": 3.752759381898455, "make_diamond_sword": 2.6490066225165565, "enter_gnomish_mines": 49.22737306843267, "enter_dungeon": 100.0, "defeat_orc_solider": 98.23399558498896, "defeat_orc_mage": 87.63796909492274, "eat_snail": 96.46799116997792, "find_bow": 100.0, "fire_bow": 65.34216335540839, "open_chest": 100.0, "drink_potion": 79.91169977924945}, "average_episode_length": 619.9558498896247, "mean_return_percentage": 18.40139719654125, "mean_return": 41.58715766418322, "lp": NaN, "priority_score": 0.24994030476246165}, {"session": 101, "sr": 0.3333333333333333, "achievement_srs": {"collect_wood": 38.888888888888886, "place_table": 36.342592592592595, "eat_cow": 44.44444444444444, "collect_sapling": 40.0462962962963, "collect_drink": 85.64814814814815, "make_wood_pickaxe": 50.23148148148148, "make_wood_sword": 100.0, "place_plant": 40.0462962962963, "defeat_zombie": 24.305555555555557, "collect_stone": 40.27777777777778, "place_stone": 39.120370370370374, "eat_plant": 8.333333333333334, "defeat_skeleton": 24.305555555555557, "make_stone_pickaxe": 35.879629629629626, "make_stone_sword": 100.0, "wake_up": 89.12037037037037, "place_furnace": 38.425925925925924, "collect_coal": 57.175925925925924, "collect_iron": 54.166666666666664, "collect_diamond": 24.76851851851852, "make_iron_pickaxe": 20.833333333333332, "make_arrow": 68.75, "make_torch": 88.6574074074074, "place_torch": 87.5, "collect_sapphire": 23.84259259259259, "collect_ruby": 21.296296296296298, "make_diamond_pickaxe": 1.8518518518518519, "make_diamond_sword": 1.3888888888888888, "enter_gnomish_mines": 33.333333333333336, "enter_dungeon": 100.0, "defeat_orc_solider": 96.06481481481481, "defeat_orc_mage": 78.70370370370371, "eat_snail": 95.60185185185185, "find_bow": 98.8425925925926, "fire_bow": 67.12962962962963, "open_chest": 98.8425925925926, "drink_potion": 77.08333333333333}, "average_episode_length": 632.5439814814815, "mean_return_percentage": 16.49155118198951, "mean_return": 37.2709056712963, "lp": NaN, "priority_score": 0.22222222222222224}]</data>
