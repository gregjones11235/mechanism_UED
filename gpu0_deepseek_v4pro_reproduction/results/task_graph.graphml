      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Train the agent to survive and fight in the pitch‑dark Gnomish Mines, defeat a small group of gnomes, and descend to the Sewers.

Description: The episode begins on floor 2 (Gnomish Mines) with the player already equipped and supplied for immediate combat and navigation. The floor is generated by the default “SmoothGen” process – a mix of path, stone, stalagmites, lava pools, and ores – and is completely dark (light level 0). The ladder from floor 1 is cleared (`monsters_killed[1] = 8`) and the player’s inventory includes an iron sword, iron pickaxe, bow, 30 arrows, 30 torches, 30 wood, 20 stone, and 15 coal. Health, food, drink, and energy start full; Strength = 2 and Dexterity = 2 provide a modest combat boost. No consumable potions or extra food are given, but survival mechanics are relaxed (`needs_depletion_multiplier = 0.5`). The goal is to defeat **4** hostile mobs (Gnome Warriors and Gnome Archers spawn as usual on this floor) to clear the level, then step on the naturally generated `LADDER_DOWN` and use `DESCEND` to reach floor 3. Success triggers `ENTER_SEWERS` and terminates the episode. The agent is free to collect additional resources, place torches, or craft more arrows, but the initial supplies should suffice for the fight.

Relevant Achievements: ENTER_SEWERS
Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_STONE_PICKAXE, MAKE_IRON_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_SWORD, MAKE_IRON_SWORD, FIND_BOW, ENTER_DUNGEON, ENTER_GNOMISH_MINES

World:
- Player:
  - Starting floor = 2.
  - Inventory: `{"pickaxe": 3, "sword": 3, "bow": 1, "wood": 30, "stone": 20, "coal": 15, "torch": 30, "arrows": 30}`.
  - Stats: `dexterity=2, strength=2, intelligence=1`.
  - `set_monsters_killed(level=0, count=8)` and `set_monsters_killed(level=1, count=8)` to pre‑clear earlier floors.
- Map:
  - No additional block placements; the Gnomish Mines use the default generation with all standard features (ladder down, ores, stalagmites, lava).
- Mechanics:
  - `melee_spawn_multiplier = 1.0`
  - `ranged_spawn_multiplier = 1.0`
  - `passive_spawn_multiplier = 1.0`
  - `mob_health_multiplier = 0.8`
  - `mob_damage_multiplier = 0.9`
  - `melee_trigger_distance = 10`
  - `monsters_killed_to_clear_level = 4`
  - `needs_depletion_multiplier = 0.5`
  - `health_recover_multiplier = 1.0`
  - `health_loss_multiplier = 1.0`
  - `mana_recover_multiplier = 1.0`
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_SEWERS,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_IRON_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_IRON_SWORD,
            Achievement.FIND_BOW,
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.label = "ENTER_SEWERS"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            mob_health_multiplier=0.8,
            mob_damage_multiplier=0.9,
            melee_trigger_distance=10,
            monsters_killed_to_clear_level=4,
            needs_depletion_multiplier=0.5,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines)
        builder.set_starting_floor(2)

        # Equip inventory and set attributes
        builder.set_player_inventory({
            "pickaxe": 3,   # iron pickaxe
            "sword": 3,     # iron sword
            "bow": 1,       # bow present
            "wood": 30,
            "stone": 20,
            "coal": 15,
            "torches": 30,
            "arrows": 30,
        })
        builder.set_player_stats(dexterity=2, strength=2, intelligence=1)

        # Pre-clear floors 0 and 1 so that ladders are open
        builder.set_monsters_killed(level=0, count=8)
        builder.set_monsters_killed(level=1, count=8)

        # No custom block or mob placement; default world generation for floor 2
        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
