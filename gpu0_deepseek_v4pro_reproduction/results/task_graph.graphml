      <data key="d2">Objective: Practice the iron‑tool crafting bottleneck and the dungeon entrance sequence, with early‑game prerequisites already satisfied, to drive up global iron pickaxe reliability and Gnomish Mines entry.

Description: The agent begins on floor 0 with a stone pickaxe, some wood, stone, and torches. A crafting table and a furnace are already placed next to the spawn, and a small water pool provides drinking water. Its task is to locally mine coal and iron, craft an iron pickaxe, then descend to the dungeon (floor 1), kill exactly 8 hostile orcs (soldiers and mages), and use the ladder down to enter the Gnomish Mines (floor 2). Survival needs accumulate at half the normal speed (`needs_depletion_multiplier = 0.5`) to keep pressure manageable while focusing on the iron/combat chain.

Relevant Achievements: MAKE_IRON_PICKAXE, ENTER_GNOMISH_MINES
Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_STONE_PICKAXE, PLACE_TABLE, PLACE_FURNACE

World:
- Player: `set_starting_floor(0)`. Inventory: `{"pickaxe": 2, "wood": 10, "stone": 5, "torch": 4}`. All attributes default (1/1/1).
- Map:
  - `builder.place_randomly_near(rng, 0, BlockType.CRAFTING_TABLE, player_spawn, 1, 2, 1, [BlockType.GRASS])`
  - `builder.place_randomly_near(rng, 0, BlockType.FURNACE, player_spawn, 1, 3, 1, [BlockType.GRASS])`
  - `builder.place_randomly_near(rng, 0, BlockType.WATER, player_spawn, 2, 3, 4, [BlockType.GRASS])`  (ensures easy access to water)
  - No other block modifications; standard procedural generation for ores, trees, and mobs.
- Mechanics:
  - `monsters_killed_to_clear_level = 8`
  - `needs_depletion_multiplier = 0.5`
  - All other `TaskParams` at default values (mob health/damage/spawn multipliers = 1.0).</data>
      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Practice the iron‑tool crafting bottleneck and the dungeon entrance sequence, with early‑game prerequisites already satisfied, to drive up global iron pickaxe reliability and Gnomish Mines entry.

Description: The agent begins on floor 0 with a stone pickaxe, some wood, stone, and torches. A crafting table and a furnace are already placed next to the spawn, and a small water pool provides drinking water. Its task is to locally mine coal and iron, craft an iron pickaxe, then descend to the dungeon (floor 1), kill exactly 8 hostile orcs (soldiers and mages), and use the ladder down to enter the Gnomish Mines (floor 2). Survival needs accumulate at half the normal speed (`needs_depletion_multiplier = 0.5`) to keep pressure manageable while focusing on the iron/combat chain.

Relevant Achievements: MAKE_IRON_PICKAXE, ENTER_GNOMISH_MINES
Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_STONE_PICKAXE, PLACE_TABLE, PLACE_FURNACE

World:
- Player: `set_starting_floor(0)`. Inventory: `{"pickaxe": 2, "wood": 10, "stone": 5, "torch": 4}`. All attributes default (1/1/1).
- Map:
  - `builder.place_randomly_near(rng, 0, BlockType.CRAFTING_TABLE, player_spawn, 1, 2, 1, [BlockType.GRASS])`
  - `builder.place_randomly_near(rng, 0, BlockType.FURNACE, player_spawn, 1, 3, 1, [BlockType.GRASS])`
  - `builder.place_randomly_near(rng, 0, BlockType.WATER, player_spawn, 2, 3, 4, [BlockType.GRASS])`  (ensures easy access to water)
  - No other block modifications; standard procedural generation for ores, trees, and mobs.
- Mechanics:
  - `monsters_killed_to_clear_level = 8`
  - `needs_depletion_multiplier = 0.5`
  - All other `TaskParams` at default values (mob health/damage/spawn multipliers = 1.0).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.MAKE_IRON_PICKAXE,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.PLACE_TABLE,
            Achievement.PLACE_FURNACE,
        ]
        self.label = "MAKE_IRON_PICKAXE, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.5,
            monsters_killed_to_clear_level=8,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, block_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld)
        builder.set_starting_floor(0)

        # Equip starting inventory
        builder.set_player_inventory({
            "pickaxe": 2,   # stone pickaxe
            "wood": 10,
            "stone": 5,
            "torches": 4,
        })

        # Player spawn position after set_starting_floor
        spawn_pos = builder.player_position

        # Place crafting table within Manhattan distance 1-2
        rng, table_rng = jax.random.split(block_rng)
        builder.place_randomly_near(
            table_rng,
            level=0,
            block_type=BlockType.CRAFTING_TABLE,
            target_pos=spawn_pos,
            min_dist=1,
            max_dist=2,
            n=1,
            on_blocks=[BlockType.GRASS],
        )

        # Place furnace within Manhattan distance 1-3
        rng, furnace_rng = jax.random.split(rng)
        builder.place_randomly_near(
            furnace_rng,
            level=0,
            block_type=BlockType.FURNACE,
            target_pos=spawn_pos,
            min_dist=1,
            max_dist=3,
            n=1,
            on_blocks=[BlockType.GRASS],
        )

        # Place water pool within Manhattan distance 2-3, 4 tiles
        builder.place_randomly_near(
            rng,
            level=0,
            block_type=BlockType.WATER,
            target_pos=spawn_pos,
            min_dist=2,
            max_dist=3,
            n=4,
            on_blocks=[BlockType.GRASS],
        )

        # No other block modifications required; standard world generation

        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
      <data key="d4">[{"session": 127, "sr": 0.3216374269005848, "achievement_srs": {"collect_wood": 100.0, "eat_cow": 74.85380116959064, "collect_sapling": 90.64327485380117, "collect_drink": 98.83040935672514, "make_wood_sword": 98.24561403508773, "place_plant": 89.47368421052632, "defeat_zombie": 63.74269005847953, "collect_stone": 100.0, "place_stone": 99.41520467836257, "eat_plant": 21.637426900584796, "defeat_skeleton": 54.3859649122807, "make_stone_sword": 98.24561403508773, "wake_up": 95.90643274853801, "collect_coal": 94.73684210526316, "collect_iron": 88.30409356725146, "collect_diamond": 32.16374269005848, "make_iron_pickaxe": 54.3859649122807, "make_iron_sword": 57.89473684210526, "make_arrow": 99.41520467836257, "make_torch": 100.0, "place_torch": 100.0, "collect_sapphire": 28.07017543859649, "collect_ruby": 28.65497076023392, "make_diamond_pickaxe": 2.9239766081871346, "make_diamond_sword": 5.2631578947368425, "make_iron_armour": 15.2046783625731, "enter_gnomish_mines": 53.21637426900585, "enter_dungeon": 97.6608187134503, "defeat_orc_solider": 95.32163742690058, "defeat_orc_mage": 90.64327485380117, "eat_bat": 0.5847953216374269, "eat_snail": 96.49122807017544, "find_bow": 97.07602339181287, "fire_bow": 97.07602339181287, "open_chest": 97.07602339181287, "drink_potion": 84.7953216374269}, "average_episode_length": 1568.5497076023391, "mean_return_percentage": 20.652337230486335, "mean_return": 46.67428214089912, "lp": NaN, "priority_score": 0.21818679251735573}]</data>
