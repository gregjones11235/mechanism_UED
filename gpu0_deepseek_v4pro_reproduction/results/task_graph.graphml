e": 19.46564885496183, "make_iron_sword": 49.23664122137404, "make_arrow": 96.18320610687023, "make_torch": 95.41984732824427, "place_torch": 94.27480916030534, "collect_sapphire": 22.900763358778626, "collect_ruby": 25.19083969465649, "make_diamond_pickaxe": 3.435114503816794, "make_diamond_sword": 2.6717557251908395, "make_iron_armour": 3.053435114503817, "enter_gnomish_mines": 60.68702290076336, "enter_dungeon": 94.65648854961832, "defeat_orc_solider": 88.93129770992367, "defeat_orc_mage": 83.58778625954199, "eat_snail": 90.83969465648855, "find_bow": 93.5114503816794, "fire_bow": 90.07633587786259, "open_chest": 93.5114503816794, "drink_potion": 72.13740458015268}, "average_episode_length": 1062.2251908396947, "mean_return_percentage": 25.34811520732706, "mean_return": 57.28674036855916, "lp": NaN, "priority_score": 0.23857875415185595}]</data>
