0, "collect_diamond": 31.875, "make_iron_pickaxe": 20.3125, "make_iron_sword": 25.625, "make_arrow": 81.5625, "place_torch": 100.0, "collect_sapphire": 21.5625, "collect_ruby": 25.3125, "make_diamond_pickaxe": 2.8125, "make_diamond_sword": 2.5, "enter_gnomish_mines": 59.375, "enter_dungeon": 100.0, "defeat_orc_solider": 99.0625, "defeat_orc_mage": 93.125, "eat_snail": 98.75, "find_bow": 99.0625, "fire_bow": 79.6875, "open_chest": 99.0625, "drink_potion": 85.9375}, "average_episode_length": 867.70625, "mean_return_percentage": 20.562023061566652, "mean_return": 46.47017211914063, "lp": NaN, "priority_score": 0.2412109375}, {"session": 120, "sr": 0.6288343558282209, "achievement_srs": {"collect_wood": 53.987730061349694, "place_table": 52.45398773006135, "eat_cow": 62.576687116564415, "collect_sapling": 53.374233128834355, "collect_drink": 92.63803680981596, "make_wood_pickaxe": 60.736196319018404, "make_wood_sword": 100.0, "place_plant": 53.374233128834355, "defeat_zombie": 40.49079754601227, "collect_stone": 51.84049079754601, "place_stone": 51.533742331288344, "eat_plant": 11.656441717791411, "defeat_skeleton": 34.66257668711656, "make_stone_pickaxe": 55.52147239263804, "wake_up": 93.25153374233129, "place_furnace": 50.920245398773005, "collect_coal": 71.16564417177914, "collect_iron": 65.95092024539878, "collect_diamond": 30.67484662576687, "make_iron_pickaxe": 24.846625766871167, "make_iron_sword": 29.754601226993866, "make_arrow": 84.3558282208589, "place_torch": 100.0, "collect_sapphire": 29.141104294478527, "collect_ruby": 23.619631901840492, "make_diamond_pickaxe": 3.6809815950920246, "make_diamond_sword": 4.9079754601226995, "enter_gnomish_mines": 62.88343558282209, "enter_dungeon": 100.0, "defeat_orc_solider": 98.46625766871166, "defeat_orc_mage": 92.02453987730061, "eat_snail": 97.23926380368098, "find_bow": 99.079754601227, "fire_bow": 82.20858895705521, "open_chest": 99.079754601227, "drink_potion": 83.12883435582822}, "average_episode_length": 877.78527