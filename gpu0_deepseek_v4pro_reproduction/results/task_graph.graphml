      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Teach the agent to craft an iron sword and then clear the Dungeon under more realistic combat and survival conditions, while skipping already‑mastered early‑game steps.

Description: The agent starts on Floor 0 (Overworld) with a stone pickaxe and 5 wood, but no other inventory. It must:
1. Place a crafting table using 2 wood.
2. Mine at least 1 stone (pickaxe level 2 required, already met) to place a furnace.
3. Locate and mine at least 1 coal and 1 iron ore.
4. Place the furnace next to the crafting table, then craft an iron sword using the MAKE_IRON_SWORD action (requires 1 wood, 1 stone, 1 iron, 1 coal).
5. Descend to Floor 1 (Dungeon) and defeat at least 7 hostile monsters (orc soldiers and mages) to meet the `monsters_killed_to_clear_level` requirement.
6. While standing on the ladder‑down tile, use DESCEND to enter Floor 2 (Gnomish Mines).

Survival needs deplete at a moderate rate (0.8×) to introduce mild pressure without overwhelming the combat focus. All mob stats and spawn rates remain at default (1.0×). The episode succeeds only when both MAKE_IRON_SWORD and ENTER_GNOMISH_MINES achievements are earned.

Relevant Achievements: MAKE_IRON_SWORD, ENTER_GNOMISH_MINES

Completed Achievements: MAKE_STONE_PICKAXE (the agent starts with a stone pickaxe, so this achievement is implicitly satisfied).

World:
- Player: `builder.set_starting_floor(0)`. `builder.set_player_inventory({"wood": 5, "pickaxe": 2})` (stone pickaxe, level 2).
- Map:
  - `builder.set_monsters_killed(level=1, count=0)` – reset Dungeon kill counter to zero.
  - No other block modifications; all floors use default generation.
- Mechanics:
  - `monsters_killed_to_clear_level = 7`
  - `needs_depletion_multiplier = 0.8`
  - All other TaskParams left at defaults (e.g., `mob_health_multiplier = 1.0`, `mob_damage_multiplier = 1.0`, spawn multipliers = 1.0).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.MAKE_IRON_SWORD,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_STONE_PICKAXE,
        ]
        self.label = "MAKE_IRON_SWORD, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=7,
            needs_depletion_multiplier=0.8,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld) at default centre
        builder.set_starting_floor(0)

        # Equip starting inventory: stone pickaxe (level 2), 5 wood
        builder.set_player_inventory({
            "wood": 5,
            "pickaxe": 2,
        })

        # Reset Dungeon (level 1) kill counter to zero
        builder.set_monsters_killed(level=1, count=0)

        state = builder.build(rng)

        # Mark pre-completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
