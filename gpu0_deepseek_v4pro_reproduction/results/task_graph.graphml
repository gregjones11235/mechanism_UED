      <data key="d3">import jax
import jax.numpy as jnp
from craftax.craftax.constants import Achievement, BlockType, ItemType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn the DESCEND action to enter the dungeon.
    Description: The agent must achieve `ENTER_DUNGEON` by descending from the overworld to floor 1. The player starts on floor 0 with a wooden sword already in hand. All mob spawns (passive, melee, ranged) are disabled to eliminate combat and reduce distractions. A ladder‑down block is placed on floor 0 within a Manhattan distance of 3 to 6 tiles from the player’s starting center (position (24,24)). No other world modifications are made. Survival needs are kept at default depletion and regeneration rates. The episode ends successfully as soon as the agent descends.
    Relevant Achievements: ENTER_DUNGEON
    Completed Achievements: MAKE_WOOD_SWORD
    World:
    - Player: Floor 0; inventory contains a wooden sword (`{"sword": 1}`).
    - Map: Place one ladder‑down block (`BlockType.LADDER_DOWN`) on floor 0 using `place_randomly_near` with target position (24,24), min_dist=3, max_dist=6, n=1, on_blocks=[BlockType.GRASS]. No mobs are added.
    - Mechanics:
        "passive_spawn_multiplier": 0.0,
        "melee_spawn_multiplier": 0.0,
        "ranged_spawn_multiplier": 0.0,
        "needs_depletion_multiplier": 1.0,
        "health_recover_multiplier": 1.0,
        "health_loss_multiplier": 1.0,
        "mana_recover_multiplier": 1.0
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_DUNGEON]
        self.completed_achievements = [Achievement.MAKE_WOOD_SWORD]
        self.label = "ENTER_DUNGEON"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=0.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            needs_depletion_multiplier=1.0,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, ladder_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(0)
        builder.set_player_inventory({"sword": 1})  # wooden sword

        state = builder.build(build_rng)

        # Place a LADDER_DOWN item on floor 0 within 3-6 Manhattan tiles of (24,24),
        # only on grass blocks.
        player_pos = jnp.array([24, 24], dtype=jnp.int32)
        min_dist, max_dist = 3, 6
        map_size = self.static_params.map_size

        rows, cols = jnp.indices(map_size)
        dist = jnp.abs(rows - player_pos[0]) + jnp.abs(cols - player_pos[1])

        floor_map = state.map[0]
        grass_mask = floor_map == BlockType.GRASS.value
        distance_mask = (dist &gt;= min_dist) &amp; (dist &lt;= max_dist)
        valid_mask = grass_mask &amp; distance_mask

        # Randomly choose a valid position
        valid_flat = valid_mask.flatten()
        probs = valid_flat / valid_flat.sum()
        chosen_idx = jax.random.choice(ladder_rng, jnp.arange(valid_flat.shape[0]), p=probs)
        row = chosen_idx // map_size[1]
        col = chosen_idx % map_size[1]

        item_map = state.item_map.at[0, row, col].set(ItemType.LADDER_DOWN.value)
        state = state.replace(item_map=item_map)

        return state</data>
