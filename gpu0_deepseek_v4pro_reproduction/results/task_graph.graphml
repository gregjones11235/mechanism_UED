iron_pickaxe": 25.0, "make_iron_sword": 29.761904761904763, "make_arrow": 63.095238095238095, "make_torch": 80.95238095238095, "place_torch": 79.16666666666667, "collect_sapphire": 25.595238095238095, "collect_ruby": 23.214285714285715, "make_diamond_pickaxe": 3.5714285714285716, "make_diamond_sword": 5.357142857142857, "make_diamond_armour": 0.5952380952380952, "enter_dungeon": 100.0, "defeat_orc_solider": 70.23809523809524, "defeat_orc_mage": 36.30952380952381, "eat_snail": 81.54761904761905, "find_bow": 93.45238095238095, "fire_bow": 63.095238095238095, "open_chest": 93.45238095238095, "drink_potion": 64.28571428571429}, "average_episode_length": 2367.845238095238, "mean_return_percentage": 14.531450878453567, "mean_return": 32.84107898530506, "lp": NaN, "priority_score": 0.2014951814058957}, {"session": 45, "sr": 0.2389937106918239, "achievement_srs": {"collect_wood": 37.735849056603776, "place_table": 35.84905660377358, "eat_cow": 51.57232704402516, "collect_sapling": 31.446540880503143, "collect_drink": 80.50314465408805, "place_plant": 31.446540880503143, "collect_stone": 39.62264150943396, "place_stone": 39.62264150943396, "eat_plant": 18.867924528301888, "make_stone_pickaxe": 31.446540880503143, "wake_up": 67.29559748427673, "place_furnace": 37.106918238993714, "collect_coal": 64.15094339622641, "collect_iron": 57.23270440251572, "collect_diamond": 30.18867924528302, "make_iron_pickaxe": 20.754716981132077, "make_iron_sword": 16.352201257861637, "make_arrow": 68.55345911949685, "make_torch": 82.38993710691824, "place_torch": 81.13207547169812, "collect_sapphire": 28.30188679245283, "collect_ruby": 28.930817610062892, "make_diamond_pickaxe": 6.918238993710692, "make_diamond_sword": 5.031446540880503, "make_diamond_armour": 0.6289308176100629, "enter_dungeon": 100.0, "defeat_orc_solider": 71.06918238993711, "defeat_orc_mage": 34.59119496855346, "eat_snail": 89.30817610062893, "find_bow": 95.59748427672956, "fire_bow": 67.9245283018868, "open_chest": 95.597484