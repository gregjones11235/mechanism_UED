      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Survive the pitch‑black Gnomish Mines and kill enough gnomes to unlock the descent into the Sewers.

Description: The agent starts on Floor 2 (Gnomish Mines) with a stone sword, bow, 10 arrows, and 5 torches, mimicking an adventurer who has already cleared the Dungeon and crafted basic weapons. The world uses the default SmoothGen terrain for floor 2, featuring stalagmites, ores, and total darkness (light level 0.0). One Gnome Warrior (melee, type_id=1) and one Gnome Archer (ranged, type_id=1) are placed 3–7 tiles from the player’s spawn, forcing immediate combat. Survival needs deplete at half the normal rate (0.5×) to introduce mild time pressure without overwhelming the combat learning. Melee and ranged spawn multipliers are both 0.5, ensuring a moderate but steady stream of additional gnomes. The floor‑clear requirement is 8 kills, matching the original Craftax value. The agent must explore, place torches to see, manage health and arrows, and defeat the required enemies to unlock the ladder down to the Sewers (floor 3).

Relevant Achievements: ENTER_SEWERS
Completed Achievements: FIND_BOW, MAKE_WOOD_SWORD, MAKE_STONE_SWORD, MAKE_ARROW, ENTER_DUNGEON, ENTER_GNOMISH_MINES

World:
- Player: Floor 2 (spawn at the ladder‑up position, which is (22, 42) for SmoothGen floor 2). Inventory: {"sword": 2, "bow": 1, "arrows": 10, "torches": 5}. Stats: Strength 1, Dexterity 1, Intelligence 1. Health/Food/Drink/Energy/Mana all full (9/9). Learned spells: none. Weapon/Armour enchantments: none.
- Map:
    - Default SmoothGen generation for Floor 2.
    - Place one melee mob (Gnome Warrior, "melee", type_id=1) using `add_mobs_randomly_near` with `target_pos = (22, 42)`, `n=1`, `min_dist=3`, `max_dist=7`, `on_blocks=[BlockType.PATH, BlockType.GRASS]`.
    - Place one ranged mob (Gnome Archer, "ranged", type_id=1) using `add_mobs_randomly_near` with `target_pos = (22, 42)`, `n=1`, `min_dist=3`, `max_dist=7`, `on_blocks=[BlockType.PATH, BlockType.GRASS]`.
    - No other mobs placed initially; spawning handles additional enemies.
- Mechanics:
    "needs_depletion_multiplier": 0.5,
    "melee_spawn_multiplier": 0.5,
    "ranged_spawn_multiplier": 0.5,
    "passive_spawn_multiplier": 0.0,
    "monsters_killed_to_clear_level": 8,
    "health_recover_multiplier": 1.0,
    "health_loss_multiplier": 1.0,
    "mob_health_multiplier": 1.0,
    "mob_damage_multiplier": 1.0
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_SEWERS,
        ]
        self.completed_achievements = [
            Achievement.FIND_BOW,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_ARROW,
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.label = "ENTER_SEWERS"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.5,
            melee_spawn_multiplier=0.5,
            ranged_spawn_multiplier=0.5,
            passive_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=8,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, melee_rng, ranged_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines) at the up-ladder position
        builder.set_starting_floor(2)

        # Equip starting inventory: stone sword, bow, arrows, torches
        builder.set_player_inventory({
            "sword": 2,     # Stone sword (tier 2)
            "bow": 1,
            "arrows": 10,
            "torches": 5,
        })

        # Spawn point is the up-ladder on floor 2
        spawn_pos = builder.ladders_up[2]

        # Place one Gnome Warrior (melee, type_id=1) within Manhattan distance 3-7
        builder.add_mobs_randomly_near(
            melee_rng,
            level=2,
            mob_name="melee",
            type_id=1,
            n=1,
            target_pos=spawn_pos,
            min_dist=3,
            max_dist=7,
            on_blocks=[BlockType.PATH, BlockType.GRASS],
        )

        # Place one Gnome Archer (ranged, type_id=1) within Manhattan distance 3-7
        builder.add_mobs_randomly_near(
            ranged_rng,
            level=2,
            mob_name="ranged",
            type_id=1,
            n=1,
            target_pos=spawn_pos,
            min_dist=3,
            max_dist=7,
            on_blocks=[BlockType.PATH, BlockType.GRASS],
        )

        # Build the initial state
        state = builder.build(rng)

        # Mark pre-completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
