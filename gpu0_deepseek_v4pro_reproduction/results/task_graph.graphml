on_pickaxe": 3.998699609882965, "make_iron_sword": 4.0962288686605985, "make_arrow": 31.729518855656696, "place_torch": 97.2366710013004, "collect_sapphire": 9.29778933680104, "collect_ruby": 9.817945383615085, "make_diamond_pickaxe": 1.2028608582574774, "make_diamond_sword": 1.6905071521456436, "enter_dungeon": 100.0, "defeat_orc_solider": 92.3927178153446, "find_bow": 99.34980494148245, "fire_bow": 31.599479843953187, "open_chest": 99.34980494148245, "drink_potion": 30.754226267880362}, "average_episode_length": 89.99642392717816, "mean_return_percentage": 13.947181855745882, "mean_return": 31.520630993985694, "lp": NaN, "priority_score": 0.07028574762285641}]</data>
