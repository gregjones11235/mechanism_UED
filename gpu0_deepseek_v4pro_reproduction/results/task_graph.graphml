.27007299270073, "drink_potion": 81.75182481751825}, "average_episode_length": 1018.1861313868613, "mean_return_percentage": 21.355764727730765, "mean_return": 48.26402828467153, "lp": NaN, "priority_score": 0.24519153924023657}, {"session": 126, "sr": 0.5543859649122806, "achievement_srs": {"eat_cow": 74.3859649122807, "collect_sapling": 80.70175438596492, "collect_drink": 95.43859649122807, "make_wood_sword": 100.0, "place_plant": 80.35087719298245, "defeat_zombie": 44.21052631578947, "place_stone": 83.15789473684211, "eat_plant": 15.43859649122807, "defeat_skeleton": 44.56140350877193, "make_stone_pickaxe": 67.01754385964912, "wake_up": 96.49122807017544, "place_furnace": 83.50877192982456, "collect_coal": 81.40350877192982, "collect_iron": 67.36842105263158, "collect_diamond": 29.12280701754386, "make_iron_pickaxe": 19.29824561403509, "make_iron_sword": 29.82456140350877, "make_arrow": 90.52631578947368, "make_torch": 86.3157894736842, "place_torch": 84.56140350877193, "collect_sapphire": 31.57894736842105, "collect_ruby": 21.75438596491228, "make_diamond_pickaxe": 3.1578947368421053, "make_diamond_sword": 3.8596491228070176, "enter_gnomish_mines": 55.43859649122807, "enter_dungeon": 100.0, "defeat_orc_solider": 95.43859649122807, "defeat_orc_mage": 84.56140350877193, "eat_snail": 96.49122807017544, "find_bow": 98.94736842105263, "fire_bow": 90.17543859649123, "open_chest": 98.94736842105263, "drink_potion": 77.54385964912281}, "average_episode_length": 1002.0385964912281, "mean_return_percentage": 20.327822373272785, "mean_return": 45.94087856359649, "lp": NaN, "priority_score": 0.24704216682056018}]</data>
