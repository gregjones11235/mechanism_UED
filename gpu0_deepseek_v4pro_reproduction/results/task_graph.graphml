ce": 33.980582524271846, "collect_coal": 50.48543689320388, "collect_iron": 44.1747572815534, "collect_diamond": 20.388349514563107, "make_iron_pickaxe": 11.16504854368932, "make_iron_sword": 16.50485436893204, "make_arrow": 55.8252427184466, "make_torch": 74.27184466019418, "place_torch": 73.7864077669903, "collect_sapphire": 18.446601941747574, "collect_ruby": 17.961165048543688, "make_diamond_pickaxe": 1.4563106796116505, "make_diamond_sword": 2.912621359223301, "enter_dungeon": 100.0, "defeat_orc_solider": 68.44660194174757, "defeat_orc_mage": 44.66019417475728, "find_bow": 97.57281553398059, "fire_bow": 54.85436893203884, "open_chest": 97.57281553398059, "drink_potion": 62.13592233009709}, "average_episode_length": 1916.7378640776699, "mean_return_percentage": 13.17488657812634, "mean_return": 29.775243666565533, "lp": NaN, "priority_score": 0.23859458949948154}, {"session": 52, "sr": 0.21481481481481482, "achievement_srs": {"collect_wood": 48.888888888888886, "place_table": 48.888888888888886, "collect_sapling": 48.888888888888886, "collect_drink": 66.66666666666667, "make_wood_pickaxe": 54.81481481481482, "make_wood_sword": 60.0, "place_plant": 48.888888888888886, "collect_stone": 48.148148148148145, "place_stone": 48.148148148148145, "eat_plant": 33.333333333333336, "make_stone_pickaxe": 49.629629629629626, "make_stone_sword": 54.81481481481482, "wake_up": 24.444444444444443, "place_furnace": 47.407407407407405, "collect_coal": 70.37037037037037, "collect_iron": 67.4074074074074, "collect_diamond": 33.333333333333336, "make_iron_pickaxe": 34.074074074074076, "make_iron_sword": 37.03703703703704, "make_arrow": 71.11111111111111, "make_torch": 87.4074074074074, "place_torch": 84.44444444444444, "collect_sapphire": 25.925925925925927, "collect_ruby": 25.925925925925927, "make_diamond_pickaxe": 2.962962962962963, "make_diamond_sword": 0.7407407407407407, "enter_dungeon": 100.0, "defeat_orc_solider": 57.03703703703704, "defeat_orc_mage": 27.40740740740741, "find_