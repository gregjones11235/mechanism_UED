      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Defeat an Orc Soldier in the Dungeon.

    Description: The player must kill a single Orc Soldier (melee mob, type_id=2) on floor 1 (Dungeon). The episode begins on floor 1 with an iron sword in inventory. No other mobs are present; all mob spawning is disabled. Survival needs (hunger, thirst, fatigue) are completely turned off so the focus remains entirely on combat. The Orc Soldier is placed at a random Manhattan distance between 4 and 8 tiles from the player’s starting position. As soon as the Orc Soldier is defeated, the `DEFEAT_ORC_SOLIDER` achievement is earned and the episode ends successfully. All other game mechanics remain at default values.

    Relevant Achievements: DEFEAT_ORC_SOLIDER
    Completed Achievements: ENTER_DUNGEON, MAKE_IRON_SWORD

    World:
    - Player: Start on floor 1. Inventory contains an iron sword (`{"sword": 3}`).
    - Map: Place exactly one melee mob `"melee"` with `type_id=2` (Orc Soldier) on floor 1 using `add_mobs_randomly_near` with `target_pos` = player start position, `min_dist=4`, `max_dist=8`, `n=1`, `on_blocks=[BlockType.PATH, BlockType.GRASS]`. No other mob additions.
    - Mechanics: `passive_spawn_multiplier = 0.0`, `melee_spawn_multiplier = 0.0`, `ranged_spawn_multiplier = 0.0`, `needs_depletion_multiplier = 0.0`. All other `TaskParams` at defaults.
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.DEFEAT_ORC_SOLIDER]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.MAKE_IRON_SWORD,
        ]
        self.label = "DEFEAT_ORC_SOLIDER"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=0.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            needs_depletion_multiplier=0.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, mob_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(1)
        builder.set_player_inventory({"sword": 3})  # Iron sword

        # Place the Orc Soldier (type_id=2) on floor 1
        builder.add_mobs_randomly_near(
            mob_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=1,
            target_pos=builder.player_position,
            min_dist=4,
            max_dist=8,
            on_blocks=[BlockType.PATH, BlockType.GRASS],
        )

        return builder.build(rng)</data>
