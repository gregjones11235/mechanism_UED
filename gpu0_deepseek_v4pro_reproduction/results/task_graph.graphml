      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Clear the dungeon by defeating two Orc guards while managing mild thirst and hunger, then descend to the Gnomish Mines.

Description: The agent starts on Floor 1 (Dungeon) at the ladder‑up arrival point, equipped with a stone sword, a bow, 10 arrows, and 4 torches. Survival needs are enabled at a low rate (`needs_depletion_multiplier = 0.3`) so hunger and thirst accumulate slowly; health regeneration is moderately boosted (`health_recover_multiplier = 2.0`). Natural hostile spawns continue to be suppressed (`melee_spawn_multiplier = 0.0`, `ranged_spawn_multiplier = 0.0`), but passive mobs are allowed to spawn at a low rate (`passive_spawn_multiplier = 0.3`)—on this floor this produces snails that the agent can kill and eat. The only hostile entities are two specifically placed Orcs: one Orc Soldier (`mob_name = "melee"`, `type_id = 2`) and one Orc Mage (`mob_name = "ranged"`, `type_id = 2`), both placed on walkable dungeon tiles (`BlockType.PATH`) within Manhattan distance 4–10 of the player’s start using `add_mobs_randomly_near`. The task‑level kill requirement remains `monsters_killed_to_clear_level = 2`. To succeed, the agent must kill both Orcs (unlocking the ladder down) and then descend to Floor 2, triggering the `ENTER_GNOMISH_MINES` achievement. The standard Dungeon features (rooms, corridors, chests, fountains, torches) are unchanged.

Relevant Achievements: DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, ENTER_GNOMISH_MINES
Completed Achievements: ENTER_DUNGEON, MAKE_STONE_SWORD, FIND_BOW
World:
- Player: Starting floor 1; inventory: `{"sword": 2, "bow": 1, "arrows": 10, "torches": 4}`. All survival stats (food, drink, energy, health, mana) start at maximum (9/9). Other stats default.
- Map: On Floor 1, place one melee Orc Soldier using `add_mobs_randomly_near(rng, 1, "melee", 2, 1, None, 4, 10, [BlockType.PATH])` and one ranged Orc Mage using `add_mobs_randomly_near(rng, 1, "ranged", 2, 1, None, 4, 10, [BlockType.PATH])`. No other block modifications.
- Mechanics: 
    "needs_depletion_multiplier": 0.3,
    "health_recover_multiplier": 2.0,
    "melee_spawn_multiplier": 0.0,
    "ranged_spawn_multiplier": 0.0,
    "passive_spawn_multiplier": 0.3,
    "monsters_killed_to_clear_level": 2
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.DEFEAT_ORC_SOLIDER,
            Achievement.DEFEAT_ORC_MAGE,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.MAKE_STONE_SWORD,
            Achievement.FIND_BOW,
        ]
        self.label = "DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.3,
            health_recover_multiplier=2.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            passive_spawn_multiplier=0.3,
            monsters_killed_to_clear_level=2,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, soldier_rng, mage_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)
        builder.set_starting_floor(1)

        # Equip starting gear: stone sword (2), bow (1), arrows (10), torches (4)
        builder.set_player_inventory({
            "sword": 2,
            "bow": 1,
            "arrows": 10,
            "torches": 4,
        })

        # Place Orc Soldier (melee, type_id=2) near spawn
        builder.add_mobs_randomly_near(
            soldier_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=1,
            target_pos=builder.player_position,
            min_dist=4,
            max_dist=10,
            on_blocks=[BlockType.PATH],
        )

        # Place Orc Mage (ranged, type_id=2) near spawn
        builder.add_mobs_randomly_near(
            mage_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=1,
            target_pos=builder.player_position,
            min_dist=4,
            max_dist=10,
            on_blocks=[BlockType.PATH],
        )

        return builder.build(rng)</data>
