one_sword": 97.41379310344827, "wake_up": 99.56896551724138, "place_furnace": 100.0, "collect_coal": 100.0, "collect_iron": 74.13793103448276, "collect_diamond": 26.29310344827586, "make_iron_pickaxe": 25.0, "make_iron_sword": 46.98275862068966, "make_arrow": 100.0, "make_torch": 98.27586206896552, "place_torch": 98.27586206896552, "collect_sapphire": 29.310344827586206, "collect_ruby": 28.448275862068964, "make_diamond_pickaxe": 3.4482758620689653, "make_diamond_sword": 5.172413793103448, "make_iron_armour": 2.586206896551724, "enter_gnomish_mines": 60.775862068965516, "enter_dungeon": 97.41379310344827, "defeat_orc_solider": 93.10344827586206, "defeat_orc_mage": 87.93103448275862, "eat_snail": 95.25862068965517, "find_bow": 96.12068965517241, "fire_bow": 96.12068965517241, "open_chest": 96.12068965517241, "drink_potion": 80.17241379310344}, "average_episode_length": 1230.176724137931, "mean_return_percentage": 23.755584986863937, "mean_return": 53.6876220703125, "lp": NaN, "priority_score": 0.23838807966706302}]</data>
