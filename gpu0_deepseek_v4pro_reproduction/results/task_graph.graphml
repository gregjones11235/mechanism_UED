      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Solidity the iron‑sword crafting pipeline by guaranteeing easy access to iron and coal; then clear the dungeon and descend to the Gnomish Mines just as before.

Description: The agent begins on floor 0 with an empty inventory and very slow survival needs (0.2×). A crafting table is pre‑placed directly south of the spawn point. To prevent the agent from being stymied by random ore distribution, 8 coal blocks and 6 iron blocks are placed within a Manhattan distance of 3–8 tiles from the player’s starting position, exclusively on Stone tiles (so they are mineable with the correct pickaxe). The agent must gather wood to make a wood pickaxe, mine stone to upgrade to a stone pickaxe, then mine the nearby coal and iron. It must place a furnace and craft an iron sword (using 1 wood, 1 stone, 1 iron, 1 coal). After arming itself, the agent must locate the Dungeon on floor 1, defeat exactly 8 hostile orc enemies (soldiers or mages) to satisfy the level‑clear requirement, stand on the ladder down, and execute the DESCEND action to enter floor 2 (the Gnomish Mines). All other world generation, mob behaviour, and combat parameters remain at their default values to preserve transferability to the full game.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: []

World:
- Player: `set_starting_floor(0)`. Inventory: `{}` (fully empty). All attributes default (Strength/Dexterity/Intelligence = 1, full health/mana/energy/food/drink).
- Map:
  - `place_block(0, BlockType.CRAFTING_TABLE, (player_start_row + 1, player_start_col))` – a crafting table directly south of spawn.
  - `place_randomly_near(rng, 0, BlockType.COAL, player_start_pos, min_dist=3, max_dist=8, n=8, on_blocks=[BlockType.STONE])` – 8 coal blocks within a 3‑8 tile ring of the spawn, on stone.
  - `place_randomly_near(rng, 0, BlockType.IRON, player_start_pos, min_dist=3, max_dist=8, n=6, on_blocks=[BlockType.STONE])` – 6 iron blocks in the same ring.
  - `set_monsters_killed(level=1, count=0)` – ensure the Dungeon starts uncleared (8 kills required).
  - No other manual block placements; other ores, trees, water, etc. procedurally generated as in the normal Overworld.
- Mechanics:
  - monsters_killed_to_clear_level = 8
  - mob_health_multiplier = 1.0
  - mob_damage_multiplier = 1.0
  - melee_spawn_multiplier = 1.0
  - ranged_spawn_multiplier = 1.0
  - passive_spawn_multiplier = 1.0
  - needs_depletion_multiplier = 0.2
  - health_recover_multiplier = 1.0
  - health_loss_multiplier = 1.0
  - mana_recover_multiplier = 1.0
  - growing_plants_age = 600
  - All other parameters left at default.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = []   # No pre-completed achievements
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.2,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, coal_rng, iron_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld) at default centre
        builder.set_starting_floor(0)

        # Player's spawn coordinate
        player_start = builder.player_position

        # Place a crafting table directly south of the spawn
        builder.place_block(
            0,
            BlockType.CRAFTING_TABLE,
            (player_start[0] + 1, player_start[1])
        )

        # Place 8 coal ores near the start, on Stone blocks
        builder.place_randomly_near(
            coal_rng,
            level=0,
            block_type=BlockType.COAL,
            target_pos=player_start,
            min_dist=3,
            max_dist=8,
            n=8,
            on_blocks=[BlockType.STONE],
        )

        # Place 6 iron ores near the start, on Stone blocks
        builder.place_randomly_near(
            iron_rng,
            level=0,
            block_type=BlockType.IRON,
            target_pos=player_start,
            min_dist=3,
            max_dist=8,
            n=6,
            on_blocks=[BlockType.STONE],
        )

        # Reset Dungeon (level 1) kill counter to zero, so 8 kills are required
        builder.set_monsters_killed(level=1, count=0)

        state = builder.build(rng)

        # No achievements are pre-completed, so return the state as-is
        return state</data>
