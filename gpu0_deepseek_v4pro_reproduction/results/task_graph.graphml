      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Manage survival needs (hunger, thirst, fatigue) while defeating a few Orc enemies and descending to the Gnomish Mines.

Description: The agent begins on floor 1 (the Dungeon) with the same inventory as the parent task: iron sword, stone pickaxe, bow, 10 arrows, 5 torches, 3 wood, and 3 stone. All hostile and passive mob spawning is disabled (melee, ranged, passive multipliers = 0.0), but survival needs are now enabled at **half speed** (`needs_depletion_multiplier = 0.5`). The three Orc Soldiers (melee, mob_name "Orc Soldier", type_id=2) and two Orc Mages (ranged, mob_name "Orc Mage", type_id=2) remain randomly placed within Manhattan distance 5–10 from the player start. To provide a food source, three Snails (passive, mob_name "Snail", type_id=2) are placed randomly within 5–10 Manhattan distance of the player start, on passable ground (any non‑solid block). The floor clear requirement remains lowered (`monsters_killed_to_clear_level = 3`). The agent must kill at least 3 enemies to unlock the ladder down, then step onto a `ladder_down` tile and execute DESCEND to reach floor 2. The episode succeeds when the achievement `ENTER_GNOMISH_MINES` is earned. The natural hunger, thirst, and fatigue accumulation (at half rate) will require the agent to eat snails and drink from any fountains encountered in the generated dungeon. All other mechanics are standard.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: ENTER_DUNGEON, MAKE_STONE_PICKAXE, MAKE_IRON_SWORD, FIND_BOW

World:
- Player: Starts on floor 1. Inventory: `{"iron_sword": 1, "stone_pickaxe": 1, "bow": 1, "arrows": 10, "torches": 5, "wood": 3, "stone": 3}`. Achievements `ENTER_DUNGEON`, `MAKE_STONE_PICKAXE`, `MAKE_IRON_SWORD`, `FIND_BOW` are completed.
- Map:
  - Place 3 Orc Soldier melee mobs (mob_name "Orc Soldier", type_id=2) randomly within Manhattan distance 5–10 of the player start, on any non‑solid block.
  - Place 2 Orc Mage ranged mobs (mob_name "Orc Mage", type_id=2) randomly within Manhattan distance 5–10 of the player start, on any non‑solid block.
  - Place 3 Snail passive mobs (mob_name "Snail", type_id=2) randomly within Manhattan distance 5–10 of the player start, on any non‑solid block.
  - No other initial mobs or block modifications.
- Mechanics:
  - monsters_killed_to_clear_level = 3
  - needs_depletion_multiplier = 0.5
  - melee_spawn_multiplier = 0.0
  - ranged_spawn_multiplier = 0.0
  - passive_spawn_multiplier = 0.0
  - mob_health_multiplier = 1.0
  - mob_damage_multiplier = 1.0
  - health_recover_multiplier = 1.0
  - health_loss_multiplier = 1.0
  - mana_recover_multiplier = 1.0
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_IRON_SWORD,
            Achievement.FIND_BOW,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            passive_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=3,
            needs_depletion_multiplier=0.5,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, mobs_rng, final_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Equip starting inventory
        builder.set_player_inventory({
            "sword": 3,      # iron sword
            "pickaxe": 2,    # stone pickaxe
            "bow": 1,
            "arrows": 10,
            "torches": 5,
            "wood": 3,
            "stone": 3,
        })

        spawn_pos = builder.ladders_up[1]

        # Split mob placement rngs
        mob_rngs = jax.random.split(mobs_rng, 8)
        melee_rng1, melee_rng2, melee_rng3, ranged_rng1, ranged_rng2, passive_rng1, passive_rng2, passive_rng3 = mob_rngs

        # Place 3 Orc Soldiers (melee, type_id=2)
        for mrng in (melee_rng1, melee_rng2, melee_rng3):
            builder.add_mobs_randomly_near(
                mrng,
                level=1,
                mob_name="melee",
                type_id=2,
                n=1,
                target_pos=spawn_pos,
                min_dist=5,
                max_dist=10,
                on_blocks=[BlockType.PATH],
            )

        # Place 2 Orc Mages (ranged, type_id=2)
        for rrng in (ranged_rng1, ranged_rng2):
            builder.add_mobs_randomly_near(
                rrng,
                level=1,
                mob_name="ranged",
                type_id=2,
                n=1,
                target_pos=spawn_pos,
                min_dist=5,
                max_dist=10,
                on_blocks=[BlockType.PATH],
            )

        # Place 3 Snails (passive, type_id=2)
        for prng in (passive_rng1, passive_rng2, passive_rng3):
            builder.add_mobs_randomly_near(
                prng,
                level=1,
                mob_name="passive",
                type_id=2,
                n=1,
                target_pos=spawn_pos,
                min_dist=5,
                max_dist=10,
                on_blocks=[BlockType.PATH],
            )

        state = builder.build(final_rng)

        # Set pre-completed achievements
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
