: {"collect_wood": 23.569794050343248, "place_table": 19.374523264683447, "collect_sapling": 22.95957284515637, "collect_drink": 76.27765064836004, "make_wood_pickaxe": 40.274599542334094, "place_plant": 22.42562929061785, "collect_stone": 26.23951182303585, "place_stone": 25.70556826849733, "make_stone_pickaxe": 22.50190694126621, "make_stone_sword": 22.349351639969488, "wake_up": 39.28299008390542, "place_furnace": 25.85812356979405, "collect_coal": 53.2418001525553, "collect_iron": 47.29214340198322, "collect_diamond": 25.85812356979405, "make_iron_pickaxe": 10.068649885583524, "make_iron_sword": 11.060259344012204, "make_torch": 85.96491228070175, "place_torch": 82.99008390541572, "collect_sapphire": 22.27307398932113, "collect_ruby": 22.578184591914567, "make_diamond_pickaxe": 2.898550724637681, "make_diamond_sword": 2.669717772692601, "enter_gnomish_mines": 73.45537757437071, "enter_dungeon": 100.0, "defeat_orc_solider": 95.8047292143402, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 97.86422578184592, "drink_potion": 72.08237986270022}, "average_episode_length": 211.26315789473685, "mean_return_percentage": 15.879742250730713, "mean_return": 35.88821748665141, "lp": NaN, "priority_score": 0.19498452628437077}]</data>
