": 19.26605504587156, "collect_ruby": 29.81651376146789, "make_diamond_pickaxe": 3.2110091743119265, "make_diamond_sword": 4.587155963302752, "make_iron_armour": 3.2110091743119265, "enter_gnomish_mines": 64.6788990825688, "enter_dungeon": 98.1651376146789, "defeat_orc_solider": 95.41284403669725, "defeat_orc_mage": 91.28440366972477, "eat_snail": 96.3302752293578, "find_bow": 97.70642201834862, "fire_bow": 97.24770642201835, "open_chest": 97.70642201834862, "drink_potion": 86.23853211009174}, "average_episode_length": 1319.633027522936, "mean_return_percentage": 25.097957535824467, "mean_return": 56.7213840309633, "lp": NaN, "priority_score": 0.22845299217237605}]</data>
