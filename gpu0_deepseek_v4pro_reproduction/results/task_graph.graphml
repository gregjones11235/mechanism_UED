ct_drink": 75.1755472945064, "make_wood_sword": 100.0, "place_plant": 98.76084262701363, "defeat_zombie": 1.4456836018174308, "collect_stone": 100.0, "place_stone": 99.17389508467575, "defeat_skeleton": 0.7847996695580338, "make_stone_pickaxe": 99.95869475423379, "make_stone_sword": 93.55638166047088, "wake_up": 94.75423378769104, "place_furnace": 98.88475836431226, "collect_coal": 74.92771581990912, "make_arrow": 94.01073936389922, "make_torch": 74.26683188764973, "place_torch": 70.34283353985957}, "average_episode_length": 115.85749690210656, "mean_return_percentage": 15.185068005157671, "mean_return": 34.31825369165634, "lp": NaN, "priority_score": 0.00041288184532931906}, {"session": 12, "sr": 0.9995064165844028, "achievement_srs": {"collect_wood": 100.0, "place_table": 99.85192497532083, "eat_cow": 68.21322803553801, "collect_sapling": 99.30898321816387, "collect_drink": 80.79960513326752, "make_wood_sword": 100.0, "place_plant": 98.61796643632773, "defeat_zombie": 1.4807502467917077, "collect_stone": 100.0, "place_stone": 99.06219151036525, "defeat_skeleton": 1.1352418558736426, "make_stone_pickaxe": 99.95064165844028, "make_stone_sword": 95.85389930898322, "wake_up": 97.58144126357354, "place_furnace": 98.86475814412636, "collect_coal": 82.4284304047384, "make_arrow": 97.97630799605133, "make_torch": 81.63869693978282, "place_torch": 78.72655478775913}, "average_episode_length": 134.28232971372162, "mean_return_percentage": 15.399297517231739, "mean_return": 34.80241238894373, "lp": NaN, "priority_score": 0.0004933397910090903}]</data>
