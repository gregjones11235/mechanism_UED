      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to clear Floor 1 (Dungeon) under normal survival pressure, reinforcing combat and resource management to enter the Gnomish Mines.

Description: The agent begins on Floor 1 with a stone sword, stone pickaxe, bow, 10 arrows, and 20 torches – the same equipment that represents a competent overworld run. All survival needs are reactivated (`needs_depletion_multiplier = 1.0`), forcing the agent to manage hunger, thirst, and fatigue while exploring the maze, fighting orcs, and placing torches. To compensate for the added survival burden and maintain a learnable difficulty, the required number of monster kills to unlock the ladder down is reduced from 8 to 4 (`monsters_killed_to_clear_level = 4`). The agent must locate fountains to drink, hunt passive snails for food, and possibly use potions from chests to stay alive, finally locating the ladder down and using the DESCEND action to enter the Gnomish Mines (Floor 2). This task transfers directly to the global game by instilling the necessary survival habits inside the dungeon, closing the gap between high dungeon entry and low mine entry seen in the full Craftax evaluation.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, COLLECT_WOOD, PLACE_TABLE, COLLECT_STONE, FIND_BOW

World:
- Player: `set_starting_floor(1)`. Inventory: `{"stone_pickaxe": 1, "stone_sword": 1, "bow": 1, "arrows": 10, "torch": 20}`. All survival stats start at maximum (health, food, drink, energy = 9). Attributes: Strength 1, Dexterity 1, Intelligence 1.
- Map: No manual block placements. Use the default procedural generation for all levels.
- Mechanics:
  - monsters_killed_to_clear_level = 4
  - needs_depletion_multiplier = 1.0
  - mob_health_multiplier = 1.0
  - mob_damage_multiplier = 1.0
  - melee_spawn_multiplier = 1.0
  - ranged_spawn_multiplier = 1.0
  - passive_spawn_multiplier = 1.0
  - health_recover_multiplier = 1.0
  - health_loss_multiplier = 1.0
  - mana_recover_multiplier = 1.0
  - growing_plants_age = 600
  - All other parameters remain at their original Craftax defaults.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.COLLECT_WOOD,
            Achievement.PLACE_TABLE,
            Achievement.COLLECT_STONE,
            Achievement.FIND_BOW,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=4,
            needs_depletion_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            growing_plants_age=600,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on Floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Equip starting inventory: stone sword (tier 2), stone pickaxe (tier 2), bow, arrows, torches
        builder.set_player_inventory({
            "sword": 2,      # stone sword
            "pickaxe": 2,    # stone pickaxe
            "bow": 1,
            "arrows": 10,
            "torches": 20,
        })

        # No manual block or mob placements; default dungeon generation is used

        state = builder.build(rng)

        # Mark completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
