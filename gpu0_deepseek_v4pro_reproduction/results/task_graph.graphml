ace_stone": 97.33333333333333, "eat_plant": 26.666666666666668, "defeat_skeleton": 70.66666666666667, "make_stone_pickaxe": 83.55555555555556, "make_stone_sword": 91.55555555555556, "wake_up": 99.55555555555556, "place_furnace": 97.33333333333333, "collect_coal": 90.22222222222223, "collect_iron": 74.66666666666667, "collect_diamond": 27.555555555555557, "make_iron_pickaxe": 22.666666666666668, "make_iron_sword": 36.888888888888886, "make_arrow": 95.11111111111111, "make_torch": 92.88888888888889, "place_torch": 91.55555555555556, "collect_sapphire": 24.88888888888889, "collect_ruby": 28.444444444444443, "make_diamond_pickaxe": 4.888888888888889, "make_diamond_sword": 2.2222222222222223, "make_iron_armour": 3.111111111111111, "enter_gnomish_mines": 61.333333333333336, "enter_dungeon": 93.77777777777777, "defeat_orc_solider": 89.33333333333333, "defeat_orc_mage": 83.55555555555556, "eat_snail": 90.66666666666667, "find_bow": 92.88888888888889, "fire_bow": 91.55555555555556, "open_chest": 92.88888888888889, "drink_potion": 77.33333333333333}, "average_episode_length": 1224.2622222222221, "mean_return_percentage": 25.46767453294002, "mean_return": 57.55694444444445, "lp": NaN, "priority_score": 0.23715555555555556}]</data>
