      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to locate and mine naturally generated iron and coal in the overworld, then craft an iron sword and descend to the Gnomish Mines.

Description: The agent spawns in the centre of the overworld with no inventory and default stats on floor 0. The world uses standard generation without any hand‑placed resources; iron (2% among stone) and coal (3% among stone) appear only through the normal procedural distribution. The agent must execute the full crafting chain (wood pickaxe → stone pickaxe → iron sword) by finding these ores in the wild, placing a Crafting Table and a Furnace, and smelting the sword. Once the iron sword is crafted, the agent must descend into the Dungeon (floor 1), clear enough hostile mobs to meet the floor‑clearance requirement of 8 kills, then descend again to the Gnomish Mines (floor 2). The task is considered a success only when both `MAKE_IRON_SWORD` and `ENTER_GNOMISH_MINES` are unlocked. Survival pressure is kept deliberately low (`needs_depletion_multiplier = 0.2`) to concentrate learning on resource exploration and the iron‑sword upgrade, avoiding premature starvation failure.

Relevant Achievements: MAKE_IRON_SWORD, ENTER_GNOMISH_MINES
Completed Achievements: (none)

World:
- Player: floor 0 via `set_starting_floor(0)`. Inventory empty. Stats default.
- Map: No block modifications are made; rely entirely on the default natural generation for all nine levels.
- Mechanics:
  - `monsters_killed_to_clear_level = 8`
  - `needs_depletion_multiplier = 0.2`
  - All other `TaskParams` remain at their default values (1.0 multipliers).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.MAKE_IRON_SWORD,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = []  # none
        self.label = "MAKE_IRON_SWORD, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
            needs_depletion_multiplier=0.2,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld)
        builder.set_starting_floor(0)

        # Inventory is empty by default; no map modifications required.
        state = builder.build(rng)

        # No pre‑completed achievements to mark.
        return state</data>
