amond_sword": 3.438395415472779, "make_iron_armour": 1.146131805157593, "enter_gnomish_mines": 59.02578796561605, "enter_dungeon": 100.0, "defeat_orc_solider": 96.56160458452722, "defeat_orc_mage": 88.53868194842407, "eat_snail": 95.98853868194843, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 98.567335243553, "drink_potion": 80.51575931232092}, "average_episode_length": 790.1404011461318, "mean_return_percentage": 17.413713743597384, "mean_return": 39.354993060530084, "lp": NaN, "priority_score": 0.24185351515997405}, {"session": 58, "sr": 0.7576530612244898, "achievement_srs": {"collect_wood": 38.265306122448976, "place_table": 35.714285714285715, "eat_cow": 38.01020408163265, "collect_sapling": 39.285714285714285, "collect_drink": 82.14285714285714, "make_wood_pickaxe": 53.826530612244895, "make_wood_sword": 100.0, "place_plant": 38.265306122448976, "defeat_zombie": 20.408163265306122, "collect_stone": 40.56122448979592, "place_stone": 38.52040816326531, "eat_plant": 5.612244897959184, "defeat_skeleton": 17.857142857142858, "make_stone_pickaxe": 30.102040816326532, "wake_up": 13.26530612244898, "place_furnace": 39.795918367346935, "collect_coal": 61.734693877551024, "collect_iron": 55.86734693877551, "collect_diamond": 27.806122448979593, "make_iron_pickaxe": 11.73469387755102, "make_iron_sword": 16.836734693877553, "place_torch": 99.48979591836735, "collect_sapphire": 22.448979591836736, "collect_ruby": 28.316326530612244, "make_diamond_pickaxe": 2.295918367346939, "make_diamond_sword": 4.336734693877551, "make_iron_armour": 2.5510204081632653, "enter_gnomish_mines": 75.76530612244898, "enter_dungeon": 100.0, "defeat_orc_solider": 97.1938775510204, "defeat_orc_mage": 87.5, "eat_snail": 95.66326530612245, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 99.23469387755102, "drink_potion": 82.39795918367346}, "average_episode_length": 672.8775510204082, "mean_return_percentage": 19.37717067779822, "mean_return": 43.792405731823976, "lp": NaN, "priority_sco