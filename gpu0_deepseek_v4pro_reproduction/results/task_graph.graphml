ckaxe": 34.14043583535109, "wake_up": 95.88377723970945, "place_furnace": 44.067796610169495, "collect_coal": 64.40677966101696, "collect_iron": 57.869249394673126, "collect_diamond": 25.423728813559322, "make_iron_pickaxe": 19.128329297820823, "make_iron_sword": 20.09685230024213, "place_torch": 99.75786924939467, "collect_sapphire": 27.360774818401936, "collect_ruby": 25.907990314769975, "make_diamond_pickaxe": 5.084745762711864, "make_diamond_sword": 3.87409200968523, "enter_gnomish_mines": 44.067796610169495, "enter_dungeon": 100.0, "defeat_orc_solider": 95.64164648910412, "defeat_orc_mage": 92.49394673123487, "eat_snail": 96.12590799031477, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 99.51573849878935, "drink_potion": 82.56658595641646}, "average_episode_length": 681.3438256658595, "mean_return_percentage": 16.87582299177452, "mean_return": 38.13935996141041, "lp": NaN, "priority_score": 0.24618775979222485}]</data>
