      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Teach the agent to survive the Dungeon under the full, original Craftax survival‑pressure rate while clearing the floor to reach the Gnomish Mines.

Description:
The task is identical to the parent Dungeon‑endurance task except that the survival needs now deplete at the standard Craftax speed. The agent starts on floor 1 with a stone sword and a wood pickaxe – the same proven equipment. Hunger, thirst, and fatigue accumulate at the original rate (`needs_depletion_multiplier = 1.0`). The agent must exploit all in‑floor resources (snails, fountains, chest potions) more aggressively to sustain itself while defeating the required eight hostile mobs and descending the ladder to floor 2. As in the parent, one Orc Soldier (`mob_name="melee"`, `type_id=2`) and one Orc Mage (`mob_name="ranged"`, `type_id=2`) are pre‑placed within Manhattan distance 1–3 from the spawn point to provide an early kill‑opportunity and combat engagement, while the rest of the eight kills must be obtained from natural spawns. All other game parameters stay at original Craftax defaults (full spawn multipliers, normal mob health and damage, plant growth age 600). The episode is successful only when the agent uses the ladder on floor 1 to descend to floor 2 (triggers `ENTER_GNOMISH_MINES`).

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: COLLECT_WOOD, PLACE_TABLE, MAKE_WOOD_PICKAXE, COLLECT_STONE, MAKE_STONE_SWORD, ENTER_DUNGEON

World:
- Player: Start on floor 1. Inventory: stone sword, wood pickaxe. All attributes at 1. Health, Food, Drink, Energy, Mana full (9/9).
- Map:
  - Floor 1: pre‑place one Orc Soldier (`mob_name="melee"`, `type_id=2`) and one Orc Mage (`mob_name="ranged"`, `type_id=2`), each randomly placed within Manhattan distance 1–3 from the up‑ladder position (the agent’s spawn point), on distinct, non‑colliding tiles.
- Mechanics:
  - `needs_depletion_multiplier = 1.0`
  - `passive_spawn_multiplier = 1.0`
  - `melee_spawn_multiplier = 1.0`
  - `ranged_spawn_multiplier = 1.0`
  - `monsters_killed_to_clear_level` for floor 1 set to 8 (default for other floors)
  - All other TaskParams at original Craftax defaults (mob health/damage multipliers, recovery rates, etc. remain 1.0).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.COLLECT_WOOD,
            Achievement.PLACE_TABLE,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.COLLECT_STONE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.ENTER_DUNGEON,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=1.0,
            monsters_killed_to_clear_level=8,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, mob_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (the Dungeon)
        builder.set_starting_floor(1)

        # Equip stone sword (tier 2) and wood pickaxe (tier 1)
        builder.set_player_inventory({
            "sword": 2,
            "pickaxe": 1,
        })

        # Player spawn point is the up-ladder position on floor 1
        spawn_pos = builder.player_position

        # Place one Orc Soldier (melee, type_id=2) within 1-3 Manhattan distance
        rng, soldier_rng = jax.random.split(mob_rng)
        builder.add_mobs_randomly_near(
            soldier_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=1,
            target_pos=spawn_pos,
            min_dist=1,
            max_dist=3,
            on_blocks=[BlockType.PATH],
        )

        # Place one Orc Mage (ranged, type_id=2) within 1-3 Manhattan distance
        builder.add_mobs_randomly_near(
            rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=1,
            target_pos=spawn_pos,
            min_dist=1,
            max_dist=3,
            on_blocks=[BlockType.PATH],
        )

        state = builder.build(rng)

        # Mark the pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
