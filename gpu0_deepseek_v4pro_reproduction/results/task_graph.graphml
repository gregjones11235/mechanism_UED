      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Navigate the overworld, enter the dungeon, clear a handful of orcs, and descend into the Gnomish Mines.

Description: The agent starts on floor 0 (the overworld), spawned at the center of the map. It is equipped with a complete stone‑age loadout: a stone pickaxe, stone sword, a bow, 10 arrows, and 10 torches. All basic crafting steps that lead to this gear are considered already accomplished. The ladder down to floor 1 is pre‑unlocked (monsters_killed for floor 0 is set to 8), so the agent does not need to defeat any overworld mobs to descend. The agent must explore the procedurally generated overworld (grass, water, sand, stone, trees, lava lakes) to find the ladder‑down location and descend to floor 1 (the dungeon). On floor 1, the task follows the same pattern as the preceding stone‑start dungeon task: the agent must kill at least 3 hostile mobs (orc soldiers, orc mages) and then locate the ladder down to floor 2 within the dungeon rooms and corridors. Descending to floor 2 triggers the ENTER_GNOMISH_MINES achievement, which immediately terminates the task as a success. All mob spawn rates, health, and damage remain at their default values. The floor‑1 kill requirement is lowered to 3 (monsters_killed_to_clear_level = 3) to keep the challenge focused on the new overworld traversal component. Survival needs deplete at normal speed, but the agent begins with full food, water, energy, and health.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: COLLECT_WOOD, PLACE_TABLE, MAKE_WOOD_PICKAXE, COLLECT_STONE, MAKE_STONE_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_SWORD, FIND_BOW, MAKE_ARROW, MAKE_TORCH

World:
- Player: Starting floor = 0 (at the default center spawn). Inventory (builder.set_player_inventory): stone pickaxe (pickaxe=2, tier 2), stone sword (sword=2, tier 2), bow (bow=1), arrows=10, torches=10. Stats: default (Strength=1, Dexterity=1, Intelligence=1). Monsters killed: builder.set_monsters_killed(level=0, count=8) to guarantee the ladder down is open.
- Map: No block modifications; the overworld (level 0) and the dungeon (level 1) are generated normally with all their default features (trees, water, lava, ore deposits on level 0; rooms, corridors, chests, fountains on level 1).
- Mechanics:
  - monsters_killed_to_clear_level = 3 (only for floor 1; floor 0’s ladder is already unlocked by the monsters_killed count)
  - All other TaskParams remain at default (melee_spawn_multiplier = 1.0, ranged_spawn_multiplier = 1.0, passive_spawn_multiplier = 1.0, mob_health_multiplier = 1.0, mob_damage_multiplier = 1.0, needs_depletion_multiplier = 1.0, health_recover_multiplier = 1.0, health_loss_multiplier = 1.0, mana_recover_multiplier = 1.0, growing_plants_age = 600).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.COLLECT_WOOD,
            Achievement.PLACE_TABLE,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.COLLECT_STONE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_SWORD,
            Achievement.FIND_BOW,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_TORCH,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=3,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Player starts on floor 0 (overworld) at the default center spawn
        # No set_starting_floor call; floor 0 is the default

        # Equip complete stone-age loadout
        builder.set_player_inventory({
            "pickaxe": 2,   # stone pickaxe
            "sword": 2,     # stone sword
            "bow": 1,
            "arrows": 10,
            "torches": 10,
        })

        # Pre-clear overworld kill requirement so the ladder down is open immediately
        builder.set_monsters_killed(level=0, count=8)

        # Build the state (levels are generated normally)
        state = builder.build(rng)

        # Mark all pre-completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
