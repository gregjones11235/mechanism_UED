  - All spawn multipliers = 1.0 (default)
  - growing_plants_age = 600 (default)</data>
      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Clear the Dungeon floor under full‑difficulty kill requirements and descend into the Gnomish Mines, starting with a pre‑built sword and torches.

Description: The agent begins on floor 1 (Dungeon) at the Ladder Up position with a stone sword and 15 torches. A Fountain is placed directly adjacent to the spawn point, and two Snail passive mobs are present nearby for food. The agent must kill 8 hostile monsters (Orc Soldiers or Orc Mages) to unlock the Ladder Down, then step onto it to achieve `ENTER_GNOMISH_MINES`. Survival needs are relaxed: hunger, thirst, and fatigue accumulate at half speed, and natural health regeneration is doubled. This task isolates the Dungeon clearing challenge at the original game difficulty, bypassing the already‑proficient overworld‑preparation loop.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, MAKE_TORCH (implied by starting inventory)

World:
- Player: Starting floor: 1 (Dungeon). Inventory: { “sword”: 2, “torches”: 15 }. Attributes: strength=1, dexterity=1, intelligence=1. Health/Food/Drink/Energy/Mana all 9/9. No enchantments or spells.
- Map:
  - On floor 1, place a Fountain block immediately adjacent to the Ladder Up position (the player’s spawn point).
  - Spawn 2 passive mobs of type Snail (mob_name="snail", type_id=2) randomly within 4 tiles of the player spawn point, on valid ground tiles.
  - No other manual block modifications; the default Dungeon generation (rooms, corridors, chests, torches) remains.
- Mechanics:
  - monsters_killed_to_clear_level = 8
  - needs_depletion_multiplier = 0.5
  - health_recover_multiplier = 2.0
  - health_loss_multiplier = 1.0
  - mana_recover_multiplier = 1.0
  - mob_damage_multiplier = 1.0
  - mob_health_multiplier = 1.0
  - melee_trigger_distance = 10 (default)
  - All spawn multipliers = 1.0 (default)
  - growing_plants_age = 600 (default)
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_TORCH,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
            needs_depletion_multiplier=0.5,
            health_recover_multiplier=2.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            mob_damage_multiplier=1.0,
            mob_health_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, fountain_rng, snail_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Equip stone sword (tier 2) and 15 torches; no other items
        builder.set_player_inventory({"sword": 2, "torches": 15})

        # Get player spawn position (the up ladder on floor 1)
        player_pos = builder.player_position

        # Place a Fountain adjacent to the player spawn (minimum distance 1, maximum distance 1)
        builder.place_randomly_near(
            rng=fountain_rng,
            level=1,
            block_type=BlockType.FOUNTAIN,
            target_pos=player_pos,
            min_dist=1,
            max_dist=1,
            n=1,
            on_blocks=[BlockType.PATH],  # dungeon floor tiles are PATH
        )

        # Spawn 2 Snail passive mobs near the player (type_id=2 for snail)
        builder.add_mobs_randomly_near(
            rng=snail_rng,
            level=1,
            mob_name="passive",
            type_id=2,
            n=2,
            target_pos=player_pos,
            min_dist=0,
            max_dist=4,
            on_blocks=[BlockType.PATH],
        )

        # Build the initial state from the builder
        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
