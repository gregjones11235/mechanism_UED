      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Teach the agent to scavenge for coal in the dark dungeon and craft torches/arrows on‑site, so it can reliably navigate and fight before descending to floor 2.

Description: The agent begins on floor 1 with the same basic combat gear as the previous task (stone sword, wood pickaxe, bow) and a small supply of wood (5) and stone (10). However, it receives **no torches, no arrows, and no coal**. The dungeon’s default darkness and hostile mobs (orc soldiers, orc mages) force the agent to seek out coal ore blocks within the dungeon walls, mine them with the wood pickaxe, and then stand near a crafting table (carried inventory can place one using 2 wood) or use the existing torches in corners? Actually, the dungeon has torches in corners, but they are limited and may not be reachable. The agent must craft torches (1 wood + 1 coal) to extend its vision and arrows (1 wood + 1 stone) to replenish ammo. The only terminal goal remains descending to floor 2 (`ENTER_GNOMISH_MINES`). The pre‑supplied gear and completed overworld achievements remove any need for backtracking.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: COLLECT_WOOD, COLLECT_STONE, MAKE_WOOD_PICKAXE, MAKE_STONE_SWORD, FIND_BOW, EAT_COW, COLLECT_DRINK, ENTER_DUNGEON

World:
- Player: Starting floor 1. Inventory:
    - stone_sword: 1
    - wood_pickaxe: 1
    - bow: 1
    - arrows: 0
    - torches: 0
    - wood: 5
    - stone: 10
    - coal: 0
  Player stats default (Strength 1, Dexterity 1, Intelligence 1; health, food, drink, energy, mana all max 9).
- Map: No explicit block modifications; floor 1 generates normally (dungeon layout with coal and other ores in walls).
- Mechanics:
    - needs_depletion_multiplier = 1.0
    - monsters_killed_to_clear_level = 6 (applies to floor 1)
    - melee_spawn_multiplier = 1.0
    - ranged_spawn_multiplier = 1.0
    - passive_spawn_multiplier = 1.0
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.COLLECT_WOOD,
            Achievement.COLLECT_STONE,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.FIND_BOW,
            Achievement.EAT_COW,
            Achievement.COLLECT_DRINK,
            Achievement.ENTER_DUNGEON,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=6,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon)
        builder.set_starting_floor(1)

        # Equip starting inventory: wood pickaxe, stone sword, bow, wood, stone
        builder.set_player_inventory({
            "pickaxe": 1,   # wood pickaxe
            "sword": 2,     # stone sword
            "bow": 1,       # bow present
            "arrows": 0,
            "torches": 0,
            "wood": 5,
            "stone": 10,
            "coal": 0,
        })

        # No map modifications; dungeon generates normally

        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
