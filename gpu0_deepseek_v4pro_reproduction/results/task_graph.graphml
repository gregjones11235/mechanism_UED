amond_sword": 2.9411764705882355, "make_iron_armour": 33.8235294117647, "enter_gnomish_mines": 7.8431372549019605, "enter_dungeon": 89.2156862745098, "defeat_orc_solider": 67.6470588235294, "defeat_orc_mage": 50.0, "eat_snail": 83.82352941176471, "find_bow": 85.7843137254902, "fire_bow": 80.88235294117646, "open_chest": 85.7843137254902, "drink_potion": 63.23529411764706}, "average_episode_length": 1424.4607843137255, "mean_return_percentage": 19.778853837926206, "mean_return": 44.70020967371323, "lp": NaN, "priority_score": 0.21530180699730872}]</data>
