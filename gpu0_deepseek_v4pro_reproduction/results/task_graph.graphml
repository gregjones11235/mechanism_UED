20.408163265306122, "make_arrow": 75.28344671201815, "make_torch": 91.83673469387755, "place_torch": 90.47619047619048, "collect_sapphire": 23.582766439909296, "collect_ruby": 25.170068027210885, "make_diamond_pickaxe": 4.761904761904762, "make_diamond_sword": 2.7210884353741496, "enter_gnomish_mines": 52.38095238095238, "enter_dungeon": 100.0, "defeat_orc_solider": 95.23809523809524, "defeat_orc_mage": 88.20861678004535, "eat_snail": 98.86621315192744, "find_bow": 99.31972789115646, "fire_bow": 73.69614512471655, "open_chest": 99.31972789115646, "drink_potion": 79.81859410430839}, "average_episode_length": 665.1043083900227, "mean_return_percentage": 19.51519050190135, "mean_return": 44.104330534297056, "lp": NaN, "priority_score": 0.2494331065759637}, {"session": 148, "sr": 0.5835294117647059, "achievement_srs": {"collect_wood": 50.8235294117647, "place_table": 47.294117647058826, "eat_cow": 55.05882352941177, "collect_sapling": 48.0, "collect_drink": 91.76470588235294, "make_wood_pickaxe": 56.470588235294116, "make_wood_sword": 100.0, "place_plant": 48.0, "defeat_zombie": 28.235294117647058, "collect_stone": 48.0, "place_stone": 47.05882352941177, "eat_plant": 7.764705882352941, "defeat_skeleton": 26.823529411764707, "make_stone_pickaxe": 44.470588235294116, "make_stone_sword": 100.0, "wake_up": 95.76470588235294, "place_furnace": 46.8235294117647, "collect_coal": 64.94117647058823, "collect_iron": 60.0, "collect_diamond": 29.176470588235293, "make_iron_pickaxe": 19.764705882352942, "make_arrow": 78.82352941176471, "make_torch": 91.29411764705883, "place_torch": 89.88235294117646, "collect_sapphire": 28.235294117647058, "collect_ruby": 23.529411764705884, "make_diamond_pickaxe": 2.588235294117647, "make_diamond_sword": 4.0, "enter_gnomish_mines": 58.35294117647059, "enter_dungeon": 100.0, "defeat_orc_solider": 95.05882352941177, "defeat_orc_mage": 88.47058823529412, "eat_snail": 97.17647058823529, "find_bow": 99.29411764705883, "fire_bow": 77.41176470588235, "ope