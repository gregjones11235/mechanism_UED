6548042705, "eat_plant": 5.516014234875445, "defeat_skeleton": 10.854092526690392, "make_stone_pickaxe": 27.224199288256226, "make_stone_sword": 100.0, "wake_up": 30.249110320284696, "place_furnace": 29.181494661921707, "collect_coal": 52.313167259786475, "collect_iron": 51.95729537366548, "collect_diamond": 24.377224199288257, "make_iron_pickaxe": 14.768683274021353, "make_arrow": 60.49822064056939, "make_torch": 84.87544483985765, "place_torch": 76.86832740213524, "collect_sapphire": 22.24199288256228, "collect_ruby": 26.334519572953738, "make_diamond_pickaxe": 3.380782918149466, "make_diamond_sword": 2.8469750889679717, "enter_gnomish_mines": 78.64768683274022, "enter_dungeon": 100.0, "defeat_orc_solider": 98.39857651245552, "defeat_orc_mage": 53.02491103202847, "eat_snail": 85.40925266903915, "find_bow": 98.39857651245552, "fire_bow": 56.93950177935943, "open_chest": 98.39857651245552, "drink_potion": 64.59074733096085}, "average_episode_length": 499.5782918149466, "mean_return_percentage": 19.467602593652565, "mean_return": 43.9967818616548, "lp": NaN, "priority_score": 0.1679310039133243}]</data>
