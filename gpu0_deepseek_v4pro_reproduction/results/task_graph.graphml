eat_plant": 1.810436634717785, "defeat_skeleton": 2.5559105431309903, "make_stone_sword": 72.31096911608094, "wake_up": 86.47497337593184, "collect_iron": 99.78700745473908, "collect_diamond": 4.259850905218317, "make_iron_pickaxe": 94.03620873269436, "make_iron_sword": 25.66560170394036, "make_arrow": 85.72949946751864, "make_torch": 92.65175718849841, "place_torch": 84.13205537806176, "collect_sapphire": 3.9403620873269434, "collect_ruby": 5.431309904153355, "make_diamond_pickaxe": 0.3194888178913738, "make_diamond_sword": 0.42598509052183176, "make_iron_armour": 0.42598509052183176, "enter_dungeon": 48.02981895633653, "defeat_orc_solider": 0.9584664536741214, "defeat_orc_mage": 0.9584664536741214, "eat_snail": 11.714589989350372, "find_bow": 46.219382321618745, "fire_bow": 34.9307774227902, "open_chest": 46.219382321618745, "drink_potion": 5.537806176783812}, "average_episode_length": 297.99680511182106, "mean_return_percentage": 17.26112114422234, "mean_return": 39.01013378594249, "lp": NaN, "priority_score": 0.05701803631761068}]</data>
