      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams
from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Clear Floor 1 (Dungeon) using only a stone sword, without relying on a bow, and descend to the Gnomish Mines.

Description: The agent begins on Floor 1 (Dungeon) equipped with a stone sword and no bow or arrows. Two guaranteed mobs are placed initially: one Orc Soldier (melee) and one Orc Mage (ranged), each 5–8 tiles from spawn. Hostile mobs spawn at low rates (melee 30 %, ranged 20 % of normal), and no passive mobs appear. The floor‑clear requirement is 4 kills. Survival needs (hunger, thirst, fatigue) drain at 20 % of normal speed so the focus remains on combat. To compensate for the lack of ranged damage, natural health regeneration is doubled (health_recover_multiplier = 2.0). This forces the agent to learn effective melee combat against both melee and ranged enemies in the dungeon environment.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: MAKE_STONE_SWORD

World:
- Player: Floor 1 (spawn at ladder‑up position). Inventory: {"sword": 2}. Stats: Strength 1, Dexterity 1, Intelligence 1. Health/Food/Drink/Energy/Mana all full (9/9). Learned spells: none. Weapon/Armour enchantments: none.
- Map:
    - Use default Dungeon generation for Floor 1.
    - Place exactly one melee mob (Orc Soldier, "melee", type_id=2) using `add_mobs_randomly_near`, with target_pos = player spawn coordinates, n=1, min_dist=5, max_dist=8, on_blocks = [BlockType.PATH].
    - Place exactly one ranged mob (Orc Mage, "ranged", type_id=2) using `add_mobs_randomly_near`, with target_pos = player spawn coordinates, n=1, min_dist=5, max_dist=8, on_blocks = [BlockType.PATH].
    - No other mobs are placed initially; spawning will populate further enemies.
- Mechanics:
    "needs_depletion_multiplier": 0.2,
    "melee_spawn_multiplier": 0.3,
    "ranged_spawn_multiplier": 0.2,
    "passive_spawn_multiplier": 0.0,
    "monsters_killed_to_clear_level": 4,
    "health_recover_multiplier": 2.0,
    "health_loss_multiplier": 1.0,
    "mob_health_multiplier": 1.0,
    "mob_damage_multiplier": 1.0
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_STONE_SWORD,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.2,
            melee_spawn_multiplier=0.3,
            ranged_spawn_multiplier=0.2,
            passive_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=4,
            health_recover_multiplier=2.0,
            health_loss_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, melee_rng, ranged_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)
        builder.set_starting_floor(1)

        # Equip only the stone sword
        builder.set_player_inventory({"sword": 2})

        # Pre-place one Orc Soldier (melee, type_id=2) within distance 5-8
        builder.add_mobs_randomly_near(
            melee_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=1,
            target_pos=builder.player_position,
            min_dist=5,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        # Pre-place one Orc Mage (ranged, type_id=2) within distance 5-8
        builder.add_mobs_randomly_near(
            ranged_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=1,
            target_pos=builder.player_position,
            min_dist=5,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        # Build the initial state
        state = builder.build(rng)

        # Mark the pre-completed achievement as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
