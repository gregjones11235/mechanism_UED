      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Clear the Dungeon floor under full original survival demands and descend to the Gnomish Mines.

Description: The agent starts on floor 1 (Dungeon) at the Ladder Up position, carrying a wood sword, a bow, 10 arrows, and 20 torches. All other inventory slots are empty. The Dungeon is generated with Craftax’s default room‑and‑corridor layout (walls, chests, fountains, torches in corners, etc.), but we additionally seed the immediate area around the start: three Ripe Plants (BlockType.RIPE_PLANT) and one Fountain (BlockType.FOUNTAIN) are placed within a Manhattan distance of ≤ 2 from the starting coordinates, on any valid ground (GRASS or PATH). Survival parameters are set to the original game values: `needs_depletion_multiplier = 1.0`, `health_recover_multiplier = 1.0`, `health_loss_multiplier = 1.0`, `mana_recover_multiplier = 1.0`. The Dungeon clearing requirement is the default 8 monsters (`monsters_killed_to_clear_level = 8`). All mob multipliers and other mechanics remain at their defaults (mob_health = 1.0, mob_damage = 1.0, spawn multipliers = 1.0). The agent must navigate the dark corridors, use torches to illuminate its path, fight orc soldiers and mages, manage hunger/thirst/fatigue by eating from the placed plants and drinking from the fountain (and any snails or additional fountains encountered), and ultimately kill enough enemies to unlock the down‑ladder. After that, standing on the LADDER_DOWN and executing DESCEND grants the `ENTER_GNOMISH_MINES` achievement.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: MAKE_WOOD_SWORD, FIND_BOW

World:
- Player: Starting floor = 1. Inventory: `{"sword": 1, "bow": 1, "arrows": 10, "torches": 20}`. All stats are 1; health, food, drink, energy are 9 / 9. The kill counter for floor 1 is 0.
- Map:  
  - Use the default Dungeon generation for floor 1.  
  - Place 3 Ripe Plants and 1 Fountain near the starting Ladder Up using `place_randomly_near` with parameters: `level=1, target_pos=start_pos, min_dist=0, max_dist=2, n=3 (plants) / n=1 (fountain), on_blocks=[BlockType.GRASS, BlockType.PATH]`.
- Mechanics: All `TaskParams` are kept at their default values, i.e.:  
  `needs_depletion_multiplier = 1.0`  
  `health_recover_multiplier = 1.0`  
  `health_loss_multiplier = 1.0`  
  `mana_recover_multiplier = 1.0`  
  `mob_health_multiplier = 1.0`  
  `mob_damage_multiplier = 1.0`  
  `melee_spawn_multiplier = 1.0`  
  `ranged_spawn_multiplier = 1.0`  
  `passive_spawn_multiplier = 1.0`  
  `monsters_killed_to_clear_level = 8`  
  `melee_trigger_distance = 10`  
  `growing_plants_age = 600`
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_SWORD,
            Achievement.FIND_BOW,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        return TaskParams()  # All default values

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        rng, build_rng, plant_rng, fountain_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Equip wood sword, bow, arrows, and torches
        builder.set_player_inventory({
            "sword": 1,      # Wood sword
            "bow": 1,
            "arrows": 10,
            "torches": 20,
        })

        # The current player position is the ladder up on floor 1
        start_pos = builder.player_position

        # Place three Ripe Plants within Manhattan distance 0-2 on valid ground
        builder.place_randomly_near(
            plant_rng,
            level=1,
            block_type=BlockType.RIPE_PLANT,
            target_pos=start_pos,
            min_dist=0,
            max_dist=2,
            n=3,
            on_blocks=[BlockType.GRASS, BlockType.PATH],
        )

        # Place one Fountain within Manhattan distance 0-2 on valid ground
        builder.place_randomly_near(
            fountain_rng,
            level=1,
            block_type=BlockType.FOUNTAIN,
            target_pos=start_pos,
            min_dist=0,
            max_dist=2,
            n=1,
            on_blocks=[BlockType.GRASS, BlockType.PATH],
        )

        state = builder.build(rng)

        # Mark completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
