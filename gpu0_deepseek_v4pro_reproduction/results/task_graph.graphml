376569, "collect_iron": 75.31380753138075, "collect_diamond": 30.543933054393307, "make_iron_pickaxe": 26.778242677824267, "make_iron_sword": 33.47280334728033, "make_arrow": 86.61087866108787, "make_torch": 94.97907949790795, "place_torch": 91.63179916317992, "collect_sapphire": 27.615062761506277, "collect_ruby": 28.03347280334728, "make_diamond_pickaxe": 5.439330543933054, "make_diamond_sword": 2.092050209205021, "make_iron_armour": 2.092050209205021, "enter_gnomish_mines": 30.96234309623431, "enter_dungeon": 85.77405857740585, "defeat_orc_solider": 80.3347280334728, "defeat_orc_mage": 71.96652719665272, "eat_snail": 68.61924686192468, "find_bow": 85.35564853556485, "fire_bow": 75.73221757322176, "open_chest": 85.35564853556485, "drink_potion": 77.82426778242677}, "average_episode_length": 1154.7196652719665, "mean_return_percentage": 19.852432283181212, "mean_return": 44.86649695998954, "lp": NaN, "priority_score": 0.21375676196145021}]</data>
