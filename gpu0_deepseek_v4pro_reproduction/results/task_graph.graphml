ength": 262.7315247895229, "mean_return_percentage": 16.26613405392932, "mean_return": 36.76146296188026, "lp": NaN, "priority_score": 0.24234988768430143}, {"session": 142, "sr": 0.599047619047619, "achievement_srs": {"collect_wood": 39.80952380952381, "place_table": 35.333333333333336, "collect_sapling": 38.95238095238095, "collect_drink": 83.52380952380952, "make_wood_pickaxe": 51.142857142857146, "make_wood_sword": 100.0, "place_plant": 38.76190476190476, "collect_stone": 39.23809523809524, "place_stone": 37.904761904761905, "make_stone_pickaxe": 29.142857142857142, "wake_up": 84.19047619047619, "place_furnace": 39.23809523809524, "collect_coal": 58.857142857142854, "collect_iron": 51.523809523809526, "collect_diamond": 28.095238095238095, "make_iron_pickaxe": 11.333333333333334, "make_iron_sword": 13.714285714285714, "make_arrow": 100.0, "make_torch": 88.66666666666667, "place_torch": 83.71428571428571, "collect_sapphire": 25.61904761904762, "collect_ruby": 27.333333333333332, "make_diamond_pickaxe": 2.857142857142857, "make_diamond_sword": 4.380952380952381, "make_iron_armour": 0.2857142857142857, "enter_gnomish_mines": 59.904761904761905, "enter_dungeon": 100.0, "defeat_orc_solider": 92.57142857142857, "defeat_orc_mage": 83.42857142857143, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 98.28571428571429, "drink_potion": 80.57142857142857}, "average_episode_length": 263.4895238095238, "mean_return_percentage": 16.499542377791823, "mean_return": 37.28896577380952, "lp": NaN, "priority_score": 0.24018956916099773}]</data>
