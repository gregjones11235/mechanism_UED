      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Defeat an Orc Mage on Floor 1 using a bow and arrows, while no other hostile mobs are present.

    Description: The player spawns in the Dungeon (Floor 1) at the position of the Ladder Up, with a wooden sword, a bow, and 10 arrows. A single Orc Mage (ranged mob, type_id=2) is pre‑placed within a Manhattan distance of 5–10 tiles from the player’s start via `add_mobs_randomly_near` using `on_blocks=[BlockType.PATH]`. No other mobs of any category can spawn because all spawn multipliers are set to zero. The task is to shoot at least one arrow (triggering `FIRE_BOW`) and then defeat the Orc Mage (achievement `DEFEAT_ORC_MAGE`). The agent may also use its wooden sword, but the ranged nature of the enemy and the small map mean the bow will likely be required. All survival needs decay at normal rate, beginning fully satisfied. The episode terminates successfully as soon as both relevant achievements are earned.

    Relevant Achievements: FIRE_BOW, DEFEAT_ORC_MAGE

    Completed Achievements: ENTER_DUNGEON, FIND_BOW, MAKE_ARROW

    World:
    - Player: Starts on floor 1 at the Ladder Up tile. Inventory: `{"sword": 1, "bow": 1, "arrows": 10}`. All stats maximum (health 9, food 9, drink 9, energy 9, mana 9). Attributes: strength=1, dexterity=1, intelligence=1.
    - Map: One Orc Mage (ranged mob type_id=2) is placed using `builder.add_mobs_randomly_near(rng, 1, "ranged", 2, n=1, target_pos=player_pos, min_dist=5, max_dist=10, on_blocks=[BlockType.PATH])`. No other mobs are manually placed. All floor generation remains default.
    - Mechanics: `passive_spawn_multiplier = 0.0`, `melee_spawn_multiplier = 0.0`, `ranged_spawn_multiplier = 0.0`. All other TaskParams keep default values (`needs_depletion_multiplier=1.0`, `health_recover_multiplier=1.0`, etc.).
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.FIRE_BOW,
            Achievement.DEFEAT_ORC_MAGE,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.FIND_BOW,
            Achievement.MAKE_ARROW,
        ]
        self.label = "FIRE_BOW, DEFEAT_ORC_MAGE"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=0.0,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            # All other parameters remain at default (1.0)
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, mob_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(1)
        builder.set_player_inventory({"sword": 1, "bow": 1, "arrows": 10})

        # Place a single Orc Mage (ranged type_id=2) on PATH blocks 5-10 tiles away
        builder.add_mobs_randomly_near(
            mob_rng,
            level=1,
            mob_name="ranged",
            type_id=2,  # Orc Mage
            n=1,
            target_pos=builder.player_position,
            min_dist=5,
            max_dist=10,
            on_blocks=[BlockType.PATH],
        )

        return builder.build(rng)</data>
