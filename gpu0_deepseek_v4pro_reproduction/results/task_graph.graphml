92156862745098, "collect_iron": 50.98039215686274, "collect_diamond": 27.205882352941178, "make_iron_pickaxe": 12.254901960784315, "make_iron_sword": 12.254901960784315, "place_torch": 95.34313725490196, "collect_sapphire": 23.03921568627451, "collect_ruby": 29.65686274509804, "make_diamond_pickaxe": 4.6568627450980395, "make_diamond_sword": 2.2058823529411766, "enter_gnomish_mines": 82.1078431372549, "enter_dungeon": 100.0, "defeat_orc_solider": 97.79411764705883, "defeat_orc_mage": 92.15686274509804, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 96.32352941176471, "drink_potion": 70.58823529411765}, "average_episode_length": 726.7205882352941, "mean_return_percentage": 17.468866457153936, "mean_return": 39.479638193167894, "lp": NaN, "priority_score": 0.15763168012302958}]</data>
