      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Isolate and robustify the floor‑1 clearing skill to enter the Gnomish Mines without overworld dependencies.

Description: The agent is placed directly on the dungeon floor (level 1) already equipped with gear typical of a competent overworld run. Starting inventory includes a stone sword, stone pickaxe, bow, 10 arrows, and 20 torches. All survival needs (hunger, thirst, fatigue) are disabled (`needs_depletion_multiplier = 0.0`) so that the agent can focus exclusively on combat, torch placement, and navigating the maze. The agent must find and defeat 8 hostile mobs (Orc Soldiers and Orc Mages) on floor 1 to satisfy the ladder‑down requirement (`monsters_killed_to_clear_level = 8`), locate the ladder down, and use the `DESCEND` action to reach floor 2 (Gnomish Mines). No overworld visitation or crafting is needed. This variation removes reliance on any specific overworld seed, forcing the agent to learn a general path‑finding and combat strategy on the dungeon map, thereby improving its global ability to enter the mines.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, COLLECT_WOOD, PLACE_TABLE, COLLECT_STONE, FIND_BOW

World:
- Player: `set_starting_floor(1)`. Inventory: `{"stone_pickaxe": 1, "stone_sword": 1, "bow": 1, "arrows": 10, "torch": 20}`. All stats at default maximum (health, food, drink, energy = 9). Attributes: Strength 1, Dexterity 1, Intelligence 1.
- Map: No manual block placements. The dungeon (level 1) and all other levels are generated procedurally as in the original Craftax game.
- Mechanics:
  - monsters_killed_to_clear_level = 8
  - mob_health_multiplier = 1.0
  - mob_damage_multiplier = 1.0
  - melee_spawn_multiplier = 1.0
  - ranged_spawn_multiplier = 1.0
  - passive_spawn_multiplier = 1.0
  - needs_depletion_multiplier = 0.0
  - health_recover_multiplier = 1.0
  - health_loss_multiplier = 1.0
  - mana_recover_multiplier = 1.0
  - growing_plants_age = 600
  - All other parameters left at their default values.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.COLLECT_WOOD,
            Achievement.PLACE_TABLE,
            Achievement.COLLECT_STONE,
            Achievement.FIND_BOW,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            needs_depletion_multiplier=0.0,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            growing_plants_age=600,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up‑ladder position
        builder.set_starting_floor(1)

        # Equip starting inventory: stone sword (tier 2), stone pickaxe (tier 2), bow, 10 arrows, 20 torches
        builder.set_player_inventory({
            "pickaxe": 2,
            "sword": 2,
            "bow": 1,
            "arrows": 10,
            "torches": 20,
        })

        # No manual block placements; standard dungeon generation is used

        state = builder.build(rng)

        # Mark completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
