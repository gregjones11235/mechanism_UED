      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Clear the Dungeon under moderately increased survival pressure and descend to the Gnomish Mines.

Description: The agent starts on floor 1 (the Dungeon) already equipped with a Stone Sword, 5 Wood, and 5 Stone – simulating a smooth transition from the Overworld. The map uses normal procedural generation; the agent must defeat 8 hostile mobs (Orc Soldiers and Orc Mages) on floor 1 to unlock the Ladder Down, then descend to floor 2 (Gnomish Mines). The only change from the parent task is that survival needs depletion is raised to 0.75 (from 0.5) to push the agent towards faster and more resource‑efficient combat, while mob damage stays at 0.75 to keep the combat encounter pressure learnable. The episode succeeds when the agent reaches floor 2 (ENTER_GNOMISH_MINES). All previous successful achievements (ENTER_DUNGEON, MAKE_STONE_SWORD) are treated as completed by the starting state.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: ENTER_DUNGEON, MAKE_STONE_SWORD

World:
- Player: Starts on floor 1 (Dungeon), at the Ladder‑Up position (centre of the level). Inventory: stone_sword = 1, wood = 5, stone = 5. All other item counts zero. Attributes: strength = 1, dexterity = 1, intelligence = 1. Health = 9, food = 9, drink = 9, energy = 9, mana = 9. No weapon or armour enchantments, no learned spells.
- Map: No manual block modifications; all nine floors use the default procedural generation (floor 1: rooms, corridors, chests, fountains, torches in corners).
- Mechanics:
  - monsters_killed_to_clear_level = 8 (default, applies to all floors except floor 0)
  - needs_depletion_multiplier = 0.75
  - mob_damage_multiplier = 0.75
  - All other TaskParams remain at their default values (e.g., mob_health_multiplier = 1.0, spawn multipliers = 1.0, health_recover/loss/mana_recover multipliers = 1.0, growing_plants_age = 600).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.MAKE_STONE_SWORD,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
            needs_depletion_multiplier=0.75,
            mob_damage_multiplier=0.75,
            # All other multipliers default to 1.0
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Equip the minimal starting inventory: stone sword, wood, stone
        builder.set_player_inventory({
            "sword": 2,   # Stone sword (tier 2)
            "wood": 5,
            "stone": 5,
        })

        # Build the initial state
        state = builder.build(rng)

        # Mark the pre-completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
