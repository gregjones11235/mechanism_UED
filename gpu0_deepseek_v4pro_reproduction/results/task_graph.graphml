7, "collect_sapphire": 17.59259259259259, "collect_ruby": 17.59259259259259, "make_diamond_pickaxe": 2.05761316872428, "make_diamond_sword": 1.7489711934156378, "enter_gnomish_mines": 70.67901234567901, "enter_dungeon": 100.0, "defeat_orc_solider": 93.72427983539094, "defeat_orc_mage": 74.07407407407408, "eat_snail": 93.00411522633745, "find_bow": 98.86831275720165, "fire_bow": 44.650205761316876, "open_chest": 98.86831275720165, "drink_potion": 67.38683127572017}, "average_episode_length": 277.57201646090533, "mean_return_percentage": 17.07640574640828, "mean_return": 38.592676986882715, "lp": NaN, "priority_score": 0.2072378448407255}, {"session": 61, "sr": 0.8225641025641026, "achievement_srs": {"collect_drink": 73.23076923076923, "make_wood_pickaxe": 23.487179487179485, "make_wood_sword": 100.0, "make_stone_pickaxe": 15.897435897435898, "make_stone_sword": 100.0, "wake_up": 14.051282051282051, "collect_coal": 39.282051282051285, "collect_iron": 38.56410256410256, "collect_diamond": 23.076923076923077, "make_iron_pickaxe": 9.23076923076923, "make_arrow": 53.02564102564103, "make_torch": 85.74358974358974, "place_torch": 81.74358974358974, "collect_sapphire": 19.897435897435898, "collect_ruby": 20.0, "make_diamond_pickaxe": 2.6666666666666665, "make_diamond_sword": 2.871794871794872, "enter_gnomish_mines": 82.25641025641026, "enter_dungeon": 100.0, "defeat_orc_solider": 96.41025641025641, "defeat_orc_mage": 75.6923076923077, "eat_snail": 93.74358974358974, "find_bow": 99.07692307692308, "fire_bow": 52.717948717948715, "open_chest": 99.07692307692308, "drink_potion": 71.38461538461539}, "average_episode_length": 285.2923076923077, "mean_return_percentage": 18.63997794701611, "mean_return": 42.12635016025641, "lp": NaN, "priority_score": 0.1459523997370151}]</data>
