"place_furnace": 92.68738574040219, "collect_coal": 76.78244972577697, "collect_iron": 62.52285191956124, "make_iron_pickaxe": 11.517367458866545, "make_iron_sword": 31.809872029250457, "make_arrow": 75.68555758683729, "make_torch": 63.80255941499086, "place_torch": 60.877513711151735, "make_iron_armour": 4.204753199268739, "enter_dungeon": 88.84826325411335}, "average_episode_length": 520.0877513711151, "mean_return_percentage": 15.43109994580253, "mean_return": 34.874285877513714, "lp": NaN, "priority_score": 0.09908124421391067}]</data>
