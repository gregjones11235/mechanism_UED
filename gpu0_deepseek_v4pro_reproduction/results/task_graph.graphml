4716981132075, "make_arrow": 31.132075471698112, "make_torch": 61.320754716981135, "place_torch": 30.660377358490567, "collect_sapphire": 8.333333333333334, "collect_ruby": 11.163522012578616, "make_diamond_pickaxe": 1.5723270440251573, "make_diamond_sword": 0.7861635220125787, "enter_dungeon": 100.0, "defeat_orc_solider": 82.38993710691824, "find_bow": 98.74213836477988, "fire_bow": 28.459119496855347, "open_chest": 98.74213836477988, "drink_potion": 25.0}, "average_episode_length": 666.5345911949686, "mean_return_percentage": 13.111331277480936, "mean_return": 29.63160868710692, "lp": NaN, "priority_score": 0.14508919742098808}, {"session": 40, "sr": 0.9318568994889267, "achievement_srs": {"collect_wood": 3.6626916524701874, "place_table": 3.492333901192504, "collect_sapling": 3.577512776831346, "collect_drink": 16.43952299829642, "make_wood_pickaxe": 14.054514480408859, "place_plant": 3.577512776831346, "collect_stone": 3.4071550255536627, "place_stone": 3.3219761499148213, "eat_plant": 2.1294718909710393, "make_stone_pickaxe": 9.965928449744464, "wake_up": 1.788756388415673, "place_furnace": 3.4071550255536627, "collect_coal": 22.402044293015333, "collect_iron": 22.146507666098806, "collect_diamond": 9.965928449744464, "make_iron_pickaxe": 4.6848381601362865, "make_iron_sword": 4.514480408858603, "make_arrow": 28.960817717206133, "make_torch": 64.90630323679727, "place_torch": 49.57410562180579, "collect_sapphire": 9.369676320272573, "collect_ruby": 9.114139693356048, "make_diamond_pickaxe": 1.8739352640545144, "make_diamond_sword": 1.362862010221465, "enter_dungeon": 100.0, "defeat_orc_solider": 93.18568994889267, "find_bow": 99.48892674616695, "fire_bow": 27.853492333901194, "open_chest": 99.48892674616695, "drink_potion": 23.594548551959114}, "average_episode_length": 255.6473594548552, "mean_return_percentage": 14.146645351532467, "mean_return": 31.97141849446337, "lp": NaN, "priority_score": 0.06349961836381107}]</data>
