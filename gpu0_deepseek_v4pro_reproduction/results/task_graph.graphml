      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Teach the agent to reliably clear a full dungeon floor (8 kills) while descending to the Gnomish Mines, using the same autonomous preparation pipeline learned earlier.

Description: The agent begins on the Overworld (floor 0) at the default centre spawn with no items, tools, or resources. It must autonomously collect wood, craft a wood pickaxe, mine stone and coal, place a crafting table, craft a stone sword, and optionally craft torches. The ladder down to the Dungeon is pre‑cleared (monsters_killed[0] = 10) so the agent can descend as soon as it is ready. In the Dungeon (floor 1), the agent must defeat **8** hostile mobs (Orc Soldiers or Orc Mages, standard behaviour and full damage) before the ladder down becomes usable. The task requires both MAKE_STONE_SWORD and ENTER_GNOMISH_MINES to be achieved for success. All other crafting steps are permitted but not required; survival mechanics use default rates. The kill‑count increase (from the parent’s 4 to 8) forces the agent to practice sustained combat and exploration in the dungeon, directly addressing the global drop‑off in ENTER_GNOMISH_MINES under original Craftax conditions.

Relevant Achievements: MAKE_STONE_SWORD, ENTER_GNOMISH_MINES

Completed Achievements: [none]

World:
- Player: Starting floor: 0 (Overworld). Inventory: empty. Attributes: strength=1, dexterity=1, intelligence=1. Health/Food/Drink/Energy/Mana all 9/9. Enchantments and spells at default (none).
- Map: No manual block modifications; default Overworld and Dungeon generation are used. However, to guarantee the overworld ladder is immediately usable, the WorldBuilder must call builder.set_monsters_killed(level=0, count=10) before build.
- Mechanics:
  - monsters_killed_to_clear_level = 8     # Applies globally; floor 0 overridden to 10 via builder
  - needs_depletion_multiplier = 1.0
  - mob_damage_multiplier = 1.0
  - health_recover_multiplier = 1.0
  - health_loss_multiplier = 1.0
  - mana_recover_multiplier = 1.0
  - All spawn multipliers (passive, melee, ranged) = 1.0
  - All other TaskParams at default.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.MAKE_STONE_SWORD,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = []  # none
        self.label = "MAKE_STONE_SWORD, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
            # all other multipliers remain at default 1.0
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld) at the default spawn
        builder.set_starting_floor(0)

        # Pre‑unlock the Overworld ladder down by setting kills to 10
        builder.set_monsters_killed(level=0, count=10)

        # No inventory set – agent starts with nothing
        # No block/mob placements – default procedural generation

        state = builder.build(rng)

        # No pre‑completed achievements to mark
        return state</data>
      <data key="d4">[{"session": 151, "sr": 0.3922413793103448, "achievement_srs": {"collect_wood": 100.0, "place_table": 100.0, "eat_cow": 96.12068965517241, "collect_sapling": 99.56896551724138, "collect_drink": 99.56896551724138, "make_wood_pickaxe": 98.70689655172414, "make_wood_sword": 98.27586206896552, "place_plant": 99.56896551724138, "defeat_zombie": 75.86206896551724, "collect_stone": 98.70689655172414, "place_stone": 98.70689655172414, "eat_plant": 22.844827586206897, "defeat_skeleton": 66.8103448275862, "make_stone_pickaxe": 86.20689655172414, "make_stone_sword": 93.96551724137932, "wake_up": 100.0, "place_furnace": 98.27586206896552, "collect_coal": 94.82758620689656, "collect_iron": 81.89655172413794, "collect_diamond": 24.56896551724138, "make_iron_pickaxe": 28.448275862068964, "make_iron_sword": 48.706896551724135, "make_arrow": 95.6896551724138, "make_torch": 95.6896551724138, "place_torch": 94.82758620689656, "collect_sapphire": 22.413793103448278, "collect_ruby": 21.982758620689655, "make_diamond_pickaxe": 6.4655172413793105, "make_diamond_sword": 3.4482758620689653, "make_iron_armour": 7.327586206896552, "enter_gnomish_mines": 40.08620689655172, "enter_dungeon": 95.6896551724138, "defeat_orc_solider": 92.24137931034483, "defeat_orc_mage": 83.1896551724138, "eat_snail": 92.67241379310344, "find_bow": 95.25862068965517, "fire_bow": 91.8103448275862, "open_chest": 95.25862068965517, "drink_potion": 79.3103448275862}, "average_episode_length": 1256.1810344827586, "mean_return_percentage": 23.463540052472727, "mean_return": 53.027600518588365, "lp": NaN, "priority_score": 0.23838807966706305}]</data>
