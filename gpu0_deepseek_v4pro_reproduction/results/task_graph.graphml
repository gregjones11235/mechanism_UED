w": 100.0, "fire_bow": 100.0, "open_chest": 90.61662198391421, "drink_potion": 65.95174262734585}, "average_episode_length": 765.8418230563003, "mean_return_percentage": 20.15355633808038, "mean_return": 45.54703732406166, "lp": NaN, "priority_score": 0.24240812483378735}, {"session": 74, "sr": 0.6467065868263473, "achievement_srs": {"collect_wood": 94.61077844311377, "place_table": 78.74251497005989, "eat_cow": 73.35329341317366, "collect_sapling": 98.80239520958084, "collect_drink": 92.51497005988024, "make_wood_pickaxe": 100.0, "make_wood_sword": 100.0, "place_plant": 98.80239520958084, "defeat_zombie": 38.32335329341317, "collect_stone": 86.82634730538922, "place_stone": 85.62874251497006, "eat_plant": 15.568862275449101, "defeat_skeleton": 34.131736526946106, "make_stone_pickaxe": 52.395209580838326, "make_stone_sword": 100.0, "wake_up": 92.81437125748504, "place_furnace": 85.02994011976048, "collect_coal": 70.95808383233533, "collect_iron": 61.67664670658683, "collect_diamond": 32.33532934131737, "make_iron_pickaxe": 17.664670658682635, "make_iron_sword": 25.748502994011975, "make_arrow": 100.0, "make_torch": 100.0, "place_torch": 100.0, "collect_sapphire": 26.646706586826348, "collect_ruby": 23.05389221556886, "make_diamond_pickaxe": 4.790419161676646, "make_diamond_sword": 3.2934131736526946, "make_iron_armour": 2.694610778443114, "enter_gnomish_mines": 64.67065868263474, "enter_dungeon": 97.60479041916167, "defeat_orc_solider": 96.40718562874251, "defeat_orc_mage": 92.21556886227545, "eat_snail": 89.22155688622755, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 93.7125748502994, "drink_potion": 80.83832335329342}, "average_episode_length": 860.056886227545, "mean_return_percentage": 21.759774836389166, "mean_return": 49.17709113023952, "lp": NaN, "priority_score": 0.22847717738176343}]</data>
