place_torch": 78.24042981867025, "collect_sapphire": 1.6789791806581598, "collect_ruby": 1.4103425117528543, "make_diamond_pickaxe": 0.1343183344526528, "make_diamond_sword": 0.2686366689053056, "enter_dungeon": 27.871054398925452, "defeat_orc_solider": 2.1490933512424446, "eat_snail": 8.19341840161182, "find_bow": 24.37877770315648, "fire_bow": 11.820013431833445, "open_chest": 24.37877770315648, "drink_potion": 4.633982538616521}, "average_episode_length": 187.82337139019475, "mean_return_percentage": 16.80834020835686, "mean_return": 37.986848870886504, "lp": NaN, "priority_score": 0.03495073115089342}]</data>
