      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to clear the Dungeon floor by defeating multiple Orc enemies and then descend to the Gnomish Mines.

Description: The agent starts on floor 1 (the Dungeon) with a stone sword, wooden pickaxe, 5 wood, 10 stone, 1 bow, and 10 arrows. No torches are pre‑placed. The agent must place a crafting table (2 wood), mine coal from four coal blocks placed near its spawn, craft a torch (1 wood + 1 coal), and place the torch to fight in the dark. Exactly four hostile mobs are present on the floor: two Orc Soldiers (melee, type_id 2) and two Orc Mages (ranged, type_id 2), all placed randomly within Manhattan distance 4‑12 from the player’s spawn. All dynamic mob spawns are disabled. Survival needs (hunger, thirst, fatigue) are turned off, natural health regeneration is active, and `monsters_killed_to_clear_level` is set to 4. The episode is considered successful when the agent achieves the `ENTER_GNOMISH_MINES` achievement, which requires killing all four placed mobs, finding the ladder down, and descending. The agent will earn incidental achievements for defeating Orc types and crafting torches.

Relevant Achievements:
- ENTER_GNOMISH_MINES

Completed Achievements:
- ENTER_DUNGEON
- MAKE_WOOD_PICKAXE
- MAKE_STONE_SWORD

World:
- Player: Start on floor 1. Inventory: `{"sword": 2, "pickaxe": 1, "wood": 5, "stone": 10, "bow": 1, "arrows": 10}` (stone sword, wooden pickaxe, 5 wood, 10 stone, 1 bow, 10 arrows). No other items.
- Map:
  * Use `place_randomly_near` to place exactly 4 coal blocks (`BlockType.COAL`) on floor 1, targeting the player’s spawn point, with `min_dist=2`, `max_dist=6`, `on_blocks=[BlockType.STONE, BlockType.PATH]`.
  * Use `add_mobs_randomly_near` to place 2 **Orc Soldiers** (melee mob, type_id=2) on floor 1, targeting the player’s spawn point, with `min_dist=4`, `max_dist=12`, `on_blocks=[BlockType.GRASS, BlockType.PATH, BlockType.STONE]`.
  * Use `add_mobs_randomly_near` to place 2 **Orc Mages** (ranged mob, type_id=2) on floor 1, targeting the player’s spawn point, with `min_dist=4`, `max_dist=12`, `on_blocks=[BlockType.GRASS, BlockType.PATH, BlockType.STONE]`.
  * No other manual block or mob modifications.
- Mechanics:
  * `melee_spawn_multiplier = 0.0`
  * `ranged_spawn_multiplier = 0.0`
  * `passive_spawn_multiplier = 0.0`
  * `needs_depletion_multiplier = 0.0`
  * `health_recover_multiplier = 1.0`
  * `mob_health_multiplier = 1.0`
  * `mob_damage_multiplier = 1.0`
  * `monsters_killed_to_clear_level = 4`
  * All other `TaskParams` at default values.
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_GNOMISH_MINES]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            passive_spawn_multiplier=0.0,
            needs_depletion_multiplier=0.0,
            health_recover_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            monsters_killed_to_clear_level=4,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, coal_rng, soldier_rng, mage_rng = jax.random.split(rng, 5)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon)
        builder.set_starting_floor(1)
        player_spawn = builder.player_position

        # Set inventory: stone sword (2), wood pickaxe (1), wood=5, stone=10, bow=1, arrows=10
        builder.set_player_inventory({
            "sword": 2,
            "pickaxe": 1,
            "wood": 5,
            "stone": 10,
            "bow": 1,
            "arrows": 10,
        })

        # Place 4 coal blocks near the player
        builder.place_randomly_near(
            coal_rng,
            level=1,
            block_type=BlockType.COAL,
            n=4,
            target_pos=player_spawn,
            min_dist=2,
            max_dist=6,
            on_blocks=[BlockType.STONE, BlockType.PATH],
        )

        # Place 2 Orc Soldiers (melee, type_id=2)
        builder.add_mobs_randomly_near(
            soldier_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=2,
            target_pos=player_spawn,
            min_dist=4,
            max_dist=12,
            on_blocks=[BlockType.GRASS, BlockType.PATH, BlockType.STONE],
        )

        # Place 2 Orc Mages (ranged, type_id=2)
        builder.add_mobs_randomly_near(
            mage_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=2,
            target_pos=player_spawn,
            min_dist=4,
            max_dist=12,
            on_blocks=[BlockType.GRASS, BlockType.PATH, BlockType.STONE],
        )

        return builder.build(rng)</data>
