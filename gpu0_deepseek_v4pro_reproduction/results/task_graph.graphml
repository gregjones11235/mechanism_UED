      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Teach the agent to reach the Gnomish Mines while managing standard survival needs (hunger/thirst/fatigue) in the dungeon.

Description: The agent starts on floor 1 (Dungeon) at the up‑ladder spawn position, holding only a stone pickaxe and stone sword. No arrows, bow, torches, food, or other resources are provided. The ladder to floor 2 is locked until 8 orcs are killed. To survive and fight effectively, the agent must source food (snails, bats) and water (fountains), as metabolic rates are at the default Craftax level (needs_depletion_multiplier = 1.0). Crafting torches and arrows from coal and chest loot remains essential. The episode ends successfully when the agent meets the kill requirement and descends to floor 2, unlocking `ENTER_GNOMISH_MINES`.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, ENTER_DUNGEON

World:
- Player: Starts on floor 1 (Dungeon) at the up‑ladder spawn position. Inventory: stone_pickaxe=1, stone_sword=1. All other equipment empty, enchantments 0, spells locked. Attributes dexterity=1, strength=1, intelligence=1. Status bars 9/9. No adjustments to monsters_killed[1]; it starts at 0.
- Map: Use default dungeon generation for floor 1. Additionally, place 5 coal blocks randomly within a Manhattan distance of 2 to 10 tiles from the player’s starting position on floor 1, only on tiles of type PATH. Place them using `place_randomly_near` with `rng, level=1, block_type=BlockType.COAL, target_pos=player_start_pos, min_dist=2, max_dist=10, n=5, on_blocks=[BlockType.PATH]`. No other block modifications; all other levels remain default.
- Mechanics:
  - monsters_killed_to_clear_level = 8  (default)
  - needs_depletion_multiplier = 1.0   (normal survival pressure)
  - mob_damage_multiplier = 1.0
  - health_recover_multiplier = 1.0
  - health_loss_multiplier = 1.0
  - mana_recover_multiplier = 1.0
  - melee_spawn_multiplier = 1.0
  - ranged_spawn_multiplier = 1.0
  - passive_spawn_multiplier = 1.0
  - melee_trigger_distance = 10 (default)
  - growing_plants_age = 600 (default)
  - All other TaskParams at default.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.ENTER_DUNGEON,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        # All stated values are the defaults, so no overrides are needed.
        return TaskParams()

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)
        rng, coal_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up‑ladder position
        builder.set_starting_floor(1)

        # Equip starting inventory: stone pickaxe (tier 2) and stone sword (tier 2)
        builder.set_player_inventory({
            "pickaxe": 2,
            "sword": 2,
        })

        # Ensure the Dungeon kill counter is zero
        builder.set_monsters_killed(level=1, count=0)

        # Get player spawn position after floor is set
        player_spawn = builder.player_position

        # Place 5 coal blocks near spawn on PATH tiles
        builder.place_randomly_near(
            coal_rng,
            level=1,
            block_type=BlockType.COAL,
            target_pos=player_spawn,
            min_dist=2,
            max_dist=10,
            n=5,
            on_blocks=[BlockType.PATH],
        )

        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
