": 3.62381363244176, "make_diamond_sword": 3.882657463330457, "enter_gnomish_mines": 54.702329594478, "enter_dungeon": 100.0, "defeat_orc_solider": 97.92924935289042, "defeat_orc_mage": 79.55133735979292, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 93.78774805867127, "drink_potion": 75.40983606557377}, "average_episode_length": 238.45642795513373, "mean_return_percentage": 14.84148619022349, "mean_return": 33.54175878990509, "lp": NaN, "priority_score": 0.24955314636327022}, {"session": 141, "sr": 0.5390428211586902, "achievement_srs": {"collect_wood": 35.43240973971452, "place_table": 31.654072208228378, "collect_sapling": 35.012594458438286, "collect_drink": 73.55163727959697, "make_wood_pickaxe": 47.60705289672544, "make_wood_sword": 100.0, "place_plant": 34.76070528967254, "defeat_zombie": 1.5113350125944585, "collect_stone": 36.18807724601176, "place_stone": 35.768261964735515, "defeat_skeleton": 1.1754827875734677, "make_stone_pickaxe": 23.761544920235096, "wake_up": 76.15449202350966, "place_furnace": 35.51637279596977, "collect_coal": 49.20235096557515, "collect_iron": 44.75230898404702, "collect_diamond": 23.845507976490346, "make_iron_pickaxe": 10.15952980688497, "make_iron_sword": 10.9151973131822, "make_arrow": 100.0, "make_torch": 100.0, "place_torch": 99.07640638119227, "collect_sapphire": 22.418136020151135, "collect_ruby": 22.418136020151135, "make_diamond_pickaxe": 2.770780856423174, "make_diamond_sword": 3.022670025188917, "enter_gnomish_mines": 56.67506297229219, "enter_dungeon": 100.0, "defeat_orc_solider": 98.15281276238456, "defeat_orc_mage": 78.58942065491183, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 93.03106633081444, "drink_potion": 72.879932829555}, "average_episode_length": 231.51721242653232, "mean_return_percentage": 14.947422373646745, "mean_return": 33.78117456444165, "lp": NaN, "priority_score": 0.24847565811597053}, {"session": 144, "sr": 0.5386493083807974, "achievement_srs": {"collect_wood": 39.218877135882835, "place_table": 35.31326281529699, "collect_sapling": 39.05614320585842, "collect_drink": 73.14890154597234, "make_wood_pickaxe": 51.50528885272579, "make_wood_sword": 100.0, "place_plant": 38.97477624084622, "defeat_zombie": 1.7087062652563059, "collect_stone": 38.64930838079739, "place_stone": 37.42880390561432, "defeat_skeleton": 1.9528071602929211, "make_stone_pickaxe": 21.887713588283155, "wake_up": 76.07811228641172, "place_furnace": 38.07973962571196, "collect_coal": 50.935720097640356, "collect_iron": 46.29780309194467, "collect_diamond": 27.25793327908869, "make_iron_pickaxe": 10.496338486574452, "make_iron_sword": 11.960943856794142, "make_arrow": 100.0, "make_torch": 100.0, "place_torch": 98.12855980471929, "collect_sapphire": 21.31814483319772, "collect_ruby": 21.643612693246542, "make_diamond_pickaxe": 3.742880390561432, "make_diamond_sword": 3.661513425549227, "enter_gnomish_mines": 57.28234336859235, "enter_dungeon": 100.0, "defeat_orc_solider": 97.15215622457282, "defeat_orc_mage": 79.57689178193654, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 94.22294548413345, "drink_potion": 74.206672091131}, "average_episode_length": 230.40032546786006, "mean_return_percentage": 15.127028154860056, "mean_return": 34.187083629983725, "lp": NaN, "priority_score": 0.24850623096168603}, {"session": 150, "sr": 0.5885372112917023, "achievement_srs": {"collect_wood": 44.31137724550898, "place_table": 39.948674080410605, "collect_sapling": 43.199315654405474, "collect_drink": 80.41060735671515, "make_wood_pickaxe": 54.57656116338751, "make_wood_sword": 100.0, "place_plant": 42.94268605645851, "defeat_zombie": 1.7108639863130881, "collect_stone": 44.31137724550898, "place_stone": 44.05474764756202, "defeat_skeleton": 1.7108639863130881, "make_stone_pickaxe": 24.721984602224122, "wake_up": 75.53464499572284, "place_furnace": 44.140290846877676, "collect_coal": 52.951240376390075, "collect_iron": 48.93071000855432, "collect_diamond": 28.314798973481608, "make_iron_pic