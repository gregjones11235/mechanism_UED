 6.172839506172839, "enter_gnomish_mines": 61.72839506172839, "enter_dungeon": 100.0, "defeat_orc_solider": 92.5925925925926, "defeat_orc_mage": 73.66255144032922, "eat_snail": 87.65432098765432, "find_bow": 96.70781893004116, "fire_bow": 93.4156378600823, "open_chest": 96.70781893004116, "drink_potion": 77.77777777777777}, "average_episode_length": 1147.9341563786008, "mean_return_percentage": 19.971956769638368, "mean_return": 45.136622299382715, "lp": NaN, "priority_score": 0.2362444749276025}]</data>
