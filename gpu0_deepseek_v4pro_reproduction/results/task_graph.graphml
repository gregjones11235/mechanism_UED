      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to use torches to light a dark level and defeat a Gnome Archer with a bow.

Description: The agent starts on Floor 2 (Gnomish Mines) at the ladder‑up arrival point. Its inventory contains exactly one bow (`"bow": 1`), 10 arrows (`"arrows": 10`), and 5 torches (`"torches": 5`). All other item counts are zero. All natural mob spawns are suppressed (`melee_spawn_multiplier = 0.0`, `ranged_spawn_multiplier = 0.0`, `passive_spawn_multiplier = 0.0`), so the only hostile entity is a single Gnome Archer placed on Floor 2. The Gnome Archer (`mob_name = "ranged"`, `type_id = 1`) is spawned on a walkable `BlockType.PATH` tile using `add_mobs_randomly_near` with `target_pos = None` (defaulting to the player’s start location), `min_dist = 4`, `max_dist = 8`, and `on_blocks = [BlockType.PATH]`. Survival demands (hunger, thirst, fatigue) are disabled (`needs_depletion_multiplier = 0.0`), and health regeneration is moderately boosted (`health_recover_multiplier = 2.0`) to cushion the ranged combat. The environment is naturally pitch-black (the level’s default light level is 0.0), so the agent must place torches to locate and engage the archer. The task is considered successful only when the agent has placed a torch, fired the bow (triggering `FIRE_BOW`), and defeated the Gnome Archer.

Relevant Achievements: PLACE_TORCH, FIRE_BOW, DEFEAT_GNOME_ARCHER
Completed Achievements: ENTER_GNOMISH_MINES, FIND_BOW, MAKE_ARROW, MAKE_TORCH
World:
- Player: Starting floor 2; inventory `{"bow": 1, "arrows": 10, "torches": 5}` (all other items 0). Stats default.
- Map: On Floor 2, add one Gnome Archer using `add_mobs_randomly_near(rng, level=2, mob_name="ranged", type_id=1, n=1, target_pos=None, min_dist=4, max_dist=8, on_blocks=[BlockType.PATH])`.
- Mechanics: 
    "needs_depletion_multiplier": 0.0,
    "health_recover_multiplier": 2.0,
    "melee_spawn_multiplier": 0.0,
    "passive_spawn_multiplier": 0.0,
    "ranged_spawn_multiplier": 0.0
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.PLACE_TORCH,
            Achievement.FIRE_BOW,
            Achievement.DEFEAT_GNOME_ARCHER,
        ]
        self.completed_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
            Achievement.FIND_BOW,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_TORCH,
        ]
        self.label = "PLACE_TORCH, FIRE_BOW, DEFEAT_GNOME_ARCHER"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.0,
            health_recover_multiplier=2.0,
            melee_spawn_multiplier=0.0,
            passive_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, mob_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines)
        builder.set_starting_floor(2)

        # Equip bow, arrows, torches
        builder.set_player_inventory({"bow": 1, "arrows": 10, "torches": 5})

        # Place Gnome Archer nearby
        builder.add_mobs_randomly_near(
            mob_rng,
            level=2,
            mob_name="ranged",
            type_id=1,  # Gnome Archer
            n=1,
            target_pos=None,
            min_dist=4,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        state = builder.build(rng)

        # Set completed achievements (they are already "earned" before the episode)
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        # Make floor 2 completely dark (pitch-black) to force torch usage
        light_map = state.light_map.at[2].set(0.0)
        state = state.replace(light_map=light_map)

        return state</data>
