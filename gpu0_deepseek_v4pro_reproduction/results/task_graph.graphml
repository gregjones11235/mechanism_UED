: 50.52910052910053, "eat_plant": 5.026455026455026, "defeat_skeleton": 24.603174603174605, "make_stone_pickaxe": 43.91534391534392, "make_stone_sword": 56.34920634920635, "wake_up": 95.23809523809524, "place_furnace": 50.0, "collect_coal": 71.16402116402116, "collect_iron": 64.55026455026454, "collect_diamond": 33.597883597883595, "make_iron_pickaxe": 15.60846560846561, "make_iron_sword": 26.19047619047619, "make_torch": 92.85714285714286, "place_torch": 91.7989417989418, "collect_sapphire": 24.074074074074073, "collect_ruby": 27.77777777777778, "make_diamond_pickaxe": 2.9100529100529102, "make_diamond_sword": 2.6455026455026456, "make_iron_armour": 2.1164021164021163, "enter_gnomish_mines": 64.55026455026454, "enter_dungeon": 100.0, "defeat_orc_solider": 99.47089947089947, "defeat_orc_mage": 96.29629629629629, "eat_snail": 87.83068783068784, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 99.2063492063492, "drink_potion": 78.57142857142857}, "average_episode_length": 744.3465608465608, "mean_return_percentage": 19.90544577743831, "mean_return": 44.98630745701058, "lp": NaN, "priority_score": 0.22882898015173148}]</data>
