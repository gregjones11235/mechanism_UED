- Player: Starts on floor 0 with inventory `{"pickaxe": 1}` (wood pickaxe).
- Map: 
  - Place a CRAFTING_TABLE at position (24,23) (assuming default spawn is (24,24)).
  - Place 3 TREE blocks randomly within 2-6 tiles of spawn on GRASS.
  - Place 3 STONE blocks randomly within 2-6 tiles of spawn on GRASS.
  - Add 2 COW passive mobs (type_id=0) randomly within 4-8 tiles of spawn on GRASS.
- Mechanics: "needs_depletion_multiplier = 0.5", "melee_spawn_multiplier = 0.5", "ranged_spawn_multiplier = 0.1". All other parameters at default values.</data>
      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Craft a stone pickaxe by mining stone with a provided wood pickaxe.
    Description: The player must collect wood from a tree, stone from a stone block, and then craft a stone pickaxe at the pre-placed crafting table. The player starts on Floor 0 (overworld) at the default spawn (center, e.g., (24,24) in a 49×49 map) with a wood pickaxe already in inventory. A crafting table is placed immediately adjacent to spawn (one tile left, at (24,23)). Nearby trees and stone blocks are placed to ensure quick acquisition of resources: 3 TREE blocks (on GRASS) within 2-6 tiles, and 3 STONE blocks (on GRASS) within 2-6 tiles. Two COW passive mobs are placed 4-8 tiles away for optional food. Hostile mob spawn rates are moderately low (melee 0.5×, ranged 0.1×) to give the agent light combat training without overwhelming, while survival need depletion is halved (0.5×). The task terminates successfully when the agent crafts the stone pickaxe.
    Relevant Achievements: COLLECT_WOOD, COLLECT_STONE, MAKE_STONE_PICKAXE
    Completed Achievements: PLACE_TABLE, MAKE_WOOD_PICKAXE
    World:
    - Player: Starts on floor 0 with inventory `{"pickaxe": 1}` (wood pickaxe).
    - Map: 
    - Place a CRAFTING_TABLE at position (24,23) (assuming default spawn is (24,24)).
    - Place 3 TREE blocks randomly within 2-6 tiles of spawn on GRASS.
    - Place 3 STONE blocks randomly within 2-6 tiles of spawn on GRASS.
    - Add 2 COW passive mobs (type_id=0) randomly within 4-8 tiles of spawn on GRASS.
    - Mechanics: "needs_depletion_multiplier = 0.5", "melee_spawn_multiplier = 0.5", "ranged_spawn_multiplier = 0.1". All other parameters at default values.
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.COLLECT_WOOD,
            Achievement.COLLECT_STONE,
            Achievement.MAKE_STONE_PICKAXE,
        ]
        self.completed_achievements = [
            Achievement.PLACE_TABLE,
            Achievement.MAKE_WOOD_PICKAXE,
        ]
        self.label = "COLLECT_WOOD, COLLECT_STONE, MAKE_STONE_PICKAXE"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.5,
            melee_spawn_multiplier=0.5,
            ranged_spawn_multiplier=0.1,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, tree_rng, stone_rng, cow_rng = jax.random.split(rng, 5)

        builder = WorldBuilder(build_rng, self.static_params, self.params)
        builder.set_starting_floor(0)

        # Give wooden pickaxe
        builder.set_player_inventory({"pickaxe": 1})

        # Place crafting table one tile left of default spawn (24,24) -&gt; (24,23)
        builder.place_block(level=0, block_type=BlockType.CRAFTING_TABLE, position=(24, 23))

        # Place 3 trees on grass within 2-6 tiles of spawn
        builder.place_randomly_near(
            tree_rng,
            level=0,
            block_type=BlockType.TREE,
            target_pos=builder.player_position,
            min_dist=2,
            max_dist=6,
            n=3,
            on_blocks=[BlockType.GRASS],
        )

        # Place 3 stone blocks on grass within 2-6 tiles of spawn
        builder.place_randomly_near(
            stone_rng,
            level=0,
            block_type=BlockType.STONE,
            target_pos=builder.player_position,
            min_dist=2,
            max_dist=6,
            n=3,
            on_blocks=[BlockType.GRASS],
        )

        # Place 2 cows for food
        builder.add_mobs_randomly_near(
            cow_rng,
            level=0,
            mob_name="passive",
            type_id=0,  # Cow
            n=2,
            target_pos=builder.player_position,
            min_dist=4,
            max_dist=8,
            on_blocks=[BlockType.GRASS, BlockType.PATH],
        )

        return builder.build(rng)</data>
