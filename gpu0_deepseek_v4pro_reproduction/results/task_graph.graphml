      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Descend from the dungeon (floor 1) to the Gnomish Mines (floor 2) with minimal survival distraction, practising the combat and navigation skills that are globally most fragile.

Description: The agent spawns on floor 1 (the dungeon) at the default ladder‑up position, carrying the equipment and supplies a competent overworld agent would have gathered. The inventory is pre‑filled with:
  - 10 wood, 10 stone, 5 coal, 0 iron
  - a stone pickaxe (pickaxe level 2), a stone sword (sword level 2), a bow, 10 arrows, 10 torches
  - all survival stats are at maximum (9 health, food, drink, energy, mana)
No enchantments or spells are known. All nine map levels are generated normally, but the player starts on floor 1 and must navigate the dungeon rooms and corridors to find and eliminate at least 8 hostile mobs (Orc Soldiers and Orc Mages) before the descending ladder unlocks. Once the required mobs are defeated, the agent must reach the ladder down and descend to floor 2; the episode terminates with success at that moment.

The only mechanics change from the default game is that survival‑needs decay at half speed (needs_depletion_multiplier = 0.5) to keep the focus on combat and progression rather than starvation. All mob spawn multipliers, health, and damage remain at standard values (1.0), and the floor‑clearing threshold is kept at 8 kills.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: ENTER_DUNGEON, COLLECT_WOOD, COLLECT_STONE, COLLECT_COAL, MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD

World:
- Player: Starting floor 1 at the dungeon’s ladder‑up position. Inventory as described above. All stats full, no enchantments, no spells learned.
- Map: No manual block modifications; all terrain, rooms, loot, and mobs are generated by the default dungeon generation for floor 1 and subsequent floors.
- Mechanics:
  - monsters_killed_to_clear_level = 8 (applies to all floors)
  - mob_health_multiplier = 1.0
  - mob_damage_multiplier = 1.0
  - melee_spawn_multiplier = 1.0
  - ranged_spawn_multiplier = 1.0
  - passive_spawn_multiplier = 1.0
  - needs_depletion_multiplier = 0.5
  - health_recover_multiplier = 1.0
  - health_loss_multiplier = 1.0
  - mana_recover_multiplier = 1.0
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.COLLECT_WOOD,
            Achievement.COLLECT_STONE,
            Achievement.COLLECT_COAL,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            needs_depletion_multiplier=0.5,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (the Dungeon) at its ladder-up position
        builder.set_starting_floor(1)

        # Equip starting inventory
        builder.set_player_inventory({
            "wood": 10,
            "stone": 10,
            "coal": 5,
            "pickaxe": 2,   # stone pickaxe
            "sword": 2,     # stone sword
            "bow": 1,
            "arrows": 10,
            "torches": 10,
        })

        # No manual block or mob placements – default generation suffices
        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
