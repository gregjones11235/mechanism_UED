      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Master movement and combat in the pitch‑black Gnomish Mines, clear the level of hostile mobs, and descend to the Sewers.

Description: The agent starts on floor 2 (the Gnomish Mines) at the ladder‑up position, having just entered from the Dungeon. Inventory is set to what a competent adventurer would bring: a stone sword (for reliable melee damage), a stone pickaxe (to mine stone/coal if desired), and 4 torches for lighting the dark tunnels. All survival stats are filled to maximum. The world uses the default procedural generation for the Gnomish Mines, complete with stalagmites, lava pockets, ore deposits, and chests. The floor is entirely devoid of natural light (base light = 0.0), so the agent must actively place torches to see mobs and navigate. The agent’s sole objective is to kill 8 hostile mobs (Gnome Warriors and Gnome Archers) to unlock the ladder down, then use that ladder to enter the Sewers (floor 3). No crafting is required, but the agent may choose to harvest resources or open chests for additional supplies. To keep the challenge learnable, survival needs (hunger, thirst, fatigue) are reduced to half speed, while all other mechanics remain at their default difficulty.

Relevant Achievements: ENTER_SEWERS

Completed Achievements: ENTER_DUNGEON, ENTER_GNOMISH_MINES, MAKE_STONE_SWORD, MAKE_STONE_PICKAXE

World:
- Player: Starts on floor 2 at the ladder‑up coordinates. Inventory: stone_sword = 1, stone_pickaxe = 1, torch = 4. All attributes default (strength=1, dexterity=1, intelligence=1). Health, food, drink, energy, mana are fully restored (9/9 each). No weapon/armour enchantments, no learned spells.
- Map: No modifications to the procedurally generated 9‑level world. All floors use standard default generation.
- Mechanics:
  - monsters_killed_to_clear_level = 8 (default; applies to all floors)
  - needs_depletion_multiplier = 0.5
  - All other TaskParams at their defaults (passive_spawn_multiplier, melee_spawn_multiplier, ranged_spawn_multiplier, mob_health_multiplier, mob_damage_multiplier, health_recover_multiplier, health_loss_multiplier, mana_recover_multiplier, growing_plants_age, melee_trigger_distance all = 1.0; melee_trigger_distance = 10).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_SEWERS,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_STONE_PICKAXE,
        ]
        self.label = "ENTER_SEWERS"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task. Only survival needs are halved."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
            needs_depletion_multiplier=0.5,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines) at the up-ladder position
        builder.set_starting_floor(2)

        # Equip the basic combat loadout
        builder.set_player_inventory({
            "sword": 1,      # stone sword
            "pickaxe": 1,    # stone pickaxe
            "torches": 4,
        })

        # No map modifications; the floor is generated normally

        state = builder.build(rng)

        # Mark the pre‑completed achievements
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
