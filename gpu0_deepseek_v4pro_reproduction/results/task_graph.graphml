ickaxe": 36.70886075949367, "make_iron_sword": 56.540084388185655, "make_arrow": 95.78059071729957, "make_torch": 93.67088607594937, "place_torch": 93.24894514767932, "collect_sapphire": 26.582278481012658, "collect_ruby": 29.11392405063291, "make_diamond_pickaxe": 2.5316455696202533, "make_diamond_sword": 6.751054852320675, "make_iron_armour": 5.485232067510548, "enter_gnomish_mines": 60.75949367088607, "enter_dungeon": 95.35864978902954, "defeat_orc_solider": 94.09282700421942, "defeat_orc_mage": 88.18565400843882, "eat_snail": 92.82700421940929, "find_bow": 94.51476793248945, "fire_bow": 91.13924050632912, "open_chest": 94.51476793248945, "drink_potion": 78.48101265822785}, "average_episode_length": 1206.071729957806, "mean_return_percentage": 23.36261416384284, "mean_return": 52.79950801028481, "lp": NaN, "priority_score": 0.23842332959461623}]</data>
