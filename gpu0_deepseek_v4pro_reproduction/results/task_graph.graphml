      <data key="d3">import jax
import jax.numpy as jnp
from craftax.craftax.constants import Achievement, BlockType, ItemType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Train the agent to travel from the Overworld (floor 0) to the Dungeon (floor 1), clear 8 normal‑strength hostiles with pre‑supplied stone‑tier equipment, and descend to floor 2 (Gnomish Mines).

Description: The episode begins on floor 0, the standard Overworld, with the player spawning at its centre. The ladder down to floor 1 is already unlocked (`monsters_killed[0] = 8`), so the agent must simply locate and step on any ladder‑down tile and use `DESCEND` to enter the Dungeon. Once on floor 1, the task mirrors the successful parent setup: a ladder down is guaranteed to appear on a `PATH` block within Manhattan distance 2–10 from the player’s spawn point on that floor. The agent must defeat at least 8 hostile mobs (Orc Soldiers and Orc Mages, spawned at standard rates via `melee_spawn_multiplier = 1.0` and `ranged_spawn_multiplier = 1.0`) to clear the floor, then step on the ladder and `DESCEND` again to unlock `ENTER_GNOMISH_MINES` and succeed. The agent is equipped with a full stone‑tier load‑out and a bow to keep the focus on the navigation‑to‑combat transition. Survival needs are drastically reduced (`needs_depletion_multiplier = 0.25`, `health_recover_multiplier = 2.0`) to prevent distractions.

Relevant Achievements: ENTER_DUNGEON, ENTER_GNOMISH_MINES
Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_STONE_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_SWORD, COLLECT_WOOD, COLLECT_STONE, COLLECT_COAL, FIND_BOW

World:
- Player:
  - Starting floor = 0.
  - Inventory: `{"pickaxe": 2, "sword": 2, "bow": 1, "arrows": 15, "torch": 10, "coal": 10}`.
  - Stats: `dexterity=1, strength=1, intelligence=1`.
  - `set_monsters_killed(level=0, count=8)` so the Overworld ladder is immediately usable.
- Map:
  - On level 1, place exactly one `LADDER_DOWN` using `place_randomly_near` on `PATH` blocks, within Manhattan distance 2–10 from the player’s spawn point on that floor.
- Mechanics:
  - `melee_spawn_multiplier = 1.0`
  - `ranged_spawn_multiplier = 1.0`
  - `passive_spawn_multiplier = 1.0`
  - `mob_health_multiplier = 1.0`
  - `mob_damage_multiplier = 1.0`
  - `needs_depletion_multiplier = 0.25`
  - `health_recover_multiplier = 2.0`
  - `monsters_killed_to_clear_level = 8`  (applies to floors 0 and 1; floor 0 is already cleared via the start‑state kill count)
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_SWORD,
            Achievement.COLLECT_WOOD,
            Achievement.COLLECT_STONE,
            Achievement.COLLECT_COAL,
            Achievement.FIND_BOW,
        ]
        self.label = "ENTER_DUNGEON, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            needs_depletion_multiplier=0.25,
            health_recover_multiplier=2.0,
            monsters_killed_to_clear_level=8,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, ladder_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0
        builder.set_starting_floor(0)

        # Equip the stone‑tier loadout
        builder.set_player_inventory({
            "pickaxe": 2,   # stone pickaxe
            "sword": 2,     # stone sword
            "bow": 1,
            "arrows": 15,
            "torches": 10,
            "coal": 10,
        })

        # Unlock the overworld ladder
        builder.set_monsters_killed(level=0, count=8)

        # Build the initial state
        state = builder.build(rng)

        # --- Place a guaranteed LADDER_DOWN on floor 1, near the up‑ladder ---
        up_ladder_pos = state.up_ladders[1]   # player spawn point on floor 1
        map_floor1 = state.map[1]

        # Mask: PATH blocks within Manhattan distance 2‑10 of the up‑ladder
        rows_grid, cols_grid = jnp.indices(self.static_params.map_size)
        dist_map = jnp.abs(rows_grid - up_ladder_pos[0]) + jnp.abs(cols_grid - up_ladder_pos[1])
        distance_mask = (dist_map &gt;= 2) &amp; (dist_map &lt;= 10)
        path_mask = map_floor1 == BlockType.PATH.value
        valid_mask = distance_mask &amp; path_mask

        # Randomly pick one of those positions
        ladder_rng, _ = jax.random.split(ladder_rng)
        random_logits = jax.random.uniform(ladder_rng, shape=self.static_params.map_size)
        masked_logits = jnp.where(valid_mask, random_logits, -jnp.inf)
        selected_flat_index = jnp.argmax(masked_logits.flatten())

        row = selected_flat_index // self.static_params.map_size[1]
        col = selected_flat_index % self.static_params.map_size[1]

        # Set the LADDER_DOWN on the item_map
        item_map = state.item_map
        item_map = item_map.at[1, row, col].set(ItemType.LADDER_DOWN.value)
        state = state.replace(item_map=item_map)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
