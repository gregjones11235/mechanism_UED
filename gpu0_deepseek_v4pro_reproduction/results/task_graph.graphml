      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Survive and clear Floor 1 (Dungeon) against dynamically spawning Orc Soldiers and Orc Mages, then descend to the Gnomish Mines.

Description: The agent begins on Floor 1 (Dungeon) with a bow, 10 arrows, and a wood sword, exactly as in the previous task. Survival needs (hunger, thirst, fatigue) still drain at 20 % of normal speed to keep the focus on combat. Two guaranteed mobs are placed initially: one Orc Soldier (melee) and one Orc Mage (ranged), each 5–8 tiles from spawn. In addition, hostile mobs now spawn naturally at low rates: melee spawns at 30 % of the normal rate, ranged spawns at 20 % of the normal rate. No passive mobs appear at all. The floor‑clear requirement is raised from 2 to 4, meaning the agent must dispatch all initial mobs **and** survive hunting down at least two extra enemies that appear through spawning. Only after accumulating at least 4 kills will the ladder down unlock, allowing the agent to DESCEND into Floor 2 (Gnomish Mines). This task forces the agent to integrate combat skill, awareness of surging threats, and persistent exploration under light spawn pressure, directly preparing for the demands of the original Dungeon.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: FIND_BOW, MAKE_WOOD_SWORD, MAKE_ARROW

World:
- Player: Floor 1 (spawn at ladder‑up position). Inventory: {"bow": 1, "arrows": 10, "sword": 1}. Stats: Strength 1, Dexterity 1, Intelligence 1. Health/Food/Drink/Energy/Mana all full (9/9). Learned spells: none. Weapon/Armour enchantments: none.
- Map:
    - Use default Dungeon generation for Floor 1.
    - Place exactly one melee mob (Orc Soldier, "melee", type_id=2) using `add_mobs_randomly_near`, with target_pos = player spawn coordinates, n=1, min_dist=5, max_dist=8, on_blocks = [BlockType.PATH].
    - Place exactly one ranged mob (Orc Mage, "ranged", type_id=2) using `add_mobs_randomly_near`, with target_pos = player spawn coordinates, n=1, min_dist=5, max_dist=8, on_blocks = [BlockType.PATH].
    - No other mobs are placed initially; spawning will populate further enemies.
- Mechanics:
    "needs_depletion_multiplier": 0.2,
    "melee_spawn_multiplier": 0.3,
    "ranged_spawn_multiplier": 0.2,
    "passive_spawn_multiplier": 0.0,
    "monsters_killed_to_clear_level": 4,
    "health_recover_multiplier": 1.0,
    "health_loss_multiplier": 1.0,
    "mob_health_multiplier": 1.0,
    "mob_damage_multiplier": 1.0
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.FIND_BOW,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_ARROW,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.2,
            melee_spawn_multiplier=0.3,
            ranged_spawn_multiplier=0.2,
            passive_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=4,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, soldier_rng, mage_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)
        builder.set_starting_floor(1)

        # Equip starting gear: wood sword (1), bow (1), arrows (10)
        builder.set_player_inventory({"sword": 1, "bow": 1, "arrows": 10})

        # Place Orc Soldier (melee type_id=2) near spawn
        builder.add_mobs_randomly_near(
            soldier_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=1,
            target_pos=builder.player_position,
            min_dist=5,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        # Place Orc Mage (ranged type_id=2) near spawn
        builder.add_mobs_randomly_near(
            mage_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=1,
            target_pos=builder.player_position,
            min_dist=5,
            max_dist=8,
            on_blocks=[BlockType.PATH],
        )

        return builder.build(rng)</data>
