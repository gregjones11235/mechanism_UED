"drink_potion": 86.21323529411765}, "average_episode_length": 555.5625, "mean_return_percentage": 16.932259618708517, "mean_return": 38.26690673828125, "lp": NaN, "priority_score": 0.20685215722318337}, {"session": 56, "sr": 0.7833333333333333, "achievement_srs": {"collect_wood": 23.75, "place_table": 19.166666666666668, "collect_sapling": 24.583333333333332, "collect_drink": 85.83333333333333, "make_wood_pickaxe": 46.666666666666664, "make_wood_sword": 100.0, "place_plant": 24.375, "defeat_zombie": 10.625, "collect_stone": 28.75, "place_stone": 28.125, "eat_plant": 5.625, "defeat_skeleton": 8.75, "make_stone_pickaxe": 28.125, "wake_up": 12.916666666666666, "place_furnace": 27.708333333333332, "collect_coal": 59.583333333333336, "collect_iron": 52.291666666666664, "collect_diamond": 31.25, "make_iron_pickaxe": 11.25, "make_iron_sword": 10.416666666666666, "place_torch": 98.54166666666667, "collect_sapphire": 28.75, "collect_ruby": 32.083333333333336, "make_diamond_pickaxe": 4.375, "make_diamond_sword": 3.75, "enter_gnomish_mines": 80.0, "enter_dungeon": 100.0, "defeat_orc_solider": 97.91666666666667, "defeat_orc_mage": 93.125, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 99.79166666666667, "drink_potion": 77.91666666666667}, "average_episode_length": 576.0833333333334, "mean_return_percentage": 17.78815255404222, "mean_return": 40.20122477213542, "lp": NaN, "priority_score": 0.16972222222222222}]</data>
