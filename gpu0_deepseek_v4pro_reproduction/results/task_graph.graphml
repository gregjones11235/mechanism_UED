      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Teach the agent to survive and clear the pitch‑dark Gnomish Mines (floor 2) by scavenging coal for torches and defeating gnome warriors/archers, then descending to the Sewers.

Description:  
The agent starts on floor 2 with basic combat and survival gear, identical in concept to the gear it would have after successfully clearing floor 1: a stone sword, a wood pickaxe, a bow, 5 arrows, 10 wood, 10 stone, and 2 torches. The floor 2 environment is totally dark (light level 0.0) and generates no pre‑placed torches. To see, the agent must place one of its initial torches, then locate and mine coal blocks (using the wood pickaxe) to craft additional torches and arrows as needed. The floor contains stalagmites, coal, iron, sapphire, and ruby ores, along with hostile gnome warriors (melee) and gnome archers (ranged). The agent must defeat enough of these enemies to satisfy the level‑clear requirement (set to 6 kills) and then locate the down ladder to descend to floor 3. The only terminal goal is descending; upon reaching the Sewers the task succeeds. No overworld or floor 1 backtracking is required, as all essential resources and achievements are already provided or marked as completed.

Relevant Achievements: ENTER_SEWERS

Completed Achievements: COLLECT_WOOD, PLACE_TABLE, EAT_COW, COLLECT_DRINK, MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD, COLLECT_STONE, MAKE_STONE_SWORD, FIND_BOW, ENTER_DUNGEON, ENTER_GNOMISH_MINES

World:
- Player: Starting floor 2. Inventory:
    - stone_sword: 1
    - wood_pickaxe: 1
    - bow: 1
    - arrows: 5
    - wood: 10
    - stone: 10
    - torch: 2
    - coal: 0
    - iron: 0
    - sapphire: 0
    - ruby: 0
    - all other items: 0
  Player stats default (Strength 1, Dexterity 1, Intelligence 1; health, food, drink, energy, mana all max 9).
- Map: No block modifications; floor 2 generates normally (SmoothGen with ores, stalagmites, and ladders).
- Mechanics:
    - monsters_killed_to_clear_level = 6 (applies to floor 2)
    - All other TaskParams remain default (1.0 multipliers, default mob spawn rates, default timings)
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_SEWERS,
        ]
        self.completed_achievements = [
            Achievement.COLLECT_WOOD,
            Achievement.PLACE_TABLE,
            Achievement.EAT_COW,
            Achievement.COLLECT_DRINK,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.COLLECT_STONE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.FIND_BOW,
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.label = "ENTER_SEWERS"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=6,
            # All other TaskParams remain default (1.0 multipliers)
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines)
        builder.set_starting_floor(2)

        # Equip starting inventory as specified:
        # stone sword (tier 2), wood pickaxe (tier 1), bow, 5 arrows, 10 wood, 10 stone, 2 torches
        builder.set_player_inventory({
            "sword": 2,        # stone sword
            "pickaxe": 1,      # wood pickaxe
            "bow": 1,
            "arrows": 5,
            "wood": 10,
            "stone": 10,
            "torches": 2,
        })
        # All other items (coal, iron, sapphire, ruby, potions, etc.) remain at 0 by default.

        # No manual block or mob placements – rely on natural generation

        # Build the state
        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
