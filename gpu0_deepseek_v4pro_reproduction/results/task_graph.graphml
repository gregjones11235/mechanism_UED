ron_pickaxe": 38.657407407407405, "make_iron_sword": 94.67592592592592, "make_arrow": 79.39814814814815, "make_torch": 87.96296296296296, "place_torch": 80.0925925925926, "collect_sapphire": 2.314814814814815, "collect_ruby": 4.861111111111111, "make_diamond_pickaxe": 0.6944444444444444, "make_diamond_sword": 0.6944444444444444, "make_iron_armour": 23.14814814814815, "enter_dungeon": 92.5925925925926, "defeat_orc_solider": 3.4722222222222223, "eat_snail": 12.731481481481481, "find_bow": 42.824074074074076, "fire_bow": 30.09259259259259, "open_chest": 42.824074074074076, "drink_potion": 8.796296296296296}, "average_episode_length": 713.8726851851852, "mean_return_percentage": 19.083920919242665, "mean_return": 43.129661277488424, "lp": NaN, "priority_score": 0.10763353052126204}, {"session": 36, "sr": 0.9212962962962963, "achievement_srs": {"collect_wood": 99.76851851851852, "eat_cow": 92.5925925925926, "collect_sapling": 100.0, "collect_drink": 90.74074074074075, "place_plant": 100.0, "defeat_zombie": 26.15740740740741, "collect_stone": 99.76851851851852, "place_stone": 98.14814814814815, "eat_plant": 14.814814814814815, "defeat_skeleton": 12.731481481481481, "make_stone_pickaxe": 97.91666666666667, "make_stone_sword": 96.99074074074075, "wake_up": 77.31481481481481, "collect_coal": 99.53703703703704, "collect_iron": 97.91666666666667, "collect_diamond": 8.333333333333334, "make_iron_pickaxe": 22.453703703703702, "make_iron_sword": 95.37037037037037, "make_arrow": 91.20370370370371, "make_torch": 95.83333333333333, "place_torch": 93.75, "collect_sapphire": 5.787037037037037, "collect_ruby": 5.324074074074074, "make_diamond_pickaxe": 0.6944444444444444, "make_diamond_sword": 0.9259259259259259, "make_iron_armour": 33.333333333333336, "enter_dungeon": 96.75925925925925, "defeat_orc_solider": 7.638888888888889, "defeat_orc_mage": 2.7777777777777777, "eat_snail": 18.75, "find_bow": 48.379629629629626, "fire_bow": 38.19444444444444, "open_chest": 48.379629629629626, "dri