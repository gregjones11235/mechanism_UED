      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Train combat against Gnome Warriors and Gnome Archers in the dark, resource‑scarce environment of the Gnomish Mines.

Description: The agent starts on Floor 2 (Gnomish Mines) at the ladder‑up position, already past the overworld and Dungeon stages. Its inventory contains a stone sword, a bow with 20 arrows, and 10 torches—the minimal gear a competent survivor would bring. Survival bars (health, food, drink, energy) all start at 9/9. All attributes are at base (STR=1, DEX=1, INT=1). The world uses standard procedural generation for all nine floors, with melee, ranged, and passive spawn multipliers set to 1.0. The survival dynamics are eased slightly to keep the episode focused on combat: `needs_depletion_multiplier = 0.75` and `health_recover_multiplier = 1.5`. The agent must explore the pitch‑black level, place torches to see, locate Gnome Warriors and Gnome Archers, and defeat both types. The task terminates successfully only when `DEFEAT_GNOME_WARRIOR` and `DEFEAT_GNOME_ARCHER` are both achieved. This thin‑slice task pressures gnome‑specific combat and dark‑level navigation while avoiding the overhead of early‑game grinding.

Relevant Achievements: DEFEAT_GNOME_WARRIOR, DEFEAT_GNOME_ARCHER
Completed Achievements: (none)

World:
- Player: Starting floor 2; inventory: {"sword": 2, "bow": 1, "arrows": 20, "torches": 10}; all survival stats (food, drink, energy, health, mana) = 9/9; attributes STR=1, DEX=1, INT=1; no learned spells.
- Map: No modifications; all levels use standard procedural generation.
- Mechanics:
    "melee_spawn_multiplier": 1.0,
    "ranged_spawn_multiplier": 1.0,
    "passive_spawn_multiplier": 1.0,
    "needs_depletion_multiplier": 0.75,
    "health_recover_multiplier": 1.5,
    "monsters_killed_to_clear_level": 8,
    "mob_damage_multiplier": 1.0,
    "mob_health_multiplier": 1.0,
    "melee_trigger_distance": 10
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.DEFEAT_GNOME_WARRIOR,
            Achievement.DEFEAT_GNOME_ARCHER,
        ]
        self.completed_achievements = []  # none
        self.label = "DEFEAT_GNOME_WARRIOR, DEFEAT_GNOME_ARCHER"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            needs_depletion_multiplier=0.75,
            health_recover_multiplier=1.5,
            monsters_killed_to_clear_level=8,
            mob_damage_multiplier=1.0,
            mob_health_multiplier=1.0,
            melee_trigger_distance=10,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines)
        builder.set_starting_floor(2)

        # Equip starting inventory: stone sword, bow, 20 arrows, 10 torches
        builder.set_player_inventory({
            "sword": 2,    # stone sword
            "bow": 1,
            "arrows": 20,
            "torches": 10,
        })

        # No additional block or mob placements – rely on natural spawning
        state = builder.build(rng)

        # No pre‑completed achievements to mark
        return state</data>
