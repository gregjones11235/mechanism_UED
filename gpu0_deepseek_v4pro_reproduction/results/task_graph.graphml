      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams
from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to progress from the overworld into the dungeon and subsequently descend to the Gnomish Mines.

Description: The agent starts at the center of the overworld (floor 0) with a pre‑equipped combat kit: a bow, 10 arrows, a wood sword, and 5 torches. A crafting table and a furnace are already placed on adjacent tiles, and the inventory contains a small stash of wood (5) and stone (2) for emergency crafting. Survival needs drain at only 30 % of the normal rate to keep the focus on navigation and combat.

Floor 0 is seeded with three hostile mobs placed 5–8 tiles away: two Zombies (melee) and one Skeleton (ranged). The global kill‑to‑clear requirement is 4, but the agent starts with 2 kills already credited on floor 0, so it only needs to dispatch 2 more enemies to unlock the ladder down to the dungeon. Once the ladder appears, the agent must locate it (placed by the default overworld generation) and descend to floor 1.

Floor 1 generates as a default dungeon. No pre‑placed mobs exist, but hostile mobs spawn naturally: melee and ranged spawn multipliers are set to 0.5, so Orc Soldiers and Orc Mages will appear as the agent explores. The same global clear requirement of 4 applies, forcing the agent to hunt down at least four orcs before the ladder to floor 2 (Gnomish Mines) unlocks. Descending to floor 2 completes the task.

This thin‑slice expansion bridges the critical gap between the agent’s proven ability to fight on floor 1 and its inability to reach that floor from the overworld, directly raising global `enter_gnomish_mines` success.

Relevant Achievements: ENTER_GNOMISH_MINES

Completed Achievements: FIND_BOW, MAKE_WOOD_SWORD, MAKE_ARROW, MAKE_TORCH

World:
- Player: Start on floor 0, at the default world‑center spawn coordinates. Inventory: {"bow": 1, "arrows": 10, "sword": 1, "wood": 5, "stone": 2, "torch": 5}. Stats: Strength 1, Dexterity 1, Intelligence 1. All status bars full (9/9). Learned spells: none. Weapon/Armour enchantments: none.
- Map:
    - Use default overworld generation for floor 0.
    - Pre‑credit 2 kills on floor 0 by calling `builder.set_monsters_killed(level=0, count=2)`.
    - Place a Crafting Table at tile (center_row+1, center_col) using `place_block`.
    - Place a Furnace at tile (center_row, center_col+1) using `place_block`.
    - Add 2 melee mobs (Zombie, "melee", type_id=0) via `add_mobs_randomly_near` with target_pos = spawn coordinates, n=2, min_dist=5, max_dist=8, on_blocks = [BlockType.GRASS, BlockType.PATH].
    - Add 1 ranged mob (Skeleton, "ranged", type_id=0) via `add_mobs_randomly_near` with target_pos = spawn coordinates, n=1, min_dist=5, max_dist=8, on_blocks = [BlockType.GRASS, BlockType.PATH].
    - All other levels (1–8) use default generation; no additional initial mobs are placed on floor 1.
- Mechanics:
    "needs_depletion_multiplier": 0.3,
    "melee_spawn_multiplier": 0.5,
    "ranged_spawn_multiplier": 0.5,
    "passive_spawn_multiplier": 0.0,
    "monsters_killed_to_clear_level": 4,
    "health_recover_multiplier": 1.0,
    "health_loss_multiplier": 1.0,
    "mob_health_multiplier": 1.0,
    "mob_damage_multiplier": 1.0
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_GNOMISH_MINES]
        self.completed_achievements = [
            Achievement.FIND_BOW,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_TORCH,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=0.0,
            melee_spawn_multiplier=0.5,
            ranged_spawn_multiplier=0.5,
            needs_depletion_multiplier=0.3,
            monsters_killed_to_clear_level=4,
            # health/mob multipliers left at default (1.0)
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, zombie_rng, skeleton_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)
        builder.set_starting_floor(0)

        # Pre‑credit 2 kills on floor 0 so only 2 more needed
        builder.set_monsters_killed(level=0, count=2)

        # ----------------- Inventory &amp; stats -----------------
        builder.set_player_inventory({
            "bow": 1,
            "arrows": 10,
            "sword": 1,          # wood sword
            "wood": 5,
            "stone": 2,
            "torches": 5,
        })
        builder.set_player_stats(dexterity=1, strength=1, intelligence=1)
        # All status bars default to full (9/9), no enchants, no spells

        # ----------------- Place crafting stations -----------------
        # player_position is the center of the map (default)
        center_row, center_col = builder.player_position
        builder.place_block(0, BlockType.CRAFTING_TABLE, (center_row + 1, center_col))
        builder.place_block(0, BlockType.FURNACE, (center_row, center_col + 1))

        # ----------------- Place mobs near spawn -----------------
        builder.add_mobs_randomly_near(
            zombie_rng,
            level=0,
            mob_name="melee",
            type_id=0,
            n=2,
            target_pos=builder.player_position,
            min_dist=5,
            max_dist=8,
            on_blocks=[BlockType.GRASS, BlockType.PATH],
        )
        builder.add_mobs_randomly_near(
            skeleton_rng,
            level=0,
            mob_name="ranged",
            type_id=0,
            n=1,
            target_pos=builder.player_position,
            min_dist=5,
            max_dist=8,
            on_blocks=[BlockType.GRASS, BlockType.PATH],
        )

        # No further modifications; default generation for all floors
        return builder.build(rng)</data>
