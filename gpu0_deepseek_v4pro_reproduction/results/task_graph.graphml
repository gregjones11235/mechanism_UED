      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Harden dungeon combat and organic bow acquisition by removing the pre‑placed bow chest, while retaining scaffolded survival and basic equipment, so that the path to Gnomish Mines generalizes to the original Craftax.

Description: The agent starts on floor 0 (Overworld) with a Wood Pickaxe, 5 Wood, 5 Stone, and 2 Coal. A Crafting Table is pre‑placed on the grass tile at player start position + (1, 0). **No Chest is pre‑placed.** The overworld generation is default. Survival needs are kept at half speed (needs_depletion_multiplier = 0.5) to avoid distraction, and mob damage remains unmodified (mob_damage_multiplier = 1.0). The ladder down to floor 1 is open (no kill requirement on floor 0). On floor 1 (the Dungeon), the agent must explore naturally, open chests to find a Bow, craft arrows and torches as needed, and defeat 8 hostile mobs (Orc Soldiers, Orc Mages) to clear the level. After clearing, descending the ladder awards ENTER_GNOMISH_MINES. The episode terminates when all Relevant Achievements are completed: MAKE_STONE_SWORD, FIND_BOW, MAKE_ARROW, MAKE_TORCH, PLACE_TORCH, ENTER_DUNGEON, ENTER_GNOMISH_MINES.

Relevant Achievements: MAKE_STONE_SWORD, FIND_BOW, MAKE_ARROW, MAKE_TORCH, PLACE_TORCH, ENTER_DUNGEON, ENTER_GNOMISH_MINES

Completed Achievements: MAKE_WOOD_PICKAXE, PLACE_TABLE

World:
- Player: Starts on floor 0, at the center of the Overworld. Inventory: wood_pickaxe = 1, wood = 5, stone = 5, coal = 2. All other slots empty. Attributes: strength = 1, dexterity = 1, intelligence = 1. Health, food, drink, energy, mana all 9/9. Weapon/armour enchantments all 0. Learned spells false.
- Map:
  - Place a Crafting Table at player start position + (1, 0) on a grass tile.
  - No other block modifications; floors 0 – 8 use normal procedural generation.
- Mechanics:
  - monsters_killed_to_clear_level = 8 (floor 0 remains 0; floor 1 now requires 8 kills).
  - mob_damage_multiplier = 1.0
  - needs_depletion_multiplier = 0.5
  - All other TaskParams (passive_spawn_multiplier, melee_spawn_multiplier, ranged_spawn_multiplier, mob_health_multiplier, health_recover_multiplier, health_loss_multiplier, mana_recover_multiplier, growing_plants_age) remain at their default values.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.MAKE_STONE_SWORD,
            Achievement.FIND_BOW,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_TORCH,
            Achievement.PLACE_TORCH,
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.PLACE_TABLE,
        ]
        self.label = "MAKE_STONE_SWORD, FIND_BOW, MAKE_ARROW, MAKE_TORCH, PLACE_TORCH, ENTER_DUNGEON, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.5,
            mob_damage_multiplier=1.0,
            monsters_killed_to_clear_level=8,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld) at default center position
        builder.set_starting_floor(0)

        # Equip starting inventory: wood pickaxe, wood, stone, coal
        builder.set_player_inventory({
            "pickaxe": 1,   # wood pickaxe
            "wood": 5,
            "stone": 5,
            "coal": 2,
        })

        # Unlock ladder down to floor 1 (no kill requirement)
        builder.set_monsters_killed(level=0, count=8)

        # Place a Crafting Table on the grass tile next to spawn (spawn + (1,0))
        spawn_pos = builder.player_position
        table_pos = (spawn_pos[0] + 1, spawn_pos[1])
        builder.place_block(0, BlockType.CRAFTING_TABLE, table_pos)

        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
