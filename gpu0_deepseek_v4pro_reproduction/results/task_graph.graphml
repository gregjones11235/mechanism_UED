word": 99.48078920041537, "place_plant": 99.5846313603323, "defeat_zombie": 95.01557632398755, "collect_stone": 99.48078920041537, "place_stone": 98.4423676012461, "eat_plant": 2.284527518172378, "defeat_skeleton": 3.842159916926272, "make_stone_pickaxe": 83.28141225337487, "make_stone_sword": 98.23468328141226, "wake_up": 81.4122533748702, "place_furnace": 98.23468328141226, "collect_coal": 83.80062305295951, "collect_iron": 45.794392523364486, "collect_diamond": 0.20768431983385255, "make_iron_pickaxe": 3.6344755970924196, "make_iron_sword": 19.833852544132917, "make_arrow": 81.82762201453791, "make_torch": 69.47040498442368, "place_torch": 67.1858774662513, "collect_sapphire": 0.3115264797507788, "collect_ruby": 0.10384215991692627, "make_iron_armour": 0.10384215991692627, "enter_dungeon": 1.3499480789200415, "eat_snail": 0.6230529595015576, "find_bow": 1.142263759086189, "fire_bow": 0.9345794392523364, "open_chest": 1.142263759086189, "drink_potion": 0.4153686396677051}, "average_episode_length": 295.10695742471444, "mean_return_percentage": 15.84100698464882, "mean_return": 35.80067578530633, "lp": NaN, "priority_score": 0.055686571364796544}]</data>
