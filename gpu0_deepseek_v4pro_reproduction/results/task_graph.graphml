      <data key="d3">import jax
import jax.numpy as jnp
from craftax.craftax.constants import Achievement, BlockType, ItemType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to handle both melee and ranged enemies on floor 1 using a stone sword and bow to unlock and descend to floor 2.
    Description: The agent starts on floor 1 (the Dungeon) with a stone sword, stone pickaxe, bow, and a stock of wood, stone, coal, arrows, and torches. The floor’s kill counter is zero and the “ladder down” is locked. Ranged orc mages spawn alongside melee orc soldiers; both are necessary to meet the kill quota of 5 enemies to clear the level. Mob health and damage are still reduced to keep encounters forgiving. A guaranteed LADDER_DOWN is placed within a short Manhattan distance (2–10 tiles) from the spawn point, so the agent can focus on combat rather than navigation. Survival pressure is minimal, and passive snails appear as a supplementary food source. The episode succeeds when the agent kills at least 5 hostiles, stands on the exposed LADDER_DOWN, and DESCENDS to trigger ENTER_GNOMISH_MINES.
    Relevant Achievements: ENTER_GNOMISH_MINES
    Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_STONE_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_SWORD, COLLECT_WOOD, COLLECT_STONE, COLLECT_COAL, ENTER_DUNGEON
    World:
    - Player: Starting floor = 1. Inventory: `{"pickaxe": 2, "sword": 2, "wood": 20, "stone": 20, "coal": 10, "torch": 10, "bow": 1, "arrows": 15}`. Stats: all 1. Kill counter for floor 1 is set to 0 using `set_monsters_killed(level=1, count=0)`.
    - Map: One `LADDER_DOWN` block is placed randomly on `PATH` within a Manhattan distance of 2–10 tiles from the player’s spawn point using `place_randomly_near`.
    - Mechanics: 
      - `melee_spawn_multiplier = 1.5`
      - `ranged_spawn_multiplier = 1.5`
      - `passive_spawn_multiplier = 1.0`
      - `mob_health_multiplier = 0.75`
      - `mob_damage_multiplier = 0.8`
      - `needs_depletion_multiplier = 0.25`
      - `health_recover_multiplier = 2.0`
      - `monsters_killed_to_clear_level = 5`
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_GNOMISH_MINES]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_SWORD,
            Achievement.COLLECT_WOOD,
            Achievement.COLLECT_STONE,
            Achievement.COLLECT_COAL,
            Achievement.ENTER_DUNGEON,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=1.5,
            ranged_spawn_multiplier=1.5,
            passive_spawn_multiplier=1.0,
            mob_health_multiplier=0.75,
            mob_damage_multiplier=0.8,
            needs_depletion_multiplier=0.25,
            health_recover_multiplier=2.0,
            monsters_killed_to_clear_level=5,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, ladder_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(1)
        builder.set_player_inventory({
            "pickaxe": 2,
            "sword": 2,
            "bow": 1,
            "arrows": 15,
            "wood": 20,
            "stone": 20,
            "coal": 10,
            "torches": 10,
        })
        builder.set_monsters_killed(level=1, count=0)

        # Build the initial state (contains default ladder down far away)
        state = builder.build(rng)

        # --- Override ladder down placement to be near the player ---
        level = 1
        map_level = state.map[level]
        item_map_level = state.item_map[level]

        # Remove any existing ladder down
        item_map_level = jnp.where(
            item_map_level == ItemType.LADDER_DOWN.value, 0, item_map_level
        )

        # Find PATH cells within Manhattan distance 2..10 from player
        player_pos = state.player_position
        map_size = self.static_params.map_size
        rows, cols = jnp.indices(map_size)
        dist_map = jnp.abs(rows - player_pos[0]) + jnp.abs(cols - player_pos[1])
        distance_mask = (dist_map &gt;= 2) &amp; (dist_map &lt;= 10)
        path_mask = map_level == BlockType.PATH.value
        valid_mask = distance_mask &amp; path_mask

        # Choose one randomly
        logits = jax.random.uniform(ladder_rng, shape=map_size)
        masked_logits = jnp.where(valid_mask, logits, -jnp.inf)
        flat_index = jnp.argmax(masked_logits.flatten())
        new_row = flat_index // map_size[1]
        new_col = flat_index % map_size[1]

        # Update item map
        item_map_level = item_map_level.at[new_row, new_col].set(
            ItemType.LADDER_DOWN.value
        )
        state = state.replace(
            item_map=state.item_map.at[level].set(item_map_level)
        )

        # Update down_ladders array for this level
        new_ladder_pos = jnp.array([new_row, new_col], dtype=jnp.int32)
        state = state.replace(
            down_ladders=state.down_ladders.at[level].set(new_ladder_pos)
        )

        return state</data>
