make_torch": 91.14832535885168, "place_torch": 83.01435406698565, "collect_sapphire": 10.526315789473685, "collect_ruby": 10.047846889952153, "make_diamond_pickaxe": 1.4354066985645932, "make_diamond_sword": 0.9569377990430622, "make_iron_armour": 11.004784688995215, "enter_gnomish_mines": 0.7177033492822966, "enter_dungeon": 88.99521531100478, "defeat_orc_solider": 35.88516746411483, "defeat_orc_mage": 25.83732057416268, "eat_snail": 56.45933014354067, "find_bow": 85.4066985645933, "fire_bow": 69.61722488038278, "open_chest": 85.4066985645933, "drink_potion": 53.110047846889955}, "average_episode_length": 659.9043062200957, "mean_return_percentage": 18.063236773960494, "mean_return": 40.82291510915072, "lp": NaN, "priority_score": 0.23511366498019734}]</data>
