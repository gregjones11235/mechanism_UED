      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Clear the dungeon and descend to the Gnomish Mines under realistic survival pressure, with the overworld progression already completed.

Description: The agent begins on floor 1 (the dungeon) with the equipment of an efficient overworld run: iron pickaxe, iron sword, bow, 10 arrows, 10 torches, and a small supply of wood (5) and stone (5). All status bars (health, food, drink, energy, mana) start at 9. The dungeon is procedurally generated with default orc soldiers and orc mages. The ladder down to floor 2 is initially locked; the agent must kill exactly 8 hostile mobs (any mix of orcs) to unlock it. Unlike the previous task, survival pressure is now set to the original Craftax intensity (`needs_depletion_multiplier = 1.0`), forcing careful time management while navigating and fighting. No crafting or overworld actions are required—all prerequisite achievements are marked as completed. The sole goal is to reach floor 2 (Gnomish Mines), i.e., achieve ENTER_GNOMISH_MINES. This task targets the global bottleneck of the dungeon‑to‑mines transition under full nutritional strain.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: COLLECT_WOOD, PLACE_TABLE, MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD, COLLECT_STONE, PLACE_STONE, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, PLACE_FURNACE, COLLECT_COAL, COLLECT_IRON, MAKE_IRON_PICKAXE, MAKE_IRON_SWORD, MAKE_ARROW, MAKE_TORCH, PLACE_TORCH

World:
- Player: `set_starting_floor(1)`. `set_player_inventory({"wood": 5, "stone": 5, "coal": 2, "iron": 2, "pickaxe": 3, "sword": 3, "bow": 1, "arrows": 10, "torches": 10})`. All attributes default (STR=1, DEX=1, INT=1).
- Map: No manual block placements. The dungeon (floor 1) is generated procedurally as in original Craftax, with rooms, corridors, chests, fountains, and torches in corners.
- Mechanics:
  - monsters_killed_to_clear_level = 8
  - needs_depletion_multiplier = 1.0
  - mob_health_multiplier = 1.0
  - mob_damage_multiplier = 1.0
  - melee_spawn_multiplier = 1.0
  - ranged_spawn_multiplier = 1.0
  - passive_spawn_multiplier = 1.0
  - health_recover_multiplier = 1.0
  - health_loss_multiplier = 1.0
  - mana_recover_multiplier = 1.0
  - growing_plants_age = 600
  - All other parameters at defaults.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.COLLECT_WOOD,
            Achievement.PLACE_TABLE,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.COLLECT_STONE,
            Achievement.PLACE_STONE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.PLACE_FURNACE,
            Achievement.COLLECT_COAL,
            Achievement.COLLECT_IRON,
            Achievement.MAKE_IRON_PICKAXE,
            Achievement.MAKE_IRON_SWORD,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_TORCH,
            Achievement.PLACE_TORCH,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
            needs_depletion_multiplier=1.0,
            # All other multipliers are default 1.0, so no need to specify them.
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Equip the iron-age inventory: iron pickaxe, iron sword, bow, arrows, torches, and some resources
        builder.set_player_inventory({
            "wood": 5,
            "stone": 5,
            "coal": 2,
            "iron": 2,
            "pickaxe": 3,   # iron pickaxe
            "sword": 3,     # iron sword
            "bow": 1,
            "arrows": 10,
            "torches": 10,
        })

        # Ensure the dungeon has no pre-killed monsters (start at 0 kills)
        builder.set_monsters_killed(level=1, count=0)

        state = builder.build(rng)

        # Mark all overworld-development achievements as completed
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
