collect_diamond": 29.681978798586574, "make_iron_pickaxe": 34.275618374558306, "make_iron_sword": 74.91166077738517, "make_arrow": 95.0530035335689, "make_torch": 93.63957597173145, "place_torch": 91.1660777385159, "collect_sapphire": 25.795053003533567, "collect_ruby": 27.56183745583039, "make_diamond_pickaxe": 2.4734982332155475, "make_diamond_sword": 3.5335689045936394, "enter_gnomish_mines": 51.236749116607776, "enter_dungeon": 100.0, "defeat_orc_solider": 95.75971731448763, "defeat_orc_mage": 92.57950530035336, "eat_snail": 100.0, "find_bow": 99.64664310954063, "fire_bow": 94.34628975265018, "open_chest": 99.64664310954063, "drink_potion": 85.15901060070671}, "average_episode_length": 1055.2826855123674, "mean_return_percentage": 21.040335124710747, "mean_return": 47.55115738184629, "lp": NaN, "priority_score": 0.249847045162257}, {"session": 148, "sr": 0.5806451612903226, "achievement_srs": {"collect_wood": 97.1774193548387, "eat_cow": 90.3225806451613, "collect_sapling": 89.51612903225806, "collect_drink": 96.7741935483871, "make_wood_pickaxe": 100.0, "make_wood_sword": 100.0, "place_plant": 89.11290322580645, "defeat_zombie": 70.16129032258064, "collect_stone": 97.58064516129032, "place_stone": 94.75806451612904, "eat_plant": 25.806451612903224, "defeat_skeleton": 64.91935483870968, "wake_up": 99.19354838709677, "collect_coal": 94.35483870967742, "collect_iron": 93.14516129032258, "collect_diamond": 33.064516129032256, "make_iron_pickaxe": 48.79032258064516, "make_iron_sword": 85.48387096774194, "make_arrow": 98.79032258064517, "make_torch": 95.16129032258064, "place_torch": 94.35483870967742, "collect_sapphire": 29.838709677419356, "collect_ruby": 23.387096774193548, "make_diamond_pickaxe": 4.435483870967742, "make_diamond_sword": 4.838709677419355, "enter_gnomish_mines": 61.29032258064516, "enter_dungeon": 100.0, "defeat_orc_solider": 98.38709677419355, "defeat_orc_mage": 91.12903225806451, "eat_snail": 100.0, "find_bow": 100.0, "fire_bow": 98.790322580645