      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Survive the Dungeon with normal‑strength enemies and kill enough hostiles to unlock the ladder to the Gnomish Mines.

Description:
The agent begins on floor 1 (Dungeon) at the up‑ladder position. It is already equipped with a stone sword (sword level 2). All player attributes and survival bars are set to their default maximums (health 9, food 9, drink 9, energy 9, mana 9; STR 1, DEX 1, INT 1). No other items or resources are provided. Enemies now spawn with their full base health and damage (mob_health_multiplier = 1.0, mob_damage_multiplier = 1.0), matching the original Craftax Dungeon challenge. To keep the task learnable, natural spawning rates are slightly reduced (both melee and ranged spawn multipliers set to 0.7). The number of hostiles that must be defeated to clear the level and activate the down‑ladder is raised to 5. The episode terminates successfully when the agent achieves the `ENTER_GNOMISH_MINES` achievement (descending to floor 2 for the first time). No additional blocks or mobs are placed.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: ENTER_DUNGEON, MAKE_STONE_SWORD
World:
- Player: Start on floor 1 at the up‑ladder position. Inventory contains a stone sword (sword level 2) and nothing else. All stats and needs at full default.
- Map: No modifications. The standard Dungeon is generated with its rooms, corridors, chests, fountains, and torches. Mobs spawn naturally according to the parameters below.
- Mechanics:
    * melee_spawn_multiplier = 0.7
    * ranged_spawn_multiplier = 0.7
    * mob_health_multiplier = 1.0
    * mob_damage_multiplier = 1.0
    * monsters_killed_to_clear_level = 5
    * All other TaskParams remain at their default values (e.g., needs_depletion_multiplier = 1.0).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.MAKE_STONE_SWORD,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=0.7,
            ranged_spawn_multiplier=0.7,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            monsters_killed_to_clear_level=5,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Equip only a stone sword (sword level 2)
        builder.set_player_inventory({"sword": 2})

        # Build the initial state
        state = builder.build(rng)

        # Mark the pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
