chest": 99.65870307167235, "drink_potion": 80.88737201365188}, "average_episode_length": 975.4436860068259, "mean_return_percentage": 21.235445800235585, "mean_return": 47.99210750853242, "lp": NaN, "priority_score": 0.24755093245116425}]</data>
