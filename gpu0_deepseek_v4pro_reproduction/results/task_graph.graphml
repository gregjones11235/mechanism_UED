      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Defeat an Orc Soldier in the Dungeon using a stone sword, teaching the agent to fight a tougher melee enemy in a confined dungeon layout.

Description: The agent starts on floor 1 (the Dungeon) with a stone sword (tier 2) in its inventory. Exactly one Orc Soldier (melee mob type_id=2) is placed randomly at a Manhattan distance of 4–8 tiles from the player’s start position. No other hostile mobs spawn during the episode; melee and ranged spawn multipliers are set to 0. Survival needs deplete at normal rates, and health regenerates at the default speed. The episode terminates upon successfully defeating the Orc Soldier (`DEFEAT_ORC_SOLIDER`). The agent may earn other achievements, but only this one defines task success.

Relevant Achievements: DEFEAT_ORC_SOLIDER
Completed Achievements: ENTER_DUNGEON, MAKE_STONE_SWORD
World:
- Player: Starts on floor 1 with inventory `{"sword": 2}` (stone sword). All stats default (STR 1, DEX 1, INT 1); health, food, drink, energy, mana all start at 9/9.
- Map: Place one Orc Soldier (`mob_name="melee"`, `type_id=2`) randomly within 4–8 Manhattan distance of the player’s starting position.
- Mechanics: `passive_spawn_multiplier = 1.0`, `melee_spawn_multiplier = 0.0`, `ranged_spawn_multiplier = 0.0`, all other `TaskParams` at default (1.0 or 10 for `melee_trigger_distance`).
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.DEFEAT_ORC_SOLIDER]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.MAKE_STONE_SWORD,
        ]
        self.label = "DEFEAT_ORC_SOLIDER"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            # passive_spawn_multiplier stays at default 1.0
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, mob_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(1)
        builder.set_player_inventory({"sword": 2})  # 2 = Stone Sword

        # Place one Orc Soldier within 4-8 tiles from player start
        builder.add_mobs_randomly_near(
            mob_rng,
            level=1,
            mob_name="melee",
            type_id=2,  # type_id 2 is Orc Soldier
            n=1,
            target_pos=builder.player_position,
            min_dist=4,
            max_dist=8,
            on_blocks=[BlockType.PATH],  # dungeon floor has PATH blocks
        )

        return builder.build(rng)</data>
