      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Defeat a gnome warrior inside the dark Gnomish Mines to build the combat skill required for survival on Floor 2.

Description: The agent begins on Floor 2 (Gnomish Mines) with a loadout that represents a successful Dungeon descent. The inventory includes a stone pickaxe, stone sword, 5 torches, 10 wood, and 10 stone, ensuring the agent can immediately engage in combat and manage darkness without having to craft basic tools. All survival metres (Health, Food, Drink, Energy, Mana) are full. A single gnome warrior is pre‑placed approximately 10 cells away from the player’s spawn to guarantee an encounter; the rest of the level uses default generation with normal spawn multipliers. The agent does not need to clear any floor to descend – the goal is simply to locate and kill one gnome warrior. Success is defined solely by unlocking the `DEFEAT_GNOME_WARRIOR` achievement.

Relevant Achievements: DEFEAT_GNOME_WARRIOR
Completed Achievements: COLLECT_WOOD, PLACE_TABLE, MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD, COLLECT_STONE, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, COLLECT_DRINK, WAKE_UP, PLACE_FURNACE, MAKE_IRON_PICKAXE, MAKE_IRON_SWORD, ENTER_DUNGEON, ENTER_GNOMISH_MINES

World:
- Player: Floor 2 (spawn at the ladder‑up position). Inventory: {"pickaxe": 2, "sword": 2, "torch": 5, "wood": 10, "stone": 10}. (Stone pickaxe and sword.) Stats: Strength 1, Dexterity 1, Intelligence 1. All needs maxed (9/9). No spells, no enchantments.
- Map:
  - Use default world generation for all levels (including Floor 2’s darkness and natural ore placement).
  - On Floor 2, place one gnome warrior (melee mob, type_id = 1, mob_name = "melee") using `add_mobs_randomly_near` with target_pos at the player’s start coordinates, min_dist = 8, max_dist = 15, n = 1, on_blocks = [BlockType.PATH, BlockType.STONE] (or any walkable ground).
- Mechanics:
    "needs_depletion_multiplier": 1.0,
    "melee_spawn_multiplier": 1.0,
    "ranged_spawn_multiplier": 1.0,
    "passive_spawn_multiplier": 1.0,
    "monsters_killed_to_clear_level": 8,
    "health_recover_multiplier": 1.0,
    "health_loss_multiplier": 1.0,
    "mob_health_multiplier": 1.0,
    "mob_damage_multiplier": 1.0
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.DEFEAT_GNOME_WARRIOR,
        ]
        self.completed_achievements = [
            Achievement.COLLECT_WOOD,
            Achievement.PLACE_TABLE,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.COLLECT_STONE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.COLLECT_DRINK,
            Achievement.WAKE_UP,
            Achievement.PLACE_FURNACE,
            Achievement.MAKE_IRON_PICKAXE,
            Achievement.MAKE_IRON_SWORD,
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.label = "DEFEAT_GNOME_WARRIOR"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,  # default, but explicit
            # All other multipliers remain at their default 1.0
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, mob_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on Floor 2 (Gnomish Mines)
        builder.set_starting_floor(2)

        # Equip starting inventory
        builder.set_player_inventory({
            "pickaxe": 2,
            "sword": 2,
            "torches": 5,
            "wood": 10,
            "stone": 10,
        })

        # Add one gnome warrior (melee, type_id 1) near the player spawn
        builder.add_mobs_randomly_near(
            rng=mob_rng,
            level=2,
            mob_name="melee",
            type_id=1,
            n=1,
            target_pos=builder.player_position,
            min_dist=8,
            max_dist=15,
            on_blocks=[BlockType.PATH, BlockType.STONE],
        )

        # Build the full state (no other modifications)
        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
