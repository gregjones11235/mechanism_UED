      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Build capability to progress from the Overworld through the Dungeon to the Gnomish Mines by crafting essential gear and defeating Orc Soldiers and Orc Mages under moderately increased hostile spawns.

Description: The agent starts on Floor 0 (Overworld) with completely empty inventory and all survival meters (food, drink, energy, health, mana) at maximum (9/9). No equipment, resources, or spells are provided. The world generation uses the default map layout for all floors. The game mechanics are tuned to be slightly easier than original Craftax but with harder spawns than the parent task: melee and ranged spawn multipliers are set to 0.75 (Orc Soldiers and Orc Mages appear 75% as often as in the full game), passive spawn multiplier is 0.5 (cows on Overworld, snails in Dungeon), needs_depletion_multiplier = 0.5 (hunger/thirst accrue at half speed), health_recover_multiplier = 2.0 (faster healing when well‑fed), and monsters_killed_to_clear_level reduced to 4 (only 4 hostile kills needed to unlock the ladder down). The agent must first survive the Overworld, gather wood and stone, craft a workbench and weapons (likely a Stone Sword), optionally find a Bow and arrows from chests, and then descend to the Dungeon (Floor 1). Inside the Dungeon, the agent must slay at least one Orc Soldier and one Orc Mage and then descend to Floor 2 (Gnomish Mines). The episode terminates successfully only when the ENTER_GNOMISH_MINES achievement is obtained.

Relevant Achievements: ENTER_DUNGEON, DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, ENTER_GNOMISH_MINES
Completed Achievements: (none)

World:
- Player: Starting floor 0; inventory: empty; all survival stats (food, drink, energy, health, mana) = 9/9; attributes: STR=1, DEX=1, INT=1; no learned spells.
- Map: No modifications; all levels use the standard procedural generation.
- Mechanics:
    "melee_spawn_multiplier": 0.75,
    "ranged_spawn_multiplier": 0.75,
    "passive_spawn_multiplier": 0.5,
    "needs_depletion_multiplier": 0.5,
    "health_recover_multiplier": 2.0,
    "monsters_killed_to_clear_level": 4
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.DEFEAT_ORC_SOLIDER,
            Achievement.DEFEAT_ORC_MAGE,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = []  # No pre-completed achievements
        self.label = "ENTER_DUNGEON, DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=0.75,
            ranged_spawn_multiplier=0.75,
            passive_spawn_multiplier=0.5,
            needs_depletion_multiplier=0.5,
            health_recover_multiplier=2.0,
            monsters_killed_to_clear_level=4,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on the overworld (floor 0) with default empty inventory and full stats
        builder.set_starting_floor(0)

        # No inventory modifications: default is empty, stats are 9/9, attributes 1/1/1

        state = builder.build(rng)

        # No completed achievements to pre-set
        return state</data>
