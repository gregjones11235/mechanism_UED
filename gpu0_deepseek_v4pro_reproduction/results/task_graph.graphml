      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Defeat four Gnome-type enemies on the pitch‑black Gnomish Mines floor and descend to the Sewers while managing hunger, thirst, and fatigue.

Description:
This task pushes the agent onto the second dungeon floor (the Gnomish Mines). The agent begins on floor 2 with equipment carried over from a successful floor‑1 run: a stone sword, a bow, 20 arrows, and 10 torches. All intrinsic needs are active at the standard rate (`needs_depletion_multiplier = 1.0`). The natural passive mob on this floor is the Bat, which can be killed and eaten for food (`EAT_BAT`); water can be collected from any water tile. The hostile mobs are Gnome Warriors (melee type 1, 9 health, 4 damage) and Gnome Archers (ranged type 1, 6 health, 2 damage). The Ladder Down to the Sewers (floor 3) is locked until the agent kills at least 4 hostile mobs (`monsters_killed_to_clear_level = 4`). The world generation uses the default SmoothGen for floor 2, which features a mix of path/stone terrain, stalagmites (trees), lava lakes, and a pitch‑black light level (0.0). The episode is a success when the agent uses the `DESCEND` action to enter the Sewers (achievements `ENTER_SEWERS`). No additional blocks, mobs, or items are manually placed; the only mechanical change is the lowered kill threshold.

Relevant Achievements: DEFEAT_GNOME_WARRIOR, DEFEAT_GNOME_ARCHER, ENTER_SEWERS

Completed Achievements: ENTER_DUNGEON, ENTER_GNOMISH_MINES, MAKE_STONE_SWORD, FIND_BOW, MAKE_ARROW, MAKE_TORCH

World:
- Player: Starts on floor 2 at the location of the Up Ladder. Inventory: `{"sword": 2, "bow": 1, "arrows": 20, "torches": 10}`. All attributes are at level 1; health, food, drink, and energy are at the maximum of 9.
- Map: No manual placements. The default floor 2 Gnomish Mines generation is used (SmoothGen with path/stone, stalagmites, lava, ores, pitch‑black lighting, and natural passive/melee/ranged mob spawns).
- Mechanics:
  * `monsters_killed_to_clear_level = 4`
  * `melee_spawn_multiplier = 1.0`
  * `ranged_spawn_multiplier = 1.0`
  * `passive_spawn_multiplier = 1.0`
  * `needs_depletion_multiplier = 1.0`
  * `health_recover_multiplier = 1.0`
  * `health_loss_multiplier = 1.0`
  * `mob_health_multiplier = 1.0`
  * `mob_damage_multiplier = 1.0`
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.DEFEAT_GNOME_WARRIOR,
            Achievement.DEFEAT_GNOME_ARCHER,
            Achievement.ENTER_SEWERS,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
            Achievement.MAKE_STONE_SWORD,
            Achievement.FIND_BOW,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_TORCH,
        ]
        self.label = "DEFEAT_GNOME_WARRIOR, DEFEAT_GNOME_ARCHER, ENTER_SEWERS"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=4,
            # All other multipliers remain at the default 1.0
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines) at the up-ladder position
        builder.set_starting_floor(2)

        # Equip starting gear: stone sword, bow, 20 arrows, 10 torches
        builder.set_player_inventory({
            "sword": 2,      # stone sword (tier 2)
            "bow": 1,
            "arrows": 20,
            "torches": 10,
        })

        # No manual block or mob placements

        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
