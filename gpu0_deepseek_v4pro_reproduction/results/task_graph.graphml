511628, "place_stone": 99.4186046511628, "eat_plant": 23.837209302325583, "defeat_skeleton": 15.116279069767442, "make_stone_pickaxe": 92.44186046511628, "make_stone_sword": 90.11627906976744, "wake_up": 87.20930232558139, "place_furnace": 99.4186046511628, "collect_coal": 94.18604651162791, "collect_iron": 83.72093023255815, "collect_diamond": 34.883720930232556, "make_iron_pickaxe": 32.55813953488372, "make_iron_sword": 52.325581395348834, "make_arrow": 97.09302325581395, "make_torch": 96.51162790697674, "place_torch": 95.34883720930233, "collect_sapphire": 29.069767441860463, "collect_ruby": 33.13953488372093, "make_diamond_pickaxe": 5.813953488372093, "make_diamond_sword": 7.558139534883721, "make_iron_armour": 4.069767441860465, "enter_gnomish_mines": 72.67441860465117, "enter_dungeon": 95.93023255813954, "defeat_orc_solider": 90.11627906976744, "defeat_orc_mage": 76.74418604651163, "eat_snail": 59.883720930232556, "find_bow": 92.44186046511628, "fire_bow": 88.95348837209302, "open_chest": 92.44186046511628, "drink_potion": 81.3953488372093}, "average_episode_length": 1654.9127906976744, "mean_return_percentage": 26.036213405536117, "mean_return": 58.84184229651163, "lp": NaN, "priority_score": 0.19858707409410495}]</data>
