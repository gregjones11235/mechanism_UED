 3.6199095022624435, "make_iron_armour": 6.787330316742081, "enter_gnomish_mines": 69.68325791855203, "enter_dungeon": 93.21266968325791, "defeat_orc_solider": 89.59276018099547, "defeat_orc_mage": 84.16289592760181, "eat_snail": 91.8552036199095, "find_bow": 92.3076923076923, "fire_bow": 91.4027149321267, "open_chest": 92.3076923076923, "drink_potion": 73.30316742081448}, "average_episode_length": 1218.3891402714933, "mean_return_percentage": 25.097955401208306, "mean_return": 56.72137920673077, "lp": NaN, "priority_score": 0.21125693577117588}]</data>
