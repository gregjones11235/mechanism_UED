      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to craft and place a torch in a dark environment.
    Description: The player must achieve the `MAKE_TORCH` and `PLACE_TORCH` achievements. The player begins on Floor 2 (Gnomish Mines), which is completely dark. They possess a wooden pickaxe, a wooden sword, 5 wood, and 5 coal. A crafting table is placed directly adjacent to the starting position (Manhattan distance 1). The task is to use the table to craft a torch (action `MAKE_TORCH`) and then place it (action `PLACE_TORCH`) on any valid empty ground tile, thereby illuminating the area. Hostile mobs are severely reduced to minimise combat distraction, and survival needs are slowed.
    Relevant Achievements: MAKE_TORCH, PLACE_TORCH
    Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD
    World:
    - Player: Starts on floor 2 with inventory {"pickaxe": 1, "sword": 1, "wood": 5, "coal": 5}.
    - Map: A single `CRAFTING_TABLE` block is placed at one step away from the player’s spawn location (e.g., if player spawns at (row, col), place table at (row+1, col) or any adjacent spot). No other block modifications.
    - Mechanics: "needs_depletion_multiplier = 0.5", "passive_spawn_multiplier = 1.0", "melee_spawn_multiplier = 0.1", "ranged_spawn_multiplier = 0.1"
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.MAKE_TORCH,
            Achievement.PLACE_TORCH,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
        ]
        self.label = "MAKE_TORCH, PLACE_TORCH"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=1.0,
            melee_spawn_multiplier=0.1,
            ranged_spawn_multiplier=0.1,
            needs_depletion_multiplier=0.5,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Set starting floor to 2 (Gnomish Mines)
        builder.set_starting_floor(2)

        # Provide initial inventory: wood pickaxe, wood sword, 5 wood, 5 coal
        builder.set_player_inventory(
            {"pickaxe": 1, "sword": 1, "wood": 5, "coal": 5}
        )

        # Place a crafting table directly adjacent (row+1) to the player spawn
        player_pos = builder.player_position
        adjacent_pos = (player_pos[0] + 1, player_pos[1])
        builder.place_block(
            level=2, block_type=BlockType.CRAFTING_TABLE, position=adjacent_pos
        )

        return builder.build(rng)</data>
