      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Graduated Dungeon clear – prepare on the Overworld and defeat six hostile mobs on floor 1 before entering the Gnomish Mines.

Description: The agent begins on the Overworld (floor 0) at the default center spawn with a wood pickaxe and 5 wood in inventory, all other slots empty. It must mine enough stone and coal to place a crafting table, craft a stone sword, and optionally craft torches to help in the Dungeon. The ladder to the Dungeon is already open (monsters_killed[0] = 10). Once on floor 1 (Dungeon), the agent must survive and kill **six** Orc Soldiers or Orc Mages (normal melee/ranged behavior, full damage) to satisfy the new clear requirement (`monsters_killed_to_clear_level = 6`). Only then can it descend via the ladder down to successfully enter the Gnomish Mines. The task succeeds when both MAKE_STONE_SWORD and ENTER_GNOMISH_MINES are achieved, enforcing that the crucial overworld preparation is not skipped and the harder floor‑1 fight is conquered. All other game mechanics remain at default values.

Relevant Achievements: MAKE_STONE_SWORD, ENTER_GNOMISH_MINES

Completed Achievements: MAKE_WOOD_PICKAXE

World:
- Player: Starting floor: 0 (Overworld). Inventory: wood_pickaxe=1, wood=5. All other inventory slots empty. Attributes: strength=1, dexterity=1, intelligence=1. Health/Food/Drink/Energy/Mana all 9/9. Enchantments and spells at default (none).
- Map: No manual block modifications; the default Overworld and Dungeon generation are used.
- Mechanics:
  - monsters_killed_to_clear_level = 6 (applies globally; floor 0 remains pre‑cleared with kills=10)
  - needs_depletion_multiplier = 1.0
  - mob_damage_multiplier = 1.0
  - health_recover_multiplier = 1.0
  - health_loss_multiplier = 1.0
  - mana_recover_multiplier = 1.0
  - All spawn multipliers (passive, melee, ranged) = 1.0
  - All other TaskParams at default.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.MAKE_STONE_SWORD,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
        ]
        self.label = "MAKE_STONE_SWORD, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=6,
            # All other multipliers default to 1.0, which is the TaskParams default.
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld)
        builder.set_starting_floor(0)

        # Initial inventory: wood pickaxe (tier 1) and 5 wood
        builder.set_player_inventory({
            "pickaxe": 1,   # wood pickaxe
            "wood": 5,
        })

        # Ensure the Overworld ladder down is pre‑opened (default is already 10, but explicit)
        builder.set_monsters_killed(level=0, count=10)

        # No block or mob modifications; default world generation
        state = builder.build(rng)

        # Mark the pre‑completed achievement
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
