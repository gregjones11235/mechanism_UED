e_wood_sword": 97.16599190283401, "place_plant": 100.0, "defeat_zombie": 65.18218623481782, "collect_stone": 97.97570850202429, "place_stone": 97.57085020242916, "eat_plant": 17.408906882591094, "defeat_skeleton": 59.51417004048583, "make_stone_pickaxe": 87.4493927125506, "make_stone_sword": 90.2834008097166, "wake_up": 91.90283400809717, "place_furnace": 97.57085020242916, "collect_coal": 91.49797570850203, "collect_iron": 63.96761133603239, "collect_diamond": 29.149797570850204, "make_iron_pickaxe": 22.267206477732792, "make_iron_sword": 30.76923076923077, "make_arrow": 93.52226720647774, "make_torch": 95.1417004048583, "place_torch": 94.33198380566802, "collect_sapphire": 26.720647773279353, "collect_ruby": 27.93522267206478, "make_diamond_pickaxe": 6.0728744939271255, "make_diamond_sword": 4.4534412955465585, "make_iron_armour": 2.0242914979757085, "enter_gnomish_mines": 62.34817813765182, "enter_dungeon": 96.76113360323886, "defeat_orc_solider": 94.33198380566802, "defeat_orc_mage": 88.66396761133603, "find_bow": 94.73684210526316, "fire_bow": 91.90283400809717, "open_chest": 94.73684210526316, "drink_potion": 81.37651821862349}, "average_episode_length": 1113.6518218623482, "mean_return_percentage": 24.05705789720003, "mean_return": 54.36895084767207, "lp": NaN, "priority_score": 0.23475224966808175}]</data>
