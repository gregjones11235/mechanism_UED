orch": 93.47826086956522, "place_torch": 92.7536231884058, "collect_sapphire": 30.07246376811594, "collect_ruby": 29.347826086956523, "make_diamond_pickaxe": 3.6231884057971016, "make_diamond_sword": 2.536231884057971, "enter_gnomish_mines": 56.15942028985507, "enter_dungeon": 100.0, "defeat_orc_solider": 96.73913043478261, "defeat_orc_mage": 92.02898550724638, "eat_snail": 97.10144927536231, "find_bow": 99.27536231884058, "fire_bow": 89.85507246376811, "open_chest": 99.27536231884058, "drink_potion": 86.59420289855072}, "average_episode_length": 968.2173913043479, "mean_return_percentage": 20.922212795185647, "mean_return": 47.28420091711956, "lp": NaN, "priority_score": 0.24620615416929215}]</data>
