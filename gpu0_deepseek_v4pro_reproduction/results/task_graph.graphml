plant": 10.455764075067025, "defeat_skeleton": 28.41823056300268, "make_stone_pickaxe": 48.525469168900806, "wake_up": 95.71045576407506, "place_furnace": 50.938337801608576, "collect_coal": 72.11796246648794, "collect_iron": 68.36461126005362, "collect_diamond": 34.048257372654156, "make_iron_pickaxe": 25.201072386058982, "make_iron_sword": 28.41823056300268, "make_torch": 94.10187667560322, "place_torch": 90.88471849865952, "collect_sapphire": 29.490616621983914, "collect_ruby": 28.15013404825737, "make_diamond_pickaxe": 5.361930294906166, "make_diamond_sword": 3.753351206434316, "make_iron_armour": 3.485254691689008, "enter_gnomish_mines": 65.68364611260054, "enter_dungeon": 100.0, "defeat_orc_solider": 97.85522788203754, "defeat_orc_mage": 93.2975871313673, "eat_snail": 97.31903485254692, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 99.46380697050938, "drink_potion": 80.9651474530831}, "average_episode_length": 735.201072386059, "mean_return_percentage": 20.23110164238772, "mean_return": 45.72228971179624, "lp": NaN, "priority_score": 0.22540232446147102}]</data>
