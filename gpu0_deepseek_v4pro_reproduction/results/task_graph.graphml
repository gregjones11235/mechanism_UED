nt_srs": {"collect_wood": 98.70828848223897, "place_table": 96.55543595263724, "eat_cow": 90.20452099031216, "collect_sapling": 86.97524219590959, "collect_drink": 88.80516684607105, "make_wood_pickaxe": 94.72551130247578, "place_plant": 84.93003229278794, "defeat_zombie": 85.14531754574811, "collect_stone": 93.43379978471475, "place_stone": 91.60387513455328, "eat_plant": 2.1528525296017222, "defeat_skeleton": 8.611410118406889, "make_stone_pickaxe": 72.65877287405813, "make_stone_sword": 52.529601722282024, "wake_up": 55.86652314316469, "place_furnace": 85.79117330462863, "collect_coal": 69.96770721205597, "collect_iron": 38.32077502691066, "collect_diamond": 3.8751345532831003, "make_iron_pickaxe": 2.798708288482239, "make_iron_sword": 13.778256189451023, "make_arrow": 69.53713670613563, "make_torch": 60.818083961248654, "place_torch": 57.481162540365986, "collect_sapphire": 2.6910656620021527, "collect_ruby": 3.1216361679224973, "make_diamond_pickaxe": 0.5382131324004306, "make_diamond_sword": 0.6458557588805167, "make_iron_armour": 0.21528525296017223, "enter_dungeon": 37.13670613562971, "defeat_orc_solider": 9.472551130247577, "defeat_orc_mage": 1.1840688912809472, "eat_snail": 12.701829924650161, "find_bow": 35.84499461786868, "fire_bow": 27.771797631862217, "open_chest": 35.84499461786868, "drink_potion": 14.854682454251884}, "average_episode_length": 302.1237890204521, "mean_return_percentage": 16.452379896310617, "mean_return": 37.182378565662, "lp": NaN, "priority_score": 0.126480665460853}]</data>
