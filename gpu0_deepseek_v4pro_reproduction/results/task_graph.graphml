      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Clear the Gnomish Mines under realistic survival pressure, learn to eat bats, and descend to the Sewers.
Description: The agent begins on floor 2 (the Gnomish Mines) with the equipment of a successful dungeon‑to‑mines run: iron pickaxe, iron sword, bow, 10 arrows, 10 torches, and a small supply of wood (5) and stone (5). All status bars (health, food, drink, energy, mana) start at 9. The Gnomish Mines are procedurally generated (SmoothGen) with pitch‑black lighting, lava lakes, stalagmites, and water bodies. Gnome Warriors (melee) and Gnome Archers (ranged) are the native hostile mobs; bats (passive) inhabit the darkness. The ladder down to floor 3 (the Sewers) is initially locked; the agent must kill exactly 8 hostile mobs (any mix of gnomes) to unlock it. In addition, the agent must locate and eat a bat to satisfy the sub‑goal EAT_BAT. Survival pressure is at original Craftax intensity (needs_depletion_multiplier = 1.0), forcing careful management of hunger, thirst, and fatigue while fighting in the dark. No crafting or backtracking to earlier floors is necessary—all overworld and dungeon achievements are marked as completed, and the agent starts with everything needed to focus on the new floor’s challenges. This task targets the global bottleneck of the mine‑to‑sewer transition and introduces the critical survival skill of consuming bats.
Relevant Achievements: ENTER_SEWERS, EAT_BAT
Completed Achievements: COLLECT_WOOD, PLACE_TABLE, MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD, COLLECT_STONE, PLACE_STONE, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, PLACE_FURNACE, COLLECT_COAL, COLLECT_IRON, MAKE_IRON_PICKAXE, MAKE_IRON_SWORD, MAKE_ARROW, MAKE_TORCH, PLACE_TORCH, ENTER_DUNGEON, ENTER_GNOMISH_MINES
World:
- Player: `set_starting_floor(2)`. `set_player_inventory({"wood": 5, "stone": 5, "coal": 2, "iron": 2, "pickaxe": 3, "sword": 3, "bow": 1, "arrows": 10, "torch": 10})`. All attributes default (STR=1, DEX=1, INT=1).
- Map: No manual block placements. Floor 2 is generated with the default SmoothGen procedure, including water, lava, stalagmites, and darkness.
- Mechanics:
  - monsters_killed_to_clear_level = 8
  - needs_depletion_multiplier = 1.0
  - mob_health_multiplier = 1.0
  - mob_damage_multiplier = 1.0
  - melee_spawn_multiplier = 1.0
  - ranged_spawn_multiplier = 1.0
  - passive_spawn_multiplier = 1.0
  - health_recover_multiplier = 1.0
  - health_loss_multiplier = 1.0
  - mana_recover_multiplier = 1.0
  - growing_plants_age = 600
  - All other parameters at defaults.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_SEWERS,
            Achievement.EAT_BAT,
        ]
        self.completed_achievements = [
            Achievement.COLLECT_WOOD,
            Achievement.PLACE_TABLE,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.COLLECT_STONE,
            Achievement.PLACE_STONE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.PLACE_FURNACE,
            Achievement.COLLECT_COAL,
            Achievement.COLLECT_IRON,
            Achievement.MAKE_IRON_PICKAXE,
            Achievement.MAKE_IRON_SWORD,
            Achievement.MAKE_ARROW,
            Achievement.MAKE_TORCH,
            Achievement.PLACE_TORCH,
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.label = "ENTER_SEWERS, EAT_BAT"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
            needs_depletion_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            growing_plants_age=600,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines)
        builder.set_starting_floor(2)

        # Equip starting inventory: iron pickaxe, iron sword, bow, arrows, torches, resources
        builder.set_player_inventory({
            "wood": 5,
            "stone": 5,
            "coal": 2,
            "iron": 2,
            "pickaxe": 3,   # iron pickaxe
            "sword": 3,     # iron sword
            "bow": 1,
            "arrows": 10,
            "torches": 10,  # note: field name is "torches"
        })

        # No manual block or mob placements; rely on default SmoothGen for floor 2

        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
