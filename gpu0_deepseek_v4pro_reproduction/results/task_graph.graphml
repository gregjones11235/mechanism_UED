      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Teach the agent to craft an iron sword, defeat four orcs in the Dungeon, and descend to the Gnomish Mines.

Description: The agent starts on Floor 0 with a stone pickaxe, a wood sword, and small amounts of wood and stone. A crafting table and a furnace are already placed near spawn (at (25,25) and (23,25)), and the Overworld's ladder down is unlocked (monsters_killed_to_clear_level on floor 0 = 8). Two coal blocks and two iron blocks are placed within a 3‑tile radius, exactly replicating the parent task's workshop. The agent must mine these resources, stand next to both the table and furnace, and craft an iron sword (consuming 1 wood, 1 stone, 1 iron, 1 coal). All other mob spawns are disabled. Once holding the iron sword, the agent descends to Floor 1 (Dungeon). On that floor, four hostile mobs are pre‑placed: two Orc Soldiers (melee, type_id=2) and two Orc Mages (ranged, type_id=2), positioned randomly between 3 and 7 Manhattan distance from the spawn‑in point. The floor‑clear requirement is raised to 4 kills (monsters_killed_to_clear_level=4), meaning the ladder down to the Gnomish Mines only becomes usable after all four are defeated. The task succeeds when the agent, after forging the iron sword, kills all four orcs and then uses the DESCEND action on the ladder down to enter Floor 2 (Gnomish Mines). Survival needs deplete at 75% of the normal rate to keep the focus on combat. All other TaskParams remain at the parent values (no other mobs spawn, standard health/damage scaling).

Relevant Achievements: MAKE_IRON_SWORD, DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, ENTER_GNOMISH_MINES.

Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_STONE_PICKAXE, MAKE_WOOD_SWORD, PLACE_TABLE, PLACE_FURNACE.

World:
- Player: Floor 0 (spawn at center, approx. (24,24)). Inventory: {"pickaxe": 2, "sword": 1, "wood": 5, "stone": 4, "torch": 10}. Stats: Strength=1, Dexterity=1, Intelligence=1. Health/Food/Drink/Energy/Mana all 9/9. Learned spells: none. Weapon/Armour enchantments: none.
- Map:
    - Floor 0:
        - Place CRAFTING_TABLE at (25, 25).
        - Place FURNACE at (23, 25).
        - Place COAL blocks at (26, 24) and (24, 26).
        - Place IRON blocks at (22, 24) and (24, 22).
        - Set monsters killed for floor 0 to 8: `set_monsters_killed(0, 8)`.
    - Floor 1 (Dungeon, default generation):
        - Place two melee mobs (Orc Soldier, "melee", type_id=2) using `add_mobs_randomly_near` with target_pos = player spawn coordinates, n=2, min_dist=3, max_dist=7, on_blocks=[BlockType.PATH].
        - Place two ranged mobs (Orc Mage, "ranged", type_id=2) using `add_mobs_randomly_near` with the same parameters (n=2, min_dist=3, max_dist=7, on_blocks=[BlockType.PATH]).
        - Do not place any other mobs.
- Mechanics:
    "needs_depletion_multiplier": 0.75,
    "melee_spawn_multiplier": 0.0,
    "ranged_spawn_multiplier": 0.0,
    "passive_spawn_multiplier": 0.0,
    "monsters_killed_to_clear_level": 4,
    "health_recover_multiplier": 1.0,
    "health_loss_multiplier": 1.0,
    "mob_health_multiplier": 1.0,
    "mob_damage_multiplier": 1.0
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.MAKE_IRON_SWORD,
            Achievement.DEFEAT_ORC_SOLIDER,
            Achievement.DEFEAT_ORC_MAGE,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.PLACE_TABLE,
            Achievement.PLACE_FURNACE,
        ]
        self.label = "MAKE_IRON_SWORD, DEFEAT_ORC_SOLIDER, DEFEAT_ORC_MAGE, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.75,
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            passive_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=4,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, melee_rng, ranged_rng = jax.random.split(rng, 4)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 0 (Overworld) at default centre
        builder.set_starting_floor(0)

        # Equip starting inventory: stone pickaxe (tier 2), wood sword (tier 1), wood, stone, torches
        builder.set_player_inventory({
            "pickaxe": 2,
            "sword": 1,
            "wood": 5,
            "stone": 4,
            "torches": 10,
        })

        # Floor 0: Place crafting table and furnace near spawn
        builder.place_block(0, BlockType.CRAFTING_TABLE, (25, 25))
        builder.place_block(0, BlockType.FURNACE, (23, 25))

        # Floor 0: Place coal blocks
        builder.place_block(0, BlockType.COAL, (26, 24))
        builder.place_block(0, BlockType.COAL, (24, 26))

        # Floor 0: Place iron blocks
        builder.place_block(0, BlockType.IRON, (22, 24))
        builder.place_block(0, BlockType.IRON, (24, 22))

        # Unlock the overworld ladder down
        builder.set_monsters_killed(0, 8)

        # Floor 1: Spawn point is the up-ladder position
        spawn_pos_floor1 = builder.ladders_up[1]

        # Place two Orc Soldiers (melee, type_id=2) within Manhattan distance 3–7
        builder.add_mobs_randomly_near(
            melee_rng,
            level=1,
            mob_name="melee",
            type_id=2,
            n=2,
            target_pos=spawn_pos_floor1,
            min_dist=3,
            max_dist=7,
            on_blocks=[BlockType.PATH],
        )

        # Place two Orc Mages (ranged, type_id=2) within Manhattan distance 3–7
        builder.add_mobs_randomly_near(
            ranged_rng,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=2,
            target_pos=spawn_pos_floor1,
            min_dist=3,
            max_dist=7,
            on_blocks=[BlockType.PATH],
        )

        state = builder.build(rng)

        # Mark pre-completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
