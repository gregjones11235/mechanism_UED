      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Master iron armour crafting while defending against dynamically spawning overworld enemies, bridging the gap between static‑environment proficiency and sustained‑threat survival.

Description: The agent starts on the overworld (floor 0) at (24, 24) with a stone pickaxe (level 2), a stone sword (level 2), 5 wood, and 5 stone. A crafting table is already placed at (20, 24). Five iron blocks and five coal blocks are randomly distributed on stone tiles within a Manhattan distance of 3–12 from (24, 24), guaranteeing accessible ore without long expeditions. A single zombie melee mob (mob_name="zombie", type_id=0) is placed randomly on grass tiles at distance 4–10 from the start. No other initial enemies are present. However, natural mob spawning is enabled: melee (zombie) spawning scales at 0.5× the default rate, ranged (skeleton) spawning at 0.3×, and passive (cow) spawning at the normal 1.0× rate. This introduces a steady stream of new threats over time, forcing the agent to juggle mining, furnace placement, and combat while maintaining health and survival. The agent must collect 3 iron and 3 coal, craft a furnace (cost: 1 stone), place it adjacent to the table, and execute `MAKE_IRON_ARMOUR` while near both stations. The goal is to successfully craft iron armour under ongoing overworld pressure, thereby building the combat and multitasking skills required for later floors.

Relevant Achievements: MAKE_IRON_ARMOUR

Completed Achievements: COLLECT_WOOD, PLACE_TABLE, COLLECT_STONE, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD

World:
- Player: Starts on floor 0 at (24, 24) with inventory {"wood": 5, "stone": 5, "pickaxe": 2, "sword": 2}.
- Map:
  - Place a CRAFTING_TABLE at coordinates (20, 24).
  - Place 5 IRON blocks randomly on level 0 on tiles of type BlockType.STONE, within Manhattan distance 3 to 12 from (24, 24) (use place_randomly_near).
  - Place 5 COAL blocks randomly on level 0 on tiles of type BlockType.STONE, within Manhattan distance 3 to 12 from (24, 24).
  - Add 1 zombie melee mob (mob_name = "zombie", type_id = 0) randomly on level 0 on tiles of type BlockType.GRASS, with target_pos = (24, 24), min_dist = 4, max_dist = 10.
- Mechanics:
  - melee_spawn_multiplier = 0.5
  - ranged_spawn_multiplier = 0.3
  - passive_spawn_multiplier = 1.0
  - needs_depletion_multiplier = 1.0
  - All other TaskParams at default values.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.MAKE_IRON_ARMOUR]
        self.completed_achievements = [
            Achievement.COLLECT_WOOD,
            Achievement.PLACE_TABLE,
            Achievement.COLLECT_STONE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
        ]
        self.label = "MAKE_IRON_ARMOUR"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=0.5,
            ranged_spawn_multiplier=0.3,
            passive_spawn_multiplier=1.0,
            needs_depletion_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)
        rng, iron_rng = jax.random.split(rng)
        rng, coal_rng = jax.random.split(rng)
        rng, zombie_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        builder.set_starting_floor(0)
        builder.set_player_inventory(
            {"wood": 5, "stone": 5, "pickaxe": 2, "sword": 2}
        )

        # Place crafting table at (20, 24)
        builder.place_block(level=0, block_type=BlockType.CRAFTING_TABLE, position=(20, 24))

        # Place 5 iron blocks near start on stone tiles
        builder.place_randomly_near(
            iron_rng,
            level=0,
            block_type=BlockType.IRON,
            n=5,
            target_pos=(24, 24),
            min_dist=3,
            max_dist=12,
            on_blocks=[BlockType.STONE],
        )

        # Place 5 coal blocks near start on stone tiles
        builder.place_randomly_near(
            coal_rng,
            level=0,
            block_type=BlockType.COAL,
            n=5,
            target_pos=(24, 24),
            min_dist=3,
            max_dist=12,
            on_blocks=[BlockType.STONE],
        )

        # Add one zombie on grass at distance 4-10
        builder.add_mobs_randomly_near(
            zombie_rng,
            level=0,
            mob_name="melee",
            type_id=0,  # Zombie
            n=1,
            target_pos=(24, 24),
            min_dist=4,
            max_dist=10,
            on_blocks=[BlockType.GRASS],
        )

        return builder.build(rng)</data>
