      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to clear the Dungeon floor by defeating enough hostile monsters to unlock the ladder, then descend to the Gnomish Mines.

Description: The agent begins on Floor 1 (Dungeon) at the ladder‑up arrival point with an iron sword (`{"sword": 3}`). Natural melee and ranged spawning is enabled at half rate (`melee_spawn_multiplier = 0.5`, `ranged_spawn_multiplier = 0.5`), generating Orc Soldiers and Orc Mages. No passive mobs spawn (`passive_spawn_multiplier = 0.0`). The world is otherwise a default Dungeon layout with chests, fountains, and torches. To succeed, the agent must defeat 5 hostile monsters (the lowered level‑clear requirement) to unlock the ladder down, then navigate to the ladder and use `Action.DESCEND` to enter Floor 2 (Gnomish Mines), earning the `ENTER_GNOMISH_MINES` achievement. Survival pressure remains moderate: needs deplete at 50% of normal speed (`needs_depletion_multiplier = 0.5`) and natural health regeneration is doubled (`health_recover_multiplier = 2.0`). Other mechanics are default.

Relevant Achievements: ENTER_GNOMISH_MINES  
Completed Achievements: ENTER_DUNGEON, MAKE_IRON_SWORD  
World:
- Player: Starting floor 1; inventory contains an iron sword (`{"sword": 3}`). All other stats at default (full health, food, drink, energy, mana).
- Map: No block modifications – the default Dungeon generation is used without manual mob placements or additional fountains.
- Mechanics:
    "needs_depletion_multiplier": 0.5,
    "health_recover_multiplier": 2.0,
    "melee_spawn_multiplier": 0.5,
    "ranged_spawn_multiplier": 0.5,
    "passive_spawn_multiplier": 0.0,
    "monsters_killed_to_clear_level": 5
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_GNOMISH_MINES]
        self.completed_achievements = [Achievement.ENTER_DUNGEON, Achievement.MAKE_IRON_SWORD]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            needs_depletion_multiplier=0.5,
            health_recover_multiplier=2.0,
            melee_spawn_multiplier=0.5,
            ranged_spawn_multiplier=0.5,
            passive_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=5
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        builder = WorldBuilder(rng, self.static_params, self.params)
        builder.set_starting_floor(1)
        builder.set_player_inventory({"sword": 3})  # 3 = iron sword
        return builder.build(rng)</data>
