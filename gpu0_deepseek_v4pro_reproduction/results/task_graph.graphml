      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to navigate pitch‑black Gnomish Mines, defeat Gnome Warriors and Archers, and descend to the Sewers.

    Description: The agent begins on floor 2 (Gnomish Mines) at the “ladder up” position. The environment is procedurally generated and completely dark (light level 0.0), so torch placement is essential for vision and combat. The agent starts with an Iron Sword (tier 3), Iron Pickaxe (tier 3), a Bow, 20 Arrows, and 20 Torches, as well as maximum Food and Drink (9 each) to buffer immediate survival pressure. The goal is to kill at least 8 hostiles (Gnome Warriors and Gnome Archers) to unlock the ladder down, then descend to floor 3 (Sewers), achieving ENTER_SEWERS. Survival pressure is moderate, with `needs_depletion_multiplier = 0.5`, encouraging the agent to hunt Bats for food while managing torch supplies. All mob stats and spawn rates remain at default values; the agent cannot retreat to earlier floors for resources, forcing reliance on the Gnomish Mines’ own features.

    Relevant Achievements: ENTER_SEWERS

    Completed Achievements: ENTER_DUNGEON, ENTER_GNOMISH_MINES, MAKE_WOOD_PICKAXE, MAKE_STONE_PICKAXE, MAKE_IRON_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_SWORD, MAKE_IRON_SWORD, FIND_BOW

    World:
    - Player: Start on floor 2 at the ladder‑up position. Inventory: sword = 3 (iron tier), pickaxe = 3 (iron tier), bow = 1, arrows = 20, torch = 20, food = 9, drink = 9. All attributes default (strength=1, dexterity=1, intelligence=1). Health, mana, energy maxed at 9. No weapon or armour enchantments, no learned spells.
    - Map: Use the default procedural generation for all 9 floors; no additional block modifications.
    - Mechanics:
      - monsters_killed_to_clear_level = 8
      - needs_depletion_multiplier = 0.5
      - All other TaskParams at defaults (passive_spawn_multiplier = 1.0, melee_spawn_multiplier = 1.0, ranged_spawn_multiplier = 1.0, mob_health_multiplier = 1.0, mob_damage_multiplier = 1.0, health_recover_multiplier = 1.0, health_loss_multiplier = 1.0, mana_recover_multiplier = 1.0, growing_plants_age = 600, melee_trigger_distance = 10).
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_SEWERS,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_IRON_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_IRON_SWORD,
            Achievement.FIND_BOW,
        ]
        self.label = "ENTER_SEWERS"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=8,
            needs_depletion_multiplier=0.5,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines) at the up‑ladder position
        builder.set_starting_floor(2)

        # Equip starting inventory: iron sword, iron pickaxe, bow, arrows, torches
        builder.set_player_inventory({
            "sword": 3,    # iron
            "pickaxe": 3,  # iron
            "bow": 1,
            "arrows": 20,
            "torches": 20,
        })

        # No mob or block modifications; use default procedural generation
        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
