      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to locate the overworld ladder and descend into the dungeon for the first time.

    Description: The agent must achieve the `ENTER_DUNGEON` achievement by moving to the `LADDER_DOWN` block on Floor 0 and executing the `DESCEND` action. The ladder is already open (no kill requirement), and the world generates normally with the ladder placed somewhere on the map. Hostile mobs are present but rare, and survival needs are relaxed to keep the focus on exploration and the single new mechanic of descending. The agent begins with a stone sword, a wood pickaxe, basic resources, and full food/drink so that no crafting or initial foraging is required.

    Relevant Achievements: ENTER_DUNGEON

    Completed Achievements: MAKE_STONE_SWORD, MAKE_WOOD_PICKAXE

    World:
    - Player:
      - Starts on floor 0.
      - Inventory: `{"sword": 1, "pickaxe": 1, "wood": 10, "stone": 10, "food": 9, "drink": 9, "torches": 5}`.
      - Completed achievements: `MAKE_STONE_SWORD`, `MAKE_WOOD_PICKAXE`.
    - Map:
      - No block modifications; default overworld generation applies (normal terrain, ores, trees, etc.).
      - No pre‑placed mobs; all mobs appear only through spawning.
    - Mechanics:
      - `needs_depletion_multiplier = 0.5`
      - `health_recover_multiplier = 1.0`
      - `health_loss_multiplier = 1.0`
      - `mana_recover_multiplier = 1.0`
      - `melee_spawn_multiplier = 0.2`
      - `ranged_spawn_multiplier = 0.2`
      - `passive_spawn_multiplier = 0.5`
      - `melee_trigger_distance = 5`
      - `monsters_killed_to_clear_level` (floor 0) remains at the default 0 (ladder always open).
    """

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [Achievement.ENTER_DUNGEON]
        self.completed_achievements = [
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_WOOD_PICKAXE,
        ]
        self.label = "ENTER_DUNGEON"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            passive_spawn_multiplier=0.5,
            melee_spawn_multiplier=0.2,
            ranged_spawn_multiplier=0.2,
            melee_trigger_distance=5,
            monsters_killed_to_clear_level=0,
            needs_depletion_multiplier=0.5,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)
        builder.set_starting_floor(0)

        # Give the agent a stone sword, wood pickaxe, and basic supplies.
        builder.set_player_inventory(
            {"pickaxe": 1, "sword": 1, "wood": 10, "stone": 10, "torches": 5}
        )

        state = builder.build(rng)

        # Pre-set the completed achievements.
        achievements = state.achievements.at[Achievement.MAKE_STONE_SWORD.value].set(
            True
        )
        achievements = achievements.at[Achievement.MAKE_WOOD_PICKAXE.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
