      <data key="d3">import jax
from craftax.craftax.constants import Achievement, BlockType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to clear a floor by defeating multiple enemies and descending to the next level.

Description:
The agent begins on floor 1 (the Dungeon) with a stone sword, wooden pickaxe, and 5 wood. Two Orc Soldiers (melee, type_id=2) and one Orc Mage (ranged, type_id=2) are placed at random locations within Manhattan distance 5–10 from the player’s spawn point. All dynamic spawning is disabled. The `monsters_killed_to_clear_level` parameter is set to 3, meaning the agent must defeat all three placed mobs to unlock the ladder down to the Gnomish Mines. The agent must then navigate to the ladder and use the DESCEND action to reach floor 2, triggering the ENTER_GNOMISH_MINES achievement. Survival needs (hunger, thirst, fatigue) are turned off, and normal health regeneration is active. Torch crafting is optional and not required for success.

Relevant Achievements:
- ENTER_GNOMISH_MINES

Completed Achievements:
- ENTER_DUNGEON
- MAKE_WOOD_PICKAXE
- MAKE_STONE_SWORD

World:
- Player: Start on floor 1. Inventory: `{"sword": 2, "pickaxe": 1, "wood": 5}` (stone sword, wooden pickaxe, 5 wood). No other items. The player is placed at the “up ladder” position of floor 1.
- Map:
  * Use `add_mobs_randomly_near` to place **two Orc Soldiers** (melee mob, type_id=2) on floor 1, targeting the player’s spawn point, with `min_dist=5`, `max_dist=10`, and `on_blocks=[BlockType.PATH, BlockType.GRASS, BlockType.STONE]`.
  * Use `add_mobs_randomly_near` to place **one Orc Mage** (ranged mob, type_id=2) on floor 1, with the same parameters.
  * No other blocks, mobs, or items are added. The default dungeon layout and ladder positions remain unchanged.
- Mechanics:
  * `melee_spawn_multiplier = 0.0`
  * `ranged_spawn_multiplier = 0.0`
  * `passive_spawn_multiplier = 0.0`
  * `monsters_killed_to_clear_level = 3`
  * `needs_depletion_multiplier = 0.0`
  * `health_recover_multiplier = 1.0`
  * `mob_health_multiplier = 1.0`
  * `mob_damage_multiplier = 1.0`
  * All other `TaskParams` at their default values.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=0.0,
            ranged_spawn_multiplier=0.0,
            passive_spawn_multiplier=0.0,
            monsters_killed_to_clear_level=3,
            needs_depletion_multiplier=0.0,
            health_recover_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, mob_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the up-ladder position
        builder.set_starting_floor(1)

        # Equip starting inventory: stone sword, wooden pickaxe, 5 wood
        builder.set_player_inventory({
            "sword": 2,
            "pickaxe": 1,
            "wood": 5,
        })

        # Spawn position for mob placement
        spawn_pos = builder.player_position

        # Split mob rng for the three placements
        mob_rng1, mob_rng2, mob_rng3 = jax.random.split(mob_rng, 3)

        # Place two Orc Soldiers (melee, type_id=2)
        builder.add_mobs_randomly_near(
            mob_rng1,
            level=1,
            mob_name="melee",
            type_id=2,
            n=1,
            target_pos=spawn_pos,
            min_dist=5,
            max_dist=10,
            on_blocks=[BlockType.PATH, BlockType.GRASS, BlockType.STONE],
        )
        builder.add_mobs_randomly_near(
            mob_rng2,
            level=1,
            mob_name="melee",
            type_id=2,
            n=1,
            target_pos=spawn_pos,
            min_dist=5,
            max_dist=10,
            on_blocks=[BlockType.PATH, BlockType.GRASS, BlockType.STONE],
        )

        # Place one Orc Mage (ranged, type_id=2)
        builder.add_mobs_randomly_near(
            mob_rng3,
            level=1,
            mob_name="ranged",
            type_id=2,
            n=1,
            target_pos=spawn_pos,
            min_dist=5,
            max_dist=10,
            on_blocks=[BlockType.PATH, BlockType.GRASS, BlockType.STONE],
        )

        state = builder.build(rng)

        # Mark completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
