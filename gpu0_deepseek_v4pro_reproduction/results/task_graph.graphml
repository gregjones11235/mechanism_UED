t_drink": 98.7603305785124, "make_wood_pickaxe": 100.0, "make_wood_sword": 100.0, "place_plant": 99.17355371900827, "defeat_zombie": 68.59504132231405, "collect_stone": 99.58677685950413, "place_stone": 99.58677685950413, "eat_plant": 20.66115702479339, "defeat_skeleton": 69.42148760330579, "wake_up": 96.69421487603306, "place_furnace": 98.7603305785124, "collect_coal": 91.32231404958678, "collect_iron": 86.77685950413223, "collect_diamond": 31.40495867768595, "make_iron_pickaxe": 36.36363636363637, "make_iron_sword": 68.18181818181819, "make_arrow": 100.0, "make_torch": 100.0, "place_torch": 100.0, "collect_sapphire": 28.925619834710744, "collect_ruby": 24.793388429752067, "make_diamond_pickaxe": 1.2396694214876034, "make_diamond_sword": 3.3057851239669422, "make_iron_armour": 9.917355371900827, "enter_gnomish_mines": 64.46280991735537, "enter_dungeon": 96.28099173553719, "defeat_orc_solider": 93.38842975206612, "defeat_orc_mage": 90.49586776859505, "eat_snail": 94.62809917355372, "find_bow": 100.0, "fire_bow": 100.0, "open_chest": 95.45454545454545, "drink_potion": 83.88429752066116}, "average_episode_length": 1150.0289256198348, "mean_return_percentage": 22.82433616890953, "mean_return": 51.582999741735534, "lp": NaN, "priority_score": 0.2290827129294447}]</data>
