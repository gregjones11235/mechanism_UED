e_stone": 8.97257089725709, "wake_up": 23.10553231055323, "collect_diamond": 14.411901441190144, "make_iron_pickaxe": 5.718270571827057, "make_torch": 63.31938633193863, "place_torch": 61.22733612273361, "collect_sapphire": 10.646211064621106, "make_diamond_pickaxe": 1.7666201766620178, "make_diamond_sword": 1.487680148768015, "enter_dungeon": 100.0, "defeat_orc_solider": 86.47140864714086, "defeat_orc_mage": 80.0557880055788, "find_bow": 100.0, "fire_bow": 99.814039981404, "open_chest": 90.2835890283589, "drink_potion": 49.00046490004649}, "average_episode_length": 127.77545327754532, "mean_return_percentage": 13.421174017898652, "mean_return": 30.331853280450954, "lp": NaN, "priority_score": 0.20276298894203576}]</data>
