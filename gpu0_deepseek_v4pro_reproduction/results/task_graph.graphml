      <data key="d3">import jax
import jax.numpy as jnp
from craftax.craftax.constants import Achievement, BlockType, ItemType
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Train the agent to travel from the Overworld to floor 2 (Gnomish Mines) while managing mildly increased survival demands and crafting its own ammunition.

Description: The episode begins on floor 0 (Overworld) with the player spawning at the centre. The ladder down is already unlocked (`monsters_killed[0] = 8`), so the agent can immediately descend. The agent is equipped with a stone pickaxe, stone sword, and a bow, but **no arrows, torches, coal, or other consumables**. Survival mechanics are set to moderate: `needs_depletion_multiplier = 0.5`, `health_recover_multiplier = 1.0`, `health_loss_multiplier = 1.0`, making hunger, thirst, and fatigue relevant but not overwhelming. On floor 1 (the Dungeon), a single `LADDER_DOWN` is placed on a `PATH` block within Manhattan distance 2–10 from the player’s spawn point, guaranteeing a reachable descent point. The floor must be cleared by defeating 8 orcs (Orc Soldiers, Orc Mages, spawned at standard rates). Once the kill requirement is met and the agent steps on the ladder, `DESCEND` unlocks `ENTER_GNOMISH_MINES` and terminates the episode with success. The agent is free to collect resources and craft arrows on either floor, encouraging efficient preparation.

Relevant Achievements: ENTER_DUNGEON, ENTER_GNOMISH_MINES
Completed Achievements: MAKE_WOOD_PICKAXE, MAKE_STONE_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_SWORD, FIND_BOW

World:
- Player:
  - Starting floor = 0.
  - Inventory: `{"pickaxe": 2, "sword": 2, "bow": 1}`.
  - Stats: `dexterity=1, strength=1, intelligence=1`.
  - `set_monsters_killed(level=0, count=8)` to open the Overworld ladder.
- Map:
  - On level 1, place exactly one `LADDER_DOWN` using `place_randomly_near` on `PATH` blocks, within Manhattan distance 2–10 from the player’s spawn point on that floor.
- Mechanics:
  - `melee_spawn_multiplier = 1.0`
  - `ranged_spawn_multiplier = 1.0`
  - `passive_spawn_multiplier = 1.0`
  - `mob_health_multiplier = 1.0`
  - `mob_damage_multiplier = 1.0`
  - `needs_depletion_multiplier = 0.5`
  - `health_recover_multiplier = 1.0`
  - `health_loss_multiplier = 1.0`
  - `mana_recover_multiplier = 1.0`
  - `monsters_killed_to_clear_level = 8`  (applies to both floors; floor 0 is pre‑cleared)
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_SWORD,
            Achievement.FIND_BOW,
        ]
        self.label = "ENTER_DUNGEON, ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            melee_spawn_multiplier=1.0,
            ranged_spawn_multiplier=1.0,
            passive_spawn_multiplier=1.0,
            mob_health_multiplier=1.0,
            mob_damage_multiplier=1.0,
            needs_depletion_multiplier=0.5,
            health_recover_multiplier=1.0,
            health_loss_multiplier=1.0,
            mana_recover_multiplier=1.0,
            monsters_killed_to_clear_level=8,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng, ladder_rng = jax.random.split(rng, 3)

        builder = WorldBuilder(build_rng, self.static_params, self.params)
        builder.set_starting_floor(0)

        # Equip stone pickaxe, stone sword, and bow (no arrows/torches)
        builder.set_player_inventory({
            "pickaxe": 2,
            "sword": 2,
            "bow": 1,
        })

        # Unlock the Overworld ladder immediately
        builder.set_monsters_killed(0, 8)

        # Place the ladder down on level 1 within 2–10 Manhattan distance of the player's spawn,
        # where spawn is the up‑ladder position of that level.
        spawn_pos = builder.ladders_up[1]
        level_map = builder.map[1]
        map_size = level_map.shape

        # Create a mask of valid cells: PATH blocks within range
        rows, cols = jnp.indices(map_size)
        dist_map = jnp.abs(rows - spawn_pos[0]) + jnp.abs(cols - spawn_pos[1])
        path_mask = level_map == BlockType.PATH.value
        dist_mask = (dist_map &gt;= 2) &amp; (dist_map &lt;= 10)
        valid_mask = dist_mask &amp; path_mask

        # Choose a random valid cell
        valid_flat = valid_mask.flatten().astype(jnp.float32)
        chosen_idx = jax.random.choice(
            ladder_rng,
            jnp.arange(map_size[0] * map_size[1]),
            p=valid_flat / valid_flat.sum(),
        )
        new_row, new_col = chosen_idx // map_size[1], chosen_idx % map_size[1]

        # Update the down‑ladder position and the corresponding item_map
        old_ladder_pos = builder.ladders_down[1]
        builder.ladders_down = builder.ladders_down.at[1].set(jnp.array([new_row, new_col]))
        # Remove old ladder down item and place new one
        builder.item_map = builder.item_map.at[1, old_ladder_pos[0], old_ladder_pos[1]].set(ItemType.NONE.value)
        builder.item_map = builder.item_map.at[1, new_row, new_col].set(ItemType.LADDER_DOWN.value)

        # Build the initial state
        state = builder.build(rng)

        # Mark the pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
