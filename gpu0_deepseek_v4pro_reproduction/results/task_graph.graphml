      <data key="d3">import jax
import jax.numpy as jnp
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Teach the agent to defeat the new Gnome‑type enemies and navigate the dark Gnomish Mines, culminating in a descent to the Sewers.

Description: The episode begins on floor 2 (Gnomish Mines) with the agent appearing at the ladder‑up tile. All vital needs (health, food, drink, energy, mana) are full. The agent carries an iron sword (level 3), a bow, 20 arrows, one iron armour piece (defence +1), a stone pickaxe (level 2), and 32 torches. The world uses the default smooth‑gen generation for floor 2: pitch‑black lighting (0.0), stalagmites acting as trees, and ores (coal, iron, diamond, sapphire, ruby) embedded in the stone terrain. Normal mob spawning is active, and both melee and ranged spawn multipliers are set to 1.5 to increase encounter frequency. Hostile mobs consist exclusively of Gnome Warriors (melee, type_id 1) and Gnome Archers (ranged, type_id 1); passive Bats also appear. The agent must place torches to see and navigate. The ladder down remains locked until the agent has killed a total of 5 hostile mobs (any mix of gnome types). Once the kill count is met, the agent must find and stand on the ladder‑down tile and execute DESCEND. Successfully entering floor 3 for the first time grants ENTER_SEWERS, which terminates the episode as a success. Failure occurs if the agent dies or time runs out before descending.

Relevant Achievements: DEFEAT_GNOME_WARRIOR, DEFEAT_GNOME_ARCHER, ENTER_SEWERS

Completed Achievements: COLLECT_WOOD, PLACE_TABLE, COLLECT_STONE, COLLECT_COAL, COLLECT_IRON, MAKE_WOOD_PICKAXE, MAKE_WOOD_SWORD, MAKE_STONE_PICKAXE, MAKE_STONE_SWORD, MAKE_IRON_SWORD, MAKE_IRON_ARMOUR, PLACE_FURNACE, ENTER_DUNGEON, ENTER_GNOMISH_MINES, FIND_BOW, MAKE_ARROW, FIRE_BOW

World:
- Player: Start on floor 2 (builder.set_starting_floor(2)). Inventory: sword=3, bow=1, arrows=20, pickaxe=2, torches=32, armour=1. All status bars at maximum.
- Map: No manual block modifications. The level uses the default smooth‑gen generator for floor 2 (pitch‑black, stalagmites, ores, etc.).
- Mechanics:
  - monsters_killed_to_clear_level = 5 (applies to floor 2)
  - melee_spawn_multiplier = 1.5
  - ranged_spawn_multiplier = 1.5
  - passive_spawn_multiplier = 1.0
  - needs_depletion_multiplier = 0.5
  - health_recover_multiplier = 1.0
  - All other TaskParams at default values.
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.DEFEAT_GNOME_WARRIOR,
            Achievement.DEFEAT_GNOME_ARCHER,
            Achievement.ENTER_SEWERS,
        ]
        self.completed_achievements = [
            Achievement.COLLECT_WOOD,
            Achievement.PLACE_TABLE,
            Achievement.COLLECT_STONE,
            Achievement.COLLECT_COAL,
            Achievement.COLLECT_IRON,
            Achievement.MAKE_WOOD_PICKAXE,
            Achievement.MAKE_WOOD_SWORD,
            Achievement.MAKE_STONE_PICKAXE,
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_IRON_SWORD,
            Achievement.MAKE_IRON_ARMOUR,
            Achievement.PLACE_FURNACE,
            Achievement.ENTER_DUNGEON,
            Achievement.ENTER_GNOMISH_MINES,
            Achievement.FIND_BOW,
            Achievement.MAKE_ARROW,
            Achievement.FIRE_BOW,
        ]
        self.label = "DEFEAT_GNOME_WARRIOR, DEFEAT_GNOME_ARCHER, ENTER_SEWERS"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=5,
            melee_spawn_multiplier=1.5,
            ranged_spawn_multiplier=1.5,
            passive_spawn_multiplier=1.0,
            needs_depletion_multiplier=0.5,
            health_recover_multiplier=1.0,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 2 (Gnomish Mines) at the up-ladder position
        builder.set_starting_floor(2)

        # Equip the agent with iron sword, bow, arrows, stone pickaxe, torches, and one iron armour piece
        builder.set_player_inventory({
            "sword": 3,                         # iron sword
            "bow": 1,
            "arrows": 20,
            "pickaxe": 2,                       # stone pickaxe
            "torches": 32,
            "armour": jnp.array([1, 0, 0, 0]),  # one iron armour piece
        })

        state = builder.build(rng)

        # Mark all pre-completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
