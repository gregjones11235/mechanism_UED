ce_stone": 94.6078431372549, "eat_plant": 30.88235294117647, "defeat_skeleton": 78.43137254901961, "make_stone_pickaxe": 87.25490196078431, "make_stone_sword": 91.17647058823529, "wake_up": 95.58823529411765, "place_furnace": 97.54901960784314, "collect_coal": 97.05882352941177, "collect_iron": 79.41176470588235, "collect_diamond": 30.88235294117647, "make_iron_pickaxe": 39.705882352941174, "make_iron_sword": 59.80392156862745, "make_arrow": 94.11764705882354, "make_torch": 99.01960784313725, "place_torch": 97.05882352941177, "collect_sapphire": 23.03921568627451, "collect_ruby": 29.901960784313726, "make_diamond_pickaxe": 3.9215686274509802, "make_diamond_sword": 4.411764705882353, "make_iron_armour": 12.745098039215685, "enter_gnomish_mines": 64.70588235294117, "enter_dungeon": 98.03921568627452, "defeat_orc_solider": 97.05882352941177, "defeat_orc_mage": 91.66666666666667, "eat_snail": 95.09803921568627, "find_bow": 97.05882352941177, "fire_bow": 92.15686274509804, "open_chest": 97.05882352941177, "drink_potion": 78.92156862745098}, "average_episode_length": 1259.9558823529412, "mean_return_percentage": 26.78299122296872, "mean_return": 60.529560163909316, "lp": NaN, "priority_score": 0.22837370242214533}]</data>
