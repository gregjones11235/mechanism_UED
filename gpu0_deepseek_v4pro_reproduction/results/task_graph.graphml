lant": 97.1938775510204, "defeat_zombie": 45.91836734693877, "collect_stone": 100.0, "place_stone": 99.48979591836735, "eat_plant": 17.857142857142858, "defeat_skeleton": 20.918367346938776, "wake_up": 42.60204081632653, "place_furnace": 100.0, "collect_iron": 63.52040816326531, "make_iron_pickaxe": 17.091836734693878, "make_iron_sword": 35.96938775510204, "make_arrow": 100.0, "place_torch": 98.9795918367347, "make_iron_armour": 4.846938775510204, "enter_dungeon": 80.86734693877551}, "average_episode_length": 741.1428571428571, "mean_return_percentage": 13.374229129393736, "mean_return": 30.225757832429846, "lp": NaN, "priority_score": 0.15472068929612662}, {"session": 45, "sr": 0.7864923747276689, "achievement_srs": {"eat_cow": 77.77777777777777, "collect_sapling": 95.86056644880175, "collect_drink": 76.90631808278867, "make_wood_pickaxe": 100.0, "make_wood_sword": 100.0, "place_plant": 94.98910675381264, "defeat_zombie": 48.80174291938998, "collect_stone": 100.0, "place_stone": 98.91067538126362, "eat_plant": 11.546840958605664, "defeat_skeleton": 18.954248366013072, "wake_up": 50.326797385620914, "place_furnace": 98.91067538126362, "collect_iron": 66.44880174291939, "collect_diamond": 0.4357298474945534, "make_iron_pickaxe": 5.228758169934641, "make_iron_sword": 10.457516339869281, "make_arrow": 98.03921568627452, "place_torch": 98.47494553376906, "make_iron_armour": 3.0501089324618738, "enter_dungeon": 78.64923747276688}, "average_episode_length": 596.1917211328976, "mean_return_percentage": 12.92594106380261, "mean_return": 29.2126268041939, "lp": NaN, "priority_score": 0.16792211922290096}]</data>
