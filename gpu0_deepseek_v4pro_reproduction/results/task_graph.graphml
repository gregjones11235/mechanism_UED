_iron_pickaxe": 21.824104234527688, "make_iron_sword": 37.785016286644954, "make_arrow": 87.62214983713355, "make_torch": 91.53094462540717, "place_torch": 90.87947882736157, "collect_sapphire": 22.80130293159609, "collect_ruby": 19.86970684039088, "make_diamond_pickaxe": 1.3029315960912051, "make_diamond_sword": 3.583061889250814, "enter_gnomish_mines": 32.899022801302934, "enter_dungeon": 100.0, "defeat_orc_solider": 96.41693811074919, "defeat_orc_mage": 87.29641693811075, "eat_snail": 93.81107491856677, "find_bow": 99.0228013029316, "fire_bow": 86.97068403908794, "open_chest": 99.0228013029316, "drink_potion": 80.78175895765472}, "average_episode_length": 886.6091205211726, "mean_return_percentage": 17.90600858291776, "mean_return": 40.46757939739414, "lp": NaN, "priority_score": 0.22075565788496432}]</data>
