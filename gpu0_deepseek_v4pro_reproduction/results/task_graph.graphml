_drink": 31.309356998287406, "collect_stone": 98.42752607815663, "place_stone": 96.99517359489336, "make_stone_pickaxe": 85.39623229020707, "make_stone_sword": 28.351237739374124, "wake_up": 1.4012143858010275, "place_furnace": 97.11972598474233, "collect_coal": 100.0, "collect_iron": 4.437178888369921, "make_arrow": 60.92168768488246, "make_torch": 98.87902849135918, "place_torch": 98.80118324770356, "enter_gnomish_mines": 100.0, "enter_dungeon": 100.0, "eat_bat": 12.50194613109139, "eat_snail": 0.031138097462245058, "find_bow": 0.015569048731122529, "open_chest": 0.015569048731122529, "drink_potion": 0.015569048731122529}, "average_episode_length": 43.09139031605169, "mean_return_percentage": 12.444903392674831, "mean_return": 28.12548166744512, "lp": NaN, "priority_score": 0.01184445136240573}]</data>
