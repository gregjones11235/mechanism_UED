487, "make_stone_pickaxe": 72.09302325581395, "make_stone_sword": 92.15116279069767, "wake_up": 86.04651162790698, "place_furnace": 95.05813953488372, "collect_coal": 82.84883720930233, "collect_iron": 57.848837209302324, "collect_diamond": 9.883720930232558, "make_iron_pickaxe": 10.755813953488373, "make_iron_sword": 22.38372093023256, "make_arrow": 74.4186046511628, "make_torch": 82.26744186046511, "place_torch": 76.16279069767442, "collect_sapphire": 11.337209302325581, "collect_ruby": 8.13953488372093, "make_diamond_pickaxe": 1.4534883720930232, "make_diamond_sword": 1.744186046511628, "make_iron_armour": 4.3604651162790695, "enter_gnomish_mines": 5.813953488372093, "enter_dungeon": 94.47674418604652, "defeat_orc_solider": 79.06976744186046, "eat_snail": 25.58139534883721, "find_bow": 81.1046511627907, "fire_bow": 56.104651162790695, "open_chest": 81.1046511627907, "drink_potion": 21.802325581395348}, "average_episode_length": 819.1162790697674, "mean_return_percentage": 20.677672121401653, "mean_return": 46.73153899436773, "lp": NaN, "priority_score": 0.17533126014061653}]</data>
