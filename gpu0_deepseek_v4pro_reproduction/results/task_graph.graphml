      <data key="d3">import jax
from craftax.craftax.constants import Achievement
from craftax.craftax.craftax_state import EnvParams, StaticEnvParams

from minicraftax.craftax_state import EnvState, TaskParams
from minicraftax.tasks.base_task import BaseTask
from minicraftax.world_builder import WorldBuilder


class Env(BaseTask):
    """Objective: Learn to clear the Dungeon and descend to the Gnomish Mines using only a stone sword and a limited number of torches, while relying on looted bows, arrows, and potions.

Description: The agent starts on Floor 1 (Dungeon) at the ladder‑up position. Inventory: stone sword (tier 2), 4 torches. All player attributes are default (strength 1, dexterity 1, intelligence 1). The Dungeon is generated normally – a network of rooms and corridors with chests, fountains, and pre‑placed torches in room corners. The ambient light is zero, so the agent must place torches to see. The ladder down to Floor 2 (Gnomish Mines) is in its standard location and is initially locked. To unlock it, the agent must defeat exactly 5 hostile monsters (melee or ranged) on Floor 1. The mobs present are Orc Soldiers (melee), Orc Mages (ranged), and passive Snails, with default spawn rates. No mining or crafting is required – all necessary equipment is already provided, though the agent may find additional bows, arrows, and potions in chests. Survival needs deplete at 20% of normal speed to keep the focus on combat, exploration, and torch management. The episode terminates successfully when the agent stands on the ladder down and executes DESCEND, thereby entering the Gnomish Mines.

Relevant Achievements: ENTER_GNOMISH_MINES
Completed Achievements: MAKE_STONE_SWORD, MAKE_TORCH, ENTER_DUNGEON

World:
- Player: Starting floor 1 via `set_starting_floor(1)`. Inventory: `{"stone_sword": 1, "torch": 4}`. Attributes default (strength=1, dexterity=1, intelligence=1).
- Map: No modifications – Floor 1 is generated using the standard dungeon algorithm (rooms, corridors, chests, fountains, torches in room corners). Floors 0 and 2 remain default but are irrelevant.
- Mechanics:
  - `monsters_killed_to_clear_level = 5`
  - `mob_health_multiplier = 1.0`
  - `mob_damage_multiplier = 1.0`
  - `melee_spawn_multiplier = 1.0`
  - `ranged_spawn_multiplier = 1.0`
  - `passive_spawn_multiplier = 1.0`
  - `needs_depletion_multiplier = 0.2`
  - `health_recover_multiplier = 1.0`
  - `health_loss_multiplier = 1.0`
  - `mana_recover_multiplier = 1.0`
  - `growing_plants_age = 600`
"""

    def __init__(self, static_params: StaticEnvParams, params: EnvParams):
        super().__init__(static_params, params)
        self.relevant_achievements = [
            Achievement.ENTER_GNOMISH_MINES,
        ]
        self.completed_achievements = [
            Achievement.MAKE_STONE_SWORD,
            Achievement.MAKE_TORCH,
            Achievement.ENTER_DUNGEON,
        ]
        self.label = "ENTER_GNOMISH_MINES"

    def get_task_params(self) -&gt; TaskParams:
        """Return custom parameters for this task."""
        return TaskParams(
            monsters_killed_to_clear_level=5,
            needs_depletion_multiplier=0.2,
        )

    def generate_world(self, rng: jax.Array) -&gt; EnvState:
        """Generates the world for the task."""
        rng, build_rng = jax.random.split(rng)

        builder = WorldBuilder(build_rng, self.static_params, self.params)

        # Start on floor 1 (Dungeon) at the ladder‑up position
        builder.set_starting_floor(1)

        # Equip stone sword (tier 2) and 4 torches
        builder.set_player_inventory({
            "sword": 2,
            "torches": 4,
        })

        # No further map modifications; standard dungeon generation is used

        state = builder.build(rng)

        # Mark pre‑completed achievements as True
        achievements = state.achievements
        for ach in self.completed_achievements:
            achievements = achievements.at[ach.value].set(True)
        state = state.replace(achievements=achievements)

        return state</data>
