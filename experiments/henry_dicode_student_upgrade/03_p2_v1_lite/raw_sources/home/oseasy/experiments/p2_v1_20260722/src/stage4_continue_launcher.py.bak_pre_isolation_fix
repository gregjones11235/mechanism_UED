# Per-session training
# ═══════════════════════════════════════════════════════════════════════

def run_session(
    ts: TrainState,
    replay: TrajectoryReplayBuffer,
    rng: jax.random.PRNGKey,
    action_rng: np.random.Generator,
    update_count: int,
    global_step: int,
    session_index: int,
    cfg: type,
    network: ActorCriticTransformer,
    learner: LongContextLearner,
    env,
    env_params,
    ach_table: jnp.ndarray,
    out_dir: str,
    num_updates: int = NUM_UPDATES_PER_SESSION,
    session_target_steps: int = SESSION_ENV_STEPS,
    pending: Optional[PendingEpisodeBuffers] = None,
    r_env_state=None,
    r_obsv=None,
    r_memories=None,
    r_mem_mask=None,
    r_mem_idx=None,
) -> dict:
    """Run ONE session of ``num_updates`` PPO updates and return updated state.

    Each update = NUM_ENVS*ROLLOUT_STEPS = 2048 env steps.  A full Stage4
    session is num_updates=12 (24,576 steps); the GPU smoke ladder uses
    num_updates=1 (Level 1/2, 2048 steps) and num_updates=12 (Level 3).

    P2-v1 corrected loop:
      - aligned transitions (obs/action/reward/value/log_prob/next_obs)
      - pre-action Transformer memory
      - checkpointable action RNG
      - native on-policy PPO main update every rollout
      - optional replay auxiliary update

    方案B exact resume: pass the restored collector state (``r_env_state`` /
    ``r_obsv`` / ``r_memories`` / ``r_mem_mask`` / ``r_mem_idx``) together with
    the restored ``pending`` buffers to CONTINUE an in-progress collection
    bit-exactly — in that case the env is NOT re-reset (no reset RNG is
    consumed).  Leaving them None performs a true fresh start with ``env.reset``.
    """
    session_t0 = time.time()
    total_env_steps = 0
    crash_info = None
    all_logs = []

    pass_trajs_long = 0
    pass_samples_long = 0
    pass_grad_updates = 0
    pass_relabel_evidence = []

    # 方案B exact resume: a checkpointed run restores the collector env/memory
    # state and continues WITHOUT an env.reset (which would splice reset
    # transitions onto the in-progress pending episodes).  A fresh start leaves
    # r_env_state None and resets below.
    resuming = r_env_state is not None
    obsv_j = r_obsv
    env_state = r_env_state
    if resuming:
        memories_j = r_memories
        mem_mask_j = r_mem_mask
        mem_idx_j = r_mem_idx
    else:
        memories_j = jnp.zeros((NUM_ENVS, cfg.window_mem, cfg.num_layers, cfg.embed_size))
        mem_mask_j = jnp.zeros((NUM_ENVS, cfg.num_heads, 1, cfg.window_mem + 1), dtype=jnp.bool_)
        mem_idx_j = jnp.full((NUM_ENVS,), cfg.window_mem + 1, dtype=jnp.int32)

    # Cross-rollout persistent episode buffers (方案B).  Restored from checkpoint
    # on resume; freshly created at a true fresh start.
    if pending is None:
        pending = PendingEpisodeBuffers(
            NUM_ENVS, first_policy_version=int(update_count))

    class _EnvAdapter:
        """Adapt Stage4 env.step(env_params) to p2_v1_core's env interface."""

        def step(self, step_rng, env_state, actions):
            return env.step(step_rng, env_state, actions, env_params)

    env_adapter = _EnvAdapter()

    def relabel_callback(sample):
        nonlocal pass_samples_long, pass_grad_updates
        pass_samples_long += 1
        info = {}
        ach_any = sample.achievements.max(axis=0)
        if ach_any.any():
            old_target = int(np.argmax(sample.target_achievements))
            sample = relabel_sample(sample)
            new_target = int(np.argmax(sample.target_achievements))
            replay.counters.relabelled_samples += 1
            pass_relabel_evidence.append({
                "from_goal_idx": old_target,
                "to_goal_idx": new_target,
            })
            info["hindsight_from_goal_idx"] = old_target
            info["hindsight_to_goal_idx"] = new_target
            info["hindsight_relabelled"] = True
        else:
            info["hindsight_relabelled"] = False
        return sample, info

    print(f"\n── Session {session_index} "
          f"(global_step={global_step}) "
          f"target={session_target_steps} steps ({num_updates} updates) ──")

    try:
        if not resuming:
            # True fresh start: reset the env.  On resume the restored env_state
            # /obsv are used directly and NO reset RNG is consumed, so the action
            # /env RNG stream stays bit-identical to an uninterrupted run.
            rng, reset_rng = jax.random.split(rng)
            obsv_j, env_state = env.reset(reset_rng, env_params)

        for up in range(num_updates):
            roll = collect_rollout(
                ts=ts,
                network=network,
                env=env_adapter,
                env_state=env_state,
                obsv=obsv_j,
                memories=memories_j,
                mem_mask=mem_mask_j,
                mem_idx=mem_idx_j,
                rng=rng,
                action_rng=action_rng,
                num_envs=NUM_ENVS,
                rollout_steps=ROLLOUT_STEPS,
                window_mem=cfg.window_mem,
                num_heads=cfg.num_heads,
                target_achievement=np.asarray(ach_table[0]),
                collected_update_count=update_count,
                pending=pending,
            )

            total_env_steps += NUM_ENVS * ROLLOUT_STEPS
            batch = roll["batch"]
            obsv_j = roll["obsv"]
            env_state = roll["env_state"]
            memories_j = roll["memories"]
            mem_mask_j = roll["mem_mask"]
            mem_idx_j = roll["mem_idx"]
            rng = roll["rng"]
            pending = roll["pending"]

            for traj in roll["trajectories"]:
                replay.insert(traj)
                replay.counters.trajectories_collected += 1
                if traj.length > 128:
                    pass_trajs_long += 1

            ts, metrics = p2_v1_update(
                ts=ts,
                learner=learner,
                batch=batch,
                replay=replay,
                update_count=update_count,
                replay_aux=True,
                relabel_callback=relabel_callback,
            )
            update_count = int(metrics["update_count"])
            replay.counters.gradient_updates += 1
            if metrics.get("ppo_grad_norm", 0.0) > 1e-12 and np.isfinite(
                metrics.get("ppo_grad_norm", 0.0)
            ):
                pass_grad_updates += 1

            if not np.isfinite(metrics.get("ppo_total_loss", np.nan)):
                raise RuntimeError(
                    f"NaN/Inf PPO loss: {metrics.get('ppo_total_loss')}")
            if not np.isfinite(metrics.get("ppo_grad_norm", np.nan)):
                raise RuntimeError(
                    f"NaN/Inf PPO grad_norm: {metrics.get('ppo_grad_norm')}")

            cs = replay.counters.snapshot()
            log = {
                "session": session_index,
                "update": up,
                "session_env_steps": total_env_steps,
                "global_env_steps": global_step + total_env_steps,
                "elapsed_s": round(time.time() - session_t0, 1),
                "update_count": update_count,
                "replay_size": len(replay),
                "replay_max_len": replay.longest_trajectory_length,
                **cs,
                **{k: v for k, v in metrics.items() if isinstance(v, (int, float, bool, str))},
            }
            all_logs.append(log)

            print(f"  up {up:3d}/{num_updates}  "
                  f"steps {total_env_steps:6d}/{session_target_steps}  "
                  f"ppo_loss {metrics.get('ppo_total_loss', float('nan')):.4f}  "
                  f"aux {int(metrics.get('replay_aux_update', False))}  "
                  f"replay {len(replay):3d}  "
                  f"relab {cs['relabelled_samples']:3d}  "
                  f"max_len={replay.longest_trajectory_length}")

    except Exception as e:
        print(f"\nSESSION STOP: {e}")
        traceback.print_exc()
        crash_info = {
            "error": str(e),
            "traceback": traceback.format_exc(),
            "session_env_steps": total_env_steps,
            "session": session_index,
            "timestamp": datetime.now(timezone.utc).isoformat(),
        }

    session_elapsed = round(time.time() - session_t0, 1)
    new_global_step = global_step + total_env_steps

    return {
        "ts": ts,
        "replay": replay,
        "rng": rng,
        "action_rng": action_rng,
        "update_count": update_count,
        "global_step": new_global_step,
        "session_env_steps": total_env_steps,
        "session_elapsed_s": session_elapsed,
        "session_log": all_logs,
        "pass_trajs_long": pass_trajs_long,
        "pass_samples_long": pass_samples_long,
        "pass_grad_updates": pass_grad_updates,
        "pass_relabel_evidence": pass_relabel_evidence,
        "crash_info": crash_info,
        "pending": pending,
        "env_state": env_state,
        "obsv": obsv_j,
        "memories": memories_j,
        "mem_mask": mem_mask_j,
        "mem_idx": mem_idx_j,
    }


