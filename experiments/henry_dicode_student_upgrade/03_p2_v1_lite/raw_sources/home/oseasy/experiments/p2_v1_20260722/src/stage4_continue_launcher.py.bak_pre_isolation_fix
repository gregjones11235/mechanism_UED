def _cfg_resolved_dict(cfg: type) -> dict:
    """Extract the resolved config as a plain dict for checkpoint metadata."""
    result = {}
    for k in dir(cfg):
        if k.startswith("__") or k.startswith("_"):
            continue
        v = getattr(cfg, k)
        if callable(v):
            continue
        result[k] = v
    return result


