def verify_not_v0_source(ckpt_path: str) -> None:
    """Fail closed if the start checkpoint looks like a forbidden P2-v0 ckpt.

    P2-v1 MUST start weights-only from healthy session175.  Continuation from
    P2-v0 98304/122880 is forbidden (SEVERE_REGRESSION, invalid for attribution).
    """
    norm = ckpt_path.replace("\\", "/")
    for marker in _FORBIDDEN_V0_MARKERS:
        if marker in norm:
            raise RuntimeError(
                f"REFUSED: start checkpoint '{ckpt_path}' matches forbidden P2-v0 "
                f"marker '{marker}'. P2-v1 must start weights-only from healthy "
                f"session175 ({SESSION175_CKPT}).")


def _params_content_sha256(params) -> str:
    """Deterministic content hash over flattened parameter leaves.

    Serves as the reproducible 'source_checkpoint_sha256' for the weights-only
    init: it hashes the actual loaded weight values (not the orbax directory
    layout), so the provenance is stable and verifiable.
    """
    h = hashlib.sha256()
    for leaf in jax.tree_util.tree_leaves(params):
        arr = np.asarray(leaf)
        h.update(str(arr.shape).encode())
        h.update(np.ascontiguousarray(arr).tobytes())
    return h.hexdigest()


def _find_encoder_kernel_shape(params) -> Optional[tuple]:
    """Return the encoder kernel shape (obs_dim, embed_size) if present."""
    found = None

    def _walk(node, prefix):
        nonlocal found
        if hasattr(node, "items"):
            for k, v in node.items():
                _walk(v, f"{prefix}/{k}")
        elif hasattr(node, "shape"):
            if "encoder" in prefix and prefix.endswith("kernel"):
                found = tuple(int(x) for x in node.shape)

    _walk(params, "")
    return found


def _optimizer_step_count(train_state: TrainState) -> int:
    """Read the optimizer iteration counter from a TrainState's opt_state."""
    leaves = jax.tree_util.tree_leaves(train_state.opt_state)
    # optax ScaleByAdamState carries `count` as its first leaf; a fresh
    # optimizer has count == 0.
    return int(leaves[0]) if leaves else -1


def init_fresh_from_session175(
    network: ActorCriticTransformer,
    env,
    env_params,
    cfg: type,
    obs_dim: int,
) -> dict:
    """Weights-only init from healthy session175 + fresh everything else.

    Loads ONLY the model parameters from session175/17500 (load_opt_state=False)
    and creates fresh optimizer / replay / RNGs / counters.  Nothing from P2-v0
    98304/122880 is loaded.  Fails closed if the encoder kernel is not
    (obs_dim, embed_size) == (8335, 256).

    Returns dict with: train_state, replay_buffer, rng, action_rng, global_step,
    update_count, source_checkpoint, source_checkpoint_sha256, replay_size,
    param_leaves, encoder_kernel, optimizer_step, master_seed.
    """
    verify_not_v0_source(SESSION175_CKPT)
    print(f"\n[fresh-start] Weights-only init from healthy session175:")
    print(f"  source_checkpoint = {SESSION175_CKPT}")

    # 1. Load model params ONLY (no optimizer state) from session175.
    ts_loaded = load_weights_only(
        SESSION175_CKPT, env, env_params, cfg, load_opt_state=False)
    loaded_params = ts_loaded.params
    param_leaves = len(jax.tree_util.tree_leaves(loaded_params))

    # 2. Fail-closed shape verification: encoder kernel must be (obs_dim, embed).
    kernel_shape = _find_encoder_kernel_shape(loaded_params)
    expected_kernel = (int(obs_dim), int(cfg.embed_size))
    if kernel_shape != expected_kernel:
        raise RuntimeError(
            f"REFUSED: session175 encoder kernel {kernel_shape} != expected "
            f"{expected_kernel}. Fail closed on schema mismatch (no override).")
    print(f"  encoder kernel    = {kernel_shape}  (== {expected_kernel} OK)")
    print(f"  param_leaves      = {param_leaves}")

    # 3. Build a FRESH TrainState: restored params + NEW Adam optimizer state.
    ts = build_stage4_train_state(network, loaded_params, cfg)
    opt_step = _optimizer_step_count(ts)
    if opt_step != 0:
        raise RuntimeError(
            f"REFUSED: fresh optimizer step != 0 (got {opt_step}). "
            f"P2-v1 must start with a brand-new optimizer.")
    print(f"  optimizer         = FRESH Adam(clip(1.0)+lr={cfg.lr}, eps=1e-5), step={opt_step}")

    # 4. Fresh empty replay buffer (NOT restored from P2-v0).
    replay = TrajectoryReplayBuffer(capacity=REPLAY_CAPACITY, seed=P2_V1_MASTER_SEED)
    if len(replay) != 0:
        raise RuntimeError("REFUSED: fresh replay buffer is not empty.")
    print(f"  replay_buffer     = EMPTY (capacity={REPLAY_CAPACITY}, len={len(replay)})")

    # 5. Fresh JAX RNG + fresh action RNG (both from the documented master seed).
    rng = jax.random.PRNGKey(P2_V1_MASTER_SEED)
    action_rng = make_action_rng(P2_V1_MASTER_SEED)
    print(f"  JAX rng           = PRNGKey({P2_V1_MASTER_SEED}) (fresh)")
    print(f"  action rng        = PCG64(seed={P2_V1_MASTER_SEED}) (fresh, checkpointable)")

    # 6. Fresh counters — do NOT treat the dir name 17500 as a P2 env step.
    global_step = P2_V1_GLOBAL_STEP_START
    update_count = P2_V1_UPDATE_COUNT_START
    print(f"  p2_v1_global_step = {global_step}  (17500 is session175 base step, NOT a P2 env step)")
    print(f"  p2_v1_update_count= {update_count}")

    # 7. Provenance: content hash of the loaded weights.
    source_sha = _params_content_sha256(loaded_params)
    print(f"  source_checkpoint_sha256 (weights content) = {source_sha}")

    return {
        "train_state": ts,
        "replay_buffer": replay,
        "rng": rng,
        "action_rng": action_rng,
        "global_step": global_step,
        "update_count": update_count,
        "source_checkpoint": SESSION175_CKPT,
        "source_checkpoint_sha256": source_sha,
        "replay_size": len(replay),
        "param_leaves": param_leaves,
        "encoder_kernel": list(kernel_shape) if kernel_shape else None,
        "optimizer_step": opt_step,
        "master_seed": P2_V1_MASTER_SEED,
    }


