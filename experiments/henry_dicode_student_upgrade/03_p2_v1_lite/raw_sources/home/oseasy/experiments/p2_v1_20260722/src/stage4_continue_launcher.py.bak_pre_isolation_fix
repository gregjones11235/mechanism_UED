def save_stage4_checkpoint(
    ts: TrainState,
    replay: TrajectoryReplayBuffer,
    rng: jax.random.PRNGKey,
    global_step: int,
    cfg: type,
    session_index: int,
    out_dir: str,
    start_step: int,
    action_rng_state: Optional[dict] = None,
    update_count: int = 0,
    source_checkpoint: str = "",
    source_checkpoint_sha256: str = "",
    pending_state: Optional[dict] = None,
    collector_state: Optional[dict] = None,
) -> str:
    """Save a full Stage4 checkpoint with resolved config and provenance.

    P2-v1: also persists the checkpointable action RNG state and the update
    count so a resumed run reproduces the exact action sequence and policy
    version.  方案B: also persists the cross-rollout pending episode buffers and
    the collector env/memory state so an interrupted run resumes the in-progress
    episodes exactly.
    """
    ckpt_path = save_full_checkpoint(
        ts, replay, rng, global_step, CKPT_ROOT, step=global_step,
        action_rng_state=action_rng_state, update_count=update_count,
        pending_state=pending_state, collector_state=collector_state)

    # Compute source hashes (same as D059 convention)
    src_hashes = {}
    for fn in sorted(os.listdir(_AMAGO_SRC)):
        if fn.endswith(".py"):
            with open(os.path.join(_AMAGO_SRC, fn), "rb") as fh:
                src_hashes[fn] = hashlib.sha256(fh.read()).hexdigest()

    # Extended manifest with Stage4 identity
    manifest = {
        "directive": "D059",
        "stage": "4",
        "stage4_session": session_index,
        "treatment": "AMAGO_STYLE_EXPLORATORY_P2",
        "experiment": "A",
        "launcher": "P2-v1-fresh-start-weights-only",
        "start": "weights_only_from_session175",
        "source_checkpoint": source_checkpoint,
        "source_checkpoint_sha256": source_checkpoint_sha256,
        "p2_v1_start_step": start_step,
        "resume_from_step": start_step,
        "checkpoint_step": global_step,
        "global_step": global_step,
        "update_count": int(update_count),
        "action_rng_state_saved": action_rng_state is not None,
        "pending_buffers_saved": pending_state is not None,
        "pending_total_transitions": (
            sum(len(s["obs"]) for s in pending_state["slots"])
            if pending_state is not None else 0),
        "collector_state_saved": collector_state is not None,
        "gamma": GAMMA,
        "gae_lambda": GAE_LAMBDA,
        "anneal_lr": False,
        "optimizer_fresh_at_start": True,
        "optimizer_note": (
            "P2-v1 weights-only init: model params loaded from healthy "
            "session175 (base 17500); optimizer/replay/RNG/global_step/"
            "update_count all created FRESH at p2_v1_global_step=0. "
            "Nothing from P2-v0 98304/122880 is loaded."
        ),
        "gpu_uuid": EXPECTED_GPU_UUID,
        "timestamp_utc": datetime.now(timezone.utc).isoformat(),
        "counters": replay.counters.snapshot(),
        "replay_buffer_size": len(replay),
        "replay_longest_trajectory": replay.longest_trajectory_length,
        "resolved_config": _cfg_resolved_dict(cfg),
        "source_hashes": src_hashes,
        "checkpoint_path": ckpt_path,
        "session_output_dir": out_dir,
    }

    manifest_path = os.path.join(
        CKPT_ROOT, str(global_step), "stage4_manifest.json")
    with open(manifest_path, "w") as f:
        json.dump(manifest, f, indent=2, sort_keys=True)

    print(f"  [checkpoint] saved at step={global_step}  →  {ckpt_path}")
    print(f"  [checkpoint] manifest  →  {manifest_path}")
    return ckpt_path


