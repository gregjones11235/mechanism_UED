# Smoke test: verify restore + forward pass + checkpoint round-trip
# ═══════════════════════════════════════════════════════════════════════

def smoke_test():
    """P2-v1 weights-only fresh-start verification (第五节 regression).

    Runs on GPU0 (load_weights_only requires GPU).  Checks, with NO training:
      1. Dummy env gives obs_dim/action_dim (expect 8335 / 43).
      2. Network builds with the BIG P2-v1 config.
      3. Fresh RANDOM init (kept as a comparison baseline).
      4. Build the real Stage4 env, then weights-only init from session175:
         params loaded; encoder kernel == (8335,256) (fail closed otherwise);
         optimizer FRESH (step==0); replay EMPTY (size 0); global_step==0;
         update_count==0; loaded params differ from fresh random init.
      5. Forward pass finite (batch_size=16).
      6. RNG independence: same master seed -> identical action stream;
         different seed -> different stream.
      7. Checkpoint round-trip: save_full_checkpoint -> restore_full_checkpoint
         preserves params/optimizer/replay/rng/action_rng/global_step/update_count.
      8. Cleanup of the smoke checkpoint.
    """
    print("=" * 60)
    print("SMOKE TEST: P2-v1 weights-only fresh-start from session175")
    print("=" * 60)

    cfg = Cfg()

    # 1. Build dummy env for network init
    print("\n[smoke 1/8] Building dummy env ...")
    ach_table = jnp.array(
        [get_achievement_multi_hot([Achievement.DEFEAT_KOBOLD])], dtype=jnp.float32)
    EMB = int(ach_table.shape[1])
    dummy = CraftaxAugObsTrain(
        condition_on_task=True, conditioning_type="embedding",
        embedding_size=EMB, task_embeddings=jnp.zeros((1, EMB)))
    obs_dim = dummy.observation_space(dummy.default_params).shape[0]
    action_dim = dummy.action_space(dummy.default_params).n
    print(f"  obs_dim={obs_dim}  action_dim={action_dim}  embedding_dim={EMB}")
    assert obs_dim == 8335, f"FAIL: expected obs_dim 8335, got {obs_dim}"
    assert action_dim == 43, f"FAIL: expected action_dim 43, got {action_dim}"

    # 2. Build network
    print("\n[smoke 2/8] Building network ...")
    network = ActorCriticTransformer(
        action_dim=action_dim,
        activation=cfg.activation,
        hidden_layers=cfg.hidden_layers,
        encoder_size=cfg.embed_size,
        num_heads=cfg.num_heads,
        qkv_features=cfg.qkv_features,
        num_layers=cfg.num_layers,
        gating=cfg.gating,
        gating_bias=cfg.gating_bias)

    # 3. Fresh RANDOM init (comparison baseline to prove weights were loaded)
    print("\n[smoke 3/8] Fresh random init (baseline) ...")
    init_rng = jax.random.PRNGKey(0)
    fresh_params = init_network_params(network, obs_dim, cfg, init_rng)
    n_leaves = len(jax.tree_util.tree_leaves(fresh_params))
    n_params = sum(
        int(np.prod(x.shape)) for x in jax.tree_util.tree_leaves(fresh_params)
        if hasattr(x, 'shape'))
    print(f"  Network init OK  param_leaves={n_leaves}  total_params={n_params:,}")

    # 4. Build the real Stage4 env, then weights-only init from session175
    print("\n[smoke 4/8] Building Stage4 env + weights-only init from session175 ...")
    static_env_params = StaticEnvParams()
    env_params = EnvParams(max_timesteps=4096)
    with open(S4_TASK_PATH) as f:
        s4_code = f.read()
    ns = {}
    exec(s4_code, ns)
    Task = ns["Env"]
    base_env = MultiTaskMiniCraftaxEnv(
        [Task], static_env_params, env_params, cfg.condition_on_task,
        conditioning_type="embedding", embedding_size=EMB,
        completion_bonus_scale=cfg.completion_bonus_scale,
        completion_bonus_min=cfg.completion_bonus_min,
        bonus_type=cfg.bonus_type, dynamic_bonus_k=cfg.dynamic_bonus_k)

    fresh = init_fresh_from_session175(network, base_env, env_params, cfg, obs_dim)
    ts = fresh["train_state"]
    replay = fresh["replay_buffer"]
    rng = fresh["rng"]
    action_rng = fresh["action_rng"]
    gs = fresh["global_step"]
    update_count = fresh["update_count"]

    # Fail-closed assertions on the fresh-start contract
    assert fresh["encoder_kernel"] == [8335, 256], \
        f"FAIL: encoder kernel {fresh['encoder_kernel']} != [8335, 256]"
    assert fresh["optimizer_step"] == 0, \
        f"FAIL: fresh optimizer step {fresh['optimizer_step']} != 0"
    assert len(replay) == 0, f"FAIL: replay not empty (len={len(replay)})"
    assert gs == 0, f"FAIL: p2_v1_global_step {gs} != 0"
    assert update_count == 0, f"FAIL: p2_v1_update_count {update_count} != 0"
    print("  weights-only init OK: kernel (8335,256), optimizer step 0, "
          "replay 0, global_step 0, update_count 0")

    # Loaded params must differ from fresh RANDOM init (proves weights loaded)
    params_differ = not all(
        bool(jnp.all(l1 == l2))
        for l1, l2 in zip(
            jax.tree_util.tree_leaves(fresh_params),
            jax.tree_util.tree_leaves(ts.params)))
    assert params_differ, "FAIL: session175 params identical to fresh random init!"
    print("  params differ from fresh random init (weights load VERIFIED)")

    # 5. Forward pass (batch_size=16, matches training — batch_size=1 breaks
    #    the transformer's memory concatenation, known limitation)
    print("\n[smoke 5/8] Forward pass (batch_size=16) ...")
    test_mem = jnp.zeros((16, cfg.window_mem, cfg.num_layers, cfg.embed_size))
    test_obs = jnp.zeros((16, obs_dim))
    test_mask = jnp.zeros((16, cfg.num_heads, 1, cfg.window_mem + 1), dtype=jnp.bool_)
    pi, value, mem_out = network.apply(
        ts.params, test_mem, test_obs, test_mask,
        method=network.model_forward_eval)
    fwd_finite = bool(np.all(np.isfinite(np.asarray(pi.logits)))
                      and np.all(np.isfinite(np.asarray(value))))
    assert fwd_finite, "FAIL: forward produced NaN/Inf"
    print(f"  Forward OK  logits={pi.logits.shape}  value={value.shape}  "
          f"mem_out={mem_out.shape}  finite={fwd_finite}")

    # 6. RNG independence + determinism (action RNG from the documented seed)
    print("\n[smoke 6/8] RNG independence + determinism ...")
    from rng_utils import sample_actions
    logits_np = np.asarray(pi.logits)
    softmax = np.exp(logits_np - logits_np.max(axis=-1, keepdims=True))
    probs = softmax / softmax.sum(axis=-1, keepdims=True)
    g_same_a = make_action_rng(P2_V1_MASTER_SEED)
    g_same_b = make_action_rng(P2_V1_MASTER_SEED)
    g_diff = make_action_rng(P2_V1_MASTER_SEED + 1)
    seq_a = [int(sample_actions(g_same_a, probs)[0]) for _ in range(8)]
    seq_b = [int(sample_actions(g_same_b, probs)[0]) for _ in range(8)]
    seq_c = [int(sample_actions(g_diff, probs)[0]) for _ in range(8)]
    assert seq_a == seq_b, "FAIL: same seed produced different action streams"
    assert seq_a != seq_c, "FAIL: different seeds produced identical action streams"
    print(f"  same-seed identical={seq_a == seq_b}  diff-seed differs={seq_a != seq_c}")

    # 7. Checkpoint round-trip (P2-v1 self-checkpoint format, save -> restore)
    print("\n[smoke 7/8] Checkpoint round-trip (save -> restore) ...")
    smoke_ckpt_dir = os.path.join(CKPT_ROOT, "_smoke_test_roundtrip")
    # Idempotent: clear any leftover smoke checkpoint from a prior aborted run.
    shutil.rmtree(smoke_ckpt_dir, ignore_errors=True)
    save_full_checkpoint(
        ts, replay, rng, gs, smoke_ckpt_dir, step=gs,
        action_rng_state=action_rng_state(action_rng), update_count=update_count)
    dummy_ts = build_stage4_train_state(
        network, init_network_params(network, obs_dim, cfg, init_rng), cfg)
    restored2 = restore_full_checkpoint(smoke_ckpt_dir, dummy_ts, step=gs)
    ts2 = restored2["train_state"]
    replay2 = restored2["replay_buffer"]
    rng2 = restored2["rng"]
    gs2 = restored2["global_step"]
    uc2 = restored2["update_count"]
    arng2 = restored2["action_rng_state"]

    assert gs2 == gs, f"Round-trip global_step mismatch: {gs2} != {gs}"
    assert uc2 == update_count, \
        f"Round-trip update_count mismatch: {uc2} != {update_count}"
    assert len(replay2) == len(replay), \
        f"Round-trip replay size mismatch: {len(replay2)} != {len(replay)}"
    assert bool(jnp.all(rng2 == rng)), "Round-trip JAX rng mismatch"
    params_equal = all(
        bool(jnp.all(l1 == l2))
        for l1, l2 in zip(
            jax.tree_util.tree_leaves(ts.params),
            jax.tree_util.tree_leaves(ts2.params)))
    assert params_equal, "Round-trip params mismatch!"
    opt_equal = all(
        bool(jnp.all(jnp.asarray(l1) == jnp.asarray(l2)))
        for l1, l2 in zip(
            jax.tree_util.tree_leaves(ts.opt_state),
            jax.tree_util.tree_leaves(ts2.opt_state)))
    assert opt_equal, "Round-trip optimizer state mismatch!"
    assert arng2 is not None, "Round-trip action_rng_state missing"
    # Restored action RNG state must reproduce the same future stream.
    g_resume = restore_action_rng(arng2, seed=P2_V1_MASTER_SEED)
    g_cont = action_rng  # current generator already advanced equally
    seq_resume = [int(sample_actions(g_resume, probs)[0]) for _ in range(8)]
    seq_cont = [int(sample_actions(g_cont, probs)[0]) for _ in range(8)]
    assert seq_resume == seq_cont, "FAIL: restored action RNG diverges from live RNG"
    print(f"  round-trip OK: params+optimizer bit-exact, global_step={gs2}, "
          f"update_count={uc2}, replay={len(replay2)}, rng match, action_rng resumes")

    # 8. Cleanup
    print("\n[smoke 8/8] Cleanup ...")
    shutil.rmtree(smoke_ckpt_dir, ignore_errors=True)
    print(f"  Smoke checkpoint cleaned up")

    # Summary
    print(f"\n{'='*60}")
    print("SMOKE TEST: P2-v1 WEIGHTS-ONLY FRESH-START — ALL CHECKS PASSED")
    print(f"  source_checkpoint:        {fresh['source_checkpoint']}")
    print(f"  source_checkpoint_sha256: {fresh['source_checkpoint_sha256']}")
    print(f"  encoder_kernel:           {fresh['encoder_kernel']}")
    print(f"  param_leaves:             {fresh['param_leaves']}")
    print(f"  optimizer:                FRESH (step {fresh['optimizer_step']})")
    print(f"  replay_size:              {len(replay)}")
    print(f"  p2_v1_global_step:        {gs}")
    print(f"  p2_v1_update_count:       {update_count}")
    print(f"  master_seed:              {fresh['master_seed']}")
    print(f"  gamma / lambda:           {GAMMA} / {GAE_LAMBDA}")
    print(f"  GPU:                      {EXPECTED_GPU_UUID}")
    print(f"{'='*60}")
    return True


