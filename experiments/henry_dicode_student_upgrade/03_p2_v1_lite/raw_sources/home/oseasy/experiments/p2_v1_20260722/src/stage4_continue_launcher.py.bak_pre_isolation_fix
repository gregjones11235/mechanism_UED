# P2-v0 freeze guard
# ═══════════════════════════════════════════════════════════════════════

def v0_freeze_guard() -> None:
    """Refuse formal chained continuation from v0 checkpoints 98304/122880.

    The v0 P2 implementation is frozen and labeled
    ``P2-v0-exploratory-invalid-for-attribution`` (2026-07-22).  Those
    checkpoints are historical exploratory results only and MUST NOT be used to
    attribute P2 mechanism efficacy.  P2-v1 training starts fresh from Henry
    session175 (base 17500) under the P2-v1 launcher/output namespace, NOT via
    this v0 continuation path.

    Set ``P2_V0_CONTINUATION_ALLOWED=1`` to override for DEBUGGING ONLY.
    """
    if os.environ.get("P2_V0_CONTINUATION_ALLOWED", "0") == "1":
        print("[freeze] WARNING: P2_V0_CONTINUATION_ALLOWED=1 — freeze OVERRIDE "
              "active (DEBUG ONLY). v0 continuation is NOT valid P2-v1 evidence.")
        return
    print("=" * 64)
    print("FROZEN: P2-v0-exploratory-invalid-for-attribution (2026-07-22)")
    print("  Formal chained continuation from v0 checkpoints 98304/122880 is")
    print("  STOPPED.  Those checkpoints are historical exploratory results only")
    print("  and MUST NOT be used to attribute P2 mechanism efficacy.")
    print("  P2-v1 training must start fresh from Henry session175 (base 17500)")
    print("  under the P2-v1 launcher / output namespace — not this v0 path.")
    print("  Set P2_V0_CONTINUATION_ALLOWED=1 to override for DEBUGGING ONLY.")
    print("=" * 64)
    sys.exit(2)


# ═══════════════════════════════════════════════════════════════════════
# Main: multi-session training loop
# ═══════════════════════════════════════════════════════════════════════

def main(max_sessions: Optional[int] = None,
         num_updates: int = NUM_UPDATES_PER_SESSION,
         resume_from: Optional[int] = None):
    # P2-v1 fresh start: weights-only init from healthy session175.  This path
    # never touches the frozen P2-v0 checkpoints (verify_not_v0_source enforces).
    verify_not_v0_source(SESSION175_CKPT)

    session_target_steps = NUM_ENVS * ROLLOUT_STEPS * num_updates
    print("=" * 60)
    print("P2-v1 Stage4 Training — Experiment A (weights-only from session175)")
    print(f"  Start:         weights-only from {SESSION175_CKPT}")
    print(f"  p2_v1 start:   global_step=0, update_count=0, replay_size=0")
    print(f"  Session size:  {session_target_steps} env steps "
          f"({NUM_ENVS}x{ROLLOUT_STEPS}x{num_updates} updates)")
    print(f"  GPU:           {EXPECTED_GPU_UUID}")
    print(f"  gamma:         {GAMMA}  lambda: {GAE_LAMBDA}")
    print(f"  anneal_lr:     False (Stage4 — NO auto-annealing)")
    print(f"  master_seed:   {P2_V1_MASTER_SEED}")
    print(f"  max_sessions:  {max_sessions if max_sessions else 'unlimited (Ctrl+C to stop)'}")
    print("=" * 60)

    # ── Guards ────────────────────────────────────────────────────
    verify_gpu()
    session_dir = guard_output_collision(
        os.path.join(OUTPUT_ROOT, "stage4_continue"))
    print(f"\n[output] Session directory: {session_dir}")

    cfg = Cfg()

    # ── [1/6] Build dummy env for obs_dim/action_dim ───────────────
    print("\n[1/6] Building dummy env for network init ...")
    ach_table = jnp.array(
        [get_achievement_multi_hot([Achievement.DEFEAT_KOBOLD])], dtype=jnp.float32)
    EMB = int(ach_table.shape[1])
    dummy = CraftaxAugObsTrain(
        condition_on_task=True, conditioning_type="embedding",
        embedding_size=EMB, task_embeddings=jnp.zeros((1, EMB)))
    obs_dim = dummy.observation_space(dummy.default_params).shape[0]
    action_dim = dummy.action_space(dummy.default_params).n
    print(f"  obs_dim={obs_dim}  action_dim={action_dim}")

    # ── [2/6] Build network ────────────────────────────────────────
    print("\n[2/6] Building network ...")
    network = ActorCriticTransformer(
        action_dim=action_dim,
        activation=cfg.activation,
        hidden_layers=cfg.hidden_layers,
        encoder_size=cfg.embed_size,
        num_heads=cfg.num_heads,
        qkv_features=cfg.qkv_features,
        num_layers=cfg.num_layers,
        gating=cfg.gating,
        gating_bias=cfg.gating_bias)

    # ── [3/6] Build the real Stage4 base env (needed for weights load) ──
    print("\n[3/6] Building Stage4 base env ...")
    with open(S4_TASK_PATH) as f:
        s4_code = f.read()
    ns = {}
    exec(s4_code, ns)
    Task = ns["Env"]
    static_env_params = StaticEnvParams()
    env_params = EnvParams(max_timesteps=4096)
    base_env = MultiTaskMiniCraftaxEnv(
        [Task], static_env_params, env_params, cfg.condition_on_task,
        conditioning_type="embedding", embedding_size=EMB,
        completion_bonus_scale=cfg.completion_bonus_scale,
        completion_bonus_min=cfg.completion_bonus_min,
        bonus_type=cfg.bonus_type, dynamic_bonus_k=cfg.dynamic_bonus_k)
    print("  base env built (Stage4: floor2, 8/8 kills pre-credited, DEFEAT_KOBOLD)")

    # ── [4/6] Weights-only init from session175 + fresh everything ──
    print("\n[4/6] Weights-only init from healthy session175 (fresh start) ...")
    fresh = init_fresh_from_session175(network, base_env, env_params, cfg, obs_dim)
    ts = fresh["train_state"]
    replay = fresh["replay_buffer"]
    rng = fresh["rng"]
    action_rng = fresh["action_rng"]
    global_step = fresh["global_step"]      # == 0
    update_count = fresh["update_count"]    # == 0
    source_checkpoint = fresh["source_checkpoint"]
    source_checkpoint_sha256 = fresh["source_checkpoint_sha256"]

    # ── [4b/6] 方案B exact-resume override (optional --resume-from) ──
    # When resume_from is given, replace the fresh-start state with the state
    # restored from P2-v1's OWN checkpoint (CKPT_ROOT/<resume_from>) so this run
    # CONTINUES bit-exactly instead of restarting.  The fresh init in [4/6] is
    # still run to recover the session175 source provenance for the manifest.
    resuming = resume_from is not None
    if resuming:
        print(f"\n[4b/6] 方案B exact-resume from P2-v1 checkpoint "
              f"step={resume_from} ...")
        rr = restore_p2_v1_checkpoint(
            CKPT_ROOT, resume_from, network, cfg, obs_dim)
        ts = rr["train_state"]
        replay = rr["replay_buffer"]
        rng = rr["rng"]
        action_rng = restore_action_rng(
            rr["action_rng_state"], seed=P2_V1_MASTER_SEED)
        global_step = int(rr["global_step"])
        update_count = int(rr["update_count"])
        pending = PendingEpisodeBuffers.from_state_dict(rr["pending_state"])
        _cs = rr["collector_state"]
        c_env_state = _cs["env_state"]
        c_obsv = _cs["obsv"]
        c_memories = _cs["memories"]
        c_mem_mask = _cs["mem_mask"]
        c_mem_idx = _cs["mem_idx"]
        print(f"  resumed: global_step={global_step} "
              f"update_count={update_count} replay={len(replay)} "
              f"pending={pending.total_pending_transitions()} "
              f"(continues WITHOUT env.reset)")
    else:
        # True fresh start: first session resets the env (collector state None).
        pending = None
        c_env_state = None
        c_obsv = None
        c_memories = None
        c_mem_mask = None
        c_mem_idx = None

    # ── [5/6] Wrap env for distributed rollout ─────────────────────
    print("\n[5/6] Wrapping env for distributed rollout ...")
    env = DistributedMultiTaskOptimisticLogWrapper(
        base_env, jax.random.PRNGKey(P2_V1_MASTER_SEED), NUM_ENVS, 1,
        cfg.optimistic_reset_ratio, jnp.array([1.0]), ach_table)
    print("  env wrapped")

    # ── [6/6] Build learner ────────────────────────────────────────
    print("\n[6/6] Building learner ...")
    learner = LongContextLearner(network, cfg, rng)
    print("  learner ready")

    # ── Source hashes (baseline) ──────────────────────────────────
    src_hashes = {}
    for fn in sorted(os.listdir(_AMAGO_SRC)):
        if fn.endswith(".py"):
            with open(os.path.join(_AMAGO_SRC, fn), "rb") as fh:
                src_hashes[fn] = hashlib.sha256(fh.read()).hexdigest()

    # ── Training loop ─────────────────────────────────────────────
    session_index = 0
    all_session_manifests = []
    t0 = time.time()

    # 方案B: persistent cross-rollout/cross-session collector state.  Initialized
    # in the [4b/6] block above: None for a true fresh start (first session resets
    # the env), or restored from the P2-v1 checkpoint when --resume-from is given.
    # Carried across sessions and checkpointed so a resumed run continues bit-exactly.

    try:
        session_failed = False
        while max_sessions is None or session_index < max_sessions:
            session_index += 1

            result = run_session(
                ts=ts,
                replay=replay,
                rng=rng,
                action_rng=action_rng,
                update_count=update_count,
                global_step=global_step,
                session_index=session_index,
                cfg=cfg,
                network=network,
                learner=learner,
                env=env,
                env_params=env_params,
                ach_table=ach_table,
                out_dir=session_dir,
                num_updates=num_updates,
                session_target_steps=session_target_steps,
                pending=pending,
                r_env_state=c_env_state,
                r_obsv=c_obsv,
                r_memories=c_memories,
                r_mem_mask=c_mem_mask,
                r_mem_idx=c_mem_idx,
            )

            # Unpack result
            ts = result["ts"]
            replay = result["replay"]
            rng = result["rng"]
            action_rng = result["action_rng"]
            update_count = result["update_count"]
            global_step = result["global_step"]
            session_env_steps = result["session_env_steps"]
            session_elapsed = result["session_elapsed_s"]
            crash_info = result["crash_info"]
            pending = result["pending"]
            c_env_state = result["env_state"]
            c_obsv = result["obsv"]
            c_memories = result["memories"]
            c_mem_mask = result["mem_mask"]
            c_mem_idx = result["mem_idx"]

            # Save full checkpoint after every SUCCESSFUL session.  A session
            # that crashed mid-update has an INCONSISTENT state (global_step
            # advanced past the last applied update), so we FAIL CLOSED: do
            # NOT write a corrupt checkpoint, and propagate a non-zero exit so
            # the orchestrator's hard gates catch it.  The manifest/log/crash
            # json are still written below (checkpoint_path=null) as evidence.
            if crash_info is None:
                ckpt_path = save_stage4_checkpoint(
                    ts, replay, rng, global_step, cfg,
                    session_index, session_dir, P2_V1_GLOBAL_STEP_START,
                    action_rng_state=action_rng_state(action_rng),
                    update_count=update_count,
                    source_checkpoint=source_checkpoint,
                    source_checkpoint_sha256=source_checkpoint_sha256,
                    pending_state=pending.state_dict(),
                    collector_state={
                        "env_state": c_env_state,
                        "obsv": c_obsv,
                        "memories": c_memories,
                        "mem_mask": c_mem_mask,
                        "mem_idx": c_mem_idx,
                    })
            else:
                ckpt_path = None
                session_failed = True
                print(f"\n!! SESSION {session_index} CRASHED — "
                      f"{crash_info['error']}")
                print("!! FAIL CLOSED: NOT saving checkpoint (state "
                      "inconsistent: global_step advanced past last applied "
                      "update). Will exit non-zero.")

            # Session manifest
            session_manifest = {
                "directive": "D059",
                "stage": "4",
                "experiment": "A",
                "treatment": "AMAGO_STYLE_EXPLORATORY_P2",
                "launcher": "P2-v1-fresh-start-weights-only",
                "start": (("resume_from_p2v1_step_%d" % resume_from)
                          if resuming else "weights_only_from_session175"),
                "source_checkpoint": source_checkpoint,
                "source_checkpoint_sha256": source_checkpoint_sha256,
                "p2_v1_start_step": P2_V1_GLOBAL_STEP_START,
                "resume_from_step": (resume_from if resuming
                                     else P2_V1_GLOBAL_STEP_START),
                "num_updates": num_updates,
                "session_index": session_index,
                "global_step": global_step,
                "session_env_steps": session_env_steps,
                "session_elapsed_s": session_elapsed,
                "total_elapsed_s": round(time.time() - t0, 1),
                "gamma": GAMMA,
                "gae_lambda": GAE_LAMBDA,
                "anneal_lr": False,
                "optimizer_fresh_at_start": (not resuming),
                "gpu_uuid": EXPECTED_GPU_UUID,
                "checkpoint_path": ckpt_path,
                "counters": replay.counters.snapshot(),
                "replay_buffer_size": len(replay),
                "replay_longest_trajectory": replay.longest_trajectory_length,
                "pass_trajs_long": result["pass_trajs_long"],
                "pass_samples_long": result["pass_samples_long"],
                "pass_grad_updates": result["pass_grad_updates"],
                "pass_relabel_count": len(result["pass_relabel_evidence"]),
                "crash_info": crash_info,
                "resolved_config": _cfg_resolved_dict(cfg),
                "source_hashes": src_hashes,
                "timestamp_utc": datetime.now(timezone.utc).isoformat(),
            }
            all_session_manifests.append(session_manifest)

            # Write cumulative manifest
            with open(os.path.join(session_dir, "stage4_manifest.json"), "w") as f:
                json.dump(all_session_manifests, f, indent=2, sort_keys=True)

            # Write session log
            with open(os.path.join(session_dir, "training_log.jsonl"), "a") as f:
                for entry in result["session_log"]:
                    f.write(json.dumps(entry) + "\n")

            # Write source hashes
            with open(os.path.join(session_dir, "source_hashes.json"), "w") as f:
                json.dump(src_hashes, f, indent=2, sort_keys=True)

            print(f"\n── Session {session_index} complete: "
                  f"{session_env_steps} steps in {session_elapsed}s, "
                  f"ckpt at step {global_step}")

            if crash_info:
                print(f"  WARNING: session crashed — {crash_info['error']}")
                with open(os.path.join(
                        session_dir,
                        f"crash_session_{session_index}.json"), "w") as f:
                    json.dump(crash_info, f, indent=2)

    except KeyboardInterrupt:
        print(f"\n\nInterrupted after session {session_index - 1}.  "
              f"Final checkpoint at step {global_step}.")
        # Save emergency checkpoint
        try:
            save_stage4_checkpoint(
                ts, replay, rng, global_step, cfg,
                session_index, session_dir, P2_V1_GLOBAL_STEP_START,
                action_rng_state=action_rng_state(action_rng),
                update_count=update_count,
                source_checkpoint=source_checkpoint,
                source_checkpoint_sha256=source_checkpoint_sha256,
                pending_state=(
                    pending.state_dict() if pending is not None else None),
                collector_state=(
                    {"env_state": c_env_state, "obsv": c_obsv,
                     "memories": c_memories, "mem_mask": c_mem_mask,
                     "mem_idx": c_mem_idx}
                    if c_env_state is not None else None))
        except Exception:
            pass

    total_elapsed = round(time.time() - t0, 1)
    print(f"\n{'='*60}")
    print(f"Stage4 Continuation: {session_index} sessions completed")
    print(f"  Final global_step: {global_step}")
    print(f"  Total env steps:   {global_step - P2_V1_GLOBAL_STEP_START}")
    print(f"  Total elapsed:     {total_elapsed}s")
    print(f"  Output:            {session_dir}")
    print(f"{'='*60}")

    if session_failed:
        print("\nEXIT 1: at least one session crashed — NO valid checkpoint "
              "was saved for it. See crash_session_*.json and the "
              "orchestrator log.")
        sys.exit(1)


